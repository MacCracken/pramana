    if (e >= 120) {
        var big: f64 = _pmn_km_cr_finish(e, buf[0], buf[1], buf[2]);
        return big;
    }
    var sc: f64 = _pmn_km_cr_pow2(e);
    var bh: f64 = buf[0] * sc;
    var bm: f64 = buf[1] * sc;
    var bl: f64 = buf[2] * sc;
    var dh, dm, dl = _pmn_km_td_add_d(bh, bm, bl, -1.0);
    var r2: f64 = _pmn_km_rn3(dh, dm, dl);
    return r2;
}

# The ln fast core for the bits ui of a positive normal x (ebias −54 for a subnormal pre-scaled by 2^54):
# (hi, lo, err) with |hi + lo − ln x| < err minus the test's own rounding (the bound above).
#must_use
fn _pmn_km_ln_core(ui, ebias): (f64, f64, f64) {
    var t = ui - 0x3FE7FC0000000000;
    var e0 = t >>> 52;
    var ti = ((t >> 43) & 511) * 32;
    var mb = ui - (e0 << 52);
    var m: f64 = mb;
    var mhb = mb & 0xFFFFFFFFF0000000;
    var mh: f64 = mhb;
    var ml: f64 = m - mh;
    var c: f64 = load64(&_PMN_KM_CR_LN_T + ti);
    var lh: f64 = load64(&_PMN_KM_CR_LN_T + ti + 8);
    var lm: f64 = load64(&_PMN_KM_CR_LN_T + ti + 16);
    var r: f64 = ((mh * c) - 1.0) + (ml * c);
    var cc: f64 = r * 134217729.0;
    var ra: f64 = cc - (cc - r);
    var rb: f64 = r - ra;
    var t1: f64 = -0.5 * (ra * ra);             # −ra²/2, exact
    var nrb: f64 = -rb;
    var t2: f64 = nrb * (ra + (0.5 * rb));
    var c3: f64 = _PMN_KM_CR_LN_C3;
    var c4: f64 = _PMN_KM_CR_LN_C4;
    var c5: f64 = _PMN_KM_CR_LN_C5;
    var c6: f64 = _PMN_KM_CR_LN_C6;
    var c7: f64 = _PMN_KM_CR_LN_C7;
    var c8: f64 = _PMN_KM_CR_LN_C8;
    var z: f64 = r * r;
    var pz: f64 = ((c3 + (r * c4)) + (z * (c5 + (r * c6)))) + ((z * z) * (c7 + (r * c8)));   # Estrin
    var p: f64 = (z * r) * pz;
    var e = e0 + ebias;
    var ef: f64 = f64_from(e);
    var ln2h: f64 = _PMN_KM_CR_LN_LN2H;
    var ln2m: f64 = _PMN_KM_CR_LN_LN2M;
    var a: f64 = ef * ln2h;                      # exact: LN2H has 42 bits, |E| < 2^11
    var s0: f64 = a + lh;
    var d0: f64 = lh - (s0 - a);
    var s1: f64 = s0 + r;
    var d1: f64 = r - (s1 - s0);
    var s2: f64 = s1 + t1;
    var d2: f64 = t1 - (s2 - s1);
    var lo: f64 = (((ef * ln2m) + lm) + (t2 + p)) + ((d0 + d1) + d2);   # short chains (latency)
    var ap: f64 = f64_abs(p);
    var ah: f64 = f64_abs(s2);
    var ae: f64 = f64_abs(ef);
    var k49: f64 = 0x3CE0000000000000;          # 2^-49
    var k83: f64 = 0x3AC0000000000000;          # 2^-83
    var k93: f64 = 0x3A20000000000000;          # 2^-93
    var err: f64 = ((ap * k49) + (ah * k83)) + (ae * k93);
    return (s2, lo, err);
}

# The special values ln and log10 share: (x for NaN, −∞ for ±0, the quiet NaN for x < 0 (−∞ included), +∞ for +∞;
# 1), or (0, 0) for a positive finite x. The one ladder of _pmn_km_cr_ln_fast, _pmn_km_cr_ln_acc, _pmn_km_cr_log10_fast
# and
# _pmn_km_cr_log10_acc (2.0.1).
#must_use
fn _pmn_km_ln_special(x: f64): (f64, i64) {
    if (x != x) { return (x, 1); }
    if (x == 0.0) {
        var m1: f64 = -1.0;
        var ninf: f64 = m1 / 0.0;
        return (ninf, 1);
    }
    if (x < 0.0) {
        var nan: f64 = _pmn_km_nan();               # the same quiet NaN on every target
        return (nan, 1);
    }
    if (x == _PMN_KM_INF) { return (x, 1); }
    return (0.0, 0);
}

# ln(x), correctly rounded. ln(1) = +0, ln(±0) = −∞, ln(+∞) = +∞, NaN for NaN and x < 0 (−∞ included).
#must_use
fn _pmn_km_cr_ln(x: f64): f64 {
    var ui = load64(&x);
    # x ≤ 0 (the sign bit), subnormal, ∞ or NaN: ui − bits(DBL_MIN) is at least bits(∞) − bits(DBL_MIN) as an
    # unsigned word (the unsigned range test of _pmn_km_cr_exp).
    if (((ui - 0x0010000000000000) ^ 0x8000000000000000) >= 0xFFE0000000000000) {
        var w, okw = _pmn_km_cr_ln_fast(x);
        if (okw == 1) { return w; }
        var zw: f64 = _pmn_km_cr_ln_acc(x);
        return zw;
    }
    # _pmn_km_ln_core's body, inline (a call and its three-value return cost about 14 ns here).
    var t = ui - 0x3FE7FC0000000000;
    var e0 = t >>> 52;
    var ti = ((t >> 43) & 511) * 32;
    var mb = ui - (e0 << 52);
    var m: f64 = mb;
    var mhb = mb & 0xFFFFFFFFF0000000;
    var mh: f64 = mhb;
    var ml: f64 = m - mh;
    var c: f64 = load64(&_PMN_KM_CR_LN_T + ti);
    var lh: f64 = load64(&_PMN_KM_CR_LN_T + ti + 8);
    var lm: f64 = load64(&_PMN_KM_CR_LN_T + ti + 16);
    var r: f64 = ((mh * c) - 1.0) + (ml * c);
    var cc: f64 = r * 134217729.0;
    var ra: f64 = cc - (cc - r);
    var rb: f64 = r - ra;
    var t1: f64 = -0.5 * (ra * ra);             # −ra²/2, exact
    var nrb: f64 = -rb;
    var t2: f64 = nrb * (ra + (0.5 * rb));
    var c3: f64 = _PMN_KM_CR_LN_C3;
    var c4: f64 = _PMN_KM_CR_LN_C4;
    var c5: f64 = _PMN_KM_CR_LN_C5;
    var c6: f64 = _PMN_KM_CR_LN_C6;
    var c7: f64 = _PMN_KM_CR_LN_C7;
    var c8: f64 = _PMN_KM_CR_LN_C8;
    var z: f64 = r * r;
    var pz: f64 = ((c3 + (r * c4)) + (z * (c5 + (r * c6)))) + ((z * z) * (c7 + (r * c8)));   # Estrin
    var p: f64 = (z * r) * pz;
    var e = e0;
    var ef: f64 = f64_from(e);
    var ln2h: f64 = _PMN_KM_CR_LN_LN2H;
    var ln2m: f64 = _PMN_KM_CR_LN_LN2M;
    var a: f64 = ef * ln2h;                      # exact: LN2H has 42 bits, |E| < 2^11
    var s0: f64 = a + lh;
    var d0: f64 = lh - (s0 - a);
    var s1: f64 = s0 + r;
    var d1: f64 = r - (s1 - s0);
    var s2: f64 = s1 + t1;
    var d2: f64 = t1 - (s2 - s1);
    var lo: f64 = (((ef * ln2m) + lm) + (t2 + p)) + ((d0 + d1) + d2);   # short chains (latency)
    var ap: f64 = f64_abs(p);
    var ah: f64 = f64_abs(s2);
    var ae: f64 = f64_abs(ef);
    var k49: f64 = 0x3CE0000000000000;          # 2^-49
    var k83: f64 = 0x3AC0000000000000;          # 2^-83
    var k93: f64 = 0x3A20000000000000;          # 2^-93
    var err: f64 = ((ap * k49) + (ah * k83)) + (ae * k93);
    var u: f64 = s2 + (lo - err);
    var v: f64 = s2 + (lo + err);
    if (u == v) { return u; }
    var za: f64 = _pmn_km_cr_ln_acc(x);
    return za;
}

# The fast path alone, for every x (as _pmn_km_cr_exp_fast): the specials, a subnormal x scaled exactly by 2^54,
# then the core and its test, the operations of _pmn_km_cr_ln's inline path.
#must_use
fn _pmn_km_cr_ln_fast(x: f64): (f64, i64) {
    var ui = load64(&x);
    var eb = 0;
    if (((ui - 0x0010000000000000) ^ 0x8000000000000000) >= 0xFFE0000000000000) {
        var sv, sp = _pmn_km_ln_special(x);
        if (sp == 1) { return (sv, 1); }
        var p54: f64 = 0x4350000000000000;      # 2^54
        var xs: f64 = x * p54;
        ui = load64(&xs);
        eb = 0 - 54;
    }
    var hi, lo, err = _pmn_km_ln_core(ui, eb);
    var u: f64 = hi + (lo - err);
    var v: f64 = hi + (lo + err);
    if (u == v) { return (u, 1); }
    return (0.0, 0);
}

# The accurate ln of a positive finite x ≠ 1 as a triple-double at out[0..2]: the fast path's E, j and the
# exact r; log1p(r) by Horner in triple-double on the exact r to r^16/16 (truncation 2^-144·|r|);
# E·ln 2 = E·LN2H (exact) + E·LN2M (TwoProduct) + E·LN2L (rounded, 2^-138); then E·ln2 + L_j + log1p(r)
# with at most 1.3 bits of cancellation. Measured relative error 2^-150.
fn _pmn_km_ln_acc_td(x: f64, out) {
    var ui = load64(&x);
    var eb = 0;
    if (ui < 0x0010000000000000) {
        var p54: f64 = 0x4350000000000000;
        var xs: f64 = x * p54;
        ui = load64(&xs);
        eb = 0 - 54;
    }
    var t = ui - 0x3FE7FC0000000000;
    var e0 = t >>> 52;
    var ti = ((t >> 43) & 511) * 32;
    var mb = ui - (e0 << 52);
    var m: f64 = mb;
    var mhb = mb & 0xFFFFFFFFF0000000;
    var mh: f64 = mhb;
    var ml: f64 = m - mh;
    var c: f64 = load64(&_PMN_KM_CR_LN_T + ti);
    var r: f64 = ((mh * c) - 1.0) + (ml * c);
    var sh: f64 = load64(&_PMN_KM_CR_LN_ACC + 336);     # −1/16 (index 3·(16 − 2))
    var sm: f64 = load64(&_PMN_KM_CR_LN_ACC + 344);
    var sl: f64 = load64(&_PMN_KM_CR_LN_ACC + 352);
    var n = 15;
    while (n >= 2) {
        var th, tm, tl = _pmn_km_td_mul_d(sh, sm, sl, r);
        var off = (n - 2) * 24;
        var ch: f64 = load64(&_PMN_KM_CR_LN_ACC + off);
        var cm: f64 = load64(&_PMN_KM_CR_LN_ACC + off + 8);
        var cl: f64 = load64(&_PMN_KM_CR_LN_ACC + off + 16);
        var uh, um, ul = _pmn_km_td_add(ch, cm, cl, th, tm, tl);
        sh = uh;
        sm = um;
        sl = ul;
        n = n - 1;
    }
    var vh, vm, vl = _pmn_km_td_mul_d(sh, sm, sl, r);
    var wh, wm, wl = _pmn_km_td_add_d(vh, vm, vl, 1.0);
    var ph, pm, pl = _pmn_km_td_mul_d(wh, wm, wl, r);       # log1p(r)
    var lh: f64 = load64(&_PMN_KM_CR_LN_T + ti + 8);
    var lm: f64 = load64(&_PMN_KM_CR_LN_T + ti + 16);
    var ll: f64 = load64(&_PMN_KM_CR_LN_T + ti + 24);
    var ef: f64 = f64_from(e0 + eb);
    var ln2h: f64 = _PMN_KM_CR_LN_LN2H;
    var ln2m: f64 = _PMN_KM_CR_LN_LN2M;
    var ln2l: f64 = _PMN_KM_CR_LN_LN2L;
    var a0: f64 = ef * ln2h;
    var a1, a1e = _pmn_km_two_prod(ef, ln2m);
    var a2: f64 = ef * ln2l;
    var h0, u0 = _pmn_km_fast_two_sum(a0, a1);
    var a12: f64 = a1e + a2;
    var m0, l0 = _pmn_km_two_sum(u0, a12);
    var bh, bm, bl = _pmn_km_td_add(h0, m0, l0, lh, lm, ll);
    var zh, zm, zl = _pmn_km_td_add(bh, bm, bl, ph, pm, pl);
    store64(out, zh);
    store64(out + 8, zm);
    store64(out + 16, zl);
}

# ln by the accurate path alone, for every x.
#must_use
fn _pmn_km_cr_ln_acc(x: f64): f64 {
    var sv, sp = _pmn_km_ln_special(x);
    if (sp == 1) { return sv; }
    if (x == 1.0) { return 0.0; }
    var buf: f64[3];
    _pmn_km_ln_acc_td(x, &buf);
    var r: f64 = _pmn_km_rn3(buf[0], buf[1], buf[2]);
    return r;
}

# (1 if y is an integer, 1 if y is an odd integer) for a finite y ≠ 0: y = M·2^(f − 1075) with the 53-bit
# significand M; integer when no set bit of M lies below 2^(1075 − f).
#must_use
fn _pmn_km_pow_yclass(y: f64): (i64, i64) {
    var uy = load64(&y) & 0x7FFFFFFFFFFFFFFF;
    var f = uy >> 52;
    var m = (uy & 0x000FFFFFFFFFFFFF) | 0x0010000000000000;
    if (f >= 1075) {
        if (f == 1075) { return (1, m & 1); }
        return (1, 0);                           # |y| ≥ 2^53: even
    }
    if (f < 1023) { return (0, 0); }             # 0 < |y| < 1
    var sh = 1075 - f;
    if ((m & ((1 << sh) - 1)) != 0) { return (0, 0); }
    return (1, (m >> sh) & 1);
}

# RN(mm·2^s) for an integer 1 ≤ mm < 2^62 and an integer |s| < 2^40, by integer rounding: ties to even,
# subnormal results on the 2^-1074 grid, +∞ past DBL_MAX, +0 below half of 2^-1074. Exact, so it rounds exact
# results and exact midpoints right.
#must_use
fn _pmn_km_cr_from_int(mm, s): f64 {
    var b = 0;
    var t = mm;
    while (t != 0) {
        t = t >> 1;
        b = b + 1;
    }
    var top = s + b - 1;                         # the exponent of mm·2^s's leading bit
    if (top > 1023) {
        var inf: f64 = _PMN_KM_INF;
        return inf;
    }
    var lsb = top - 52;                          # the result's last bit, at most 53 bits and not below 2^-1074
    if (lsb < 0 - 1074) { lsb = 0 - 1074; }
    var sh = lsb - s;
    var q = mm;
    if (sh > 0) {
        if (sh > 62) { return 0.0; }
        q = mm >> sh;
        var rem = mm - (q << sh);
        var half = 1 << (sh - 1);
        if (rem > half || (rem == half && (q & 1) == 1)) { q = q + 1; }
    } else {
        lsb = s;
    }
    var qf: f64 = f64_from(q);                   # q ≤ 2^53: exact
    if (lsb >= 0 - 1022) {
        var sc: f64 = _pmn_km_cr_pow2(lsb);
        var r: f64 = qf * sc;                    # exact, or +∞ when q·2^lsb = 2^1024
        return r;
    }
    var s1: f64 = _pmn_km_cr_pow2(lsb + 1074);       # q·2^lsb = ((q·2^(lsb + 1074))·2^-52)·2^-1022: each step exact
    var s2: f64 = _pmn_km_cr_pow2(0 - 52);
    var s3: f64 = _pmn_km_cr_pow2(0 - 1022);
    var w: f64 = ((qf * s1) * s2) * s3;
    return w;
}

# M^n for odd integers M ≥ 3 and n ≥ 1, or 0 when it reaches 2^54.
#must_use
fn _pmn_km_pow_int54(mm, n): i64 {
    var acc = 1;
    var i = 0;
    while (i < n) {
        if (acc > (0x0040000000000000 / mm)) { return 0; }
        acc = acc * mm;
        i = i + 1;
    }
    if (acc >= 0x0040000000000000) { return 0; }
    return acc;
}

# (1, RN(x^y)) when x^y is an exact double or an exact midpoint (or another value known exactly), else (0, 0);
# x > 0 finite, y finite with 0 < |y| < 2^64. After Lauter and Lefèvre ("An efficient rounding boundary test for
# pow(x, y) in double precision", IEEE TC 2009) and CORE-MATH's pow. Write x = mx·2^ex and y = ±my·2^fy with mx,
# my odd. y is a double, so in lowest terms y = p/2^k (k = max(0, −fy)). If x^y = R is rational then
# R^(2^k) = x^p: when p > 0, unique factorisation makes mx a perfect 2^k-th power, mx = a^(2^k), with 2^k | ex,
# and R = a^p·2^(ex·p/2^k); when p < 0, R's odd part 1/a^|p| is dyadic only for a = 1, mx = 1. A double or a
# midpoint has an odd part below 2^54, so beyond these cases x^y is neither: mx = 1 gives a power of two
# 2^(ex·y) (exact, the tie 2^-1075, or out of range); mx ≥ 3 needs p > 0, a^p < 2^54 (so p ≤ 34) and
# a^(2^k) = mx < 2^53 (so k ≤ 5). In particular y = RN(1/3) has k = 54: x^y is never exact unless x = 1.
#must_use
fn _pmn_km_pow_exact(ax: f64, y: f64): (i64, f64) {
    var ux = load64(&ax);
    var mx = ux & 0x000FFFFFFFFFFFFF;
    var ex = 0 - 1074;
    if ((ux >> 52) != 0) {
        mx = mx | 0x0010000000000000;
        ex = (ux >> 52) - 1075;
    }
    while ((mx & 1) == 0) {
        mx = mx >> 1;
        ex = ex + 1;
    }
    var uy = load64(&y);
    var sy = 1;
    if (uy < 0) { sy = 0 - 1; }
    var ay = uy & 0x7FFFFFFFFFFFFFFF;
    var my = ay & 0x000FFFFFFFFFFFFF;
    var fy = 0 - 1074;
    if ((ay >> 52) != 0) {
        my = my | 0x0010000000000000;
        fy = (ay >> 52) - 1075;
    }
    while ((my & 1) == 0) {
        my = my >> 1;
        fy = fy + 1;
    }
    if (fy >= 0) {                               # y an integer: |y| = my·2^fy
        if (fy >= 12 || my >= 4096) { return (0, 0.0); }   # |y| ≥ 4096: 2^(ex·y) and mx^y are out of reach
        var yi = my << fy;
        if (yi >= 4096) { return (0, 0.0); }
        if (mx == 1) {
            var r1: f64 = _pmn_km_cr_from_int(1, ex * yi * sy);
            return (1, r1);
        }
        if (sy < 0) { return (0, 0.0); }
        if (yi > 34) { return (0, 0.0); }
        var mm = _pmn_km_pow_int54(mx, yi);
        if (mm == 0) { return (0, 0.0); }
        var r2: f64 = _pmn_km_cr_from_int(mm, ex * yi);
        return (1, r2);
    }
    var k = 0 - fy;                              # y = ±my/2^k, k ≥ 1
    var q = 0;
    if (k >= 11) {
        if (ex != 0) { return (0, 0.0); }        # |ex| < 2^11: 2^k ∤ ex
    } else {
        if ((ex & ((1 << k) - 1)) != 0) { return (0, 0.0); }
        q = ex >>> k;
    }
    if (mx == 1) {
        if (q == 0) { return (1, 1.0); }         # x = 1
        if (my >= 4096) { return (0, 0.0); }     # |ex·y| ≥ my: out of range
        var r3: f64 = _pmn_km_cr_from_int(1, q * my * sy);
        return (1, r3);
    }
    if (k > 5 || sy < 0 || my > 34) { return (0, 0.0); }
    var a = mx;
    var i = 0;
    while (i < k) {                              # a = mx^(1/2^k), each root exact or none
        var af: f64 = f64_from(a);
        var sf: f64 = f64_sqrt(af);
        var si = f64_to(sf);
        if (si * si != a) { return (0, 0.0); }
        a = si;
        i = i + 1;
    }
    var m2 = _pmn_km_pow_int54(a, my);
    if (m2 == 0) { return (0, 0.0); }
    var r4: f64 = _pmn_km_cr_from_int(m2, q * my);
    return (1, r4);
}

# The fast kernel for x > 0 finite (bits ux, a subnormal included) and finite y with 0 < |y| < 2^64:
# (RN(x^y), 1), or (0, 0) when the rounding test fails.
#must_use
fn _pmn_km_pow_pos_fast(ux, y: f64): (f64, i64) {
    var ui = ux;
    var eb = 0;
    if (ui < 0x0010000000000000) {               # a subnormal x, scaled exactly by 2^54
        var xf: f64 = ui;
        var p54: f64 = 0x4350000000000000;
        var xs: f64 = xf * p54;
        ui = load64(&xs);
        eb = 0 - 54;
    }
    # _pmn_km_ln_core(ui, eb)'s body, inline (2.0.1), as _pmn_km_cr_ln inlines it.
    var t = ui - 0x3FE7FC0000000000;
    var e0 = t >>> 52;
    var ti = ((t >> 43) & 511) * 32;
    var mb = ui - (e0 << 52);
    var m: f64 = mb;
    var mhb = mb & 0xFFFFFFFFF0000000;
    var mh: f64 = mhb;
    var ml: f64 = m - mh;
    var lc: f64 = load64(&_PMN_KM_CR_LN_T + ti);
    var tlh: f64 = load64(&_PMN_KM_CR_LN_T + ti + 8);
    var tlm: f64 = load64(&_PMN_KM_CR_LN_T + ti + 16);
    var lr: f64 = ((mh * lc) - 1.0) + (ml * lc);
    var cc: f64 = lr * 134217729.0;
    var ra: f64 = cc - (cc - lr);
    var rb: f64 = lr - ra;
    var t1: f64 = -0.5 * (ra * ra);             # −ra²/2, exact
    var nrb: f64 = -rb;
    var t2: f64 = nrb * (ra + (0.5 * rb));
    var c3: f64 = _PMN_KM_CR_LN_C3;
    var c4: f64 = _PMN_KM_CR_LN_C4;
    var c5: f64 = _PMN_KM_CR_LN_C5;
    var c6: f64 = _PMN_KM_CR_LN_C6;
    var c7: f64 = _PMN_KM_CR_LN_C7;
    var c8: f64 = _PMN_KM_CR_LN_C8;
    var zr: f64 = lr * lr;
    var pz: f64 = ((c3 + (lr * c4)) + (zr * (c5 + (lr * c6)))) + ((zr * zr) * (c7 + (lr * c8)));   # Estrin
    var lp: f64 = (zr * lr) * pz;
    var le = e0 + eb;
    var ef: f64 = f64_from(le);
    var ln2h: f64 = _PMN_KM_CR_LN_LN2H;
    var ln2m: f64 = _PMN_KM_CR_LN_LN2M;
    var la: f64 = ef * ln2h;                     # exact: LN2H has 42 bits, |E| < 2^11
    var s0: f64 = la + tlh;
    var d0: f64 = tlh - (s0 - la);
    var s1: f64 = s0 + lr;
    var d1: f64 = lr - (s1 - s0);
    var s2: f64 = s1 + t1;
    var d2: f64 = t1 - (s2 - s1);
    var ll: f64 = (((ef * ln2m) + tlm) + (t2 + lp)) + ((d0 + d1) + d2);
    var alp: f64 = f64_abs(lp);
    var als: f64 = f64_abs(s2);
    var ale: f64 = f64_abs(ef);
    var k49: f64 = 0x3CE0000000000000;          # 2^-49
    var k83: f64 = 0x3AC0000000000000;          # 2^-83
    var k93: f64 = 0x3A20000000000000;          # 2^-93
    var eln: f64 = ((alp * k49) + (als * k83)) + (ale * k93);
    var lh: f64 = s2;
    var zh0: f64 = y * lh;                       # z = y·(lh + ll): Dekker's product, both factors split
    var cy: f64 = 134217729.0 * y;
    var y1: f64 = cy - (cy - y);
    var y2: f64 = y - y1;
    var cl: f64 = 134217729.0 * lh;
    var l1: f64 = cl - (cl - lh);
    var l2: f64 = lh - l1;
    var ze: f64 = ((((y1 * l1) - zh0) + (y1 * l2)) + (y2 * l1)) + (y2 * l2);
    var zl0: f64 = ze + (y * ll);
    var zh: f64 = zh0 + zl0;                     # renormalised (Fast2Sum): |zl| ≤ 2^-44
    var zl: f64 = zl0 - (zh - zh0);
    var azh: f64 = f64_abs(zh);
    if (azh > 708.0) {
        if (zh > 710.0) {
            var inf: f64 = _PMN_KM_INF;
            return (inf, 1);
        }
        if (zh < -746.0) { return (0.0, 1); }
    }
    var ay: f64 = f64_abs(y);
    var k100: f64 = 0x39B0000000000000;          # 2^-100
    var k69: f64 = 0x3BA0000000000000;           # 2^-69
    var errz: f64 = (ay * eln) + (azh * k100);
    var err: f64 = (errz * 2.0625) + k69;
    # _pmn_km_exp_core(zh, zl)'s body, inline (2.0.1).
    var inv: f64 = _PMN_KM_CR_EXP_INVLN2N;
    var x_l1: f64 = _PMN_KM_CR_EXP_L1;
    var x_l2: f64 = _PMN_KM_CR_EXP_L2;
    var tt: f64 = (zh * inv) + 6755399441055744.0;   # 1.5·2^52: rounds z·512/ln 2 to an integer
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var xti = (k & 511) * 32;
    var e = k >>> 9;
    var rh: f64 = zh - (kd * x_l1);
    var xsk: f64 = (kd * x_l2) - zl;
    var xr: f64 = rh - xsk;
    var rl: f64 = (rh - xr) - xsk;
    var xc: f64 = xr + 49152.0;                 # 1.5·2^15: rounds r to a multiple of 2^-37
    var r1: f64 = xc - 49152.0;
    var r2: f64 = xr - r1;
    var p3: f64 = _PMN_KM_CR_EXP_P3;
    var p4: f64 = _PMN_KM_CR_EXP_P4;
    var p5: f64 = _PMN_KM_CR_EXP_P5;
    var xz: f64 = xr * xr;                       # Estrin: the code is latency-bound, so keep chains short
    var q: f64 = (xz * (0.5 + (xr * p3))) + ((xz * xz) * (p4 + (xr * p5)));
    var ta: f64 = load64(&_PMN_KM_CR_EXP_T + xti);
    var tb: f64 = load64(&_PMN_KM_CR_EXP_T + xti + 8);
    var p1: f64 = ta * r1;
    var hi: f64 = ta + p1;
    var e1: f64 = p1 - (hi - ta);
    var rlq: f64 = rl + q;
    var lo: f64 = (e1 + tb) + ((ta * (r2 + rlq)) + (tb * (xr + rlq)));
    if (e > 0 - 1022 && e < 1024) {             # a normal result: _pmn_km_exp_fin's first case, inline
        var u: f64 = hi + (lo - err);
        var v: f64 = hi + (lo + err);
        if (u != v) { return (0.0, 0); }
        var sb = (e + 1023) << 52;
        var sc: f64 = sb;
        var rn: f64 = u * sc;
        return (rn, 1);
    }
    var ok, r = _pmn_km_exp_fin(hi, lo, e, err);
    return (r, ok);
}

# The accurate kernel for the same arguments: an exact or midpoint result exactly, else the triple-double path.
#must_use
fn _pmn_km_pow_pos_acc(ax: f64, y: f64): f64 {
    var found, rx = _pmn_km_pow_exact(ax, y);
    if (found == 1) { return rx; }
    var lb: f64[3];
    _pmn_km_ln_acc_td(ax, &lb);
    var z0, z1, z2 = _pmn_km_td_mul_d(lb[0], lb[1], lb[2], y);
    if (z0 > 710.0) {
        var inf: f64 = _PMN_KM_INF;
        return inf;
    }
    if (z0 < -746.0) { return 0.0; }
    var eb: f64[3];
    var e = _pmn_km_exp_acc_core(z0, z1, z2, &eb);
    var r: f64 = _pmn_km_cr_finish(e, eb[0], eb[1], eb[2]);
    return r;
}

# Every argument outside the fast path's common case (x positive normal, 0 < |y| < 2^64): the special values,
# a negative x (the sign from y's parity), a subnormal x, |y| ≥ 2^64. acc = 0 runs the fast kernel, 1 the
# accurate one; (result, 1), or (0, 0) when the fast kernel's test fails.
#must_use
fn _pmn_km_pow_cases(x: f64, y: f64, acc): (f64, i64) {
    if (y == 0.0) { return (1.0, 1); }           # pow(x, ±0) = 1, x NaN included
    if (x == 1.0) { return (1.0, 1); }           # pow(+1, y) = 1, y NaN included
    if (x != x) { return (x, 1); }
    if (y != y) { return (y, 1); }
    var ax: f64 = f64_abs(x);
    var ay: f64 = f64_abs(y);
    var inf: f64 = _PMN_KM_INF;
    if (ay == inf) {
        if (ax == 1.0) { return (1.0, 1); }      # pow(−1, ±∞) = 1
        if (ax < 1.0) {
            if (y > 0.0) { return (0.0, 1); }
            return (inf, 1);
        }
        if (y > 0.0) { return (inf, 1); }
        return (0.0, 1);
    }
    var yint, yodd = _pmn_km_pow_yclass(y);
    if (ax == 0.0) {
        if (y < 0.0) {
            if (yodd == 1) {
                var pz: f64 = 1.0 / x;           # ±∞ with x's sign
                return (pz, 1);
            }
            return (inf, 1);
        }
        if (yodd == 1) { return (x, 1); }        # ±0
        return (0.0, 1);
    }
    if (ax == inf) {
        var res: f64 = inf;
        if (y < 0.0) { res = 0.0; }
        if (x < 0.0 && yodd == 1) { res = -res; }
        return (res, 1);
    }
    var neg = 0;
    if (x < 0.0) {
        if (yint == 0) {
            var nan: f64 = _pmn_km_nan();
            return (nan, 1);
        }
        neg = yodd;
    }
    var r: f64 = 0.0;
    var ok = 1;
    var big: f64 = 0x43F0000000000000;           # 2^64: |y·ln|x|| ≥ 2^64·2^-53 > 746 unless |x| = 1
    if (ay >= big) {
        if (ax == 1.0) {
            r = 1.0;
        } else {
            r = 0.0;
            if ((ax > 1.0) == (y > 0.0)) { r = inf; }
        }
    } else {
        if (acc == 1) {
            r = _pmn_km_pow_pos_acc(ax, y);
        } else {
            var rf, okf = _pmn_km_pow_pos_fast(load64(&ax), y);
            r = rf;
            ok = okf;
        }
    }
    if (neg == 1) { r = -r; }
    return (r, ok);
}

# pow(x, y) = x^y, correctly rounded, with the special values above. Mirrors `f64::powf`.
#must_use
fn _pmn_km_cr_pow(x: f64, y: f64): f64 {
    var ux = load64(&x);
    var ay = load64(&y) & 0x7FFFFFFFFFFFFFFF;
    # The common case of _pmn_km_cr_pow_fast, dispatched here to save a call: x in [DBL_MIN, DBL_MAX] and
    # 0 < |y| < 2^64.
    if (((ux - 0x0010000000000000) ^ 0x8000000000000000) < 0xFFE0000000000000) {
        if (((ay - 1) ^ 0x8000000000000000) < 0xC3EFFFFFFFFFFFFF) {
            var r, ok = _pmn_km_pow_pos_fast(ux, y);
            if (ok == 1) { return r; }
            var a: f64 = _pmn_km_pow_pos_acc(x, y);
            return a;
        }
    }
    var r2, ok2 = _pmn_km_pow_cases(x, y, 0);
    if (ok2 == 1) { return r2; }
    var a2: f64 = _pmn_km_cr_pow_acc(x, y);
    return a2;
}

# The fast path alone: (its result, 1), or (0, 0) when its rounding test fails.
#must_use
fn _pmn_km_cr_pow_fast(x: f64, y: f64): (f64, i64) {
    var ux = load64(&x);
    var ay = load64(&y) & 0x7FFFFFFFFFFFFFFF;
    # x in [DBL_MIN, DBL_MAX] and 0 < |y| < 2^64, as unsigned range tests (the trick of _pmn_km_cr_exp).
    if (((ux - 0x0010000000000000) ^ 0x8000000000000000) < 0xFFE0000000000000) {
        if (((ay - 1) ^ 0x8000000000000000) < 0xC3EFFFFFFFFFFFFF) {
            var r, ok = _pmn_km_pow_pos_fast(ux, y);
            return (r, ok);
        }
    }
    var r2, ok2 = _pmn_km_pow_cases(x, y, 0);
    return (r2, ok2);
}

# pow by the accurate path alone, for every (x, y).
#must_use
fn _pmn_km_cr_pow_acc(x: f64, y: f64): f64 {
    var r, ok = _pmn_km_pow_cases(x, y, 1);
    return r;
}

# Payne–Hanek reduction for 2^20 ≤ x < 2^1024 (bits ux of a positive finite x): returns k with x·2/π = k + f,
# |f| ≤ 1/2 (only k mod 4 is meaningful), and r = f·π/2 as a triple-double at out[0..2]. x = m·2^e (m the 53-bit
# significand, e ≥ −32); bits j < e − 1 of 2/π add multiples of 4 to m·2^e·2/π and are skipped, the 288 bits
# from e − 1 on are W (9 limbs of 32 bits from _PMN_KM_CR_TWOPI), the rest add below m·2^(e − (e − 1) − 287) =
# m·2^-286 < 2^-233. m·W mod 2^288 is computed exactly in base-2^32 columns (each product of 32-bit halves fits
# 64 bits, unsigned); its top 2 bits are k mod 4, the next 286 the fraction, centred into [−1/2, 1/2) by a
# two's-complement negation, then summed limb by limb into a triple-double (each step's error below 2^-155 of
# the sum) and multiplied by π/2 (2^-153).
fn _pmn_km_ph_reduce(ux, out): i64 {
    var m = (ux & 0x000FFFFFFFFFFFFF) | 0x0010000000000000;
    var e = (ux >> 52) - 1075;
    var m1 = m >> 32;
    var m0 = m & 0xFFFFFFFF;
    var p = e + 62;                               # bit e − 1 of 2/π sits at position e − 1 + 63 of the table
    var w = p >> 5;
    var s = p & 31;
    var col: i64[10];
    var k = 0;
    while (k < 10) {
        col[k] = 0;
        k = k + 1;
    }
    k = 0;
    while (k < 9) {                               # limb k (weight 2^(32k)) is window word 8 − k
        var hw = load64(&_PMN_KM_CR_TWOPI + 8 * (w + 8 - k));
        var lw = load64(&_PMN_KM_CR_TWOPI + 8 * (w + 9 - k));
        var v = ((hw << s) | (lw >> (32 - s))) & 0xFFFFFFFF;
        var a = m0 * v;                           # < 2^64: the exact product, as an unsigned word
        var b = m1 * v;                           # < 2^53
        col[k] = col[k] + (a & 0xFFFFFFFF);
        col[k + 1] = col[k + 1] + (a >> 32) + (b & 0xFFFFFFFF);
        if (k < 8) { col[k + 2] = col[k + 2] + (b >> 32); }
        k = k + 1;
    }
    k = 0;
    while (k < 8) {                               # carries; each column is below 2^35
        col[k + 1] = col[k + 1] + (col[k] >> 32);
        col[k] = col[k] & 0xFFFFFFFF;
        k = k + 1;
    }
    var top = col[8] & 0xFFFFFFFF;
    var q = top >> 30;
    col[8] = top & 0x3FFFFFFF;
    var neg = 0;
    if ((top & 0x20000000) != 0) {                # f ≥ 1/2: f − 1 = −(2^286 − F)·2^-286
        neg = 1;
        q = q + 1;
        var c = 1;
        k = 0;
        while (k < 9) {
            var mask = 0xFFFFFFFF;
            if (k == 8) { mask = 0x3FFFFFFF; }
            var t = (mask - col[k]) + c;
            col[k] = t & mask;
            c = t >> 32;
            k = k + 1;
        }
    }
    var lead: f64 = f64_from(col[8]);
    var s30: f64 = 0x3E10000000000000;            # 2^-30
    var h: f64 = lead * s30;
    var mm: f64 = 0.0;
    var l: f64 = 0.0;
    k = 7;
    while (k >= 0) {
        var lf: f64 = f64_from(col[k]);
        var sc: f64 = _pmn_km_cr_pow2(32 * k - 286);
        var d: f64 = lf * sc;                     # exact: 32 bits at a normal scale
        var h2, m2, l2 = _pmn_km_td_add_d(h, mm, l, d);
        h = h2;
        mm = m2;
        l = l2;
        k = k - 1;
    }
    var ph: f64 = _PMN_KM_CR_SC_PIO2H;
    var pm: f64 = _PMN_KM_CR_SC_PIO2M;
    var pl: f64 = _PMN_KM_CR_SC_PIO2L;
    var rh, rm, rl = _pmn_km_td_mul(h, mm, l, ph, pm, pl);
    if (neg == 1) {
        rh = -rh;
        rm = -rm;
        rl = -rl;
    }
    store64(out, rh);
    store64(out + 8, rm);
    store64(out + 16, rl);
    return q;
}

# The fast evaluation of ±sin r / ±cos r (q = 0: sin r, 1: cos r, 2: −sin r, 3: −cos r) for r = rh + rl,
# |r| ≤ π/4 + 2^-30, |rl| ≤ 2^-53·|rh|, with the reduction's absolute error dr: (hi, lo, err) with
# |hi + lo − f| < err less the test's own rounding (the bound above).
#must_use
fn _pmn_km_sc_eval(q, rh: f64, rl: f64, dr: f64): (f64, f64, f64) {
    var cc: f64 = rh + 26388279066624.0;          # 1.5·2^44: rounds rh to a multiple of 2^-8
    var ad: f64 = cc - 26388279066624.0;
    var i = load64(&cc) - 0x42B8000000000000;
    var th: f64 = rh - ad;                        # exact, |th| ≤ 2^-9
    var ai = i;
    if (i < 0) { ai = 0 - i; }
    var off = ai * 64;
    var sa: f64 = load64(&_PMN_KM_CR_SC_T + off);
    var sb: f64 = load64(&_PMN_KM_CR_SC_T + off + 8);
    var ca: f64 = load64(&_PMN_KM_CR_SC_T + off + 32);
    var cb: f64 = load64(&_PMN_KM_CR_SC_T + off + 40);
    if (i < 0) {
        sa = -sa;
        sb = -sb;
    }
    var ua: f64 = sa;
    var ub: f64 = sb;
    var va: f64 = ca;
    var vb: f64 = cb;
    if ((q & 1) == 1) {
        ua = ca;
        ub = cb;
        va = -sa;
        vb = -sb;
    }
    if ((q & 2) == 2) {
        ua = -ua;
        ub = -ub;
        va = -va;
        vb = -vb;
    }
    var t1: f64 = th;
    var t2: f64 = 0.0;
    if (i != 0) {
        var ct: f64 = th + 98304.0;               # 1.5·2^16: rounds th to a multiple of 2^-36
        t1 = ct - 98304.0;
        t2 = th - t1;
    }
    var p1: f64 = va * t1;                        # exact
    var hi: f64 = ua + p1;
    var e1: f64 = p1 - (hi - ua);
    var s3: f64 = _PMN_KM_CR_SC_S3;
    var s5: f64 = _PMN_KM_CR_SC_S5;
    var s7: f64 = _PMN_KM_CR_SC_S7;
    var c4: f64 = _PMN_KM_CR_SC_C4;
    var c6: f64 = _PMN_KM_CR_SC_C6;
    var z: f64 = th * th;
    var cm1: f64 = z * ((z * (c4 + (z * c6))) - 0.5);
    var sm: f64 = (th * z) * (s3 + (z * (s5 + (z * s7))));
    var uf: f64 = ua + ub;
    var vf: f64 = va + vb;
    var small: f64 = (e1 + (va * t2)) + (vb * th);
    var mid: f64 = (vf * sm) + (rl * (vf - (uf * th)));
    var big: f64 = ub + (uf * cm1);
    var lo: f64 = (small + mid) + big;
    var aua: f64 = f64_abs(ua);
    var ahi: f64 = f64_abs(hi);
    var k68: f64 = 0x3BB0000000000000;            # 2^-68
    var k69: f64 = 0x3BA0000000000000;            # 2^-69
    var err: f64 = ((aua * k68) + (ahi * k69)) + dr;
    return (hi, lo, err);
}

# The fast core for a = |x|, 2^-27 ≤ a < +∞ (bits ax), sel = 0 for sin, 1 for cos: (hi, lo, err) for f(a).
#must_use
fn _pmn_km_sc_core(ax, sel): (f64, f64, f64) {
    var a: f64 = ax;
    if (ax >= 0x4130000000000000) {               # a ≥ 2^20: Payne–Hanek
        var rb: f64[3];
        var kp = _pmn_km_ph_reduce(ax, &rb);
        var ph, pl, pe = _pmn_km_sc_eval((kp + sel) & 3, rb[0], rb[1], 0.0);
        return (ph, pl, pe);
    }
    var inv: f64 = _PMN_KM_CR_SC_INVPIO2;
    var p1: f64 = _PMN_KM_CR_SC_P1;
    var p2: f64 = _PMN_KM_CR_SC_P2;
    var p3: f64 = _PMN_KM_CR_SC_P3;
    var tt: f64 = (a * inv) + 6755399441055744.0; # 1.5·2^52: rounds a·2/π to an integer
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var d1: f64 = a - (kd * p1);                  # exact
    var q2: f64 = kd * p2;                        # exact
    var nq2: f64 = -q2;
    var s: f64 = d1 + nq2;                        # TwoSum(d1, −k·P2)
    var bb: f64 = s - d1;
    var e: f64 = (d1 - (s - bb)) + (nq2 - bb);
    var w: f64 = e - (kd * p3);
    var rh: f64 = s + w;                          # Fast2Sum: |rl| ≤ 2^-53·|rh|
    var rl: f64 = w - (rh - s);
    var k119: f64 = 0x3880000000000000;           # 2^-119
    var dr: f64 = kd * k119;
    var hi, lo, err = _pmn_km_sc_eval((k + sel) & 3, rh, rl, dr);
    return (hi, lo, err);
}

# The accurate reduction of a = |x| ≥ 2^-27 (bits ax): k and r = a − k·π/2 as a triple-double at out[0..2].
fn _pmn_km_sc_reduce_acc(ax, out): i64 {
    if (ax >= 0x4130000000000000) {
        var kp = _pmn_km_ph_reduce(ax, out);
        return kp;
    }
    var a: f64 = ax;
    var inv: f64 = _PMN_KM_CR_SC_INVPIO2;
    var p1: f64 = _PMN_KM_CR_SC_P1;
    var p2: f64 = _PMN_KM_CR_SC_P2;
    var tt: f64 = (a * inv) + 6755399441055744.0;
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var d1: f64 = a - (kd * p1);
    var q2: f64 = kd * p2;
    var h, m = _pmn_km_two_sum(d1, -q2);
    var l: f64 = 0.0;
    var n = 0;
    while (n < 3) {                               # k·P3, k·P4, k·P5 by TwoProduct
        var pv: f64 = _PMN_KM_CR_SC_P3;
        if (n == 1) { pv = _PMN_KM_CR_SC_P4; }
        if (n == 2) { pv = _PMN_KM_CR_SC_P5; }
        var ph, pe = _pmn_km_two_prod(kd, pv);
        var a0, a1, a2 = _pmn_km_td_add_d(h, m, l, -ph);
        var b0, b1, b2 = _pmn_km_td_add_d(a0, a1, a2, -pe);
        h = b0;
        m = b1;
        l = b2;
        n = n + 1;
    }
    store64(out, h);
    store64(out + 8, m);
    store64(out + 16, l);
    return k;
}

# U·cos t + V·sin t in triple-double for quadrant q, from buf = S (sin a), C (cos a), sin t, cos t (four
# triple-doubles, 12 words), at out[0..2].
fn _pmn_km_sc_comb(q, buf, out) {
    var uo = 0;                                   # U = S, V = C (sin type) or U = C, V = −S (cos type)
    var vo = 24;
    var vs: f64 = 1.0;
    if ((q & 1) == 1) {
        uo = 24;
        vo = 0;
        vs = -1.0;
    }
    var us: f64 = 1.0;
    if ((q & 2) == 2) {
        us = -1.0;
        vs = -vs;
    }
    var u0: f64 = load64(buf + uo);
    var u1: f64 = load64(buf + uo + 8);
    var u2: f64 = load64(buf + uo + 16);
    var v0: f64 = load64(buf + vo);
    var v1: f64 = load64(buf + vo + 8);
    var v2: f64 = load64(buf + vo + 16);
    var c0: f64 = load64(buf + 72);
    var c1: f64 = load64(buf + 80);
    var c2: f64 = load64(buf + 88);
    var s0: f64 = load64(buf + 48);
    var s1: f64 = load64(buf + 56);
    var s2: f64 = load64(buf + 64);
    var ah, am, al = _pmn_km_td_mul(u0 * us, u1 * us, u2 * us, c0, c1, c2);   # ±1 scalings are exact
    var bh, bm, bl = _pmn_km_td_mul(v0 * vs, v1 * vs, v2 * vs, s0, s1, s2);
    var rh, rm, rl = _pmn_km_td_add(ah, am, al, bh, bm, bl);
    store64(out, rh);
    store64(out + 8, rm);
    store64(out + 16, rl);
}

# The accurate f_q(r) for r = r0 + r1 + r2 at out[0..2], and f_(q+1)(r) at out[3..5] when both = 1.
fn _pmn_km_sc_acc_td(q, r0: f64, r1: f64, r2: f64, both, out) {
    var cc: f64 = r0 + 26388279066624.0;
    var ad: f64 = cc - 26388279066624.0;
    var i = load64(&cc) - 0x42B8000000000000;
    var t0: f64 = r0 - ad;                        # exact
    var th, tm, tl = _pmn_km_td_add_d(r1, r2, 0.0, t0);
    var zh, zm, zl = _pmn_km_td_mul(th, tm, tl, th, tm, tl);
    var wh: f64 = -zh;                            # w = −t²
    var wm: f64 = -zm;
    var wl: f64 = -zl;
    var ph: f64 = load64(&_PMN_KM_CR_EXP_ACC + 264);  # 1/13! (index 3·(13 − 2))
    var pm: f64 = load64(&_PMN_KM_CR_EXP_ACC + 272);
    var pl: f64 = load64(&_PMN_KM_CR_EXP_ACC + 280);
    var k = 11;
    while (k >= 3) {                              # 1/k! + w·P for k = 11, 9, …, 3
        var ah, am, al = _pmn_km_td_mul(ph, pm, pl, wh, wm, wl);
        var off = (k - 2) * 24;
        var ch: f64 = load64(&_PMN_KM_CR_EXP_ACC + off);
        var cm: f64 = load64(&_PMN_KM_CR_EXP_ACC + off + 8);
        var cl: f64 = load64(&_PMN_KM_CR_EXP_ACC + off + 16);
        var bh, bm, bl = _pmn_km_td_add(ch, cm, cl, ah, am, al);
        ph = bh;
        pm = bm;
        pl = bl;
        k = k - 2;
    }
    var sh1, sm1, sl1 = _pmn_km_td_mul(ph, pm, pl, wh, wm, wl);
    var sh2, sm2, sl2 = _pmn_km_td_add_d(sh1, sm1, sl1, 1.0);
    var snh, snm, snl = _pmn_km_td_mul(sh2, sm2, sl2, th, tm, tl);       # sin t
    ph = load64(&_PMN_KM_CR_EXP_ACC + 240);           # 1/12!
    pm = load64(&_PMN_KM_CR_EXP_ACC + 248);
    pl = load64(&_PMN_KM_CR_EXP_ACC + 256);
    k = 10;
    while (k >= 2) {                              # 1/k! + w·P for k = 10, 8, …, 2
        var dh, dm, dl = _pmn_km_td_mul(ph, pm, pl, wh, wm, wl);
        var off2 = (k - 2) * 24;
        var eh: f64 = load64(&_PMN_KM_CR_EXP_ACC + off2);
        var em: f64 = load64(&_PMN_KM_CR_EXP_ACC + off2 + 8);
        var el: f64 = load64(&_PMN_KM_CR_EXP_ACC + off2 + 16);
        var fh, fm, fl = _pmn_km_td_add(eh, em, el, dh, dm, dl);
        ph = fh;
        pm = fm;
        pl = fl;
        k = k - 2;
    }
    var ch1, cm1, cl1 = _pmn_km_td_mul(ph, pm, pl, wh, wm, wl);
    var csh, csm, csl = _pmn_km_td_add_d(ch1, cm1, cl1, 1.0);           # cos t
    var ai = i;
    if (i < 0) { ai = 0 - i; }
    var to = ai * 64;
    var buf: f64[12];
    var g = 0;
    while (g < 2) {                               # S then C, each A + B + C + D renormalised
        var xa: f64 = load64(&_PMN_KM_CR_SC_T + to + 32 * g);
        var xb: f64 = load64(&_PMN_KM_CR_SC_T + to + 32 * g + 8);
        var xc: f64 = load64(&_PMN_KM_CR_SC_T + to + 32 * g + 16);
        var xd: f64 = load64(&_PMN_KM_CR_SC_T + to + 32 * g + 24);
        var y0, y1a = _pmn_km_fast_two_sum(xa, xb);
        var y1, y2a = _pmn_km_fast_two_sum(y1a, xc);
        var y2: f64 = y2a + xd;
        if (g == 0 && i < 0) {
            y0 = -y0;
            y1 = -y1;
            y2 = -y2;
        }
        buf[3 * g] = y0;
        buf[3 * g + 1] = y1;
        buf[3 * g + 2] = y2;
        g = g + 1;
    }
    buf[6] = snh;
    buf[7] = snm;
    buf[8] = snl;
    buf[9] = csh;
    buf[10] = csm;
    buf[11] = csl;
    _pmn_km_sc_comb(q, &buf, out);
    if (both == 1) { _pmn_km_sc_comb(q + 1, &buf, out + 24); }
}

# The accurate path for f(|x|), sel = 0 sin, 1 cos, bits ax with 2^-27 ≤ |x| < ∞.
#must_use
fn _pmn_km_sc_acc(ax, sel): f64 {
    var rb: f64[3];
    var k = _pmn_km_sc_reduce_acc(ax, &rb);
    var ob: f64[6];
    _pmn_km_sc_acc_td((k + sel) & 3, rb[0], rb[1], rb[2], 0, &ob);
    var r: f64 = _pmn_km_rn3(ob[0], ob[1], ob[2]);
    return r;
}

# sin(x), correctly rounded. sin(±0) = ±0 (as every |x| < 2^-26: x), NaN for NaN and ±∞. Mirrors `f64::sin`.
#must_use
fn _pmn_km_cr_sin(x: f64): f64 {
    var ux = load64(&x);
    var ax = ux & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3E50000000000000) { return x; }   # |x| < 2^-26
    if (ax >= 0x7FF0000000000000) {
        if (ax > 0x7FF0000000000000) { return x; }
        var nan: f64 = _pmn_km_nan();               # the same quiet NaN on every target
        return nan;
    }
    if (ax >= 0x4130000000000000) {               # |x| ≥ 2^20: Payne–Hanek, through _pmn_km_sc_core
        var ph, pl, pe = _pmn_km_sc_core(ax, 0);
        var pu: f64 = ph + (pl - pe);
        var pv: f64 = ph + (pl + pe);
        if (pu != pv) { pu = _pmn_km_sc_acc(ax, 0); }
        if (ux < 0) { pu = -pu; }
        return pu;
    }
    var a: f64 = ax;                              # _pmn_km_sc_core's Cody–Waite reduction, inline
    var inv: f64 = _PMN_KM_CR_SC_INVPIO2;
    var p1: f64 = _PMN_KM_CR_SC_P1;
    var p2: f64 = _PMN_KM_CR_SC_P2;
    var p3: f64 = _PMN_KM_CR_SC_P3;
    var tt: f64 = (a * inv) + 6755399441055744.0;
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var d1: f64 = a - (kd * p1);
    var q2: f64 = kd * p2;
    var nq2: f64 = -q2;
    var s: f64 = d1 + nq2;
    var bb: f64 = s - d1;
    var e: f64 = (d1 - (s - bb)) + (nq2 - bb);
    var w: f64 = e - (kd * p3);
    var rh: f64 = s + w;
    var rl: f64 = w - (rh - s);
    var k119: f64 = 0x3880000000000000;
    var dr: f64 = kd * k119;
    var hi, lo, err = _pmn_km_sc_eval(k & 3, rh, rl, dr);
    var u: f64 = hi + (lo - err);
    var v: f64 = hi + (lo + err);
    var r: f64 = u;
    if (u != v) { r = _pmn_km_sc_acc(ax, 0); }
    if (ux < 0) { r = -r; }
    return r;
}

# cos(x), correctly rounded. cos(±0) = 1 (as every |x| < 2^-27), NaN for NaN and ±∞. Mirrors `f64::cos`.
#must_use
fn _pmn_km_cr_cos(x: f64): f64 {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3E40000000000000) { return 1.0; }   # |x| < 2^-27
    if (ax >= 0x7FF0000000000000) {
        if (ax > 0x7FF0000000000000) { return x; }
        var nan: f64 = _pmn_km_nan();
        return nan;
    }
    if (ax >= 0x4130000000000000) {               # |x| ≥ 2^20: Payne–Hanek, through _pmn_km_sc_core
        var ph, pl, pe = _pmn_km_sc_core(ax, 1);
        var pu: f64 = ph + (pl - pe);
        var pv: f64 = ph + (pl + pe);
        if (pu == pv) { return pu; }
        var pa: f64 = _pmn_km_sc_acc(ax, 1);
        return pa;
    }
    var a: f64 = ax;                              # _pmn_km_sc_core's Cody–Waite reduction, inline
    var inv: f64 = _PMN_KM_CR_SC_INVPIO2;
    var p1: f64 = _PMN_KM_CR_SC_P1;
    var p2: f64 = _PMN_KM_CR_SC_P2;
    var p3: f64 = _PMN_KM_CR_SC_P3;
    var tt: f64 = (a * inv) + 6755399441055744.0;
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var d1: f64 = a - (kd * p1);
    var q2: f64 = kd * p2;
    var nq2: f64 = -q2;
    var s: f64 = d1 + nq2;
    var bb: f64 = s - d1;
    var e: f64 = (d1 - (s - bb)) + (nq2 - bb);
    var w: f64 = e - (kd * p3);
    var rh: f64 = s + w;
    var rl: f64 = w - (rh - s);
    var k119: f64 = 0x3880000000000000;
    var dr: f64 = kd * k119;
    var hi, lo, err = _pmn_km_sc_eval((k + 1) & 3, rh, rl, dr);
    var u: f64 = hi + (lo - err);
    var v: f64 = hi + (lo + err);
    if (u == v) { return u; }
    var r: f64 = _pmn_km_sc_acc(ax, 1);
    return r;
}

# The fast atan core for n = nh + nl, d = dh + dl with 0 < n ≤ d (1 + 2^-50), dh in [1/2, 2), nh ≥ 2^-62·dh:
# (hi, lo, err) for offset ± atan(n/d) by oct.
#must_use
fn _pmn_km_atan_core(nh: f64, nl: f64, dh: f64, dl: f64, oct): (f64, f64, f64) {
    var zh: f64 = nh / dh;
    var cz: f64 = zh + 26388279066624.0;          # 1.5·2^44: rounds n/d to a multiple of 2^-8
    var c: f64 = cz - 26388279066624.0;
    var j = load64(&cz) - 0x42B8000000000000;
    var sh: f64 = nh;
    var sl: f64 = nl;
    var eh: f64 = dh;
    var el: f64 = dl;
    if (j != 0) {
        var d1: f64 = (dh + 384.0) - 384.0;       # 1.5·2^8: dh on the 2^-44 grid
        var d2: f64 = dh - d1;
        var n1: f64 = (nh + 384.0) - 384.0;
        var n2: f64 = nh - n1;
        var p1: f64 = c * d1;                     # exact
        var np1: f64 = -p1;
        var u: f64 = nh + np1;                    # TwoSum(nh, −c·d1)
        var ub: f64 = u - nh;
        var ue: f64 = (nh - (u - ub)) + (np1 - ub);
        sh = u;
        sl = ((ue - (c * d2)) + nl) - (c * dl);
        var q1: f64 = c * n1;                     # exact
        var v: f64 = dh + q1;                     # TwoSum(dh, c·n1)
        var vb: f64 = v - dh;
        var ve: f64 = (dh - (v - vb)) + (q1 - vb);
        eh = v;
        el = ((ve + (c * n2)) + dl) + (c * nl);
    }
    var qh: f64 = sh / eh;                        # δ = qh + ql: Dekker's division
    var cq: f64 = 134217729.0 * qh;
    var q1h: f64 = cq - (cq - qh);
    var q1l: f64 = qh - q1h;
    var ce: f64 = 134217729.0 * eh;
    var e1h: f64 = ce - (ce - eh);
    var e1l: f64 = eh - e1h;
    var pp: f64 = qh * eh;
    var pe: f64 = (((q1h * e1h) - pp) + (q1h * e1l) + (q1l * e1h)) + (q1l * e1l);
    var ql: f64 = ((((sh - pp) - pe) + sl) - (qh * el)) / eh;
    var a3: f64 = _PMN_KM_CR_SC_A3;
    var a5: f64 = _PMN_KM_CR_SC_A5;
    var a7: f64 = _PMN_KM_CR_SC_A7;
    var a9: f64 = _PMN_KM_CR_SC_A9;
    var z: f64 = qh * qh;
    var pz: f64 = ((qh * z) * (a3 + (z * (a5 + (z * (a7 + (z * a9))))))) - (ql * z);
    var ah: f64 = load64(&_PMN_KM_CR_ATAN_T + 24 * j);
    var am: f64 = load64(&_PMN_KM_CR_ATAN_T + 24 * j + 8);
    var oh: f64 = 0.0;
    var om: f64 = 0.0;
    var sg: f64 = 1.0;
    if (oct == 1) {
        oh = _PMN_KM_CR_SC_PIH;
        om = _PMN_KM_CR_SC_PIM;
        sg = -1.0;
    }
    if (oct >= 2) {
        oh = _PMN_KM_CR_SC_PIO2H;
        om = _PMN_KM_CR_SC_PIO2M;
        if (oct == 2) { sg = -1.0; }
    }
    var sah: f64 = sg * ah;
    var h1: f64 = oh + sah;                       # Fast2Sum: |oh| ≥ |ah| or oh = 0
    var f1: f64 = sah - (h1 - oh);
    var sqh: f64 = sg * qh;
    var hi: f64 = h1 + sqh;                       # Fast2Sum: |h1| ≥ |qh| or h1 = 0
    var f2: f64 = sqh - (hi - h1);
    var tl: f64 = (am + ql) + pz;
    var lo: f64 = ((f1 + f2) + om) + (sg * tl);
    var ahi: f64 = f64_abs(hi);
    var k68: f64 = 0x3BA6A09E667F3BCD;            # 2^-68.5 (√2·2^-69)
    var err: f64 = ahi * k68;
    return (hi, lo, err);
}

# The fast atan core with its rounding test: (RN(result), 1) or (0, 0).
#must_use
fn _pmn_km_atan_fast(nh: f64, nl: f64, dh: f64, dl: f64, oct): (f64, i64) {
    var hi, lo, err = _pmn_km_atan_core(nh, nl, dh, dl, oct);
    var u: f64 = hi + (lo - err);
    var v: f64 = hi + (lo + err);
    if (u != v) { return (0.0, 0); }
    return (u, 1);
}

# A triple-double renormalised (two bottom-up TwoSum passes): after a cancellation _pmn_km_td_add's leading word can
# be far from the sum (its last renormalisation does not see the rounded third-order term), and the corrections
# below need the leading word to be the sum to 2^-52. The sum is unchanged (every step is exact).
#must_use
fn _pmn_km_td_norm(a0: f64, a1: f64, a2: f64): (f64, f64, f64) {
    var s, e = _pmn_km_two_sum(a1, a2);
    var h, u = _pmn_km_two_sum(a0, s);
    var m, l = _pmn_km_two_sum(u, e);
    var h2, u2 = _pmn_km_two_sum(h, m);
    var m2, l2 = _pmn_km_two_sum(u2, l);
    return (h2, m2, l2);
}

# (a0, a1, a2)/(b0, b1, b2) as a triple-double at out[0..2], b ≠ 0 normalised: q0 = a0/b0 (a renormalised first),
# then two corrections from the remainder a − q·b, computed in triple-double (each below 2^-153 of a) and
# renormalised: relative error below 2^-151.
fn _pmn_km_td_div(a0: f64, a1: f64, a2: f64, b0: f64, b1: f64, b2: f64, out) {
    var n0, n1, n2 = _pmn_km_td_norm(a0, a1, a2);
    var q0: f64 = n0 / b0;
    var t0, t1, t2 = _pmn_km_td_mul_d(b0, b1, b2, q0);
    var ra, rb, rc = _pmn_km_td_add(n0, n1, n2, -t0, -t1, -t2);
    var r0, r1, r2 = _pmn_km_td_norm(ra, rb, rc);
    var q1: f64 = r0 / b0;
    var u0, u1, u2 = _pmn_km_td_mul_d(b0, b1, b2, q1);
    var sa, sb, sc = _pmn_km_td_add(r0, r1, r2, -u0, -u1, -u2);
    var s0, s1, s2 = _pmn_km_td_norm(sa, sb, sc);
    var q2: f64 = s0 / b0;
    var h, m0 = _pmn_km_fast_two_sum(q0, q1);
    var m, l = _pmn_km_two_sum(m0, q2);
    store64(out, h);
    store64(out + 8, m);
    store64(out + 16, l);
}

# The accurate atan core: RN(offset ± atan(n/d)) by oct, for triple-doubles 0 < n ≤ d (1 + 2^-50), n0 ≥ 2^-62·d0.
#must_use
fn _pmn_km_atan_acc(n0: f64, n1: f64, n2: f64, d0: f64, d1: f64, d2: f64, oct): f64 {
    var rb: f64[3];
    _pmn_km_atan_acc_td(n0, n1, n2, d0, d1, d2, oct, &rb);
    var r: f64 = _pmn_km_rn3(rb[0], rb[1], rb[2]);
    return r;
}

# offset ± atan(n/d) as a triple-double at out[0..2] (the accurate atan core before its rounding).
fn _pmn_km_atan_acc_td(n0: f64, n1: f64, n2: f64, d0: f64, d1: f64, d2: f64, oct, out) {
    var zh: f64 = n0 / d0;
    var cz: f64 = zh + 26388279066624.0;
    var c: f64 = cz - 26388279066624.0;
    var j = load64(&cz) - 0x42B8000000000000;
    var a0: f64 = n0;
    var a1: f64 = n1;
    var a2: f64 = n2;
    var b0: f64 = d0;
    var b1: f64 = d1;
    var b2: f64 = d2;
    if (j != 0) {                                 # num = n − c·d, den = d + c·n
        var cd0, cd1, cd2 = _pmn_km_td_mul_d(d0, d1, d2, c);
        var x0, x1, x2 = _pmn_km_td_add(n0, n1, n2, -cd0, -cd1, -cd2);
        var cn0, cn1, cn2 = _pmn_km_td_mul_d(n0, n1, n2, c);
        var y0, y1, y2 = _pmn_km_td_add(d0, d1, d2, cn0, cn1, cn2);
        a0 = x0;
        a1 = x1;
        a2 = x2;
        b0 = y0;
        b1 = y1;
        b2 = y2;
    }
    var db: f64[3];
    _pmn_km_td_div(a0, a1, a2, b0, b1, b2, &db);
    var dh: f64 = db[0];
    var dm: f64 = db[1];
    var dl: f64 = db[2];
    var wh, wm, wl = _pmn_km_td_mul(dh, dm, dl, dh, dm, dl);
    var ph: f64 = load64(&_PMN_KM_CR_ATAN_ACC + 168);  # 1/17 (index 3·(8 − 1))
    var pm: f64 = load64(&_PMN_KM_CR_ATAN_ACC + 176);
    var pl: f64 = load64(&_PMN_KM_CR_ATAN_ACC + 184);
    var k = 7;
    while (k >= 1) {                              # (−1)^k/(2k + 1) + w·P
        var th, tm, tl = _pmn_km_td_mul(ph, pm, pl, wh, wm, wl);
        var off = (k - 1) * 24;
        var ch: f64 = load64(&_PMN_KM_CR_ATAN_ACC + off);
        var cm: f64 = load64(&_PMN_KM_CR_ATAN_ACC + off + 8);
        var cl: f64 = load64(&_PMN_KM_CR_ATAN_ACC + off + 16);
        var uh, um, ul = _pmn_km_td_add(ch, cm, cl, th, tm, tl);
        ph = uh;
        pm = um;
        pl = ul;
        k = k - 1;
    }
    var vh, vm, vl = _pmn_km_td_mul(wh, wm, wl, ph, pm, pl);
    var xh, xm, xl = _pmn_km_td_mul(vh, vm, vl, dh, dm, dl);
    var th2, tm2, tl2 = _pmn_km_td_add(dh, dm, dl, xh, xm, xl);          # atan δ
    var ah: f64 = load64(&_PMN_KM_CR_ATAN_T + 24 * j);
    var am: f64 = load64(&_PMN_KM_CR_ATAN_T + 24 * j + 8);
    var al: f64 = load64(&_PMN_KM_CR_ATAN_T + 24 * j + 16);
    var gh, gm, gl = _pmn_km_td_add(ah, am, al, th2, tm2, tl2);          # θ
    if (oct == 0) {
        store64(out, gh);
        store64(out + 8, gm);
        store64(out + 16, gl);
        return;
    }
    var oh: f64 = _PMN_KM_CR_SC_PIO2H;
    var om: f64 = _PMN_KM_CR_SC_PIO2M;
    var ol: f64 = _PMN_KM_CR_SC_PIO2L;
    if (oct == 1) {
        oh = _PMN_KM_CR_SC_PIH;
        om = _PMN_KM_CR_SC_PIM;
        ol = _PMN_KM_CR_SC_PIL;
    }
    if (oct != 3) {
        gh = -gh;
        gm = -gm;
        gl = -gl;
    }
    var rh, rm, rl = _pmn_km_td_add(oh, om, ol, gh, gm, gl);
    store64(out, rh);
    store64(out + 8, rm);
    store64(out + 16, rl);
}

# A positive finite nonzero double from its bits b as (m, e), b's value = m·2^e with m in [1, 2).
#must_use
fn _pmn_km_frexp(b): (f64, i64) {
    var bb = b;
    var eo = 0;
    if ((b >> 52) == 0) {                         # subnormal: scale by 2^54 (exact)
        var v: f64 = b;
        var p54: f64 = 0x4350000000000000;
        var vs: f64 = v * p54;
        bb = load64(&vs);
        eo = 0 - 54;
    }
    var mb = (bb & 0x000FFFFFFFFFFFFF) | 0x3FF0000000000000;
    var m: f64 = mb;
    return (m, (bb >> 52) - 1023 + eo);
}

# atan2 for |n/d| < 2^-59 (n = mn·2^en, d = md·2^ed, mn and md in [1, 2), en − ed ≤ −60), unsigned:
# π/2 ∓ atan(n/d) rounds to π/2 (the quotient is below 2^-55 and π/2 is 2^-54.15 inside its rounding interval),
# π − atan(n/d) to π (likewise, 2^-52.86 inside); atan(q) itself lies in (q − q³/3, q), with q²/3 < 2^-119
# below any distance from a non-midpoint quotient of two doubles to a rounding boundary (at least 2^-107 of q,
# or 2^-1128 on the subnormal grid), so it rounds as q does unless q is exactly a midpoint (possible only in
# the subnormal range, e.g. 3·2^-1075 = atan2(3·2^-60, 2^1015)), where it rounds toward zero. q = qs·2^(en − ed)
# with qs = mn/md as q0 + q1 + q2 (Dekker's division, the remainders exact): an exact qs (q1 = 0) is lowered by
# q0·2^-100 to break the tie, and _pmn_km_cr_finish rounds once, at the subnormal grid when the result is subnormal.
#must_use
fn _pmn_km_atan2_tiny(mn: f64, md: f64, e, oct): f64 {
    if (oct >= 2) {
        var p2: f64 = _PMN_KM_CR_SC_PIO2H;
        return p2;
    }
    if (oct == 1) {
        var pi: f64 = _PMN_KM_CR_SC_PIH;
        return pi;
    }
    if (e < 0 - 1077) { return 0.0; }             # q < 2^-1076: below half of 2^-1074
    var q0: f64 = mn / md;
    var p, pe = _pmn_km_two_prod(q0, md);
    var r1: f64 = (mn - p) - pe;                  # exact
    var q1: f64 = r1 / md;
    var p2b, pe2 = _pmn_km_two_prod(q1, md);
    var r2: f64 = (r1 - p2b) - pe2;
    var q2: f64 = r2 / md;
    var tiny: f64 = 0x39B0000000000000;           # 2^-100
    if (r1 == 0.0) {
        q1 = -(q0 * tiny);
        q2 = 0.0;
    }
    var ee = e;
    if (q0 < 1.0) {                               # into [1, 2) for _pmn_km_cr_finish: exact
        q0 = q0 * 2.0;
        q1 = q1 * 2.0;
        q2 = q2 * 2.0;
        ee = ee - 1;
    }
    var r: f64 = _pmn_km_cr_finish(ee, q0, q1, q2);
    return r;
}

# atan2(y, x) for finite nonzero y and x, |y| = ay, |x| = ax (bits), the sign of x xneg: by the fast path
# (acc = 0: (result, 1) or (0, 0)) or the accurate one (acc = 1), unsigned.
#must_use
fn _pmn_km_atan2_pos(ay, ax, xneg, acc): (f64, i64) {
    var nb = ay;
    var db = ax;
    var oct = 0;
    if (xneg == 1) { oct = 1; }
    if (ay > ax) {
        nb = ax;
        db = ay;
        oct = 2;
        if (xneg == 1) { oct = 3; }
    }
    var mn, en = _pmn_km_frexp(nb);
    var md, ed = _pmn_km_frexp(db);
    if (en - ed <= 0 - 60) {
        var t: f64 = _pmn_km_atan2_tiny(mn, md, en - ed, oct);
        return (t, 1);
    }
    var sc: f64 = _pmn_km_cr_pow2(en - ed);
    var n: f64 = mn * sc;                         # exact: n/d ≥ 2^-60
    if (acc == 1) {
        var a: f64 = _pmn_km_atan_acc(n, 0.0, 0.0, md, 0.0, 0.0, oct);
        return (a, 1);
    }
    var r, ok = _pmn_km_atan_fast(n, 0.0, md, 0.0, oct);
    return (r, ok);
}

# The special values of atan2 (C99 Annex F, as glibc and Rust's f64::atan2): (result, 1), or (0, 0) for finite
# nonzero y and x. A NaN argument is returned as it is (y's first).
#must_use
fn _pmn_km_atan2_special(y: f64, x: f64): (f64, i64) {
    var uy = load64(&y);
    var ux = load64(&x);
    var ay = uy & 0x7FFFFFFFFFFFFFFF;
    var ax = ux & 0x7FFFFFFFFFFFFFFF;
    if (ay > 0x7FF0000000000000) { return (y, 1); }
    if (ax > 0x7FF0000000000000) { return (x, 1); }
    var r: f64 = 0.0;
    var found = 0;
    if (ay == 0) {                                # atan2(±0, x): ±0 for x ≥ +0, ±π for x ≤ −0
        found = 1;
        if (ux < 0) { r = _PMN_KM_CR_SC_PIH; }
    } elif (ax == 0) {                            # atan2(y ≠ 0, ±0) = ±π/2
        found = 1;
        r = _PMN_KM_CR_SC_PIO2H;
    } elif (ax == 0x7FF0000000000000) {
        found = 1;
        if (ay == 0x7FF0000000000000) {           # ±π/4, ±3π/4
            r = _PMN_KM_CR_SC_PIO4;
            if (ux < 0) { r = _PMN_KM_CR_SC_PI3O4; }
        } elif (ux < 0) {                         # finite y, x = −∞: ±π; x = +∞: ±0
            r = _PMN_KM_CR_SC_PIH;
        }
    } elif (ay == 0x7FF0000000000000) {           # y = ±∞, x finite: ±π/2
        found = 1;
        r = _PMN_KM_CR_SC_PIO2H;
    }
    if (found == 0) { return (0.0, 0); }
    if (uy < 0) { r = -r; }
    return (r, 1);
}

# atan2(y, x), correctly rounded, the angle of (x, y) in [−π, π]. Mirrors `f64::atan2`.
#must_use
fn _pmn_km_cr_atan2(y: f64, x: f64): f64 {
    var uy0 = load64(&y);
    var ux0 = load64(&x);
    var ay0 = uy0 & 0x7FFFFFFFFFFFFFFF;
    var ax0 = ux0 & 0x7FFFFFFFFFFFFFFF;
    var ey = ay0 >> 52;
    var ex = ax0 >> 52;
    # Both normal and finite (biased exponents 1 … 2046, an unsigned range test each) with |n/d| ≥ 2^-59: the
    # scaling of _pmn_km_atan2_pos done on the bits (n's significand at exponent en − ed, d's at 0: the same
    # doubles), then the fast core and its test, inline.
    if (((ey - 1) ^ 0x8000000000000000) < 0x80000000000007FE) {
        if (((ex - 1) ^ 0x8000000000000000) < 0x80000000000007FE) {
            var nb = ay0;
            var db = ax0;
            var en = ey;
            var ed = ex;
            var oct = 0;
            if (ux0 < 0) { oct = 1; }
            if (ay0 > ax0) {
                nb = ax0;
                db = ay0;
                en = ex;
                ed = ey;
                oct = oct + 2;
            }
            if (ed - en < 60) {
                var nbits = (nb & 0x000FFFFFFFFFFFFF) | ((1023 + en - ed) << 52);
                var dbits = (db & 0x000FFFFFFFFFFFFF) | 0x3FF0000000000000;
                var n: f64 = nbits;
                var d: f64 = dbits;
                var hi, lo, err = _pmn_km_atan_core(n, 0.0, d, 0.0, oct);
                var u: f64 = hi + (lo - err);
                var v: f64 = hi + (lo + err);
                if (u != v) { u = _pmn_km_atan_acc(n, 0.0, 0.0, d, 0.0, 0.0, oct); }
                if (uy0 < 0) { u = -u; }
                return u;
            }
        }
    }
    var s, sp = _pmn_km_atan2_special(y, x);
    if (sp == 1) { return s; }
    var uy = load64(&y);
    var ux = load64(&x);
    var xneg = 0;
    if (ux < 0) { xneg = 1; }
    var r, ok = _pmn_km_atan2_pos(uy & 0x7FFFFFFFFFFFFFFF, ux & 0x7FFFFFFFFFFFFFFF, xneg, 0);
    if (ok == 0) {
        var a, oka = _pmn_km_atan2_pos(uy & 0x7FFFFFFFFFFFFFFF, ux & 0x7FFFFFFFFFFFFFFF, xneg, 1);
        r = a;
    }
    if (uy < 0) { r = -r; }
    return r;
}
