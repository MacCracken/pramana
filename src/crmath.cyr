# +∞ (0x7FF0000000000000), a compile-time constant.
const _PMN_KM_INF = 1.0 / 0.0;

# The quiet NaN Rust's f64::NAN is (0x7FF8000000000000). The parity rules match any NaN.
#must_use
fn _pmn_km_nan(): f64 {
    var n: f64 = 0x7FF8000000000000;
    return n;
}

# a + b = s + e exactly (Knuth's TwoSum).
#must_use
fn _pmn_km_two_sum(a: f64, b: f64): (f64, f64) {
    var s: f64 = a + b;
    var bb: f64 = s - a;
    var e: f64 = (a - (s - bb)) + (b - bb);
    return (s, e);
}

# a + b = s + e exactly, for |a| ≥ |b| or a = 0 (Dekker's FastTwoSum): s = RN(a + b).
#must_use
fn _pmn_km_fast_two_sum(a: f64, b: f64): (f64, f64) {
    var s: f64 = a + b;
    var e: f64 = b - (s - a);
    return (s, e);
}

# a·b = p + e exactly (Dekker's TwoProduct with Veltkamp's 2²⁷ + 1 split), for |a|, |b| < 2⁹⁹⁶
# and no underflow in e.
#must_use
fn _pmn_km_two_prod(a: f64, b: f64): (f64, f64) {
    var p: f64 = a * b;
    var split: f64 = 134217729.0;
    var ca: f64 = split * a;
    var ah: f64 = ca - (ca - a);
    var al: f64 = a - ah;
    var cb: f64 = split * b;
    var bh: f64 = cb - (cb - b);
    var bl: f64 = b - bh;
    var e: f64 = (al * bl) - (((p - (ah * bh)) - (al * bh)) - (ah * bl));
    return (p, e);
}

# RO(a + b): a + b rounded to odd (of the two doubles around an inexact sum, the one with an odd last
# bit; exact sums are returned as they are). TwoSum's error e gives the side of the exact sum; an inexact
# sum is never 0, so the bit step stays in range.
#must_use
fn _pmn_km_ro_sum(a: f64, b: f64): f64 {
    var s, e = _pmn_km_two_sum(a, b);
    if (e == 0.0) { return s; }
    var sb = load64(&s);
    if ((sb & 1) != 0) { return s; }
    var up = 0;
    if (e > 0.0) { up = 1; }
    var pos = 0;
    if (s > 0.0) { pos = 1; }
    if (up == pos) { sb = sb + 1; } else { sb = sb - 1; }   # away from zero is the larger magnitude word
    var r: f64 = sb;
    return r;
}

# RN(a + b + c) exactly, for any three doubles without underflow in the TwoSums: Boldo and Melquiond's
# rounding-to-odd algorithm ("Emulation of FMA and correctly rounded sums", IEEE TC 2008): b + c = uh + ul
# and a + uh = th + tl exactly, then RN(th + RO(tl + ul)). (300,000 adversarial triples — ties, near-ties,
# binade edges, cancellation — agree with exact rational rounding.)
#must_use
fn _pmn_km_rn3(a: f64, b: f64, c: f64): f64 {
    var uh, ul = _pmn_km_two_sum(b, c);
    var th, tl = _pmn_km_two_sum(a, uh);
    var v: f64 = _pmn_km_ro_sum(tl, ul);
    var z: f64 = th + v;
    return z;
}

# Triple-doubles (h, m, l), normalised (|m| ≲ ulp(h), |l| ≲ ulp(m)). Every step is TwoSum or TwoProduct
# (exact) except the rounded sums of the third-order terms and the dropped products below 2^-158 of the
# result, so each operation's error is below 2^-155·max(|a|, |b|) for a sum and 2^-153·|a·b| for a
# product. The renormalising TwoSums keep the sum exact whatever the magnitudes, so a cancellation costs
# only its relative factor.
#must_use
fn _pmn_km_td_add(a0: f64, a1: f64, a2: f64, b0: f64, b1: f64, b2: f64): (f64, f64, f64) {
    var s0, e0 = _pmn_km_two_sum(a0, b0);
    var s1, e1 = _pmn_km_two_sum(a1, b1);
    var s2: f64 = a2 + b2;
    var t1, f1 = _pmn_km_two_sum(e0, s1);
    var t2: f64 = (f1 + e1) + s2;
    var h, u = _pmn_km_two_sum(s0, t1);
    var m, l = _pmn_km_two_sum(u, t2);
    return (h, m, l);
}

# (a0, a1, a2) + d.
#must_use
fn _pmn_km_td_add_d(a0: f64, a1: f64, a2: f64, d: f64): (f64, f64, f64) {
    var s0, e0 = _pmn_km_two_sum(a0, d);
    var t1, f1 = _pmn_km_two_sum(e0, a1);
    var t2: f64 = f1 + a2;
    var h, u = _pmn_km_two_sum(s0, t1);
    var m, l = _pmn_km_two_sum(u, t2);
    return (h, m, l);
}

# (a0, a1, a2)·(b0, b1, b2): a0b0, a0b1, a1b0 exact (TwoProduct), the 2^-106 terms rounded, the 2^-159 ones
# (a1b2, a2b1, a2b2) dropped.
#must_use
fn _pmn_km_td_mul(a0: f64, a1: f64, a2: f64, b0: f64, b1: f64, b2: f64): (f64, f64, f64) {
    var p0, q0 = _pmn_km_two_prod(a0, b0);
    var p1, q1 = _pmn_km_two_prod(a0, b1);
    var p2, q2 = _pmn_km_two_prod(a1, b0);
    var r: f64 = ((a0 * b2) + (a1 * b1)) + (a2 * b0);
    var s1, e1 = _pmn_km_two_sum(p1, p2);
    var s2, e2 = _pmn_km_two_sum(q0, s1);
    var t: f64 = (((e1 + e2) + q1) + q2) + r;
    var h, u = _pmn_km_two_sum(p0, s2);
    var m, l = _pmn_km_two_sum(u, t);
    return (h, m, l);
}

# (a0, a1, a2)·d for a double d.
#must_use
fn _pmn_km_td_mul_d(a0: f64, a1: f64, a2: f64, d: f64): (f64, f64, f64) {
    var p0, q0 = _pmn_km_two_prod(a0, d);
    var p1, q1 = _pmn_km_two_prod(a1, d);
    var r: f64 = a2 * d;
    var s, e = _pmn_km_two_sum(q0, p1);
    var t: f64 = (e + q1) + r;
    var h, u = _pmn_km_two_sum(p0, s);
    var m, l = _pmn_km_two_sum(u, t);
    return (h, m, l);
}

# 2^e as a double, for −1022 ≤ e ≤ 1023.
#must_use
fn _pmn_km_cr_pow2(e): f64 {
    var b = (e + 1023) << 52;
    var r: f64 = b;
    return r;
}

# RN(2^e·(h + m + l)) for a normalised triple-double h + m + l in [0.99, 2.01] and any e, every result range: a normal
# result is RN3 then an exact scale (2^1024 in two steps; a significand that rounds up past DBL_MAX gives
# +∞, as IEEE overflow does, and every e > 1024 gives +∞ by 2^1023·2^1023; a normal result at e = −1023, h + m + l ≥ 2,
# scales by 2^(e + 1022) then 2^-1022, and an e below −2044 scales the subnormal-grid sum by 2^-1022, which rounds it to
# +0 as it must). A result below 2^-1022 is rounded ONCE, at the subnormal grid: with
# y = 2^(e + 1022)·(h + m + l) < 1 (each part scaled exactly), RN(1 + y) has its ulp at 2^-52, which is
# 2^-1074 after the final scale, and (RN(1 + y) − 1)·2^-1022 is exact (glibc's specialcase technique). The
# sum 1 + yh + ym + yl is rounded exactly: 1 + yh = a + b (Fast2Sum), and RN(a + b + RO(ym + yl)) =
# RN(a + b + ym + yl) because every breakpoint minus a − b is a multiple of ulp(yh), an even multiple of
# ulp(RO(ym + yl)), and rounding to odd keeps the order against those.
#must_use
fn _pmn_km_cr_finish(e, h: f64, m: f64, l: f64): f64 {
    if (e >= 0 - 1021) {
        var z: f64 = _pmn_km_rn3(h, m, l);
        if (e > 1023) {
            var s1: f64 = _pmn_km_cr_pow2(1023);
            var o: f64 = z * s1;
            if (e > 1024) {
                o = o * s1;                  # past 2^1025·0.99: ±∞
            } else {
                o = o * 2.0;
            }
            return o;
        }
        var s2: f64 = _pmn_km_cr_pow2(e);
        var y: f64 = z * s2;
        return y;
    }
    var h1, m1a = _pmn_km_fast_two_sum(h, m);    # renormalised, so the sign tests below decide y < 1
    var m1, l1 = _pmn_km_two_sum(m1a, l);
    var es = e + 1022;
    if (es < 0 - 1022) { es = 0 - 1022; }    # 2^e·2.01 < 2^-1075 already: the sum below rounds to 1, the result +0
    var s: f64 = _pmn_km_cr_pow2(es);
    var yh: f64 = h1 * s;
    var ym: f64 = m1 * s;
    var yl: f64 = l1 * s;
    var normal = 0;
    if (yh > 1.0) { normal = 1; }
    if (yh == 1.0) {
        if (ym > 0.0) { normal = 1; }
        if (ym == 0.0 && yl >= 0.0) { normal = 1; }
    }
    var dmin: f64 = _pmn_km_cr_pow2(0 - 1022);
    if (normal == 1) {                       # y ≥ 1: the result is at least 2^-1022 (e is −1022 or −1023)
        var z2: f64 = _pmn_km_rn3(h, m, l);
        var y2: f64 = (z2 * s) * dmin;       # both scales exact: z2·2^(e + 1022) ≥ 1
        return y2;
    }
    var a, b = _pmn_km_fast_two_sum(1.0, yh);
    var v: f64 = _pmn_km_ro_sum(ym, yl);
    var w: f64 = _pmn_km_rn3(a, b, v);
    var r: f64 = (w - 1.0) * dmin;
    return r;
}

# The fast core for e^(xh + xl), |xh| < 1180 and |xl| ≤ 2^-42: (hi, lo, E) with hi + lo = e^x/2^E within
# 2^-70. |xh| < 1180 keeps K = RN(xh·512/ln 2) below 871,700 < 2^20, which K·L1's exactness needs (L1 has 33 bits);
# past 745.2 (the ux tiers' 708 < |x| < 1024, and x·ln 10 up to 1179) the dropped K·L3 grows from 2^-79.2 to 2^-78.8,
# inside the bound's margin (0.9·2^-70 against ε = 2^-69). exp passes xl = 0; exp10 passes x·ln 10 as xh + xl (xl
# folds into the K·L2 term).
#must_use
fn _pmn_km_exp_core(xh: f64, xl: f64): (f64, f64, i64) {
    var inv: f64 = _PMN_KM_CR_EXP_INVLN2N;
    var l1: f64 = _PMN_KM_CR_EXP_L1;
    var l2: f64 = _PMN_KM_CR_EXP_L2;
    var tt: f64 = (xh * inv) + 6755399441055744.0;   # 1.5·2^52: rounds x·512/ln 2 to an integer
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var ti = (k & 511) * 32;
    var e = k >>> 9;
    var rh: f64 = xh - (kd * l1);
    var s: f64 = (kd * l2) - xl;
    var r: f64 = rh - s;
    var rl: f64 = (rh - r) - s;
    var c: f64 = r + 49152.0;                         # 1.5·2^15: rounds r to a multiple of 2^-37
    var r1: f64 = c - 49152.0;
    var r2: f64 = r - r1;
    var p3: f64 = _PMN_KM_CR_EXP_P3;
    var p4: f64 = _PMN_KM_CR_EXP_P4;
    var p5: f64 = _PMN_KM_CR_EXP_P5;
    var z: f64 = r * r;                       # Estrin: the code is latency-bound, so keep chains short
    var q: f64 = (z * (0.5 + (r * p3))) + ((z * z) * (p4 + (r * p5)));
    var a: f64 = load64(&_PMN_KM_CR_EXP_T + ti);
    var b: f64 = load64(&_PMN_KM_CR_EXP_T + ti + 8);
    var p1: f64 = a * r1;
    var hi: f64 = a + p1;
    var e1: f64 = p1 - (hi - a);
    var rlq: f64 = rl + q;
    var lo: f64 = (e1 + b) + ((a * (r2 + rlq)) + (b * (r + rlq)));
    return (hi, lo, e);
}

# The fast test with bound err (absolute, on hi + lo) and the scale for any E: (1, RN(2^E·(hi + lo))) or (0, 0)
# when the test fails. Normal results scale exactly (2^1024 in two steps, +∞ for every E > 1024, and 2^(E + 1022)
# then 2^-1022 at E = −1023; an E below −2044 scales by 2^-1022, so the result is +0 as it must be). A result that
# may be subnormal (E ≤ −1022 and 2^(E+1022)·(hi + lo) < 1, decided
# on hi + lo renormalised: the core's lo is not, when r1 = 0) is tested on the subnormal grid, rounding once:
# y = 2^(E+1022)·(hi + lo) (exact), 1 + y = a + b + yl with a + b = 1 + yh exactly, and the ends
# a + ((b + yl) ∓ ε') with ε' = err·2^(E+1022) + 2^-104 (|b + yl| ≤ 2^-52, so the two inner roundings are below
# 2^-104.4 at this scale, where the grid is 2^-52).
#must_use
fn _pmn_km_exp_fin(hi: f64, lo: f64, e, err: f64): (i64, f64) {
    if (e >= 0 - 1021) {
        var u: f64 = hi + (lo - err);
        var v: f64 = hi + (lo + err);
        if (u != v) { return (0, 0.0); }
        if (e > 1023) {
            var s1: f64 = _pmn_km_cr_pow2(1023);
            var o: f64 = u * s1;
            if (e > 1024) {
                o = o * s1;                  # past 2^1025·0.99: ±∞
            } else {
                o = o * 2.0;
            }
            return (1, o);
        }
        var s2: f64 = _pmn_km_cr_pow2(e);
        var y: f64 = u * s2;
        return (1, y);
    }
    var es = e + 1022;
    if (es < 0 - 1022) { es = 0 - 1022; }    # 2^E·2 < 2^-1075 already: rounds to +0 below
    var s: f64 = _pmn_km_cr_pow2(es);
    var hn: f64 = hi + lo;                   # hi + lo renormalised: lo can be up to 2^-38 when r1 = 0
    var ln: f64 = lo - (hn - hi);
    var yh: f64 = hn * s;
    var dmin: f64 = _pmn_km_cr_pow2(0 - 1022);
    if (yh > 1.0 || (yh == 1.0 && ln >= 0.0)) {   # 2^E·(hi + lo) ≥ 2^-1022: a normal result (E is −1022 or −1023)
        var u2: f64 = hi + (lo - err);
        var v2: f64 = hi + (lo + err);
        if (u2 != v2) { return (0, 0.0); }
        var y2: f64 = (u2 * s) * dmin;       # both scales exact: u2·2^(E + 1022) ≥ 1
        return (1, y2);
    }
    var yl: f64 = ln * s;
    var a, b = _pmn_km_fast_two_sum(1.0, yh);
    var w: f64 = b + yl;
    var tiny: f64 = 0x3970000000000000;     # 2^-104
    var err2: f64 = (err * s) + tiny;
    var u3: f64 = a + (w - err2);
    var v3: f64 = a + (w + err2);
    if (u3 != v3) { return (0, 0.0); }
    var r: f64 = (u3 - 1.0) * dmin;
    return (1, r);
}

# e^x, correctly rounded. exp(±0) = 1 (as every |x| < 2^-54: e^x is then within 2^-54 of 1, inside 1's
# rounding interval), exp(+∞) = +∞, exp(−∞) = +0, NaN for NaN; x above 709.782712893384 overflows to +∞, and
# below −745.1332191019411 (e^x < 2^-1075) rounds to +0. e^x is exact only at x = 0 (Lindemann–Weierstrass: e^x
# is transcendental for algebraic x ≠ 0), so no other argument is exact or a tie. The fast path covers
# 2^-54 ≤ |x| ≤ 708 (normal results, one scale), inline; the rest goes through _pmn_km_cr_exp_fast.
#must_use
fn _pmn_km_cr_exp(x: f64): f64 {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    # |x| < 2^-54, |x| > 708 or NaN, in one compare: ax − bits(2^-54) is above bits(708) − bits(2^-54) as an
    # unsigned word (the sign flip makes the signed compare an unsigned one) exactly then.
    if (((ax - 0x3C90000000000000) ^ 0x8000000000000000) > 0x83F6200000000000) {
        var w, okw = _pmn_km_cr_exp_fast(x);
        if (okw == 1) { return w; }
        var zw: f64 = _pmn_km_cr_exp_acc(x);
        return zw;
    }
    var inv: f64 = _PMN_KM_CR_EXP_INVLN2N;
    var l1: f64 = _PMN_KM_CR_EXP_L1;
    var l2: f64 = _PMN_KM_CR_EXP_L2;
    var tt: f64 = (x * inv) + 6755399441055744.0;
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var ti = (k & 511) * 32;
    var e = k >>> 9;
    var rh: f64 = x - (kd * l1);
    var s: f64 = kd * l2;
    var r: f64 = rh - s;
    var rl: f64 = (rh - r) - s;
    var c: f64 = r + 49152.0;
    var r1: f64 = c - 49152.0;
    var r2: f64 = r - r1;
    var p3: f64 = _PMN_KM_CR_EXP_P3;
    var p4: f64 = _PMN_KM_CR_EXP_P4;
    var p5: f64 = _PMN_KM_CR_EXP_P5;
    var z: f64 = r * r;                       # Estrin: the code is latency-bound, so keep chains short
    var q: f64 = (z * (0.5 + (r * p3))) + ((z * z) * (p4 + (r * p5)));
    var a: f64 = load64(&_PMN_KM_CR_EXP_T + ti);
    var b: f64 = load64(&_PMN_KM_CR_EXP_T + ti + 8);
    var p1: f64 = a * r1;
    var hi: f64 = a + p1;
    var e1: f64 = p1 - (hi - a);
    var rlq: f64 = rl + q;
    var lo: f64 = (e1 + b) + ((a * (r2 + rlq)) + (b * (r + rlq)));
    var err: f64 = 0x3BA0000000000000;      # 2^-69
    var u: f64 = hi + (lo - err);
    var v: f64 = hi + (lo + err);
    if (u == v) {
        var sb = (e + 1023) << 52;
        var sc: f64 = sb;
        var y: f64 = u * sc;
        return y;
    }
    var za: f64 = _pmn_km_cr_exp_acc(x);
    return za;
}

# The fast path alone, for every x: (RN(e^x), 1), or (0, 0) when the rounding test fails and the accurate path
# must decide. NaN, the tiny end, overflow and underflow first, then the fast core with the general finish
# (708 < x: E up to 1024; x < −708: subnormal results). For 2^-54 ≤ |x| ≤ 708 _pmn_km_exp_core and _pmn_km_exp_fin
# perform exactly the operations of _pmn_km_cr_exp's inline path (E ≥ −1022 there, with hi > 1 at E = −1022), so
# this gives its result and its test.
#must_use
fn _pmn_km_cr_exp_fast(x: f64): (f64, i64) {
    if (x != x) { return (x, 1); }
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3C90000000000000) { return (1.0, 1); }
    var ovf: f64 = _PMN_KM_CR_EXP_OVF;
    var unf: f64 = _PMN_KM_CR_EXP_UNF;
    if (x > ovf) {
        var inf: f64 = _PMN_KM_INF;
        return (inf, 1);
    }
    if (x < unf) { return (0.0, 1); }
    var hi, lo, e = _pmn_km_exp_core(x, 0.0);
    var err: f64 = 0x3BA0000000000000;      # 2^-69
    var ok, y = _pmn_km_exp_fin(hi, lo, e, err);
    return (y, ok);
}

# The accurate core: e^(y0 + y1 + y2) = 2^E·(h + m + l), (h, m, l) stored at out[0..2], E returned. The same
# K as the fast path; r = y − K·(L1 + L2 + L3 + L4) as a triple-double (K·L1 exact, K·L2 and K·L3
# TwoProducts, K·L4 rounded: below 2^-186 of error); e^r − 1 by Horner in triple-double to r^11/11!
# (truncation 2^-152); T_j = A + B + C + D renormalised (2^-159); h + m + l = T_j + T_j·(e^r − 1). Measured
# relative error 2^-155 against 400-bit MPFR.
#must_use
fn _pmn_km_exp_acc_core(y0: f64, y1: f64, y2: f64, out): i64 {
    var inv: f64 = _PMN_KM_CR_EXP_INVLN2N;
    var l1: f64 = _PMN_KM_CR_EXP_L1;
    var l2: f64 = _PMN_KM_CR_EXP_L2;
    var l3: f64 = _PMN_KM_CR_EXP_L3;
    var l4: f64 = _PMN_KM_CR_EXP_L4;
    var tt: f64 = (y0 * inv) + 6755399441055744.0;
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var ti = (k & 511) * 32;
    var e = k >>> 9;
    var rh: f64 = y0 - (kd * l1);
    var a2, a2e = _pmn_km_two_prod(kd, l2);
    var a3, a3e = _pmn_km_two_prod(kd, l3);
    var a4: f64 = kd * l4;
    var ra0, ra1, ra2 = _pmn_km_td_add_d(rh, 0.0, 0.0, -a2);
    var rb0, rb1, rb2 = _pmn_km_td_add_d(ra0, ra1, ra2, y1);
    var rc0, rc1, rc2 = _pmn_km_td_add_d(rb0, rb1, rb2, -a2e);
    var rd0, rd1, rd2 = _pmn_km_td_add_d(rc0, rc1, rc2, -a3);
    var re0, re1, re2 = _pmn_km_td_add_d(rd0, rd1, rd2, y2);
    var a34: f64 = a3e + a4;
    var r0, r1, r2 = _pmn_km_td_add_d(re0, re1, re2, -a34);
    var sh: f64 = load64(&_PMN_KM_CR_EXP_ACC + 216);    # 1/11! (index 3·(11 − 2))
    var sm: f64 = load64(&_PMN_KM_CR_EXP_ACC + 224);
    var sl: f64 = load64(&_PMN_KM_CR_EXP_ACC + 232);
    var n = 10;
    while (n >= 2) {
        var th, tm, tl = _pmn_km_td_mul(r0, r1, r2, sh, sm, sl);
        var off = (n - 2) * 24;
        var ch: f64 = load64(&_PMN_KM_CR_EXP_ACC + off);
        var cm: f64 = load64(&_PMN_KM_CR_EXP_ACC + off + 8);
        var cl: f64 = load64(&_PMN_KM_CR_EXP_ACC + off + 16);
        var uh, um, ul = _pmn_km_td_add(ch, cm, cl, th, tm, tl);
        sh = uh;
        sm = um;
        sl = ul;
        n = n - 1;
    }
    var vh, vm, vl = _pmn_km_td_mul(r0, r1, r2, sh, sm, sl);
    var wh, wm, wl = _pmn_km_td_add_d(vh, vm, vl, 1.0);
    var ph, pm, pl = _pmn_km_td_mul(r0, r1, r2, wh, wm, wl);     # e^r − 1
    var ta: f64 = load64(&_PMN_KM_CR_EXP_T + ti);
    var tb: f64 = load64(&_PMN_KM_CR_EXP_T + ti + 8);
    var tc: f64 = load64(&_PMN_KM_CR_EXP_T + ti + 16);
    var td: f64 = load64(&_PMN_KM_CR_EXP_T + ti + 24);
    var t0, t1a = _pmn_km_fast_two_sum(ta, tb);
    var t1, t2a = _pmn_km_fast_two_sum(t1a, tc);
    var t2: f64 = t2a + td;
    var qh, qm, ql = _pmn_km_td_mul(t0, t1, t2, ph, pm, pl);
    var zh, zm, zl = _pmn_km_td_add(t0, t1, t2, qh, qm, ql);
    store64(out, zh);
    store64(out + 8, zm);
    store64(out + 16, zl);
    return e;
}

# e^x for 2^-54 ≤ |x| < 2^-30, where Lefèvre–Muller's bound is 2^-158 (e^x is then 1 + x + x²/2 + …, and
# 1 + x is a short exact number): 1 + x = a + b exactly, q = x²/2 + x³/6 + x⁴/24 + x⁵/120 as a double-double
# to 2^-165 absolute (x² and x³ by TwoProduct, x³/6 by a corrected division; x⁶/720 < 2^-189 dropped), and
# RN(a + b + RO(qh + ql)) by _pmn_km_rn3 (the rounding-to-odd argument of _pmn_km_cr_finish: ulp(x) is an even
# multiple of ulp(q)).
#must_use
fn _pmn_km_exp_tiny_acc(x: f64): f64 {
    var p, pe = _pmn_km_two_prod(x, x);
    var a, ae = _pmn_km_two_prod(x, p);
    var x3l: f64 = ae + (x * pe);
    var d3h: f64 = a / 6.0;
    var pp, pe2 = _pmn_km_two_prod(d3h, 6.0);
    var d3l: f64 = (((a - pp) - pe2) + x3l) / 6.0;
    var ax: f64 = a * x;
    var x4: f64 = ax / 24.0;
    var x5: f64 = (ax * x) / 120.0;
    var hp: f64 = p * 0.5;
    var t, te = _pmn_km_two_sum(hp, d3h);
    var lo: f64 = ((((pe * 0.5) + te) + d3l) + x4) + x5;
    var qh, ql = _pmn_km_fast_two_sum(t, lo);
    var a1, b1 = _pmn_km_fast_two_sum(1.0, x);
    var v: f64 = _pmn_km_ro_sum(qh, ql);
    var r: f64 = _pmn_km_rn3(a1, b1, v);
    return r;
}

# e^x by the accurate path alone, for every x (the fast path's fallback, and a test hook).
#must_use
fn _pmn_km_cr_exp_acc(x: f64): f64 {
    if (x != x) { return x; }
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3C90000000000000) { return 1.0; }
    var ovf: f64 = _PMN_KM_CR_EXP_OVF;
    var unf: f64 = _PMN_KM_CR_EXP_UNF;
    if (x > ovf) { return _PMN_KM_INF; }
    if (x < unf) { return 0.0; }
    if (ax < 0x3E10000000000000) {              # |x| < 2^-30
        var t: f64 = _pmn_km_exp_tiny_acc(x);
        return t;
    }
    var buf: f64[3];
    var e = _pmn_km_exp_acc_core(x, 0.0, 0.0, &buf);
    var r: f64 = _pmn_km_cr_finish(e, buf[0], buf[1], buf[2]);
    return r;
}

# expm1(x) = e^x − 1, correctly rounded. ±0 → ±0 and |x| < 2^-53 → x (x²/2 is then below half an ulp of x,
# on the side that keeps x), +∞ → +∞, −∞ → −1, NaN for NaN; x above 709.782712893384 overflows, below
# −37.42994775023704 (e^x < 2^-54) rounds to −1.
#must_use
fn _pmn_km_cr_expm1(x: f64): f64 {
    # _pmn_km_cr_expm1_fast's body with _pmn_km_exp_core's inline (2.0.1), as _pmn_km_cr_exp inlines its fast path: the
    # same
    # operations, each failed test or region left to the accurate path.
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3F90000000000000) {               # |x| < 2^-6
        if (ax < 0x3CA0000000000000) { return x; }   # |x| < 2^-53, ±0, subnormals
        var p: f64 = x * x;                      # x² = p + pe exactly (Dekker, inline)
        var cx: f64 = 134217729.0 * x;
        var x1: f64 = cx - (cx - x);
        var x2: f64 = x - x1;
        var pe: f64 = (((x1 * x1) - p) + (2.0 * (x1 * x2))) + (x2 * x2);
        var k3: f64 = _PMN_KM_CR_EXPM1_Q3;
        var k4: f64 = _PMN_KM_CR_EXPM1_Q4;
        var k5: f64 = _PMN_KM_CR_EXPM1_Q5;
        var k6: f64 = _PMN_KM_CR_EXPM1_Q6;
        var k7: f64 = _PMN_KM_CR_EXPM1_Q7;
        var k8: f64 = _PMN_KM_CR_EXPM1_Q8;
        var k9: f64 = _PMN_KM_CR_EXPM1_Q9;
        var s: f64 = ((k3 + (x * k4)) + (p * (k5 + (x * k6)))) + ((p * p) * ((k7 + (x * k8)) + (p * k9)));
        var x3: f64 = (x * p) * s;
        var hp: f64 = p * 0.5;
        var hs: f64 = x + hp;
        var ht: f64 = hp - (hs - x);
        var lo: f64 = (ht + (pe * 0.5)) + x3;
        var ex3: f64 = f64_abs(x3);
        var exa: f64 = f64_abs(x);
        var c49: f64 = 0x3CE0000000000000;      # 2^-49
        var c100: f64 = 0x39B0000000000000;     # 2^-100
        var err: f64 = (ex3 * c49) + (exa * c100);
        var u: f64 = hs + (lo - err);
        var v: f64 = hs + (lo + err);
        if (u == v) { return u; }
        var za: f64 = _pmn_km_cr_expm1_acc(x);
        return za;
    }
    var m1b = _PMN_KM_CR_EXPM1_M1 & 0x7FFFFFFFFFFFFFFF;
    if (ax > m1b) {                              # |x| > 37.42994775023704
        if (x < 0.0) { return -1.0; }            # x < EXPM1_M1 (−∞ included): e^x < 2^-54
        if (ax > 0x4086200000000000) {           # x > 708, +∞, NaN: the accurate path returns the specials
            var zs: f64 = _pmn_km_cr_expm1_acc(x);
            return zs;
        }
    }
    # _pmn_km_exp_core(x, 0), inline.
    var inv: f64 = _PMN_KM_CR_EXP_INVLN2N;
    var l1: f64 = _PMN_KM_CR_EXP_L1;
    var l2: f64 = _PMN_KM_CR_EXP_L2;
    var tt: f64 = (x * inv) + 6755399441055744.0;   # 1.5·2^52: rounds x·512/ln 2 to an integer
    var kd: f64 = tt - 6755399441055744.0;
    var k = load64(&tt) - 0x4338000000000000;
    var ti = (k & 511) * 32;
    var e = k >>> 9;
    var rh: f64 = x - (kd * l1);
    var sx: f64 = (kd * l2) - 0.0;           # the core's (K·L2) − xl with xl = 0
    var r: f64 = rh - sx;
    var rl: f64 = (rh - r) - sx;
    var cr: f64 = r + 49152.0;               # 1.5·2^15: rounds r to a multiple of 2^-37
    var r1: f64 = cr - 49152.0;
    var r2: f64 = r - r1;
    var p3: f64 = _PMN_KM_CR_EXP_P3;
    var p4: f64 = _PMN_KM_CR_EXP_P4;
    var p5: f64 = _PMN_KM_CR_EXP_P5;
    var zr: f64 = r * r;
    var q: f64 = (zr * (0.5 + (r * p3))) + ((zr * zr) * (p4 + (r * p5)));
    var ta: f64 = load64(&_PMN_KM_CR_EXP_T + ti);
    var tb: f64 = load64(&_PMN_KM_CR_EXP_T + ti + 8);
    var p1: f64 = ta * r1;
    var hi: f64 = ta + p1;
    var e1: f64 = p1 - (hi - ta);
    var rlq: f64 = rl + q;
    var lo2: f64 = (e1 + tb) + ((ta * (r2 + rlq)) + (tb * (r + rlq)));
    var hh: f64 = 0.0;
    var ll: f64 = lo2;
    var sc: f64 = 1.0;
    if (e == 0) {
        hh = hi - 1.0;                           # exact: hi in [0.9993, 1.9987]
    } else {
        sc = _pmn_km_cr_pow2(e);
        var hsc: f64 = hi * sc;
        if (e > 0) {
            hh = hsc - 1.0;
            var t1: f64 = -1.0 - (hh - hsc);
            ll = t1 + (lo2 * sc);
        } else {
            hh = -1.0 + hsc;
            var t2: f64 = hsc - (hh + 1.0);
            ll = t2 + (lo2 * sc);
        }
    }
    var err2: f64 = 0x3BA0000000000000;      # 2^-69
    var errs: f64 = err2 * sc;
    var u2: f64 = hh + (ll - errs);
    var v2: f64 = hh + (ll + errs);
    if (u2 == v2) { return u2; }
    var zb: f64 = _pmn_km_cr_expm1_acc(x);
    return zb;
}

# The fast path alone: (its result, 1), or (0, 0) when its test fails or x > 708 (left to the accurate path).
#must_use
fn _pmn_km_cr_expm1_fast(x: f64): (f64, i64) {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
