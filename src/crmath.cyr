# expm1 by the accurate path alone. |x| < 2^-6: x + x²/2 + … + x^17/17! by Horner in triple-double on the
# exact x (truncation below 2^-154 of x; measured 2^-155). Otherwise e^x from exp's accurate core, scaled,
# minus 1 in triple-double (|expm1(x)| ≥ 0.0155: at most 6.1 bits of cancellation; measured 2^-152); for
# E ≥ 120 the −1 is below 2^-114 of e^x, inside exp's own worst-case distance (Lefèvre–Muller: 2^-113 for
# |x| ≥ 2^-30), so it cannot move the rounding and expm1 rounds as exp does.
#must_use
fn _pmn_km_cr_expm1_acc(x: f64): f64 {
    if (x != x) { return x; }
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3CA0000000000000) { return x; }
    var ovf: f64 = _PMN_KM_CR_EXPM1_OVF;
    var m1: f64 = _PMN_KM_CR_EXPM1_M1;
    if (x > ovf) { return _PMN_KM_INF; }
    if (x < m1) { return -1.0; }
    if (ax < 0x3F90000000000000) {
        var sh: f64 = load64(&_PMN_KM_CR_EXP_ACC + 360);   # 1/17! (index 3·(17 − 2))
        var sm: f64 = load64(&_PMN_KM_CR_EXP_ACC + 368);
        var sl: f64 = load64(&_PMN_KM_CR_EXP_ACC + 376);
        var n = 16;
        while (n >= 2) {
            var th, tm, tl = _pmn_km_td_mul_d(sh, sm, sl, x);
            var off = (n - 2) * 24;
            var ch: f64 = load64(&_PMN_KM_CR_EXP_ACC + off);
            var cm: f64 = load64(&_PMN_KM_CR_EXP_ACC + off + 8);
            var cl: f64 = load64(&_PMN_KM_CR_EXP_ACC + off + 16);
            var uh, um, ul = _pmn_km_td_add(ch, cm, cl, th, tm, tl);
            sh = uh;
            sm = um;
            sl = ul;
            n = n - 1;
        }
        var vh, vm, vl = _pmn_km_td_mul_d(sh, sm, sl, x);
        var wh, wm, wl = _pmn_km_td_add_d(vh, vm, vl, 1.0);
