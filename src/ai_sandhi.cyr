# ai_sandhi.cyr — the HooshClient's transport, sandhi's HTTP POST (port plan D8; M7 part b): pass
# `&pmn_ai_sandhi_transport` to `PmnStatQuery_new`. In the `[lib.ai]` profile after src/ai.cyr; sandhi itself comes
# from the consumer (`include "lib/sandhi.cyr"`, probe P8), as 1.3.0's `HooshClient` came from hoosh. It names
# nothing of pramana's but the error codes and the scratch pool (src/pool.cyr), so a sandhi build carries none of the
# library's tables.

# The arena one exchange takes, past the request's own bytes (4·nbody): sandhi's receive buffer (its 256 KiB reply cap
# and a byte), the reply's parsed headers and body, the connection and the URL. 2.0.1: sandhi allocated all of it on
# the consumer's bump heap, 464 bytes for a refused call and more than 256 KiB for an answered one, never freed.
var _PMN_AI_SANDHI_ARENA = 4194304;

# POSTs body[0, nbody) to url[0, nurl) as `application/json` (reqwest's `.json(&body)`), and fills resp (32 bytes: the
# status; the body's pointer and length; 1, the body being a freelist block of its own that the caller frees with
# `fl_free`). `query` frees it after reading the reply. The whole exchange runs in an arena claimed from the scratch
# pool and given back before the return, through sandhi's allocator-taking calls, so nothing stays on the consumer's
# heap. PMN_ERR_NONE; PMN_ERR_COMPUTATION_ERROR when sandhi has no response (no connection, a refusal, a malformed
# reply, an arena too small) or the URL holds a NUL byte (sandhi takes a C string, which would end there: 2.0.1, the
# POST went to the URL's prefix; reqwest refuses such a URL); PMN_ERR_OUT_OF_MEMORY when the arena or the body's block
# can't be had. On a refusal resp is untouched.
fn pmn_ai_sandhi_transport(ctx, url, nurl, body, nbody, resp): i64 {
    if (url == 0 || nurl <= 0 || resp == 0 || nbody < 0 || (body == 0 && nbody > 0)) {
        return PMN_ERR_COMPUTATION_ERROR;
    }
    for (var i = 0; i < nurl; i = i + 1) {
        if (load8(url + i) == 0) { return PMN_ERR_COMPUTATION_ERROR; }
    }
    var asz = _pmn_sz_add(_pmn_sz_add(_PMN_AI_SANDHI_ARENA, _pmn_sz_mul(4, nbody)), nurl);
    var ar, aslot = _pmn_scratch_take(asz);
    if (ar == 0) { return PMN_ERR_OUT_OF_MEMORY; }
    var al[_PMN_BUMP_ALLOCATOR_SIZE];
    var st[_PMN_BUMP_STATE_SIZE];
    _pmn_bump_allocator(&al, &st, ar, asz);
    var e = PMN_ERR_COMPUTATION_ERROR;
    var cu = alloc_via(&al, nurl + 1);
    var h = sandhi_headers_new_a(&al);
    if (cu != 0 && h != 0) {
        memcpy(cu, url, nurl);
        store8(cu + nurl, 0);
        sandhi_headers_set_a(&al, h, "content-type", "application/json");
        var r = sandhi_http_post_a(&al, cu, h, body, nbody);
        if (r != 0 && sandhi_http_err_kind(r) == SANDHI_OK) {
            var n = sandhi_http_body_len(r);
            var own = fl_alloc(n + 1);
            if (own == 0) {
                e = PMN_ERR_OUT_OF_MEMORY;
            } else {
                if (n > 0) { memcpy(own, sandhi_http_body(r), n); }
                store64(resp, sandhi_http_status(r));
                store64(resp + 8, own);
                store64(resp + 16, n);
                store64(resp + 24, 1);
                e = PMN_ERR_NONE;
            }
        }
    }
    _pmn_scratch_give(ar, aslot);
    return e;
}
