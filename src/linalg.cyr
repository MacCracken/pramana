# linalg.cyr — hisab 1.4.0's dense Cholesky factorization and solve (`hisab::num::cholesky`, `cholesky_solve`), which
# 1.3.0 calls for MultivariateNormal (M3 part d2), the ARIMA Yule–Walker fit (M5) and the logistic regression's Newton
# step (M4). Port plan §8.2 and ledger L4; M3 part d1.
#
# Transcribed, term for term and in hisab's order, so every value is 1.4.0's bit for bit: each sum starts from the
# matrix entry and subtracts the products k = 0, 1, … in turn; the diagonal is the correctly rounded √, an
# off-diagonal entry one division. Both run on caller storage and allocate nothing (D11): hisab returns a fresh
# `Vec<Vec<f64>>` each call, and ganita's solve leaves 8n bytes per call, which an MVN pdf in a loop would leak.
# Matrices are flat row-major n × n f64 arrays, vectors n f64s.
#
# hisab's one error, `InvalidInput`, is PMN_ERR_INVALID_PARAMETER here; each caller maps it as 1.3.0 does
# (MultivariateNormal to InvalidParameter, ARIMA to ComputationError, the logistic step to a stop). hisab's shape
# checks (a ragged row, a b of another length) have no counterpart: a flat array with n cannot be ragged.
#
# UPSTREAM(L4): ganita:docs/development/issues/2026-11-15-mat-cholesky-solve-allocates-and-sums-in-another-order.md
# ganita's `mat_cholesky_solve` allocates, and its `mat_cholesky` sums in another order (probe P5: up to 40 ulp from
# 1.4.0). This stand-in goes when ganita has an allocation-free solve and the factor in this order, its rows re-run.
#
# The file is also the home of hisab 1.4.0's two other routines 1.3.0 calls, transcribed with their first callers:
# UPSTREAM(L5): hisab:docs/development/issues/2026-11-15-no-polynomial-least-squares.md
# `least_squares_poly` (modified Gram–Schmidt), with the polynomial regression;
# UPSTREAM(L6): hisab:docs/development/issues/2026-11-15-eigen-symmetric-no-tolerance-budget-or-caller-scratch.md
# `eigen_symmetric(tol, max_iter)` (cyclic Jacobi), with the PCA.

# The largest n the Cholesky pair takes (and MultivariateNormal's d): n·n words then stay far inside the address space.
# The Jacobi and the least squares size through `_pmn_sz_mul` instead, so they take any n whose words can exist, as
# hisab does (2.0.1: they refused more than 4096 variables and 2²⁶ points, which 1.3.0 takes).
var _PMN_LINALG_MAX_N = 67108864;           # 2^26

# 1 when the byte ranges [p, p + pn) and [q, q + qn) overlap (neither empty).
#must_use
#pure
fn _pmn_linalg_overlaps(p, pn, q, qn): i64 {
    if (pn == 0 || qn == 0) { return 0; }
    if (p < q + qn && q < p + pn) { return 1; }
    return 0;
}

# hisab's `cholesky(a)`: the lower-triangular L with A = L·Lᵀ, into out (n × n, zeros above the diagonal), reading A's
# lower triangle and diagonal only. PMN_ERR_NONE; or PMN_ERR_INVALID_PARAMETER, as hisab's InvalidInput, when a pivot
# is ≤ 0 (not positive-definite) or n = 0, and for a null or overlapping buffer or n out of range. A NaN pivot is not
# refused (NaN ≤ 0 is false), as hisab's: its √ is NaN and the factor carries it. On a refusal out holds the factor's
# rows up to the failed pivot.
#must_use
fn _pmn_cholesky(a, n, out): i64 {
    if (a == 0 || out == 0 || n <= 0 || n > _PMN_LINALG_MAX_N) { return PMN_ERR_INVALID_PARAMETER; }
    var bytes = n * n * 8;
    if (_pmn_linalg_overlaps(a, bytes, out, bytes) == 1) { return PMN_ERR_INVALID_PARAMETER; }
    for (var z = 0; z < n * n; z = z + 1) { store64(out + z * 8, 0); }
    for (var i = 0; i < n; i = i + 1) {
        var ri = i * n;
        for (var j = 0; j <= i; j = j + 1) {
            var rj = j * n;
            var sum: f64 = load64(a + (ri + j) * 8);
            for (var k = 0; k < j; k = k + 1) {
                var lik: f64 = load64(out + (ri + k) * 8);
                var ljk: f64 = load64(out + (rj + k) * 8);
                var p: f64 = lik * ljk;
                sum = sum - p;
            }
            if (i == j) {
                if (sum <= 0.0) { return PMN_ERR_INVALID_PARAMETER; }
                var r: f64 = f64_sqrt(sum);
                store64(out + (ri + j) * 8, r);
            } else {
                var ljj: f64 = load64(out + (rj + j) * 8);
                var q: f64 = sum / ljj;
                store64(out + (ri + j) * 8, q);
            }
        }
    }
    return PMN_ERR_NONE;
}

# hisab's `cholesky_solve(l, b)`: x with L·Lᵀ·x = b, into out (n f64s), by forward substitution L·y = b and back
# substitution Lᵀ·x = y, reading L's lower triangle and diagonal only; hisab's y and x share out, which gives the same
# values (each element is read before it is overwritten). out may be b itself, the solve then in place. PMN_ERR_NONE,
# n = 0 included (nothing to solve, as hisab's empty result); or PMN_ERR_INVALID_PARAMETER for a null buffer, out
# overlapping L or partly overlapping b, or n out of range. A zero diagonal divides by zero, as hisab's: ±∞ or NaN.
#must_use
fn _pmn_cholesky_solve(l, n, b, out): i64 {
    if (n < 0 || n > _PMN_LINALG_MAX_N) { return PMN_ERR_INVALID_PARAMETER; }
    if (n == 0) { return PMN_ERR_NONE; }
    if (l == 0 || b == 0 || out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    var vb = n * 8;
    if (_pmn_linalg_overlaps(l, n * vb, out, vb) == 1) { return PMN_ERR_INVALID_PARAMETER; }
    if (out != b && _pmn_linalg_overlaps(b, vb, out, vb) == 1) { return PMN_ERR_INVALID_PARAMETER; }
    for (var i = 0; i < n; i = i + 1) {
        var ri = i * n;
        var sum: f64 = load64(b + i * 8);
        for (var j = 0; j < i; j = j + 1) {
            var lij: f64 = load64(l + (ri + j) * 8);
            var yj: f64 = load64(out + j * 8);
            var p: f64 = lij * yj;
            sum = sum - p;
        }
        var lii: f64 = load64(l + (ri + i) * 8);
        var y: f64 = sum / lii;
        store64(out + i * 8, y);
    }
    var i2 = n - 1;
    while (i2 >= 0) {
        var s2: f64 = load64(out + i2 * 8);
        for (var j2 = i2 + 1; j2 < n; j2 = j2 + 1) {
            var lji: f64 = load64(l + (j2 * n + i2) * 8);
            var xj: f64 = load64(out + j2 * 8);
            var p2: f64 = lji * xj;
            s2 = s2 - p2;
        }
        var ld: f64 = load64(l + (i2 * n + i2) * 8);
        var x: f64 = s2 / ld;
        store64(out + i2 * 8, x);
        i2 = i2 - 1;
    }
    return PMN_ERR_NONE;
}

# ── eigen_symmetric (M4 part a3, ledger L6) ───────────────────────────────────────────────────────────

# hisab 1.4.0's `EPSILON_F64`: below it two diagonal entries count as equal, and the rotation angle is π/4.
var _PMN_HISAB_EPSILON: f64 = 0.000000000001;

# hisab's `eigen_symmetric(a, tol, max_iter)`: the cyclic Jacobi method, transcribed term for term. Each sweep visits
# the pairs p < q in order and rotates every w[p][q] with |w[p][q]| > tol², by θ = π/4 when |w[p][p] − w[q][q]| <
# 1e-12, else ½·atan(2·w[p][q] / (w[p][p] − w[q][q])): rows p and q of W first, then its columns, then V's columns.
# It stops after a sweep that rotated nothing, or after max_iter sweeps either way, as hisab does (no error for that).
# The eigenvalues, W's diagonal, are ordered by descending |λ| with a stable insertion sort (ADR 007 row 14: hisab's
# `sort_unstable_by` may order exactly equal |λ| otherwise; NaN compares equal, as its `partial_cmp(..).unwrap_or
# (Equal)`), into vals (n f64s); vecs (n × n, row-major) gets eigenvector k, V's column for the k-th, as its row k. The
# angle's atan, cos and sin are the correctly rounded ones (ADR 009), so values differ from 1.4.0's where glibc
# misrounds them. a is read whole (hisab's doc says the lower triangle; its code reads every entry). PMN_ERR_NONE;
# PMN_ERR_INVALID_PARAMETER for n = 0 (hisab's "empty matrix"), a null or overlapping buffer, an n whose n² words
# can't exist (they pass 2⁶³ bytes) or a negative max_iter; PMN_ERR_OUT_OF_MEMORY when the scratch (2n² + 3n f64s)
# can't be had.
#must_use
fn _pmn_eigen_symmetric(a, n, tol: f64, max_iter, vals, vecs): i64 {
    if (a == 0 || vals == 0 || vecs == 0 || n <= 0 || max_iter < 0) { return PMN_ERR_INVALID_PARAMETER; }
    var nn = _pmn_sz_mul(n, n);
    var nb = _pmn_sz_mul(nn, 8);
    if (nb < 0) { return PMN_ERR_INVALID_PARAMETER; }
    if (_pmn_linalg_overlaps(a, nb, vals, n * 8) == 1 || _pmn_linalg_overlaps(a, nb, vecs, nb) == 1) {
        return PMN_ERR_INVALID_PARAMETER;
    }
    if (_pmn_linalg_overlaps(vals, n * 8, vecs, nb) == 1) { return PMN_ERR_INVALID_PARAMETER; }
    if (n == 1) {
        store64(vals, load64(a));
        store64(vecs, 1.0);
        return PMN_ERR_NONE;
    }
    var s, slot = _pmn_scratch_take(_pmn_sz_mul(_pmn_sz_add(_pmn_sz_mul(2, nn), 3 * n), 8));
    if (s == 0) { return PMN_ERR_OUT_OF_MEMORY; }
    var w = s;
    var v = s + nn * 8;
    var np = v + nn * 8;
    var nq = np + n * 8;
    var ord = nq + n * 8;
    _pmn_copy_words(w, a, nn);
    for (var z = 0; z < nn; z = z + 1) { store64(v + z * 8, 0); }
    for (var d = 0; d < n; d = d + 1) { store64(v + (d * n + d) * 8, 1.0); }
    var tol_sq: f64 = tol * tol;
    var eps: f64 = _PMN_HISAB_EPSILON;
    var pi: f64 = _PMN_F64_PI;
    var quarter: f64 = pi * 0.25;                # FRAC_PI_4 = RN(π)/4 exactly
    for (var it = 0; it < max_iter; it = it + 1) {
        var converged = 1;
        for (var p = 0; p < n; p = p + 1) {
            for (var q = p + 1; q < n; q = q + 1) {
                var wpq: f64 = load64(w + (p * n + q) * 8);
                var awpq: f64 = f64_abs(wpq);
                if (awpq > tol_sq) {
                    converged = 0;
                    var wpp: f64 = load64(w + (p * n + p) * 8);
                    var wqq: f64 = load64(w + (q * n + q) * 8);
                    var dw: f64 = wpp - wqq;
                    var adw: f64 = f64_abs(dw);
                    var theta: f64 = quarter;
                    if (adw < eps) {
                        theta = quarter;
                    } else {
                        var two: f64 = 2.0 * wpq;
                        var ratio: f64 = two / dw;
                        var at: f64 = _pmn_atan(ratio);
                        theta = 0.5 * at;
                    }
                    var c: f64 = _pmn_cos(theta);
                    var sn: f64 = _pmn_sin(theta);
                    var ns: f64 = -sn;
                    for (var i = 0; i < n; i = i + 1) {
                        var wpi: f64 = load64(w + (p * n + i) * 8);
                        var wqi: f64 = load64(w + (q * n + i) * 8);
                        var a1: f64 = c * wpi;
                        var a2: f64 = sn * wqi;
                        var b1: f64 = ns * wpi;
                        var b2: f64 = c * wqi;
                        var rp: f64 = a1 + a2;
                        var rq: f64 = b1 + b2;
                        store64(np + i * 8, rp);
                        store64(nq + i * 8, rq);
                    }
                    _pmn_copy_words(w + p * n * 8, np, n);
                    _pmn_copy_words(w + q * n * 8, nq, n);
                    for (var i2 = 0; i2 < n; i2 = i2 + 1) {
                        var wp: f64 = load64(w + (i2 * n + p) * 8);
                        var wq: f64 = load64(w + (i2 * n + q) * 8);
                        var c1: f64 = c * wp;
                        var c2: f64 = sn * wq;
                        var d1: f64 = ns * wp;
                        var d2: f64 = c * wq;
                        var cp: f64 = c1 + c2;
                        var cq: f64 = d1 + d2;
                        store64(w + (i2 * n + p) * 8, cp);
                        store64(w + (i2 * n + q) * 8, cq);
                    }
                    for (var i3 = 0; i3 < n; i3 = i3 + 1) {
                        var vp: f64 = load64(v + (i3 * n + p) * 8);
                        var vq: f64 = load64(v + (i3 * n + q) * 8);
                        var e1: f64 = c * vp;
                        var e2: f64 = sn * vq;
                        var f1: f64 = ns * vp;
                        var f2: f64 = c * vq;
                        var xp: f64 = e1 + e2;
                        var xq: f64 = f1 + f2;
                        store64(v + (i3 * n + p) * 8, xp);
                        store64(v + (i3 * n + q) * 8, xq);
                    }
                }
            }
        }
        if (converged == 1) { it = max_iter; }
    }
    # The order: descending |λ|, stable.
    for (var k = 0; k < n; k = k + 1) {
        store64(ord + k * 8, k);
        var j = k - 1;
        var lk: f64 = load64(w + (k * n + k) * 8);
        var ak: f64 = f64_abs(lk);
        var go = 1;
        while (go == 1 && j >= 0) {
            var oj = load64(ord + j * 8);
            var lj: f64 = load64(w + (oj * n + oj) * 8);
            var aj: f64 = f64_abs(lj);
            if (aj < ak) {
                store64(ord + (j + 1) * 8, oj);
                j = j - 1;
            } else {
                go = 0;
            }
        }
        store64(ord + (j + 1) * 8, k);
    }
    for (var r = 0; r < n; r = r + 1) {
        var o = load64(ord + r * 8);
        store64(vals + r * 8, load64(w + (o * n + o) * 8));
        for (var i4 = 0; i4 < n; i4 = i4 + 1) { store64(vecs + (r * n + i4) * 8, load64(v + (i4 * n + o) * 8)); }
    }
    _pmn_scratch_give(s, slot);
    return PMN_ERR_NONE;
}

# ── least_squares_poly (M5 part a, ledger L5) ──────────────────────────────────────────────────────

# hisab 1.4.0's `least_squares_poly(x, y, degree)`: the degree-d least-squares polynomial of (x, y)[0, m), its d + 1
# coefficients a₀ … a_d into out. Transcribed term for term: the raw Vandermonde columns x^j (`powi` with a run-time
# exponent, compiler-rt's square-and-multiply), hisab's `qr_decompose` by modified Gram–Schmidt (each column's dot
# products with the earlier orthonormal columns from −0.0, subtracted in turn; its norm the correctly rounded √ of the
# sum of squares; columns dependent when the norm is below 1e-12), Qᵀy from −0.0, and back substitution. Every value
# is 1.4.0's bit for bit. PMN_ERR_NONE; PMN_ERR_INVALID_PARAMETER, as hisab's InvalidInput, for m = 0, m < d + 1 or
# dependent columns, and for a null or overlapping buffer or a negative count; PMN_ERR_OUT_OF_MEMORY when the scratch
# ((d + 1)(m + d + 2) f64s) can't be had. A NaN norm is not refused (NaN < 1e-12 is false), as hisab's.
#must_use
fn _pmn_least_squares_poly(x, y, m, degree, out): i64 {
    if (x == 0 || y == 0 || out == 0 || m <= 0 || degree < 0) { return PMN_ERR_INVALID_PARAMETER; }
    if (degree >= m) { return PMN_ERR_INVALID_PARAMETER; }    # m < d + 1, without computing d + 1 (it wraps at 2⁶³ − 1)
    var n = degree + 1;
    if (_pmn_linalg_overlaps(out, n * 8, x, m * 8) == 1 || _pmn_linalg_overlaps(out, n * 8, y, m * 8) == 1) {
        return PMN_ERR_INVALID_PARAMETER;
    }
    var words = _pmn_sz_add(_pmn_sz_add(_pmn_sz_mul(n, m), _pmn_sz_mul(n, n)), n);
    var s, slot = _pmn_scratch_take(_pmn_sz_mul(words, 8));
    if (s == 0) { return PMN_ERR_OUT_OF_MEMORY; }
    var q = s;                       # column j at q + j·m
    var r = q + n * m * 8;           # r[col][row] at r + (col·n + row)
    var qty = r + n * n * 8;
    for (var j = 0; j < n; j = j + 1) {
        for (var k = 0; k < m; k = k + 1) {
            var xk: f64 = load64(x + k * 8);
            var pw: f64 = _pmn_powi(xk, j);
            store64(q + (j * m + k) * 8, pw);
        }
    }
    for (var z = 0; z < n * n; z = z + 1) { store64(r + z * 8, 0); }
    var eps: f64 = _PMN_HISAB_EPSILON;
    for (var c = 0; c < n; c = c + 1) {
        for (var i = 0; i < c; i = i + 1) {
            var dot: f64 = -0.0;
            for (var k2 = 0; k2 < m; k2 = k2 + 1) {
                var qi: f64 = load64(q + (i * m + k2) * 8);
                var qc: f64 = load64(q + (c * m + k2) * 8);
                var pr: f64 = qi * qc;
                dot = dot + pr;
            }
            store64(r + (c * n + i) * 8, dot);
            for (var k3 = 0; k3 < m; k3 = k3 + 1) {
                var qi2: f64 = load64(q + (i * m + k3) * 8);
                var qc2: f64 = load64(q + (c * m + k3) * 8);
                var sub: f64 = dot * qi2;
                var nv: f64 = qc2 - sub;
                store64(q + (c * m + k3) * 8, nv);
            }
        }
        var ss: f64 = -0.0;
        for (var k4 = 0; k4 < m; k4 = k4 + 1) {
            var qv: f64 = load64(q + (c * m + k4) * 8);
            var sq: f64 = qv * qv;
            ss = ss + sq;
        }
        var norm: f64 = f64_sqrt(ss);
        if (norm < eps) {
            _pmn_scratch_give(s, slot);
            return PMN_ERR_INVALID_PARAMETER;
        }
        store64(r + (c * n + c) * 8, norm);
        for (var k5 = 0; k5 < m; k5 = k5 + 1) {
            var qv2: f64 = load64(q + (c * m + k5) * 8);
            var dv: f64 = qv2 / norm;
            store64(q + (c * m + k5) * 8, dv);
        }
    }
    for (var j2 = 0; j2 < n; j2 = j2 + 1) {
        var acc: f64 = -0.0;
        for (var k6 = 0; k6 < m; k6 = k6 + 1) {
            var qj: f64 = load64(q + (j2 * m + k6) * 8);
            var yk: f64 = load64(y + k6 * 8);
            var p2: f64 = qj * yk;
            acc = acc + p2;
        }
        store64(qty + j2 * 8, acc);
    }
    var i2 = n - 1;
    while (i2 >= 0) {
        var sum: f64 = load64(qty + i2 * 8);
        for (var j3 = i2 + 1; j3 < n; j3 = j3 + 1) {
            var rji: f64 = load64(r + (j3 * n + i2) * 8);
            var cj: f64 = load64(out + j3 * 8);
            var p3: f64 = rji * cj;
            sum = sum - p3;
        }
        var rii: f64 = load64(r + (i2 * n + i2) * 8);
        var ci: f64 = sum / rii;
        store64(out + i2 * 8, ci);
        i2 = i2 - 1;
    }
    _pmn_scratch_give(s, slot);
    return PMN_ERR_NONE;
}
