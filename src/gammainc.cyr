# gammainc.cyr — the regularized incomplete gamma P(a, x) and Q(a, x) within 4 ulp (T1, M2 part b4; port plan
# D3 = C, §3.4; ADR 009: ≤ 4 ulp for a in [1e-3, 1e5] and x > 0; for any other a up to 1e9, no row less accurate
# than Rust's).
#
# Probe P9's prototype (§5 step 9d-2), moved here unchanged but for names. It keeps Rust's two expansions, the series
# for P and Legendre's continued fraction for Q, with four changes:
# - the prefactor's exponent a ln x − x − lnΓ(a) is a double-double. Below a = 10, lnΓ(a) comes from the ζ series of
#   lnΓ(1 + f) (src/zeta_data.cyr) and an exact recurrence. From a = 10 it is Rust's cancellation-free kernel, with
#   u − ln(1 + u) as an exact series, or with ln(1 + u) taken as ln x − ln a so that u's rounding never enters.
#   kimiya's exp core takes the double-double;
# - the series and the continued fraction run in double-double and stop under 2^-62;
# - the split is at x = a, so a complement is taken only where it can't cancel: Q = 1 − P where P ≤ 0.64, and
#   P = 1 − Q where Q ≤ 1/2;
# - for a < 1 and x < 1.1, Q comes directly from (Γ(1 + a) − x^a − a·x^a·Σ (−x)^n/(n!(a + n)))/Γ(1 + a), not as
#   1 − P (Rust's 246-ulp row).
# Three fixes to P9's form, each found past its sets (a from 1e-3 to 1e5, x to 50a): the series stops on a bound of
# its tail, not on its last term; below a = 2^-512 its Σ/a is formed as Σ/(a·2^600), as Dekker's split overflowed into
# a NaN; and past x = 2^990 the result is (1, 0) directly, where the kernel overflowed the same way.
# Each result is rounded once; a subnormal one is rounded twice, by the final scaling, by at most 2^-1074. P9 measured
# it within 1.0 ulp (mean ≤ 0.25) on 360,400 rows against a 320-bit reference, where 1.3.0 is off by up to 485 ulp on
# §3.2's pairs and by 2.9×10⁹ in the deep lower tail. It costs 10–17× 1.3.0's form: every loop step is double-double.
#
# UPSTREAM(L8): ganita:docs/development/issues/2026-11-15-special-functions-scope-request.md
#   replace with ganita's incomplete gamma if it takes the special functions on, at ADR 009's bound; parity: every
#   gamma_inc row of special.ref.tsv

# lnΓ(1 + f) for 0 ≤ f < 1 as a double-double: −γf + Σ (−1)^k ζ(k)/k·f^k up to f = 1/2, and with y = f − 1,
# (1 − γ)y + Σ (−1)^k (ζ(k) − 1)/k·y^k above (terms below 2^-k and 4^-k: the sums stop under 2^-62 of the value).
#must_use
fn _pmn_gi_lngamma1p_dd(f: f64): (f64, f64) {
    if (f == 0.0) { return (0.0, 0.0); }
    var gh: f64 = _PMN_ZT_EULER_H;
    var gl: f64 = _PMN_ZT_EULER_L;
    var thr: f64 = 0x3C10000000000000;          # 0x1p-62
    var y: f64 = f;
    var ch: f64 = 0.0;
    var cl: f64 = 0.0;
    var useh = 1;
    if (f > 0.5) {
        y = f - 1.0;
        var oh, ol = _pmn_km_two_sum(1.0, -gh);
        var ol2: f64 = ol - gl;
        ch = oh;
        cl = ol2;
        useh = 0;
    } else {
        ch = -gh;
        cl = -gl;
    }
    var acc, accl = _pmn_dd_mul_d(ch, cl, y);
    var ph: f64 = y;
    var pl: f64 = 0.0;
    var k = 2;
    while (k <= 64) {
        var nh, nl = _pmn_dd_mul_d(ph, pl, y);
        ph = nh;
        pl = nl;
        var zh: f64 = load64(&_PMN_ZT_ZH + k * 8);
        var zl: f64 = load64(&_PMN_ZT_ZL + k * 8);
        if (useh == 0) {
            zh = load64(&_PMN_ZT_MH + k * 8);
            zl = load64(&_PMN_ZT_ML + k * 8);
        }
        var th, tl = _pmn_dd_mul(zh, zl, ph, pl);
        var fk: f64 = f64_from(k);
        var uh, ul = _pmn_dd_div(th, tl, fk, 0.0);
        if ((k & 1) == 1) {
            uh = -uh;
            ul = -ul;
        }
        var sh, sl = _pmn_dd_add(acc, accl, uh, ul);
        acc = sh;
        accl = sl;
        var au: f64 = f64_abs(uh);
        var aa: f64 = f64_abs(acc);
        var lim: f64 = aa * thr;
        if (au < lim) { break; }
        k = k + 1;
    }
    return (acc, accl);
}

# lnΓ(a) for 0 < a < 20 as a double-double: lnΓ(1 + f) − ln a below 1, else lnΓ(1 + f) + ln((1 + f)…(m − 1 + f))
# with a = m + f and the product a double-double (the incomplete gamma calls it below 10).
#must_use
fn _pmn_gi_lngamma_small_dd(a: f64): (f64, f64) {
    if (a < 1.0) {
        var gh, gl = _pmn_gi_lngamma1p_dd(a);
        var lh, ll = _pmn_dd_ln_any(a);
        var rh, rl = _pmn_dd_add(gh, gl, -lh, -ll);
        return (rh, rl);
    }
    var mf: f64 = f64_floor(a);
    var f: f64 = a - mf;
    var m = f64_to(mf);
    var g2h, g2l = _pmn_gi_lngamma1p_dd(f);
    if (m < 2) { return (g2h, g2l); }
    var zh, zl = _pmn_km_two_sum(1.0, f);
    var j = 2;
    while (j < m) {
        var fj: f64 = f64_from(j);
        var th, tl = _pmn_km_two_sum(fj, f);
        var nh, nl = _pmn_dd_mul(zh, zl, th, tl);
        zh = nh;
        zl = nl;
        j = j + 1;
    }
    var lzh, lzl = _pmn_dd_ln(zh);
    var cz: f64 = zl / zh;
    var lzl2: f64 = lzl + cz;
    var sh, sl = _pmn_dd_add(g2h, g2l, lzh, lzl2);
    return (sh, sl);
}

# The prefactor's exponent M = a ln x − x − lnΓ(a) as a double-double.
#must_use
fn _pmn_gi_lnpre(a: f64, x: f64): (f64, f64) {
    if (a < 10.0) {
        var lh, ll = _pmn_dd_ln_any(x);
        var th, tl = _pmn_dd_mul_d(lh, ll, a);
        var sh, sl = _pmn_dd_add(th, tl, -x, 0.0);
        var gh, gl = _pmn_gi_lngamma_small_dd(a);
        var mh, ml = _pmn_dd_add(sh, sl, -gh, -gl);
        return (mh, ml);
    }
    # a ≥ 10: −a·φ(u) + ½ ln a − ln √(2π) − stirling(a), u = (x − a)/a, φ(u) = u − ln(1 + u).
    var dh, dl = _pmn_km_two_sum(x, -a);
    var uh, ul = _pmn_dd_div(dh, dl, a, 0.0);
    var fh: f64 = 0.0;
    var fl: f64 = 0.0;
    var lah, lal = _pmn_dd_ln(a);
    var au: f64 = f64_abs(uh);
    if (au <= 0.25) {
        # φ(u) = Σ_{k≥2} (−u)^k/k, exactly enough: terms fall by 4 or more.
        var wh: f64 = -uh;
        var wl: f64 = -ul;
        var ph, pl = _pmn_dd_mul(wh, wl, wh, wl);
        var thr: f64 = 0x3C10000000000000;      # 0x1p-62
        var k = 2;
        while (k < 200) {
            var fk: f64 = f64_from(k);
            var th2, tl2 = _pmn_dd_div(ph, pl, fk, 0.0);
            var sh2, sl2 = _pmn_dd_add(fh, fl, th2, tl2);
            fh = sh2;
            fl = sl2;
            var at: f64 = f64_abs(th2);
            var af: f64 = f64_abs(fh);
            var lim: f64 = af * thr;
            # 2.0.1: u = 0 (x = a) makes every term 0 and lim 0, so `at < lim` never held and the loop ran its 198
            # steps; the rest add exact zeros, so stopping at a zero term leaves the bits as they were.
            if (at < lim || th2 == 0.0) { break; }
            var nh, nl = _pmn_dd_mul(ph, pl, wh, wl);
            ph = nh;
            pl = nl;
            k = k + 1;
        }
    } else {
        # ln(1 + u) = ln x − ln a exactly, so u's rounding never enters the logarithm.
        var lxh, lxl = _pmn_dd_ln_any(x);
        var l1h, l1l = _pmn_dd_add(lxh, lxl, -lah, -lal);
        var ph2, pl2 = _pmn_dd_add(uh, ul, -l1h, -l1l);
        fh = ph2;
        fl = pl2;
    }
    var ah, al = _pmn_dd_mul_d(fh, fl, a);
    var hh: f64 = 0.5 * lah;
    var hl: f64 = 0.5 * lal;
    var pih: f64 = _PMN_KM_CR_SC_PIH;
    var pim: f64 = _PMN_KM_CR_SC_PIM;
    var tph: f64 = 2.0 * pih;
    var tpm: f64 = 2.0 * pim;
    var lph, lpl = _pmn_dd_ln(tph);
    var cp: f64 = tpm / tph;
    var lpl2: f64 = lpl + cp;
    var sph: f64 = 0.5 * lph;
    var spl: f64 = 0.5 * lpl2;
    var st: f64 = _pmn_stirling_error(a);       # Rust's series, as a ≥ 10
    var r1h, r1l = _pmn_dd_add(hh, hl, -ah, -al);
    var r2h, r2l = _pmn_dd_add(r1h, r1l, -sph, -spl);
    var r3h, r3l = _pmn_dd_add(r2h, r2l, -st, 0.0);
    return (r3h, r3l);
}

# e^M for a double-double M, as (h, l, E) with h + l = e^M/2^E near 2^-70; E = −100000 when e^M underflows.
#must_use
fn _pmn_gi_exp_dd(mh: f64, ml: f64): (f64, f64, i64) {
    var lo: f64 = -1100.0;
    if (mh < lo) { return (0.0, 0.0, 0 - 100000); }
    var h, l, e = _pmn_km_exp_core(mh, ml);
    return (h, l, e);
}

# The series Σ_{n≥0} Π_{k=1..n} x/(a + k) as a double-double, stopping once the tail is under 2^-62 of the sum: the
# terms after t_n are below t_n·r/(1 − r) with r = x/(a + n + 1), so the test is t_n·x < 2^-62·S·(a + n + 1 − x). P9
# stopped at t_n < 2^-62·S, which near x = a leaves a tail of t_n/(1 − r), about √a/9 terms' worth: 7 ulp at a = 1e9
# (M2 part b4's crverify set), 0.07 at 1e5.
#must_use
fn _pmn_gi_series(a: f64, x: f64): (f64, f64) {
    var sh: f64 = 1.0;
    var sl: f64 = 0.0;
    var th: f64 = 1.0;
    var tl: f64 = 0.0;
    var thr: f64 = 0x3C10000000000000;          # 0x1p-62
    var n = 1;
    var cap = 2000 + 100 * f64_to(f64_sqrt(a));
    while (n < cap) {
        var fnn: f64 = f64_from(n);
        var dh, dl = _pmn_km_two_sum(a, fnn);
        var qh, ql = _pmn_dd_div(x, 0.0, dh, dl);
        var mh, ml = _pmn_dd_mul(th, tl, qh, ql);
        th = mh;
        tl = ml;
        var nh, nl = _pmn_dd_add(sh, sl, th, tl);
        sh = nh;
        sl = nl;
        var axn: f64 = a - x;
        var gap: f64 = axn + (fnn + 1.0);
        var tx: f64 = th * x;
        var lim: f64 = sh * thr;
        var lim2: f64 = lim * gap;
        if (tx < lim2) { break; }
        n = n + 1;
    }
    return (sh, sl);
}

# Legendre's continued fraction for Γ(a, x)·e^x·x^-a by modified Lentz, in double-double, stopping when a step
# changes the value by under 2^-62.
#must_use
fn _pmn_gi_cf(a: f64, x: f64): (f64, f64) {
    var tiny: f64 = 0x0010000000000000;         # 0x1p-1022
    var bh, bl0 = _pmn_km_two_sum(x, -a);
    var b1h, b1l = _pmn_dd_add(bh, bl0, 1.0, 0.0);
    bh = b1h;
    var bl: f64 = b1l;
    var dh, dl = _pmn_dd_div(1.0, 0.0, bh, bl);
    var hh: f64 = dh;
    var hl: f64 = dl;
    var ch: f64 = 0.0;
    var cl: f64 = 0.0;
    var thr: f64 = 0x3C10000000000000;          # 0x1p-62
    var cap = 2000 + 100 * f64_to(f64_sqrt(a));
    var i = 1;
    while (i < cap) {
        var fi: f64 = f64_from(i);
        var ih, il = _pmn_km_two_sum(fi, -a);
        var anh, anl = _pmn_dd_mul_d(ih, il, fi);
        anh = -anh;
        anl = -anl;
        var b2h, b2l = _pmn_dd_add(bh, bl, 2.0, 0.0);
        bh = b2h;
        bl = b2l;
        var adh, adl = _pmn_dd_mul(anh, anl, dh, dl);
        var d2h, d2l = _pmn_dd_add(adh, adl, bh, bl);
        var dab: f64 = f64_abs(d2h);
        if (dab < tiny) {
            d2h = tiny;
            d2l = 0.0;
        }
        if (i == 1) {
            # c starts at "infinity", so the first c is b itself.
            ch = bh;
            cl = bl;
        } else {
            var qh, ql = _pmn_dd_div(anh, anl, ch, cl);
            var c2h, c2l = _pmn_dd_add(bh, bl, qh, ql);
            ch = c2h;
            cl = c2l;
        }
        var cab: f64 = f64_abs(ch);
        if (cab < tiny) {
            ch = tiny;
            cl = 0.0;
        }
        var rdh, rdl = _pmn_dd_div(1.0, 0.0, d2h, d2l);
        dh = rdh;
        dl = rdl;
        var delh, dell = _pmn_dd_mul(dh, dl, ch, cl);
        var nhh, nhl = _pmn_dd_mul(hh, hl, delh, dell);
        hh = nhh;
        hl = nhl;
        var dm1h, dm1l = _pmn_dd_add(delh, dell, -1.0, 0.0);
        var dev: f64 = f64_abs(dm1h);
        if (dev < thr) { break; }
        i = i + 1;
    }
    return (hh, hl);
}

# Q for a < 1 and x < 1.1, directly: (Γ(1 + a) − x^a − a·x^a·T)/Γ(1 + a), T = Σ_{n≥1} (−x)^n/(n!(a + n)),
# with Γ(1 + a) − 1 = expm1(lnΓ(1 + a)) and x^a − 1 = expm1(a ln x), all in double-double.
#must_use
fn _pmn_gi_small_q(a: f64, x: f64): f64 {
    var lgh, lgl = _pmn_gi_lngamma1p_dd(a);
    var g1h, g1l = _pmn_dd_expm1(lgh, lgl);
    var lxh, lxl = _pmn_dd_ln_any(x);
    var alh, all = _pmn_dd_mul_d(lxh, lxl, a);
    var p1h, p1l = _pmn_dd_expm1(alh, all);
    var th: f64 = 0.0;
    var tl: f64 = 0.0;
    var ch: f64 = 1.0;
    var cl: f64 = 0.0;
    var nx: f64 = -x;
    var thr: f64 = 0x3C10000000000000;          # 0x1p-62
    var n = 1;
    while (n < 80) {
        var fnn: f64 = f64_from(n);
        var mh, ml = _pmn_dd_mul_d(ch, cl, nx);
        var qh, ql = _pmn_dd_div(mh, ml, fnn, 0.0);
        ch = qh;
        cl = ql;
        var dh, dl = _pmn_km_two_sum(a, fnn);
        var uh, ul = _pmn_dd_div(ch, cl, dh, dl);
        var sh, sl = _pmn_dd_add(th, tl, uh, ul);
        th = sh;
        tl = sl;
        var au: f64 = f64_abs(uh);
        var as: f64 = f64_abs(th);
        var lim: f64 = as * thr;
        if (au < lim) { break; }
        n = n + 1;
    }
    var xah, xal = _pmn_dd_add(1.0, 0.0, p1h, p1l);
    var axh, axl = _pmn_dd_mul_d(xah, xal, a);
    var wh, wl = _pmn_dd_mul(axh, axl, th, tl);
    var dfh, dfl = _pmn_dd_add(g1h, g1l, -p1h, -p1l);
    var nmh, nml = _pmn_dd_add(dfh, dfl, -wh, -wl);
    var gmh, gml = _pmn_dd_add(1.0, 0.0, g1h, g1l);
    var qh2, ql2 = _pmn_dd_div(nmh, nml, gmh, gml);
    var r: f64 = qh2 + ql2;
    return r;
}

# T1 (P, Q) for 0 < a ≤ 1e9 (special.cyr's gamma_inc keeps Rust's Wilson–Hilferty form past 1e9). (NaN, NaN) for a NaN
# argument or a ≤ 0; (0, 1) for x ≤ 0 or a = +∞; (1, 0) for x = +∞; each as Rust's.
#must_use
fn _pmn_gi_gamma_inc(a: f64, x: f64): (f64, f64) {
    var nan: f64 = _PMN_F64_NAN;
    if (x != x || a != a || a <= 0.0) { return (nan, nan); }
    if (x <= 0.0) { return (0.0, 1.0); }
    var inf: f64 = _PMN_F64_INFINITY;
    if (x == inf) { return (1.0, 0.0); }
    if (a == inf) { return (0.0, 1.0); }
    # Past x = 2^990, Q is far below 2^-1075 for every a up to 1e9 (the exponent is about −x), and from a = 10 the
    # kernel's (x − a)/a and a·φ(u) would overflow Dekker's split near x = 2^996·a: (1, 0), which the underflowed
    # prefactor gives below (M2 part b4 found the NaN at x = f64::MAX; P9's sets stopped at 50a).
    var huge: f64 = 0x7DD0000000000000;         # 0x1p990
    if (x > huge) { return (1.0, 0.0); }
    var mh, ml = _pmn_gi_lnpre(a, x);
    var eh, el, e = _pmn_gi_exp_dd(mh, ml);
    if (x < a || (a < 1.0 && x < 1.1)) {
        var sh, sl = _pmn_gi_series(a, x);
        # Σ/a passes 2^996, where Dekker's split overflows, once a is below about 2^-995: below 2^-512 the sum is
        # divided by a·2^600 and the scale takes the 600 back, both exactly (M2 part b4 found the NaN at a = 1e-300;
        # P9's sets stopped at 1e-3).
        var ad: f64 = a;
        var es = e;
        var t512: f64 = 0x1FF0000000000000;    # 0x1p-512
        if (a < t512) {
            var p600: f64 = 0x6570000000000000; # 0x1p600
            ad = a * p600;
            es = e + 600;
        }
        var s2h, s2l = _pmn_dd_div(sh, sl, ad, 0.0);
        var ph, pl = _pmn_dd_mul(eh, el, s2h, s2l);
        var pr: f64 = ph + pl;
        var p: f64 = _pmn_dd_scale(pr, es);
        if (a < 1.0 && x < 1.1) {
            var qs: f64 = _pmn_gi_small_q(a, x);
            return (p, qs);
        }
        # Q = 1 − P, with P ≤ 0.64 here (x < a, a ≥ 1): the scaled double-double, then one rounding.
        var s: f64 = _pmn_km_cr_pow2(e);
        if (e < 0 - 1000) { s = 0.0; }
        var psh: f64 = ph * s;
        var psl: f64 = pl * s;
        var qh, ql = _pmn_dd_add(1.0, 0.0, -psh, -psl);
        var q: f64 = qh + ql;
        return (p, q);
    }
    var hh, hl = _pmn_gi_cf(a, x);
    var qqh, qql = _pmn_dd_mul(eh, el, hh, hl);
    var qr: f64 = qqh + qql;
    var q2: f64 = _pmn_dd_scale(qr, e);
    var s2: f64 = _pmn_km_cr_pow2(e);
    if (e < 0 - 1000) { s2 = 0.0; }
    var qsh: f64 = qqh * s2;
    var qsl: f64 = qql * s2;
    var p2h, p2l = _pmn_dd_add(1.0, 0.0, -qsh, -qsl);
    var p2: f64 = p2h + p2l;
    return (p2, q2);
}
