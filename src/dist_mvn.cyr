# dist_mvn.cyr — Rust 1.3.0's `MultivariateNormal` (src/distribution.rs; port plan §4.1, D5, D7, D11, D12; M3 part
# d2): its constructor, `dim`, `pdf`, `log_pdf`, `sample`, `mean_vec`, `covariance_matrix`, Clone, serde_json's codec
# and the derived Debug.
#
# The one owned distribution (D11, §8.5). The struct lives in caller storage, and its buffers in one freelist block
# sized at construction: the mean (d f64s), the covariance (d × d, row-major) and the lower Cholesky factor L (d × d,
# zeros above the diagonal). `PmnMultivariateNormal_drop` frees the block; a dropped one refuses every call. Rust's
# `Vec<Vec<f64>>` covariance is a flat row-major array with its rows and columns (§8.3), so the constructor still
# tells a covariance of the wrong shape (DimensionMismatch) from a bad one (InvalidParameter); a flat array can't be
# ragged, a JSON document can, and reads as PMN_ERR_DESERIALIZE as in Rust.
#
# Every value is Rust's in its operation order: the factor is hisab 1.4.0's (src/linalg.cyr, bit for bit), log det Σ is
# 2·Σ ln L_ii summed from −0.0, the density solves L·Lᵀ·w = x − μ with hisab's solve, and a draw is μ + L·z with z from
# Box–Muller's both branches. The transcendentals are the correctly rounded ln, exp, cos and sin (ADR 009), so values
# differ from 1.3.0's only where glibc misrounds. `pdf` and `log_pdf` return a value-form Result, Ok holding the f64's
# bits; their scratch (2d f64s) comes from the work-table pool, so a density in a loop allocates nothing. A draw goes
# into a caller buffer of d f64s (D11).

include "src/rng.cyr"   # the PmnRng trait, for `cyrius lint`'s compile of this file alone (see src/dist.cyr)

# Rust's `MultivariateNormal`: the d-dimensional normal with mean μ and symmetric positive-definite covariance Σ.
# n is Rust's private `dim`, buf the owned block, log_det Rust's cached log det Σ.
struct PmnMultivariateNormal {
    n;
    buf;
    log_det: f64;
}

# ln 2π as the port computes it, the correctly rounded ln of the double 2π (Rust's `(2.0 * PI).ln()`), held as its bit
# pattern: scripts/crverify/consts.py proves it, and tests/dist_mvn.tcyr checks it against `_pmn_ln`.
var _PMN_MVN_LN_2PI: f64 = 0x3FFD67F1C864BEB4;

# The block's bytes for dimension d: the mean, the covariance and the factor.
#must_use
#pure
fn _pmn_mvn_bytes(d): i64 {
    return (d + 2 * d * d) * 8;
}

# Rust's `MultivariateNormal::new(mean, covariance)`, with mean[0, d) and the rows × cols covariance at cov (row-major),
# into out (caller storage, D11). The checks are Rust's, in its order:
# - PMN_ERR_INVALID_PARAMETER for an empty mean, then for a non-finite mean element;
# - PMN_ERR_DIMENSION_MISMATCH when the covariance has other than d rows, then other than d columns;
# - PMN_ERR_INVALID_PARAMETER for a non-finite covariance element, an asymmetry past Rust's relative tolerance
#   (|Σ_ij − Σ_ji| > 1e-10·max(|Σ_ij|, |Σ_ji|, f64::MIN_POSITIVE)), a factor hisab refuses (not positive-definite), or
#   a log det Σ that isn't finite (a NaN pivot the factor kept).
# Before them, PMN_ERR_INVALID_PARAMETER for a null out, a null mean or covariance, or a negative count, and once the
# shape is d × d, for d past 2^26 (no such covariance fits in memory); PMN_ERR_OUT_OF_MEMORY when the block can't be
# had.
# On a refusal out is untouched and nothing is held. out may overlap mean or cov: it is written last. A live
# MultivariateNormal in out is overwritten, not freed: drop it first.
#must_use
fn PmnMultivariateNormal_new(out: *PmnMultivariateNormal, mean, d, cov, rows, cols): i64 {
    if (out == 0 || d < 0 || rows < 0 || cols < 0 || (mean == 0 && d > 0)) { return PMN_ERR_INVALID_PARAMETER; }
    if (d == 0) { return PMN_ERR_INVALID_PARAMETER; }
    for (var i = 0; i < d; i = i + 1) {
        var mi: f64 = load64(mean + i * 8);
        if (_pmn_is_finite(mi) == 0) { return PMN_ERR_INVALID_PARAMETER; }
    }
    if (rows != d || cols != d) { return PMN_ERR_DIMENSION_MISMATCH; }
    if (d > _PMN_LINALG_MAX_N || cov == 0) { return PMN_ERR_INVALID_PARAMETER; }
    var dd = d * d;
    for (var k = 0; k < dd; k = k + 1) {
        var ck: f64 = load64(cov + k * 8);
        if (_pmn_is_finite(ck) == 0) { return PMN_ERR_INVALID_PARAMETER; }
    }
    var tol: f64 = _PMN_DISTRIBUTION_MVN_SYMMETRY_TOL;
    var mp: f64 = _PMN_F64_MIN_POSITIVE;
    for (var r = 0; r < d; r = r + 1) {
        for (var c = r + 1; c < d; c = c + 1) {
            var cij: f64 = load64(cov + (r * d + c) * 8);
            var cji: f64 = load64(cov + (c * d + r) * 8);
            var aij: f64 = f64_abs(cij);
            var aji: f64 = f64_abs(cji);
            var m1: f64 = _pmn_max(aij, aji);
            var scale: f64 = _pmn_max(m1, mp);
            var diff: f64 = cij - cji;
            var ad: f64 = f64_abs(diff);
            var lim: f64 = tol * scale;
            if (ad > lim) { return PMN_ERR_INVALID_PARAMETER; }
        }
    }
    var blk = fl_alloc(_pmn_mvn_bytes(d));
    if (blk == 0) { return PMN_ERR_OUT_OF_MEMORY; }
    var bc = blk + d * 8;
    var bl = bc + dd * 8;
    _pmn_copy_words(blk, mean, d);
    _pmn_copy_words(bc, cov, dd);
    if (_pmn_cholesky(bc, d, bl) != PMN_ERR_NONE) {
        fl_free(blk);
        return PMN_ERR_INVALID_PARAMETER;
    }
    var s: f64 = -0.0;
    for (var j = 0; j < d; j = j + 1) {
        var lj: f64 = load64(bl + (j * d + j) * 8);
        var g: f64 = _pmn_ln(lj);
        s = s + g;
    }
    var ld: f64 = s * 2.0;
    if (_pmn_is_finite(ld) == 0) {
        fl_free(blk);
        return PMN_ERR_INVALID_PARAMETER;
    }
    out.n = d;
    out.buf = blk;
    out.log_det = ld;
    return PMN_ERR_NONE;
}

# Rust's derived Clone: a new block holding src's mean, covariance and factor, into out. PMN_ERR_NONE;
# PMN_ERR_INVALID_PARAMETER for a null or dropped src, a null out, or out overlapping src (cloning into src would lose
# its block); PMN_ERR_OUT_OF_MEMORY when the block can't be had. Drop each one.
#must_use
fn PmnMultivariateNormal_clone(out: *PmnMultivariateNormal, src: *PmnMultivariateNormal): i64 {
    if (out == 0 || src == 0 || src.buf == 0) { return PMN_ERR_INVALID_PARAMETER; }
    if (_pmn_linalg_overlaps(out, 24, src, 24) == 1) { return PMN_ERR_INVALID_PARAMETER; }
    var d = src.n;
    var nb = _pmn_mvn_bytes(d);
    var blk = fl_alloc(nb);
    if (blk == 0) { return PMN_ERR_OUT_OF_MEMORY; }
    _pmn_copy_words(blk, src.buf, nb / 8);
    var ld: f64 = src.log_det;
    out.n = d;
    out.buf = blk;
    out.log_det = ld;
    return PMN_ERR_NONE;
}

# Frees m's block and marks it dropped (every call on it then refuses). PMN_ERR_NONE, a dropped one included;
# PMN_ERR_INVALID_PARAMETER for a null m.
fn PmnMultivariateNormal_drop(m: *PmnMultivariateNormal): i64 {
    if (m == 0) { return PMN_ERR_INVALID_PARAMETER; }
    if (m.buf != 0) { fl_free(m.buf); }
    m.buf = 0;
    m.n = 0;
    return PMN_ERR_NONE;
}

impl PmnMultivariateNormal {
    # Rust's `dim`: d, or 0 for a dropped one.
    #must_use
    fn dim(self): i64 {
        if (self == 0 || self.buf == 0) { return 0; }
        return self.n;
    }

    # Rust's `mean_vec`: the mean's d f64s, borrowed from the block until the drop; 0 for a dropped one.
    #must_use
    fn mean_vec(self): i64 {
        if (self == 0) { return 0; }
        return self.buf;
    }

    # Rust's `covariance_matrix`: the covariance's d × d f64s (row-major), borrowed until the drop; 0 for a dropped one.
    #must_use
    fn covariance_matrix(self): i64 {
        if (self == 0 || self.buf == 0) { return 0; }
        return self.buf + self.n * 8;
    }

    # Rust's `log_pdf(x)`, x[0, n): Ok(−½·(d·ln 2π + log det Σ + (x − μ)ᵀ·w)), w solving L·Lᵀ·w = x − μ by hisab's
    # solve, the dot product summed from −0.0. Err(PMN_ERR_DIMENSION_MISMATCH) when n ≠ d;
    # Err(PMN_ERR_INVALID_PARAMETER) for a null x or a dropped self; Err(PMN_ERR_OUT_OF_MEMORY) when the pool can't
    # give its 2d f64s of scratch.
    #must_use
    fn log_pdf(self, x, n): Result {
        if (self == 0 || self.buf == 0) { return Err(PMN_ERR_INVALID_PARAMETER); }
        var d = self.n;
        if (n != d) { return Err(PMN_ERR_DIMENSION_MISMATCH); }
        if (x == 0) { return Err(PMN_ERR_INVALID_PARAMETER); }
        var s, slot = _pmn_scratch_take(2 * d * 8);
        if (s == 0) { return Err(PMN_ERR_OUT_OF_MEMORY); }
        var w = s + d * 8;
        var mu = self.buf;
        var l = mu + (d + d * d) * 8;
        for (var i = 0; i < d; i = i + 1) {
            var xi: f64 = load64(x + i * 8);
            var mi: f64 = load64(mu + i * 8);
            var di: f64 = xi - mi;
            store64(s + i * 8, di);
        }
        var e = _pmn_cholesky_solve(l, d, s, w);
        var m: f64 = -0.0;
        for (var j = 0; j < d; j = j + 1) {
            var dj: f64 = load64(s + j * 8);
            var wj: f64 = load64(w + j * 8);
            var p: f64 = dj * wj;
            m = m + p;
        }
        _pmn_scratch_give(s, slot);
        if (e != PMN_ERR_NONE) { return Err(PMN_ERR_COMPUTATION_ERROR); }   # Rust's map of a solve error: unreachable
        var df: f64 = f64_from(d);
        var lt: f64 = _PMN_MVN_LN_2PI;
        var t1: f64 = df * lt;
        var ld: f64 = self.log_det;
        var t2: f64 = t1 + ld;
        var t3: f64 = t2 + m;
        var r: f64 = -0.5 * t3;
        return Ok(r);
    }

    # Rust's `pdf(x)`: Ok(exp(log_pdf(x))), or log_pdf's error.
    #must_use
    fn pdf(self, x, n): Result {
        var t, v = self.log_pdf(x, n);
        if (t == Err) { return Err(v); }
        var lp: f64 = v;
        var r: f64 = _pmn_exp(lp);
        return Ok(r);
    }

    # Rust's `sample`, into out[0, d) (cap ≥ d, D11): μ + L·z, z the d N(0, 1) variates of Box–Muller's pairs,
    # √(−2 ln u1)·cos(2π u2) then √(−2 ln u1)·sin(2π u2), u1 kept from 0 by f64::MIN_POSITIVE; an odd d draws the last
    # pair's two uniforms and keeps its cosine. Row i's sum Σ_(k ≤ i) L_ik·z_k runs from −0.0 in k order, as Rust's;
    # z sits in out and the rows are done from the last up, so row i reads z_0 … z_i while they are still z.
    # PMN_ERR_NONE; PMN_ERR_INVALID_PARAMETER, drawing nothing, for a null rng or out, cap < d, out overlapping the
    # block, or a dropped self.
    #must_use
    fn sample<R: PmnRng>(self, rng: *R, out, cap): i64 {
        if (self == 0 || self.buf == 0 || rng == 0 || out == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var d = self.n;
        if (cap < d) { return PMN_ERR_INVALID_PARAMETER; }
        if (_pmn_linalg_overlaps(out, d * 8, self.buf, _pmn_mvn_bytes(d)) == 1) { return PMN_ERR_INVALID_PARAMETER; }
        var mp: f64 = _PMN_F64_MIN_POSITIVE;
        var tp: f64 = 2.0 * _PMN_F64_PI;
        var k = 0;
        while (k < d) {
            var d1: f64 = rng.next_f64();
            var u1: f64 = _pmn_max(d1, mp);
            var u2: f64 = rng.next_f64();
            var lu: f64 = _pmn_ln(u1);
            var a: f64 = -2.0 * lu;
            var rr: f64 = f64_sqrt(a);
            var th: f64 = tp * u2;
            var c: f64 = _pmn_cos(th);
            var zc: f64 = rr * c;
            store64(out + k * 8, zc);
            k = k + 1;
            if (k < d) {
                var sn: f64 = _pmn_sin(th);
                var zs: f64 = rr * sn;
                store64(out + k * 8, zs);
                k = k + 1;
            }
        }
        var mu = self.buf;
        var l = mu + (d + d * d) * 8;
        var i = d - 1;
        while (i >= 0) {
            var s: f64 = -0.0;
            for (var j = 0; j <= i; j = j + 1) {
                var lij: f64 = load64(l + (i * d + j) * 8);
                var zj: f64 = load64(out + j * 8);
                var p: f64 = lij * zj;
                s = s + p;
            }
            var mi: f64 = load64(mu + i * 8);
            var xi: f64 = mi + s;
            store64(out + i * 8, xi);
            i = i - 1;
        }
        return PMN_ERR_NONE;
    }

    # Appends Rust's derived Debug (D12): `MultivariateNormal { mean: [..], covariance: [[..], ..], cholesky_l: [[..],
    # ..], log_det: .., dim: d }` for `{:?}` (alternate 0), or the pretty form, each list one entry a line (1).
    # PMN_ERR_NONE; PMN_ERR_OUT_OF_MEMORY when sb can't grow; PMN_ERR_INVALID_PARAMETER for a dropped self.
    #must_use
    fn debug(self, sb, alternate): i64 {
        if (self == 0 || self.buf == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var d = self.n;
        var mu = self.buf;
        var cv = mu + d * 8;
        var l = cv + d * d * 8;
        var ld: f64 = self.log_det;
        var e = _pmn_dbg_open(sb, "MultivariateNormal", 1, alternate);
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item(sb, "mean", 1, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_vec_f64(sb, mu, d, alternate, 1); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item_end(sb, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item(sb, "covariance", 0, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_mat_f64(sb, cv, d, d, alternate, 1); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item_end(sb, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item(sb, "cholesky_l", 0, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_mat_f64(sb, l, d, d, alternate, 1); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item_end(sb, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item(sb, "log_det", 0, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_f64(sb, ld); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item_end(sb, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item(sb, "dim", 0, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_u64(sb, d); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item_end(sb, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_close(sb, 1, alternate); }
        return e;
    }

    # Appends serde_json's text of every field, the cached ones included, as 1.3.0 serializes them:
    # `{"mean":[..],"covariance":[[..],..],"cholesky_l":[[..],..],"log_det":..,"dim":d}`. PMN_ERR_NONE;
    # PMN_ERR_OUT_OF_MEMORY when sb can't grow; PMN_ERR_INVALID_PARAMETER for a dropped self.
    #must_use
    fn to_json(self, sb): i64 {
        if (self == 0 || self.buf == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var d = self.n;
        var mu = self.buf;
        var cv = mu + d * 8;
        var l = cv + d * d * 8;
        var ld: f64 = self.log_det;
        var e = _pmn_json_w_key(sb, "mean", 1);
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_vec_f64(sb, mu, d); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_key(sb, "covariance", 0); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_mat_f64(sb, cv, d, d); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_key(sb, "cholesky_l", 0); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_mat_f64(sb, l, d, d); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_key(sb, "log_det", 0); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_f64(sb, ld); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_key(sb, "dim", 0); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_u64(sb, d); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_lit(sb, "}"); }
        return e;
    }
}

# The decoder for PmnMultivariateNormal_from_json: MultivariateNormalRepr's two fields by serde's struct rules (the
# cached fields a document carries are unknown members, skipped), each read whole as its type (a Vec<f64>, a
# Vec<Vec<f64>>) before `MultivariateNormal::new` judges them, as serde's `try_from` does; any refusal is
# PMN_ERR_DESERIALIZE, a ragged covariance among them. The two arrays are copied to pool scratch for the constructor,
# which recomputes the factor.
fn _pmn_mvn_from_root(root, out): i64 {
    var names[16];
    store64(&names, "mean");
    store64(&names + 8, "covariance");
    var sl[16];
    var e = _pmn_json_struct(root, &names, 2, &sl);
    if (e != PMN_ERR_NONE) { return e; }
    var mv = load64(&sl);
    var cv = load64(&sl + 8);
    var d = _pmn_json_arr_len(mv);
    if (d < 0) { return PMN_ERR_DESERIALIZE; }
    var x[8];
    for (var i = 0; i < d; i = i + 1) {
        if (_pmn_json_f64(_pmn_json_arr_get(mv, i), &x) != PMN_ERR_NONE) { return PMN_ERR_DESERIALIZE; }
    }
    var sh[24];
    e = _pmn_json_mat_shape(cv, &sh);
    if (e != PMN_ERR_NONE) { return e; }
    var rows = load64(&sh);
    var cols = load64(&sh + 8);
    if (load64(&sh + 16) == 1) { return PMN_ERR_DESERIALIZE; }   # ragged: `new` refuses it (DimensionMismatch)
    var s, slot = _pmn_scratch_take((d + rows * cols + 1) * 8);
    if (s == 0) { return PMN_ERR_OUT_OF_MEMORY; }
    var c = s + d * 8;
    e = _pmn_json_vec_f64(mv, s, d);
    if (e == PMN_ERR_NONE) { e = _pmn_json_mat_f64(cv, c, rows, cols); }
    if (e == PMN_ERR_NONE) { e = PmnMultivariateNormal_new(out, s, d, c, rows, cols); }
    _pmn_scratch_give(s, slot);
    if (e == PMN_ERR_OUT_OF_MEMORY) { return e; }
    if (e != PMN_ERR_NONE) { return PMN_ERR_DESERIALIZE; }
    return PMN_ERR_NONE;
}

# Reads a MultivariateNormal document, buf[0, len), into out (caller storage, owning a new block: drop it):
# PMN_ERR_NONE, PMN_ERR_DESERIALIZE for any document serde_json refuses (one `MultivariateNormal::new` refuses
# included), or PMN_ERR_OUT_OF_MEMORY. The cached factor, log det and dim a document carries are ignored, as Rust
# ignores them: the factor is recomputed.
#must_use
fn PmnMultivariateNormal_from_json(out: *PmnMultivariateNormal, buf, len): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    return _pmn_json_decode(buf, len, &_pmn_mvn_from_root, out);
}
