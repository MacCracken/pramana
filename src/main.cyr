# pramana — Cyrius port
# Ported from 10424 lines of Rust

# Stdlib auto-included via cyrius.cyml

# Entry point of the scaffold build. pramana is a library: the modules arrive with M1 (port plan §7).
fn main() {
    alloc_init();
    println("pramana ready");
    return 0;
}

var r = main();
# sys_exit_group, not syscall(SYS_EXIT, ...): SYS_EXIT ends only the calling
# thread, so the bare syscall hangs once this program spawns its first worker.
sys_exit_group(r);
