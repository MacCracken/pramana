# dist_disc.cyr — the discrete distributions of Rust 1.3.0's src/distribution.rs (port plan §4.1, D5, D7, D11, D12;
# M3 parts a2, c1, c2): their constructors, the five `PmnDistribution` methods, serde_json's codec and the derived
# Debug, as src/dist_cont.cyr's. Bernoulli (part a2), Poisson (c1) and Binomial (c2).

include "src/dist.cyr"   # the trait, for `cyrius lint`'s compile of this file alone (see src/dist.cyr)

# ── Bernoulli (part a2) ─────────────────────────────────────────────────────────────────────────────

# Rust's `Bernoulli`: one trial with success probability `p`.
struct PmnBernoulli {
    p: f64;
}

# Rust's `Bernoulli::new(p)` into out (caller storage, D11): PMN_ERR_NONE, or PMN_ERR_INVALID_PARAMETER, writing
# nothing, unless 0 ≤ p ≤ 1 (so never for NaN); or for a null out.
#must_use
fn PmnBernoulli_new(out: *PmnBernoulli, p: f64): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    var e = _pmn_require_probability(p);
    if (e != PMN_ERR_NONE) { return e; }
    out.p = p;
    return PMN_ERR_NONE;
}

impl PmnDistribution for PmnBernoulli {
    # Rust's `pdf`, the mass: 1 − p within f64::EPSILON of 0, p within f64::EPSILON of 1, else 0.
    #must_use
    fn pdf(self, x: f64): f64 {
        var p: f64 = self.p;
        var eps: f64 = _PMN_F64_EPSILON;
        var ax: f64 = f64_abs(x);
        if (ax < eps) { return 1.0 - p; }
        var d: f64 = x - 1.0;
        var ad: f64 = f64_abs(d);
        if (ad < eps) { return p; }
        return 0.0;
    }

    # Rust's `cdf`: NaN at NaN, 0 below 0, 1 − p on [0, 1), 1 from 1.
    #must_use
    fn cdf(self, x: f64): f64 {
        if (x != x) {
            var nan: f64 = _PMN_F64_NAN;
            return nan;
        }
        if (x < 0.0) { return 0.0; }
        var p: f64 = self.p;
        if (x < 1.0) { return 1.0 - p; }
        return 1.0;
    }

    # Rust's `mean`: p.
    #must_use
    fn mean(self): f64 {
        var p: f64 = self.p;
        return p;
    }

    # Rust's `variance`: p·(1 − p).
    #must_use
    fn variance(self): f64 {
        var p: f64 = self.p;
        var q: f64 = 1.0 - p;
        return p * q;
    }

    # Rust's `sample`: 1 when a uniform is below p, else 0.
    #must_use
    fn sample<R: PmnRng>(self, rng: *R): f64 {
        var u: f64 = rng.next_f64();
        var p: f64 = self.p;
        if (u < p) { return 1.0; }
        return 0.0;
    }
}

impl PmnBernoulli {
    # Appends Rust's Debug (D12): `Bernoulli { p: 0.5 }`, or its alternate form. PMN_ERR_NONE, or
    # PMN_ERR_OUT_OF_MEMORY when sb can't grow.
    #must_use
    fn debug(self, sb, alternate): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var p: f64 = self.p;
        var e = _pmn_dbg_open(sb, "Bernoulli", 1, alternate);
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item(sb, "p", 1, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_f64(sb, p); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item_end(sb, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_close(sb, 1, alternate); }
        return e;
    }

    # Appends serde_json's text, `{"p":P}`: PMN_ERR_NONE, or PMN_ERR_OUT_OF_MEMORY when sb can't grow.
    #must_use
    fn to_json(self, sb): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var p: f64 = self.p;
        var e = _pmn_json_w_key(sb, "p", 1);
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_f64(sb, p); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_lit(sb, "}"); }
        return e;
    }
}

# The decoder for PmnBernoulli_from_json: BernoulliRepr's one f64 field, then `Bernoulli::new`.
fn _pmn_bernoulli_from_root(root, out): i64 {
    var names[8];
    store64(&names, "p");
    var v[8];
    var e = _pmn_dist_fields(root, &names, 1, &v);
    if (e != PMN_ERR_NONE) { return e; }
    var p: f64 = load64(&v);
    if (PmnBernoulli_new(out, p) != PMN_ERR_NONE) { return PMN_ERR_DESERIALIZE; }
    return PMN_ERR_NONE;
}

# Reads a Bernoulli document, buf[0, len), into out (caller storage): PMN_ERR_NONE, PMN_ERR_DESERIALIZE for any
# document serde_json refuses (a p outside [0, 1] among them), or PMN_ERR_OUT_OF_MEMORY.
#must_use
fn PmnBernoulli_from_json(out: *PmnBernoulli, buf, len): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    return _pmn_json_decode(buf, len, &_pmn_bernoulli_from_root, out);
}

# ── Poisson (part c1) ───────────────────────────────────────────────────────────────────────────────

# Rust's `POISSON_PTRS_THRESHOLD`: above this rate the sampler is PTRS, at and below it Knuth's multiplication.
var _PMN_POISSON_PTRS_THRESHOLD: f64 = 30.0;

# Rust's `sample_poisson_ptrs`: Hörmann's transformed rejection with squeeze (PTRS, 1993), valid for λ ≥ 10, in Rust's
# operation order on the correctly rounded ln and the kernel ln P(X = k) = ln_gamma_kernel(k + 1, λ) − ln λ. Two
# uniforms a try. λ is a constructor's, finite and above 30 (the oracle's hook takes λ ≥ 10).
#must_use
fn _pmn_sample_poisson_ptrs<R: PmnRng>(lambda: f64, rng: *R): f64 {
    var slam: f64 = f64_sqrt(lambda);
    var loglam: f64 = _pmn_ln(lambda);
    var b0: f64 = 2.53 * slam;
    var b: f64 = 0.931 + b0;
    var a0: f64 = 0.02483 * b;
    var a: f64 = -0.059 + a0;
    var b34: f64 = b - 3.4;
    var ia0: f64 = 1.1328 / b34;
    var inv_alpha: f64 = 1.1239 + ia0;
    var b2: f64 = b - 2.0;
    var vr0: f64 = 3.6224 / b2;
    var vr: f64 = 0.9277 - vr0;
    var lia: f64 = _pmn_ln(inv_alpha);
    while (1) {
        var du: f64 = rng.next_f64();
        var u: f64 = du - 0.5;
        var v: f64 = rng.next_f64();
        var au: f64 = f64_abs(u);
        var us: f64 = 0.5 - au;
        var a2: f64 = 2.0 * a;
        var q: f64 = a2 / us;
        q = q + b;
        q = q * u;
        q = q + lambda;
        q = q + 0.43;
        var k: f64 = f64_floor(q);
        if (us >= 0.07 && v <= vr) { return k; }
        var skip = 0;
        if (k < 0.0 || _pmn_is_finite(k) == 0) { skip = 1; }
        if (us < 0.013 && v > us) { skip = 1; }
        if (skip == 0) {
            var lv: f64 = _pmn_ln(v);
            var lhs: f64 = lv + lia;
            var uu: f64 = us * us;
            var t: f64 = a / uu;
            t = t + b;
            var lt: f64 = _pmn_ln(t);
            lhs = lhs - lt;
            var rhs: f64 = -lambda;
            if (k != 0.0) {
                var k1: f64 = k + 1.0;
                var kern: f64 = _pmn_ln_gamma_kernel(k1, lambda);
                rhs = kern - loglam;
            }
            if (lhs <= rhs) { return k; }
        }
    }
    return 0.0;
}

# Rust's `Poisson`: the Poisson distribution with rate `lambda`.
struct PmnPoisson {
    lambda: f64;
}

# Rust's `Poisson::new(lambda)` into out (caller storage, D11): PMN_ERR_NONE, or PMN_ERR_INVALID_PARAMETER, writing
# nothing, unless lambda is finite and positive; or for a null out.
#must_use
fn PmnPoisson_new(out: *PmnPoisson, lambda: f64): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    var e = _pmn_require_positive(lambda);
    if (e != PMN_ERR_NONE) { return e; }
    out.lambda = lambda;
    return PMN_ERR_NONE;
}

impl PmnDistribution for PmnPoisson {
    # Rust's `pdf`, the mass P(X = k) = λ^k e^-λ/k!: NaN at NaN; 0 below 0, off the integers (an exact comparison) and
    # at ∞; e^-λ at 0; else exp(ln_gamma_kernel(k + 1, λ) − ln λ), Loader's form, in O(1) and without cancellation.
    #must_use
    fn pdf(self, x: f64): f64 {
        if (x != x) {
            var nan: f64 = _PMN_F64_NAN;
            return nan;
        }
        var fr: f64 = _pmn_fract(x);
        if (x < 0.0 || fr != 0.0 || _pmn_is_finite(x) == 0) { return 0.0; }
        var l: f64 = self.lambda;
        var nl: f64 = -l;
        if (x == 0.0) {
            var e0: f64 = _pmn_exp(nl);
            return e0;
        }
        var x1: f64 = x + 1.0;
        var kern: f64 = _pmn_ln_gamma_kernel(x1, l);
        var ll: f64 = _pmn_ln(l);
        var s: f64 = kern - ll;
        var r: f64 = _pmn_exp(s);
        return r;
    }

    # Rust's `cdf`: P(X ≤ x) = Q(⌊x⌋ + 1, λ), the T1 regularized upper incomplete gamma; NaN at NaN, 0 below 0.
    #must_use
    fn cdf(self, x: f64): f64 {
        if (x != x) {
            var nan: f64 = _PMN_F64_NAN;
            return nan;
        }
        if (x < 0.0) { return 0.0; }
        var fl: f64 = f64_floor(x);
        var a: f64 = fl + 1.0;
        var l: f64 = self.lambda;
        var q: f64 = _pmn_regularized_upper_incomplete_gamma(a, l);
        return q;
    }

    # Rust's `mean`: λ.
    #must_use
    fn mean(self): f64 {
        var l: f64 = self.lambda;
        return l;
    }

    # Rust's `variance`: λ.
    #must_use
    fn variance(self): f64 {
        var l: f64 = self.lambda;
        return l;
    }

    # Rust's `sample`, exact: PTRS above λ = 30; at and below, Knuth's multiplication, the count of uniforms whose
    # running product stays above e^-λ.
    #must_use
    fn sample<R: PmnRng>(self, rng: *R): f64 {
        var l: f64 = self.lambda;
        var th: f64 = _PMN_POISSON_PTRS_THRESHOLD;
        if (l > th) {
            var pt: f64 = _pmn_sample_poisson_ptrs(l, rng);
            return pt;
        }
        var nl: f64 = -l;
        var lim: f64 = _pmn_exp(nl);
        var k = 0;
        var pr: f64 = 1.0;
        while (1) {
            k = k + 1;
            var u: f64 = rng.next_f64();
            pr = pr * u;
            if (pr <= lim) { break; }
        }
        var km: f64 = f64_from(k - 1);
        return km;
    }
}

impl PmnPoisson {
    # Appends Rust's Debug (D12): `Poisson { lambda: 3.5 }`, or its alternate form. PMN_ERR_NONE, or
    # PMN_ERR_OUT_OF_MEMORY when sb can't grow.
    #must_use
    fn debug(self, sb, alternate): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var l: f64 = self.lambda;
        var e = _pmn_dbg_open(sb, "Poisson", 1, alternate);
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item(sb, "lambda", 1, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_f64(sb, l); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item_end(sb, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_close(sb, 1, alternate); }
        return e;
    }

    # Appends serde_json's text, `{"lambda":L}`: PMN_ERR_NONE, or PMN_ERR_OUT_OF_MEMORY when sb can't grow.
    #must_use
    fn to_json(self, sb): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var l: f64 = self.lambda;
        var e = _pmn_json_w_key(sb, "lambda", 1);
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_f64(sb, l); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_lit(sb, "}"); }
        return e;
    }
}

# The decoder for PmnPoisson_from_json: PoissonRepr's one f64 field, then `Poisson::new`.
fn _pmn_poisson_from_root(root, out): i64 {
    var names[8];
    store64(&names, "lambda");
    var v[8];
    var e = _pmn_dist_fields(root, &names, 1, &v);
    if (e != PMN_ERR_NONE) { return e; }
    var l: f64 = load64(&v);
    if (PmnPoisson_new(out, l) != PMN_ERR_NONE) { return PMN_ERR_DESERIALIZE; }
    return PMN_ERR_NONE;
}

# Reads a Poisson document, buf[0, len), into out (caller storage): PMN_ERR_NONE, PMN_ERR_DESERIALIZE for any document
# serde_json refuses (a lambda the constructor refuses among them), or PMN_ERR_OUT_OF_MEMORY.
#must_use
fn PmnPoisson_from_json(out: *PmnPoisson, buf, len): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    return _pmn_json_decode(buf, len, &_pmn_poisson_from_root, out);
}

# ── Binomial (part c2) ──────────────────────────────────────────────────────────────────────────────

# Rust's `BINOMIAL_DIRECT_MAX_N`: up to this many trials a draw simulates them; above, Beta splitting halves them.
var _PMN_BINOMIAL_DIRECT_MAX_N = 64;

# Rust's `Binomial`: the number of successes in `n` independent trials of probability `p`. n is a u64, held as its
# 64-bit word: every comparison, halving and conversion of it is unsigned.
struct PmnBinomial {
    n;
    p: f64;
}

# Rust's `Binomial::new(n, p)` into out (caller storage, D11): PMN_ERR_NONE, or PMN_ERR_INVALID_PARAMETER, writing
# nothing, for n = 0 or unless 0 ≤ p ≤ 1; or for a null out.
#must_use
fn PmnBinomial_new(out: *PmnBinomial, n, p: f64): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    if (n == 0) { return PMN_ERR_INVALID_PARAMETER; }
    var e = _pmn_require_probability(p);
    if (e != PMN_ERR_NONE) { return e; }
    out.n = n;
    out.p = p;
    return PMN_ERR_NONE;
}

impl PmnDistribution for PmnBinomial {
    # Rust's `pdf`, the mass C(n, k)·p^k·(1 − p)^(n−k): NaN at NaN; 0 below 0, off the integers (an exact comparison)
    # and above n; the point masses at p = 0 and 1; (1 − p)^n and p^n at k = 0 and n; else Loader's saddle point,
    # exp(lc − ½·ln(2πk(n − k)/n)) with lc of Stirling's remainders and bd0's deviances, O(1) in n. On the correctly
    # rounded primitives and the remainder's T1 lnΓ below 10.
    #must_use
    fn pdf(self, x: f64): f64 {
        if (x != x) {
            var nan: f64 = _PMN_F64_NAN;
            return nan;
        }
        var nf: f64 = _pmn_u64_to_f64(self.n);
        var fr: f64 = _pmn_fract(x);
        if (x < 0.0 || fr != 0.0 || x > nf) { return 0.0; }
        var p: f64 = self.p;
        var q: f64 = 1.0 - p;
        if (p == 0.0) {
            if (x == 0.0) { return 1.0; }
            return 0.0;
        }
        if (p == 1.0) {
            if (x == nf) { return 1.0; }
            return 0.0;
        }
        if (x == 0.0) {
            var np: f64 = -p;
            var l1: f64 = _pmn_ln_1p(np);
            var t0: f64 = nf * l1;
            var r0: f64 = _pmn_exp(t0);
            return r0;
        }
        if (x == nf) {
            var lp: f64 = _pmn_ln(p);
            var tn: f64 = nf * lp;
            var rn: f64 = _pmn_exp(tn);
            return rn;
        }
        var nmx: f64 = nf - x;
        var s1: f64 = _pmn_stirling_error(nf);
        var s2: f64 = _pmn_stirling_error(x);
        var s3: f64 = _pmn_stirling_error(nmx);
        var npv: f64 = nf * p;
        var b1: f64 = _pmn_bd0(x, npv);
        var nq: f64 = nf * q;
        var b2: f64 = _pmn_bd0(nmx, nq);
        var lc: f64 = s1 - s2;
        lc = lc - s3;
        lc = lc - b1;
        lc = lc - b2;
        var ls: f64 = _PMN_MATH_LN_SQRT_2PI;
        var lf: f64 = 2.0 * ls;
        var lx: f64 = _pmn_ln(x);
        lf = lf + lx;
        var nx: f64 = -x;
        var xn: f64 = nx / nf;
        var l2: f64 = _pmn_ln_1p(xn);
        lf = lf + l2;
        var hl: f64 = 0.5 * lf;
        var sd: f64 = lc - hl;
        var r: f64 = _pmn_exp(sd);
        return r;
    }

    # Rust's `cdf`: P(X ≤ x) = I_(1−p)(n − k, k + 1), k = ⌊x⌋, by the T1 incomplete beta with both arguments exact (no
    # O(n) sum); NaN at NaN, 0 below 0, 1 from n, and the point masses' at p = 0 and 1.
    #must_use
    fn cdf(self, x: f64): f64 {
        if (x != x) {
            var nan: f64 = _PMN_F64_NAN;
            return nan;
        }
        if (x < 0.0) { return 0.0; }
        var nf: f64 = _pmn_u64_to_f64(self.n);
        if (x >= nf) { return 1.0; }
        var p: f64 = self.p;
        if (p == 0.0) { return 1.0; }
        if (p == 1.0) { return 0.0; }
        var k: f64 = f64_floor(x);
        var a: f64 = nf - k;
        var b: f64 = k + 1.0;
        var y: f64 = 1.0 - p;
        var i, c = _pmn_beta_inc(a, b, y, p);
        return i;
    }

    # Rust's `mean`: n·p.
    #must_use
    fn mean(self): f64 {
        var nf: f64 = _pmn_u64_to_f64(self.n);
        var p: f64 = self.p;
        return nf * p;
    }

    # Rust's `variance`: n·p·(1 − p), left to right.
    #must_use
    fn variance(self): f64 {
        var nf: f64 = _pmn_u64_to_f64(self.n);
        var p: f64 = self.p;
        var np: f64 = nf * p;
        var q: f64 = 1.0 - p;
        return np * q;
    }

    # Rust's `sample`, exact: above 64 trials, Knuth's Beta splitting (TAOCP 2, §3.4.1) halves them in O(log n). The
    # a-th smallest of the trials' uniforms, a = 1 + ⌊trials/2⌋, is Beta(a, trials − a + 1), drawn as a ratio of two
    # Marsaglia–Tsang variates; the successes lie below it or, all a of them counted, above it. Then the last trials
    # are simulated, a success when a uniform is below p.
    #must_use
    fn sample<R: PmnRng>(self, rng: *R): f64 {
        var trials = self.n;
        var p: f64 = self.p;
        var succ = 0;
        var mx = _PMN_BINOMIAL_DIRECT_MAX_N;
        while (_pmn_u64_lt(mx, trials) == 1) {
            if (p <= 0.0) {
                var r0: f64 = _pmn_u64_to_f64(succ);
                return r0;
            }
            if (p >= 1.0) {
                var st = succ + trials;
                var r1: f64 = _pmn_u64_to_f64(st);
                return r1;
            }
            var a = 1 + (trials >> 1);
            var b = trials - a + 1;
            var af: f64 = _pmn_u64_to_f64(a);
            var bf: f64 = _pmn_u64_to_f64(b);
            var ga: f64 = _pmn_sample_gamma_standard(af, rng);
            var gb: f64 = _pmn_sample_gamma_standard(bf, rng);
            var gs: f64 = ga + gb;
            var x: f64 = 0.5;
            if (gs > 0.0) { x = ga / gs; }
            if (x >= p) {
                trials = a - 1;
                var px: f64 = p / x;
                p = _pmn_clamp(px, 0.0, 1.0);
            } else {
                succ = succ + a;
                trials = b - 1;
                var pm: f64 = p - x;
                var om: f64 = 1.0 - x;
                var pr: f64 = pm / om;
                p = _pmn_clamp(pr, 0.0, 1.0);
            }
        }
        for (var i = 0; i < trials; i = i + 1) {
            var u: f64 = rng.next_f64();
            if (u < p) { succ = succ + 1; }
        }
        var r: f64 = _pmn_u64_to_f64(succ);
        return r;
    }
}

impl PmnBinomial {
    # Appends Rust's Debug (D12): `Binomial { n: 10, p: 0.3 }`, or its alternate form, n as its decimal. PMN_ERR_NONE,
    # or PMN_ERR_OUT_OF_MEMORY when sb can't grow.
    #must_use
    fn debug(self, sb, alternate): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var p: f64 = self.p;
        var e = _pmn_dbg_open(sb, "Binomial", 1, alternate);
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item(sb, "n", 1, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_u64(sb, self.n); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item_end(sb, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item(sb, "p", 0, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_f64(sb, p); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item_end(sb, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_close(sb, 1, alternate); }
        return e;
    }

    # Appends serde_json's text, `{"n":N,"p":P}`: PMN_ERR_NONE, or PMN_ERR_OUT_OF_MEMORY when sb can't grow.
    #must_use
    fn to_json(self, sb): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var p: f64 = self.p;
        var e = _pmn_json_w_key(sb, "n", 1);
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_u64(sb, self.n); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_key(sb, "p", 0); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_f64(sb, p); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_lit(sb, "}"); }
        return e;
    }
}

# The decoder for PmnBinomial_from_json: BinomialRepr's u64 and f64 fields by serde's rules, then `Binomial::new`.
fn _pmn_binomial_from_root(root, out): i64 {
    var names[16];
    store64(&names, "n");
    store64(&names + 8, "p");
    var sl[16];
    var e = _pmn_json_struct(root, &names, 2, &sl);
    if (e != PMN_ERR_NONE) { return e; }
    var nw = 0;
    e = _pmn_json_u64(load64(&sl), &nw);
    if (e != PMN_ERR_NONE) { return e; }
    var v[8];
    e = _pmn_json_f64(load64(&sl + 8), &v);
    if (e != PMN_ERR_NONE) { return e; }
    var p: f64 = load64(&v);
    if (PmnBinomial_new(out, nw, p) != PMN_ERR_NONE) { return PMN_ERR_DESERIALIZE; }
    return PMN_ERR_NONE;
}

# Reads a Binomial document, buf[0, len), into out (caller storage): PMN_ERR_NONE, PMN_ERR_DESERIALIZE for any document
# serde_json refuses (n = 0 or a p outside [0, 1] among them), or PMN_ERR_OUT_OF_MEMORY.
#must_use
fn PmnBinomial_from_json(out: *PmnBinomial, buf, len): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    return _pmn_json_decode(buf, len, &_pmn_binomial_from_root, out);
}
