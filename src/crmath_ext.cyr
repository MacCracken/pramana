# crmath_ext.cyr — pramana's own correctly rounded primitives, on the cores vendored in src/crmath.cyr (port plan D2,
# §8.1; ADR 009). No sibling has a public log1p, tan or log2, so M1 parts b2–b4 write them with kimiya's method:
# Ziv's two phases, a fast path with a proven error bound and a rounding test, then a triple-double accurate path
# rounded once (kimiya src/mathx.cyr's header gives the argument, and src/crmath.cyr carries its ln analysis).
# Each function has the entry points kimiya's do: `_pmn_cr_<f>(x)`, `_pmn_cr_<f>_fast(x)` → (result, 1) or (0, 0)
# when its rounding test fails, and `_pmn_cr_<f>_acc(x)`, the whole function by the accurate path alone.
# scripts/crverify/ checks all three against MPFR.
# UPSTREAM(L1): ganita:docs/development/issues/2026-11-09-correctly-rounded-exp-sin-cos-hypot.md
#   replace with ganita's correctly rounded log1p, tan and log2 once it has them; parity: every class C row at 0 ulp

# ── log1p (M1 part b2) ────────────────────────────────────────────────────────────────────────────
#
# log1p(x) = ln(1 + x) for x > −1, with no rounding of 1 + x:
# - |x| < 2^-60: log1p(x) = x − x²/2 + …, and x²/2 < 2^-61·|x| is below half an ulp of x on either side (also when
#   |x| is a power of 2), so RN(log1p(x)) = x. That keeps ±0 and the subnormals exact.
# - |x| < 2^-10: x is ln's reduced argument itself. kimiya's ln core on its interval 256 (c = 1, L = 0, E = 0)
#   evaluates log1p(r) for the exact r = m − 1 with |r| < 2^-10; here r = x, and the arithmetic is that core's term
#   for term, so its bound holds as it is: err = 2^-49·|p| + 2^-83·|hi|, relative to r.
# - otherwise: 1 + x = s + t exactly (TwoSum). s ≥ 2^-53 is a normal double (x > −1 is a double, so 1 + x ≥ 2^-53),
#   never 1 (|x| ≥ 2^-10), and never overflows (1 + DBL_MAX rounds to DBL_MAX). |t| ≤ ulp(s)/2, so τ = t/s has
#   |τ| ≤ 2^-53, and log1p(x) = ln s + log1p(τ) = ln s + τ − τ²/2 + …. The fast path adds RN(τ) to ln's fast core
#   at s, and widens its bound by |τ|·2^-50 + 2^-105: τ's own rounding (2^-53·|τ|), the dropped τ²/2 − … (below
#   2^-107) and the extra rounding of lo + τ. Here |log1p(x)| ≥ ln(1 + 2^-10) > 2^-10.01, so those are below 2^-94
#   of the result, against the core's 2^-77.
# - the accurate path: the same split in triple-double. On |x| < 2^-10, log1p(x) by Horner on the exact x to x^16/16
#   (ln's accurate series: truncation below 2^-160 of x). Otherwise ln s by ln's accurate path (below 2^-135 by its
#   operation count, measured 2^-150), plus τ as a double-double minus τ²/2 (dropped: τ³/3 < 2^-159, under 2^-149 of
#   the result). Rounded once by _pmn_km_rn3.
# Why that is correctly rounded: the fast path returns only when both ends of its bound round alike, and the
# accurate path's error (below 2^-135) is past the hardest case expected for 2^64 arguments, about 2^-(53 + 64), as
# kimiya argues for its expm1 and log10, for which no worst-case table exists either. log1p is exact only at x = 0
# (log1p(x) rational means 1 + x = e^q), so there are no ties.
# Special values: log1p(NaN) = NaN, log1p(+∞) = +∞, log1p(−1) = −∞, NaN for x < −1 (−∞ included).

# The special values, and |x| < 2^-60: (result, 1), or (0, 0) for a finite x > −1 with |x| ≥ 2^-60.
#must_use
fn _pmn_log1p_special(x: f64): (f64, i64) {
    if (x != x) { return (x, 1); }
    if (x == _PMN_KM_INF) { return (x, 1); }
    var m1: f64 = -1.0;
    if (x < m1) {
        var nan: f64 = _pmn_km_nan();               # the same quiet NaN on every target
        return (nan, 1);
    }
    if (x == m1) {
        var ninf: f64 = m1 / 0.0;
        return (ninf, 1);
    }
    var ax: f64 = f64_abs(x);
    var k60: f64 = 0x3C30000000000000;              # 2^-60
    if (ax < k60) { return (x, 1); }
    return (0.0, 0);
}

# log1p(r) for an exact r with 2^-60 ≤ |r| < 2^-10: kimiya's ln core on interval 256 (E = 0, L = 0), r given.
# (hi, lo, err) with |hi + lo − log1p(r)| < err minus the test's own rounding.
#must_use
fn _pmn_log1p_small_core(r: f64): (f64, f64, f64) {
    var cc: f64 = r * 134217729.0;
    var ra: f64 = cc - (cc - r);
    var rb: f64 = r - ra;
    var t1: f64 = -0.5 * (ra * ra);                 # −ra²/2, exact
    var nrb: f64 = -rb;
    var t2: f64 = nrb * (ra + (0.5 * rb));
    var c3: f64 = _PMN_KM_CR_LN_C3;
    var c4: f64 = _PMN_KM_CR_LN_C4;
    var c5: f64 = _PMN_KM_CR_LN_C5;
    var c6: f64 = _PMN_KM_CR_LN_C6;
    var c7: f64 = _PMN_KM_CR_LN_C7;
    var c8: f64 = _PMN_KM_CR_LN_C8;
    var z: f64 = r * r;
    var pz: f64 = ((c3 + (r * c4)) + (z * (c5 + (r * c6)))) + ((z * z) * (c7 + (r * c8)));   # Estrin
    var p: f64 = (z * r) * pz;
    var s2: f64 = r + t1;
    var d2: f64 = t1 - (s2 - r);                    # Fast2Sum: |t1| < |r|
    var lo: f64 = (t2 + p) + d2;
    var ap: f64 = f64_abs(p);
    var ah: f64 = f64_abs(s2);
    var k49: f64 = 0x3CE0000000000000;              # 2^-49
    var k83: f64 = 0x3AC0000000000000;              # 2^-83
    var err: f64 = (ap * k49) + (ah * k83);
    return (s2, lo, err);
}

# log1p(x) by the fast path: (RN(log1p(x)), 1), or (0, 0) when the rounding test fails.
#must_use
fn _pmn_cr_log1p_fast(x: f64): (f64, i64) {
    var sv, sp = _pmn_log1p_special(x);
    if (sp == 1) { return (sv, 1); }
    var ax: f64 = f64_abs(x);
    var k10: f64 = 0x3F50000000000000;              # 2^-10
    if (ax < k10) {
        var h, l, e = _pmn_log1p_small_core(x);
        var u: f64 = h + (l - e);
        var v: f64 = h + (l + e);
        if (u == v) { return (u, 1); }
        return (0.0, 0);
    }
    var s, t = _pmn_km_two_sum(1.0, x);
    var tau: f64 = t / s;
    var hi, lo, err = _pmn_km_ln_core(load64(&s), 0);
    var lo2: f64 = lo + tau;
    var at: f64 = f64_abs(tau);
    var k50: f64 = 0x3CD0000000000000;              # 2^-50
    var k105: f64 = 0x3960000000000000;             # 2^-105
    var err2: f64 = (err + (at * k50)) + k105;
    var u2: f64 = hi + (lo2 - err2);
    var v2: f64 = hi + (lo2 + err2);
    if (u2 == v2) { return (u2, 1); }
    return (0.0, 0);
}

# log1p(r) for an exact r with |r| < 2^-9, as a triple-double at out[0..2]: ln's accurate series (Horner on
# _PMN_KM_CR_LN_ACC to r^16/16, truncation below 2^-144·|r|).
fn _pmn_log1p_td(r: f64, out) {
    var sh: f64 = load64(&_PMN_KM_CR_LN_ACC + 336);   # −1/16 (index 3·(16 − 2))
    var sm: f64 = load64(&_PMN_KM_CR_LN_ACC + 344);
    var sl: f64 = load64(&_PMN_KM_CR_LN_ACC + 352);
    var n = 15;
    while (n >= 2) {
        var th, tm, tl = _pmn_km_td_mul_d(sh, sm, sl, r);
        var off = (n - 2) * 24;
        var ch: f64 = load64(&_PMN_KM_CR_LN_ACC + off);
        var cm: f64 = load64(&_PMN_KM_CR_LN_ACC + off + 8);
        var cl: f64 = load64(&_PMN_KM_CR_LN_ACC + off + 16);
        var uh, um, ul = _pmn_km_td_add(ch, cm, cl, th, tm, tl);
        sh = uh;
        sm = um;
        sl = ul;
        n = n - 1;
    }
    var vh, vm, vl = _pmn_km_td_mul_d(sh, sm, sl, r);
    var wh, wm, wl = _pmn_km_td_add_d(vh, vm, vl, 1.0);
    var ph, pm, pl = _pmn_km_td_mul_d(wh, wm, wl, r);
    store64(out, ph);
    store64(out + 8, pm);
    store64(out + 16, pl);
}

# log1p(x), correctly rounded, by the accurate path alone (also the fast path's fallback).
#must_use
fn _pmn_cr_log1p_acc(x: f64): f64 {
    var sv, sp = _pmn_log1p_special(x);
    if (sp == 1) { return sv; }
    var buf: f64[3];
    var ax: f64 = f64_abs(x);
    var k10: f64 = 0x3F50000000000000;              # 2^-10
    if (ax < k10) {
        _pmn_log1p_td(x, &buf);
        var r0: f64 = _pmn_km_rn3(buf[0], buf[1], buf[2]);
        return r0;
    }
    var s, t = _pmn_km_two_sum(1.0, x);
    _pmn_km_ln_acc_td(s, &buf);
    # τ = t/s as a double-double: t − τh·s is exact (Sterbenz: τh·s rounds to within a factor 2 of t), and so is
    # the product's error pe (TwoProduct). Dekker's split overflows past 2^996, so a large s and its t are first
    # scaled by 2^-512, which leaves τ as it is (t is then about 1, far from underflow).
    var th: f64 = t / s;
    var ss: f64 = s;
    var ts: f64 = t;
    var k512: f64 = 0x5FF0000000000000;            # 2^512
    if (s > k512) {
        var d512: f64 = 0x1FF0000000000000;        # 2^-512
        ss = s * d512;
        ts = t * d512;
    }
    var p, pe = _pmn_km_two_prod(th, ss);
    var d: f64 = (ts - p) - pe;
    var tl: f64 = d / ss;
    var hh: f64 = 0.5 * th;
    var q: f64 = hh * th;                           # τ²/2
    var e1: f64 = tl - q;
    var zh, zm, zl = _pmn_km_td_add(buf[0], buf[1], buf[2], th, e1, 0.0);
    var r1: f64 = _pmn_km_rn3(zh, zm, zl);
    return r1;
}

# log1p(x), correctly rounded. log1p(±0) = ±0, log1p(−1) = −∞, log1p(+∞) = +∞, NaN for NaN and x < −1.
#must_use
fn _pmn_cr_log1p(x: f64): f64 {
    var r, ok = _pmn_cr_log1p_fast(x);
    if (ok == 1) { return r; }
    var a: f64 = _pmn_cr_log1p_acc(x);
    return a;
}

# ── tan (M1 part b3) ──────────────────────────────────────────────────────────────────────────────
#
# tan x = sgn(x)·tan|x|, and tan|x| = sin|x| / cos|x| on kimiya's sin and cos: |x| = k·π/2 + r with |r| ≤ π/4 + 2^-30,
# so sin|x| and cos|x| are its ±sin r and ±cos r for quadrants k and k + 1 (kimiya's src/crmath.cyr analysis).
# - |x| < 2^-27: tan x rounds to x (0 < |tan x| − |x| < |x|³/3·(1 + x²) < 2^-54·|x|, below the distance from x to the
#   midpoint above it; subnormals and ±0 included). tan is transcendental at every algebraic x ≠ 0, so nothing
#   else is exact or a tie. NaN gives that NaN, ±∞ the quiet NaN. No double is within 2^-61 of a multiple of π/2
#   (Lefèvre and Muller), so |cos x| > 2^-62 and |tan x| < 2^63: never infinite.
# - Fast path: one reduction (Cody–Waite below 2^20, Payne–Hanek above, as kimiya's sin), then kimiya's fast
#   evaluation twice, S = sh + sl for sin|x| and C = ch + cl for cos|x|, each with its absolute bound (es, ec), and
#   each renormalised by an exact Fast2Sum (the evaluation's hi is only a partial sum). Then T = S/C as a
#   double-double: qh = RN(sh/ch), and ql from the exact remainder sh − qh·ch (TwoProduct, Sterbenz)
#   corrected by sl and qh·cl, over ch. The bound: |S/C − s/c| ≤ (es + |s/c|·ec)/|C|, with |C| ≥ |ch| − |cl| − ec
#   and |s/c| ≤ |qh|·(1 + 2^-50), widened by 2^-40; the double-double division adds below 2^-102·|q| (the remainder's
#   three roundings, ql's own, and the dropped ql·cl/ch), taken as 2^-98·|qh|. Relative to tan, the bound is about
#   2^-66 when r is not small. Near a multiple of π/2 the reduction's absolute error (2^-119·|k|) is large against
#   the small one of sin r or cos r, the test fails, and the accurate path takes it.
# - Accurate path: kimiya's accurate reduction and evaluation give sin|x| and cos|x| together in triple-double
#   (below 2^-148 relative when |r| ≥ 2^-10, 2^-138 at worst, from the reduction), divided in triple-double (below
#   2^-151) and rounded once: below 2^-137 relative, 20 bits past the hardest case expected over 2^64 arguments,
#   about 2^-(53 + 64), as kimiya argues for sin and cos outside Lefèvre and Muller's tables.

# The special values, and |x| < 2^-27: (result, 1), or (0, 0) for a finite |x| ≥ 2^-27.
#must_use
fn _pmn_tan_special(x: f64): (f64, i64) {
    var ax = load64(&x) & 0x7FFFFFFFFFFFFFFF;
    if (ax < 0x3E40000000000000) { return (x, 1); }    # |x| < 2^-27
    if (ax >= 0x7FF0000000000000) {
        if (ax > 0x7FF0000000000000) { return (x, 1); }
        var nan: f64 = _pmn_km_nan();                   # the same quiet NaN on every target
        return (nan, 1);
    }
    return (0.0, 0);
}

# tan(x) by the fast path: (RN(tan x), 1), or (0, 0) when the rounding test fails.
#must_use
fn _pmn_cr_tan_fast(x: f64): (f64, i64) {
    var sv, sp = _pmn_tan_special(x);
    if (sp == 1) { return (sv, 1); }
    var ux = load64(&x);
    var ax = ux & 0x7FFFFFFFFFFFFFFF;
    var k = 0;
    var rh: f64 = 0.0;
    var rl: f64 = 0.0;
    var dr: f64 = 0.0;
    if (ax >= 0x4130000000000000) {                     # |x| ≥ 2^20: Payne–Hanek, whose r is good to 2^-233
        var rb: f64[3];
        k = _pmn_km_ph_reduce(ax, &rb);
        rh = rb[0];
        rl = rb[1];
    } else {                                            # kimiya's Cody–Waite reduction, as _pmn_km_cr_sin's
        var a: f64 = ax;
        var inv: f64 = _PMN_KM_CR_SC_INVPIO2;
        var p1: f64 = _PMN_KM_CR_SC_P1;
        var p2: f64 = _PMN_KM_CR_SC_P2;
        var p3: f64 = _PMN_KM_CR_SC_P3;
        var tt: f64 = (a * inv) + 6755399441055744.0;
        var kd: f64 = tt - 6755399441055744.0;
        k = load64(&tt) - 0x4338000000000000;
        var d1: f64 = a - (kd * p1);
        var q2: f64 = kd * p2;
        var nq2: f64 = -q2;
        var s: f64 = d1 + nq2;
        var bb: f64 = s - d1;
        var e: f64 = (d1 - (s - bb)) + (nq2 - bb);
        var w: f64 = e - (kd * p3);
        rh = s + w;
        rl = w - (rh - s);
        var k119: f64 = 0x3880000000000000;             # 2^-119
        dr = kd * k119;
    }
    var sh0, sl0, es = _pmn_km_sc_eval(k & 3, rh, rl, dr);
    var ch0, cl0, ec = _pmn_km_sc_eval((k + 1) & 3, rh, rl, dr);
    # The evaluation's hi is a partial sum (lo carries up to 2^-27 of the value), so renormalise both, exactly,
    # before dividing: the division's bound needs |cl| ≤ 2^-53·|ch|.
    var sh, sl = _pmn_km_fast_two_sum(sh0, sl0);
    var ch, cl = _pmn_km_fast_two_sum(ch0, cl0);
    var qh: f64 = sh / ch;
    var p, pe = _pmn_km_two_prod(qh, ch);
    var rem: f64 = (((sh - p) - pe) + sl) - (qh * cl);
    var ql: f64 = rem / ch;
    var ach: f64 = f64_abs(ch);
    var acl: f64 = f64_abs(cl);
    var den: f64 = ach - (acl + ec);
    if (den <= 0.0) { return (0.0, 0); }
    var aq: f64 = f64_abs(qh);
    var num: f64 = es + (aq * ec);
    var e1: f64 = num / den;
    var w40: f64 = 0x3FF0000000001000;                  # 1 + 2^-40
    var k98: f64 = 0x39D0000000000000;                  # 2^-98
    var err: f64 = (e1 * w40) + (aq * k98);
    var u: f64 = qh + (ql - err);
    var v: f64 = qh + (ql + err);
    if (u != v) { return (0.0, 0); }
    if (ux < 0) { u = -u; }
    return (u, 1);
}

# tan(x), correctly rounded, by the accurate path alone (also the fast path's fallback).
#must_use
fn _pmn_cr_tan_acc(x: f64): f64 {
    var sv, sp = _pmn_tan_special(x);
    if (sp == 1) { return sv; }
    var ux = load64(&x);
    var ax = ux & 0x7FFFFFFFFFFFFFFF;
    var rb: f64[3];
    var k = _pmn_km_sc_reduce_acc(ax, &rb);
    var ob: f64[6];
    _pmn_km_sc_acc_td(k & 3, rb[0], rb[1], rb[2], 1, &ob);   # sin|x| at ob[0..2], cos|x| at ob[3..5]
    var qb: f64[3];
    _pmn_km_td_div(ob[0], ob[1], ob[2], ob[3], ob[4], ob[5], &qb);
    var r: f64 = _pmn_km_rn3(qb[0], qb[1], qb[2]);
    if (ux < 0) { r = -r; }
    return r;
}

# tan(x), correctly rounded. tan(±0) = ±0 (as every |x| < 2^-27: x), NaN for NaN and ±∞. Mirrors `f64::tan`.
#must_use
fn _pmn_cr_tan(x: f64): f64 {
    var r, ok = _pmn_cr_tan_fast(x);
    if (ok == 1) { return r; }
    var a: f64 = _pmn_cr_tan_acc(x);
    return a;
}

# ── log2 (M1 part b4) ─────────────────────────────────────────────────────────────────────────────
#
# log2 x = E + ln(m)/ln 2 on kimiya's ln, with E an exact integer: x = 2^E·m with m in [0.7495, 1.499) (ln's
# reduction, bits(x) − 0x3FE7FC0000000000; a subnormal is first scaled by 2^54). |ln m| ≤ 0.405 < ln 2, so
# |log2 m| < 0.585 and E + log2 m never cancels by more than 1.3 bits.
# - log2 x is rational only at x = 2^E (log2 x = p/q means x^q = 2^p), so the powers of two give E exactly and are
#   the only exact cases; there are no ties. log2(1) = +0.
# - Fast path: ln's fast core at m (E = 0 there, so its hi + lo is ln m = L_j + log1p(r), with its bound eln), times
#   1/ln 2 = IH + IM (Dekker's product for hi·IH, rounded hi·IM and lo·IH), then E + that by Fast2Sum (|E| ≥ 1 >
#   |log2 m| when E ≠ 0). The bound: 1.4427·eln plus the product's roundings and IL (below 2^-104·|ph|), plus the
#   rounding of the low word and the test's own (below 2^-104·|hi|): err = 1.5·eln + 2^-100·|ph| + 2^-103·|hi|.
#   Relative to ln m near m = 1 (ln's core is relative to r there) and below 2^-75 elsewhere.
# - Accurate path: ln's triple-double path at m (E = 0: L_j + log1p(r), below 2^-135 by its operation count, measured
#   2^-150), times 1/ln 2 as a triple-double (below 2^-153), plus E (exact: the renormalising TwoSums keep the sum),
#   rounded once: below 2^-135, past the hardest case expected over 2^64 arguments (about 2^-(53 + 64)) and past
#   ln's tabulated 2^-118, the argument kimiya makes for its expm1 and log10 and part b2 for log1p.
# Special values, as ln's: log2(NaN) = NaN, log2(±0) = −∞, log2(+∞) = +∞, NaN for x < 0 (−∞ included).

var _PMN_CR_INVLN2_H: f64 = 0x3FF71547652B82FE;   # 1/ln 2 = H + M + L; scripts/crverify/consts.py checks them
var _PMN_CR_INVLN2_M: f64 = 0x3C7777D0FFDA0D24;
var _PMN_CR_INVLN2_L: f64 = 0xB9160BB8A5442AB9;

# x = 2^E·m for a positive finite x: (E, bits(m)), m in [0.7495, 1.499).
#must_use
fn _pmn_log2_split(x: f64): (i64, i64) {
    var ui = load64(&x);
    var eb = 0;
    if (ui < 0x0010000000000000) {                      # subnormal: scaled exactly by 2^54
        var p54: f64 = 0x4350000000000000;
        var xs: f64 = x * p54;
        ui = load64(&xs);
        eb = 0 - 54;
    }
    var t = ui - 0x3FE7FC0000000000;
    var e0 = t >>> 52;
    var mb = ui - (e0 << 52);
    return (e0 + eb, mb);
}

# log2(x) by the fast path: (RN(log2 x), 1), or (0, 0) when the rounding test fails.
#must_use
fn _pmn_cr_log2_fast(x: f64): (f64, i64) {
    var sv, sp = _pmn_km_ln_special(x);
    if (sp == 1) { return (sv, 1); }
    var e, mb = _pmn_log2_split(x);
    var ef: f64 = f64_from(e);
    if (mb == 0x3FF0000000000000) { return (ef, 1); }   # x = 2^E: exactly E
    var fh, fl, eln = _pmn_km_ln_core(mb, 0);
    var ih: f64 = _PMN_CR_INVLN2_H;
    var im: f64 = _PMN_CR_INVLN2_M;
    var ph, pe = _pmn_km_two_prod(fh, ih);
    var pl: f64 = pe + ((fh * im) + (fl * ih));
    var hi: f64 = ph;
    var lo: f64 = pl;
    if (e != 0) {
        var sh, st = _pmn_km_fast_two_sum(ef, ph);
        hi = sh;
        lo = st + pl;
    }
    var ap: f64 = f64_abs(ph);
    var ah: f64 = f64_abs(hi);
    var k100: f64 = 0x39B0000000000000;                 # 2^-100
    var k103: f64 = 0x3980000000000000;                 # 2^-103
    var err: f64 = ((eln * 1.5) + (ap * k100)) + (ah * k103);
    var u: f64 = hi + (lo - err);
    var v: f64 = hi + (lo + err);
    if (u == v) { return (u, 1); }
    return (0.0, 0);
}

# log2(x), correctly rounded, by the accurate path alone (also the fast path's fallback).
#must_use
fn _pmn_cr_log2_acc(x: f64): f64 {
    var sv, sp = _pmn_km_ln_special(x);
    if (sp == 1) { return sv; }
    var e, mb = _pmn_log2_split(x);
    var ef: f64 = f64_from(e);
    if (mb == 0x3FF0000000000000) { return ef; }       # x = 2^E: exactly E
    var m: f64 = 0.0;
    store64(&m, mb);
    var buf: f64[3];
    _pmn_km_ln_acc_td(m, &buf);                         # ln m = L_j + log1p(r): E = 0 at m
    var yh, ym, yl = _pmn_km_td_mul(buf[0], buf[1], buf[2], _PMN_CR_INVLN2_H, _PMN_CR_INVLN2_M, _PMN_CR_INVLN2_L);
    if (e != 0) {
        var zh, zm, zl = _pmn_km_td_add_d(yh, ym, yl, ef);
        yh = zh;
        ym = zm;
        yl = zl;
    }
    var r: f64 = _pmn_km_rn3(yh, ym, yl);
    return r;
}

# log2(x), correctly rounded. log2(2^k) = k, log2(±0) = −∞, log2(+∞) = +∞, NaN for NaN and x < 0. Mirrors `f64::log2`.
#must_use
fn _pmn_cr_log2(x: f64): f64 {
    var r, ok = _pmn_cr_log2_fast(x);
    if (ok == 1) { return r; }
    var a: f64 = _pmn_cr_log2_acc(x);
    return a;
}
