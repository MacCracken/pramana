fn _pmn_log2(x: f64): f64 {
    var r: f64 = _pmn_cr_log2(x);
    return r;
}

# The cube root, ganita's, which is correctly rounded as Rust's (compiler_builtins) is. Mirrors `f64::cbrt`.
#must_use
#pure
fn _pmn_cbrt(x: f64): f64 {
    var r: f64 = ganita_f64_cbrt(x);
    return r;
}
