# arctan x, as the correctly rounded atan2(x, 1): the same value. Mirrors `f64::atan`.
#must_use
#pure
fn _pmn_atan(x: f64): f64 {
    var r: f64 = _pmn_km_cr_atan2(x, 1.0);
    return r;
}

