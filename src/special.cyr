# Each polynomial is Rust's nested Horner form `c0 + s * (c1 + s * (…))`, evaluated innermost first, one rounding per
# + and ×, as Rust's (no contraction to fma on either side).

# Rust's `high_word`: the upper 32 bits of x's pattern.
#must_use
#pure
fn _pmn_sp_high_word(x: f64): i64 {
    return (load64(&x) >> 32) & 0xFFFFFFFF;
}

# fdlibm's erf/erfc kernel on |x| < 0.84375: r / s for z = x², the PP and QQ rationals.
#must_use
fn _pmn_sp_erf_small(z: f64): f64 {
    var r: f64 = _PMN_MATH_FDLIBM_PP4;
    r = _PMN_MATH_FDLIBM_PP3 + z * r;
    r = _PMN_MATH_FDLIBM_PP2 + z * r;
    r = _PMN_MATH_FDLIBM_PP1 + z * r;
    r = _PMN_MATH_FDLIBM_PP0 + z * r;
    var s: f64 = _PMN_MATH_FDLIBM_QQ5;
    s = _PMN_MATH_FDLIBM_QQ4 + z * s;
    s = _PMN_MATH_FDLIBM_QQ3 + z * s;
    s = _PMN_MATH_FDLIBM_QQ2 + z * s;
    s = _PMN_MATH_FDLIBM_QQ1 + z * s;
    s = 1.0 + z * s;
    return r / s;
}

# Rust's `erfc_mid`: erfc(|x|) for 0.84375 ≤ |x| < 1.25, 1 − erx − P/Q at s = |x| − 1.
#must_use
fn _pmn_sp_erfc_mid(x: f64): f64 {
    var ax: f64 = f64_abs(x);
    var s: f64 = ax - 1.0;
    var p: f64 = _PMN_MATH_FDLIBM_PA6;
    p = _PMN_MATH_FDLIBM_PA5 + s * p;
    p = _PMN_MATH_FDLIBM_PA4 + s * p;
    p = _PMN_MATH_FDLIBM_PA3 + s * p;
    p = _PMN_MATH_FDLIBM_PA2 + s * p;
    p = _PMN_MATH_FDLIBM_PA1 + s * p;
    p = _PMN_MATH_FDLIBM_PA0 + s * p;
    var q: f64 = _PMN_MATH_FDLIBM_QA6;
    q = _PMN_MATH_FDLIBM_QA5 + s * q;
    q = _PMN_MATH_FDLIBM_QA4 + s * q;
    q = _PMN_MATH_FDLIBM_QA3 + s * q;
    q = _PMN_MATH_FDLIBM_QA2 + s * q;
    q = _PMN_MATH_FDLIBM_QA1 + s * q;
    q = 1.0 + s * q;
    var erx: f64 = _PMN_MATH_FDLIBM_ERX;
    var a: f64 = 1.0 - erx;
    var pq: f64 = p / q;
    return a - pq;
}

# Rust's `erfc_tail`: erfc(|x|) for 0.84375 ≤ |x| < 28, given ix, the high word of |x|. Above 1.25 it is
# exp(−z² − 0.5625) · exp((z − x)(z + x) + R/S) / x, with z = x's upper 32 bits so −z·z is exact.
#must_use
fn _pmn_sp_erfc_tail(ix, x0: f64): f64 {
    if (ix < 0x3FF40000) { return _pmn_sp_erfc_mid(x0); }
    var x: f64 = f64_abs(x0);
    var xx: f64 = x * x;
    var s: f64 = 1.0 / xx;
    var r: f64 = 0.0;
    var bs: f64 = 0.0;
    if (ix < 0x4006DB6D) {
        r = _PMN_MATH_FDLIBM_RA7;
        r = _PMN_MATH_FDLIBM_RA6 + s * r;
        r = _PMN_MATH_FDLIBM_RA5 + s * r;
        r = _PMN_MATH_FDLIBM_RA4 + s * r;
        r = _PMN_MATH_FDLIBM_RA3 + s * r;
        r = _PMN_MATH_FDLIBM_RA2 + s * r;
        r = _PMN_MATH_FDLIBM_RA1 + s * r;
        r = _PMN_MATH_FDLIBM_RA0 + s * r;
        bs = _PMN_MATH_FDLIBM_SA8;
        bs = _PMN_MATH_FDLIBM_SA7 + s * bs;
        bs = _PMN_MATH_FDLIBM_SA6 + s * bs;
        bs = _PMN_MATH_FDLIBM_SA5 + s * bs;
        bs = _PMN_MATH_FDLIBM_SA4 + s * bs;
        bs = _PMN_MATH_FDLIBM_SA3 + s * bs;
        bs = _PMN_MATH_FDLIBM_SA2 + s * bs;
        bs = _PMN_MATH_FDLIBM_SA1 + s * bs;
        bs = 1.0 + s * bs;
    } else {
        r = _PMN_MATH_FDLIBM_RB6;
        r = _PMN_MATH_FDLIBM_RB5 + s * r;
        r = _PMN_MATH_FDLIBM_RB4 + s * r;
        r = _PMN_MATH_FDLIBM_RB3 + s * r;
        r = _PMN_MATH_FDLIBM_RB2 + s * r;
        r = _PMN_MATH_FDLIBM_RB1 + s * r;
        r = _PMN_MATH_FDLIBM_RB0 + s * r;
        bs = _PMN_MATH_FDLIBM_SB7;
        bs = _PMN_MATH_FDLIBM_SB6 + s * bs;
        bs = _PMN_MATH_FDLIBM_SB5 + s * bs;
        bs = _PMN_MATH_FDLIBM_SB4 + s * bs;
        bs = _PMN_MATH_FDLIBM_SB3 + s * bs;
        bs = _PMN_MATH_FDLIBM_SB2 + s * bs;
        bs = _PMN_MATH_FDLIBM_SB1 + s * bs;
        bs = 1.0 + s * bs;
    }
    var zb = load64(&x) & 0xFFFFFFFF00000000;
    var z: f64 = 0.0;
    store64(&z, zb);
    var nz: f64 = -z;
    var a1: f64 = nz * z;
    var a2: f64 = a1 - 0.5625;
    var e1: f64 = _pmn_exp(a2);
    var zmx: f64 = z - x;
    var zpx: f64 = z + x;
    var b1: f64 = zmx * zpx;
    var rs: f64 = r / bs;
    var b2: f64 = b1 + rs;
    var e2: f64 = _pmn_exp(b2);
    var pe: f64 = e1 * e2;
    return pe / x;
}

# Rust's `erf` (fdlibm), operation for operation: ±1 at ±∞, NaN for NaN.
#must_use
fn _pmn_erf(x: f64): f64 {
    var bits = load64(&x);
    var negative = (bits >> 63) & 1;
    var ix = _pmn_sp_high_word(x) & 0x7FFFFFFF;
    if (ix >= 0x7FF00000) {
        if (x != x) { return x; }
        if (negative == 1) { return -1.0; }
        return 1.0;
    }
    if (ix < 0x3FEB0000) {
        if (ix < 0x3E300000) {
            var efx8: f64 = _PMN_MATH_FDLIBM_EFX8;
            var a: f64 = 8.0 * x;
            var b: f64 = efx8 * x;
            var c: f64 = a + b;
            return 0.125 * c;
        }
        var z: f64 = x * x;
        var q: f64 = _pmn_sp_erf_small(z);
        var xq: f64 = x * q;
        return x + xq;
    }
    var y: f64 = 0.0;
    if (ix < 0x40180000) {
        var t: f64 = _pmn_sp_erfc_tail(ix, x);
        y = 1.0 - t;
    } else {
        var mp: f64 = _PMN_F64_MIN_POSITIVE;
        y = 1.0 - mp;
    }
    if (negative == 1) { return -y; }
    return y;
}

# Rust's `erfc` (fdlibm), computed directly so the tail keeps its relative precision: 0 at +∞, 2 at −∞.
#must_use
fn _pmn_erfc(x: f64): f64 {
    var bits = load64(&x);
    var negative = (bits >> 63) & 1;
    var ix = _pmn_sp_high_word(x) & 0x7FFFFFFF;
    if (ix >= 0x7FF00000) {
        if (x != x) { return x; }
        if (negative == 1) { return 2.0; }
        return 0.0;
    }
    if (ix < 0x3FEB0000) {
        if (ix < 0x3C700000) { return 1.0 - x; }
        var z: f64 = x * x;
        var y: f64 = _pmn_sp_erf_small(z);
        var xy: f64 = x * y;
        if (negative == 1 || ix < 0x3FD00000) {
            var t1: f64 = x + xy;
            return 1.0 - t1;
        }
        var t2: f64 = x - 0.5;
        var t3: f64 = t2 + xy;
        return 0.5 - t3;
    }
    if (ix < 0x403C0000) {
        var tail: f64 = _pmn_sp_erfc_tail(ix, x);
        if (negative == 1) { return 2.0 - tail; }
        return tail;
    }
    if (negative == 1) {
        var mp: f64 = _PMN_F64_MIN_POSITIVE;
        return 2.0 - mp;
    }
    return 0.0;
}

# Rust's `normal_cdf`: Φ(z) = 0.5 · erfc(−z / √2), accurate in both tails.
#must_use
fn _pmn_normal_cdf(z: f64): f64 {
    var nz: f64 = -z;
    var s2: f64 = _PMN_F64_SQRT_2;
    var a: f64 = nz / s2;
    var e: f64 = _pmn_erfc(a);
    return 0.5 * e;
}

# Rust's `normal_sf`: 1 − Φ(z) = 0.5 · erfc(z / √2), accurate in the upper tail.
#must_use
fn _pmn_normal_sf(z: f64): f64 {
    var s2: f64 = _PMN_F64_SQRT_2;
    var a: f64 = z / s2;
    var e: f64 = _pmn_erfc(a);
    return 0.5 * e;
}

# ── part a2: lnΓ and its relatives ──────────────────────────────────────────────────────────────────────────────

# Rust's `ln_gamma`: ln|Γ(x)| by Lanczos (g = 7, n = 9), with the reflection ln π − ln|sin πx| − lnΓ(1 − x) below ½.
# +∞ where |sin πx| < 1e-300: x = ±0 and 0 < |x| ≲ 3.2e-301 (1.3.0's own cutoff, which T1 removes). A negative integer
# is not a pole here: sin(π·n) rounds to about n·1.2e-16, so 1.3.0 returns a finite value there, and so does this.
# +∞ gives NaN, as in 1.3.0 (∞ − ∞ in the last line).
#must_use
fn _pmn_ln_gamma(x: f64): f64 {
    if (x < 0.5) {
        var pi: f64 = _PMN_F64_PI;
        var px: f64 = pi * x;
        var sv: f64 = _pmn_sin(px);
        var asv: f64 = f64_abs(sv);
        # 1.3.0 compares with the literal 1e-300: the generated LENTZ_TINY is that literal's double (and has no
        # positional form inside a line).
        var tiny: f64 = _PMN_MATH_LENTZ_TINY;
        if (asv < tiny) {
            var inf: f64 = _PMN_F64_INFINITY;
            return inf;
        }
        var lp: f64 = _pmn_ln(pi);
        var ls: f64 = _pmn_ln(asv);
        var omx: f64 = 1.0 - x;
        var lg: f64 = _pmn_ln_gamma(omx);
        var d: f64 = lp - ls;
        return d - lg;
    }
    var xm: f64 = x - 1.0;
    var sum: f64 = _PMN_MATH_LN_GAMMA_COEFFICIENTS_0;
    var d1: f64 = xm + 1.0;
    sum = sum + _PMN_MATH_LN_GAMMA_COEFFICIENTS_1 / d1;
    var d2: f64 = xm + 2.0;
    sum = sum + _PMN_MATH_LN_GAMMA_COEFFICIENTS_2 / d2;
    var d3: f64 = xm + 3.0;
    sum = sum + _PMN_MATH_LN_GAMMA_COEFFICIENTS_3 / d3;
    var d4: f64 = xm + 4.0;
    sum = sum + _PMN_MATH_LN_GAMMA_COEFFICIENTS_4 / d4;
    var d5: f64 = xm + 5.0;
    sum = sum + _PMN_MATH_LN_GAMMA_COEFFICIENTS_5 / d5;
    var d6: f64 = xm + 6.0;
    sum = sum + _PMN_MATH_LN_GAMMA_COEFFICIENTS_6 / d6;
    var d7: f64 = xm + 7.0;
    sum = sum + _PMN_MATH_LN_GAMMA_COEFFICIENTS_7 / d7;
    var d8: f64 = xm + 8.0;
    sum = sum + _PMN_MATH_LN_GAMMA_COEFFICIENTS_8 / d8;
    var g: f64 = _PMN_MATH_LN_GAMMA_G;
    var tg: f64 = xm + g;
    var t: f64 = tg + 0.5;
    var lt: f64 = _pmn_ln(t);
    var xh: f64 = xm + 0.5;
    var a1: f64 = lt * xh;
    var a2: f64 = _PMN_MATH_LN_SQRT_2PI + a1;
    var a3: f64 = a2 - t;
    var lsum: f64 = _pmn_ln(sum);
    return a3 + lsum;
}

# Rust's `stirling_error`: lnΓ(a) − [(a − ½) ln a − a + ln √(2π)]. From a = 10 the asymptotic series, seven terms in
# 1/a² (its coefficients are Rust's literal quotients, each a correctly rounded division as Rust folds it); below,
# the difference itself.
#must_use
fn _pmn_stirling_error(a: f64): f64 {
    if (a >= 10.0) {
        var r: f64 = 1.0 / a;
        var r2: f64 = r * r;
        var t: f64 = r2 / 156.0;
        t = 691.0 / 360360.0 - t;
        t = 1.0 / 1188.0 - r2 * t;
        t = 1.0 / 1680.0 - r2 * t;
        t = 1.0 / 1260.0 - r2 * t;
        t = 1.0 / 360.0 - r2 * t;
        t = 1.0 / 12.0 - r2 * t;
        return r * t;
    }
    var lg: f64 = _pmn_ln_gamma(a);
    var la: f64 = _pmn_ln(a);
    var am: f64 = a - 0.5;
    var b1: f64 = am * la;
    var b2: f64 = b1 - a;
    var b3: f64 = b2 + _PMN_MATH_LN_SQRT_2PI;
    return lg - b3;
}

# Rust's `bd0`, Loader's deviance term x ln(x/m) + m − x, as m·((1 + u) ln(1 + u) − u) with u = (x − m)/m: its
# absolute error is about |x − m|·ε rather than x·ε. m at x = 0.
#must_use
fn _pmn_bd0(x: f64, m: f64): f64 {
    if (x == 0.0) { return m; }
    var xm: f64 = x - m;
    var u: f64 = xm / m;
    var l: f64 = _pmn_ln_1p(u);
    var u1: f64 = 1.0 + u;
    var p: f64 = u1 * l;
    var d: f64 = p - u;
    return m * d;
}

# Rust's `ln_gamma_kernel`: a ln x − x − lnΓ(a), the log of the incomplete gamma's prefactor (and of the Poisson pmf
# at a = k + 1). From a = 10 it is −a(u − ln(1 + u)) + ½ ln a − ln √(2π) − stirling_error(a), u = (x − a)/a, which
# does not cancel.
#must_use
fn _pmn_ln_gamma_kernel(a: f64, x: f64): f64 {
    if (a < 10.0) {
        var lx: f64 = _pmn_ln(x);
        var t: f64 = a * lx;
        var t2: f64 = t - x;
        var lg: f64 = _pmn_ln_gamma(a);
        return t2 - lg;
    }
    var xa: f64 = x - a;
    var u: f64 = xa / a;
    var l1: f64 = _pmn_ln_1p(u);
    var d: f64 = u - l1;
    var na: f64 = -a;
    var m: f64 = na * d;
    var la: f64 = _pmn_ln(a);
    var h: f64 = 0.5 * la;
    var r: f64 = m + h;
    var r2: f64 = r - _PMN_MATH_LN_SQRT_2PI;
    var st: f64 = _pmn_stirling_error(a);
    return r2 - st;
}

# Rust's `ln_beta`: ln B(a, b) = lnΓ(a) + lnΓ(b) − lnΓ(a + b), in R's lbeta scheme: with p = min(a, b) and
# q = max(a, b) (Rust's min and max, which ignore a NaN), the Stirling corrections when q ≥ 10, so the three lnΓ
# never cancel.
#must_use
fn _pmn_ln_beta(a: f64, b: f64): f64 {
    var p: f64 = _pmn_min(a, b);
    var q: f64 = _pmn_max(a, b);
    if (p >= 10.0) {
        var pq: f64 = p + q;
        var sp: f64 = _pmn_stirling_error(p);
        var sq: f64 = _pmn_stirling_error(q);
        var spq: f64 = _pmn_stirling_error(pq);
        var c1: f64 = sp + sq;
        var corr: f64 = c1 - spq;
        var lq: f64 = _pmn_ln(q);
        var t1: f64 = -0.5 * lq;
        var t2: f64 = t1 + _PMN_MATH_LN_SQRT_2PI;
        var t3: f64 = t2 + corr;
        var r: f64 = p / pq;
        var lr: f64 = _pmn_ln(r);
        var pm: f64 = p - 0.5;
        var t4: f64 = pm * lr;
        var t5: f64 = t3 + t4;
        var np: f64 = -p;
        var nr: f64 = np / pq;
        var l1: f64 = _pmn_ln_1p(nr);
        var t6: f64 = q * l1;
        return t5 + t6;
    }
    if (q >= 10.0) {
        var pq2: f64 = p + q;
        var sq2: f64 = _pmn_stirling_error(q);
        var spq2: f64 = _pmn_stirling_error(pq2);
        var corr2: f64 = sq2 - spq2;
        var lgp: f64 = _pmn_ln_gamma(p);
        var u1: f64 = lgp + corr2;
        var u2: f64 = u1 + p;
        var lpq: f64 = _pmn_ln(pq2);
        var plp: f64 = p * lpq;
        var u3: f64 = u2 - plp;
        var np2: f64 = -p;
        var nr2: f64 = np2 / pq2;
        var l2: f64 = _pmn_ln_1p(nr2);
        var qm: f64 = q - 0.5;
        var u4: f64 = qm * l2;
        return u3 + u4;
    }
    var ga: f64 = _pmn_ln_gamma(a);
    var gb: f64 = _pmn_ln_gamma(b);
    var ab: f64 = a + b;
    var gab: f64 = _pmn_ln_gamma(ab);
    var g1: f64 = ga + gb;
    return g1 - gab;
}

# ── part a3: the regularized incomplete gamma ───────────────────────────────────────────────────────────────────

# Rust's `iteration_budget`: min(200 + 20·√shape, 10⁶) iterations, truncated as `as usize` truncates; √shape is 0
# for a shape that is not finite and positive. Bounds every series and continued fraction's worst-case time.
#must_use
fn _pmn_iteration_budget(shape: f64): i64 {
    var root: f64 = 0.0;
    if (_pmn_is_finite(shape) == 1 && shape > 0.0) { root = f64_sqrt(shape); }
    var t: f64 = 20.0 * root;
    var b: f64 = 200.0 + t;
    var mx: f64 = _PMN_MATH_MAX_ITERATIONS;
    var m: f64 = _pmn_min(b, mx);
    return _pmn_sat_usize(m);
}

# Rust's `gamma_series_p`: P(a, x) = e^kernel · Σ xⁿ / (a(a + 1)…(a + n)), stopped when a term falls below 1e-15 of
# the sum or the budget runs out, then clamped to [0, 1]. 0 when the prefactor underflows.
#must_use
fn _pmn_gamma_series_p(a: f64, x: f64): f64 {
    var k: f64 = _pmn_ln_gamma_kernel(a, x);
    var prefix: f64 = _pmn_exp(k);
    if (prefix == 0.0) { return 0.0; }
    var eps: f64 = _PMN_MATH_CONVERGENCE_EPS;
    var ap: f64 = a;
    var sum: f64 = 1.0 / a;
    var del: f64 = sum;
    var n = _pmn_iteration_budget(a);
    for (var i = 0; i < n; i = i + 1) {
        ap = ap + 1.0;
        var q: f64 = x / ap;
        del = del * q;
        sum = sum + del;
        var adel: f64 = f64_abs(del);
        var asum: f64 = f64_abs(sum);
        var lim: f64 = asum * eps;
        if (adel < lim) { break; }
    }
    var r: f64 = sum * prefix;
    return _pmn_clamp(r, 0.0, 1.0);
}

# Rust's `gamma_cf_q`: Q(a, x) by the modified Lentz continued fraction, each denominator kept from 0 by 1e-300,
# stopped when a factor is within 1e-15 of 1 or the budget runs out, then clamped. 0 when the prefactor underflows.
#must_use
fn _pmn_gamma_cf_q(a: f64, x: f64): f64 {
    var k: f64 = _pmn_ln_gamma_kernel(a, x);
    var prefix: f64 = _pmn_exp(k);
    if (prefix == 0.0) { return 0.0; }
    var tiny: f64 = _PMN_MATH_LENTZ_TINY;
    var eps: f64 = _PMN_MATH_CONVERGENCE_EPS;
    var x1: f64 = x + 1.0;
    var b: f64 = x1 - a;
    var c: f64 = 1.0 / tiny;
    var d: f64 = 1.0 / b;
    var h: f64 = d;
    var n = _pmn_iteration_budget(a);
    for (var i = 1; i <= n; i = i + 1) {
        var fi: f64 = f64_from(i);
        var nfi: f64 = -fi;
        var ima: f64 = fi - a;
        var an: f64 = nfi * ima;
        b = b + 2.0;
        var ad: f64 = an * d;
        d = ad + b;
        var dabs: f64 = f64_abs(d);
        if (dabs < tiny) { d = tiny; }
        var ac: f64 = an / c;
        c = b + ac;
        var cabs: f64 = f64_abs(c);
        if (cabs < tiny) { c = tiny; }
        d = 1.0 / d;
        var del: f64 = d * c;
        h = h * del;
        var dm: f64 = del - 1.0;
        var dma: f64 = f64_abs(dm);
        if (dma < eps) { break; }
    }
    var r: f64 = h * prefix;
    return _pmn_clamp(r, 0.0, 1.0);
}

# Rust's `gamma_inc`: (P(a, x), Q(a, x)), each computed without cancellation: the series for P below x = a + 1 and the
# continued fraction for Q from there, the other as 1 − it. Past a = 10⁹, Wilson–Hilferty: (x/a)^⅓ is close to
# N(1 − 1/(9a), 1/(9a)). (NaN, NaN) for a NaN argument or a ≤ 0; (0, 1) for x ≤ 0 or a = +∞; (1, 0) for x = +∞.
#must_use
fn _pmn_gamma_inc(a: f64, x: f64): (f64, f64) {
    if (x != x || a != a || a <= 0.0) {
        var nan: f64 = _PMN_F64_NAN;
        return (nan, nan);
    }
    if (x <= 0.0) { return (0.0, 1.0); }
    var inf: f64 = _PMN_F64_INFINITY;
    if (x == inf) { return (1.0, 0.0); }
    if (a == inf) { return (0.0, 1.0); }
    var wh: f64 = _PMN_MATH_GAMMA_WILSON_HILFERTY_SHAPE;
    if (a > wh) {
        var a9: f64 = 9.0 * a;
        var v: f64 = 1.0 / a9;
        var xa: f64 = x / a;
        var cr: f64 = _pmn_cbrt(xa);
        var mv: f64 = 1.0 - v;
        var num: f64 = cr - mv;
        var sv: f64 = f64_sqrt(v);
        var z: f64 = num / sv;
        var pz: f64 = _pmn_normal_cdf(z);
        var qz: f64 = _pmn_normal_sf(z);
        return (pz, qz);
    }
    var a1: f64 = a + 1.0;
    if (x < a1) {
        var p: f64 = _pmn_gamma_series_p(a, x);
        var q: f64 = 1.0 - p;
        return (p, q);
    }
    var q2: f64 = _pmn_gamma_cf_q(a, x);
    var p2: f64 = 1.0 - q2;
    return (p2, q2);
}

# Rust's `regularized_lower_incomplete_gamma`: P(a, x) = γ(a, x)/Γ(a), gamma_inc's first value.
#must_use
fn _pmn_regularized_lower_incomplete_gamma(a: f64, x: f64): f64 {
    var p, q = _pmn_gamma_inc(a, x);
    return p;
}

# Rust's `regularized_upper_incomplete_gamma`: Q(a, x) = 1 − P(a, x), computed directly, gamma_inc's second value.
#must_use
fn _pmn_regularized_upper_incomplete_gamma(a: f64, x: f64): f64 {
    var p, q = _pmn_gamma_inc(a, x);
    return q;
}
