# p9_ncdf.bcyr — probe P9, normal_cdf: the cost of T0, the correctly rounded erfc alone, and T1 (port plan §5 step
# 9d-4, §3.7).
#
# ns per call on 4,096 seeded arguments per region, cycled 250 times: the core, where T1 takes CORE-MATH's accurate
# path, the lower tail, and the deep tail with its subnormal results.
#   CYRIUS_ALLOW_ABSOLUTE_INCLUDES=1 cyrius bench scripts/probes/p9_ncdf.bcyr

include "scripts/probes/p9_ncdf_impl.cyr"

var g_rng = 0x2545F4914F6CDD1D;
var g_xs = 0;

fn p9_unit(): f64 {
    var x = g_rng;
    x = x ^ (x >> 12);
    x = x ^ (x << 25);
    x = x ^ (x >> 27);
    g_rng = x;
    var top = (x * 0x2545F4914F6CDD1D) >> 11;
    var a: f64 = f64_from(top);
    var d: f64 = 9007199254740992.0;
    return a / d;
}

fn fill(lo: f64, hi: f64): i64 {
    var i = 0;
    while (i < 4096) {
        var w: f64 = hi - lo;
        var u: f64 = p9_unit();
        var x: f64 = lo + w * u;
        store64(g_xs + i * 8, x);
        i = i + 1;
    }
    return 0;
}

# `which`: 0 T0, 1 the correctly rounded erfc alone, 2 T1.
fn row(name: cstring, which): i64 {
    var s: f64 = 0.0;
    var b = bench_new(name);
    bench_batch_start(b);
    var k = 0;
    while (k < 250) {
        var i = 0;
        while (i < 4096) {
            var x: f64 = load64(g_xs + i * 8);
            var r: f64 = 0.0;
            if (which == 0) { r = p9_t0_normal_cdf(x); }
            if (which == 1) { r = p9_cr_normal_cdf(x); }
            if (which == 2) { r = p9_t1_normal_cdf(x); }
            s = s + r;
            i = i + 1;
        }
        k = k + 1;
    }
    bench_batch_stop(b, 1024000);
    bench_report(b);
    if (s != s) { println("nan"); }
    return 0;
}

fn region(lo: f64, hi: f64, t0: cstring, cr: cstring, t1: cstring): i64 {
    fill(lo, hi);
    row(t0, 0);
    row(cr, 1);
    row(t1, 2);
    return 0;
}

fn main(): i64 {
    alloc_init();
    g_xs = alloc(4096 * 8);
    region(-5.0, 5.0, "T0, z in (-5, 5)", "CR erfc alone, z in (-5, 5)", "T1, z in (-5, 5)");
    region(-4.1, -2.5, "T0, z in (-4.1, -2.5)", "CR erfc alone, z in (-4.1, -2.5)", "T1, z in (-4.1, -2.5)");
    region(-36.0, -5.0, "T0, z in (-36, -5)", "CR erfc alone, z in (-36, -5)", "T1, z in (-36, -5)");
    region(-38.4, -36.6, "T0, z in (-38.4, -36.6)", "CR erfc alone, z in (-38.4, -36.6)", "T1, z in (-38.4, -36.6)");
    return 0;
}

var rc = main();
sys_exit_group(rc);
