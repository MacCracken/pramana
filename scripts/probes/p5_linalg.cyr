# p5_linalg.cyr — M0 step 9, probe P5: the linear algebra (port plan §5 step 9, §8.2).
#
# pramana 1.3.0 calls four hisab 1.4.0 routines: cholesky, cholesky_solve, least_squares_poly (modified Gram–Schmidt
# QR on the raw Vandermonde matrix) and eigen_symmetric (cyclic Jacobi). This computes the Rust twin's seeded inputs
# (scripts/probes/rust/src/bin/p5_linalg.rs) with ganita's counterparts, and hisab 3.5's eigen_symmetric, and
# prints every element for scripts/probes/p0_compare.py. The heap bytes each call leaves behind go to stderr.
#   CYRIUS_ALLOW_ABSOLUTE_INCLUDES=1 cyrius build scripts/probes/p5_linalg.cyr build/p5_linalg
#   ./build/p5_linalg > build/p5_cyrius.tsv
# (hisab 3.5's bundle is included from its repo by absolute path, which the compiler refuses unless allowed.)

include "/home/macro/Repos/hisab/dist/hisab.cyr"

var g_state = 0;

# Write a C string to stdout.
fn put(s: cstring): i64 {
    print(s, strlen(s));
    return 0;
}

# `kind[a,b][i]` or `kind[a,b][i,j]` <TAB> variant <TAB> f64 <TAB> bits.
fn show(kind: cstring, a, b, i, j, two, variant: cstring, bits): i64 {
    put(kind);
    put("[");
    fmt_int(a);
    put(",");
    fmt_int(b);
    put("][");
    fmt_int(i);
    if (two == 1) {
        put(",");
        fmt_int(j);
    }
    put("]\t");
    put(variant);
    put("\tf64\t");
    fmt_hex0x(bits);
    println("");
    return 0;
}

# The twin's xorshift64*: uniform in [0, 1) from the top 53 bits.
fn g_unit(): f64 {
    var x = g_state;
    x = x ^ (x >> 12);
    x = x ^ (x << 25);
    x = x ^ (x >> 27);
    g_state = x;
    var top = (x * 0x2545f4914f6cdd1d) >> 11;
    var a: f64 = f64_from(top);
    var d: f64 = 9007199254740992.0;
    return a / d;
}

fn g_uniform(lo: f64, hi: f64): f64 {
    var u: f64 = g_unit();
    var w: f64 = hi - lo;
    var r: f64 = lo + w * u;
    return r;
}

# A = BᵀB + n·I with B uniform in [−1, 1), summed in k order, as the twin builds it.
fn spd(n): i64 {
    var b = ganita_mat_new(n, n);
    var i = 0;
    while (i < n) {
        var j = 0;
        while (j < n) {
            var v: f64 = g_uniform(-1.0, 1.0);
            ganita_mat_set(b, i, j, v);
            j = j + 1;
        }
        i = i + 1;
    }
    var a = ganita_mat_new(n, n);
    var nf: f64 = f64_from(n);
    i = 0;
    while (i < n) {
        var j = 0;
        while (j < n) {
            var s: f64 = 0.0;
            var k = 0;
            while (k < n) {
                var bki: f64 = ganita_mat_get(b, k, i);
                var bkj: f64 = ganita_mat_get(b, k, j);
                s = s + bki * bkj;
                k = k + 1;
            }
            if (i == j) { s = s + nf; }
            ganita_mat_set(a, i, j, s);
            j = j + 1;
        }
        i = i + 1;
    }
    return a;
}

# Sorts vals (n words) by descending |value|, insertion order kept for ties, as hisab 1.4.0 orders its eigenvalues.
fn sort_abs_desc(vals, n): i64 {
    var i = 1;
    while (i < n) {
        var x = load64(vals + i * 8);
        var ax: f64 = f64_abs(x);
        var j = i - 1;
        while (j >= 0) {
            var y: f64 = f64_abs(load64(vals + j * 8));
            if (f64_lt(y, ax) == 0) { break; }
            store64(vals + (j + 1) * 8, load64(vals + j * 8));
            j = j - 1;
        }
        store64(vals + (j + 1) * 8, x);
        i = i + 1;
    }
    return 0;
}

# A non-negative integer in decimal, on stderr.
fn eprint_int(v): i64 {
    var buf[24];
    var at = 23;
    if (v == 0) {
        eprint("0", 1);
        return 0;
    }
    while (v > 0) {
        store8(&buf + at, 48 + v % 10);
        v = v / 10;
        at = at - 1;
    }
    eprint(&buf + at + 1, 23 - at);
    return 0;
}

# One heap note on stderr: what a call left on the bump heap.
fn note(what: cstring, n, bytes): i64 {
    eprint(what, strlen(what));
    eprint(" n=", 3);
    eprint_int(n);
    eprint(": ", 2);
    eprint_int(bytes);
    eprint(" bytes\n", 7);
    return 0;
}

# Entry point: the twin's cases, in its order.
fn main(): i64 {
    alloc_init();
    var sizes[48];
    store64(&sizes + 0, 2);
    store64(&sizes + 8, 3);
    store64(&sizes + 16, 4);
    store64(&sizes + 24, 6);
    store64(&sizes + 32, 8);
    store64(&sizes + 40, 10);
    var si = 0;
    while (si < 6) {
        var n = load64(&sizes + si * 8);
        var seed = 1;
        while (seed <= 10) {
            g_state = seed * 7919 + n;
            var a = spd(n);
            var rhs = alloc(n * 8);
            var r = 0;
            while (r < n) {
                var v: f64 = g_uniform(-1.0, 1.0);
                store64(rhs + r * 8, v);
                r = r + 1;
            }
            var l = ganita_mat_new(n, n);
            ganita_mat_cholesky(a, l);
            var i = 0;
            while (i < n) {
                var j = 0;
                while (j <= i) {
                    show("chol", n, seed, i, j, 1, "ganita_mat_cholesky", ganita_mat_get(l, i, j));
                    j = j + 1;
                }
                i = i + 1;
            }
            var x = alloc(n * 8);
            var before = alloc_used();
            ganita_mat_cholesky_solve(l, rhs, x);
            if (seed == 1) { note("ganita_mat_cholesky_solve", n, alloc_used() - before); }
            i = 0;
            while (i < n) {
                show("solve", n, seed, i, 0, 0, "ganita_mat_cholesky_solve", load64(x + i * 8));
                i = i + 1;
            }
            var vals = alloc(n * 8);
            var vecs = ganita_mat_new(n, n);
            before = alloc_used();
            ganita_mat_eigen_sym(a, vals, vecs);
            if (seed == 1) { note("ganita_mat_eigen_sym", n, alloc_used() - before); }
            sort_abs_desc(vals, n);
            i = 0;
            while (i < n) {
                show("eigval", n, seed, i, 0, 0, "ganita_mat_eigen_sym", load64(vals + i * 8));
                i = i + 1;
            }
            var vals2 = alloc(n * 8);
            var vecs2 = ganita_mat_new(n, n);
            before = alloc_used();
            var tag, val = eigen_symmetric(a, n, vals2, vecs2);
            if (seed == 1) { note("hisab 3.5 eigen_symmetric", n, alloc_used() - before); }
            if (tag == 0) {
                i = 0;
                while (i < n) {
                    show("eigval", n, seed, i, 0, 0, "hisab 3.5 eigen_symmetric", load64(vals2 + i * 8));
                    i = i + 1;
                }
            }
            seed = seed + 1;
        }
        si = si + 1;
    }
    var degree = 1;
    while (degree <= 4) {
        var seed = 1;
        while (seed <= 10) {
            g_state = seed * 104729 + degree;
            var m = 40;
            var xs = alloc(m * 8);
            var ys = alloc(m * 8);
            var k = 0;
            while (k < m) {
                var xv: f64 = g_uniform(-2.0, 2.0);
                store64(xs + k * 8, xv);
                k = k + 1;
            }
            k = 0;
            while (k < m) {
                var xk: f64 = load64(xs + k * 8);
                var noise: f64 = g_uniform(-0.1, 0.1);
                var yv: f64 = 1.0 + 0.5 * xk - 0.25 * xk * xk + noise;
                store64(ys + k * 8, yv);
                k = k + 1;
            }
            # The Vandermonde matrix, x^j by compiler-rt's __powidf2 order (as hisab 1.4.0's runtime powi).
            var vm = ganita_mat_new(m, degree + 1);
            k = 0;
            while (k < m) {
                var j = 0;
                while (j <= degree) {
                    var base: f64 = load64(xs + k * 8);
                    var acc: f64 = 1.0;
                    var e = j;
                    while (e != 0) {
                        if ((e & 1) == 1) { acc = acc * base; }
                        e = e >> 1;
                        if (e != 0) { base = base * base; }
                    }
                    ganita_mat_set(vm, k, j, acc);
                    j = j + 1;
                }
                k = k + 1;
            }
            var coef = alloc((degree + 1) * 8);
            var before = alloc_used();
            ganita_mat_least_squares(vm, ys, coef);
            if (seed == 1) { note("ganita_mat_least_squares (m = 40)", degree + 1, alloc_used() - before); }
            var i = 0;
            while (i <= degree) {
                show("lsq", degree, seed, i, 0, 0, "ganita_mat_least_squares", load64(coef + i * 8));
                i = i + 1;
            }
            seed = seed + 1;
        }
        degree = degree + 1;
    }
    return 0;
}

var rc = main();
sys_exit_group(rc);
