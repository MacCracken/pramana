# p0_semantics.cyr — M0 step 4: the Cyrius counterpart of every Rust f64 / u64 operation pramana 1.3.0 uses
# (port plan §8.1), probed on the pinned toolchain. pravash's probe is the template.
#
# Prints one line per probe: case <TAB> variant <TAB> type <TAB> bits (0x hex of the word). Its twin
# p0_semantics.rs prints Rust's value for each case, and p0_compare.py joins the two:
#   cyrius build scripts/probes/p0_semantics.cyr build/p0_semantics && ./build/p0_semantics > build/p0_cyrius.tsv
#   python3 -I -B scripts/probes/p0_compare.py build/p0_cyrius.tsv build/p0_rust.tsv
# Types: f64 (bits compared by ulp), u32 / u64 / i64 (the word compared at that width).

var g_rng = 0;

# Write a C string to stdout.
fn put(s: cstring): i64 {
    print(s, strlen(s));
    return 0;
}

# One probe line: name, variant, type, the word's bits in hex.
fn show(name: cstring, variant: cstring, ty: cstring, bits): i64 {
    put(name);
    put("\t");
    put(variant);
    put("\t");
    put(ty);
    put("\t");
    fmt_hex0x(bits);
    println("");
    return 0;
}

# A saturating f64 → u64, as Rust's `as usize` on 64-bit (NaN and negatives → 0, ≥ 2^64 → u64::MAX).
fn sat_u64(x: f64): i64 {
    if (x != x) { return 0; }
    if (x <= 0.0) { return 0; }
    if (x >= 18446744073709551616.0) { return -1; }
    if (x >= 9223372036854775808.0) {
        var hi: f64 = x - 9223372036854775808.0;
        return f64_to(hi) | 0x8000000000000000;
    }
    return f64_to(x);
}

# u64 → f64 rounded to nearest, as Rust's `as f64`. f64_from reads the word as signed, so a word at or above 2^63
# is halved first, keeping the lost bit as a sticky bit, then doubled exactly.
fn u64_to_f64(n): f64 {
    if (n >= 0) {
        var a: f64 = f64_from(n);
        return a;
    }
    var half = (n >> 1) | (n & 1);
    var h: f64 = f64_from(half);
    return h + h;
}

# SimpleRng::next_f64: xorshift64 on g_rng, then the top 53 bits over 2^53.
fn xs_next(): f64 {
    var x = g_rng;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    g_rng = x;
    var top = x >> 11;
    var a: f64 = f64_from(top);
    var two53: f64 = 9007199254740992.0;
    return a / two53;
}

# Draws 1 and 1000 from a seed, with the state after each.
fn p_rng(s1: cstring, d1: cstring, s1000: cstring, d1000: cstring, seed): i64 {
    g_rng = seed;
    var first: f64 = xs_next();
    show(s1, "xorshift64 (<< >> logical)", "u64", g_rng);
    show(d1, "(x >> 11) / 2^53", "f64", first);
    var last: f64 = 0.0;
    var i = 1;
    while (i < 1000) {
        last = xs_next();
        i = i + 1;
    }
    show(s1000, "xorshift64 (<< >> logical)", "u64", g_rng);
    show(d1000, "(x >> 11) / 2^53", "f64", last);
    return 0;
}

# f64::total_cmp's key: the bits with the magnitude flipped for negatives (>>> arithmetic, then >> logical).
fn total_key(bits): i64 {
    var k = bits;
    return k ^ ((k >>> 63) >> 1);
}

# fract two ways: the stdlib's f64_fract, and Rust's definition x − trunc(x).
fn p_fract(name: cstring, x: f64): i64 {
    var a: f64 = f64_fract(x);
    show(name, "f64_fract", "f64", a);
    var t: f64 = f64_trunc(x);
    var b: f64 = x - t;
    show(name, "x - f64_trunc(x)", "f64", b);
    return 0;
}

# exp through the builtin and the polyfill.
fn p_exp(name: cstring, x: f64): i64 {
    var a: f64 = f64_exp(x);
    show(name, "f64_exp", "f64", a);
    var b: f64 = _f64_exp_polyfill(x);
    show(name, "_f64_exp_polyfill", "f64", b);
    return 0;
}

# ln through the builtin and the polyfill.
fn p_ln(name: cstring, x: f64): i64 {
    var a: f64 = f64_ln(x);
    show(name, "f64_ln", "f64", a);
    var b: f64 = _f64_ln_polyfill(x);
    show(name, "_f64_ln_polyfill", "f64", b);
    return 0;
}

# ln_1p: only ganita's private fdlibm port exists.
fn p_ln1p(name: cstring, x: f64): i64 {
    var a: f64 = _gn_log1p(x);
    show(name, "_gn_log1p (ganita, private)", "f64", a);
    return 0;
}

# exp_m1: only ganita's private fdlibm port exists.
fn p_expm1(name: cstring, x: f64): i64 {
    var a: f64 = _gn_expm1(x);
    show(name, "_gn_expm1 (ganita, private)", "f64", a);
    return 0;
}

# sin and cos (the fdlibm polyfill on every target).
fn p_sincos(sname: cstring, cname: cstring, x: f64): i64 {
    var a: f64 = f64_sin(x);
    show(sname, "f64_sin", "f64", a);
    var c: f64 = f64_cos(x);
    show(cname, "f64_cos", "f64", c);
    return 0;
}

# tan (ganita's fdlibm port).
fn p_tan(name: cstring, x: f64): i64 {
    var a: f64 = ganita_f64_tan(x);
    show(name, "ganita_f64_tan", "f64", a);
    return 0;
}

# atan through the builtin and the polyfill.
fn p_atan(name: cstring, x: f64): i64 {
    var a: f64 = f64_atan(x);
    show(name, "f64_atan", "f64", a);
    var b: f64 = _f64_atan_polyfill(x);
    show(name, "_f64_atan_polyfill", "f64", b);
    return 0;
}

# log2 through the builtin and the polyfill.
fn p_log2(name: cstring, x: f64): i64 {
    var a: f64 = f64_log2(x);
    show(name, "f64_log2", "f64", a);
    var b: f64 = _f64_log2_polyfill(x);
    show(name, "_f64_log2_polyfill", "f64", b);
    return 0;
}

# floor(x) as usize, saturating and raw.
fn p_usize(name: cstring, x: f64): i64 {
    var fl: f64 = f64_floor(x);
    show(name, "sat_u64", "u64", sat_u64(fl));
    show(name, "f64_to (no saturation)", "u64", f64_to(fl));
    return 0;
}

# The fdlibm high word, (bits >> 32) as u32.
fn p_hi(name: cstring, x: f64): i64 {
    var bits = x;
    show(name, "bits >> 32", "u32", bits >> 32);
    return 0;
}

# A u64 → f64 conversion, with the helper and with f64_from alone.
fn p_u64(name: cstring, n): i64 {
    var a: f64 = u64_to_f64(n);
    show(name, "u64_to_f64 (sticky halving)", "f64", a);
    var b: f64 = f64_from(n);
    show(name, "f64_from (signed)", "f64", b);
    return 0;
}

# A comparison's outcome as 0 or 1.
fn p_cmp(name: cstring, variant: cstring, c): i64 {
    var v = 0;
    if (c) { v = 1; }
    show(name, variant, "u64", v);
    return 0;
}

# Entry point: every case in the order p0_semantics.rs prints them.
fn main(): i64 {
    alloc_init();
    var nan: f64 = 0x7FF8000000000000;
    var inf: f64 = 0x7FF0000000000000;
    var negz: f64 = 0x8000000000000000;
    var zero: f64 = 0.0;
    var one: f64 = 1.0;
    var r: f64 = 0.0;

    # min / max / clamp
    r = f64_min(nan, 1.0);
    show("min(nan,1)", "f64_min", "f64", r);
    r = f64_min(1.0, nan);
    show("min(1,nan)", "f64_min", "f64", r);
    r = f64_max(nan, 1.0);
    show("max(nan,1)", "f64_max", "f64", r);
    r = f64_max(1.0, nan);
    show("max(1,nan)", "f64_max", "f64", r);
    r = f64_min(0.0, negz);
    show("min(+0,-0)", "f64_min", "f64", r);
    r = f64_max(0.0, negz);
    show("max(+0,-0)", "f64_max", "f64", r);
    r = f64_clamp(nan, 0.0, 1.0);
    show("clamp(nan,0,1)", "f64_clamp", "f64", r);
    r = f64_clamp(2.0, 0.0, 1.0);
    show("clamp(2,0,1)", "f64_clamp", "f64", r);
    r = f64_clamp(negz, 0.0, 1.0);
    show("clamp(-0,0,1)", "f64_clamp", "f64", r);

    # exact operations
    r = f64_floor(-0.5);
    show("floor(-0.5)", "f64_floor", "f64", r);
    r = f64_floor(negz);
    show("floor(-0)", "f64_floor", "f64", r);
    r = f64_floor(2.5);
    show("floor(2.5)", "f64_floor", "f64", r);
    r = f64_ceil(-0.5);
    show("ceil(-0.5)", "f64_ceil", "f64", r);
    r = f64_trunc(-2.7);
    show("trunc(-2.7)", "f64_trunc", "f64", r);
    r = f64_sqrt(2.0);
    show("sqrt(2)", "f64_sqrt", "f64", r);
    r = f64_sqrt(negz);
    show("sqrt(-0)", "f64_sqrt", "f64", r);
    r = f64_abs(negz);
    show("abs(-0)", "f64_abs", "f64", r);

    # fract
    p_fract("fract(2.75)", 2.75);
    p_fract("fract(-2.75)", -2.75);
    p_fract("fract(-0)", negz);
    p_fract("fract(3)", 3.0);
    var big: f64 = .0;
    p_fract("fract(1e300)", big);
    p_fract("fract(inf)", inf);

    # transcendentals
    p_exp("exp(-0.7)", -0.7);
    p_exp("exp(1)", 1.0);
    p_exp("exp(5.3)", 5.3);
    p_exp("exp(239.014)", 239.01439753131297);
    p_ln("ln(0.3)", 0.3);
    p_ln("ln(2)", 2.0);
    p_ln("ln(10)", 10.0);
    p_ln1p("ln_1p(1e-10)", 0.0000000001);
    p_ln1p("ln_1p(-0.5)", -0.5);
    p_ln1p("ln_1p(0.2833)", 0.28331233718677845);
    p_expm1("exp_m1(1e-10)", 0.0000000001);
    p_expm1("exp_m1(-3)", -3.0);
    p_expm1("exp_m1(0.9204)", 0.92043886641489558);
    r = ganita_f64_pow(2.0, 0.5);
    show("pow(2,0.5)", "ganita_f64_pow", "f64", r);
    r = ganita_f64_pow(1.5, 2.3);
    show("pow(1.5,2.3)", "ganita_f64_pow", "f64", r);
    r = ganita_f64_pow(200.0, -0.2);
    show("pow(200,-0.2)", "ganita_f64_pow", "f64", r);
    p_sincos("sin(0.5)", "cos(0.5)", 0.5);
    p_sincos("sin(1)", "cos(1)", 1.0);
    p_sincos("sin(3)", "cos(3)", 3.0);
    p_tan("tan(0.5)", 0.5);
    p_tan("tan(1.4939)", 1.4938616554658477);
    p_tan("tan(-1)", -1.0);
    p_atan("atan(0.5)", 0.5);
    p_atan("atan(-3)", -3.0);
    p_atan("atan(1e10)", 10000000000.0);
    p_log2("log2(3)", 3.0);
    p_log2("log2(8)", 8.0);
    p_log2("log2(10)", 10.0);
    r = ganita_f64_cbrt(2.0);
    show("cbrt(2)", "ganita_f64_cbrt", "f64", r);
    r = ganita_f64_cbrt(0.001);
    show("cbrt(0.001)", "ganita_f64_cbrt", "f64", r);
    var tiny: f64 = 0.;
    r = ganita_f64_cbrt(tiny);
    show("cbrt(1e-300)", "ganita_f64_cbrt", "f64", r);

    # powi in LLVM's square-and-multiply order: the result accumulates the set bits low to high
    var b: f64 = 1.1;
    var b2: f64 = b * b;
    show("powi(1.1,2)", "x*x", "f64", b2);
    r = b * b2;
    show("powi(1.1,3)", "x * x^2", "f64", r);
    r = b2 * b2;
    show("powi(1.1,4)", "(x^2)^2", "f64", r);
    var c: f64 = 0.9;
    var c2: f64 = c * c;
    var c4: f64 = c2 * c2;
    var c8: f64 = c4 * c4;
    r = c * c8;
    show("powi(0.9,9)", "x * x^8", "f64", r);
    var d: f64 = 0.99;
    var d2: f64 = d * d;
    var d4: f64 = d2 * d2;
    var d8: f64 = d4 * d4;
    var d16: f64 = d8 * d8;
    var d9: f64 = d * d8;
    r = d9 * d16;
    show("powi(0.99,25)", "(x * x^8) * x^16", "f64", r);
    var e: f64 = 0.999;
    var e2: f64 = e * e;
    var e4: f64 = e2 * e2;
    var e8: f64 = e4 * e4;
    var e16: f64 = e8 * e8;
    var e32: f64 = e16 * e16;
    var e17: f64 = e * e16;
    r = e17 * e32;
    show("powi(0.999,49)", "(x * x^16) * x^32", "f64", r);

    # SimpleRng
    p_rng("rng[1].state1", "rng[1].draw1", "rng[1].state1000", "rng[1].draw1000", 1);
    p_rng("rng[42].state1", "rng[42].draw1", "rng[42].state1000", "rng[42].draw1000", 42);
    p_rng("rng[2^63].state1", "rng[2^63].draw1", "rng[2^63].state1000", "rng[2^63].draw1000", 0x8000000000000000);
    p_rng("rng[u64max].state1", "rng[u64max].draw1", "rng[u64max].state1000", "rng[u64max].draw1000", -1);

    # total_cmp keys
    show("key(-nan)", "total_key", "i64", total_key(0xFFF8000000000000));
    show("key(-inf)", "total_key", "i64", total_key(0xFFF0000000000000));
    show("key(-1)", "total_key", "i64", total_key(0xBFF0000000000000));
    show("key(-0)", "total_key", "i64", total_key(0x8000000000000000));
    show("key(+0)", "total_key", "i64", total_key(0));
    show("key(1)", "total_key", "i64", total_key(0x3FF0000000000000));
    show("key(inf)", "total_key", "i64", total_key(0x7FF0000000000000));
    show("key(nan)", "total_key", "i64", total_key(0x7FF8000000000000));

    # u64 → f64
    p_u64("f64(12345u64)", 12345);
    p_u64("f64(2^53+1)", 9007199254740993);
    p_u64("f64(2^63)", 0x8000000000000000);
    p_u64("f64(2^63+2^11+1)", 0x8000000000000801);
    p_u64("f64(u64max)", -1);

    # f64 → usize
    p_usize("usize(floor(-3.7))", -3.7);
    p_usize("usize(floor(7.9))", 7.9);
    var huge: f64 = 100000000000000000000000000000.0;
    p_usize("usize(1e29)", huge);
    p_usize("usize(0)", 0.0);
    show("usize(nan)", "sat_u64", "u64", sat_u64(nan));
    show("usize(inf)", "sat_u64", "u64", sat_u64(inf));

    # the fdlibm word operations
    p_hi("hi(-2.5)", -2.5);
    p_hi("hi(1e-300)", tiny);
    p_hi("hi(0.84375)", 0.84375);
    var w = 1.2345678;
    var masked: f64 = w & 0xFFFFFFFF00000000;
    show("lowmask(1.2345678)", "bits & 0xFFFFFFFF00000000", "f64", masked);

    # constants and exponent literals, written positionally
    var eps: f64 = 0.0000000000000002220446049250313;
    show("EPSILON", "positional literal", "f64", eps);
    var minpos: f64 = 0.;
    show("MIN_POSITIVE", "positional literal", "f64", minpos);
    var fmax: f64 = .0;
    show("MAX", "positional literal", "f64", fmax);
    show("INFINITY", "hex bits", "f64", inf);
    show("NAN", "hex bits", "f64", nan);
    var pi: f64 = F64_PI;
    show("PI", "F64_PI", "f64", pi);
    var ee: f64 = F64_E;
    show("E", "F64_E", "f64", ee);
    var tau: f64 = F64_TAU;
    show("TAU", "F64_TAU", "f64", tau);
    var l15: f64 = 0.000000000000001;
    show("lit(1e-15)", "positional literal", "f64", l15);
    show("lit(1e-300)", "positional literal", "f64", tiny);
    show("lit(1e300)", "positional literal", "f64", big);
    var l9: f64 = 1000000000.0;
    show("lit(1e9)", "positional literal", "f64", l9);
    var l01: f64 = 0.1;
    show("lit(0.1)", "literal", "f64", l01);
    var lns: f64 = 0.9189385332046728;
    show("lit(LN_SQRT_2PI)", "literal", "f64", lns);

    # the neutral element of a sum
    var s0: f64 = negz;
    show("sum([])", "loop from -0.0", "f64", s0);
    var z0: f64 = 0.0;
    show("sum([])", "loop from 0.0", "f64", z0);
    var s1: f64 = negz + zero;
    show("sum([+0])", "loop from -0.0", "f64", s1);
    var s2: f64 = negz + negz;
    show("sum([-0])", "loop from -0.0", "f64", s2);
    var s3: f64 = zero + negz;
    show("sum([-0])", "loop from 0.0", "f64", s3);

    # comparisons on typed f64 locals
    p_cmp("lt(nan,1)", "<", nan < one);
    p_cmp("eq(nan,nan)", "==", nan == nan);
    p_cmp("ne(nan,nan)", "!=", nan != nan);
    p_cmp("lt(-0,+0)", "<", negz < zero);
    p_cmp("eq(-0,+0)", "==", negz == zero);
    p_cmp("ge(nan,0)", ">=", nan >= zero);
    return 0;
}

var rc = main();
sys_exit_group(rc);
