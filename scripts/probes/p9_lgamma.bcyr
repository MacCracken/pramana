# p9_lgamma.bcyr — probe P9, ln_gamma: the cost of T0 and T1 (port plan §5 step 9d, §3.7).
#
# ns per call on 4,096 seeded inputs per region, cycled 250 times (10^6 calls a row): beside the roots, (0.5, 10),
# [2, 8) and large x, plus x < 0. The sums keep every result live.
#   CYRIUS_ALLOW_ABSOLUTE_INCLUDES=1 cyrius bench scripts/probes/p9_lgamma.bcyr

include "scripts/probes/p9_lgamma_impl.cyr"

var g_rng = 0x2545F4914F6CDD1D;
var g_xs = 0;

fn p9_unit(): f64 {
    var x = g_rng;
    x = x ^ (x >> 12);
    x = x ^ (x << 25);
    x = x ^ (x >> 27);
    g_rng = x;
    var top = (x * 0x2545F4914F6CDD1D) >> 11;
    var a: f64 = f64_from(top);
    var d: f64 = 9007199254740992.0;
    return a / d;
}

# 4,096 inputs in [lo, hi) into g_xs.
fn fill(lo: f64, hi: f64): i64 {
    var i = 0;
    while (i < 4096) {
        var w: f64 = hi - lo;
        var u: f64 = p9_unit();
        var x: f64 = lo + w * u;
        store64(g_xs + i * 8, x);
        i = i + 1;
    }
    return 0;
}

# One timed row: `which` 0 is T0, 1 is T1.
fn row(name: cstring, which): i64 {
    var s: f64 = 0.0;
    var b = bench_new(name);
    bench_batch_start(b);
    var k = 0;
    while (k < 250) {
        var i = 0;
        while (i < 4096) {
            var x: f64 = load64(g_xs + i * 8);
            if (which == 0) {
                var r0: f64 = p9_t0_ln_gamma(x);
                s = s + r0;
            } else {
                var r1: f64 = p9_t1_ln_gamma(x);
                s = s + r1;
            }
            i = i + 1;
        }
        k = k + 1;
    }
    bench_batch_stop(b, 1024000);
    bench_report(b);
    if (s != s) { println("nan"); }
    return 0;
}

fn main(): i64 {
    alloc_init();
    g_xs = alloc(4096 * 8);
    fill(0.9, 1.1);
    row("T0 Rust Lanczos, x in (0.9, 1.1)", 0);
    row("T1 prototype,    x in (0.9, 1.1)", 1);
    fill(0.5, 10.0);
    row("T0 Rust Lanczos, x in (0.5, 10)", 0);
    row("T1 prototype,    x in (0.5, 10)", 1);
    fill(2.0, 8.0);
    row("T0 Rust Lanczos, x in [2, 8)", 0);
    row("T1 prototype,    x in [2, 8)", 1);
    fill(10.0, 1000000.0);
    row("T0 Rust Lanczos, x in [10, 1e6)", 0);
    row("T1 prototype,    x in [10, 1e6)", 1);
    fill(-20.0, -0.5);
    row("T0 Rust Lanczos, x in (-20, -0.5)", 0);
    row("T1 prototype,    x in (-20, -0.5)", 1);
    return 0;
}

var rc = main();
sys_exit_group(rc);
