# p9_gamma.bcyr — probe P9, gamma_inc: the cost of T0 and T1 (port plan §5 step 9d-2, §3.7).
#
# ns per (P, Q) call on 1,024 seeded pairs per region, cycled: x near a for small, middle and large shapes, small
# shapes with small x (T1's direct Q), and the upper tail. The sums keep every result live.
#   CYRIUS_ALLOW_ABSOLUTE_INCLUDES=1 cyrius bench scripts/probes/p9_gamma.bcyr

include "scripts/probes/p9_gamma_impl.cyr"

var g_rng = 0x2545F4914F6CDD1D;
var g_as = 0;
var g_xs = 0;

fn p9_unit(): f64 {
    var x = g_rng;
    x = x ^ (x >> 12);
    x = x ^ (x << 25);
    x = x ^ (x >> 27);
    g_rng = x;
    var top = (x * 0x2545F4914F6CDD1D) >> 11;
    var a: f64 = f64_from(top);
    var d: f64 = 9007199254740992.0;
    return a / d;
}

fn p9_logr(lo: f64, hi: f64): f64 {
    var l1: f64 = _km_cr_ln(lo);
    var l2: f64 = _km_cr_ln(hi);
    var w: f64 = l2 - l1;
    var u: f64 = p9_unit();
    var t: f64 = l1 + w * u;
    var r: f64 = _km_cr_exp(t);
    return r;
}

# 1,024 pairs: a log-uniform in [alo, ahi]; x = a + t·√a (t in [−3, 3]) when `near`, else log-uniform in [xlo, xhi].
fn fill(alo: f64, ahi: f64, near, xlo: f64, xhi: f64): i64 {
    var i = 0;
    while (i < 1024) {
        var a: f64 = p9_logr(alo, ahi);
        var x: f64 = 0.0;
        if (near == 1) {
            var t: f64 = -3.0 + 6.0 * p9_unit();
            var s: f64 = f64_sqrt(a);
            x = a + t * s;
            var fl: f64 = a * 0.001;
            if (x < fl) { x = fl; }
        } else {
            x = p9_logr(xlo, xhi);
        }
        store64(g_as + i * 8, a);
        store64(g_xs + i * 8, x);
        i = i + 1;
    }
    return 0;
}

# One timed row over `reps` passes: `which` 0 is T0, 1 is T1.
fn row(name: cstring, which, reps): i64 {
    var s: f64 = 0.0;
    var b = bench_new(name);
    bench_batch_start(b);
    var k = 0;
    while (k < reps) {
        var i = 0;
        while (i < 1024) {
            var a: f64 = load64(g_as + i * 8);
            var x: f64 = load64(g_xs + i * 8);
            if (which == 0) {
                var p0, q0 = p9_t0_gamma_inc(a, x);
                s = s + p0 + q0;
            } else {
                var p1, q1 = p9_t1_gamma_inc(a, x);
                s = s + p1 + q1;
            }
            i = i + 1;
        }
        k = k + 1;
    }
    bench_batch_stop(b, reps * 1024);
    bench_report(b);
    if (s != s) { println("nan"); }
    return 0;
}

fn main(): i64 {
    alloc_init();
    g_as = alloc(1024 * 8);
    g_xs = alloc(1024 * 8);
    fill(0.5, 10.0, 1, 0.0, 0.0);
    row("T0, a in [0.5, 10], x near a", 0, 200);
    row("T1, a in [0.5, 10], x near a", 1, 200);
    fill(10.0, 1000.0, 1, 0.0, 0.0);
    row("T0, a in [10, 1e3], x near a", 0, 50);
    row("T1, a in [10, 1e3], x near a", 1, 50);
    fill(1000.0, 100000.0, 1, 0.0, 0.0);
    row("T0, a in [1e3, 1e5], x near a", 0, 5);
    row("T1, a in [1e3, 1e5], x near a", 1, 5);
    fill(0.001, 1.0, 0, 0.0001, 1.1);
    row("T0, a in [1e-3, 1], x in [1e-4, 1.1]", 0, 200);
    row("T1, a in [1e-3, 1], x in [1e-4, 1.1]", 1, 200);
    fill(1.0, 1000.0, 0, 2000.0, 100000.0);
    row("T0, a in [1, 1e3], x in [2e3, 1e5]", 0, 200);
    row("T1, a in [1, 1e3], x in [2e3, 1e5]", 1, 200);
    return 0;
}

var rc = main();
sys_exit_group(rc);
