# p1_integers.cyr — M0 step 9, probe P1: integer semantics (port plan §5 step 9, D10).
#
# - SimpleRng: 10^6 xorshift64 draws from each seed, folded into a 64-bit FNV-1a digest of the draws' bits;
# - PmnU128, the prototype of D10's two-word u128: a 128 × 64-bit multiply with overflow detection (32-bit limbs, so
#   no partial product overflows a word) and a 128 / 64-bit divide (restoring division). factorial, permutations and
#   combinations are transcribed onto it in Rust's operation order.
#
# Prints `case <TAB> variant <TAB> type <TAB> bits` for scripts/probes/p0_compare.py, against the Rust twin
# scripts/probes/rust/src/bin/p1_integers.rs (the oracle's own functions):
#   cyrius build scripts/probes/p1_integers.cyr build/p1_integers && ./build/p1_integers > build/p1_cyrius.tsv

var g_rng = 0;
var g_hi = 0;
var g_lo = 0;
var g_ovf = 0;
var g_kind = 0;

# Write a C string to stdout.
fn put(s: cstring): i64 {
    print(s, strlen(s));
    return 0;
}

# One word line: the case built from a prefix, up to two hex arguments and a suffix.
fn show(pre: cstring, a, b, nargs, suf: cstring, word): i64 {
    put(pre);
    put("(");
    fmt_hex0x(a);
    if (nargs == 2) {
        put(",");
        fmt_hex0x(b);
    }
    put(")");
    put(suf);
    put("\tPmnU128\tu64\t");
    fmt_hex0x(word);
    println("");
    return 0;
}

# a < b as unsigned 64-bit words.
fn ult(a, b): i64 {
    if ((a ^ 0x8000000000000000) < (b ^ 0x8000000000000000)) { return 1; }
    return 0;
}

# SimpleRng::next_f64 on g_rng.
fn xs_next(): f64 {
    var x = g_rng;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    g_rng = x;
    var top = x >> 11;
    var a: f64 = f64_from(top);
    var two53: f64 = 9007199254740992.0;
    return a / two53;
}

# The FNV-1a digest of 10^6 draws from `seed`.
fn rng_digest(seed): i64 {
    g_rng = seed;
    if (g_rng == 0) { g_rng = 1; }
    var h = 0xcbf29ce484222325;
    var i = 0;
    while (i < 1000000) {
        var d: f64 = xs_next();
        var w = d;
        h = (h ^ w) * 0x100000001b3;
        i = i + 1;
    }
    return h;
}

# (hi, lo) × b → g_hi, g_lo; g_ovf = 1 when the product needs more than 128 bits. Limbs of 32 bits: each partial
# product fits a word, and each limb's sum of at most four 32-bit pieces stays below 2^35.
fn u128_mul_u64(hi, lo, b): i64 {
    var x0 = lo & 0xFFFFFFFF;
    var x1 = lo >> 32;
    var x2 = hi & 0xFFFFFFFF;
    var x3 = hi >> 32;
    var b0 = b & 0xFFFFFFFF;
    var b1 = b >> 32;
    var a0 = 0;
    var a1 = 0;
    var a2 = 0;
    var a3 = 0;
    var a4 = 0;
    var a5 = 0;
    var p = x0 * b0;
    a0 = a0 + (p & 0xFFFFFFFF);
    a1 = a1 + (p >> 32);
    p = x0 * b1;
    a1 = a1 + (p & 0xFFFFFFFF);
    a2 = a2 + (p >> 32);
    p = x1 * b0;
    a1 = a1 + (p & 0xFFFFFFFF);
    a2 = a2 + (p >> 32);
    p = x1 * b1;
    a2 = a2 + (p & 0xFFFFFFFF);
    a3 = a3 + (p >> 32);
    p = x2 * b0;
    a2 = a2 + (p & 0xFFFFFFFF);
    a3 = a3 + (p >> 32);
    p = x2 * b1;
    a3 = a3 + (p & 0xFFFFFFFF);
    a4 = a4 + (p >> 32);
    p = x3 * b0;
    a3 = a3 + (p & 0xFFFFFFFF);
    a4 = a4 + (p >> 32);
    p = x3 * b1;
    a4 = a4 + (p & 0xFFFFFFFF);
    a5 = a5 + (p >> 32);
    a1 = a1 + (a0 >> 32);
    a2 = a2 + (a1 >> 32);
    a3 = a3 + (a2 >> 32);
    a4 = a4 + (a3 >> 32);
    a5 = a5 + (a4 >> 32);
    g_lo = (a0 & 0xFFFFFFFF) | ((a1 & 0xFFFFFFFF) << 32);
    g_hi = (a2 & 0xFFFFFFFF) | ((a3 & 0xFFFFFFFF) << 32);
    g_ovf = 0;
    if ((a4 & 0xFFFFFFFF) != 0 || a5 != 0) { g_ovf = 1; }
    return 0;
}

# (hi, lo) / d → g_hi, g_lo, by restoring division over the 128 bits. The remainder stays below d < 2^64; a carry out
# of its top bit means it is already ≥ d.
fn u128_div_u64(hi, lo, d): i64 {
    var qhi = 0;
    var qlo = 0;
    var rem = 0;
    var i = 127;
    while (i >= 0) {
        var bit = 0;
        if (i >= 64) { bit = (hi >> (i - 64)) & 1; } else { bit = (lo >> i) & 1; }
        var top = rem >> 63;
        rem = (rem << 1) | bit;
        if (top == 1 || ult(rem, d) == 0) {
            rem = rem - d;
            if (i >= 64) { qhi = qhi | (1 << (i - 64)); } else { qlo = qlo | (1 << i); }
        }
        i = i - 1;
    }
    g_hi = qhi;
    g_lo = qlo;
    return 0;
}

# factorial(n) → g_kind (0 ok, 2 overflow), g_hi, g_lo, as rust-old/src/combinatorics.rs.
fn factorial(n): i64 {
    g_kind = 0;
    if (ult(34, n) == 1) {
        g_kind = 2;
        return 0;
    }
    var hi = 0;
    var lo = 1;
    var i = 2;
    while (ult(n, i) == 0) {
        u128_mul_u64(hi, lo, i);
        if (g_ovf == 1) {
            g_kind = 2;
            return 0;
        }
        hi = g_hi;
        lo = g_lo;
        i = i + 1;
    }
    g_hi = hi;
    g_lo = lo;
    return 0;
}

# permutations(n, r): n · (n − 1) · … · (n − r + 1), checked.
fn permutations(n, r): i64 {
    g_kind = 0;
    if (ult(n, r) == 1) {
        g_kind = 1;
        return 0;
    }
    var hi = 0;
    var lo = 1;
    var i = 0;
    while (ult(i, r) == 1) {
        u128_mul_u64(hi, lo, n - i);
        if (g_ovf == 1) {
            g_kind = 2;
            return 0;
        }
        hi = g_hi;
        lo = g_lo;
        i = i + 1;
    }
    g_hi = hi;
    g_lo = lo;
    return 0;
}

# combinations(n, r): with r = min(r, n − r), result · (n − i) / (i + 1) per step, checked.
fn combinations(n, r): i64 {
    g_kind = 0;
    if (ult(n, r) == 1) {
        g_kind = 1;
        return 0;
    }
    var k = r;
    if (ult(n - r, k) == 1) { k = n - r; }
    var hi = 0;
    var lo = 1;
    var i = 0;
    while (ult(i, k) == 1) {
        u128_mul_u64(hi, lo, n - i);
        if (g_ovf == 1) {
            g_kind = 2;
            return 0;
        }
        u128_div_u64(g_hi, g_lo, i + 1);
        hi = g_hi;
        lo = g_lo;
        i = i + 1;
    }
    g_hi = hi;
    g_lo = lo;
    return 0;
}

# The outcome lines of one call, as the Rust twin prints them.
fn report(pre: cstring, a, b, nargs): i64 {
    show(pre, a, b, nargs, ".kind", g_kind);
    if (g_kind == 0) {
        show(pre, a, b, nargs, ".hi", g_hi);
        show(pre, a, b, nargs, ".lo", g_lo);
    }
    return 0;
}

var g_rs[24];
var g_rs_n = 0;

# The twin's r grid for n: fixed values, n − 2, n − 1, n, n + 1 (saturating), sorted and deduplicated as unsigned.
fn rs_build(n): i64 {
    var v = &g_rs;
    var fixed = 0;
    store64(v + 0, 0);
    store64(v + 8, 1);
    store64(v + 16, 2);
    store64(v + 24, 3);
    store64(v + 32, 5);
    store64(v + 40, 10);
    store64(v + 48, 20);
    store64(v + 56, 33);
    store64(v + 64, 34);
    store64(v + 72, 35);
    store64(v + 80, 64);
    store64(v + 88, 65);
    store64(v + 96, 66);
    store64(v + 104, 67);
    var m2 = 0;
    if (ult(n, 2) == 0) { m2 = n - 2; }
    var m1 = 0;
    if (n != 0) { m1 = n - 1; }
    var p1 = n + 1;
    if (n == -1) { p1 = n; }
    store64(v + 112, m2);
    store64(v + 120, m1);
    store64(v + 128, n);
    store64(v + 136, p1);
    var cnt = 18;
    var i = 1;
    while (i < cnt) {
        var x = load64(v + i * 8);
        var j = i - 1;
        while (j >= 0 && ult(x, load64(v + j * 8)) == 1) {
            store64(v + (j + 1) * 8, load64(v + j * 8));
            j = j - 1;
        }
        store64(v + (j + 1) * 8, x);
        i = i + 1;
    }
    var out = 1;
    i = 1;
    while (i < cnt) {
        if (load64(v + i * 8) != load64(v + (out - 1) * 8)) {
            store64(v + out * 8, load64(v + i * 8));
            out = out + 1;
        }
        i = i + 1;
    }
    g_rs_n = out;
    return fixed;
}

# Entry point: every case in the twin's order.
fn main(): i64 {
    alloc_init();
    var seeds[40];
    store64(&seeds + 0, 1);
    store64(&seeds + 8, 42);
    store64(&seeds + 16, 0x8000000000000000);
    store64(&seeds + 24, -1);
    store64(&seeds + 32, 0x9e3779b97f4a7c15);
    var s = 0;
    while (s < 5) {
        var seed = load64(&seeds + s * 8);
        put("rng[");
        fmt_hex0x(seed);
        put("].digest1e6\txorshift64\tu64\t");
        fmt_hex0x(rng_digest(seed));
        println("");
        s = s + 1;
    }
    var n = 0;
    while (n <= 36) {
        factorial(n);
        report("factorial", n, 0, 1);
        n = n + 1;
    }
    var ns[432];
    var nn = 0;
    while (nn <= 40) {
        store64(&ns + nn * 8, nn);
        nn = nn + 1;
    }
    store64(&ns + 41 * 8, 60);
    store64(&ns + 42 * 8, 66);
    store64(&ns + 43 * 8, 100);
    store64(&ns + 44 * 8, 130);
    store64(&ns + 45 * 8, 131);
    store64(&ns + 46 * 8, 132);
    store64(&ns + 47 * 8, 133);
    store64(&ns + 48 * 8, 1000);
    store64(&ns + 49 * 8, 0x100000000);
    store64(&ns + 50 * 8, 0x100000001);
    store64(&ns + 51 * 8, 0x8000000000000000);
    store64(&ns + 52 * 8, -2);
    store64(&ns + 53 * 8, -1);
    var k = 0;
    while (k < 54) {
        var nv = load64(&ns + k * 8);
        rs_build(nv);
        var j = 0;
        while (j < g_rs_n) {
            var rv = load64(&g_rs + j * 8);
            permutations(nv, rv);
            report("permutations", nv, rv, 2);
            combinations(nv, rv);
            report("combinations", nv, rv, 2);
            j = j + 1;
        }
        k = k + 1;
    }
    return 0;
}

var rc = main();
sys_exit_group(rc);
