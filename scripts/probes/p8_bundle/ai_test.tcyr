# p8_bundle/ai_test.tcyr — probe P8's stand-in for pramana's own ai test. It names sandhi itself, so that only this
# file's compile carries it when sandhi is not in [deps] stdlib (the hybrid and outside layouts).
include "lib/sandhi.cyr"
include "src/p8_core.cyr"
include "src/p8_ai.cyr"

# The ai stand-in answers a POST to a closed port.
fn main(): i64 {
    alloc_init();
    var j = "{}";
    if (pmn_p8_ai_post(j, 2) != 1) { return 1; }
    return 0;
}

var rc = main();
sys_exit_group(rc);
