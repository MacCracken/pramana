# p9_beta.cyr — probe P9, beta_inc: accuracy rows for scripts/port-baseline/check.c (port plan §5 step 9d-3).
#
# Reads the Rust baseline's integer-shape rows (build/p9/beta_rust.txt, from scripts/port-baseline/main.rs's `beta`
# mode: §3.2's 4,000 rows, a, b in 1 … 60, x = k/2^20, with Rust 1.3.0's I and 1 − I) and prints, per row, Rust's,
# T0's and T1's I and 1 − I as `bref_i/set/variant a b x y value` rows (check.c's 320-bit reference). Then four
# seeded sets over ADR 009's domain, a and b in [1e-3, 1e5], T0 and T1 only. In every row the smaller of x and y is
# the exact one, and the other is its rounded complement, as a caller passes them.
#   bash scripts/probes/p9_beta.sh

include "scripts/probes/p9_beta_impl.cyr"

var g_rng = 0x9E3779B97F4A7C15;
var g_out = 0;

fn p9_unit(): f64 {
    var x = g_rng;
    x = x ^ (x >> 12);
    x = x ^ (x << 25);
    x = x ^ (x >> 27);
    g_rng = x;
    var top = (x * 0x2545F4914F6CDD1D) >> 11;
    var a: f64 = f64_from(top);
    var d: f64 = 9007199254740992.0;
    return a / d;
}

fn p9_logr(lo: f64, hi: f64): f64 {
    var l1: f64 = _km_cr_ln(lo);
    var l2: f64 = _km_cr_ln(hi);
    var w: f64 = l2 - l1;
    var u: f64 = p9_unit();
    var t: f64 = l1 + w * u;
    var r: f64 = _km_cr_exp(t);
    return r;
}

fn p9_hex64(sb, w): i64 {
    var i = 60;
    while (i >= 0) {
        var d = (w >> i) & 15;
        if (d < 10) { str_builder_putc(sb, 48 + d); } else { str_builder_putc(sb, 87 + d); }
        i = i - 4;
    }
    return 0;
}

fn p9_flush(): i64 {
    print(load64(g_out), load64(g_out + 8));
    store64(g_out + 8, 0);
    return 0;
}

# One row: `fname/set/variant a b x y value`.
fn p9_row(fname: cstring, set: cstring, variant: cstring, a: f64, b: f64, x: f64, y: f64, v: f64): i64 {
    str_builder_add_cstr(g_out, fname);
    str_builder_putc(g_out, 47);
    str_builder_add_cstr(g_out, set);
    str_builder_putc(g_out, 47);
    str_builder_add_cstr(g_out, variant);
    str_builder_putc(g_out, 32);
    p9_hex64(g_out, a);
    str_builder_putc(g_out, 32);
    p9_hex64(g_out, b);
    str_builder_putc(g_out, 32);
    p9_hex64(g_out, x);
    str_builder_putc(g_out, 32);
    p9_hex64(g_out, y);
    str_builder_putc(g_out, 32);
    p9_hex64(g_out, v);
    str_builder_putc(g_out, 10);
    if (load64(g_out + 8) > 1048576) { p9_flush(); }
    return 0;
}

# T0's and T1's I and 1 − I for one input, four consecutive rows (check.c reuses its reference across them).
fn p9_pair(set: cstring, a: f64, b: f64, x: f64, y: f64): i64 {
    var i0, c0 = p9_t0_beta_inc(a, b, x, y);
    var i1, c1 = p9_t1_beta_inc(a, b, x, y);
    p9_row("bref_i", set, "t0", a, b, x, y, i0);
    p9_row("bref_i", set, "t1", a, b, x, y, i1);
    p9_row("bref_c", set, "t0", a, b, x, y, c0);
    p9_row("bref_c", set, "t1", a, b, x, y, c1);
    return 0;
}

# A point t in (0, 1) as a caller passes it: (t, 1 − t) when t ≤ 1/2, else (1 − s, s) with s = 1 − t, the smaller
# exact and the larger its rounded complement.
fn p9_point(set: cstring, a: f64, b: f64, t: f64): i64 {
    if (t <= 0.0 || t >= 1.0) { return 0; }
    if (t <= 0.5) {
        var y: f64 = 1.0 - t;
        p9_pair(set, a, b, t, y);
        return 0;
    }
    var s: f64 = 1.0 - t;
    var x: f64 = 1.0 - s;
    p9_pair(set, a, b, x, s);
    return 0;
}

# A point given by its upper tail s = 1 − x in (0, 1/2].
fn p9_upper(set: cstring, a: f64, b: f64, s: f64): i64 {
    var x: f64 = 1.0 - s;
    p9_pair(set, a, b, x, s);
    return 0;
}

fn p9_parse_int(p, n): i64 {
    var v = 0;
    var i = 0;
    while (i < n) {
        v = v * 10 + (load8(p + i) - 48);
        i = i + 1;
    }
    return v;
}

fn p9_hexval(c): i64 {
    if (c >= 48 && c <= 57) { return c - 48; }
    return c - 87;
}

# §3.2's rows: `a b k p q`, decimal integers then two hex words.
fn p9_baseline(buf, n): i64 {
    var s = 0;
    var i = 0;
    var st[40];
    var ln[40];
    while (i < n) {
        if (load8(buf + i) == 10) {
            var line = buf + s;
            var len = i - s;
            var f = 0;
            var j = 0;
            var b0 = 0;
            while (j <= len && f < 5) {
                if (j == len || load8(line + j) == 32) {
                    store64(&st + f * 8, line + b0);
                    store64(&ln + f * 8, j - b0);
                    f = f + 1;
                    b0 = j + 1;
                }
                j = j + 1;
            }
            var ai = p9_parse_int(load64(&st), load64(&ln));
            var bi = p9_parse_int(load64(&st + 8), load64(&ln + 8));
            var k = p9_parse_int(load64(&st + 16), load64(&ln + 16));
            var pw = 0;
            var qw = 0;
            var q = 0;
            while (q < 16) {
                pw = (pw << 4) | p9_hexval(load8(load64(&st + 24) + q));
                qw = (qw << 4) | p9_hexval(load8(load64(&st + 32) + q));
                q = q + 1;
            }
            var a: f64 = f64_from(ai);
            var b: f64 = f64_from(bi);
            var kf: f64 = f64_from(k);
            var d: f64 = 1048576.0;
            var x: f64 = kf / d;
            var y: f64 = 1.0 - x;
            var pr: f64 = pw;
            var qr: f64 = qw;
            var i0, c0 = p9_t0_beta_inc(a, b, x, y);
            var i1, c1 = p9_t1_beta_inc(a, b, x, y);
            p9_row("bref_i", "base", "rust", a, b, x, y, pr);
            p9_row("bref_i", "base", "t0", a, b, x, y, i0);
            p9_row("bref_i", "base", "t1", a, b, x, y, i1);
            p9_row("bref_c", "base", "rust", a, b, x, y, qr);
            p9_row("bref_c", "base", "t0", a, b, x, y, c0);
            p9_row("bref_c", "base", "t1", a, b, x, y, c1);
            s = i + 1;
        }
        i = i + 1;
    }
    return 0;
}

fn main(): i64 {
    alloc_init();
    g_out = str_builder_new();
    var cap = 4194304;
    var buf = alloc(cap);
    var n = file_read_all("build/p9/beta_rust.txt", buf, cap);
    if (n <= 0) {
        var msg = "cannot read build/p9/beta_rust.txt\n";
        print(msg, strlen(msg));
        return 1;
    }
    p9_baseline(buf, n);
    var smin: f64 = 0.001;
    var smax: f64 = 100000.0;
    var i = 0;
    # x near the mean: x = μ + t·σ, t in [−5, 5].
    while (i < 20000) {
        var a1: f64 = p9_logr(smin, smax);
        var b1: f64 = p9_logr(smin, smax);
        var s1: f64 = a1 + b1;
        var mu: f64 = a1 / s1;
        var s11: f64 = s1 + 1.0;
        var v1: f64 = (a1 * b1) / (s1 * s1 * s11);
        var sd: f64 = f64_sqrt(v1);
        var t1: f64 = -5.0 + 10.0 * p9_unit();
        var x1: f64 = mu + t1 * sd;
        p9_point("near", a1, b1, x1);
        i = i + 1;
    }
    # The tails: x = μ·r (I small) or 1 − x = (1 − μ)·r (1 − I small), r log-uniform in [1e-10, 1/2].
    i = 0;
    while (i < 10000) {
        var a2: f64 = p9_logr(smin, smax);
        var b2: f64 = p9_logr(smin, smax);
        var s2: f64 = a2 + b2;
        var mu2: f64 = a2 / s2;
        var r2: f64 = p9_logr(0.0000000001, 0.5);
        var x2: f64 = mu2 * r2;
        p9_point("lower", a2, b2, x2);
        var a3: f64 = p9_logr(smin, smax);
        var b3: f64 = p9_logr(smin, smax);
        var s3: f64 = a3 + b3;
        var nu3: f64 = b3 / s3;
        var r3: f64 = p9_logr(0.0000000001, 0.5);
        var y3: f64 = nu3 * r3;
        p9_upper("upper", a3, b3, y3);
        i = i + 1;
    }
    # Small shapes: one shape in [1e-3, 1], the other over the whole range; x uniform, or in a tail.
    i = 0;
    while (i < 10000) {
        var a4: f64 = p9_logr(smin, 1.0);
        var b4: f64 = p9_logr(smin, smax);
        if (p9_unit() < 0.5) {
            var sw4: f64 = a4;
            a4 = b4;
            b4 = sw4;
        }
        var u4: f64 = p9_unit();
        var x4: f64 = p9_unit();
        if (u4 < 0.25) { x4 = p9_logr(0.0000000001, 0.5); }
        if (u4 > 0.75) {
            var y4: f64 = p9_logr(0.0000000001, 0.5);
            p9_upper("smalls", a4, b4, y4);
        } else {
            p9_point("smalls", a4, b4, x4);
        }
        i = i + 1;
    }
    # The switch: x = (a + 1)/(a + b + 2)·(1 ± δ), δ log-uniform in [1e-12, 1e-2].
    i = 0;
    while (i < 5000) {
        var a5: f64 = p9_logr(smin, smax);
        var b5: f64 = p9_logr(smin, smax);
        var a51: f64 = a5 + 1.0;
        var s5: f64 = a5 + b5 + 2.0;
        var sw5: f64 = a51 / s5;
        var d5: f64 = p9_logr(0.000000000001, 0.01);
        var x5: f64 = sw5 + sw5 * d5;
        if (p9_unit() < 0.5) { x5 = sw5 - sw5 * d5; }
        p9_point("switch", a5, b5, x5);
        i = i + 1;
    }
    p9_flush();
    return 0;
}

var rc = main();
sys_exit_group(rc);
