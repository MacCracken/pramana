# p7_json.cyr — M0 step 9, probe P7: JSON (port plan §5 step 9c, D5).
#
# Reads the Rust twin's documents (scripts/probes/rust/src/bin/p7_json.rs) and decodes each one as pramana's hand
# codecs would: bayan 1.11.1's value tree, serde's rules for the type, then the validating constructor's checks.
# Each document is read twice: as bayan parses it, and after `p7_lift`, a stand-in pre-pass for bayan's integer
# gaps. Each value read is written again with impetus's serde_json printer (fmtf.cyr) and with bayan's Grisu2, and
# both texts are read back. Then the printers are compared on the twin's doubles.
#   CYRIUS_ALLOW_ABSOLUTE_INCLUDES=1 cyrius build scripts/probes/p7_json.cyr build/p7_json
#   ./build/p7_json > build/p7_cyrius.tsv
# It reads build/p7_rust_corpus.tsv and build/p7_rust_floats.tsv. impetus's fmtf.cyr is included from its repo by
# absolute path, which the compiler refuses unless allowed. Output rows:
#   D id type verdict-as-parsed verdict-lifted tokens fmtf-text grisu-text round-trips tokens-as-parsed
#   F name count, and FX kind bits expected got for the first mismatches of each printer.

# fmtf.cyr takes an f64's bits from its project's mathx.cyr.
fn _im_bits(x): i64 {
    return x;
}

include "/home/macro/Repos/impetus/src/fmtf.cyr"

const P7_OK = 0;
const P7_ERR_DESERIALIZE = 1;
const P7_ERR_INVALID_PARAMETER = 2;
const P7_ERR_INVALID_SAMPLE = 3;
const P7_ERR_DIMENSION_MISMATCH = 4;

var g_lift = 0;
var g_grisu = 0;
var g_al = 0;
var g_lift_buf = 0;
var g_lift_cap = 0;
var g_sb = 0;
var g_names = 0;

fn err_name(c): cstring {
    if (c == P7_OK) { return "ok"; }
    if (c == P7_ERR_DESERIALIZE) { return "DESERIALIZE"; }
    if (c == P7_ERR_INVALID_PARAMETER) { return "INVALID_PARAMETER"; }
    if (c == P7_ERR_INVALID_SAMPLE) { return "INVALID_SAMPLE"; }
    return "DIMENSION_MISMATCH";
}

# ── small helpers ─────────────────────────────────────────────────────────────────

fn sb_ptr(sb): i64 {
    return load64(sb);
}

fn sb_len(sb): i64 {
    return load64(sb + 8);
}

fn sb_reset(sb): i64 {
    store64(sb + 8, 0);
    return 0;
}

fn sb_bytes(sb, p, n): i64 {
    var i = 0;
    while (i < n) {
        str_builder_putc(sb, load8(p + i));
        i = i + 1;
    }
    return 0;
}

fn mem_eq(a, an, b, bn): i64 {
    if (an != bn) { return 0; }
    var i = 0;
    while (i < an) {
        if (load8(a + i) != load8(b + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn cstr_eq(p, n, s: cstring): i64 {
    return mem_eq(p, n, s, strlen(s));
}

# Copies n bytes into fresh storage (the probe's decoded values live on the bump heap).
fn dup_bytes(p, n): i64 {
    var q = alloc(n + 1);
    memcpy(q, p, n);
    store8(q + n, 0);
    return q;
}

# The decimal of n read as unsigned into buf; its length.
fn dec_u64(n, buf): i64 {
    var tmp[24];
    var k = 0;
    var x = n;
    if (x == 0) {
        store8(buf, 48);
        return 1;
    }
    while (x != 0) {
        var q = (x >> 1) / 5;
        var r = x - q * 10;
        store8(&tmp + k, 48 + r);
        k = k + 1;
        x = q;
    }
    var i = 0;
    while (i < k) {
        store8(buf + i, load8(&tmp + k - 1 - i));
        i = i + 1;
    }
    return k;
}

fn sb_u64(sb, n): i64 {
    var buf[24];
    var k = dec_u64(n, &buf);
    sb_bytes(sb, &buf, k);
    return 0;
}

fn sb_hex(sb, p, n): i64 {
    var i = 0;
    while (i < n) {
        var c = load8(p + i);
        var hi = c >> 4;
        var lo = c & 15;
        if (hi < 10) { str_builder_putc(sb, 48 + hi); } else { str_builder_putc(sb, 87 + hi); }
        if (lo < 10) { str_builder_putc(sb, 48 + lo); } else { str_builder_putc(sb, 87 + lo); }
        i = i + 1;
    }
    return 0;
}

fn sb_hex64(sb, w): i64 {
    var i = 60;
    while (i >= 0) {
        var d = (w >> i) & 15;
        if (d < 10) { str_builder_putc(sb, 48 + d); } else { str_builder_putc(sb, 87 + d); }
        i = i - 4;
    }
    return 0;
}

fn hexval(c): i64 {
    if (c >= 48 && c <= 57) { return c - 48; }
    return c - 87;
}

# Decodes n hex digits at p into fresh storage; returns the pointer (n / 2 bytes).
fn unhex(p, n): i64 {
    var q = alloc(n / 2 + 1);
    var i = 0;
    while (i < n / 2) {
        store8(q + i, hexval(load8(p + 2 * i)) * 16 + hexval(load8(p + 2 * i + 1)));
        i = i + 1;
    }
    return q;
}

fn parse_hex64(p, n): i64 {
    var w = 0;
    var i = 0;
    while (i < n) {
        w = (w << 4) | hexval(load8(p + i));
        i = i + 1;
    }
    return w;
}

fn put_sb(sb): i64 {
    print(sb_ptr(sb), sb_len(sb));
    return 0;
}

fn put(s: cstring): i64 {
    print(s, strlen(s));
    return 0;
}

# An unsigned u64 to the nearest f64 (round to odd on the halved value, then double).
fn u64_to_f64(x): f64 {
    if (x >= 0) {
        var a: f64 = f64_from(x);
        return a;
    }
    var h = (x >> 1) | (x & 1);
    var b: f64 = f64_from(h);
    return b * 2.0;
}

fn finite_bits(b): i64 {
    if (((b >> 52) & 0x7FF) == 0x7FF) { return 0; }
    return 1;
}

# ── the stand-in pre-pass ───────────────────────────────────────────────────────────

# 1 when the integer digits p[0, n) (no leading zeros) are at most the bound's.
fn digits_le(p, n, bound: cstring): i64 {
    var bn = strlen(bound);
    if (n < bn) { return 1; }
    if (n > bn) { return 0; }
    var i = 0;
    while (i < n) {
        var a = load8(p + i);
        var b = load8(bound + i);
        if (a < b) { return 1; }
        if (a > b) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn is_digit(c): i64 {
    if (c >= 48 && c <= 57) { return 1; }
    return 0;
}

fn is_num_byte(c): i64 {
    if (is_digit(c) == 1) { return 1; }
    if (c == 46 || c == 101 || c == 69 || c == 43 || c == 45) { return 1; }
    return 0;
}

# STAND-IN for bayan's integer gaps (its open issues 2026-11-09 i64-max and 2026-11-11 negative zero). Rewrites
# src[0, n) into dst so that bayan's tree reads every number as serde_json does:
# - a negative integer, `-0` included, becomes a float (`-1.0`, `-0.0`): serde_json reads `-0` as −0.0 and refuses
#   it for a u64, and an f64 field reads the same value;
# - an integer in 2^63 .. 2^64 − 1 becomes the negative integer with its bits, which nothing else now produces, so a
#   u64 reader takes it back exactly and an f64 reader rounds it as unsigned;
# - an integer beyond that becomes a float, which an f64 field reads correctly rounded and a u64 field refuses.
# Strings are copied unchanged, except that a raw byte below 0x20 refuses the document, as serde_json does anywhere
# (bayan's issue 2026-11-11 raw control bytes). Returns the new length, -1 for a refusal, -2 when dst is too small
# (cap = 2n + 32 always suffices).
fn p7_lift(src, n, dst, cap): i64 {
    var i = 0;
    var o = 0;
    while (i < n) {
        if (o + 24 > cap) { return 0 - 2; }
        var c = load8(src + i);
        if (c == 34) {
            store8(dst + o, c);
            o = o + 1;
            i = i + 1;
            var open = 1;
            while (i < n && open == 1) {
                if (o + 2 > cap) { return 0 - 2; }
                var s = load8(src + i);
                if (s < 32) { return 0 - 1; }
                store8(dst + o, s);
                o = o + 1;
                i = i + 1;
                if (s == 92 && i < n) {
                    var e = load8(src + i);
                    if (e < 32) { return 0 - 1; }
                    store8(dst + o, e);
                    o = o + 1;
                    i = i + 1;
                } elif (s == 34) {
                    open = 0;
                }
            }
        } elif (c == 45 || is_digit(c) == 1) {
            var st = i;
            var neg = 0;
            if (c == 45) {
                neg = 1;
                i = i + 1;
            }
            var ds = i;
            while (i < n && is_digit(load8(src + i)) == 1) { i = i + 1; }
            var de = i;
            var other = 0;
            while (i < n && is_num_byte(load8(src + i)) == 1) {
                other = 1;
                i = i + 1;
            }
            var len = i - st;
            var nd = de - ds;
            var plain = 1;
            if (other == 1 || nd == 0) { plain = 0; }
            if (nd > 1 && load8(src + ds) == 48) { plain = 0; }
            if (o + len + 24 > cap) { return 0 - 2; }
            if (plain == 0) {
                memcpy(dst + o, src + st, len);
                o = o + len;
            } elif (neg == 1) {
                memcpy(dst + o, src + st, len);
                o = o + len;
                store8(dst + o, 46);
                store8(dst + o + 1, 48);
                o = o + 2;
            } elif (digits_le(src + ds, nd, "9223372036854775807") == 1) {
                memcpy(dst + o, src + st, len);
                o = o + len;
            } elif (digits_le(src + ds, nd, "18446744073709551615") == 1) {
                var v = 0;
                var k = ds;
                while (k < de) {
                    v = v * 10 + (load8(src + k) - 48);
                    k = k + 1;
                }
                store8(dst + o, 45);
                o = o + 1;
                o = o + dec_u64(0 - v, dst + o);
            } else {
                memcpy(dst + o, src + st, len);
                o = o + len;
                store8(dst + o, 46);
                store8(dst + o + 1, 48);
                o = o + 2;
            }
        } else {
            store8(dst + o, c);
            o = o + 1;
            i = i + 1;
        }
    }
    return o;
}

# ── readers: serde's rules over bayan's tree ─────────────────────────────────────────

# An f64 field: serde reads any JSON number, refusing one past f64's range (a non-finite node).
fn rd_f64(v, out): i64 {
    if (v == 0) { return 0; }
    var t = bayan_json_v_tag(v);
    if (t == JTAG_FLOAT) {
        var b = load64(v + 8);
        if (finite_bits(b) == 0) { return 0; }
        store64(out, b);
        return 1;
    }
    if (t == JTAG_INT) {
        var n = bayan_json_v_int(v);
        if (g_lift == 1 && n < 0) {
            var x: f64 = u64_to_f64(n);
            store64(out, x);
            return 1;
        }
        var y: f64 = f64_from(n);
        store64(out, y);
        return 1;
    }
    return 0;
}

# A u64 or usize field: a JSON integer in range; a float, even `1.0`, refuses.
fn rd_u64(v, out): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_tag(v) != JTAG_INT) { return 0; }
    var n = bayan_json_v_int(v);
    if (n < 0 && g_lift == 0) { return 0; }
    store64(out, n);
    return 1;
}

fn rd_bool(v, out): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_tag(v) != JTAG_BOOL) { return 0; }
    store64(out, bayan_json_v_bool(v));
    return 1;
}

# 1 when the next `k` bytes after p[i] are continuation bytes, the first in [lo, hi].
fn utf8_cont(p, i, n, k, lo, hi): i64 {
    if (i + k >= n) { return 0; }
    var c1 = load8(p + i + 1);
    if (c1 < lo || c1 > hi) { return 0; }
    var j = 2;
    while (j <= k) {
        var c = load8(p + i + j);
        if (c < 0x80 || c > 0xBF) { return 0; }
        j = j + 1;
    }
    return 1;
}

# 1 when p[0, n) is UTF-8 (no overlong forms, no surrogates, nothing past U+10FFFF).
fn utf8_ok(p, n): i64 {
    var i = 0;
    while (i < n) {
        var c = load8(p + i);
        var k = 0 - 1;
        var lo = 0x80;
        var hi = 0xBF;
        if (c < 0x80) { k = 0; }
        elif (c >= 0xC2 && c <= 0xDF) { k = 1; }
        elif (c == 0xE0) { k = 2; lo = 0xA0; }
        elif ((c >= 0xE1 && c <= 0xEC) || c == 0xEE || c == 0xEF) { k = 2; }
        elif (c == 0xED) { k = 2; hi = 0x9F; }
        elif (c == 0xF0) { k = 3; lo = 0x90; }
        elif (c >= 0xF1 && c <= 0xF3) { k = 3; }
        elif (c == 0xF4) { k = 3; hi = 0x8F; }
        if (k < 0) { return 0; }
        if (k > 0 && utf8_cont(p, i, n, k, lo, hi) == 0) { return 0; }
        i = i + k + 1;
    }
    return 1;
}

# A String field: a JSON string whose bytes are UTF-8, copied out. out: the pointer, then the length.
fn rd_str(v, out): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_tag(v) != JTAG_STR) { return 0; }
    var s = bayan_json_v_str(v);
    var p = load64(s);
    var n = load64(s + 8);
    if (utf8_ok(p, n) == 0) { return 0; }
    store64(out, dup_bytes(p, n));
    store64(out + 8, n);
    return 1;
}

# A Vec<f64>: out gets the pointer, then the count.
fn rd_vec_f64(v, out): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_tag(v) != JTAG_ARR) { return 0; }
    var n = bayan_json_v_arr_len(v);
    var q = alloc(n * 8 + 8);
    var i = 0;
    while (i < n) {
        if (rd_f64(bayan_json_v_arr_get(v, i), q + i * 8) == 0) { return 0; }
        i = i + 1;
    }
    store64(out, q);
    store64(out + 8, n);
    return 1;
}

fn rd_vec_u64(v, out): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_tag(v) != JTAG_ARR) { return 0; }
    var n = bayan_json_v_arr_len(v);
    var q = alloc(n * 8 + 8);
    var i = 0;
    while (i < n) {
        if (rd_u64(bayan_json_v_arr_get(v, i), q + i * 8) == 0) { return 0; }
        i = i + 1;
    }
    store64(out, q);
    store64(out + 8, n);
    return 1;
}

# A Vec<Vec<f64>>, possibly ragged: out gets a block [rows, then (pointer, count) per row].
fn rd_mat(v, out): i64 {
    if (v == 0) { return 0; }
    if (bayan_json_v_tag(v) != JTAG_ARR) { return 0; }
    var r = bayan_json_v_arr_len(v);
    var m = alloc(8 + r * 16);
    store64(m, r);
    var i = 0;
    while (i < r) {
        if (rd_vec_f64(bayan_json_v_arr_get(v, i), m + 8 + i * 16) == 0) { return 0; }
        i = i + 1;
    }
    store64(out, m);
    return 1;
}

fn p7_mat_rows(m): i64 {
    return load64(m);
}

fn p7_mat_row(m, i): i64 {
    return load64(m + 8 + i * 16);
}

fn p7_mat_cols(m, i): i64 {
    return load64(m + 16 + i * 16);
}

# The names table: nf C strings for a type's fields, 8 bytes apart.
fn names(a: cstring, b: cstring, c: cstring, d: cstring, e: cstring, f: cstring): i64 {
    var t = alloc(48);
    store64(t, a);
    store64(t + 8, b);
    store64(t + 16, c);
    store64(t + 24, d);
    store64(t + 32, e);
    store64(t + 40, f);
    return t;
}

# serde's struct rules: an object's members match the field names (an unknown one is skipped, a known one twice
# refuses, a missing one refuses); an array is the sequence form, exactly nf values in field order. 1 or 0.
fn rd_struct(v, nm, nf, slots): i64 {
    var i = 0;
    while (i < nf) {
        store64(slots + i * 8, 0);
        i = i + 1;
    }
    if (v == 0) { return 0; }
    var t = bayan_json_v_tag(v);
    if (t == JTAG_ARR) {
        if (bayan_json_v_arr_len(v) != nf) { return 0; }
        i = 0;
        while (i < nf) {
            store64(slots + i * 8, bayan_json_v_arr_get(v, i));
            i = i + 1;
        }
        return 1;
    }
    if (t != JTAG_OBJ) { return 0; }
    var m = bayan_json_v_obj_len(v);
    var k = 0;
    while (k < m) {
        var key = bayan_json_v_obj_key(v, k);
        var kp = load64(key);
        var kn = load64(key + 8);
        var j = 0;
        while (j < nf) {
            if (cstr_eq(kp, kn, load64(nm + j * 8)) == 1) {
                if (load64(slots + j * 8) != 0) { return 0; }
                store64(slots + j * 8, bayan_json_v_obj_val(v, k));
            }
            j = j + 1;
        }
        k = k + 1;
    }
    i = 0;
    while (i < nf) {
        if (load64(slots + i * 8) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

fn slot(s, i): i64 {
    return load64(s + i * 8);
}

# ── the nine types ───────────────────────────────────────────────────────────────────
# Each object is a word array: normal [mean, sd]; binomial [n, p]; rng [state]; kde [data, n, bw, kernel];
# error [variant, msg, len]; test [name, len, stat, p, df, alpha, reject]; markov [mat, state];
# mvn [d, mean, cov, chol, log_det]; hist [edges, ne, counts, nc, total].

fn dec_normal(v, o): i64 {
    var s[16];
    if (rd_struct(v, load64(g_names), 2, &s) == 0) { return P7_ERR_DESERIALIZE; }
    if (rd_f64(slot(&s, 0), o) == 0) { return P7_ERR_DESERIALIZE; }
    if (rd_f64(slot(&s, 1), o + 8) == 0) { return P7_ERR_DESERIALIZE; }
    var sd: f64 = load64(o + 8);
    if (finite_bits(load64(o)) == 0) { return P7_ERR_INVALID_PARAMETER; }
    if (finite_bits(load64(o + 8)) == 0 || (sd > 0.0) == 0) { return P7_ERR_INVALID_PARAMETER; }
    return P7_OK;
}

fn dec_binomial(v, o): i64 {
    var s[16];
    if (rd_struct(v, load64(g_names + 8), 2, &s) == 0) { return P7_ERR_DESERIALIZE; }
    if (rd_u64(slot(&s, 0), o) == 0) { return P7_ERR_DESERIALIZE; }
    if (rd_f64(slot(&s, 1), o + 8) == 0) { return P7_ERR_DESERIALIZE; }
    if (load64(o) == 0) { return P7_ERR_INVALID_PARAMETER; }
    var p: f64 = load64(o + 8);
    if ((p >= 0.0) == 0 || (p <= 1.0) == 0) { return P7_ERR_INVALID_PARAMETER; }
    return P7_OK;
}

fn dec_rng(v, o): i64 {
    var s[8];
    if (rd_struct(v, load64(g_names + 16), 1, &s) == 0) { return P7_ERR_DESERIALIZE; }
    if (rd_u64(slot(&s, 0), o) == 0) { return P7_ERR_DESERIALIZE; }
    if (load64(o) == 0) { store64(o, 1); }
    return P7_OK;
}

var g_kernels = 0;

# A unit variant: "Name", or the map form {"Name": null}. The index, or -1.
fn rd_kernel(v): i64 {
    if (v == 0) { return 0 - 1; }
    var t = bayan_json_v_tag(v);
    var p = 0;
    var n = 0;
    if (t == JTAG_STR) {
        var s = bayan_json_v_str(v);
        p = load64(s);
        n = load64(s + 8);
    } elif (t == JTAG_OBJ) {
        if (bayan_json_v_obj_len(v) != 1) { return 0 - 1; }
        if (bayan_json_v_tag(bayan_json_v_obj_val(v, 0)) != JTAG_NULL) { return 0 - 1; }
        var key = bayan_json_v_obj_key(v, 0);
        p = load64(key);
        n = load64(key + 8);
    } else {
        return 0 - 1;
    }
    var i = 0;
    while (i < 4) {
        if (cstr_eq(p, n, load64(g_kernels + i * 8)) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn dec_kde(v, o): i64 {
    var s[24];
    if (rd_struct(v, load64(g_names + 24), 3, &s) == 0) { return P7_ERR_DESERIALIZE; }
    if (rd_vec_f64(slot(&s, 0), o) == 0) { return P7_ERR_DESERIALIZE; }
    if (rd_f64(slot(&s, 1), o + 16) == 0) { return P7_ERR_DESERIALIZE; }
    var k = rd_kernel(slot(&s, 2));
    if (k < 0) { return P7_ERR_DESERIALIZE; }
    store64(o + 24, k);
    if (load64(o + 8) == 0) { return P7_ERR_INVALID_SAMPLE; }
    var bw: f64 = load64(o + 16);
    if ((bw > 0.0) == 0) { return P7_ERR_INVALID_PARAMETER; }
    return P7_OK;
}

var g_variants = 0;

# The newtype-variant enum: exactly {"Variant": "message"}.
fn dec_error(v, o): i64 {
    if (v == 0 || bayan_json_v_tag(v) != JTAG_OBJ) { return P7_ERR_DESERIALIZE; }
    if (bayan_json_v_obj_len(v) != 1) { return P7_ERR_DESERIALIZE; }
    var key = bayan_json_v_obj_key(v, 0);
    var i = 0;
    var found = 0 - 1;
    while (i < 5) {
        if (cstr_eq(load64(key), load64(key + 8), load64(g_variants + i * 8)) == 1) { found = i; }
        i = i + 1;
    }
    if (found < 0) { return P7_ERR_DESERIALIZE; }
    store64(o, found);
    if (rd_str(bayan_json_v_obj_val(v, 0), o + 8) == 0) { return P7_ERR_DESERIALIZE; }
    return P7_OK;
}

fn dec_test(v, o): i64 {
    var s[48];
    if (rd_struct(v, load64(g_names + 40), 6, &s) == 0) { return P7_ERR_DESERIALIZE; }
    if (rd_str(slot(&s, 0), o) == 0) { return P7_ERR_DESERIALIZE; }
    var i = 1;
    while (i < 5) {
        if (rd_f64(slot(&s, i), o + 8 + i * 8) == 0) { return P7_ERR_DESERIALIZE; }
        i = i + 1;
    }
    if (rd_bool(slot(&s, 5), o + 48) == 0) { return P7_ERR_DESERIALIZE; }
    return P7_OK;
}

fn dec_markov(v, o): i64 {
    var s[16];
    if (rd_struct(v, load64(g_names + 48), 2, &s) == 0) { return P7_ERR_DESERIALIZE; }
    if (rd_mat(slot(&s, 0), o) == 0) { return P7_ERR_DESERIALIZE; }
    if (rd_u64(slot(&s, 1), o + 8) == 0) { return P7_ERR_DESERIALIZE; }
    var m = load64(o);
    var n = p7_mat_rows(m);
    if (n == 0) { return P7_ERR_INVALID_PARAMETER; }
    var i = 0;
    while (i < n) {
        if (p7_mat_cols(m, i) != n) { return P7_ERR_INVALID_PARAMETER; }
        var row = p7_mat_row(m, i);
        var sum: f64 = -0.0;
        var j = 0;
        while (j < n) {
            var x: f64 = load64(row + j * 8);
            if (x < 0.0) { return P7_ERR_INVALID_PARAMETER; }
            sum = sum + x;
            j = j + 1;
        }
        var dev: f64 = f64_abs(sum - 1.0);
        if (dev > 0.000001) { return P7_ERR_INVALID_PARAMETER; }
        i = i + 1;
    }
    var st = load64(o + 8);
    if (st < 0 || st >= n) { return P7_ERR_INVALID_PARAMETER; }
    return P7_OK;
}

# MultivariateNormal: only mean and covariance are read (serde's repr); the cached factor is recomputed, here with
# hisab 1.4.0's Cholesky as transcribed (port plan §8.2) and the sum of ln L_ii from −0.0, doubled.
fn dec_mvn(v, o): i64 {
    var s[16];
    if (rd_struct(v, load64(g_names + 56), 2, &s) == 0) { return P7_ERR_DESERIALIZE; }
    var mv[16];
    if (rd_vec_f64(slot(&s, 0), &mv) == 0) { return P7_ERR_DESERIALIZE; }
    var cm = 0;
    if (rd_mat(slot(&s, 1), &cm) == 0) { return P7_ERR_DESERIALIZE; }
    var d = load64(&mv + 8);
    store64(o, d);
    store64(o + 8, load64(&mv));
    store64(o + 16, cm);
    if (d == 0) { return P7_ERR_INVALID_PARAMETER; }
    if (p7_mat_rows(cm) != d) { return P7_ERR_DIMENSION_MISMATCH; }
    var i = 0;
    while (i < d) {
        if (p7_mat_cols(cm, i) != d) { return P7_ERR_DIMENSION_MISMATCH; }
        i = i + 1;
    }
    i = 0;
    while (i < d) {
        var j = i + 1;
        while (j < d) {
            var aij: f64 = load64(p7_mat_row(cm, i) + j * 8);
            var aji: f64 = load64(p7_mat_row(cm, j) + i * 8);
            var sc: f64 = f64_abs(aij);
            var b: f64 = f64_abs(aji);
            if (b > sc) { sc = b; }
            var tiny: f64 = 0.0;
            store64(&tiny, 0x0010000000000000);
            if (tiny > sc) { sc = tiny; }
            var diff: f64 = f64_abs(aij - aji);
            var tol: f64 = 0.0000000001 * sc;
            if (diff > tol) { return P7_ERR_INVALID_PARAMETER; }
            j = j + 1;
        }
        i = i + 1;
    }
    var l = alloc(d * d * 8 + 8);
    i = 0;
    while (i < d * d) {
        store64(l + i * 8, 0);
        i = i + 1;
    }
    i = 0;
    while (i < d) {
        var j = 0;
        while (j <= i) {
            var sum: f64 = load64(p7_mat_row(cm, i) + j * 8);
            var k = 0;
            while (k < j) {
                var lik: f64 = load64(l + (i * d + k) * 8);
                var ljk: f64 = load64(l + (j * d + k) * 8);
                var pr: f64 = lik * ljk;
                sum = sum - pr;
                k = k + 1;
            }
            if (i == j) {
                if (sum <= 0.0) { return P7_ERR_INVALID_PARAMETER; }
                var r: f64 = f64_sqrt(sum);
                store64(l + (i * d + j) * 8, r);
            } else {
                var ljj: f64 = load64(l + (j * d + j) * 8);
                var q: f64 = sum / ljj;
                store64(l + (i * d + j) * 8, q);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    var ls: f64 = -0.0;
    i = 0;
    while (i < d) {
        var lii: f64 = load64(l + (i * d + i) * 8);
        var ln: f64 = f64_ln(lii);
        ls = ls + ln;
        i = i + 1;
    }
    var ld: f64 = ls * 2.0;
    if (finite_bits(ld) == 0) { return P7_ERR_INVALID_PARAMETER; }
    store64(o + 24, l);
    store64(o + 32, ld);
    return P7_OK;
}

fn dec_hist(v, o): i64 {
    var s[24];
    if (rd_struct(v, load64(g_names + 64), 3, &s) == 0) { return P7_ERR_DESERIALIZE; }
    if (rd_vec_f64(slot(&s, 0), o) == 0) { return P7_ERR_DESERIALIZE; }
    if (rd_vec_u64(slot(&s, 1), o + 16) == 0) { return P7_ERR_DESERIALIZE; }
    if (rd_u64(slot(&s, 2), o + 32) == 0) { return P7_ERR_DESERIALIZE; }
    return P7_OK;
}

# Parses buf[0, n) (through p7_lift when g_lift is 1) and decodes it as type ty into o: P7_OK or an error code.
fn decode(ty, buf, n, o): i64 {
    var src = buf;
    var len = n;
    if (g_lift == 1) {
        var m = p7_lift(buf, n, g_lift_buf, g_lift_cap);
        if (m < 0) { return P7_ERR_DESERIALIZE; }
        src = g_lift_buf;
        len = m;
    }
    reset_via(g_al);
    var v = bayan_json_v_parse_buf_a(g_al, src, len);
    if (v == 0) { return P7_ERR_DESERIALIZE; }
    if (ty == 0) { return dec_normal(v, o); }
    if (ty == 1) { return dec_binomial(v, o); }
    if (ty == 2) { return dec_rng(v, o); }
    if (ty == 3) { return dec_kde(v, o); }
    if (ty == 4) { return dec_error(v, o); }
    if (ty == 5) { return dec_test(v, o); }
    if (ty == 6) { return dec_markov(v, o); }
    if (ty == 7) { return dec_mvn(v, o); }
    return dec_hist(v, o);
}

# ── writers: serde_json's compact text ───────────────────────────────────────────────

fn jw_f64(sb, b): i64 {
    if (g_grisu == 1) {
        var buf[40];
        var n = bayan_f64_to_json(b, &buf);
        sb_bytes(sb, &buf, n);
        return 0;
    }
    var x: f64 = b;
    im_fmt_f64_json(sb, x);
    return 0;
}

fn jw_key(sb, name: cstring, first): i64 {
    if (first == 0) { str_builder_putc(sb, 44); }
    str_builder_putc(sb, 34);
    str_builder_add_cstr(sb, name);
    str_builder_putc(sb, 34);
    str_builder_putc(sb, 58);
    return 0;
}

fn jw_str(sb, p, n): i64 {
    var t[16];
    store64(&t, p);
    store64(&t + 8, n);
    str_builder_add_json_str(sb, &t);
    return 0;
}

fn jw_vec_f64(sb, p, n): i64 {
    str_builder_putc(sb, 91);
    var i = 0;
    while (i < n) {
        if (i > 0) { str_builder_putc(sb, 44); }
        jw_f64(sb, load64(p + i * 8));
        i = i + 1;
    }
    str_builder_putc(sb, 93);
    return 0;
}

fn jw_vec_u64(sb, p, n): i64 {
    str_builder_putc(sb, 91);
    var i = 0;
    while (i < n) {
        if (i > 0) { str_builder_putc(sb, 44); }
        sb_u64(sb, load64(p + i * 8));
        i = i + 1;
    }
    str_builder_putc(sb, 93);
    return 0;
}

fn jw_mat(sb, m): i64 {
    str_builder_putc(sb, 91);
    var i = 0;
    while (i < p7_mat_rows(m)) {
        if (i > 0) { str_builder_putc(sb, 44); }
        jw_vec_f64(sb, p7_mat_row(m, i), p7_mat_cols(m, i));
        i = i + 1;
    }
    str_builder_putc(sb, 93);
    return 0;
}

fn jw_bool(sb, b): i64 {
    if (b == 1) {
        str_builder_add_cstr(sb, "true");
    } else {
        str_builder_add_cstr(sb, "false");
    }
    return 0;
}

fn encode(ty, o, sb): i64 {
    str_builder_putc(sb, 123);
    if (ty == 0) {
        jw_key(sb, "mean", 1);
        jw_f64(sb, load64(o));
        jw_key(sb, "std_dev", 0);
        jw_f64(sb, load64(o + 8));
    } elif (ty == 1) {
        jw_key(sb, "n", 1);
        sb_u64(sb, load64(o));
        jw_key(sb, "p", 0);
        jw_f64(sb, load64(o + 8));
    } elif (ty == 2) {
        jw_key(sb, "state", 1);
        sb_u64(sb, load64(o));
    } elif (ty == 3) {
        jw_key(sb, "data", 1);
        jw_vec_f64(sb, load64(o), load64(o + 8));
        jw_key(sb, "bandwidth", 0);
        jw_f64(sb, load64(o + 16));
        jw_key(sb, "kernel", 0);
        var kn = load64(g_kernels + load64(o + 24) * 8);
        jw_str(sb, kn, strlen(kn));
    } elif (ty == 4) {
        jw_key(sb, load64(g_variants + load64(o) * 8), 1);
        jw_str(sb, load64(o + 8), load64(o + 16));
    } elif (ty == 5) {
        jw_key(sb, "test_name", 1);
        jw_str(sb, load64(o), load64(o + 8));
        jw_key(sb, "statistic", 0);
        jw_f64(sb, load64(o + 16));
        jw_key(sb, "p_value", 0);
        jw_f64(sb, load64(o + 24));
        jw_key(sb, "degrees_of_freedom", 0);
        jw_f64(sb, load64(o + 32));
        jw_key(sb, "reject_at_alpha", 0);
        jw_f64(sb, load64(o + 40));
        jw_key(sb, "reject", 0);
        jw_bool(sb, load64(o + 48));
    } elif (ty == 6) {
        jw_key(sb, "transition_matrix", 1);
        jw_mat(sb, load64(o));
        jw_key(sb, "state", 0);
        sb_u64(sb, load64(o + 8));
    } elif (ty == 7) {
        var d = load64(o);
        jw_key(sb, "mean", 1);
        jw_vec_f64(sb, load64(o + 8), d);
        jw_key(sb, "covariance", 0);
        jw_mat(sb, load64(o + 16));
        jw_key(sb, "cholesky_l", 0);
        str_builder_putc(sb, 91);
        var i = 0;
        while (i < d) {
            if (i > 0) { str_builder_putc(sb, 44); }
            jw_vec_f64(sb, load64(o + 24) + i * d * 8, d);
            i = i + 1;
        }
        str_builder_putc(sb, 93);
        jw_key(sb, "log_det", 0);
        jw_f64(sb, load64(o + 32));
        jw_key(sb, "dim", 0);
        sb_u64(sb, d);
    } else {
        jw_key(sb, "bin_edges", 1);
        jw_vec_f64(sb, load64(o), load64(o + 8));
        jw_key(sb, "counts", 0);
        jw_vec_u64(sb, load64(o + 16), load64(o + 24));
        jw_key(sb, "total", 0);
        sb_u64(sb, load64(o + 32));
    }
    str_builder_putc(sb, 125);
    return 0;
}

# ── tokens, as the twin flattens a value ─────────────────────────────────────────────

var g_tok = 0;

fn tok_sep(sb): i64 {
    if (g_tok > 0) { str_builder_putc(sb, 32); }
    g_tok = g_tok + 1;
    return 0;
}

fn flat(sb, v): i64 {
    var t = bayan_json_v_tag(v);
    tok_sep(sb);
    if (t == JTAG_NULL) {
        str_builder_putc(sb, 110);
    } elif (t == JTAG_BOOL) {
        str_builder_putc(sb, 98);
        str_builder_putc(sb, 48 + bayan_json_v_bool(v));
    } elif (t == JTAG_INT) {
        str_builder_putc(sb, 117);
        sb_u64(sb, bayan_json_v_int(v));
    } elif (t == JTAG_FLOAT) {
        str_builder_putc(sb, 102);
        sb_hex64(sb, load64(v + 8));
    } elif (t == JTAG_STR) {
        var s = bayan_json_v_str(v);
        str_builder_putc(sb, 115);
        sb_hex(sb, load64(s), load64(s + 8));
    } elif (t == JTAG_ARR) {
        str_builder_putc(sb, 91);
        var i = 0;
        while (i < bayan_json_v_arr_len(v)) {
            flat(sb, bayan_json_v_arr_get(v, i));
            i = i + 1;
        }
        tok_sep(sb);
        str_builder_putc(sb, 93);
    } else {
        str_builder_putc(sb, 123);
        var k = 0;
        while (k < bayan_json_v_obj_len(v)) {
            var key = bayan_json_v_obj_key(v, k);
            tok_sep(sb);
            str_builder_putc(sb, 115);
            sb_hex(sb, load64(key), load64(key + 8));
            flat(sb, bayan_json_v_obj_val(v, k));
            k = k + 1;
        }
        tok_sep(sb);
        str_builder_putc(sb, 125);
    }
    return 0;
}

# The tokens of the probe's own text p[0, n), read back through the lift: a struct's values in order, or the
# error enum's object.
fn tokens(sb, ty, p, n): i64 {
    var m = p7_lift(p, n, g_lift_buf, g_lift_cap);
    reset_via(g_al);
    var v = bayan_json_v_parse_buf_a(g_al, g_lift_buf, m);
    g_tok = 0;
    if (ty == 4) {
        flat(sb, v);
        return 0;
    }
    var k = 0;
    while (k < bayan_json_v_obj_len(v)) {
        flat(sb, bayan_json_v_obj_val(v, k));
        k = k + 1;
    }
    return 0;
}

# ── the documents ─────────────────────────────────────────────────────────────────────

fn type_id(p, n): i64 {
    if (cstr_eq(p, n, "normal") == 1) { return 0; }
    if (cstr_eq(p, n, "binomial") == 1) { return 1; }
    if (cstr_eq(p, n, "rng") == 1) { return 2; }
    if (cstr_eq(p, n, "kde") == 1) { return 3; }
    if (cstr_eq(p, n, "error") == 1) { return 4; }
    if (cstr_eq(p, n, "test") == 1) { return 5; }
    if (cstr_eq(p, n, "markov") == 1) { return 6; }
    if (cstr_eq(p, n, "mvn") == 1) { return 7; }
    return 8;
}

# Splits line[0, n) at tabs: up to max fields' starts and lengths into st / ln. The count.
fn split(line, n, st, ln, max): i64 {
    var k = 0;
    var s = 0;
    var i = 0;
    while (i <= n && k < max) {
        if (i == n || load8(line + i) == 9) {
            store64(st + k * 8, line + s);
            store64(ln + k * 8, i - s);
            k = k + 1;
            s = i + 1;
        }
        i = i + 1;
    }
    return k;
}

# Encodes o (type ty) with the current printer into fresh storage: the pointer, its length at out.
fn encode_copy(ty, o, lenout): i64 {
    sb_reset(g_sb);
    encode(ty, o, g_sb);
    store64(lenout, sb_len(g_sb));
    return dup_bytes(sb_ptr(g_sb), sb_len(g_sb));
}

fn one_doc(line, n, out): i64 {
    var st[64];
    var ln[64];
    if (split(line, n, &st, &ln, 7) < 3) { return 0; }
    var ty = type_id(load64(&st + 8), load64(&ln + 8));
    var dn = load64(&ln + 16) / 2;
    var doc = unhex(load64(&st + 16), load64(&ln + 16));
    var o1 = alloc(64);
    var o2 = alloc(64);
    g_lift = 0;
    var c0 = decode(ty, doc, dn, o1);
    g_lift = 1;
    var c1 = decode(ty, doc, dn, o2);
    str_builder_add_cstr(out, "D\t");
    sb_bytes(out, load64(&st), load64(&ln));
    str_builder_putc(out, 9);
    sb_bytes(out, load64(&st + 8), load64(&ln + 8));
    str_builder_putc(out, 9);
    str_builder_add_cstr(out, err_name(c0));
    str_builder_putc(out, 9);
    str_builder_add_cstr(out, err_name(c1));
    str_builder_putc(out, 9);
    if (c1 != P7_OK) {
        str_builder_add_cstr(out, "\t\t\t\t");
    } else {
        var fl = 0;
        var gl = 0;
        g_grisu = 0;
        var fp = encode_copy(ty, o2, &fl);
        g_grisu = 1;
        var gp = encode_copy(ty, o2, &gl);
        g_grisu = 0;
        tokens(out, ty, fp, fl);
        str_builder_putc(out, 9);
        sb_hex(out, fp, fl);
        str_builder_putc(out, 9);
        sb_hex(out, gp, gl);
        str_builder_putc(out, 9);
        var o3 = alloc(64);
        var r1 = 0;
        var r2 = 0;
        var tl = 0;
        if (decode(ty, fp, fl, o3) == P7_OK) {
            var tp = encode_copy(ty, o3, &tl);
            r1 = mem_eq(tp, tl, fp, fl);
        }
        if (decode(ty, gp, gl, o3) == P7_OK) {
            var up = encode_copy(ty, o3, &tl);
            r2 = mem_eq(up, tl, fp, fl);
        }
        str_builder_putc(out, 48 + r1);
        str_builder_putc(out, 48 + r2);
    }
    str_builder_putc(out, 9);
    if (c0 == P7_OK) {
        var hl = 0;
        var hp = encode_copy(ty, o1, &hl);
        tokens(out, ty, hp, hl);
    }
    str_builder_putc(out, 10);
    return 1;
}

# ── the printers ──────────────────────────────────────────────────────────────────────

var g_fx = 0;

# Significant digits of a JSON or Display number text (no sign, exponent, point, or leading and trailing zeros).
fn sig_digits(p, n): i64 {
    var i = 0;
    var e = n;
    var k = 0;
    while (k < n) {
        var c = load8(p + k);
        if (c == 101 || c == 69) { e = k; }
        k = k + 1;
    }
    var first = 0 - 1;
    var last = 0 - 1;
    while (i < e) {
        var c = load8(p + i);
        if (c >= 49 && c <= 57) {
            if (first < 0) { first = i; }
            last = i;
        }
        i = i + 1;
    }
    if (first < 0) { return 0; }
    var cnt = 0;
    i = first;
    while (i <= last) {
        if (is_digit(load8(p + i)) == 1) { cnt = cnt + 1; }
        i = i + 1;
    }
    return cnt;
}

fn fx(kind: cstring, bits, ep, en, gp, gn): i64 {
    if (g_fx >= 40) { return 0; }
    g_fx = g_fx + 1;
    put("FX\t");
    put(kind);
    put("\t");
    var sb = str_builder_new();
    sb_hex64(sb, bits);
    str_builder_putc(sb, 9);
    sb_bytes(sb, ep, en);
    str_builder_putc(sb, 9);
    sb_bytes(sb, gp, gn);
    str_builder_putc(sb, 10);
    put_sb(sb);
    return 0;
}

fn summary(name: cstring, n): i64 {
    put("F\t");
    put(name);
    put("\t");
    var sb = str_builder_new();
    sb_u64(sb, n);
    str_builder_putc(sb, 10);
    put_sb(sb);
    return 0;
}

fn floats(buf, n): i64 {
    var count = 0;
    var d_grisu = 0;
    var d_longer = 0;
    var d_fjson = 0;
    var d_fdisp = 0;
    var d_parse = 0;
    var st[32];
    var ln[32];
    var sb = str_builder_new();
    var gb[40];
    var s = 0;
    var i = 0;
    while (i < n) {
        if (load8(buf + i) == 10) {
            if (split(buf + s, i - s, &st, &ln, 3) == 3) {
                count = count + 1;
                var bits = parse_hex64(load64(&st), load64(&ln));
                var jp = load64(&st + 8);
                var jn = load64(&ln + 8);
                var dp = load64(&st + 16);
                var dn = load64(&ln + 16);
                var gn = bayan_f64_to_json(bits, &gb);
                if (mem_eq(&gb, gn, jp, jn) == 0) {
                    d_grisu = d_grisu + 1;
                    if (sig_digits(&gb, gn) > sig_digits(jp, jn)) { d_longer = d_longer + 1; }
                    if (d_grisu <= 6) { fx("grisu", bits, jp, jn, &gb, gn); }
                }
                var x: f64 = bits;
                sb_reset(sb);
                im_fmt_f64_json(sb, x);
                if (mem_eq(sb_ptr(sb), sb_len(sb), jp, jn) == 0) {
                    d_fjson = d_fjson + 1;
                    fx("fmtf_json", bits, jp, jn, sb_ptr(sb), sb_len(sb));
                }
                sb_reset(sb);
                im_fmt_f64_display(sb, x);
                if (mem_eq(sb_ptr(sb), sb_len(sb), dp, dn) == 0) {
                    d_fdisp = d_fdisp + 1;
                    fx("fmtf_display", bits, dp, dn, sb_ptr(sb), sb_len(sb));
                }
                if (bayan_f64_parse(jp, jn) != bits) {
                    d_parse = d_parse + 1;
                    fx("parse", bits, jp, jn, jp, jn);
                }
            }
            s = i + 1;
        }
        i = i + 1;
    }
    summary("doubles", count);
    summary("grisu_differs", d_grisu);
    summary("grisu_longer", d_longer);
    summary("fmtf_json_differs", d_fjson);
    summary("fmtf_display_differs", d_fdisp);
    summary("bayan_parse_differs", d_parse);
    return 0;
}

fn main(): i64 {
    alloc_init();
    g_al = arena_allocator_growable(1048576);
    g_sb = str_builder_new();
    g_names = alloc(72);
    store64(g_names, names("mean", "std_dev", "", "", "", ""));
    store64(g_names + 8, names("n", "p", "", "", "", ""));
    store64(g_names + 16, names("state", "", "", "", "", ""));
    store64(g_names + 24, names("data", "bandwidth", "kernel", "", "", ""));
    store64(g_names + 32, 0);
    store64(g_names + 40, names("test_name", "statistic", "p_value", "degrees_of_freedom", "reject_at_alpha",
        "reject"));
    store64(g_names + 48, names("transition_matrix", "state", "", "", "", ""));
    store64(g_names + 56, names("mean", "covariance", "", "", "", ""));
    store64(g_names + 64, names("bin_edges", "counts", "total", "", "", ""));
    g_kernels = names("Gaussian", "Epanechnikov", "Uniform", "Triangular", "", "");
    g_variants = names("InvalidParameter", "InvalidSample", "ConvergenceFailure", "DimensionMismatch",
        "ComputationError", "");
    var cap = 67108864;
    var buf = alloc(cap);
    var n = file_read_all("build/p7_rust_corpus.tsv", buf, cap);
    if (n <= 0) {
        put("cannot read build/p7_rust_corpus.tsv\n");
        return 1;
    }
    g_lift_cap = 1048576;
    g_lift_buf = alloc(g_lift_cap);
    var out = str_builder_new();
    var s = 0;
    var i = 0;
    while (i < n) {
        if (load8(buf + i) == 10) {
            sb_reset(out);
            one_doc(buf + s, i - s, out);
            put_sb(out);
            s = i + 1;
        }
        i = i + 1;
    }
    var fbuf = alloc(cap);
    var fnn = file_read_all("build/p7_rust_floats.tsv", fbuf, cap);
    if (fnn <= 0) {
        put("cannot read build/p7_rust_floats.tsv\n");
        return 1;
    }
    floats(fbuf, fnn);
    return 0;
}

var rc = main();
sys_exit_group(rc);
