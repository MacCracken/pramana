# p9_beta.bcyr — probe P9, beta_inc: the cost of T0 and T1 (port plan §5 step 9d-3, §3.7).
#
# ns per (I, 1 − I) call on 1,024 seeded inputs per region, cycled: shapes in [1, 60] with x uniform, shapes near
# the mean for middle and large shapes, one small shape (T1's direct complement), and a tail. The sums keep every
# result live.
#   CYRIUS_ALLOW_ABSOLUTE_INCLUDES=1 cyrius bench scripts/probes/p9_beta.bcyr

include "scripts/probes/p9_beta_impl.cyr"

var g_rng = 0x2545F4914F6CDD1D;
var g_as = 0;
var g_bs = 0;
var g_xs = 0;

fn p9_unit(): f64 {
    var x = g_rng;
    x = x ^ (x >> 12);
    x = x ^ (x << 25);
    x = x ^ (x >> 27);
    g_rng = x;
    var top = (x * 0x2545F4914F6CDD1D) >> 11;
    var a: f64 = f64_from(top);
    var d: f64 = 9007199254740992.0;
    return a / d;
}

fn p9_logr(lo: f64, hi: f64): f64 {
    var l1: f64 = _km_cr_ln(lo);
    var l2: f64 = _km_cr_ln(hi);
    var w: f64 = l2 - l1;
    var u: f64 = p9_unit();
    var t: f64 = l1 + w * u;
    var r: f64 = _km_cr_exp(t);
    return r;
}

# 1,024 inputs: a in [alo, ahi], b in [blo, bhi] (log-uniform); `mode` 0 x uniform in (0, 1), 1 x = μ ± 2σ,
# 2 x = μ·r with r log-uniform in [1e-6, 1/2].
fn fill(alo: f64, ahi: f64, blo: f64, bhi: f64, mode): i64 {
    var i = 0;
    while (i < 1024) {
        var a: f64 = p9_logr(alo, ahi);
        var b: f64 = p9_logr(blo, bhi);
        var s: f64 = a + b;
        var mu: f64 = a / s;
        var x: f64 = p9_unit();
        if (mode == 1) {
            var s1: f64 = s + 1.0;
            var v: f64 = (a * b) / (s * s * s1);
            var sd: f64 = f64_sqrt(v);
            var t: f64 = -2.0 + 4.0 * p9_unit();
            x = mu + t * sd;
            if (x <= 0.0) { x = mu * 0.5; }
            if (x >= 1.0) { x = mu; }
        }
        if (mode == 2) {
            var r: f64 = p9_logr(0.000001, 0.5);
            x = mu * r;
        }
        store64(g_as + i * 8, a);
        store64(g_bs + i * 8, b);
        store64(g_xs + i * 8, x);
        i = i + 1;
    }
    return 0;
}

fn row(name: cstring, which, reps): i64 {
    var s: f64 = 0.0;
    var bn = bench_new(name);
    bench_batch_start(bn);
    var k = 0;
    while (k < reps) {
        var i = 0;
        while (i < 1024) {
            var a: f64 = load64(g_as + i * 8);
            var b: f64 = load64(g_bs + i * 8);
            var x: f64 = load64(g_xs + i * 8);
            var y: f64 = 1.0 - x;
            if (which == 0) {
                var i0, c0 = p9_t0_beta_inc(a, b, x, y);
                s = s + i0 + c0;
            } else {
                var i1, c1 = p9_t1_beta_inc(a, b, x, y);
                s = s + i1 + c1;
            }
            i = i + 1;
        }
        k = k + 1;
    }
    bench_batch_stop(bn, reps * 1024);
    bench_report(bn);
    if (s != s) { println("nan"); }
    return 0;
}

fn main(): i64 {
    alloc_init();
    g_as = alloc(1024 * 8);
    g_bs = alloc(1024 * 8);
    g_xs = alloc(1024 * 8);
    fill(1.0, 60.0, 1.0, 60.0, 0);
    row("T0, a, b in [1, 60], x uniform", 0, 100);
    row("T1, a, b in [1, 60], x uniform", 1, 100);
    fill(10.0, 1000.0, 10.0, 1000.0, 1);
    row("T0, a, b in [10, 1e3], x near the mean", 0, 50);
    row("T1, a, b in [10, 1e3], x near the mean", 1, 50);
    fill(1000.0, 100000.0, 1000.0, 100000.0, 1);
    row("T0, a, b in [1e3, 1e5], x near the mean", 0, 10);
    row("T1, a, b in [1e3, 1e5], x near the mean", 1, 10);
    fill(0.001, 1.0, 1.0, 1000.0, 0);
    row("T0, a in [1e-3, 1], b in [1, 1e3], x uniform", 0, 100);
    row("T1, a in [1e-3, 1], b in [1, 1e3], x uniform", 1, 100);
    fill(1.0, 1000.0, 1.0, 1000.0, 2);
    row("T0, a, b in [1, 1e3], x in the lower tail", 0, 100);
    row("T1, a, b in [1, 1e3], x in the lower tail", 1, 100);
    return 0;
}

var rc = main();
sys_exit_group(rc);
