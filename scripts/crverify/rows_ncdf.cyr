# rows_ncdf.cyr — the accuracy check of pramana's Φ (M2 part b2; port plan D3 = C, §3.4, ADR 009: ≤ 1 ulp).
#
# Prints `cr:ncdf/<set> z result` rows (bit patterns) for scripts/crverify/check.c, which compares each with
# MPFR's ½·erfc(−z/√2) at 1,024 bits, zero and subnormal results in units of 2^-1074. Probe P9's nine seeded sets
# (scripts/probes/cn_ncdf.cyr, its seed and order, T1 only), 1,146,809 arguments: the core and the lower tail, where
# CORE-MATH's fast bound fails and Φ takes the accurate path, the deep tail's subnormal results, the upper side, |z|
# from 2^-1074 to 32, any finite bits, the decimal grid z = k/1000, and the eight branch points of erfc in h = −z/√2.
# normal_sf(z) is normal_cdf(−z), so these rows cover both.
#   bash scripts/crverify/run.sh ncdf

include "tests/lib.cyr"

var g_rng = 0x2545F4914F6CDD1D;
var g_out = 0;

# Every shift here is `>>`, the logical one (`>>>` sign-extends).
fn cn_word(): i64 {
    var x = g_rng;
    x = x ^ (x >> 12);
    x = x ^ (x << 25);
    x = x ^ (x >> 27);
    g_rng = x;
    return x * 0x2545F4914F6CDD1D;
}

fn cn_unit(): f64 {
    var top = cn_word() >> 11;
    var a: f64 = f64_from(top);
    var d: f64 = 9007199254740992.0;
    return a / d;
}

# Uniform in [lo, hi).
fn cn_range(lo: f64, hi: f64): f64 {
    var w: f64 = hi - lo;
    var u: f64 = cn_unit();
    var r: f64 = lo + w * u;
    return r;
}

# 2^u·(1 + f) with u a random integer in [elo, ehi] (2^-1074 granularity below 2^-1022), and a random sign.
fn cn_scale(elo, ehi): f64 {
    var span = ehi - elo + 1;
    var e = elo + (cn_word() >> 1) % span;
    var m = cn_word() >> 12;
    var x: f64 = 0.0;
    if (e >= 0 - 1022) {
        var bits = ((e + 1023) << 52) | m;
        x = _pmn_cm_bits(bits);
    } else {
        var sh = 0 - 1022 - e;
        var sub = (m | 0x10000000000000) >> sh;
        if (sub == 0) { sub = 1; }
        x = _pmn_cm_bits(sub);
    }
    if ((cn_word() & 1) == 1) { x = -x; }
    return x;
}

# Any finite double.
fn cn_anybits(): f64 {
    var b = cn_word();
    if (((b >> 52) & 0x7FF) == 0x7FF) { b = b & 0xBFFFFFFFFFFFFFFF; }
    var x: f64 = _pmn_cm_bits(b);
    return x;
}

fn cn_hex64(sb, w): i64 {
    var i = 60;
    while (i >= 0) {
        var d = (w >> i) & 15;
        if (d < 10) { str_builder_putc(sb, 48 + d); } else { str_builder_putc(sb, 87 + d); }
        i = i - 4;
    }
    return 0;
}

fn cn_hexval(c): i64 {
    if (c >= 48 && c <= 57) { return c - 48; }
    return c - 87;
}

fn cn_flush(): i64 {
    print(load64(g_out), load64(g_out + 8));
    store64(g_out + 8, 0);
    return 0;
}

fn cn_row(set: cstring, z: f64, r: f64): i64 {
    str_builder_add_cstr(g_out, "cr:ncdf/");
    str_builder_add_cstr(g_out, set);
    str_builder_putc(g_out, 32);
    cn_hex64(g_out, z);
    str_builder_putc(g_out, 32);
    cn_hex64(g_out, r);
    str_builder_putc(g_out, 10);
    if (load64(g_out + 8) > 1048576) { cn_flush(); }
    return 0;
}

fn cn_seeded(set: cstring, z: f64): i64 {
    var r1: f64 = _pmn_normal_cdf(z);
    cn_row(set, z, r1);
    return 0;
}

# 2,001 inputs at z_e + k ulps (k ∈ [−1000, 1000]) and 10,500 within 2^-20·|z_e| of it, for an edge in h = −z/√2.
fn cn_edge(h: f64): i64 {
    var s2: f64 = _PMN_F64_SQRT_2;
    var nh: f64 = -h;
    var ze: f64 = nh * s2;
    var b = load64(&ze);
    var k = 0 - 1000;
    while (k <= 1000) {
        var y: f64 = _pmn_cm_bits(b + k);
        cn_seeded("edges", y);
        k = k + 1;
    }
    var aze: f64 = f64_abs(ze);
    var c20: f64 = 0x3EB0000000000000;          # 0x1p-20
    var w: f64 = aze * c20;
    var nw: f64 = -w;
    var i = 0;
    while (i < 10500) {
        var off: f64 = cn_range(nw, w);
        var y2: f64 = ze + off;
        cn_seeded("edges", y2);
        i = i + 1;
    }
    return 0;
}

fn main(): i64 {
    alloc_init();
    g_out = str_builder_new();
    var i = 0;
    # the core, (−5, 5): 250,000
    while (i < 250000) {
        cn_seeded("core", cn_range(-5.0, 5.0));
        i = i + 1;
    }
    # the lower tail, (−38.5, −5): 250,000 (Rust: 1,590 ulp)
    i = 0;
    while (i < 250000) {
        cn_seeded("tail", cn_range(-38.5, -5.0));
        i = i + 1;
    }
    # where CORE-MATH's fast bound fails and T1 takes the accurate path, h ∈ (1.77, 2.9): 100,000
    i = 0;
    while (i < 100000) {
        cn_seeded("mid", cn_range(-4.1, -2.5));
        i = i + 1;
    }
    # the deep tail, (−38.5, −36.5): the accurate asymptotic path and the subnormal results, 100,000
    i = 0;
    while (i < 100000) {
        cn_seeded("deep", cn_range(-38.5, -36.5));
        i = i + 1;
    }
    # the upper side, (5, 8.3), where Φ → 1: 100,000
    i = 0;
    while (i < 100000) {
        cn_seeded("upper", cn_range(5.0, 8.3));
        i = i + 1;
    }
    # |z| from 2^-1074 to 32, both signs: 150,000
    i = 0;
    while (i < 150000) {
        cn_seeded("scales", cn_scale(0 - 1074, 4));
        i = i + 1;
    }
    # any finite bits: 50,000
    i = 0;
    while (i < 50000) {
        cn_seeded("bits", cn_anybits());
        i = i + 1;
    }
    # z = k/1000 for k ∈ [−38500, 8300]: the decimal inputs callers type, 46,801
    var k = 0 - 38500;
    while (k <= 8300) {
        var kf: f64 = f64_from(k);
        var zg: f64 = kf / 1000.0;
        cn_seeded("grid", zg);
        k = k + 1;
    }
    # the branch points of cr_erfc in h, 12,501 each: erfc rounds to 2, the tiny thresholds, 0x1.e861fbb24c00ap-2,
    # 0x1.b59ffb450828cp+0, THRESHOLD1, the fast asymptotic path's top, erfc's underflow
    var e1: f64 = 0xC017744F8F74E94B;
    cn_edge(e1);
    var e2: f64 = 0xBC9C5BF891B4EF6A;
    cn_edge(e2);
    var e3: f64 = 0x3C8C5BF891B4EF6A;
    cn_edge(e3);
    var e4: f64 = 0x3FDE861FBB24C00A;
    cn_edge(e4);
    var e5: f64 = 0x3FFB59FFB450828C;
    cn_edge(e5);
    var e6: f64 = _PMN_CM_D_THRESHOLD1;
    cn_edge(e6);
    var e7: f64 = 0x4039DB1BB14E15CA;
    cn_edge(e7);
    var e8: f64 = 0x403B39DC41E48BFD;
    cn_edge(e8);
    cn_flush();
    return 0;
}

var rc = main();
sys_exit_group(rc);
