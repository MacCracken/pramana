# rows_gamma.cyr — the accuracy check of pramana's regularized incomplete gamma (M2 part b4; port plan D3 = C, §3.4;
# ADR 009: P and Q within 4 ulp for a in [1e-3, 1e5] and x > 0; for any other a up to 1e9, no row less accurate than
# Rust's).
#
# Prints `gref_p/<set>/t1 a x P` and `gref_q/<set>/t1 a x Q` rows (bit patterns) for scripts/port-baseline/check.c,
# which compares each with its 320-bit reference (`gref`: the series below x = a, Legendre's continued fraction above,
# taken wider for a tiny shape). Zero and subnormal results count in units of 2^-1074. The sets:
# - probe P9's five seeded sets over ADR 009's domain (scripts/probes/p9_gamma.cyr), drawn in the same order from the
#   same seed, so these rows are byte for byte P9's own T1 rows: 20,000 pairs with x = a + t√a, t in [−5, 5]; 10,000
#   in the lower tail, x/a down to 1e-8; 10,000 in the upper tail, out to 50a and a + 40√a; 10,000 with a in
#   [1e-3, 1] and x in [1e-8, 60]; 10,000 at the switches, x near 1.1 and x = a(1 ± δ);
# - beyond P9, outside the committed domain: 4,000 pairs with a log-uniform in [1e5, 1e9] (half with x = a + t√a,
#   a quarter in each tail), and 10,000 with a log-uniform from the least subnormal, 2^-1074, to 1e-3 and x from
#   2^-1074 to 1e3 (Σ/a overflows Dekker's split below about 2^-995, which the port scales away below 2^-512).
#   bash scripts/crverify/run.sh gamma

include "tests/lib.cyr"

var g_rng = 0x9E3779B97F4A7C15;
var g_out = 0;

# xorshift64*: uniform in [0, 1) from the top 53 bits. Every shift is `>>`, the logical one.
fn cg_unit(): f64 {
    var x = g_rng;
    x = x ^ (x >> 12);
    x = x ^ (x << 25);
    x = x ^ (x >> 27);
    g_rng = x;
    var top = (x * 0x2545F4914F6CDD1D) >> 11;
    var a: f64 = f64_from(top);
    var d: f64 = 9007199254740992.0;
    return a / d;
}

# Log-uniform in [lo, hi], as P9 draws it.
fn cg_logr(lo: f64, hi: f64): f64 {
    var l1: f64 = _pmn_km_cr_ln(lo);
    var l2: f64 = _pmn_km_cr_ln(hi);
    var w: f64 = l2 - l1;
    var u: f64 = cg_unit();
    var t: f64 = l1 + w * u;
    var r: f64 = _pmn_km_cr_exp(t);
    return r;
}

fn cg_hex64(sb, w): i64 {
    var i = 60;
    while (i >= 0) {
        var d = (w >> i) & 15;
        if (d < 10) { str_builder_putc(sb, 48 + d); } else { str_builder_putc(sb, 87 + d); }
        i = i - 4;
    }
    return 0;
}

fn cg_row(fname: cstring, set: cstring, a: f64, x: f64, v: f64): i64 {
    str_builder_add_cstr(g_out, fname);
    str_builder_putc(g_out, 47);
    str_builder_add_cstr(g_out, set);
    str_builder_add_cstr(g_out, "/t1 ");
    cg_hex64(g_out, a);
    str_builder_putc(g_out, 32);
    cg_hex64(g_out, x);
    str_builder_putc(g_out, 32);
    cg_hex64(g_out, v);
    str_builder_putc(g_out, 10);
    if (load64(g_out + 8) > 1048576) {
        print(load64(g_out), load64(g_out + 8));
        store64(g_out + 8, 0);
    }
    return 0;
}

# One pair: P's row, then Q's (check.c reuses its reference across consecutive rows of the same pair).
fn cg_pair(set: cstring, a: f64, x: f64): i64 {
    var p, q = _pmn_gamma_inc(a, x);
    cg_row("gref_p", set, a, x, p);
    cg_row("gref_q", set, a, x, q);
    return 0;
}

fn main(): i64 {
    alloc_init();
    g_out = str_builder_new();
    var amin: f64 = 0.001;
    var amax: f64 = 100000.0;
    var i = 0;
    # x near a: x = a + t·√a, t in [−5, 5], kept above a/1000.
    while (i < 20000) {
        var a1: f64 = cg_logr(amin, amax);
        var t1: f64 = -5.0 + 10.0 * cg_unit();
        var sq: f64 = f64_sqrt(a1);
        var x1: f64 = a1 + t1 * sq;
        var fl: f64 = a1 * 0.001;
        if (x1 < fl) { x1 = fl; }
        cg_pair("near", a1, x1);
        i = i + 1;
    }
    # The lower tail: x = a·r, r log-uniform in [1e-8, 0.95].
    i = 0;
    while (i < 10000) {
        var a2: f64 = cg_logr(amin, amax);
        var r2: f64 = cg_logr(0.00000001, 0.95);
        var x2: f64 = a2 * r2;
        cg_pair("lower", a2, x2);
        i = i + 1;
    }
    # The upper tail: half x = a·r, r log-uniform in [1.05, 50]; half x = a + t·√a, t in [5, 40].
    i = 0;
    while (i < 10000) {
        var a3: f64 = cg_logr(amin, amax);
        var x3: f64 = 0.0;
        if (cg_unit() < 0.5) {
            var r3: f64 = cg_logr(1.05, 50.0);
            x3 = a3 * r3;
        } else {
            var t3: f64 = 5.0 + 35.0 * cg_unit();
            var s3: f64 = f64_sqrt(a3);
            x3 = a3 + t3 * s3;
        }
        cg_pair("upper", a3, x3);
        i = i + 1;
    }
    # Small shapes: a in [1e-3, 1], x log-uniform in [1e-8, 60] (Rust's 246-ulp Q).
    i = 0;
    while (i < 10000) {
        var a4: f64 = cg_logr(amin, 1.0);
        var x4: f64 = cg_logr(0.00000001, 60.0);
        cg_pair("smalla", a4, x4);
        i = i + 1;
    }
    # The switches: a in [0.95, 1.05] with x in [1, 1.2] (the small-a edge at x = 1.1), and x = a(1 ± δ),
    # δ log-uniform in [1e-12, 1e-2] (the series and fraction meet at x = a).
    i = 0;
    while (i < 5000) {
        var a5: f64 = 0.95 + 0.1 * cg_unit();
        var x5: f64 = 1.0 + 0.2 * cg_unit();
        cg_pair("switch", a5, x5);
        var a6: f64 = cg_logr(1.0, amax);
        var d6: f64 = cg_logr(0.000000000001, 0.01);
        var x6: f64 = a6 + a6 * d6;
        if (cg_unit() < 0.5) { x6 = a6 - a6 * d6; }
        cg_pair("switch", a6, x6);
        i = i + 1;
    }
    # Beyond P9: large shapes, a in [1e5, 1e9]. Half x = a + t·√a, t in [−5, 5]; a quarter x = a·r with r
    # log-uniform in [1e-3, 0.99]; a quarter x = a·r with r log-uniform in [1.01, 10].
    var abig: f64 = 1000000000.0;
    i = 0;
    while (i < 4000) {
        var a7: f64 = cg_logr(amax, abig);
        var u7: f64 = cg_unit();
        var x7: f64 = 0.0;
        if (u7 < 0.5) {
            var t7: f64 = -5.0 + 10.0 * cg_unit();
            var s7: f64 = f64_sqrt(a7);
            x7 = a7 + t7 * s7;
        } elif (u7 < 0.75) {
            var r7: f64 = cg_logr(0.001, 0.99);
            x7 = a7 * r7;
        } else {
            var r8: f64 = cg_logr(1.01, 10.0);
            x7 = a7 * r8;
        }
        cg_pair("biga", a7, x7);
        i = i + 1;
    }
    # Beyond P9: tiny shapes, a log-uniform in [2^-1074, 1e-3], x log-uniform in [2^-1074, 1e3].
    var atiny: f64 = 0.0;
    store64(&atiny, 1);                      # 2^-1074, the least subnormal
    i = 0;
    while (i < 10000) {
        var a9: f64 = cg_logr(atiny, amin);
        var x9: f64 = cg_logr(atiny, 1000.0);
        cg_pair("tinya", a9, x9);
        i = i + 1;
    }
    print(load64(g_out), load64(g_out + 8));
    return 0;
}

var rc = main();
sys_exit_group(rc);
