# monte_carlo.cyr — 1.3.0's Monte Carlo example, in 2.0, and a Metropolis–Hastings chain on N(0, 1): the
# log-density is a function pointer and a context (D7), the chain an owned result freed by its drop.
include "dist/pramana.cyr"

fn log_normal(ctx, xs, dim): f64 {
    var x: f64 = load64(xs);
    var h: f64 = -0.5 * x;
    var r: f64 = h * x;
    return r;
}

fn main(): i64 {
    alloc_init();
    var rng: PmnSimpleRng;
    PmnSimpleRng_new(&rng, 42);
    var t, v = pmn_monte_carlo_pi(100000, &rng);
    if (t == Err) { return 1; }
    var pi: f64 = v;                             # bind a Result's value to an f64 before using it in arithmetic
    var d: f64 = pi - _PMN_F64_PI;
    if (f64_abs(d) >= 0.1) { return 1; }
    var x0[8];
    store64(&x0, 0.0);
    var chain: PmnMcmcResult;
    if (pmn_metropolis_hastings(&chain, &log_normal, 0, &x0, 1, 1.0, 5000, 500, &rng) != PMN_ERR_NONE) { return 1; }
    var rate: f64 = chain.acceptance_rate;
    var n = chain.n_samples();
    PmnMcmcResult_drop(&chain);
    if (n != 5000 || rate <= 0.1 || rate >= 0.9) { return 1; }
    println("π and an MH chain: ok");
    return 0;
}

var rc = main();
sys_exit_group(rc);
