# soorat.bcyr — src/soorat.cyr (M7 part a): ns per call. 1.3.0 has no criterion body for soorat.rs, so these rows
# have no Rust column:
# - `soorat/from_data_10000_100bins`: HistogramData::from_data on 10⁴ seeded values in [−1, 1), 100 bins, then drop;
# - `soorat/curve_json_200`: a 200-point DistributionCurve written as JSON and read back.
# Each row prints a result. The record is docs/benchmarks-rust-v-cyrius.md.

include "tests/lib.cyr"

# Runs the bench rows below, printing each one's timing and the result a run can be checked by.
fn main(): i64 {
    alloc_init();
    var n = 10000;
    var d = alloc(n * 8);
    var g: PmnSimpleRng;
    PmnSimpleRng_new(&g, 42);
    for (var i = 0; i < n; i = i + 1) {
        var u: f64 = g.next_f64();
        var t: f64 = u * 2.0;
        var x: f64 = t - 1.0;
        store64(d + i * 8, x);
    }
    var h: PmnHistogramData;
    var b1 = bench_new("from_data_10000_100bins");
    bench_batch_start(b1);
    for (var r = 0; r < 500; r = r + 1) {
        if (PmnHistogramData_from_data(&h, d, n, 100) != PMN_ERR_NONE) { return 1; }
        PmnHistogramData_drop(&h);
    }
    bench_batch_stop(b1, 500);
    if (PmnHistogramData_from_data(&h, d, n, 100) != PMN_ERR_NONE) { return 1; }
    print("  counts[50]: ", 14);
    fmt_int(load64(h.counts + 50 * 8));
    println("");
    PmnHistogramData_drop(&h);
    bench_report(b1);

    var c: PmnDistributionCurve;
    if (PmnDistributionCurve_new(&c, d, 200, d + 200 * 8, 200, d + 400 * 8, 200, "Normal(0,1)", 11) != PMN_ERR_NONE) {
        return 1;
    }
    var sb = str_builder_new();
    var c2: PmnDistributionCurve;
    var b2 = bench_new("curve_json_200");
    bench_batch_start(b2);
    for (var r2 = 0; r2 < 200; r2 = r2 + 1) {
        store64(sb + 8, 0);
        if (c.to_json(sb) != PMN_ERR_NONE) { return 1; }
        if (PmnDistributionCurve_from_json(&c2, load64(sb), load64(sb + 8)) != PMN_ERR_NONE) { return 1; }
        PmnDistributionCurve_drop(&c2);
    }
    bench_batch_stop(b2, 200);
    print("  bytes: ", 9);
    fmt_int(load64(sb + 8));
    println("");
    bench_report(b2);
    PmnDistributionCurve_drop(&c);
    return 0;
}

var rc = main();
sys_exit_group(rc);
