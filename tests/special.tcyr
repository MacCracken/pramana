# special.tcyr — the special functions of src/special.cyr (M2).
#
# tests/parity.tcyr replays 1.3.0's results on tests/golden/special.tsv at 0 ulp, against special.cr.tsv where a
# primitive is corrected. These tests carry 1.3.0's own unit tests over (math.rs), and pin what a class-C replay does
# not check bit for bit: the sign of a zero, a NaN's payload, erf's odd symmetry, 1.3.0's poles and cutoffs, and the
# identities bd0 and ln B keep.

include "tests/lib.cyr"

fn bits(x: f64): i64 {
    return load64(&x);
}

fn of_bits(b): f64 {
    var x: f64 = 0.0;
    store64(&x, b);
    return x;
}

# 1.3.0's assert_rel: |actual − expected| / |expected| ≤ tol, or |actual| ≤ tol when expected is 0.
fn rel_ok(actual: f64, expected: f64, tol: f64): i64 {
    var err: f64 = 0.0;
    if (expected == 0.0) {
        err = f64_abs(actual);
    } else {
        var d: f64 = actual - expected;
        var q: f64 = d / expected;
        err = f64_abs(q);
    }
    if (err <= tol) { return 1; }
    return 0;
}

# The distance between two finite doubles in ulps, or in units of 2^-1074 for zero and subnormal results (ADR 009).
fn ulps(a: f64, b: f64): i64 {
    var ua = bits(a);
    var ub = bits(b);
    if (ua < 0) { ua = 0 - (ua & 0x7FFFFFFFFFFFFFFF); }
    if (ub < 0) { ub = 0 - (ub & 0x7FFFFFFFFFFFFFFF); }
    var d = ua - ub;
    if (d < 0) { d = 0 - d; }
    return d;
}

# 1 when gamma_inc(a, x) is within ADR 009's 4 ulp of MPFR's P and Q (all four as bit patterns).
fn gi_ok(ab, xb, pb, qb): i64 {
    var a: f64 = of_bits(ab);
    var x: f64 = of_bits(xb);
    var p, q = _pmn_gamma_inc(a, x);
    var wp: f64 = of_bits(pb);
    var wq: f64 = of_bits(qb);
    if (ulps(p, wp) <= 4 && ulps(q, wq) <= 4) { return 1; }
    return 0;
}

# 1 when beta_inc(a, b, x, y) is within `bound` ulp of MPFR's I and 1 − I (all six as bit patterns).
fn bi_ok(ab, bb, xb, yb, ib, cb, bound): i64 {
    var a: f64 = of_bits(ab);
    var b: f64 = of_bits(bb);
    var x: f64 = of_bits(xb);
    var y: f64 = of_bits(yb);
    var p, q = _pmn_beta_inc(a, b, x, y);
    var wi: f64 = of_bits(ib);
    var wc: f64 = of_bits(cb);
    if (ulps(p, wi) <= bound && ulps(q, wc) <= bound) { return 1; }
    return 0;
}

fn main() {
    alloc_init();
    var t7: f64 = 0.0000001;

    test_group("erf_known_values, erfc_known_values (1.3.0's tests)");
    var e0: f64 = _pmn_erf(0.0);
    var e10: f64 = _pmn_erf(10.0);
    var em10: f64 = _pmn_erf(-10.0);
    assert(f64_abs(e0) < t7, "erf(0) = 0");
    assert(f64_abs(e10 - 1.0) < t7, "erf(10) = 1");
    assert(f64_abs(em10 + 1.0) < t7, "erf(-10) = -1");
    var c0: f64 = _pmn_erfc(0.0);
    var c10: f64 = _pmn_erfc(10.0);
    var cm10: f64 = _pmn_erfc(-10.0);
    assert(f64_abs(c0 - 1.0) < t7, "erfc(0) = 1");
    assert(f64_abs(c10) < t7, "erfc(10) = 0");
    assert(f64_abs(cm10 - 2.0) < t7, "erfc(-10) = 2");

    test_group("erf_erfc_sum_to_one (1.3.0's test)");
    var t15: f64 = 0.000000000000001;
    var sum_ok = 1;
    for (var k = 0 - 4; k <= 6; k = k + 1) {
        var kf: f64 = f64_from(k);
        var x: f64 = kf * 0.5;
        var a: f64 = _pmn_erf(x);
        var b: f64 = _pmn_erfc(x);
        var s: f64 = a + b;
        var d: f64 = s - 1.0;
        if (f64_abs(d) >= t15) { sum_ok = 0; }
    }
    assert(sum_ok == 1, "erf(x) + erfc(x) = 1 within 1e-15, x = -2 … 3 by halves");

    test_group("erf_reference_values (1.3.0's test, glibc's values)");
    var t416: f64 = 0.0000000000000004;
    var xs[40];
    var es[40];
    var ecs[40];
    store64(&xs, 0.1);
    store64(&es, 0.1124629160182849);
    store64(&ecs, 0.887537083981715);
    store64(&xs + 8, 0.5);
    store64(&es + 8, 0.5204998778130465);
    store64(&ecs + 8, 0.4795001221869535);
    store64(&xs + 16, 1.0);
    store64(&es + 16, 0.8427007929497149);
    store64(&ecs + 16, 0.15729920705028513);
    store64(&xs + 24, 3.0);
    store64(&es + 24, 0.9999779095030014);
    store64(&ecs + 24, 0.00002209049699858544);
    store64(&xs + 32, 5.0);
    store64(&es + 32, 0.9999999999984626);
    store64(&ecs + 32, 0.000000000001537459794428035);
    var ref_ok = 1;
    for (var i = 0; i < 5; i = i + 1) {
        var xi: f64 = load64(&xs + i * 8);
        var ei: f64 = load64(&es + i * 8);
        var eci: f64 = load64(&ecs + i * 8);
        var nxi: f64 = -xi;
        var nei: f64 = -ei;
        var g1: f64 = _pmn_erf(xi);
        var g2: f64 = _pmn_erfc(xi);
        var g3: f64 = _pmn_erf(nxi);
        if (rel_ok(g1, ei, t416) == 0 || rel_ok(g2, eci, t416) == 0 || rel_ok(g3, nei, t416) == 0) { ref_ok = 0; }
    }
    assert(ref_ok == 1, "erf, erfc and erf(-x) at 0.1, 0.5, 1, 3, 5 within 4e-16");
    var t14: f64 = 0.00000000000001;
    var c10w: f64 = of_bits(0x36A7D8A7F2A8A2D0);
    assert(rel_ok(c10, c10w, t14) == 1, "erfc(10) = 2.088487583762545e-45");
    var cm1: f64 = _pmn_erfc(-1.0);
    assert(rel_ok(cm1, 1.8427007929497148, t416) == 1, "erfc(-1) = 1.8427007929497148");

    test_group("erf_special_values (1.3.0's test)");
    var nan: f64 = of_bits(0x7FF8000000000000);
    var inf: f64 = of_bits(0x7FF0000000000000);
    var ninf: f64 = -inf;
    var en: f64 = _pmn_erf(nan);
    var cn: f64 = _pmn_erfc(nan);
    assert(_pmn_is_nan(en) == 1 && _pmn_is_nan(cn) == 1, "erf(NaN) and erfc(NaN) are NaN");
    var ei1: f64 = _pmn_erf(inf);
    var ei2: f64 = _pmn_erf(ninf);
    var ci1: f64 = _pmn_erfc(inf);
    var ci2: f64 = _pmn_erfc(ninf);
    assert(ei1 == 1.0 && ei2 == -1.0, "erf(±inf) = ±1");
    assert(bits(ci1) == 0 && ci2 == 2.0, "erfc(+inf) = +0, erfc(-inf) = 2");
    var c30: f64 = _pmn_erfc(30.0);
    assert(bits(c30) == 0, "erfc(30) = +0");
    var tiny: f64 = of_bits(0x01A56E1FC2F8F359);
    var etiny: f64 = _pmn_erf(tiny);
    var two: f64 = tiny * 2.0;
    var pi: f64 = _PMN_F64_PI;
    var rpi: f64 = f64_sqrt(pi);
    var wtiny: f64 = two / rpi;
    assert(rel_ok(etiny, wtiny, t15) == 1, "erf(1e-300) = 2x/sqrt(pi), no underflow");

    test_group("normal_cdf_tails (1.3.0's test, glibc's values)");
    var p6: f64 = _pmn_normal_cdf(-6.0);
    var p1: f64 = _pmn_normal_cdf(-1.0);
    var q6: f64 = _pmn_normal_sf(6.0);
    var p0: f64 = _pmn_normal_cdf(0.0);
    assert(rel_ok(p6, 0.0000000009865876450377014, t14) == 1, "Phi(-6) = 9.865876450377014e-10");
    assert(rel_ok(p1, 0.15865525393145707, t15) == 1, "Phi(-1) = 0.15865525393145707");
    assert(rel_ok(q6, 0.0000000009865876450377014, t14) == 1, "1 - Phi(6) = 9.865876450377014e-10");
    var t16: f64 = 0.0000000000000001;
    assert(f64_abs(p0 - 0.5) < t16, "Phi(0) = 0.5");

    test_group("T1 (M2 part b2): Phi and 1 - Phi to MPFR's correctly rounded values");
    assert(bits(p1) == 0x3FC44ED0BB7CB20B, "Phi(-1) = 0.15865525393145705, correctly rounded (glibc's is 1 ulp off)");
    assert(bits(p6) == 0x3E10F30EF0092D48, "Phi(-6) = 9.86587645037698e-10, correctly rounded");
    var p37: f64 = _pmn_normal_cdf(-37.0);
    var z384: f64 = of_bits(0xC043333333333333);
    var p384: f64 = _pmn_normal_cdf(z384);
    assert(bits(p37) == 0x01CEACCC6BFEB0AF, "Phi(-37) = 5.725571222524577e-300, where 1.3.0 is hundreds of ulps off");
    assert(bits(p384) == 0x000000000000000D, "Phi(-38.4) = 13 x 2^-1074, the half folded into one subnormal rounding");
    var zm: f64 = of_bits(0xC00C0A2745DC2554);
    var pm: f64 = _pmn_normal_cdf(zm);
    assert(bits(pm) == 0x3F2DEDD0D0CDEF17, "Phi(-3.5049577195938273) correctly rounded: its fast path can't prove it");
    var nz2: f64 = -0.0;
    var pnz: f64 = _pmn_normal_cdf(nz2);
    assert(bits(p0) == 0x3FE0000000000000 && bits(pnz) == 0x3FE0000000000000, "Phi(+0) = Phi(-0) = 0.5 exactly");
    var sym_sf = 1;
    var zs: f64 = -39.5;
    for (var j5 = 0; j5 < 400; j5 = j5 + 1) {
        var nzs: f64 = -zs;
        var sfv: f64 = _pmn_normal_sf(zs);
        var cdv: f64 = _pmn_normal_cdf(nzs);
        if (bits(sfv) != bits(cdv)) { sym_sf = 0; }
        zs = zs + 0.1237;
    }
    assert(sym_sf == 1, "1 - Phi(z) = Phi(-z) bit for bit, z from -39.5 to 10");
    var pay2: f64 = of_bits(0x7FF8000000ABCDEF);
    var sfn: f64 = _pmn_normal_sf(pay2);
    var cdn: f64 = _pmn_normal_cdf(pay2);
    var keep2 = bits(sfn) == 0x7FF8000000ABCDEF && bits(cdn) == 0x7FF8000000ABCDEF;
    assert(keep2, "Phi and 1 - Phi return a NaN as it came");

    test_group("what a class-C replay does not pin: zeros, payloads, symmetry");
    var nz: f64 = -0.0;
    var enz: f64 = _pmn_erf(nz);
    var epz: f64 = _pmn_erf(0.0);
    assert(bits(enz) == bits(nz) && bits(epz) == 0, "erf(-0) = -0 and erf(+0) = +0: the sign is kept");
    var cnz: f64 = _pmn_erfc(nz);
    assert(cnz == 1.0, "erfc(-0) = 1");
    var payload: f64 = of_bits(0x7FF8000000ABCDEF);
    var ep: f64 = _pmn_erf(payload);
    var cp: f64 = _pmn_erfc(payload);
    var kept = bits(ep) == 0x7FF8000000ABCDEF && bits(cp) == 0x7FF8000000ABCDEF;
    assert(kept, "a NaN is returned as it came, payload kept");
    var odd = 1;
    var x0: f64 = 0.0000000000000000001;
    for (var j = 0; j < 400; j = j + 1) {
        var nx0: f64 = -x0;
        var u: f64 = _pmn_erf(x0);
        var v: f64 = _pmn_erf(nx0);
        var nv: f64 = -v;
        if (bits(u) != bits(nv)) { odd = 0; }
        x0 = x0 * 1.13;
    }
    assert(odd == 1, "erf(-x) = -erf(x) bit for bit, x from 1e-19 to 170");
    var cmax: f64 = _pmn_erfc(-40.0);
    var mp: f64 = _PMN_F64_MIN_POSITIVE;
    var want_cmax: f64 = 2.0 - mp;
    assert(bits(cmax) == bits(want_cmax) && cmax == 2.0, "erfc(-40) = 2");
    test_group("T1 (M2 part b1): erf and erfc correctly rounded, CORE-MATH's hard cases");
    var wx: f64 = of_bits(0x3C20380EBD7A8F91);
    var we: f64 = _pmn_erf(wx);
    var nwx: f64 = -wx;
    var nwe: f64 = _pmn_erf(nwx);
    assert(bits(we) == 0x3C224D1863C5B5B5 && bits(nwe) == 0xBC224D1863C5B5B5,
      "erf(0x1.0380ebd7a8f91p-61) = 0x1.24d1863c5b5b5p-61, a worst case its fast path can't round");
    var cx: f64 = of_bits(0x3C8C5BF891B4EF6B);
    var ce1: f64 = _pmn_erfc(cx);
    var ncx: f64 = -cx;
    var ce2: f64 = _pmn_erfc(ncx);
    assert(bits(ce1) == 0x3FEFFFFFFFFFFFFF && bits(ce2) == 0x3FF0000000000000,
      "erfc(±0x1.c5bf891b4ef6bp-55) = 1 - 2^-53 and 1: worst cases beside 1");
    var sx: f64 = of_bits(0x403A8F7BFBD15495);
    var se: f64 = _pmn_erfc(sx);
    assert(bits(se) == 0x000667BD620FD95B,
      "erfc(0x1.a8f7bfbd15495p+4) = 0x1.99ef5883f656cp-1024, a subnormal exception");
    var ux: f64 = of_bits(0x403B39DC41E48BFD);
    var ue: f64 = _pmn_erfc(ux);
    var ux1: f64 = of_bits(0x403B39DC41E48BFC);
    var ue1: f64 = _pmn_erfc(ux1);
    assert(bits(ue) == 0 && bits(ue1) == 1,
      "erfc underflows to +0 from 0x1.b39dc41e48bfdp+4, and is the smallest subnormal just below");
    var pt: f64 = _pmn_normal_cdf(-40.0);
    var st: f64 = _pmn_normal_sf(40.0);
    assert(bits(pt) == 0 && bits(st) == 0, "Phi(-40) and 1 - Phi(40) underflow to +0");

    test_group("ln_gamma_known_values (1.3.0's test)");
    var t10: f64 = 0.0000000001;
    var t8: f64 = 0.00000001;
    var g1: f64 = _pmn_ln_gamma(1.0);
    var g5: f64 = _pmn_ln_gamma(5.0);
    var gh: f64 = _pmn_ln_gamma(0.5);
    var l24: f64 = _pmn_ln(24.0);
    var lpi: f64 = _pmn_ln(pi);
    var hlpi: f64 = 0.5 * lpi;
    assert(f64_abs(g1) < t10, "lnGamma(1) = 0");
    assert(f64_abs(g5 - l24) < t8, "lnGamma(5) = ln 24");
    assert(f64_abs(gh - hlpi) < t8, "lnGamma(1/2) = ln sqrt(pi)");

    test_group("stirling_error_continuous_at_cutoff (1.3.0's test)");
    var g10: f64 = _pmn_ln_gamma(10.0);
    var l10: f64 = _pmn_ln(10.0);
    var b1: f64 = 9.5 * l10;
    var b2: f64 = b1 - 10.0;
    var b3: f64 = b2 + _PMN_MATH_LN_SQRT_2PI;
    var below: f64 = g10 - b3;
    var se10: f64 = _pmn_stirling_error(10.0);
    var t14b: f64 = 0.00000000000001;
    assert(f64_abs(se10 - below) < t14b, "the series at 10 agrees with the direct form within 1e-14");

    test_group("ln_beta_matches_ln_gamma_and_is_stable (1.3.0's test)");
    var pa[40];
    var pb[40];
    store64(&pa, 0.5);
    store64(&pb, 0.5);
    store64(&pa + 8, 2.0);
    store64(&pb + 8, 3.0);
    store64(&pa + 16, 0.5);
    store64(&pb + 16, 12.0);
    store64(&pa + 24, 12.0);
    store64(&pb + 24, 0.5);
    store64(&pa + 32, 15.0);
    store64(&pb + 32, 25.0);
    var t12: f64 = 0.000000000001;
    var lb_ok = 1;
    for (var m = 0; m < 5; m = m + 1) {
        var am: f64 = load64(&pa + m * 8);
        var bm: f64 = load64(&pb + m * 8);
        var ga: f64 = _pmn_ln_gamma(am);
        var gb: f64 = _pmn_ln_gamma(bm);
        var abm: f64 = am + bm;
        var gab: f64 = _pmn_ln_gamma(abm);
        var naive: f64 = ga + gb - gab;
        var lb: f64 = _pmn_ln_beta(am, bm);
        if (f64_abs(lb - naive) >= t12) { lb_ok = 0; }
    }
    assert(lb_ok == 1, "ln B = lnGamma(a) + lnGamma(b) - lnGamma(a + b) within 1e-12 on five pairs");
    var big: f64 = 10000000.0;
    var lbb: f64 = _pmn_ln_beta(big, 1.0);
    var lbig: f64 = _pmn_ln(big);
    var nlbig: f64 = -lbig;
    assert(rel_ok(lbb, nlbig, t14b) == 1, "ln B(1e7, 1) = -ln 1e7");

    test_group("ln_gamma_kernel_matches_direct_form (1.3.0's test)");
    var ka[24];
    var kx[24];
    store64(&ka, 10.0);
    store64(&kx, 9.0);
    store64(&ka + 8, 25.0);
    store64(&kx + 8, 30.0);
    store64(&ka + 16, 200.0);
    store64(&kx + 16, 190.0);
    var t11: f64 = 0.00000000001;
    var k_ok = 1;
    for (var k2 = 0; k2 < 3; k2 = k2 + 1) {
        var a2: f64 = load64(&ka + k2 * 8);
        var x2: f64 = load64(&kx + k2 * 8);
        var lx2: f64 = _pmn_ln(x2);
        var ax: f64 = a2 * lx2;
        var lga: f64 = _pmn_ln_gamma(a2);
        var direct: f64 = ax - x2 - lga;
        var kv: f64 = _pmn_ln_gamma_kernel(a2, x2);
        if (f64_abs(kv - direct) >= t11) { k_ok = 0; }
    }
    assert(k_ok == 1, "the Stirling form agrees with a ln x - x - lnGamma(a) within 1e-11");

    test_group("T1 (M2 part b3): lnGamma's poles, its tiny range and its specials");
    var gpz: f64 = _pmn_ln_gamma(0.0);
    var gnz: f64 = _pmn_ln_gamma(nz);
    assert(bits(gpz) == 0x7FF0000000000000 && bits(gnz) == 0x7FF0000000000000, "lnGamma(+0) = lnGamma(-0) = +inf");
    var cut: f64 = _PMN_MATH_LENTZ_TINY;
    var x3: f64 = cut * 0.3;
    var g3: f64 = _pmn_ln_gamma(x3);
    assert(bits(g3) == 0x40859FD60476DE89, "lnGamma(3e-301) = -ln(3e-301), correctly rounded (1.3.0 returned +inf)");
    var gm1: f64 = _pmn_ln_gamma(-1.0);
    var gm2: f64 = _pmn_ln_gamma(-2.0);
    assert(bits(gm1) == 0x7FF0000000000000 && bits(gm2) == 0x7FF0000000000000,
      "lnGamma(-1) = lnGamma(-2) = +inf: poles (1.3.0 returned finite values)");
    var gin: f64 = _pmn_ln_gamma(inf);
    var gnin: f64 = _pmn_ln_gamma(ninf);
    var gnan: f64 = _pmn_ln_gamma(nan);
    assert(bits(gin) == 0x7FF0000000000000 && bits(gnin) == 0x7FF0000000000000 && _pmn_is_nan(gnan) == 1,
      "lnGamma(+inf) = lnGamma(-inf) = +inf, lnGamma(NaN) = NaN (1.3.0: NaN at +inf)");
    var gr1: f64 = _pmn_ln_gamma(1.0);
    var gr2: f64 = _pmn_ln_gamma(2.0);
    assert(bits(gr1) == 0 && bits(gr2) == 0, "lnGamma(1) = lnGamma(2) = +0 exactly");
    var xo1: f64 = of_bits(0x7F573D8E39B3A267);
    var xo2: f64 = of_bits(0x7F5754E31CD072DA);
    var mx: f64 = of_bits(0x7FEFFFFFFFFFFFFF);
    var go1: f64 = _pmn_ln_gamma(xo1);
    var go2: f64 = _pmn_ln_gamma(xo2);
    var gmx: f64 = _pmn_ln_gamma(mx);
    var dov = bits(go1) - 0x7FEFE001FB1FD3AF;
    assert(dov >= 0 - 2 && dov <= 2, "lnGamma(2.55e305) = 1.79e308, within 2 ulp of MPFR, just under the overflow");
    assert(bits(go2) == 0x7FF0000000000000 && bits(gmx) == 0x7FF0000000000000,
      "lnGamma(2.56e305) and lnGamma(MAX) overflow to +inf (P9's prototype gave NaN past the overflow)");

    test_group("T1 (M2 part b3): lnGamma within 2 ulp of MPFR, where 1.3.0 is far off");
    var xn1: f64 = of_bits(0x3FF0000000400000);
    var xn2: f64 = of_bits(0x3FFFFFFFFFC00000);
    var gn1: f64 = _pmn_ln_gamma(xn1);
    var gn2: f64 = _pmn_ln_gamma(xn2);
    var dn1 = bits(gn1) - 0xBE02788CFC066F7F;
    var dn2 = bits(gn2) - 0xBDFB0EE606CE069B;
    assert(dn1 >= 0 - 2 && dn1 <= 2 && dn2 >= 0 - 2 && dn2 <= 2,
      "lnGamma(1 + 2^-30) and lnGamma(2 - 2^-30) within 2 ulp of MPFR (1.3.0: about 10^6 ulp off)");
    var gh2: f64 = _pmn_ln_gamma(0.5);
    var g10b: f64 = _pmn_ln_gamma(10.0);
    var gm25: f64 = _pmn_ln_gamma(-2.5);
    var dh = bits(gh2) - 0x3FE250D048E7A1BD;
    var d10 = bits(g10b) - 0x40299A8921A7F7CF;
    assert(dh >= 0 - 2 && dh <= 2 && d10 >= 0 - 2 && d10 <= 2, "lnGamma(0.5) and lnGamma(10) within 2 ulp of MPFR");
    # x < 0: ADR 009's bound is 2 ulp of max(|lnGamma|, 1), so 2^-51 absolute where |lnGamma| < 1.
    var want25: f64 = of_bits(0xBFACCBF9F5ED0F16);
    var e25: f64 = gm25 - want25;
    var lim25: f64 = of_bits(0x3CC0000000000000);
    assert(f64_abs(e25) <= lim25, "lnGamma(-2.5) within 2 ulp of max(|lnGamma|, 1) = 2^-51 of MPFR (the mixed bound)");

    test_group("bd0's identities (no 1.3.0 test)");
    var d0: f64 = _pmn_bd0(0.0, 2.5);
    var dm: f64 = _pmn_bd0(7.25, 7.25);
    assert(d0 == 2.5 && bits(dm) == 0, "bd0(0, m) = m, bd0(m, m) = +0");
    var bd_ok = 1;
    var xb: f64 = 0.37;
    for (var j2 = 0; j2 < 60; j2 = j2 + 1) {
        var mb: f64 = 3.0;
        var db: f64 = _pmn_bd0(xb, mb);
        var q: f64 = xb / mb;
        var lq: f64 = _pmn_ln(q);
        var xl: f64 = xb * lq;
        var nv: f64 = xl + mb - xb;
        var diff: f64 = db - nv;
        if (db < 0.0 || f64_abs(diff) > t12) { bd_ok = 0; }
        xb = xb * 1.09;
    }
    assert(bd_ok == 1, "bd0(x, 3) >= 0 and = x ln(x/3) + 3 - x within 1e-12, x from 0.37 to 60");

    test_group("ln_beta: Rust's NaN-ignoring min and max, and symmetry");
    var lbn1: f64 = _pmn_ln_beta(nan, 15.0);
    var lbn2: f64 = _pmn_ln_beta(15.0, nan);
    var lb15: f64 = _pmn_ln_beta(15.0, 15.0);
    assert(bits(lbn1) == bits(lb15) && bits(lbn2) == bits(lb15),
      "ln B(NaN, 15) = ln B(15, NaN) = ln B(15, 15), as 1.3.0's min and max read it");
    var sym = 1;
    var sa: f64 = 0.013;
    for (var j3 = 0; j3 < 40; j3 = j3 + 1) {
        var sb: f64 = sa * 0.7 + 0.3;
        var u1: f64 = _pmn_ln_beta(sa, sb);
        var u2: f64 = _pmn_ln_beta(sb, sa);
        if (bits(u1) != bits(u2)) { sym = 0; }
        sa = sa * 1.27;
    }
    assert(sym == 1, "ln B(a, b) = ln B(b, a) bit for bit, a from 0.013 to 145, b = 0.7a + 0.3: all three branches");

    test_group("incomplete_gamma_known_values (1.3.0's test)");
    var p11: f64 = _pmn_regularized_lower_incomplete_gamma(1.0, 1.0);
    var em1: f64 = _pmn_exp(-1.0);
    var w11: f64 = 1.0 - em1;
    assert(f64_abs(p11 - w11) < t15, "P(1, 1) = 1 - 1/e within 1e-15");
    var p30: f64 = _pmn_regularized_lower_incomplete_gamma(3.0, 0.0);
    var p3i: f64 = _pmn_regularized_lower_incomplete_gamma(3.0, inf);
    assert(p30 == 0.0 && p3i == 1.0, "P(3, 0) = 0 and P(3, inf) = 1");
    var p33: f64 = _pmn_regularized_lower_incomplete_gamma(3.0, 3.0);
    assert(rel_ok(p33, 0.5768099188731565, t14) == 1, "P(3, 3) = 0.5768099188731565 (a Poisson sum)");

    test_group("incomplete_gamma_upper_tail_reference (1.3.0's test, 50-digit references)");
    var ga[40];
    var gx[40];
    var gq[40];
    store64(&ga, 10.0);
    store64(&gx, 9.5);
    store64(&gq, 0.5218260222372074);
    store64(&ga + 8, 50.0);
    store64(&gx + 8, 100.0);
    store64(&gq + 8, 0.000000011784500720979422);
    store64(&ga + 16, 1000.0);
    store64(&gx + 16, 1010.0);
    store64(&gq + 16, 0.3723210552630053);
    store64(&ga + 24, 5000.0);
    store64(&gx + 24, 5000.0);
    store64(&gq + 24, 0.4981193659661826);
    store64(&ga + 32, 500000.0);
    store64(&gx + 32, 500000.0);
    store64(&gq + 32, 0.4998119368033945);
    var t11b: f64 = 0.00000000001;
    var up_ok = 1;
    for (var g = 0; g < 5; g = g + 1) {
        var ag: f64 = load64(&ga + g * 8);
        var xg: f64 = load64(&gx + g * 8);
        var qw: f64 = load64(&gq + g * 8);
        var gp, gqv = _pmn_gamma_inc(ag, xg);
        var pq1: f64 = gp + gqv - 1.0;
        if (rel_ok(gqv, qw, t11b) == 0 || f64_abs(pq1) >= t15) { up_ok = 0; }
    }
    assert(up_ok == 1, "Q within 1e-11 of the reference, and P + Q = 1 within 1e-15, on five pairs to a = 5e5");

    test_group("incomplete_gamma_wilson_hilferty_continuity (1.3.0's test)");
    var wh: f64 = _PMN_MATH_GAMMA_WILSON_HILFERTY_SHAPE;
    var swh: f64 = f64_sqrt(wh);
    var xwh: f64 = wh + 2.0 * swh;
    var e12: f64 = 0.000000000001;
    var alo: f64 = wh * (1.0 - e12);
    var ahi: f64 = wh * (1.0 + e12);
    var plo, qlo = _pmn_gamma_inc(alo, xwh);
    var phi, qhi = _pmn_gamma_inc(ahi, xwh);
    var t8b: f64 = 0.00000001;
    assert(f64_abs(plo - phi) < t8b, "P just below and just above a = 1e9 agree within 1e-8");

    test_group("incomplete_gamma_invalid (1.3.0's test)");
    var ip1, iq1 = _pmn_gamma_inc(nan, 1.0);
    var ip2, iq2 = _pmn_gamma_inc(1.0, nan);
    var ip3, iq3 = _pmn_gamma_inc(-1.0, 1.0);
    var ip4, iq4 = _pmn_gamma_inc(inf, 5.0);
    assert(_pmn_is_nan(ip1) == 1 && _pmn_is_nan(ip2) == 1 && _pmn_is_nan(ip3) == 1, "NaN for a NaN argument or a < 0");
    assert(ip4 == 0.0 && iq4 == 1.0, "gamma_inc(inf, 5) = (0, 1)");

    test_group("the iteration budget (no golden row runs a loop out)");
    assert_eq(_pmn_iteration_budget(0.0), 200, "budget(0) = 200");
    assert_eq(_pmn_iteration_budget(nan), 200, "budget(NaN) = 200");
    assert_eq(_pmn_iteration_budget(inf), 200, "budget(inf) = 200");
    assert_eq(_pmn_iteration_budget(-4.0), 200, "budget(-4) = 200");
    assert_eq(_pmn_iteration_budget(1.0), 220, "budget(1) = 220");
    assert_eq(_pmn_iteration_budget(100.0), 400, "budget(100) = 400");
    assert_eq(_pmn_iteration_budget(1000000.0), 20200, "budget(1e6) = 20,200");
    assert_eq(_pmn_iteration_budget(wh), 632655, "budget(1e9) = 632,655: 200 + 20 sqrt(1e9) truncated");
    assert_eq(_pmn_iteration_budget(10000000000.0), 1000000, "budget(1e10) = 1e6, the cap");

    test_group("gamma_inc's edges and wrappers");
    var ep1, eq1 = _pmn_gamma_inc(2.0, nz);
    var ep2, eq2 = _pmn_gamma_inc(2.0, ninf);
    var ep3, eq3 = _pmn_gamma_inc(2.0, inf);
    assert(ep1 == 0.0 && eq1 == 1.0 && ep2 == 0.0 && eq2 == 1.0, "x = -0 and x = -inf give (0, 1)");
    assert(ep3 == 1.0 && eq3 == 0.0, "x = inf gives (1, 0)");
    var ip5, iq5 = _pmn_gamma_inc(0.0, 1.0);
    assert(_pmn_is_nan(ip5) == 1 && _pmn_is_nan(iq5) == 1, "a = 0 gives (NaN, NaN)");
    var wr_ok = 1;
    var e1x: f64 = 0.1;
    for (var g2 = 0; g2 < 30; g2 = g2 + 1) {
        var ag2: f64 = 0.37 * e1x + 0.5;
        var wp, wq = _pmn_gamma_inc(ag2, e1x);
        var lp: f64 = _pmn_regularized_lower_incomplete_gamma(ag2, e1x);
        var uq: f64 = _pmn_regularized_upper_incomplete_gamma(ag2, e1x);
        if (bits(lp) != bits(wp) || bits(uq) != bits(wq)) { wr_ok = 0; }
        e1x = e1x * 1.4;
    }
    assert(wr_ok == 1, "the two wrappers give gamma_inc's P and Q bit for bit, both branches");
    var ex_ok = 1;
    var xe: f64 = 0.05;
    for (var g3 = 0; g3 < 40; g3 = g3 + 1) {
        var pe, qe = _pmn_gamma_inc(1.0, xe);
        var nxe: f64 = -xe;
        var em: f64 = _pmn_exp_m1(nxe);
        var want_p: f64 = -em;
        var want_q: f64 = _pmn_exp(nxe);
        if (ulps(pe, want_p) > 4 || ulps(qe, want_q) > 4) { ex_ok = 0; }
        xe = xe * 1.25;
    }
    # 1.3.0's error grew with x here (exp(kernel) turned the kernel's absolute rounding into relative error: Q(1, 300)
    # 1.4e-14 off with every primitive correctly rounded), so part a3 checked 1e-13. T1 meets ADR 009's 4 ulp.
    assert(ex_ok == 1, "P(1, x) and Q(1, x) within 4 ulp of the correctly rounded 1 - e^-x and e^-x, x 0.05 to 300");

    test_group("the T1 incomplete gamma (part b4) against MPFR: ADR 009's 4 ulp");
    # Expected P and Q: MPFR (scripts/golden/mpfr_ref.gamma_pq: a series or continued fraction at 320 bits or more),
    # as bit patterns: a, x, P, Q.
    assert(gi_ok(0x4008000000000000, 0x4008000000000000, 0x3FE2753A13323223, 0x3FDB158BD99B9BBA) == 1,
      "P(3, 3) and Q(3, 3) (1.3.0's Poisson-sum test)");
    assert(gi_ok(0x4043000000000000, 0x3E9EDEBD6525C993, 0x04A646FDFC751C00, 0x3FF0000000000000) == 1,
      "P(38, 4.6e-7) = 2.93e-286, the deep lower tail (1.3.0's u = (x - a)/a rounds near -1 there)");
    assert(gi_ok(0x4034000000000000, 0x3CD203AF9EE75616, 0x00000000000144FA, 0x3FF0000000000000) == 1,
      "P(20, 1e-15) = 4.11e-319, a subnormal P (2^-1074 units)");
    assert(gi_ok(0x3F847AE147AE147B, 0x3FF0CCCCCCCCCCCD, 0x3FEFEF49A3927722, 0x3F60B65C6D88DE4E) == 1,
      "Q(0.01, 1.05) = 0.00204, small a just under x = 1.1: Q directly, not 1 - P");
    assert(gi_ok(0x3FE0000000000000, 0x3FF170A3D70A3D71, 0x3FEB86A3D2618611, 0x3FC1E570B679E7BB) == 1,
      "P(0.5, 1.09) and Q(0.5, 1.09): erf and erfc of sqrt(1.09)");
    assert(gi_ok(0x3F50624DD2F1A9FC, 0x404E000000000000, 0x3FF0000000000000, 0x398768615FFD1853) == 1,
      "Q(0.001, 60) = 1.44e-31, the continued fraction at the domain's smallest shape");
    assert(gi_ok(0x40F86A0000000000, 0x40F86A0000000000, 0x3FE00371E616C2AB, 0x3FDFF91C33D27AA9) == 1,
      "P(1e5, 1e5) and Q(1e5, 1e5), the domain's largest shape at x = a");
    assert(gi_ok(0x41CD3B5B82E8D18C, 0x41CD3B5A7056C9DB, 0x3FDF8D77F3BC170E, 0x3FE039440621F479) == 1,
      "P(9.81e8, a - 549) = 0.4930: the series' tail-aware stop (P9's last-term stop was 7 ulp off here)");
    assert(gi_ok(0x41CDCD6500000000, 0x41CDCD6500000000, 0x3FE00008D1A927CF, 0x3FDFFFEE5CADB062) == 1,
      "P(1e9, 1e9) and Q(1e9, 1e9), the last shape before Wilson-Hilferty");
    assert(gi_ok(0x01A56E1FC2F8F359, 0x01A56E1FC2F8F359, 0x3FF0000000000000, 0x023CE388C95789CB) == 1,
      "Q(1e-300, 1e-300) = 6.90e-298, a tiny shape: Q is about a(-ln x - gamma)");
    assert(gi_ok(0x01A56E1FC2F8F359, 0x3FE0000000000000, 0x3FF0000000000000, 0x0197FDF98B5CCE39) == 1,
      "P(1e-300, 0.5) = 1 and Q = 5.60e-301: the series' sum over a passes 2^996 (P9's form gave a NaN P)");
    assert(gi_ok(0x000012688B70E62B, 0x3FE0000000000000, 0x3FF0000000000000, 0x00000A4DF544E4AF) == 1,
      "P(1e-310, 0.5) = 1 and Q = 5.60e-311: a subnormal shape, the series scaled by 2^600");
    assert(gi_ok(0x000012688B70E62B, 0x4000000000000000, 0x3FF0000000000000, 0x000000E67222B5FF) == 1,
      "P(1e-310, 2) = 1 and Q = 4.89e-312: a subnormal shape, the continued fraction");

    test_group("incomplete_beta_known_values (1.3.0's test)");
    var i05: f64 = _pmn_regularized_incomplete_beta(0.5, 1.0, 1.0);
    var i03: f64 = _pmn_regularized_incomplete_beta(0.3, 1.0, 1.0);
    assert(f64_abs(i05 - 0.5) < t15 && f64_abs(i03 - 0.3) < t15, "I_x(1, 1) = x at 0.5 and 0.3");
    var i07: f64 = _pmn_regularized_incomplete_beta(0.7, 3.5, 1.0);
    var w07: f64 = _pmn_powf(0.7, 3.5);
    assert(rel_ok(i07, w07, t14) == 1, "I_0.7(3.5, 1) = 0.7^3.5");
    var i02: f64 = _pmn_regularized_incomplete_beta(0.2, 1.0, 4.0);
    var p84: f64 = _pmn_powi(0.8, 4);
    var w02: f64 = 1.0 - p84;
    assert(rel_ok(i02, w02, t14) == 1, "I_0.2(1, 4) = 1 - 0.8^4");

    test_group("incomplete_beta_complement_keeps_tail_precision (1.3.0's test)");
    var bp1, bq1 = _pmn_beta_inc(1.0, 40.0, 0.9, 0.1);
    var w40: f64 = _pmn_powi(0.1, 40);
    var t13b: f64 = 0.0000000000001;
    assert(rel_ok(bq1, w40, t13b) == 1, "1 - I_0.9(1, 40) = 0.1^40, not rounded to 0");
    var bp2, bq2 = _pmn_beta_inc(2.5, 3.5, 0.4, 0.6);
    var s2b: f64 = bp2 + bq2 - 1.0;
    assert(f64_abs(s2b) < t15, "I + (1 - I) = 1 within 1e-15 at (2.5, 3.5, 0.4)");

    test_group("incomplete_beta_large_shape (1.3.0's test: F(2, d) in closed form)");
    var f_ok = 1;
    var d2v: f64 = 10.0;
    for (var f2 = 0; f2 < 4; f2 = f2 + 1) {
        var two_x: f64 = 6.0;
        var den: f64 = two_x + d2v;
        var u: f64 = two_x / den;
        var yv: f64 = d2v / den;
        var r2x: f64 = two_x / d2v;
        var l1: f64 = _pmn_ln_1p(r2x);
        var nh: f64 = -d2v / 2.0;
        var ex: f64 = nh * l1;
        var ee: f64 = _pmn_exp(ex);
        var expected: f64 = 1.0 - ee;
        var hd: f64 = d2v / 2.0;
        var fp, fq = _pmn_beta_inc(1.0, hd, u, yv);
        if (rel_ok(fp, expected, t12) == 0) { f_ok = 0; }
        if (f2 == 0) {
            d2v = 10000.0;
        } else {
            d2v = d2v * 100.0;
        }
    }
    assert(f_ok == 1, "I_u(1, d/2) = 1 - (1 + 2x/d)^(-d/2) within 1e-12, x = 3, d = 10, 1e4, 1e6, 1e8");

    test_group("incomplete_beta_invalid (1.3.0's test)");
    var vp1, vq1 = _pmn_beta_inc(nan, 1.0, 0.5, 0.5);
    var vp2, vq2 = _pmn_beta_inc(1.0, 0.0, 0.5, 0.5);
    var vi: f64 = _pmn_regularized_incomplete_beta(nan, 1.0, 1.0);
    assert(_pmn_is_nan(vp1) == 1 && _pmn_is_nan(vp2) == 1 && _pmn_is_nan(vi) == 1, "NaN for a NaN or a shape of 0");
    var vlo: f64 = _pmn_regularized_incomplete_beta(-1.0, 2.0, 2.0);
    var vhi: f64 = _pmn_regularized_incomplete_beta(2.0, 2.0, 2.0);
    assert(vlo == 0.0 && vhi == 1.0, "I_-1 = 0 and I_2 = 1");

    test_group("beta_inc's edges, symmetry and wrapper");
    var yp, yq = _pmn_beta_inc(2.0, 3.0, 0.3, nan);
    assert(_pmn_is_nan(yp) == 1 && _pmn_is_nan(yq) == 1, "a NaN y gives (NaN, NaN)");
    var zp, zq = _pmn_beta_inc(2.0, 3.0, 0.3, 0.0);
    assert(zp == 1.0 && zq == 0.0, "y <= 0 gives (1, 0) whatever x is");
    var ip6, iq6 = _pmn_beta_inc(3.0, inf, 0.7, 0.3);
    var ip7, iq7 = _pmn_beta_inc(inf, 3.0, 0.3, 0.7);
    assert(_pmn_is_nan(ip6) == 1 && _pmn_is_nan(iq6) == 1 && _pmn_is_nan(ip7) == 1 && _pmn_is_nan(iq7) == 1,
      "an infinite shape gives (NaN, NaN), 1.3.0's value, before the loop (1.3.0 ran its budget on a NaN prefactor)");
    var sym_ok = 1;
    var wr2_ok = 1;
    var sa2: f64 = 0.03;
    for (var j4 = 0; j4 < 30; j4 = j4 + 1) {
        var sb2: f64 = 50.0 / (sa2 + 1.0);
        var spl: f64 = (sa2 + 1.0) / (sa2 + sb2 + 2.0);
        var xs2: f64 = spl * 0.5;
        var ys2: f64 = 1.0 - xs2;
        var p1, q1 = _pmn_beta_inc(sa2, sb2, xs2, ys2);
        var p2, q2 = _pmn_beta_inc(sb2, sa2, ys2, xs2);
        if (bits(p1) != bits(q2) || bits(q1) != bits(p2)) { sym_ok = 0; }
        var rib: f64 = _pmn_regularized_incomplete_beta(xs2, sa2, sb2);
        if (bits(rib) != bits(p1)) { wr2_ok = 0; }
        sa2 = sa2 * 1.4;
    }
    assert(sym_ok == 1, "I_x(a, b) = 1 - I_y(b, a), the two calls bit for bit, on 30 shape pairs");
    assert(wr2_ok == 1, "regularized_incomplete_beta(x, a, b) is beta_inc(a, b, x, 1 - x)'s first value bit for bit");
    var fmax: f64 = mx;
    var hp1, hq1 = _pmn_beta_inc(2.0, fmax, 0.3, 0.7);
    var hp2, hq2 = _pmn_beta_inc(fmax, 3.0, 0.3, 0.7);
    assert(hp1 == 1.0 && hq1 == 0.0 && hp2 == 0.0 && hq2 == 1.0,
      "past max(a, b) = 1e9 Rust's form stays: (1, 0) and (0, 1) for an f64::MAX shape, its prefactor underflowing");

    test_group("the T1 incomplete beta (part b5) against MPFR: ADR 009's 8 ulp");
    assert(bi_ok(0x4042000000000000, 0x402E000000000000, 0x3F32500000000000, 0x3FEFFDB600000000,
        0x27DB676C39DA3BB5, 0x3FF0000000000000, 8) == 1,
      "I_x(36, 15) at x = 293/2^20 = 1.09e-116, 1.3.0's worst I on 3.2's rows (550 ulp)");
    assert(bi_ok(0x4036000000000000, 0x4049000000000000, 0x3FEFF91E00000000, 0x3F4B880000000000,
        0x3FF0000000000000, 0x23B090CA793ECDD1, 8) == 1,
      "1 - I_x(22, 50) at x = 1047695/2^20 = 8.90e-137, 1.3.0's worst 1 - I on 3.2's rows (583 ulp)");
    assert(bi_ok(0x3F50624DD2F1A9FC, 0x40D8374000000000, 0x3DA19799812DEA11, 0x3FEFFFFFFFFEE686,
        0x3FEF87317C1348DC, 0x3F8E33A0FB2DC8ED, 8) == 1,
      "1 - I at a = 0.001, b = 24797, x = 8e-12 by the power series (P9's first form: 3.6e10 ulp)");
    assert(bi_ok(0x4059000000000000, 0x3FF0000000000000, 0x3F50624DD2F1A9FC, 0x3FEFF7CED916872B,
        0x01A56E1FC2F8F365, 0x3FF0000000000000, 8) == 1,
      "I_0.001(100, 1) = 0.001^100 = 1e-300, the prefactor's exponent below -1000 (P9's first form zeroed it)");
    assert(bi_ok(0x3FE0000000000000, 0x4000000000000000, 0x0000000000000001, 0x3FF0000000000000,
        0x1E68000000000000, 0x3FF0000000000000, 8) == 1, "I at x = 2^-1074 (a = 0.5, b = 2): 3.33e-162");
    assert(bi_ok(0x4000000000000000, 0x3FE0000000000000, 0x3FF0000000000000, 0x0000000000000001,
        0x3FF0000000000000, 0x1E68000000000000, 8) == 1,
      "1 - I at y = 2^-1074 given exactly (a = 2, b = 0.5): 3.33e-162, though x rounds to 1");
    assert(bi_ok(0x41CDCD6500000000, 0x41CDCD6500000000, 0x3FE00014F8B588E3, 0x3FDFFFD60E94EE39,
        0x3FEA100066216984, 0x3FC7BFFE677A59F0, 8) == 1, "a = b = 1e9 at x = 0.50001, the last shapes T1 computes");

    test_group("the T1 incomplete beta: what part b5 fixed past P9's sets, within 1 ulp");
    assert(bi_ok(0x000000000000032A, 0x042D3C66B278A405, 0x3027288E1271F513, 0x3FF0000000000000,
        0x3FF0000000000000, 0x392BB4A3BC57EF00, 1) == 1,
      "two tiny shapes, a = 4e-321, b = 1.5e-288: 1 - I = a/(a + b) = 2.67e-33 (P9's form: 1e-318)");
    assert(bi_ok(0x000000000AEE4408, 0x094866615AFBAF90, 0x3D334FBFACAA1FFA, 0x3FEFFFFFFFFFFD96,
        0x3FF0000000000000, 0x352CABBC9121B7DB, 1) == 1,
      "a subnormal shape over a tiny one, a = 9.1e-316, b = 6.1e-264: a/b scaled first (unscaled: 4.4e7 ulp)");
    assert(bi_ok(0x2EE4280904516763, 0x408C48BC22221CA6, 0x3D6CFED0888F5B0F, 0x3FEFFFFFFFFFE301,
        0x3FF0000000000000, 0x2F29BFE05DFCE701, 1) == 1,
      "1 - I = 1.70e-81 at a = 8.3e-83, b = 905: lnGamma(1 + a) from the zeta series (as lnGamma(a) + ln a: 2e14 ulp)");
    assert(bi_ok(0x40410776F4F9B476, 0x000000000BE87395, 0x3FF0000000000000, 0x36C0AFD7B76AFEBA,
        0x000000048C20CFEE, 0x3FF0000000000000, 1) == 1,
      "I = 9.65e-314 at a = 34, b = 9.9e-316: (b - 1/2)ln(1 + a/b) as a(1 - 1/(2b))ln(1 + t)/t (directly: 18 units)");
    assert(bi_ok(0x3A94559FC5582032, 0x352CC537BD93547F, 0x3FF0000000000000, 0x000000000A766C6A,
        0x3A86A341E7E488D5, 0x3FF0000000000000, 1) == 1,
      "I = 9.14e-27 at a = 1.6e-26, b = 1.5e-52, y = 8.7e-316 by the power series (1 - I's complement alone: 0)");
    assert(bi_ok(0x41CA324CF8139F71, 0x41A927C0D80D62A0, 0x3FE9CE53EDDE7348, 0x3FC8C6B0488632E0,
        0x3FEF8B6E0409D08C, 0x3F8D247EFD8BDCEF, 1) == 1,
      "a = 8.8e8, b = 2.1e8 at the switch: the brcomp prefactor (the Stirling-difference form alone: 50,109 ulp)");
    var sp1, sq1 = _pmn_beta_inc(2.0, 3.0, 0.3, of_bits(1));
    assert(sp1 == 1.0 && sq1 == 0.0,
      "y = 2^-1074, not 1 - x: y is the exact one, x = 1 - y, and the side is chosen on it: (1, 0), not (0, 1)");
    assert(bi_ok(0x41DDCD6500000000, 0x41E65A0BC0000000, 0x3FD999C38B04AB60, 0x3FE3331E3A7DAA50,
        0x3FED9E0B083CE55C, 0x3FB30FA7BE18D51C, 0) == 1,
      "past max(a, b) = 1e9 Rust's form stays: (2e9, 3e9, 0.40001) is its value bit for bit (5,631, 45,046 ulp off)");
    assert(bi_ok(0x4014000000000000, 0x41DDCD6500000000, 0x3E249DA7E361CE4C, 0x3FEFFFFFFEB62582,
        0x3FE0C27D01A0014E, 0x3FDE7B05FCBFFD64, 0) == 1,
      "and with one shape past 1e9: (5, 2e9, 2.4e-9) is Rust's form's value bit for bit (45 and 90 ulp off)");
    assert(bi_ok(0x3F6CC44424EA138B, 0x41C252D10CD1E316, 0x3DFCE52E65792666, 0x3FEFFFFFFFC635A3,
        0x3FEFE2B310ED5684, 0x3F6D4CEF12A97BB7, 1) == 1,
      "1 - I at a = 0.0035, b = 6.1e8 by the power series, ln(aB) as a difference (P9's form: 118 ulp)");
    assert(bi_ok(0x41C14347DDFE6D66, 0x3F78E51D52888114, 0x3FEFFFFFFFAE5581, 0x3E046A9FC0000000,
        0x3F741963A6FCDFE2, 0x3FEFD7CD38B20640, 1) == 1,
      "I at a = 5.8e8, b = 0.0061, the shapes swapped (P9's form: 24 ulp)");
    assert(bi_ok(0x3F59AAB588341D27, 0x41C6FD8AFB317AC8, 0x3C153220F65EDD21, 0x3FF0000000000000,
        0x3FEEEEC355D8C916, 0x3FA113CAA2736E9F, 1) == 1,
      "1 - I at a = 0.0016, b = 7.7e8: ln B by the Stirling difference (P9's form: 3 ulp)");
    assert(bi_ok(0x41CC7B51EDE67FB4, 0x41C1A7FB8284F328, 0x3FE3C0CA59CCCF5F, 0x3FD87E6B4C666142,
        0x3F6D7C410D988505, 0x3FEFE283BEF2677B, 1) == 1,
      "I at a = 9.6e8, b = 5.9e8: the brcomp prefactor (P9's form: 2 ulp)");

    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
