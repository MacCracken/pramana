# dist.bcyr — the distributions of src/dist*.cyr (M3): ns per call.
#
# 4,096 seeded arguments (or pairs) per row, cycled 250 times (1,024,000 calls), as tests/special.bcyr. The Rust twin
# is scripts/probes/rust/src/bin/m3_dist.rs: the same xorshift, regions and loop, 1.3.0's distributions on glibc's
# primitives. Each side prints the row's sum and an FNV-1a digest of its 4,096 results' bits; they differ where a
# glibc primitive misrounds or a T1 function (here Φ, M2 part b2) moves a value. The record is
# docs/benchmarks-rust-v-cyrius.md. Part a1: Normal; part a2: Uniform, Exponential and Bernoulli; part a3: Cauchy and
# Weibull; part b1: Gamma and ChiSquared; part b2: Beta, StudentT and FDistribution.

include "tests/lib.cyr"

var g_rng = 0x2545F4914F6CDD1D;
var g_xs = 0;
var g_ys = 0;
var g_sb = 0;

fn next(): i64 {
    var x = g_rng;
    x = x ^ (x >> 12);
    x = x ^ (x << 25);
    x = x ^ (x >> 27);
    g_rng = x;
    return x * 0x2545F4914F6CDD1D;
}

fn unit(): f64 {
    var top = next() >> 11;
    var a: f64 = f64_from(top);
    var d: f64 = 9007199254740992.0;
    return a / d;
}

# One row's function at (x, y), with g the generator a draw takes its uniforms from.
# `which`: 0 N(0, 1)'s pdf at x, 1 N(0, 1)'s cdf at x, 2 one draw of N(x, y), 3 N(x, y) to JSON and back (the mean
# read back), 4 N(x, y)'s Debug (the text's length); 5 and up, part a2's rows (eval_a2).
fn eval(which, x: f64, y: f64, g: *PmnSimpleRng): f64 {
    if (which >= 24) { return eval_b2(which, x, y, g); }
    if (which >= 19) { return eval_b1(which, x, y, g); }
    if (which >= 12) { return eval_a3(which, x, y, g); }
    if (which >= 5) { return eval_a2(which, x, y, g); }
    var r: f64 = 0.0;
    var n: PmnNormal;
    if (which <= 1) {
        if (PmnNormal_new(&n, 0.0, 1.0) != PMN_ERR_NONE) { return 0.0; }
        if (which == 0) { r = n.pdf(x); }
        if (which == 1) { r = n.cdf(x); }
        return r;
    }
    if (PmnNormal_new(&n, x, y) != PMN_ERR_NONE) { return 0.0; }
    if (which == 2) { r = n.sample(g); }
    if (which == 3) {
        store64(g_sb + 8, 0);
        if (n.to_json(g_sb) == PMN_ERR_NONE) {
            var back: PmnNormal;
            if (PmnNormal_from_json(&back, load64(g_sb), load64(g_sb + 8)) == PMN_ERR_NONE) { r = back.mean; }
        }
    }
    if (which == 4) {
        store64(g_sb + 8, 0);
        if (n.debug(g_sb, 0) == PMN_ERR_NONE) { r = f64_from(load64(g_sb + 8)); }
    }
    return r;
}

# Part a2's rows: 5 U(−1, 5)'s cdf at x, 6 one draw of U(x, x + y), 7 Exp(2.5)'s pdf at x, 8 its cdf at x, 9 one draw
# of Exp(y), 10 Bernoulli(0.3)'s cdf at x, 11 one draw of Bernoulli(y).
fn eval_a2(which, x: f64, y: f64, g: *PmnSimpleRng): f64 {
    var r: f64 = 0.0;
    var u: PmnUniform;
    var e: PmnExponential;
    var b: PmnBernoulli;
    if (which == 5) {
        if (PmnUniform_new(&u, -1.0, 5.0) == PMN_ERR_NONE) { r = u.cdf(x); }
    } elif (which == 6) {
        var hi: f64 = x + y;
        if (PmnUniform_new(&u, x, hi) == PMN_ERR_NONE) { r = u.sample(g); }
    } elif (which == 7) {
        if (PmnExponential_new(&e, 2.5) == PMN_ERR_NONE) { r = e.pdf(x); }
    } elif (which == 8) {
        if (PmnExponential_new(&e, 2.5) == PMN_ERR_NONE) { r = e.cdf(x); }
    } elif (which == 9) {
        if (PmnExponential_new(&e, y) == PMN_ERR_NONE) { r = e.sample(g); }
    } elif (which == 10) {
        if (PmnBernoulli_new(&b, 0.3) == PMN_ERR_NONE) { r = b.cdf(x); }
    } elif (which == 11) {
        if (PmnBernoulli_new(&b, y) == PMN_ERR_NONE) { r = b.sample(g); }
    }
    return r;
}

# Part a3's rows: 12 Cauchy(0, 1)'s pdf at x, 13 its cdf at x, 14 one draw of Cauchy(x, y), 15 Weibull(2, 1)'s pdf
# at x, 16 its cdf at x, 17 Weibull(y, 1)'s mean, 18 one draw of Weibull(y, x).
fn eval_a3(which, x: f64, y: f64, g: *PmnSimpleRng): f64 {
    var r: f64 = 0.0;
    var c: PmnCauchy;
    var w: PmnWeibull;
    if (which == 12) {
        if (PmnCauchy_new(&c, 0.0, 1.0) == PMN_ERR_NONE) { r = c.pdf(x); }
    } elif (which == 13) {
        if (PmnCauchy_new(&c, 0.0, 1.0) == PMN_ERR_NONE) { r = c.cdf(x); }
    } elif (which == 14) {
        if (PmnCauchy_new(&c, x, y) == PMN_ERR_NONE) { r = c.sample(g); }
    } elif (which == 15) {
        if (PmnWeibull_new(&w, 2.0, 1.0) == PMN_ERR_NONE) { r = w.pdf(x); }
    } elif (which == 16) {
        if (PmnWeibull_new(&w, 2.0, 1.0) == PMN_ERR_NONE) { r = w.cdf(x); }
    } elif (which == 17) {
        if (PmnWeibull_new(&w, y, 1.0) == PMN_ERR_NONE) { r = w.mean(); }
    } elif (which == 18) {
        if (PmnWeibull_new(&w, y, x) == PMN_ERR_NONE) { r = w.sample(g); }
    }
    return r;
}

# Part b1's rows: 19 Gamma(2.5, 2)'s pdf at x, 20 its cdf at x, 21 one draw of Gamma(y, 1), 22 χ²(5)'s cdf at x, 23 one
# draw of χ²(y).
fn eval_b1(which, x: f64, y: f64, g: *PmnSimpleRng): f64 {
    var r: f64 = 0.0;
    var d: PmnGamma;
    var c: PmnChiSquared;
    if (which == 19) {
        if (PmnGamma_new(&d, 2.5, 2.0) == PMN_ERR_NONE) { r = d.pdf(x); }
    } elif (which == 20) {
        if (PmnGamma_new(&d, 2.5, 2.0) == PMN_ERR_NONE) { r = d.cdf(x); }
    } elif (which == 21) {
        if (PmnGamma_new(&d, y, 1.0) == PMN_ERR_NONE) { r = d.sample(g); }
    } elif (which == 22) {
        if (PmnChiSquared_new(&c, 5.0) == PMN_ERR_NONE) { r = c.cdf(x); }
    } elif (which == 23) {
        if (PmnChiSquared_new(&c, y) == PMN_ERR_NONE) { r = c.sample(g); }
    }
    return r;
}

# Part b2's rows: 24 Beta(2, 5)'s pdf at x, 25 its cdf at x, 26 one draw of Beta(y, y), 27 t(5)'s pdf at x, 28 its
# cdf at x, 29 one draw of t(y), 30 F(4, 9)'s cdf at x, 31 one draw of F(y, y).
fn eval_b2(which, x: f64, y: f64, g: *PmnSimpleRng): f64 {
    var r: f64 = 0.0;
    var b: PmnBeta;
    var t: PmnStudentT;
    var d: PmnFDistribution;
    if (which == 24) {
        if (PmnBeta_new(&b, 2.0, 5.0) == PMN_ERR_NONE) { r = b.pdf(x); }
    } elif (which == 25) {
        if (PmnBeta_new(&b, 2.0, 5.0) == PMN_ERR_NONE) { r = b.cdf(x); }
    } elif (which == 26) {
        if (PmnBeta_new(&b, y, y) == PMN_ERR_NONE) { r = b.sample(g); }
    } elif (which == 27) {
        if (PmnStudentT_new(&t, 5.0) == PMN_ERR_NONE) { r = t.pdf(x); }
    } elif (which == 28) {
        if (PmnStudentT_new(&t, 5.0) == PMN_ERR_NONE) { r = t.cdf(x); }
    } elif (which == 29) {
        if (PmnStudentT_new(&t, y) == PMN_ERR_NONE) { r = t.sample(g); }
    } elif (which == 30) {
        if (PmnFDistribution_new(&d, 4.0, 9.0) == PMN_ERR_NONE) { r = d.cdf(x); }
    } elif (which == 31) {
        if (PmnFDistribution_new(&d, y, y) == PMN_ERR_NONE) { r = d.sample(g); }
    }
    return r;
}

fn row(name: cstring, which, lo: f64, hi: f64, lo2: f64, hi2: f64): i64 {
    for (var j = 0; j < 4096; j = j + 1) {
        var w: f64 = hi - lo;
        var u: f64 = unit();
        var x0: f64 = lo + w * u;
        store64(g_xs + j * 8, x0);
        var w2: f64 = hi2 - lo2;
        var u2: f64 = unit();
        var y0: f64 = lo2 + w2 * u2;
        store64(g_ys + j * 8, y0);
    }
    var g: PmnSimpleRng;
    if (PmnSimpleRng_new(&g, 42) != PMN_ERR_NONE) { return 1; }
    var s: f64 = 0.0;
    var b = bench_new(name);
    bench_batch_start(b);
    for (var k = 0; k < 250; k = k + 1) {
        for (var i = 0; i < 4096; i = i + 1) {
            var x: f64 = load64(g_xs + i * 8);
            var y: f64 = load64(g_ys + i * 8);
            var r: f64 = eval(which, x, y, &g);
            s = s + r;
        }
    }
    bench_batch_stop(b, 1024000);
    var sb: f64 = s;
    print("  ", 2);
    print(name, strlen(name));
    print(", the sum: ", 11);
    fmt_hex(load64(&sb));
    println("");
    # The digest: FNV-1a over the 4,096 results' bit patterns, untimed, a draw row from a fresh generator.
    if (PmnSimpleRng_new(&g, 42) != PMN_ERR_NONE) { return 1; }
    var dg = 0xCBF29CE484222325;
    for (var t = 0; t < 4096; t = t + 1) {
        var xd: f64 = load64(g_xs + t * 8);
        var yd: f64 = load64(g_ys + t * 8);
        var rd: f64 = eval(which, xd, yd, &g);
        dg = (dg ^ load64(&rd)) * 0x100000001B3;
    }
    print("  ", 2);
    print(name, strlen(name));
    print(", the digest: ", 14);
    fmt_hex(dg);
    println("");
    bench_report(b);
    return 0;
}

fn main(): i64 {
    alloc_init();
    g_xs = alloc(4096 * 8);
    g_ys = alloc(4096 * 8);
    g_sb = str_builder_new();
    row("Normal::pdf, N(0, 1), x in [-10, 10)", 0, -10.0, 10.0, 0.0, 1.0);
    row("Normal::cdf, N(0, 1), x in [-10, 10)", 1, -10.0, 10.0, 0.0, 1.0);
    row("Normal::cdf, N(0, 1), x in [-38, -1.2)", 1, -38.0, -1.2, 0.0, 1.0);
    row("Normal::sample, mean in [-10, 10), sd in [0.1, 10)", 2, -10.0, 10.0, 0.1, 10.0);
    row("Normal, to JSON and back, mean in [-10, 10), sd in [0.1, 10)", 3, -10.0, 10.0, 0.1, 10.0);
    row("Normal, Debug, mean in [-10, 10), sd in [0.1, 10)", 4, -10.0, 10.0, 0.1, 10.0);
    row("Uniform::cdf, U(-1, 5), x in [-2, 6)", 5, -2.0, 6.0, 0.0, 1.0);
    row("Uniform::sample, min in [-10, 10), width in [0.1, 10)", 6, -10.0, 10.0, 0.1, 10.0);
    row("Exponential::pdf, Exp(2.5), x in [0, 10)", 7, 0.0, 10.0, 0.0, 1.0);
    row("Exponential::cdf, Exp(2.5), x in [0, 10)", 8, 0.0, 10.0, 0.0, 1.0);
    row("Exponential::cdf, Exp(2.5), x in [0, 0.01)", 8, 0.0, 0.01, 0.0, 1.0);
    row("Exponential::sample, lambda in [0.1, 10)", 9, 0.0, 1.0, 0.1, 10.0);
    row("Bernoulli::cdf, p = 0.3, x in [-1, 2)", 10, -1.0, 2.0, 0.0, 1.0);
    row("Bernoulli::sample, p in [0, 1)", 11, 0.0, 1.0, 0.0, 1.0);
    row("Cauchy::pdf, Cauchy(0, 1), x in [-10, 10)", 12, -10.0, 10.0, 0.0, 1.0);
    row("Cauchy::cdf, Cauchy(0, 1), x in [-10, 10)", 13, -10.0, 10.0, 0.0, 1.0);
    row("Cauchy::sample, x0 in [-10, 10), gamma in [0.1, 10)", 14, -10.0, 10.0, 0.1, 10.0);
    row("Weibull::pdf, Weibull(2, 1), x in [0, 3)", 15, 0.0, 3.0, 0.0, 1.0);
    row("Weibull::cdf, Weibull(2, 1), x in [0, 3)", 16, 0.0, 3.0, 0.0, 1.0);
    row("Weibull::mean, k in [0.1, 10), lambda = 1", 17, 0.0, 1.0, 0.1, 10.0);
    row("Weibull::sample, lambda in [0.1, 10), k in [0.1, 10)", 18, 0.1, 10.0, 0.1, 10.0);
    row("Gamma::pdf, Gamma(2.5, 2), x in [0, 20)", 19, 0.0, 20.0, 0.0, 1.0);
    row("Gamma::cdf, Gamma(2.5, 2), x in [0, 20)", 20, 0.0, 20.0, 0.0, 1.0);
    row("Gamma::sample, alpha in [0.1, 10), beta = 1", 21, 0.0, 1.0, 0.1, 10.0);
    row("ChiSquared::cdf, chi2(5), x in [0, 20)", 22, 0.0, 20.0, 0.0, 1.0);
    row("ChiSquared::sample, df in [1, 30)", 23, 0.0, 1.0, 1.0, 30.0);
    row("Beta::pdf, Beta(2, 5), x in [0, 1)", 24, 0.0, 1.0, 0.0, 1.0);
    row("Beta::cdf, Beta(2, 5), x in [0, 1)", 25, 0.0, 1.0, 0.0, 1.0);
    row("Beta::sample, alpha = beta in [0.5, 10)", 26, 0.0, 1.0, 0.5, 10.0);
    row("StudentT::pdf, t(5), x in [-10, 10)", 27, -10.0, 10.0, 0.0, 1.0);
    row("StudentT::cdf, t(5), x in [-10, 10)", 28, -10.0, 10.0, 0.0, 1.0);
    row("StudentT::sample, df in [1, 30)", 29, 0.0, 1.0, 1.0, 30.0);
    row("FDistribution::cdf, F(4, 9), x in [0, 10)", 30, 0.0, 10.0, 0.0, 1.0);
    row("FDistribution::sample, d1 = d2 in [1, 30)", 31, 0.0, 1.0, 1.0, 30.0);
    return 0;
}

var rc = main();
sys_exit_group(rc);
