# json.bcyr — the JSON core (M1 parts d3a, d3b and d4): a whole decode, or a whole write, per document.
#
# Each row decodes one document 10^4 times through _pmn_json_decode (the pre-pass, a pool claim, bayan's parse, the
# reader, the release). The documents are built from mathx.bcyr's xorshift with src/fmtf.cyr, which writes
# serde_json's text, so the Rust twin (`m1_primitives.rs`, its `json` rows: serde_json::from_slice with
# float_roundtrip) parses byte-identical text: each side prints every document's length and FNV-1a hash. The record is
# docs/benchmarks-rust-v-cyrius.md, which keeps the twin's numbers: the Rust twins went with the Rust tooling (ADR
# 010).

include "tests/lib.cyr"

var g_rng = 0x2545F4914F6CDD1D;
var g_out = 0;

# The next xorshift64* word of g_rng, the bench's seeded generator.
fn next(): i64 {
    var x = g_rng;
    x = x ^ (x >> 12);
    x = x ^ (x << 25);
    x = x ^ (x >> 27);
    g_rng = x;
    return x * 0x2545F4914F6CDD1D;
}

# A uniform draw in [0, 1): next()'s top 53 bits over 2^53.
fn unit(): f64 {
    var top = next() >> 11;
    var a: f64 = f64_from(top);
    var d: f64 = 9007199254740992.0;
    return a / d;
}

# Writes the word x, read as unsigned, in decimal at buf; returns the digit count (at most 20).
fn dec_u64(x, buf): i64 {
    if (x == 0) {
        store8(buf, 48);
        return 1;
    }
    var tmp[24];
    var k = 0;
    var r = x;
    while (r != 0) {
        var q = (r >> 1) / 5;                   # r / 10, unsigned: the logical shift clears the sign
        store8(&tmp + k, 48 + r - q * 10);
        k = k + 1;
        r = q;
    }
    var i = 0;
    while (i < k) {
        store8(buf + i, load8(&tmp + k - 1 - i));
        i = i + 1;
    }
    return k;
}

# FNV-1a over the n bytes at p.
fn fnv(p, n): i64 {
    var h = 0xCBF29CE484222325;
    for (var i = 0; i < n; i = i + 1) { h = (h ^ load8(p + i)) * 0x100000001B3; }
    return h;
}

# Reads a Vec<f64> into g_out.
fn dec_vec_f64(root, ctx): i64 {
    return _pmn_json_vec_f64(root, g_out, 4096);
}

# Reads a Vec<u64> into g_out.
fn dec_vec_u64(root, ctx): i64 {
    return _pmn_json_vec_u64(root, g_out, 4096);
}

# Reads a Vec<Vec<f64>> into g_out, row-major.
fn dec_mat(root, ctx): i64 {
    var sh[24];
    var e = _pmn_json_mat_shape(root, &sh);
    if (e != PMN_ERR_NONE) { return e; }
    return _pmn_json_mat_f64(root, g_out, load64(&sh), load64(&sh + 8));
}

# Reads a String into g_out.
fn dec_str(root, ctx): i64 {
    var w[16];
    var e = _pmn_json_str(root, &w);
    if (e != PMN_ERR_NONE) { return e; }
    memcpy(g_out, load64(&w), load64(&w + 8));
    return PMN_ERR_NONE;
}

# Reads an f64 into g_out.
fn dec_f64(root, ctx): i64 {
    return _pmn_json_f64(root, g_out);
}

# What M3's Normal decoder will do: serde's struct rules, both fields read, then Normal::new's checks (a finite mean;
# a finite, positive std_dev).
fn dec_normal(root, ctx): i64 {
    var names[16];
    store64(&names, "mean");
    store64(&names + 8, "std_dev");
    var sl[16];
    var e = _pmn_json_struct(root, &names, 2, &sl);
    if (e != PMN_ERR_NONE) { return e; }
    e = _pmn_json_f64(load64(&sl), g_out);
    if (e != PMN_ERR_NONE) { return e; }
    e = _pmn_json_f64(load64(&sl + 8), g_out + 8);
    if (e != PMN_ERR_NONE) { return e; }
    var mean: f64 = load64(g_out);
    var sd: f64 = load64(g_out + 8);
    if (_pmn_is_finite(mean) == 0 || _pmn_is_finite(sd) == 0 || (sd > 0.0) == 0) { return PMN_ERR_INVALID_PARAMETER; }
    return PMN_ERR_NONE;
}

# Reads a Kernel, serde's unit-variant form, into g_out.
fn dec_kernel(root, ctx): i64 {
    var kn[32];
    store64(&kn, "Gaussian");
    store64(&kn + 8, "Epanechnikov");
    store64(&kn + 16, "Uniform");
    store64(&kn + 24, "Triangular");
    return _pmn_json_unit_variant(root, &kn, 4, g_out);
}

# Prints the length and FNV-1a hash of the document in sb, then times 10^4 decodes of it by fp.
fn row(name: cstring, sb, fp): i64 {
    var p = load64(sb);
    var n = load64(sb + 8);
    print("  ", 2);
    print(name, strlen(name));
    print(": ", 2);
    fmt_int(n);
    print(" bytes, fnv ", 12);
    fmt_hex(fnv(p, n));
    println("");
    var bad = 0;
    var b = bench_new(name);
    bench_batch_start(b);
    for (var i = 0; i < 10000; i = i + 1) {
        if (_pmn_json_decode(p, n, fp, 0) != PMN_ERR_NONE) { bad = bad + 1; }
    }
    bench_batch_stop(b, 10000);
    bench_report(b);
    if (bad != 0) { println("  DECODE FAILED"); }
    return 0;
}

# Writes one value 10^4 times into one cleared builder (`which`: 0 the Vec<f64>, 1 a Normal, 2 the string, 3 an error
# code) and prints the text's length and FNV-1a hash.
fn wrow(name: cstring, which, vals, sp, sn): i64 {
    var out = str_builder_new();
    var bad = 0;
    var m05: f64 = 0.5;
    var s225: f64 = 2.25;
    var b = bench_new(name);
    bench_batch_start(b);
    for (var i = 0; i < 10000; i = i + 1) {
        store64(out + 8, 0);
        var e = PMN_ERR_NONE;
        if (which == 0) { e = _pmn_json_w_vec_f64(out, vals, 100); }
        if (which == 1) {
            e = _pmn_json_w_key(out, "mean", 1) | _pmn_json_w_f64(out, m05) | _pmn_json_w_key(out, "std_dev", 0);
            e = e | _pmn_json_w_f64(out, s225) | _pmn_json_w_lit(out, "}");
        }
        if (which == 2) { e = _pmn_json_w_str(out, sp, sn); }
        if (which == 3) { e = pmn_err_to_json(PMN_ERR_DIMENSION_MISMATCH, out); }
        if (e != PMN_ERR_NONE) { bad = bad + 1; }
    }
    bench_batch_stop(b, 10000);
    print("  ", 2);
    print(name, strlen(name));
    print(": ", 2);
    fmt_int(load64(out + 8));
    print(" bytes, fnv ", 12);
    fmt_hex(fnv(load64(out), load64(out + 8)));
    println("");
    bench_report(b);
    if (bad != 0) { println("  WRITE FAILED"); }
    return 0;
}

# Runs the bench rows below, printing each one's timing and the result a run can be checked by.
fn main(): i64 {
    alloc_init();
    g_out = alloc(4096 * 8);
    var sb = str_builder_new();
    var vals = alloc(800);
    str_builder_putc(sb, 91);
    for (var i = 0; i < 100; i = i + 1) {
        if (i > 0) { str_builder_putc(sb, 44); }
        var u: f64 = unit();
        var x: f64 = 2000000.0 * u - 1000000.0;
        store64(vals + i * 8, x);
        _pmn_fmt_f64_json(sb, x);
    }
    str_builder_putc(sb, 93);
    row("Vec<f64>, 100 values in [-1e6, 1e6)", sb, &dec_vec_f64);
    store64(sb + 8, 0);
    str_builder_putc(sb, 91);
    for (var r = 0; r < 10; r = r + 1) {
        if (r > 0) { str_builder_putc(sb, 44); }
        str_builder_putc(sb, 91);
        for (var c = 0; c < 10; c = c + 1) {
            if (c > 0) { str_builder_putc(sb, 44); }
            var y: f64 = unit();
            _pmn_fmt_f64_json(sb, y);
        }
        str_builder_putc(sb, 93);
    }
    str_builder_putc(sb, 93);
    row("Vec<Vec<f64>>, 10 x 10 in [0, 1)", sb, &dec_mat);
    store64(sb + 8, 0);
    str_builder_putc(sb, 91);
    for (var k = 0; k < 100; k = k + 1) {
        if (k > 0) { str_builder_putc(sb, 44); }
        var dig[24];
        var dn = dec_u64(next(), &dig);
        for (var j = 0; j < dn; j = j + 1) { str_builder_putc(sb, load8(&dig + j)); }
    }
    str_builder_putc(sb, 93);
    row("Vec<u64>, 100 words", sb, &dec_vec_u64);
    store64(sb + 8, 0);
    str_builder_add_cstr(sb, "\"");
    for (var q = 0; q < 8; q = q + 1) { str_builder_add_cstr(sb, "abc\\n\\u00e9\\\"xyz"); }
    str_builder_add_cstr(sb, "\"");
    row("String, 8 x abc\\n\\u00e9\\\"xyz", sb, &dec_str);
    store64(sb + 8, 0);
    str_builder_add_cstr(sb, "1.5");
    row("f64, 1.5", sb, &dec_f64);
    store64(sb + 8, 0);
    str_builder_add_cstr(sb, "{\"mean\":0.5,\"std_dev\":2.25}");
    row("Normal, its two fields and checks", sb, &dec_normal);
    store64(sb + 8, 0);
    str_builder_add_cstr(sb, "\"Epanechnikov\"");
    row("Kernel, a unit variant", sb, &dec_kernel);
    wrow("write a Vec<f64>, the 100 values", 0, vals, 0, 0);
    wrow("write a Normal", 1, 0, 0, 0);
    var raw = "abc\ndef\"ghi\\jkl\tmn\u00e9o\u0001pq";
    wrow("write a String, 5 escapes in 24 bytes", 2, 0, raw, strlen(raw));
    wrow("write an error code", 3, 0, 0, 0);
    return 0;
}

var rc = main();
sys_exit_group(rc);
