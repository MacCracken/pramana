# combinatorics.tcyr — counting (M1 part e2; port plan D10, ADR 007 row 4).
#
# tests/parity.tcyr replays 1.3.0's results on 2,405 rows (tests/golden/combinatorics.tsv). These tests carry 1.3.0's
# own unit tests over, and name what the port adds: the u128 arithmetic at its limits, the out-pointer written only on
# success, and every u64 compared as unsigned.

include "tests/lib.cyr"

# 1 when x holds (lo, hi).
fn is(x: *PmnU128, lo, hi): i64 {
    if (x.lo == lo && x.hi == hi) { return 1; }
    return 0;
}

fn main() {
    alloc_init();
    var x: PmnU128;
    var umax = 0 - 1;

    test_group("factorial (1.3.0's tests)");
    assert(pmn_factorial(0, &x) == PMN_ERR_NONE && is(&x, 1, 0) == 1, "0! = 1");
    assert(pmn_factorial(5, &x) == PMN_ERR_NONE && is(&x, 120, 0) == 1, "5! = 120");
    assert(pmn_factorial(20, &x) == PMN_ERR_NONE && is(&x, 2432902008176640000, 0) == 1, "20! = 2432902008176640000");
    # 34! = 295232799039604140847618609643520000000: hi 0xDE1BC4D19EFCAC82, lo 0x445DA75B00000000
    assert(pmn_factorial(34, &x) == PMN_ERR_NONE && is(&x, 0x445DA75B00000000, 0xDE1BC4D19EFCAC82) == 1,
        "34!, the last that fits u128");
    assert_eq(pmn_factorial(35, &x), PMN_ERR_COMPUTATION_ERROR, "35! overflows");
    assert_eq(pmn_factorial(umax, &x), PMN_ERR_COMPUTATION_ERROR, "u64::MAX! refuses, compared unsigned");

    test_group("permutations (1.3.0's tests)");
    assert(pmn_permutations(5, 3, &x) == PMN_ERR_NONE && is(&x, 60, 0) == 1, "P(5, 3) = 60");
    assert(pmn_permutations(10, 2, &x) == PMN_ERR_NONE && is(&x, 90, 0) == 1, "P(10, 2) = 90");
    assert(pmn_permutations(5, 5, &x) == PMN_ERR_NONE && is(&x, 120, 0) == 1, "P(5, 5) = 120");
    assert(pmn_permutations(umax, 0, &x) == PMN_ERR_NONE && is(&x, 1, 0) == 1, "P(u64::MAX, 0) = 1");
    assert(pmn_permutations(umax, 1, &x) == PMN_ERR_NONE && is(&x, umax, 0) == 1, "P(u64::MAX, 1) = u64::MAX");
    assert_eq(pmn_permutations(umax, 3, &x), PMN_ERR_COMPUTATION_ERROR, "P(u64::MAX, 3) overflows at once");
    assert_eq(pmn_permutations(3, 5, &x), PMN_ERR_INVALID_PARAMETER, "r > n refuses");
    assert_eq(pmn_permutations(5, umax, &x), PMN_ERR_INVALID_PARAMETER, "so does r = u64::MAX, unsigned");

    test_group("combinations (1.3.0's tests)");
    assert(pmn_combinations(10, 3, &x) == PMN_ERR_NONE && is(&x, 120, 0) == 1, "C(10, 3) = 120");
    assert(pmn_combinations(20, 10, &x) == PMN_ERR_NONE && is(&x, 184756, 0) == 1, "C(20, 10) = 184756");
    assert(pmn_combinations(5, 0, &x) == PMN_ERR_NONE && is(&x, 1, 0) == 1, "C(5, 0) = 1");
    assert(pmn_combinations(5, 5, &x) == PMN_ERR_NONE && is(&x, 1, 0) == 1, "C(5, 5) = 1, through r = min(r, n - r)");
    assert_eq(pmn_combinations(3, 5, &x), PMN_ERR_INVALID_PARAMETER, "r > n refuses");
    assert_eq(pmn_combinations(130, 65, &x), PMN_ERR_COMPUTATION_ERROR,
        "C(130, 65) refuses: an intermediate product overflows, as in Rust, though the result fits");
    assert(pmn_combinations(umax, umax, &x) == PMN_ERR_NONE && is(&x, 1, 0) == 1, "C(u64::MAX, u64::MAX) = 1");
    assert(pmn_combinations(umax, 1, &x) == PMN_ERR_NONE && is(&x, umax, 0) == 1, "C(u64::MAX, 1) = u64::MAX");

    test_group("the out-pointer");
    x.lo = 7;
    x.hi = 9;
    assert(pmn_factorial(35, &x) == PMN_ERR_COMPUTATION_ERROR && is(&x, 7, 9) == 1, "written only on success");
    assert_eq(pmn_factorial(3, 0), PMN_ERR_INVALID_PARAMETER, "a null out is the caller's error");
    assert_eq(pmn_permutations(3, 1, 0), PMN_ERR_INVALID_PARAMETER, "for each function");
    assert_eq(pmn_combinations(3, 1, 0), PMN_ERR_INVALID_PARAMETER, "all three");

    test_group("the u128 arithmetic at its limits");
    var h, l, o = _pmn_u128_mul_u64(0, umax, umax);
    assert(h == 0 - 2 && l == 1 && o == 0, "(2^64 - 1)^2 = 2^128 - 2^65 + 1 fits");
    var h2, l2, o2 = _pmn_u128_mul_u64(umax, umax, 2);
    assert_eq(o2, 1, "(2^128 - 1) * 2 overflows");
    var h3, l3, o3 = _pmn_u128_mul_u64(0x8000000000000000, 0, 2);
    assert_eq(o3, 1, "2^127 * 2 overflows");
    var h4, l4, o4 = _pmn_u128_mul_u64(0x4000000000000000, 0, 2);
    assert(o4 == 0 && h4 == 0x8000000000000000 && l4 == 0, "2^126 * 2 = 2^127 fits");
    var qh, ql = _pmn_u128_div_u64(umax, umax, umax);
    assert(qh == 1 && ql == 1, "(2^128 - 1) / (2^64 - 1) = 2^64 + 1");
    var qh2, ql2 = _pmn_u128_div_u64(0, 100, 7);
    assert(qh2 == 0 && ql2 == 14, "100 / 7 = 14");
    assert(_pmn_u64_lt(1, umax) == 1 && _pmn_u64_lt(umax, 1) == 0, "u64 compares unsigned");
    var qh3, ql3 = _pmn_u128_div_u64(umax, umax, 0x7FFFFFFF);
    var qh4, ql4 = _pmn_u128_div_u64(umax, umax, 0x80000000);
    assert(qh4 == 0x1FFFFFFFF && ql4 == umax, "(2^128 - 1) / 2^31, by restoring division");
    # (2^128 - 1) / (2^31 - 1): the limb fast path at its largest divisor, checked by multiplying back.
    var bh, bl, bo = _pmn_u128_mul_u64(qh3, ql3, 0x7FFFFFFF);
    assert(bo == 0 && bh == umax && _pmn_u64_lt(umax - bl, 0x7FFFFFFF) == 1, "q * d is within d of the dividend");
    var g = 0x2545F4914F6CDD1D;
    var agree = 1;
    for (var t = 0; t < 20000; t = t + 1) {
        g = g ^ (g << 13);
        g = g ^ (g >> 7);
        g = g ^ (g << 17);
        var dh = g;
        g = g ^ (g << 13);
        g = g ^ (g >> 7);
        g = g ^ (g << 17);
        var dl = g;
        var dv = ((g >> 20) & 0x7FFFFFFF) | 1;
        if (t % 4 == 0) { dv = (g >> 61) + 1; }
        var fh, fl = _pmn_u128_div_u64(dh, dl, dv);
        var ph, pl, po = _pmn_u128_mul_u64(fh, fl, dv);
        var remw = dl - pl;
        if (po != 0 || (dh - ph - _pmn_u64_lt(dl, pl)) != 0 || _pmn_u64_lt(remw, dv) == 0) { agree = 0; }
    }
    assert_eq(agree, 1, "20,000 seeded divisions by d < 2^31: q * d + r = the dividend, r < d");

    test_group("stirling_approx (1.3.0's test)");
    var s0: f64 = pmn_stirling_approx(0);
    assert(s0 == 1.0, "stirling(0) = 1");
    var s10: f64 = pmn_stirling_approx(10);
    var exact: f64 = 3628800.0;
    var rel: f64 = f64_abs(s10 - exact) / exact;
    assert(rel < 0.01, "stirling(10) within 1% of 10!");
    var sbig: f64 = pmn_stirling_approx(200);
    assert(_pmn_is_finite(sbig) == 0 && sbig > 0.0, "stirling(200) overflows to +inf");
    var smax: f64 = pmn_stirling_approx(umax);
    assert(_pmn_is_finite(smax) == 0 && smax > 0.0, "u64::MAX reads unsigned: +inf, not NaN");

    return assert_summary();
}

var exit_code = main();
# Any failure at all is exit 1: a wait status is 8 bits, so a raw count of 256 would read as success.
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
