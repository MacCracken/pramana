# dist.tcyr — the distributions (M3; port plan D5, D7 as amended, D11, D12).
#
# tests/parity.tcyr replays 1.3.0's own values (tests/golden/dist.tsv), documents (json.tsv) and Debug text
# (debug.tsv). These tests carry 1.3.0's own unit tests over (distribution.rs) and pin what a replay doesn't: a
# constructor's refusals, the identities each method keeps bit for bit, a consumer's own generator through the trait,
# and the codecs' and Debug's exact text. Part a1: Normal, Box–Muller and Debug's f64 form; part a2: Uniform,
# Exponential and Bernoulli; part a3: Cauchy and Weibull; part b1: Gamma, ChiSquared and Marsaglia–Tsang; part b2:
# Beta, StudentT and FDistribution, with Rust's Student-t and F tails; part c1: Poisson, Knuth's sampler and PTRS;
# part c2: Binomial, its u64 n and Beta splitting.

include "tests/lib.cyr"

# x's bit pattern.
fn bits(x: f64): i64 {
    return load64(&x);
}

# The f64 with bit pattern b.
fn of_bits(b): f64 {
    var x: f64 = 0.0;
    store64(&x, b);
    return x;
}

# 1.3.0's assert_rel: |actual − expected| / |expected| ≤ tol.
fn rel_ok(actual: f64, expected: f64, tol: f64): i64 {
    var d: f64 = actual - expected;
    var ad: f64 = f64_abs(d);
    var ae: f64 = f64_abs(expected);
    var lim: f64 = tol * ae;
    if (ad <= lim) { return 1; }
    return 0;
}

# A consumer's own generator, as Rust users implemented `Rng`: it counts up in steps of 1/8, then wraps; `calls`
# counts the draws.
struct Eighths {
    k;
    calls;
}

impl PmnRng for Eighths {
    # k/8, then k advances, wrapping from 7 to 0; counts the call.
    fn next_f64(self): f64 {
        var a: f64 = f64_from(self.k);
        var d: f64 = 8.0;
        self.k = (self.k + 1) & 7;
        self.calls = self.calls + 1;
        return a / d;
    }
}

# A consumer's generator that counts its draws: a SimpleRng behind it (g, a pointer), as Rust's oracle test counts them.
struct Counted {
    g: *PmnSimpleRng;
    calls;
}

impl PmnRng for Counted {
    # The SimpleRng's next draw; counts the call.
    fn next_f64(self): f64 {
        var r: *PmnSimpleRng = self.g;
        self.calls = self.calls + 1;
        var x: f64 = r.next_f64();
        return x;
    }
}

# A consumer's generator of period 3, 0.3, 0.6, 0.5 in turn: two Marsaglia–Tsang variates at the same shape each take
# exactly three uniforms (accepted at once by the squeeze), so they come out equal, and their Beta ratio is exactly ½.
struct Cycle3 {
    k;
}

impl PmnRng for Cycle3 {
    # 0.3, 0.6 and 0.5 in turn.
    fn next_f64(self): f64 {
        var r: f64 = 0.3;
        if (self.k == 1) { r = 0.6; }
        if (self.k == 2) { r = 0.5; }
        self.k = self.k + 1;
        if (self.k == 3) { self.k = 0; }
        return r;
    }
}

# What an API generic over the distribution does with it (a static call through the bound, D7).
fn mean_and_variance<T: PmnDistribution>(d: *T): f64 {
    var m: f64 = d.mean();
    var v: f64 = d.variance();
    return m + v;
}

# Appends x's Debug text to sb and compares it with want.
fn dbg_is(sb, x: f64, want: cstring): i64 {
    store64(sb + 8, 0);
    if (_pmn_dbg_f64(sb, x) != PMN_ERR_NONE) { return 0; }
    if (load64(sb + 8) != strlen(want)) { return 0; }
    return memeq(load64(sb), want, strlen(want));
}

# Appends a Normal's JSON or Debug text and compares it with want.
fn text_is(sb, want: cstring): i64 {
    if (load64(sb + 8) != strlen(want)) { return 0; }
    return memeq(load64(sb), want, strlen(want));
}

# Runs the distributions' tests; returns the number that failed, the exit status.
fn main() {
    alloc_init();
    var nan: f64 = _PMN_F64_NAN;
    var inf: f64 = _PMN_F64_INFINITY;
    var n: PmnNormal;
    var g: PmnSimpleRng;
    var h: PmnSimpleRng;
    var sb = str_builder_new();

    test_group("1.3.0's Normal tests (normal_pdf_at_mean, normal_cdf_at_mean, normal_invalid_std_dev)");
    assert_eq(PmnNormal_new(&n, 0.0, 1.0), PMN_ERR_NONE, "N(0, 1)");
    var p0: f64 = n.pdf(0.0);
    var tp: f64 = 2.0 * _PMN_F64_PI;
    var st: f64 = f64_sqrt(tp);
    var w0: f64 = 1.0 / st;
    assert(bits(p0) == bits(w0), "pdf(0) = 1/√(2π), bit for bit (1.3.0: within 1e-10)");
    var c0: f64 = n.cdf(0.0);
    assert(c0 == 0.5, "cdf(0) = 0.5 exactly (1.3.0: within 1e-6)");
    var bad: PmnNormal;
    assert_eq(PmnNormal_new(&bad, 0.0, 0.0), PMN_ERR_INVALID_PARAMETER, "std_dev 0 refused");
    assert_eq(PmnNormal_new(&bad, 0.0, -1.0), PMN_ERR_INVALID_PARAMETER, "std_dev −1 refused");

    test_group("1.3.0's constructors_reject_non_finite_parameters and normal_cdf_tail_precision");
    assert_eq(PmnNormal_new(&bad, nan, 1.0), PMN_ERR_INVALID_PARAMETER, "a NaN mean");
    assert_eq(PmnNormal_new(&bad, 0.0, nan), PMN_ERR_INVALID_PARAMETER, "a NaN std_dev");
    assert_eq(PmnNormal_new(&bad, 0.0, inf), PMN_ERR_INVALID_PARAMETER, "an infinite std_dev");
    var c6: f64 = n.cdf(-6.0);
    assert(rel_ok(c6, 0.0000000009865876450377014, 0.0000000000001) == 1, "Φ(−6) within 1e-13");
    var c1: f64 = n.cdf(-1.0);
    var c1p: f64 = n.cdf(1.0);
    assert(rel_ok(c1, 0.15865525393145707, 0.000000000000001) == 1, "Φ(−1) within 1e-15");
    var c40: f64 = n.cdf(-40.0);
    assert(c40 >= 0.0, "Φ(−40) is not negative");
    var sym: f64 = c1p + c1 - 1.0;
    assert(f64_abs(sym) < 0.000000000000001, "Φ(1) + Φ(−1) = 1 within 1e-15");

    test_group("the constructor (D11)");
    assert_eq(PmnNormal_new(0, 0.0, 1.0), PMN_ERR_INVALID_PARAMETER, "a null out is the caller's error");
    bad.mean = 7.0;
    bad.std_dev = 7.0;
    assert_eq(PmnNormal_new(&bad, 0.0, -1.0), PMN_ERR_INVALID_PARAMETER, "refused");
    var bm: f64 = bad.mean;
    var bs: f64 = bad.std_dev;
    assert(bm == 7.0 && bs == 7.0, "a refusal writes nothing");
    var mz: f64 = -0.0;
    assert_eq(PmnNormal_new(&bad, mz, 1.0), PMN_ERR_NONE, "a mean of −0.0");
    var bz: f64 = bad.mean;
    assert_eq(bits(bz), bits(mz), "kept with its sign");
    var tiny: f64 = of_bits(1);
    assert_eq(PmnNormal_new(&bad, 0.0, tiny), PMN_ERR_NONE, "a subnormal std_dev is positive and finite");
    var mx: f64 = of_bits(0x7FEFFFFFFFFFFFFF);
    assert_eq(PmnNormal_new(&bad, mx, mx), PMN_ERR_NONE, "f64::MAX for both");

    test_group("the methods' identities");
    assert_eq(PmnNormal_new(&n, 1.5, 2.3), PMN_ERR_NONE, "built");
    var cdf_ok = 1;
    var sym_ok = 1;
    var std: PmnNormal;
    assert_eq(PmnNormal_new(&std, 0.0, 1.0), PMN_ERR_NONE, "built");
    for (var k = 0 - 80; k <= 80; k = k + 1) {
        var kf: f64 = f64_from(k);
        var x: f64 = kf / 8.0;
        var nx: f64 = -x;
        var c: f64 = n.cdf(x);
        var d: f64 = x - 1.5;
        var z: f64 = d / 2.3;
        var phi: f64 = _pmn_normal_cdf(z);
        if (bits(c) != bits(phi)) { cdf_ok = 0; }
        var pa: f64 = std.pdf(x);
        var pb: f64 = std.pdf(nx);
        if (bits(pa) != bits(pb)) { sym_ok = 0; }
    }
    assert_eq(cdf_ok, 1, "cdf(x) is the T1 Φ((x − μ)/σ), bit for bit");
    assert_eq(sym_ok, 1, "N(0, 1)'s pdf is even, bit for bit");
    var mv: f64 = mean_and_variance(&n);
    var mvw: f64 = 1.5 + 2.3 * 2.3;
    assert(bits(mv) == bits(mvw), "mean and variance through a bound generic: μ and σ·σ");

    test_group("sampling (1.3.0's normal_sample_finite; D7)");
    assert_eq(PmnNormal_new(&n, 0.0, 1.0), PMN_ERR_NONE, "built");
    PmnSimpleRng_new(&g, 42);
    var fin = 1;
    for (var i = 0; i < 1000; i = i + 1) {
        var s: f64 = n.sample(&g);
        if (_pmn_is_finite(s) == 0) { fin = 0; }
    }
    assert_eq(fin, 1, "1,000 draws of N(0, 1) from seed 42, all finite");
    assert_eq(PmnNormal_new(&n, 1.5, 2.3), PMN_ERR_NONE, "built");
    PmnSimpleRng_new(&g, 12345);
    PmnSimpleRng_new(&h, 12345);
    var bm_ok = 1;
    for (var j = 0; j < 1000; j = j + 1) {
        var a: f64 = n.sample(&g);
        var zz: f64 = _pmn_standard_normal(&h);
        var t: f64 = 2.3 * zz;
        var b: f64 = 1.5 + t;
        if (bits(a) != bits(b)) { bm_ok = 0; }
    }
    assert_eq(bm_ok, 1, "a draw is μ + σ·Z, Z from Box–Muller on the same stream, bit for bit");
    var e8: Eighths;
    e8.k = 0;
    e8.calls = 0;
    var s0: f64 = n.sample(&e8);
    assert_eq(e8.calls, 2, "a consumer's own generator, through the trait: two uniforms a draw");
    assert(_pmn_is_finite(s0) == 1, "a first uniform of 0 is kept from ln(0) by f64::MIN_POSITIVE");

    test_group("JSON (1.3.0's serde_roundtrip_normal, deserialize_rejects_invalid_parameters; D5)");
    assert_eq(PmnNormal_new(&n, 1.5, 2.3), PMN_ERR_NONE, "built");
    store64(sb + 8, 0);
    assert_eq(n.to_json(sb), PMN_ERR_NONE, "written");
    assert(text_is(sb, "{\"mean\":1.5,\"std_dev\":2.3}") == 1, "as serde_json writes it");
    var r: PmnNormal;
    assert_eq(PmnNormal_from_json(&r, load64(sb), load64(sb + 8)), PMN_ERR_NONE, "read back");
    var rm: f64 = r.mean;
    var rs: f64 = r.std_dev;
    assert(rm == 1.5 && rs == 2.3, "the same parameters");
    var d1 = "{\"mean\":0.0,\"std_dev\":-1.0}";
    assert_eq(PmnNormal_from_json(&r, d1, strlen(d1)), PMN_ERR_DESERIALIZE, "a std_dev the constructor refuses");
    var d2 = "[0.5,2.0]";
    assert_eq(PmnNormal_from_json(&r, d2, strlen(d2)), PMN_ERR_NONE, "serde's sequence form");
    var d3 = "{\"mean\":0.5}";
    assert_eq(PmnNormal_from_json(&r, d3, strlen(d3)), PMN_ERR_DESERIALIZE, "a missing field");
    var d4 = "{\"mean\":0.5,\"std_dev\":1e999}";
    assert_eq(PmnNormal_from_json(&r, d4, strlen(d4)), PMN_ERR_DESERIALIZE, "a number out of range");
    var d5 = "{\"mean\":-0,\"std_dev\":5e-324}";
    assert_eq(PmnNormal_from_json(&r, d5, strlen(d5)), PMN_ERR_NONE, "−0 and the least subnormal");
    var r5: f64 = r.mean;
    assert(bits(r5) == bits(mz), "−0 reads as −0.0");
    assert_eq(PmnNormal_from_json(0, d2, strlen(d2)), PMN_ERR_INVALID_PARAMETER, "a null out");
    assert_eq(PmnNormal_new(&n, mz, tiny), PMN_ERR_NONE, "built");
    store64(sb + 8, 0);
    assert_eq(n.to_json(sb), PMN_ERR_NONE, "−0.0 and 5e-324");
    assert(text_is(sb, "{\"mean\":-0.0,\"std_dev\":5e-324}") == 1, "written as serde_json writes them");

    test_group("Debug (D12)");
    assert_eq(PmnNormal_new(&n, 0.0, 1.0), PMN_ERR_NONE, "built");
    store64(sb + 8, 0);
    assert_eq(n.debug(sb, 0), PMN_ERR_NONE, "{:?}");
    assert(text_is(sb, "Normal { mean: 0.0, std_dev: 1.0 }") == 1, "Normal { mean: 0.0, std_dev: 1.0 }");
    store64(sb + 8, 0);
    assert_eq(n.debug(sb, 1), PMN_ERR_NONE, "{:#?}");
    assert(text_is(sb, "Normal {\n    mean: 0.0,\n    std_dev: 1.0,\n}") == 1, "one field a line");
    assert(dbg_is(sb, 0.1, "0.1") == 1, "0.1");
    assert(dbg_is(sb, 10000000000000000.0, "1e16") == 1, "1e16: exponential from 1e16");
    assert(dbg_is(sb, 9999999999999998.0, "9999999999999998.0") == 1, "positional below 1e16, with .0");
    assert(dbg_is(sb, 0.0001, "0.0001") == 1, "0.0001: positional from 1e-4");
    assert(dbg_is(sb, of_bits(0x3F1A36E2EB1C432C), "9.999999999999999e-5") == 1, "exponential below 1e-4");
    assert(dbg_is(sb, of_bits(0x3E60000000000000), "2.9802322387695313e-8") == 1,
      "2^-25: an exact tie, the upper digit as Rust's core printer (serde_json's ...5312e-8)");
    assert(dbg_is(sb, tiny, "5e-324") == 1, "5e-324");
    assert(dbg_is(sb, of_bits(0x7FEFFFFFFFFFFFFF), "1.7976931348623157e308") == 1, "f64::MAX, no + in the exponent");
    assert(dbg_is(sb, mz, "-0.0") == 1, "-0.0");
    assert(dbg_is(sb, nan, "NaN") == 1 && dbg_is(sb, of_bits(0xFFF8000000000000), "NaN") == 1, "NaN, either sign");
    var ninf: f64 = -inf;
    assert(dbg_is(sb, inf, "inf") == 1 && dbg_is(sb, ninf, "-inf") == 1, "inf and -inf");

    test_group("1.3.0's uniform_pdf_and_cdf, exponential_mean_and_variance, bernoulli_pdf");
    var u: PmnUniform;
    assert_eq(PmnUniform_new(&u, 0.0, 10.0), PMN_ERR_NONE, "U(0, 10)");
    var u5: f64 = u.pdf(5.0);
    var c5: f64 = u.cdf(5.0);
    assert(u5 == 0.1 && c5 == 0.5, "pdf(5) = 0.1 and cdf(5) = 0.5 exactly (1.3.0: within 1e-10)");
    var um: f64 = u.pdf(-1.0);
    var cm: f64 = u.cdf(-1.0);
    var cp: f64 = u.cdf(11.0);
    assert(um == 0.0 && cm == 0.0 && cp == 1.0, "pdf(−1) = 0, cdf(−1) = 0, cdf(11) = 1");
    var ex: PmnExponential;
    assert_eq(PmnExponential_new(&ex, 2.0), PMN_ERR_NONE, "Exp(2)");
    var em: f64 = ex.mean();
    var ev: f64 = ex.variance();
    assert(em == 0.5 && ev == 0.25, "mean 0.5 and variance 0.25 exactly (1.3.0: within 1e-10)");
    var be: PmnBernoulli;
    assert_eq(PmnBernoulli_new(&be, 0.7), PMN_ERR_NONE, "Bernoulli(0.7)");
    var b1: f64 = be.pdf(1.0);
    var b0: f64 = be.pdf(0.0);
    var q7: f64 = 1.0 - 0.7;
    assert(b1 == 0.7 && bits(b0) == bits(q7), "pmf(1) = 0.7, pmf(0) = 1 − 0.7 bit for bit (1.3.0: within 1e-10)");

    test_group("1.3.0's constructors_reject_non_finite_parameters and exponential_and_weibull_cdf_small_x");
    var bu: PmnUniform;
    var ninf2: f64 = -inf;
    var big: f64 = of_bits(0x7FE1CCF385EBC8A0);
    var nbig: f64 = -big;
    assert_eq(PmnUniform_new(&bu, nan, 1.0), PMN_ERR_INVALID_PARAMETER, "a NaN min");
    assert_eq(PmnUniform_new(&bu, ninf2, 0.0), PMN_ERR_INVALID_PARAMETER, "an infinite min");
    assert_eq(PmnUniform_new(&bu, nbig, big), PMN_ERR_INVALID_PARAMETER, "[−1e308, 1e308]: the width overflows");
    var bx: PmnExponential;
    assert_eq(PmnExponential_new(&bx, nan), PMN_ERR_INVALID_PARAMETER, "a NaN lambda");
    assert_eq(PmnExponential_new(&bx, inf), PMN_ERR_INVALID_PARAMETER, "an infinite lambda");
    var bb: PmnBernoulli;
    assert_eq(PmnBernoulli_new(&bb, nan), PMN_ERR_INVALID_PARAMETER, "a NaN p");
    assert_eq(PmnExponential_new(&ex, 1.0), PMN_ERR_NONE, "Exp(1)");
    var e20: f64 = of_bits(0x3BC79CA10C924223);
    var ce: f64 = ex.cdf(e20);
    assert(bits(ce) == bits(e20), "cdf(1e-20) = 1e-20 exactly, by exp_m1 (1.3.0: within 1e-15)");

    test_group("the constructors (D11)");
    assert_eq(PmnUniform_new(0, 0.0, 1.0), PMN_ERR_INVALID_PARAMETER, "Uniform: a null out");
    assert_eq(PmnExponential_new(0, 1.0), PMN_ERR_INVALID_PARAMETER, "Exponential: a null out");
    assert_eq(PmnBernoulli_new(0, 0.5), PMN_ERR_INVALID_PARAMETER, "Bernoulli: a null out");
    bu.min = 7.0;
    bu.max = 8.0;
    assert_eq(PmnUniform_new(&bu, 1.0, 1.0), PMN_ERR_INVALID_PARAMETER, "min = max refused");
    var bu1: f64 = bu.min;
    var bu2: f64 = bu.max;
    assert(bu1 == 7.0 && bu2 == 8.0, "a refusal writes nothing");
    assert_eq(PmnUniform_new(&bu, 0.0, mz), PMN_ERR_INVALID_PARAMETER, "[0, −0] refused: 0 ≥ −0");
    assert_eq(PmnUniform_new(&bu, 2.0, 1.0), PMN_ERR_INVALID_PARAMETER, "min > max refused");
    assert_eq(PmnUniform_new(&bu, nbig, 0.0), PMN_ERR_NONE, "[−1e308, 0]: a finite width");
    var mxu: f64 = of_bits(0x7FEFFFFFFFFFFFFF);
    var nmxu: f64 = -mxu;
    assert_eq(PmnUniform_new(&bu, nmxu, 0.0), PMN_ERR_NONE, "[−f64::MAX, 0]");
    assert_eq(PmnUniform_new(&bu, nmxu, tiny), PMN_ERR_NONE, "[−f64::MAX, 5e-324]: the width rounds to f64::MAX");
    assert_eq(PmnUniform_new(&bu, nmxu, mxu), PMN_ERR_INVALID_PARAMETER, "[−f64::MAX, f64::MAX]: it overflows");
    assert_eq(PmnExponential_new(&bx, 0.0), PMN_ERR_INVALID_PARAMETER, "lambda 0 refused");
    assert_eq(PmnExponential_new(&bx, mz), PMN_ERR_INVALID_PARAMETER, "lambda −0 refused");
    assert_eq(PmnExponential_new(&bx, tiny), PMN_ERR_NONE, "a subnormal lambda is positive");
    var e1: f64 = of_bits(0x3FF0000000000001);
    var eps: f64 = of_bits(0x3CB0000000000000);
    var neps: f64 = -eps;
    assert_eq(PmnBernoulli_new(&bb, e1), PMN_ERR_INVALID_PARAMETER, "p = 1 + ε refused");
    assert_eq(PmnBernoulli_new(&bb, neps), PMN_ERR_INVALID_PARAMETER, "p = −ε refused");
    assert_eq(PmnBernoulli_new(&bb, 1.0), PMN_ERR_NONE, "p = 1");
    assert_eq(PmnBernoulli_new(&bb, mz), PMN_ERR_NONE, "p = −0.0: −0 ≥ 0");
    var bp: f64 = bb.p;
    assert_eq(bits(bp), bits(mz), "kept with its sign");

    test_group("the methods' edges");
    assert_eq(PmnUniform_new(&u, -1.0, 5.0), PMN_ERR_NONE, "U(−1, 5)");
    var ulo: f64 = u.cdf(-1.0);
    var uhi: f64 = u.cdf(5.0);
    var plo: f64 = u.pdf(-1.0);
    var phi6: f64 = u.pdf(5.0);
    var sixth: f64 = 1.0 / 6.0;
    assert(ulo == 0.0 && uhi == 1.0, "cdf is 0 at min and 1 at max");
    assert(plo == sixth && phi6 == sixth, "pdf is 1/(max − min) at both ends: the support is closed");
    var unan: f64 = u.pdf(nan);
    var cnan: f64 = u.cdf(nan);
    assert(unan == 0.0 && cnan != cnan, "pdf(NaN) = 0, cdf(NaN) = NaN, as Rust's comparisons give");
    var uinf: f64 = u.cdf(inf);
    var uninf: f64 = u.cdf(ninf2);
    assert(uinf == 1.0 && uninf == 0.0, "cdf(±∞) = 1 and 0");
    var umv: f64 = mean_and_variance(&u);
    var umw: f64 = 2.0 + 3.0;
    assert(bits(umv) == bits(umw), "mean (min + max)/2 and variance (max − min)²/12 through a bound generic");
    var ov: PmnUniform;
    assert_eq(PmnUniform_new(&ov, big, mxu), PMN_ERR_NONE, "U(1e308, f64::MAX): a finite width");
    var ovm: f64 = ov.mean();
    assert(ovm == inf, "its mean is ∞, as Rust's (min + max)/2 overflows before the halving");
    var tw: f64 = of_bits(2);
    assert_eq(PmnUniform_new(&ov, tiny, tw), PMN_ERR_NONE, "U(5e-324, 1e-323)");
    var tm: f64 = ov.mean();
    var tp1: f64 = ov.pdf(tiny);
    assert(bits(tm) == 2 && tp1 == inf, "mean 1.5·5e-324 rounds to 1e-323, and the pdf 1/5e-324 overflows");
    assert_eq(PmnExponential_new(&ex, 2.5), PMN_ERR_NONE, "Exp(2.5)");
    var x0: f64 = ex.cdf(0.0);
    var p0e: f64 = ex.pdf(0.0);
    assert(bits(x0) == 0 && p0e == 2.5, "cdf(0) = +0.0 and pdf(0) = lambda");
    var xin: f64 = ex.cdf(inf);
    var pin: f64 = ex.pdf(inf);
    assert(xin == 1.0 && pin == 0.0, "cdf(∞) = 1 and pdf(∞) = 0");
    var xneg: f64 = ex.cdf(-1.0);
    var pneg: f64 = ex.pdf(-1.0);
    assert(xneg == 0.0 && pneg == 0.0, "0 below the support");
    var xnan: f64 = ex.cdf(nan);
    var pnan: f64 = ex.pdf(nan);
    assert(xnan != xnan && pnan != pnan, "NaN at NaN");
    var half: f64 = of_bits(0x3CA0000000000000);
    var below1: f64 = of_bits(0x3FEFFFFFFFFFFFFF);
    assert_eq(PmnBernoulli_new(&be, 0.7), PMN_ERR_NONE, "Bernoulli(0.7)");
    var w1: f64 = be.pdf(half);
    var w2: f64 = be.pdf(eps);
    var w3: f64 = be.pdf(below1);
    var w4: f64 = be.pdf(e1);
    var w5: f64 = be.pdf(nan);
    assert(bits(w1) == bits(q7) && w2 == 0.0, "pmf: 1 − p within ε of 0, not at ε");
    assert(w3 == 0.7 && w4 == 0.0 && w5 == 0.0, "p within ε of 1, not at 1 + ε; 0 at NaN");
    var k0: f64 = be.cdf(mz);
    var k1: f64 = be.cdf(below1);
    var k2: f64 = be.cdf(1.0);
    var k3: f64 = be.cdf(nan);
    var k4: f64 = be.cdf(neps);
    assert(bits(k0) == bits(q7) && bits(k1) == bits(q7), "cdf: 1 − p on [0, 1), −0.0 included");
    assert(k2 == 1.0 && k3 != k3 && k4 == 0.0, "1 from 1, NaN at NaN, 0 below 0");
    var bmv: f64 = mean_and_variance(&be);
    var bmw: f64 = 0.7 + 0.7 * q7;
    assert(bits(bmv) == bits(bmw), "mean p and variance p·(1 − p) through a bound generic");

    test_group("sampling (D7)");
    assert_eq(PmnUniform_new(&u, -1.0, 5.0), PMN_ERR_NONE, "U(−1, 5)");
    PmnSimpleRng_new(&g, 12345);
    PmnSimpleRng_new(&h, 12345);
    var us_ok = 1;
    for (var j2 = 0; j2 < 1000; j2 = j2 + 1) {
        var ua: f64 = u.sample(&g);
        var uu: f64 = h.next_f64();
        var ut: f64 = uu * 6.0;
        var ub: f64 = -1.0 + ut;
        if (bits(ua) != bits(ub)) { us_ok = 0; }
    }
    assert_eq(us_ok, 1, "a Uniform draw is min + u·(max − min), u from the same stream, bit for bit");
    assert_eq(PmnExponential_new(&ex, 2.5), PMN_ERR_NONE, "Exp(2.5)");
    PmnSimpleRng_new(&g, 42);
    PmnSimpleRng_new(&h, 42);
    var es_ok = 1;
    for (var j3 = 0; j3 < 1000; j3 = j3 + 1) {
        var ea: f64 = ex.sample(&g);
        var eu: f64 = h.next_f64();
        var ec: f64 = 1.0 - eu;
        var el: f64 = _pmn_ln(ec);
        var en: f64 = -el;
        var eb: f64 = en / 2.5;
        if (bits(ea) != bits(eb) || ea < 0.0) { es_ok = 0; }
    }
    assert_eq(es_ok, 1, "an Exponential draw is −ln(1 − u)/lambda, bit for bit, and never negative");
    e8.k = 0;
    e8.calls = 0;
    var es0: f64 = ex.sample(&e8);
    assert_eq(e8.calls, 1, "one uniform a draw");
    assert_eq(bits(es0), bits(mz), "a uniform of 0 (kept to f64::MIN_POSITIVE) draws −0.0, as Rust's −ln(1)/λ");
    assert_eq(PmnBernoulli_new(&be, 0.5), PMN_ERR_NONE, "Bernoulli(0.5)");
    e8.k = 0;
    e8.calls = 0;
    var ones: f64 = 0.0;
    for (var j4 = 0; j4 < 8; j4 = j4 + 1) {
        var bs8: f64 = be.sample(&e8);
        ones = ones + bs8;
    }
    assert(ones == 4.0 && e8.calls == 8, "a success when u < p: 0, 1/8, 2/8 and 3/8 of the eighths");
    assert_eq(PmnBernoulli_new(&be, 0.0), PMN_ERR_NONE, "Bernoulli(0)");
    e8.k = 0;
    var bz0: f64 = be.sample(&e8);
    assert(bz0 == 0.0, "p = 0 never succeeds, even at u = 0");

    test_group("JSON (1.3.0's serde_roundtrip_uniform, _exponential, _bernoulli and deserialize_rejects; D5)");
    assert_eq(PmnUniform_new(&u, -1.0, 5.0), PMN_ERR_NONE, "built");
    store64(sb + 8, 0);
    assert_eq(u.to_json(sb), PMN_ERR_NONE, "written");
    assert(text_is(sb, "{\"min\":-1.0,\"max\":5.0}") == 1, "as serde_json writes it");
    var ru: PmnUniform;
    assert_eq(PmnUniform_from_json(&ru, load64(sb), load64(sb + 8)), PMN_ERR_NONE, "read back");
    var rmin: f64 = ru.min;
    var rmax: f64 = ru.max;
    assert(rmin == -1.0 && rmax == 5.0, "the same bounds");
    var j1 = "{\"min\":2.0,\"max\":1.0}";
    assert_eq(PmnUniform_from_json(&ru, j1, strlen(j1)), PMN_ERR_DESERIALIZE, "min > max");
    var j1b = "{\"min\":-1e308,\"max\":1e308}";
    assert_eq(PmnUniform_from_json(&ru, j1b, strlen(j1b)), PMN_ERR_DESERIALIZE, "a width that overflows");
    assert_eq(PmnUniform_from_json(0, j1, strlen(j1)), PMN_ERR_INVALID_PARAMETER, "a null out");
    assert_eq(PmnExponential_new(&ex, 2.5), PMN_ERR_NONE, "built");
    store64(sb + 8, 0);
    assert_eq(ex.to_json(sb), PMN_ERR_NONE, "written");
    assert(text_is(sb, "{\"lambda\":2.5}") == 1, "as serde_json writes it");
    var rx: PmnExponential;
    assert_eq(PmnExponential_from_json(&rx, load64(sb), load64(sb + 8)), PMN_ERR_NONE, "read back");
    var rl: f64 = rx.lambda;
    assert(rl == 2.5, "the same lambda");
    var j2d = "{\"lambda\":0.0}";
    assert_eq(PmnExponential_from_json(&rx, j2d, strlen(j2d)), PMN_ERR_DESERIALIZE, "lambda 0");
    assert_eq(PmnExponential_from_json(0, j2d, strlen(j2d)), PMN_ERR_INVALID_PARAMETER, "a null out");
    assert_eq(PmnBernoulli_new(&be, 0.7), PMN_ERR_NONE, "built");
    store64(sb + 8, 0);
    assert_eq(be.to_json(sb), PMN_ERR_NONE, "written");
    assert(text_is(sb, "{\"p\":0.7}") == 1, "as serde_json writes it");
    var rb: PmnBernoulli;
    assert_eq(PmnBernoulli_from_json(&rb, load64(sb), load64(sb + 8)), PMN_ERR_NONE, "read back");
    var rp: f64 = rb.p;
    assert(rp == 0.7, "the same p");
    var j3d = "{\"p\":-0.1}";
    assert_eq(PmnBernoulli_from_json(&rb, j3d, strlen(j3d)), PMN_ERR_DESERIALIZE, "p = −0.1");
    var j4d = "{\"p\":1.0000000000000002}";
    assert_eq(PmnBernoulli_from_json(&rb, j4d, strlen(j4d)), PMN_ERR_DESERIALIZE, "p = 1 + ε");
    var j5d = "{\"p\":1.00000000000000001}";
    assert_eq(PmnBernoulli_from_json(&rb, j5d, strlen(j5d)), PMN_ERR_NONE, "a p that rounds to 1");
    assert_eq(PmnBernoulli_from_json(0, j3d, strlen(j3d)), PMN_ERR_INVALID_PARAMETER, "a null out");

    test_group("Debug (D12)");
    store64(sb + 8, 0);
    assert_eq(u.debug(sb, 0), PMN_ERR_NONE, "Uniform {:?}");
    assert(text_is(sb, "Uniform { min: -1.0, max: 5.0 }") == 1, "Uniform { min: -1.0, max: 5.0 }");
    store64(sb + 8, 0);
    assert_eq(u.debug(sb, 1), PMN_ERR_NONE, "Uniform {:#?}");
    assert(text_is(sb, "Uniform {\n    min: -1.0,\n    max: 5.0,\n}") == 1, "one field a line");
    store64(sb + 8, 0);
    assert_eq(ex.debug(sb, 0), PMN_ERR_NONE, "Exponential {:?}");
    assert(text_is(sb, "Exponential { lambda: 2.5 }") == 1, "Exponential { lambda: 2.5 }");
    store64(sb + 8, 0);
    assert_eq(ex.debug(sb, 1), PMN_ERR_NONE, "Exponential {:#?}");
    assert(text_is(sb, "Exponential {\n    lambda: 2.5,\n}") == 1, "one field a line");
    store64(sb + 8, 0);
    assert_eq(be.debug(sb, 0), PMN_ERR_NONE, "Bernoulli {:?}");
    assert(text_is(sb, "Bernoulli { p: 0.7 }") == 1, "Bernoulli { p: 0.7 }");
    store64(sb + 8, 0);
    assert_eq(be.debug(sb, 1), PMN_ERR_NONE, "Bernoulli {:#?}");
    assert(text_is(sb, "Bernoulli {\n    p: 0.7,\n}") == 1, "one field a line");

    test_group("1.3.0's Cauchy tests (cauchy_pdf_and_cdf, cauchy_undefined_moments, cauchy_sample_finite)");
    var ca: PmnCauchy;
    assert_eq(PmnCauchy_new(&ca, 0.0, 1.0), PMN_ERR_NONE, "Cauchy(0, 1)");
    var cp0: f64 = ca.pdf(0.0);
    var pi: f64 = _PMN_F64_PI;
    var ipi: f64 = 1.0 / pi;
    assert(bits(cp0) == bits(ipi), "pdf(0) = 1/π bit for bit (1.3.0: within 1e-10)");
    var cc0: f64 = ca.cdf(0.0);
    assert(cc0 == 0.5, "cdf(0) = 0.5 exactly");
    var cc1: f64 = ca.cdf(1.0);
    var ccm1: f64 = ca.cdf(-1.0);
    var csym: f64 = cc1 + ccm1 - 1.0;
    assert(f64_abs(csym) < 0.0000000001, "cdf(1) + cdf(−1) = 1 within 1e-10");
    var cmean: f64 = ca.mean();
    var cvar: f64 = ca.variance();
    assert(cmean != cmean && cvar != cvar, "mean and variance undefined: NaN");
    assert(bits(cmean) == bits(nan), "the quiet NaN Rust's f64::NAN is");
    PmnSimpleRng_new(&g, 42);
    var cfin = 1;
    for (var ci1 = 0; ci1 < 10000; ci1 = ci1 + 1) {
        var cs: f64 = ca.sample(&g);
        if (_pmn_is_finite(cs) == 0) { cfin = 0; }
    }
    assert_eq(cfin, 1, "10,000 draws from seed 42, all finite");

    test_group("1.3.0's Weibull tests (weibull_exponential_case, weibull_mean_and_variance, _sample_nonnegative)");
    var wb: PmnWeibull;
    assert_eq(PmnWeibull_new(&wb, 1.0, 2.0), PMN_ERR_NONE, "Weibull(1, 2)");
    var wm: f64 = wb.mean();
    assert(wm == 2.0, "mean 2·Γ(2) = 2 exactly: the T1 lnΓ(2) is 0 (1.3.0: within 1e-8)");
    var wc2: f64 = wb.cdf(2.0);
    var em1: f64 = _pmn_exp(-1.0);
    var wce: f64 = 1.0 - em1;
    assert(f64_abs(wc2 - wce) < 0.00000001, "cdf(2) = 1 − e⁻¹ within 1e-8");
    assert_eq(PmnWeibull_new(&wb, 2.0, 1.0), PMN_ERR_NONE, "Weibull(2, 1)");
    var wm2: f64 = wb.mean();
    assert_eq(bits(wm2), 0x3FEC5BF891B4EF6B, "mean Γ(1.5) = √π/2, correctly rounded (MPFR; 1.3.0: 2 ulp above)");
    var wv2: f64 = wb.variance();
    assert_eq(bits(wv2), 0x3FCB7812AEEF4B9C, "variance 1 − π/4, 3 ulp from MPFR's (1.3.0: 15)");
    assert_eq(PmnWeibull_new(&wb, 2.0, 3.0), PMN_ERR_NONE, "Weibull(2, 3)");
    PmnSimpleRng_new(&g, 42);
    var wneg = 0;
    for (var wi1 = 0; wi1 < 10000; wi1 = wi1 + 1) {
        var ws: f64 = wb.sample(&g);
        if (ws < 0.0 || ws != ws) { wneg = 1; }
    }
    assert_eq(wneg, 0, "10,000 draws from seed 42, none negative");
    assert_eq(PmnWeibull_new(&wb, 1.0, 1.0), PMN_ERR_NONE, "Weibull(1, 1)");
    var wc20: f64 = wb.cdf(e20);
    assert(bits(wc20) == bits(e20), "cdf(1e-20) = 1e-20 exactly (1.3.0's _cdf_small_x: within 1e-15)");

    test_group("the constructors' refusals (constructors_reject_non_finite_parameters; D11)");
    var bc: PmnCauchy;
    assert_eq(PmnCauchy_new(&bc, nan, 1.0), PMN_ERR_INVALID_PARAMETER, "a NaN x0");
    assert_eq(PmnCauchy_new(&bc, 0.0, inf), PMN_ERR_INVALID_PARAMETER, "an infinite gamma");
    assert_eq(PmnCauchy_new(&bc, inf, 1.0), PMN_ERR_INVALID_PARAMETER, "an infinite x0");
    assert_eq(PmnCauchy_new(&bc, 0.0, 0.0), PMN_ERR_INVALID_PARAMETER, "gamma 0");
    assert_eq(PmnCauchy_new(&bc, 0.0, mz), PMN_ERR_INVALID_PARAMETER, "gamma −0");
    assert_eq(PmnCauchy_new(&bc, 0.0, -1.0), PMN_ERR_INVALID_PARAMETER, "a negative gamma");
    assert_eq(PmnCauchy_new(0, 0.0, 1.0), PMN_ERR_INVALID_PARAMETER, "a null out");
    bc.x0 = 7.0;
    bc.gamma = 8.0;
    assert_eq(PmnCauchy_new(&bc, 0.0, nan), PMN_ERR_INVALID_PARAMETER, "a NaN gamma");
    var bcx: f64 = bc.x0;
    var bcg: f64 = bc.gamma;
    assert(bcx == 7.0 && bcg == 8.0, "a refusal writes nothing");
    assert_eq(PmnCauchy_new(&bc, mz, tiny), PMN_ERR_NONE, "x0 = −0.0 and a subnormal gamma");
    var bcz: f64 = bc.x0;
    assert_eq(bits(bcz), bits(mz), "x0 kept with its sign");
    var bw: PmnWeibull;
    assert_eq(PmnWeibull_new(&bw, nan, 1.0), PMN_ERR_INVALID_PARAMETER, "a NaN k");
    assert_eq(PmnWeibull_new(&bw, 1.0, nan), PMN_ERR_INVALID_PARAMETER, "a NaN lambda");
    assert_eq(PmnWeibull_new(&bw, inf, 1.0), PMN_ERR_INVALID_PARAMETER, "an infinite k");
    assert_eq(PmnWeibull_new(&bw, 1.0, inf), PMN_ERR_INVALID_PARAMETER, "an infinite lambda");
    assert_eq(PmnWeibull_new(&bw, 0.0, 1.0), PMN_ERR_INVALID_PARAMETER, "k 0");
    assert_eq(PmnWeibull_new(&bw, 1.0, mz), PMN_ERR_INVALID_PARAMETER, "lambda −0");
    assert_eq(PmnWeibull_new(0, 1.0, 1.0), PMN_ERR_INVALID_PARAMETER, "a null out");
    bw.k = 7.0;
    bw.lambda = 8.0;
    assert_eq(PmnWeibull_new(&bw, 1.0, -1.0), PMN_ERR_INVALID_PARAMETER, "a negative lambda");
    var bwk: f64 = bw.k;
    var bwl: f64 = bw.lambda;
    assert(bwk == 7.0 && bwl == 8.0, "a refusal writes nothing");
    assert_eq(PmnWeibull_new(&bw, tiny, mxu), PMN_ERR_NONE, "a subnormal k and f64::MAX's lambda");

    test_group("Cauchy's edges and identities");
    assert_eq(PmnCauchy_new(&ca, 0.0, 1.0), PMN_ERR_NONE, "Cauchy(0, 1)");
    var c_even = 1;
    for (var c2 = 0 - 80; c2 <= 80; c2 = c2 + 1) {
        var cf: f64 = f64_from(c2);
        var cx: f64 = cf / 8.0;
        var cnx: f64 = -cx;
        var cpa: f64 = ca.pdf(cx);
        var cpb: f64 = ca.pdf(cnx);
        if (bits(cpa) != bits(cpb)) { c_even = 0; }
    }
    assert_eq(c_even, 1, "Cauchy(0, 1)'s pdf is even, bit for bit");
    var cinf: f64 = ca.cdf(inf);
    var cninf: f64 = ca.cdf(ninf2);
    assert(cinf == 1.0 && cninf == 0.0, "cdf(±∞) = 1 and 0 exactly: (1/π)·atan(∞) rounds to ½");
    var cpinf: f64 = ca.pdf(inf);
    var cpnan: f64 = ca.pdf(nan);
    var ccnan: f64 = ca.cdf(nan);
    assert(cpinf == 0.0 && cpnan != cpnan && ccnan != ccnan, "pdf(∞) = 0; NaN at NaN");
    assert_eq(PmnCauchy_new(&ca, 2.0, 3.0), PMN_ERR_NONE, "Cauchy(2, 3)");
    var cmed: f64 = ca.cdf(2.0);
    var cpk: f64 = ca.pdf(2.0);
    var p3: f64 = pi * 3.0;
    var wpk3: f64 = 1.0 / p3;
    assert(cmed == 0.5 && bits(cpk) == bits(wpk3), "cdf(x0) = ½ and pdf(x0) = 1/(πγ), bit for bit");
    assert_eq(PmnCauchy_new(&ca, 0.0, tiny), PMN_ERR_NONE, "Cauchy(0, 5e-324)");
    var ctp: f64 = ca.pdf(1.0);
    var ctc: f64 = ca.cdf(1.0);
    assert(ctp == 0.0 && ctc == 1.0, "a subnormal scale: z overflows, pdf 0 and cdf 1");
    assert_eq(PmnCauchy_new(&ca, 2.0, 3.0), PMN_ERR_NONE, "Cauchy(2, 3)");
    PmnSimpleRng_new(&g, 12345);
    PmnSimpleRng_new(&h, 12345);
    var cs_ok = 1;
    for (var c3 = 0; c3 < 1000; c3 = c3 + 1) {
        var csa: f64 = ca.sample(&g);
        var cu: f64 = h.next_f64();
        var ch: f64 = cu - 0.5;
        var cph: f64 = pi * ch;
        var ct: f64 = _pmn_tan(cph);
        var cgt: f64 = 3.0 * ct;
        var csb: f64 = 2.0 + cgt;
        if (bits(csa) != bits(csb)) { cs_ok = 0; }
    }
    assert_eq(cs_ok, 1, "a draw is x0 + γ·tan(π(u − ½)), bit for bit on the same stream");
    e8.k = 0;
    e8.calls = 0;
    var cs0: f64 = ca.sample(&e8);
    assert(e8.calls == 1 && _pmn_is_finite(cs0) == 1, "one uniform a draw; u = 0 gives tan(−π/2 rounded), finite");

    test_group("Weibull's edges and identities");
    assert_eq(PmnWeibull_new(&wb, 1.0, 1.0), PMN_ERR_NONE, "Weibull(1, 1)");
    assert_eq(PmnExponential_new(&ex, 1.0), PMN_ERR_NONE, "Exp(1)");
    var w_exp = 1;
    for (var wi2 = 0; wi2 <= 160; wi2 = wi2 + 1) {
        var wf: f64 = f64_from(wi2);
        var wx: f64 = wf / 16.0;
        var wpa: f64 = wb.pdf(wx);
        var wpb: f64 = ex.pdf(wx);
        var wca: f64 = wb.cdf(wx);
        var wcb: f64 = ex.cdf(wx);
        if (bits(wpa) != bits(wpb) || bits(wca) != bits(wcb)) { w_exp = 0; }
    }
    assert_eq(w_exp, 1, "Weibull(1, 1) is Exp(1), pdf and cdf bit for bit: x^1 and x^0 are exact");
    var wp0: f64 = wb.pdf(0.0);
    assert(wp0 == 1.0, "pdf(0) = 1/λ for k = 1");
    assert_eq(PmnWeibull_new(&wb, 2.0, 1.0), PMN_ERR_NONE, "Weibull(2, 1)");
    var wp0b: f64 = wb.pdf(0.0);
    var wp0n: f64 = wb.pdf(mz);
    assert(wp0b == 0.0 && wp0n == 0.0, "pdf(0) = 0 for k > 1, −0.0 included");
    assert_eq(PmnWeibull_new(&wb, 0.5, 1.0), PMN_ERR_NONE, "Weibull(0.5, 1)");
    var wp0c: f64 = wb.pdf(0.0);
    assert(wp0c == inf, "pdf(0) = +∞ for k < 1");
    var wcz: f64 = wb.cdf(0.0);
    var wcn: f64 = wb.cdf(-1.0);
    var wci: f64 = wb.cdf(inf);
    var wcnan: f64 = wb.cdf(nan);
    var wpn: f64 = wb.pdf(-1.0);
    var wpnan: f64 = wb.pdf(nan);
    assert(wcz == 0.0 && wcn == 0.0 && wpn == 0.0, "0 at and below 0");
    assert(wci == 1.0 && wcnan != wcnan && wpnan != wpnan, "cdf(∞) = 1; NaN at NaN");
    var wcmz: f64 = wb.cdf(mz);
    assert_eq(bits(wcmz), 0, "cdf(−0.0) = +0.0 for k = ½");
    assert_eq(PmnWeibull_new(&wb, 1.0, 1.0), PMN_ERR_NONE, "Weibull(1, 1)");
    var wcmz1: f64 = wb.cdf(mz);
    assert_eq(bits(wcmz1), 0, "cdf(−0.0) = +0.0 for k = 1, by the x ≤ 0 arm: (−0.0)^1 would give −0.0");
    assert_eq(PmnWeibull_new(&wb, tiny, 1.0), PMN_ERR_NONE, "Weibull(5e-324, 1)");
    var wtm: f64 = wb.mean();
    assert(wtm == inf, "k = 5e-324: Γ(1 + ∞) = ∞ on the T1 lnΓ (1.3.0's Lanczos form: NaN)");
    assert_eq(PmnWeibull_new(&wb, 0.005, tiny), PMN_ERR_NONE, "Weibull(0.005, 5e-324)");
    var wom: f64 = wb.mean();
    assert(wom == inf, "Γ(201) overflows before the product, as in Rust's form: +∞");
    assert_eq(PmnWeibull_new(&wb, 2.0, 3.0), PMN_ERR_NONE, "Weibull(2, 3)");
    PmnSimpleRng_new(&g, 12345);
    PmnSimpleRng_new(&h, 12345);
    var ws_ok = 1;
    for (var w3i = 0; w3i < 1000; w3i = w3i + 1) {
        var wsa: f64 = wb.sample(&g);
        var wu: f64 = h.next_f64();
        var wcu: f64 = 1.0 - wu;
        var wl: f64 = _pmn_ln(wcu);
        var wnl: f64 = -wl;
        var wpw: f64 = _pmn_powf(wnl, 0.5);
        var wsb: f64 = 3.0 * wpw;
        if (bits(wsa) != bits(wsb)) { ws_ok = 0; }
    }
    assert_eq(ws_ok, 1, "a draw is λ·(−ln(1 − u))^(1/k), bit for bit on the same stream");
    e8.k = 0;
    e8.calls = 0;
    var wz2: f64 = wb.sample(&e8);
    assert(e8.calls == 1 && bits(wz2) == 0, "one uniform a draw; u = 0: (−0.0)^½ = +0.0");
    assert_eq(PmnWeibull_new(&wb, 1.0, 3.0), PMN_ERR_NONE, "Weibull(1, 3)");
    e8.k = 0;
    var wz1: f64 = wb.sample(&e8);
    assert_eq(bits(wz1), bits(mz), "k = 1: (−0.0)^1 = −0.0, as Rust's powf, so the draw is −0.0");

    test_group("JSON (1.3.0's serde_roundtrip_cauchy, _weibull and deserialize_rejects; D5)");
    assert_eq(PmnCauchy_new(&ca, 2.0, 3.0), PMN_ERR_NONE, "built");
    store64(sb + 8, 0);
    assert_eq(ca.to_json(sb), PMN_ERR_NONE, "written");
    assert(text_is(sb, "{\"x0\":2.0,\"gamma\":3.0}") == 1, "as serde_json writes it");
    var rc: PmnCauchy;
    assert_eq(PmnCauchy_from_json(&rc, load64(sb), load64(sb + 8)), PMN_ERR_NONE, "read back");
    var rcx: f64 = rc.x0;
    var rcg: f64 = rc.gamma;
    assert(rcx == 2.0 && rcg == 3.0, "the same parameters");
    var jc = "{\"x0\":0.0,\"gamma\":0.0}";
    assert_eq(PmnCauchy_from_json(&rc, jc, strlen(jc)), PMN_ERR_DESERIALIZE, "gamma 0");
    assert_eq(PmnCauchy_from_json(0, jc, strlen(jc)), PMN_ERR_INVALID_PARAMETER, "a null out");
    assert_eq(PmnWeibull_new(&wb, 2.0, 3.0), PMN_ERR_NONE, "built");
    store64(sb + 8, 0);
    assert_eq(wb.to_json(sb), PMN_ERR_NONE, "written");
    assert(text_is(sb, "{\"k\":2.0,\"lambda\":3.0}") == 1, "as serde_json writes it");
    var rw: PmnWeibull;
    assert_eq(PmnWeibull_from_json(&rw, load64(sb), load64(sb + 8)), PMN_ERR_NONE, "read back");
    var rwk: f64 = rw.k;
    var rwl: f64 = rw.lambda;
    assert(rwk == 2.0 && rwl == 3.0, "the same parameters");
    var jw = "{\"k\":-1.0,\"lambda\":1.0}";
    assert_eq(PmnWeibull_from_json(&rw, jw, strlen(jw)), PMN_ERR_DESERIALIZE, "k −1");
    var jw2 = "[2.0,3.0]";
    assert_eq(PmnWeibull_from_json(&rw, jw2, strlen(jw2)), PMN_ERR_NONE, "serde's sequence form");
    assert_eq(PmnWeibull_from_json(0, jw, strlen(jw)), PMN_ERR_INVALID_PARAMETER, "a null out");

    test_group("Debug (D12): Cauchy and Weibull");
    store64(sb + 8, 0);
    assert_eq(ca.debug(sb, 0), PMN_ERR_NONE, "Cauchy {:?}");
    assert(text_is(sb, "Cauchy { x0: 2.0, gamma: 3.0 }") == 1, "Cauchy { x0: 2.0, gamma: 3.0 }");
    store64(sb + 8, 0);
    assert_eq(ca.debug(sb, 1), PMN_ERR_NONE, "Cauchy {:#?}");
    assert(text_is(sb, "Cauchy {\n    x0: 2.0,\n    gamma: 3.0,\n}") == 1, "one field a line");
    store64(sb + 8, 0);
    assert_eq(wb.debug(sb, 0), PMN_ERR_NONE, "Weibull {:?}");
    assert(text_is(sb, "Weibull { k: 2.0, lambda: 3.0 }") == 1, "Weibull { k: 2.0, lambda: 3.0 }");
    store64(sb + 8, 0);
    assert_eq(wb.debug(sb, 1), PMN_ERR_NONE, "Weibull {:#?}");
    assert(text_is(sb, "Weibull {\n    k: 2.0,\n    lambda: 3.0,\n}") == 1, "one field a line");

    test_group("1.3.0's Gamma tests (gamma_pdf_known, _cdf_known, _mean_and_variance, _invalid_params)");
    var gm: PmnGamma;
    assert_eq(PmnGamma_new(&gm, 1.0, 1.0), PMN_ERR_NONE, "Gamma(1, 1)");
    var gp1: f64 = gm.pdf(1.0);
    var ge1: f64 = _pmn_exp(-1.0);
    assert(bits(gp1) == bits(ge1), "pdf(1) = e⁻¹ bit for bit: lnΓ(1) is 0 (1.3.0: within 1e-8)");
    var gc1: f64 = gm.cdf(1.0);
    var gce: f64 = 1.0 - ge1;
    assert(f64_abs(gc1 - gce) < 0.000000000000001, "cdf(1) = 1 − e⁻¹ within 1e-15 (1.3.0: within 1e-6)");
    assert_eq(PmnGamma_new(&gm, 3.0, 2.0), PMN_ERR_NONE, "Gamma(3, 2)");
    var gmn: f64 = gm.mean();
    var gvr: f64 = gm.variance();
    assert(gmn == 6.0 && gvr == 12.0, "mean 6 and variance 12 exactly");
    var bg: PmnGamma;
    assert_eq(PmnGamma_new(&bg, 0.0, 1.0), PMN_ERR_INVALID_PARAMETER, "alpha 0");
    assert_eq(PmnGamma_new(&bg, 1.0, 0.0), PMN_ERR_INVALID_PARAMETER, "beta 0");
    assert_eq(PmnGamma_new(&bg, -1.0, 1.0), PMN_ERR_INVALID_PARAMETER, "alpha −1");
    assert_eq(PmnGamma_new(&bg, nan, 1.0), PMN_ERR_INVALID_PARAMETER, "a NaN alpha");
    assert_eq(PmnGamma_new(&bg, 1.0, inf), PMN_ERR_INVALID_PARAMETER, "an infinite beta");
    assert_eq(PmnGamma_new(0, 1.0, 1.0), PMN_ERR_INVALID_PARAMETER, "a null out");
    bg.alpha = 7.0;
    bg.beta = 8.0;
    assert_eq(PmnGamma_new(&bg, 1.0, mz), PMN_ERR_INVALID_PARAMETER, "beta −0");
    var bga: f64 = bg.alpha;
    var bgb: f64 = bg.beta;
    assert(bga == 7.0 && bgb == 8.0, "a refusal writes nothing");

    test_group("1.3.0's Gamma sampling tests (gamma_sample_mean, gamma_small_alpha_sample)");
    assert_eq(PmnGamma_new(&gm, 5.0, 2.0), PMN_ERR_NONE, "Gamma(5, 2)");
    PmnSimpleRng_new(&g, 42);
    var gsum: f64 = 0.0;
    for (var gi = 0; gi < 50000; gi = gi + 1) {
        var gs: f64 = gm.sample(&g);
        gsum = gsum + gs;
    }
    var gavg: f64 = gsum / 50000.0;
    assert(f64_abs(gavg - 10.0) < 0.5, "50,000 draws from seed 42: the mean within 0.5 of 10");
    assert_eq(PmnGamma_new(&gm, 0.1, 1.0), PMN_ERR_NONE, "Gamma(0.1, 1)");
    PmnSimpleRng_new(&g, 42);
    var g01 = 1;
    var g01s: f64 = 0.0;
    for (var gj = 0; gj < 10000; gj = gj + 1) {
        var gt: f64 = gm.sample(&g);
        if (gt < 0.0 || _pmn_is_finite(gt) == 0) { g01 = 0; }
        g01s = g01s + gt;
    }
    var g01m: f64 = g01s / 10000.0;
    assert(g01 == 1 && f64_abs(g01m - 0.1) < 0.05,
      "α < 1, the boost: 10,000 draws, finite and ≥ 0, their mean within 0.05 of 0.1");

    test_group("1.3.0's χ² tests (chi_squared_mean_and_variance, _cdf_known, _sample_mean, _large_df_cdf)");
    var chi: PmnChiSquared;
    assert_eq(PmnChiSquared_new(&chi, 5.0), PMN_ERR_NONE, "χ²(5)");
    var csm: f64 = chi.mean();
    var csv: f64 = chi.variance();
    assert(csm == 5.0 && csv == 10.0, "mean 5 and variance 10 exactly");
    assert_eq(PmnChiSquared_new(&chi, 2.0), PMN_ERR_NONE, "χ²(2)");
    var cs2: f64 = chi.cdf(2.0);
    assert(f64_abs(cs2 - gce) < 0.000000000000001, "cdf(2) = 1 − e⁻¹ within 1e-15 (1.3.0: within 1e-4)");
    assert_eq(PmnChiSquared_new(&chi, 10.0), PMN_ERR_NONE, "χ²(10)");
    PmnSimpleRng_new(&g, 42);
    var csum: f64 = 0.0;
    for (var ci = 0; ci < 50000; ci = ci + 1) {
        var cd: f64 = chi.sample(&g);
        csum = csum + cd;
    }
    var cavg: f64 = csum / 50000.0;
    assert(f64_abs(cavg - 10.0) < 0.5, "50,000 draws from seed 42: the mean within 0.5 of 10");
    assert_eq(PmnChiSquared_new(&chi, 1000000.0), PMN_ERR_NONE, "χ²(1e6)");
    var cbig: f64 = chi.cdf(1000000.0);
    var cbw: f64 = 1.0 - 0.4998119368033945;
    assert(rel_ok(cbig, cbw, 0.00000000001) == 1, "cdf(1e6) = 1 − 0.4998119368033945 within 1e-11");
    var bcs: PmnChiSquared;
    assert_eq(PmnChiSquared_new(&bcs, inf), PMN_ERR_INVALID_PARAMETER, "an infinite df");
    assert_eq(PmnChiSquared_new(&bcs, 0.0), PMN_ERR_INVALID_PARAMETER, "df 0");
    assert_eq(PmnChiSquared_new(&bcs, nan), PMN_ERR_INVALID_PARAMETER, "a NaN df");
    assert_eq(PmnChiSquared_new(0, 1.0), PMN_ERR_INVALID_PARAMETER, "a null out");

    test_group("the oracle's wiring tests: the cdfs are P, the pdf is lnΓ's, a draw is sample_gamma_standard's");
    var p_ok = 1;
    for (var pai = 0; pai < 4; pai = pai + 1) {
        var aa: f64 = 0.05;
        if (pai == 1) { aa = 2.5; }
        if (pai == 2) { aa = 30.0; }
        if (pai == 3) { aa = 100000.0; }
        assert_eq(PmnGamma_new(&gm, aa, 1.0), PMN_ERR_NONE, "Gamma(a, 1)");
        for (var px = 1; px <= 64; px = px + 1) {
            var pxf: f64 = f64_from(px);
            var xx: f64 = pxf * aa;
            xx = xx / 16.0;
            var gcx: f64 = gm.cdf(xx);
            var pp: f64 = _pmn_regularized_lower_incomplete_gamma(aa, xx);
            if (bits(gcx) != bits(pp)) { p_ok = 0; }
        }
    }
    assert_eq(p_ok, 1, "Gamma(a, 1).cdf(x) is P(a, x), bit for bit");
    assert_eq(PmnChiSquared_new(&chi, 7.0), PMN_ERR_NONE, "χ²(7)");
    assert_eq(PmnGamma_new(&gm, 3.5, 2.0), PMN_ERR_NONE, "Gamma(3.5, 2)");
    var c_ok = 1;
    for (var cxi = 1; cxi <= 160; cxi = cxi + 1) {
        var cxf: f64 = f64_from(cxi);
        var cxx: f64 = cxf / 4.0;
        var ca1: f64 = chi.cdf(cxx);
        var cx2: f64 = cxx / 2.0;
        var cb1: f64 = _pmn_regularized_lower_incomplete_gamma(3.5, cx2);
        var pa1: f64 = chi.pdf(cxx);
        var pb1: f64 = gm.pdf(cxx);
        var ga1: f64 = gm.cdf(cxx);
        if (bits(ca1) != bits(cb1) || bits(pa1) != bits(pb1) || bits(ca1) != bits(ga1)) { c_ok = 0; }
    }
    assert_eq(c_ok, 1, "χ²(7) is Gamma(3.5, 2): cdf P(3.5, x/2) and pdf, bit for bit");
    var cg1: PmnSimpleRng;
    var cg2: PmnSimpleRng;
    var ct1: Counted;
    var ct2: Counted;
    var d_ok = 1;
    for (var da = 0; da < 4; da = da + 1) {
        var al: f64 = 0.3;
        if (da == 1) { al = 1.0; }
        if (da == 2) { al = 2.5; }
        if (da == 3) { al = 50.0; }
        assert_eq(PmnGamma_new(&gm, al, 1.0), PMN_ERR_NONE, "Gamma(α, 1)");
        PmnSimpleRng_new(&cg1, 13);
        PmnSimpleRng_new(&cg2, 13);
        ct1.g = &cg1;
        ct1.calls = 0;
        ct2.g = &cg2;
        ct2.calls = 0;
        for (var dk = 0; dk < 5000; dk = dk + 1) {
            var dra: f64 = gm.sample(&ct1);
            var drb: f64 = _pmn_sample_gamma_standard(al, &ct2);
            if (bits(dra) != bits(drb)) { d_ok = 0; }
        }
        if (ct1.calls != ct2.calls) { d_ok = 0; }
    }
    assert_eq(d_ok, 1, "Gamma(α, 1)'s draws are sample_gamma_standard(α)'s, bit for bit and draw for draw");
    assert_eq(PmnChiSquared_new(&chi, 5.0), PMN_ERR_NONE, "χ²(5)");
    assert_eq(PmnGamma_new(&gm, 2.5, 2.0), PMN_ERR_NONE, "Gamma(2.5, 2)");
    PmnSimpleRng_new(&g, 99);
    PmnSimpleRng_new(&h, 99);
    var x_ok = 1;
    for (var xk = 0; xk < 2000; xk = xk + 1) {
        var xa: f64 = chi.sample(&g);
        var xb: f64 = gm.sample(&h);
        if (bits(xa) != bits(xb)) { x_ok = 0; }
    }
    assert_eq(x_ok, 1, "χ²(5)'s draws are Gamma(2.5, 2)'s, bit for bit");

    test_group("the edges, and T1's accuracy where 1.3.0 lost it");
    assert_eq(PmnGamma_new(&gm, 2.0, 3.0), PMN_ERR_NONE, "Gamma(2, 3)");
    var e0: f64 = gm.pdf(0.0);
    var e1n: f64 = gm.pdf(-1.0);
    var e2c: f64 = gm.cdf(0.0);
    var e3c: f64 = gm.cdf(mz);
    assert(e0 == 0.0 && e1n == 0.0 && e2c == 0.0 && bits(e3c) == 0, "0 at and below 0, +0.0 at −0.0");
    var e4: f64 = gm.pdf(nan);
    var e5: f64 = gm.cdf(nan);
    var e6: f64 = gm.cdf(inf);
    var e7: f64 = gm.pdf(inf);
    assert(e4 != e4 && e5 != e5 && e6 == 1.0, "NaN at NaN; cdf(∞) = 1");
    assert(e7 != e7, "pdf(∞) is NaN, as 1.3.0's: (α − 1)·ln ∞ − ∞/β is ∞ − ∞");
    assert_eq(PmnGamma_new(&gm, tiny, 1.0), PMN_ERR_NONE, "Gamma(5e-324, 1)");
    var t0p: f64 = gm.pdf(tiny);
    var t0c: f64 = gm.cdf(tiny);
    assert(t0p == 1.0 && t0c == 1.0,
      "α = 5e-324: pdf(5e-324) = α·x^(α−1) ≈ 1 and cdf = 1 on T1 (1.3.0: 0 for both, its lnΓ(5e-324) = +∞)");
    var t0s: f64 = gm.sample(&g);
    assert_eq(bits(t0s), 0, "a draw is +0.0: the boost u^(1/α) underflows");
    assert_eq(PmnGamma_new(&gm, 10.0, 2.0), PMN_ERR_NONE, "Gamma(10, 2)");
    var x39: f64 = of_bits(0x3D80000000000000);
    var dtc: f64 = gm.cdf(x39);
    var dtw: f64 = of_bits(0x25927E4FB7788E8D);
    var dtd = bits(dtc) - bits(dtw);
    assert(dtd >= 0 - 1 && dtd <= 1,
      "cdf(2^-39) = P(10, 2^-40) within 1 ulp of MPFR's 1.0671825162164122e-127 (1.3.0: 1.3×10¹³ ulp off)");
    assert_eq(PmnGamma_new(&gm, mxu, 1.0), PMN_ERR_NONE, "Gamma(f64::MAX, 1)");
    var mxs: f64 = gm.sample(&g);
    assert(mxs == mxu, "α = f64::MAX: c = 0, so v = 1 and the draw is d = f64::MAX");

    test_group("JSON and Debug (serde_roundtrip_gamma, _chi_squared, deserialize_rejects; D5, D12)");
    assert_eq(PmnGamma_new(&gm, 3.0, 2.0), PMN_ERR_NONE, "built");
    store64(sb + 8, 0);
    assert_eq(gm.to_json(sb), PMN_ERR_NONE, "written");
    assert(text_is(sb, "{\"alpha\":3.0,\"beta\":2.0}") == 1, "as serde_json writes it");
    var rg: PmnGamma;
    assert_eq(PmnGamma_from_json(&rg, load64(sb), load64(sb + 8)), PMN_ERR_NONE, "read back");
    var rga: f64 = rg.alpha;
    var rgb: f64 = rg.beta;
    assert(rga == 3.0 && rgb == 2.0, "the same parameters");
    var jg = "{\"alpha\":0.0,\"beta\":1.0}";
    assert_eq(PmnGamma_from_json(&rg, jg, strlen(jg)), PMN_ERR_DESERIALIZE, "alpha 0");
    assert_eq(PmnGamma_from_json(0, jg, strlen(jg)), PMN_ERR_INVALID_PARAMETER, "a null out");
    assert_eq(PmnChiSquared_new(&chi, 5.0), PMN_ERR_NONE, "built");
    store64(sb + 8, 0);
    assert_eq(chi.to_json(sb), PMN_ERR_NONE, "written");
    assert(text_is(sb, "{\"df\":5.0}") == 1, "as serde_json writes it");
    var rcs: PmnChiSquared;
    assert_eq(PmnChiSquared_from_json(&rcs, load64(sb), load64(sb + 8)), PMN_ERR_NONE, "read back");
    var rdf: f64 = rcs.df;
    assert(rdf == 5.0, "the same df");
    var jc2 = "{\"df\":0.0}";
    assert_eq(PmnChiSquared_from_json(&rcs, jc2, strlen(jc2)), PMN_ERR_DESERIALIZE, "df 0");
    assert_eq(PmnChiSquared_from_json(0, jc2, strlen(jc2)), PMN_ERR_INVALID_PARAMETER, "a null out");
    store64(sb + 8, 0);
    assert_eq(gm.debug(sb, 0), PMN_ERR_NONE, "Gamma {:?}");
    assert(text_is(sb, "Gamma { alpha: 3.0, beta: 2.0 }") == 1, "Gamma { alpha: 3.0, beta: 2.0 }");
    store64(sb + 8, 0);
    assert_eq(gm.debug(sb, 1), PMN_ERR_NONE, "Gamma {:#?}");
    assert(text_is(sb, "Gamma {\n    alpha: 3.0,\n    beta: 2.0,\n}") == 1, "one field a line");
    store64(sb + 8, 0);
    assert_eq(chi.debug(sb, 0), PMN_ERR_NONE, "ChiSquared {:?}");
    assert(text_is(sb, "ChiSquared { df: 5.0 }") == 1, "ChiSquared { df: 5.0 }");
    store64(sb + 8, 0);
    assert_eq(chi.debug(sb, 1), PMN_ERR_NONE, "ChiSquared {:#?}");
    assert(text_is(sb, "ChiSquared {\n    df: 5.0,\n}") == 1, "one field a line");

    test_group("1.3.0's Beta tests (beta_mean_and_variance, _cdf_endpoints, _uniform_is_beta_1_1, _sample_in_range)");
    var bt: PmnBeta;
    assert_eq(PmnBeta_new(&bt, 2.0, 5.0), PMN_ERR_NONE, "Beta(2, 5)");
    var btm: f64 = bt.mean();
    var btv: f64 = bt.variance();
    var w27: f64 = 2.0 / 7.0;
    var wv: f64 = 10.0 / 392.0;
    assert(bits(btm) == bits(w27) && bits(btv) == bits(wv), "mean 2/7 and variance 10/392, bit for bit");
    assert_eq(PmnBeta_new(&bt, 2.0, 3.0), PMN_ERR_NONE, "Beta(2, 3)");
    var bc0: f64 = bt.cdf(0.0);
    var bc1: f64 = bt.cdf(1.0);
    assert(bc0 == 0.0 && bc1 == 1.0, "cdf(0) = 0 and cdf(1) = 1 exactly");
    assert_eq(PmnBeta_new(&bt, 1.0, 1.0), PMN_ERR_NONE, "Beta(1, 1)");
    var bp5: f64 = bt.pdf(0.5);
    var bc5: f64 = bt.cdf(0.5);
    assert(bp5 == 1.0 && bc5 == 0.5, "Beta(1, 1) is U(0, 1): pdf(½) = 1 and cdf(½) = ½ exactly (1.3.0: within 1e-8)");
    assert_eq(PmnBeta_new(&bt, 2.0, 5.0), PMN_ERR_NONE, "Beta(2, 5)");
    PmnSimpleRng_new(&g, 42);
    var b_in = 1;
    for (var bi = 0; bi < 10000; bi = bi + 1) {
        var bsx: f64 = bt.sample(&g);
        if (bsx < 0.0 || bsx > 1.0 || bsx != bsx) { b_in = 0; }
    }
    assert_eq(b_in, 1, "10,000 draws from seed 42, all in [0, 1]");
    assert_eq(PmnBeta_new(&bt, 0.5, 0.5), PMN_ERR_NONE, "Beta(0.5, 0.5)");
    PmnSimpleRng_new(&g, 42);
    var b_in2 = 1;
    for (var bj = 0; bj < 10000; bj = bj + 1) {
        var bs2: f64 = bt.sample(&g);
        if (bs2 < 0.0 || bs2 > 1.0 || bs2 != bs2) { b_in2 = 0; }
    }
    assert_eq(b_in2, 1, "α, β < 1 (beta_small_alpha_sample): 10,000 draws, all in [0, 1]");

    test_group("1.3.0's Student-t tests (symmetric_pdf, mean_and_variance, sample_symmetric, cdf_closed_forms)");
    var tt: PmnStudentT;
    assert_eq(PmnStudentT_new(&tt, 5.0), PMN_ERR_NONE, "t(5)");
    var tpp1: f64 = tt.pdf(1.0);
    var tpm1: f64 = tt.pdf(-1.0);
    var tc0: f64 = tt.cdf(0.0);
    assert(bits(tpp1) == bits(tpm1) && tc0 == 0.5, "pdf even bit for bit, cdf(0) = ½ exactly");
    var tmn: f64 = tt.mean();
    var tvr: f64 = tt.variance();
    var w53: f64 = 5.0 / 3.0;
    assert(tmn == 0.0 && bits(tvr) == bits(w53), "mean 0, variance 5/3");
    assert_eq(PmnStudentT_new(&tt, 1.0), PMN_ERR_NONE, "t(1)");
    var t1m: f64 = tt.mean();
    var t1v: f64 = tt.variance();
    assert(t1m != t1m && t1v != t1v, "df = 1: mean and variance NaN");
    assert_eq(PmnStudentT_new(&tt, 1.5), PMN_ERR_NONE, "t(1.5)");
    var t15m: f64 = tt.mean();
    var t15v: f64 = tt.variance();
    assert(t15m == 0.0 && t15v == inf, "df = 1.5: mean 0, variance +∞");
    assert_eq(PmnStudentT_new(&tt, 10.0), PMN_ERR_NONE, "t(10)");
    PmnSimpleRng_new(&g, 42);
    var tsum: f64 = 0.0;
    for (var ti = 0; ti < 50000; ti = ti + 1) {
        var ts: f64 = tt.sample(&g);
        tsum = tsum + ts;
    }
    var tavg: f64 = tsum / 50000.0;
    assert(f64_abs(tavg) < 0.1, "50,000 draws of t(10) from seed 42: the mean within 0.1 of 0");
    var t1d: PmnStudentT;
    var t2d: PmnStudentT;
    assert_eq(PmnStudentT_new(&t1d, 1.0), PMN_ERR_NONE, "t(1)");
    assert_eq(PmnStudentT_new(&t2d, 2.0), PMN_ERR_NONE, "t(2)");
    var cf_ok = 1;
    for (var ci2 = 0; ci2 < 6; ci2 = ci2 + 1) {
        var cxv: f64 = -30.0;
        if (ci2 == 1) { cxv = -2.5; }
        if (ci2 == 2) { cxv = -0.3; }
        if (ci2 == 3) { cxv = 0.0; }
        if (ci2 == 4) { cxv = 0.7; }
        if (ci2 == 5) { cxv = 4.0; }
        var c1v: f64 = t1d.cdf(cxv);
        var at: f64 = _pmn_atan(cxv);
        var atp: f64 = at / pi;
        var w1v: f64 = 0.5 + atp;
        var c2v: f64 = t2d.cdf(cxv);
        var x2v: f64 = cxv * cxv;
        var x2p: f64 = 2.0 + x2v;
        var sq2: f64 = f64_sqrt(x2p);
        var dn2: f64 = 2.0 * sq2;
        var q2v: f64 = cxv / dn2;
        var w2v: f64 = 0.5 + q2v;
        if (f64_abs(c1v - w1v) >= 0.000000000000001 || f64_abs(c2v - w2v) >= 0.000000000000001) { cf_ok = 0; }
    }
    assert_eq(cf_ok, 1, "t(1) is ½ + atan(x)/π and t(2) is ½ + x/(2√(2 + x²)), within 1e-15");
    var tail1: f64 = t1d.cdf(-10000000000.0);
    var e10: f64 = 1.0 / 10000000000.0;
    var at10: f64 = _pmn_atan(e10);
    var wt1: f64 = at10 / pi;
    assert(rel_ok(tail1, wt1, 0.000000000001) == 1, "the far tail keeps its relative precision: atan(1e-10)/π");
    var tci: f64 = t1d.cdf(inf);
    var tcn: f64 = t1d.cdf(ninf2);
    var tcnan: f64 = t1d.cdf(nan);
    assert(tci == 1.0 && tcn == 0.0 && tcnan != tcnan, "cdf(±∞) = 1 and 0, NaN at NaN");

    test_group("1.3.0's Student-t and F tests (large_df_approaches_normal, pdf_matches_gamma_form, F closed form)");
    assert_eq(PmnStudentT_new(&tt, 1000000000.0), PMN_ERR_NONE, "t(1e9)");
    assert_eq(PmnNormal_new(&n, 0.0, 1.0), PMN_ERR_NONE, "N(0, 1)");
    var tz1: f64 = tt.cdf(1.96);
    var nz1: f64 = n.cdf(1.96);
    var tz2: f64 = tt.pdf(0.3);
    var nz2: f64 = n.pdf(0.3);
    assert(f64_abs(tz1 - nz1) < 0.000000001 && f64_abs(tz2 - nz2) < 0.000000001, "t(1e9) is N(0, 1) within 1e-9");
    var gf_ok = 1;
    for (var gi2 = 0; gi2 < 3; gi2 = gi2 + 1) {
        var gdf: f64 = 0.5;
        if (gi2 == 1) { gdf = 3.0; }
        if (gi2 == 2) { gdf = 30.0; }
        assert_eq(PmnStudentT_new(&tt, gdf), PMN_ERR_NONE, "t(df)");
        var gp: f64 = tt.pdf(1.3);
        var gh: f64 = gdf + 1.0;
        gh = gh / 2.0;
        var gl1: f64 = _pmn_ln_gamma(gh);
        var ghd: f64 = gdf / 2.0;
        var gl2: f64 = _pmn_ln_gamma(ghd);
        var gpi: f64 = gdf * pi;
        var gl3: f64 = _pmn_ln(gpi);
        var gq: f64 = 1.69 / gdf;
        var gq1: f64 = 1.0 + gq;
        var gl4: f64 = _pmn_ln(gq1);
        var gsm: f64 = gl1 - gl2;
        var hl3: f64 = 0.5 * gl3;
        gsm = gsm - hl3;
        var hl4: f64 = gh * gl4;
        gsm = gsm - hl4;
        var gw: f64 = _pmn_exp(gsm);
        if (rel_ok(gp, gw, 0.0000000000001) == 0) { gf_ok = 0; }
    }
    assert_eq(gf_ok, 1, "the pdf is the lnΓ form within 1e-13, at df = 0.5, 3 and 30 (30 takes the ln B form)");
    var fdd: PmnFDistribution;
    var ff_ok = 1;
    for (var fi = 0; fi < 3; fi = fi + 1) {
        var fd2v: f64 = 5.0;
        if (fi == 1) { fd2v = 100.0; }
        if (fi == 2) { fd2v = 1000000.0; }
        assert_eq(PmnFDistribution_new(&fdd, 2.0, fd2v), PMN_ERR_NONE, "F(2, d2)");
        var fcv: f64 = fdd.cdf(2.5);
        var f5: f64 = 5.0 / fd2v;
        var fl1: f64 = _pmn_ln_1p(f5);
        var fh: f64 = -fd2v;
        fh = fh / 2.0;
        var fm: f64 = fh * fl1;
        var fem: f64 = _pmn_exp_m1(fm);
        var fw: f64 = -fem;
        if (rel_ok(fcv, fw, 0.000000000001) == 0) { ff_ok = 0; }
    }
    assert_eq(ff_ok, 1, "F(2, d2)'s cdf is 1 − (1 + 2x/d2)^(−d2/2) within 1e-12, d2 = 5, 100 and 1e6");
    var sfc, sfs = _pmn_f_cdf_sf(1000000.0, 2.0, 5.0);
    var sfb: f64 = 2000000.0 / 5.0;
    sfb = 1.0 + sfb;
    var sfw: f64 = _pmn_powf(sfb, -2.5);
    assert(rel_ok(sfs, sfw, 0.00000000001) == 1, "the upper tail is direct: no 1 − cdf rounding to 0");
    var sic, sis = _pmn_f_cdf_sf(inf, 2.0, 5.0);
    assert(sic == 1.0 && sis == 0.0, "f_cdf_sf(∞) = (1, 0)");

    test_group("1.3.0's F tests (f_distribution_mean, _variance, _cdf_nonneg, _sample_positive)");
    assert_eq(PmnFDistribution_new(&fdd, 5.0, 10.0), PMN_ERR_NONE, "F(5, 10)");
    var fmn: f64 = fdd.mean();
    var fvr: f64 = fdd.variance();
    var w108: f64 = 10.0 / 8.0;
    var wfv: f64 = 2600.0 / 1920.0;
    assert(bits(fmn) == bits(w108) && f64_abs(fvr - wfv) < 0.0000000001, "mean 10/8 exactly, variance 2600/1920");
    var fc0: f64 = fdd.cdf(0.0);
    var fc100: f64 = fdd.cdf(100.0);
    assert(fc0 == 0.0 && fc100 > 0.99, "cdf(0) = 0, cdf(100) > 0.99");
    PmnSimpleRng_new(&g, 42);
    var f_pos = 1;
    for (var fj = 0; fj < 10000; fj = fj + 1) {
        var fs: f64 = fdd.sample(&g);
        if (!(fs > 0.0)) { f_pos = 0; }
    }
    assert_eq(f_pos, 1, "10,000 draws from seed 42, all positive");
    assert_eq(PmnFDistribution_new(&fdd, 5.0, 2.0), PMN_ERR_NONE, "F(5, 2)");
    var f2m: f64 = fdd.mean();
    assert(f2m != f2m, "d2 ≤ 2: mean NaN");
    assert_eq(PmnFDistribution_new(&fdd, 5.0, 4.0), PMN_ERR_NONE, "F(5, 4)");
    var f4v: f64 = fdd.variance();
    var f4m: f64 = fdd.mean();
    assert(f4v != f4v && f4m == 2.0, "d2 ≤ 4: variance NaN, mean 4/2");

    test_group("the constructors' refusals (constructors_reject_non_finite_parameters; D11)");
    var bbt: PmnBeta;
    assert_eq(PmnBeta_new(&bbt, 1.0, nan), PMN_ERR_INVALID_PARAMETER, "a NaN beta");
    assert_eq(PmnBeta_new(&bbt, 0.0, 1.0), PMN_ERR_INVALID_PARAMETER, "alpha 0");
    assert_eq(PmnBeta_new(&bbt, 1.0, inf), PMN_ERR_INVALID_PARAMETER, "an infinite beta");
    assert_eq(PmnBeta_new(0, 1.0, 1.0), PMN_ERR_INVALID_PARAMETER, "a null out");
    bbt.alpha = 7.0;
    bbt.beta = 8.0;
    assert_eq(PmnBeta_new(&bbt, -1.0, 1.0), PMN_ERR_INVALID_PARAMETER, "alpha −1");
    var bba: f64 = bbt.alpha;
    assert(bba == 7.0, "a refusal writes nothing");
    var btt: PmnStudentT;
    assert_eq(PmnStudentT_new(&btt, nan), PMN_ERR_INVALID_PARAMETER, "a NaN df");
    assert_eq(PmnStudentT_new(&btt, mz), PMN_ERR_INVALID_PARAMETER, "df −0");
    assert_eq(PmnStudentT_new(0, 1.0), PMN_ERR_INVALID_PARAMETER, "a null out");
    var bfd: PmnFDistribution;
    assert_eq(PmnFDistribution_new(&bfd, 1.0, nan), PMN_ERR_INVALID_PARAMETER, "a NaN d2");
    assert_eq(PmnFDistribution_new(&bfd, inf, 1.0), PMN_ERR_INVALID_PARAMETER, "an infinite d1");
    assert_eq(PmnFDistribution_new(0, 1.0, 1.0), PMN_ERR_INVALID_PARAMETER, "a null out");

    test_group("the oracle's wiring tests: each cdf is its incomplete-beta hook's, bit for bit");
    var wi_ok = 1;
    for (var wb1 = 0; wb1 < 4; wb1 = wb1 + 1) {
        var wa: f64 = 0.5;
        var wbv: f64 = 0.5;
        if (wb1 == 1) {
            wa = 2.0;
            wbv = 5.0;
        }
        if (wb1 == 2) {
            wa = 30.0;
            wbv = 0.7;
        }
        if (wb1 == 3) {
            wa = 400.0;
            wbv = 350.0;
        }
        assert_eq(PmnBeta_new(&bt, wa, wbv), PMN_ERR_NONE, "Beta(a, b)");
        for (var wk = 1; wk < 64; wk = wk + 1) {
            var wkf: f64 = f64_from(wk);
            var wxx: f64 = wkf / 64.0;
            var wc: f64 = bt.cdf(wxx);
            var wix: f64 = _pmn_regularized_incomplete_beta(wxx, wa, wbv);
            var wy: f64 = 1.0 - wxx;
            var wbi, wbq = _pmn_beta_inc(wa, wbv, wxx, wy);
            if (bits(wc) != bits(wix) || bits(wbi) != bits(wix)) { wi_ok = 0; }
        }
    }
    assert_eq(wi_ok, 1, "Beta(a, b).cdf(x) is I_x(a, b) is beta_inc(a, b, x, 1 − x)'s first value");
    var wt_ok = 1;
    for (var wd = 0; wd < 4; wd = wd + 1) {
        var wdf: f64 = 1.0;
        if (wd == 1) { wdf = 3.5; }
        if (wd == 2) { wdf = 30.0; }
        if (wd == 3) { wdf = 1000000.0; }
        assert_eq(PmnStudentT_new(&tt, wdf), PMN_ERR_NONE, "t(df)");
        for (var wt = 0 - 50; wt <= 50; wt = wt + 1) {
            var wtf: f64 = f64_from(wt);
            var wtc: f64 = tt.cdf(wtf);
            var wth: f64 = _pmn_student_t_cdf(wtf, wdf);
            if (bits(wtc) != bits(wth)) { wt_ok = 0; }
        }
    }
    assert_eq(wt_ok, 1, "StudentT(df).cdf(t) is student_t_cdf(t, df)");
    assert_eq(PmnFDistribution_new(&fdd, 4.0, 9.0), PMN_ERR_NONE, "F(4, 9)");
    var wf_ok = 1;
    for (var wfx = 1; wfx <= 120; wfx = wfx + 1) {
        var wff: f64 = f64_from(wfx);
        var wfv2: f64 = wff / 4.0;
        var wfc: f64 = fdd.cdf(wfv2);
        var wsc, wss = _pmn_f_cdf_sf(wfv2, 4.0, 9.0);
        if (bits(wfc) != bits(wsc)) { wf_ok = 0; }
    }
    assert_eq(wf_ok, 1, "FDistribution(4, 9).cdf(x) is f_cdf_sf(x, 4, 9)'s first value");

    test_group("the edges and identities");
    assert_eq(PmnBeta_new(&bt, 2.0, 5.0), PMN_ERR_NONE, "Beta(2, 5)");
    var be0: f64 = bt.pdf(0.0);
    var be1: f64 = bt.pdf(1.0);
    var bepn: f64 = bt.pdf(nan);
    var becn: f64 = bt.cdf(nan);
    var becm: f64 = bt.cdf(-1.0);
    var becp: f64 = bt.cdf(2.0);
    assert(be0 == 0.0 && be1 == 0.0 && bepn != bepn && becn != becn, "the pdf is 0 at 0 and 1, NaN at NaN");
    assert(becm == 0.0 && becp == 1.0, "the cdf is 0 below and 1 above");
    PmnSimpleRng_new(&g, 7);
    PmnSimpleRng_new(&h, 7);
    var bd_ok = 1;
    for (var bk = 0; bk < 2000; bk = bk + 1) {
        var bda: f64 = bt.sample(&g);
        var bgx: f64 = _pmn_sample_gamma_standard(2.0, &h);
        var bgy: f64 = _pmn_sample_gamma_standard(5.0, &h);
        var bgs: f64 = bgx + bgy;
        var bdb: f64 = bgx / bgs;
        if (bits(bda) != bits(bdb)) { bd_ok = 0; }
    }
    assert_eq(bd_ok, 1, "a Beta draw is X/(X + Y), X ~ Gamma(α, 1) then Y ~ Gamma(β, 1), bit for bit");
    var t0a: f64 = _pmn_student_t_two_tailed(0.0, 3.0);
    var tna: f64 = _pmn_student_t_two_tailed(nan, 3.0);
    var tnb: f64 = _pmn_student_t_two_tailed(1.0, nan);
    var tia: f64 = _pmn_student_t_two_tailed(inf, 3.0);
    assert(t0a == 1.0 && tna != tna && tnb != tnb && tia == 0.0, "P(|T| ≥ 0) = 1, P(|T| ≥ ∞) = 0, NaN at NaN");
    var tsy = 1;
    for (var tk = 1; tk <= 80; tk = tk + 1) {
        var tkf: f64 = f64_from(tk);
        var tkx: f64 = tkf / 4.0;
        var tnk: f64 = -tkx;
        var tpa: f64 = _pmn_student_t_two_tailed(tkx, 3.5);
        var tpb: f64 = _pmn_student_t_two_tailed(tnk, 3.5);
        if (bits(tpa) != bits(tpb)) { tsy = 0; }
    }
    assert_eq(tsy, 1, "the two-tailed p-value is even in t, bit for bit");
    assert_eq(PmnStudentT_new(&tt, 3.0), PMN_ERR_NONE, "t(3)");
    PmnSimpleRng_new(&g, 7);
    PmnSimpleRng_new(&h, 7);
    var td_ok = 1;
    for (var tq = 0; tq < 2000; tq = tq + 1) {
        var tda: f64 = tt.sample(&g);
        var tz: f64 = _pmn_standard_normal(&h);
        var tg: f64 = _pmn_sample_gamma_standard(1.5, &h);
        var tv: f64 = tg * 2.0;
        var tvd: f64 = tv / 3.0;
        var tsq: f64 = f64_sqrt(tvd);
        var tdb: f64 = tz / tsq;
        if (bits(tda) != bits(tdb)) { td_ok = 0; }
    }
    assert_eq(td_ok, 1, "a t draw is Z/√(V/df), Z from Box–Muller then V a χ² variate, bit for bit");
    var zc, zs = _pmn_f_cdf_sf(0.0, 4.0, 9.0);
    var nc, ns = _pmn_f_cdf_sf(nan, 4.0, 9.0);
    var mc, ms = _pmn_f_cdf_sf(-1.0, 4.0, 9.0);
    assert(zc == 0.0 && zs == 1.0 && mc == 0.0 && ms == 1.0, "f_cdf_sf is (0, 1) at and below 0");
    assert(nc != nc && ns != ns, "(NaN, NaN) at NaN");
    var cc_ok = 1;
    for (var ck = 1; ck <= 64; ck = ck + 1) {
        var ckf: f64 = f64_from(ck);
        var ckx: f64 = ckf / 8.0;
        var ccc, ccs = _pmn_f_cdf_sf(ckx, 4.0, 9.0);
        var csum2: f64 = ccc + ccs;
        if (f64_abs(csum2 - 1.0) > 0.000000000000001) { cc_ok = 0; }
    }
    assert_eq(cc_ok, 1, "the cdf and the survival sum to 1 within 1e-15");

    test_group("JSON and Debug (the serde round trips and deserialize_rejects; D5, D12)");
    assert_eq(PmnBeta_new(&bt, 2.0, 5.0), PMN_ERR_NONE, "built");
    store64(sb + 8, 0);
    assert_eq(bt.to_json(sb), PMN_ERR_NONE, "written");
    assert(text_is(sb, "{\"alpha\":2.0,\"beta\":5.0}") == 1, "as serde_json writes it");
    var rbt: PmnBeta;
    assert_eq(PmnBeta_from_json(&rbt, load64(sb), load64(sb + 8)), PMN_ERR_NONE, "read back");
    var rba: f64 = rbt.alpha;
    var rbb: f64 = rbt.beta;
    assert(rba == 2.0 && rbb == 5.0, "the same shapes");
    var jb = "{\"alpha\":1.0,\"beta\":-2.0}";
    assert_eq(PmnBeta_from_json(&rbt, jb, strlen(jb)), PMN_ERR_DESERIALIZE, "beta −2");
    assert_eq(PmnStudentT_new(&tt, 5.0), PMN_ERR_NONE, "built");
    store64(sb + 8, 0);
    assert_eq(tt.to_json(sb), PMN_ERR_NONE, "written");
    assert(text_is(sb, "{\"df\":5.0}") == 1, "as serde_json writes it");
    var rtt: PmnStudentT;
    assert_eq(PmnStudentT_from_json(&rtt, load64(sb), load64(sb + 8)), PMN_ERR_NONE, "read back");
    var jt = "{\"df\":-1.0}";
    assert_eq(PmnStudentT_from_json(&rtt, jt, strlen(jt)), PMN_ERR_DESERIALIZE, "df −1");
    assert_eq(PmnFDistribution_new(&fdd, 5.0, 10.0), PMN_ERR_NONE, "built");
    store64(sb + 8, 0);
    assert_eq(fdd.to_json(sb), PMN_ERR_NONE, "written");
    assert(text_is(sb, "{\"d1\":5.0,\"d2\":10.0}") == 1, "as serde_json writes it");
    var rfd: PmnFDistribution;
    assert_eq(PmnFDistribution_from_json(&rfd, load64(sb), load64(sb + 8)), PMN_ERR_NONE, "read back");
    var rf1: f64 = rfd.d1;
    var rf2: f64 = rfd.d2;
    assert(rf1 == 5.0 && rf2 == 10.0, "the same degrees of freedom");
    var jf = "{\"d1\":1.0,\"d2\":0.0}";
    assert_eq(PmnFDistribution_from_json(&rfd, jf, strlen(jf)), PMN_ERR_DESERIALIZE, "d2 0");
    assert_eq(PmnFDistribution_from_json(0, jf, strlen(jf)), PMN_ERR_INVALID_PARAMETER, "a null out");
    store64(sb + 8, 0);
    assert_eq(bt.debug(sb, 0), PMN_ERR_NONE, "Beta {:?}");
    assert(text_is(sb, "Beta { alpha: 2.0, beta: 5.0 }") == 1, "Beta { alpha: 2.0, beta: 5.0 }");
    store64(sb + 8, 0);
    assert_eq(tt.debug(sb, 1), PMN_ERR_NONE, "StudentT {:#?}");
    assert(text_is(sb, "StudentT {\n    df: 5.0,\n}") == 1, "one field a line");
    store64(sb + 8, 0);
    assert_eq(fdd.debug(sb, 0), PMN_ERR_NONE, "FDistribution {:?}");
    assert(text_is(sb, "FDistribution { d1: 5.0, d2: 10.0 }") == 1, "FDistribution { d1: 5.0, d2: 10.0 }");
    store64(sb + 8, 0);
    assert_eq(fdd.debug(sb, 1), PMN_ERR_NONE, "FDistribution {:#?}");
    assert(text_is(sb, "FDistribution {\n    d1: 5.0,\n    d2: 10.0,\n}") == 1, "one field a line");

    test_group("1.3.0's Poisson tests (poisson_pmf, _pmf_and_cdf_reference, _huge_arguments_are_fast_and_bounded)");
    var po: PmnPoisson;
    assert_eq(PmnPoisson_new(&po, 2.0), PMN_ERR_NONE, "Poisson(2)");
    var pe: f64 = of_bits(0x4005BF0A8B145769);
    var pe2: f64 = _pmn_powf(pe, -2.0);
    var pw3: f64 = 8.0 * pe2;
    pw3 = pw3 / 6.0;
    var pp3: f64 = po.pdf(3.0);
    assert(f64_abs(pp3 - pw3) < 0.0000000001, "pmf(3; 2) = 8e⁻²/6 within 1e-10");
    assert_eq(PmnPoisson_new(&po, 2.5), PMN_ERR_NONE, "Poisson(2.5)");
    var pq3: f64 = po.pdf(3.0);
    assert(rel_ok(pq3, 0.21376301724973645, 0.00000000000001) == 1, "pmf(3; 2.5) within 1e-14");
    var psum: f64 = 0.0;
    for (var pk = 0; pk <= 6; pk = pk + 1) {
        var pkf: f64 = f64_from(pk);
        var pkv: f64 = po.pdf(pkf);
        psum = psum + pkv;
    }
    var pc6: f64 = po.cdf(6.0);
    assert(rel_ok(pc6, psum, 0.00000000000001) == 1, "cdf(6; 2.5) is the pmf's sum within 1e-14");
    var p100: PmnPoisson;
    assert_eq(PmnPoisson_new(&p100, 100.0), PMN_ERR_NONE, "Poisson(100)");
    var pc120: f64 = p100.cdf(120.0);
    assert(rel_ok(pc120, 0.9773306709216473, 0.0000000000001) == 1, "cdf(120; 100) within 1e-13");
    var p1e4: PmnPoisson;
    assert_eq(PmnPoisson_new(&p1e4, 10000.0), PMN_ERR_NONE, "Poisson(1e4)");
    var pc1e4: f64 = p1e4.cdf(10000.0);
    assert(rel_ok(pc1e4, 0.5026595812190076, 0.000000000001) == 1, "cdf(1e4; 1e4) within 1e-12");
    assert_eq(PmnPoisson_new(&po, 3.0), PMN_ERR_NONE, "Poisson(3)");
    var pbig: f64 = po.cdf(1000000000000000000.0);
    var pinf: f64 = po.cdf(inf);
    var ppbig: f64 = po.pdf(1000000000000000.0);
    var pcnan: f64 = po.cdf(nan);
    assert(pbig == 1.0 && pinf == 1.0 && ppbig == 0.0 && pcnan != pcnan, "cdf(1e18) = cdf(∞) = 1, pmf(1e15) = 0, NaN");
    var p12: PmnPoisson;
    assert_eq(PmnPoisson_new(&p12, 1000000000000.0), PMN_ERR_NONE, "Poisson(1e12)");
    var p12c: f64 = p12.cdf(1000000000000.0);
    var p12p: f64 = p12.pdf(1000000000000.0);
    assert(f64_abs(p12c - 0.5) < 0.001 && p12p > 0.0, "λ = 1e12: cdf(λ) within 1e-3 of ½, pmf(λ) > 0, in O(1)");

    test_group("1.3.0's Poisson sampling tests (poisson_large_lambda_sample, poisson_ptrs_sampling_moments)");
    assert_eq(PmnPoisson_new(&po, 100.0), PMN_ERR_NONE, "Poisson(100)");
    PmnSimpleRng_new(&g, 42);
    var ps_ok = 1;
    var pssum: f64 = 0.0;
    for (var pi1 = 0; pi1 < 10000; pi1 = pi1 + 1) {
        var psd: f64 = po.sample(&g);
        if (psd < 0.0 || _pmn_is_finite(psd) == 0) { ps_ok = 0; }
        pssum = pssum + psd;
    }
    var psavg: f64 = pssum / 10000.0;
    assert(ps_ok == 1 && f64_abs(psavg - 100.0) < 5.0, "10,000 draws of Poisson(100) from seed 42: ≥ 0, mean within 5");
    var pm_ok = 1;
    for (var pl = 0; pl < 3; pl = pl + 1) {
        var lam: f64 = 31.0;
        if (pl == 1) { lam = 100.0; }
        if (pl == 2) { lam = 1000000.0; }
        assert_eq(PmnPoisson_new(&po, lam), PMN_ERR_NONE, "Poisson(λ)");
        PmnSimpleRng_new(&g, 2024);
        var smean: f64 = 0.0;
        var ssq: f64 = 0.0;
        for (var pj = 0; pj < 20000; pj = pj + 1) {
            var pd: f64 = po.sample(&g);
            var pfr: f64 = _pmn_fract(pd);
            if (pd < 0.0 || pfr != 0.0) { pm_ok = 0; }
            smean = smean + pd;
            ssq = ssq + pd * pd;
        }
        var mn: f64 = smean / 20000.0;
        var m2: f64 = mn * mn;
        m2 = m2 * 20000.0;
        var vr: f64 = ssq - m2;
        vr = vr / 19999.0;
        var se: f64 = lam / 20000.0;
        se = f64_sqrt(se);
        se = 5.0 * se;
        var vq: f64 = vr / lam;
        vq = vq - 1.0;
        if (f64_abs(mn - lam) >= se || f64_abs(vq) >= 0.06) { pm_ok = 0; }
    }
    assert_eq(pm_ok, 1, "PTRS at λ = 31, 100, 1e6: 20,000 integer draws, mean within 5 standard errors, variance 6%");

    test_group("the oracle's PTRS wiring test, Knuth's draw count, and the constructor (D11)");
    var pt_ok = 1;
    for (var pt = 0; pt < 4; pt = pt + 1) {
        var tl: f64 = 31.0;
        if (pt == 1) { tl = 100.0; }
        if (pt == 2) { tl = 10000.0; }
        if (pt == 3) { tl = 100000000.0; }
        assert_eq(PmnPoisson_new(&po, tl), PMN_ERR_NONE, "Poisson(λ)");
        PmnSimpleRng_new(&cg1, 11);
        PmnSimpleRng_new(&cg2, 11);
        ct1.g = &cg1;
        ct1.calls = 0;
        ct2.g = &cg2;
        ct2.calls = 0;
        for (var tki = 0; tki < 5000; tki = tki + 1) {
            var ta: f64 = po.sample(&ct1);
            var tb: f64 = _pmn_sample_poisson_ptrs(tl, &ct2);
            if (bits(ta) != bits(tb)) { pt_ok = 0; }
        }
        if (ct1.calls != ct2.calls) { pt_ok = 0; }
    }
    assert_eq(pt_ok, 1, "above λ = 30 a draw is sample_poisson_ptrs', bit for bit and draw for draw");
    assert_eq(PmnPoisson_new(&po, 30.0), PMN_ERR_NONE, "Poisson(30), Knuth's last rate");
    PmnSimpleRng_new(&cg1, 5);
    ct1.g = &cg1;
    ct1.calls = 0;
    var ksum = 0;
    for (var kk = 0; kk < 1000; kk = kk + 1) {
        var kd: f64 = po.sample(&ct1);
        ksum = ksum + f64_to(kd);
    }
    assert_eq(ct1.calls, ksum + 1000, "Knuth: a draw of k takes k + 1 uniforms");
    assert_eq(PmnPoisson_new(&po, tiny), PMN_ERR_NONE, "Poisson(5e-324)");
    var kz: f64 = po.sample(&g);
    assert(bits(kz) == 0, "e^-λ = 1: the first product is ≤ 1, so the draw is 0");
    var bpo: PmnPoisson;
    assert_eq(PmnPoisson_new(&bpo, nan), PMN_ERR_INVALID_PARAMETER, "a NaN lambda");
    assert_eq(PmnPoisson_new(&bpo, inf), PMN_ERR_INVALID_PARAMETER, "an infinite lambda");
    assert_eq(PmnPoisson_new(&bpo, 0.0), PMN_ERR_INVALID_PARAMETER, "lambda 0");
    assert_eq(PmnPoisson_new(0, 1.0), PMN_ERR_INVALID_PARAMETER, "a null out");
    bpo.lambda = 7.0;
    assert_eq(PmnPoisson_new(&bpo, -1.0), PMN_ERR_INVALID_PARAMETER, "lambda −1");
    var bpl: f64 = bpo.lambda;
    assert(bpl == 7.0, "a refusal writes nothing");

    test_group("the pmf's and cdf's edges");
    assert_eq(PmnPoisson_new(&po, 2.5), PMN_ERR_NONE, "Poisson(2.5)");
    var pz0: f64 = po.pdf(mz);
    var e25: f64 = _pmn_exp(-2.5);
    assert(bits(pz0) == bits(e25), "pmf(−0.0) = e^-λ, bit for bit");
    var pf1: f64 = po.pdf(2.5);
    var pf2: f64 = po.pdf(of_bits(0x4008000000000001));
    var pf3: f64 = po.pdf(-1.0);
    var pf4: f64 = po.pdf(inf);
    assert(pf1 == 0.0 && pf2 == 0.0 && pf3 == 0.0 && pf4 == 0.0, "0 off the integers (3 + ulp too), below 0, at ∞");
    var nneg: f64 = of_bits(0xFFF8000000000000);
    var pfn: f64 = po.pdf(nneg);
    var pcn: f64 = po.cdf(nneg);
    assert(bits(pfn) == 0x7FF8000000000000 && bits(pcn) == 0x7FF8000000000000, "NaN in, Rust's quiet f64::NAN out");
    var pcm: f64 = po.cdf(-0.5);
    var pc27: f64 = po.cdf(2.7);
    var pc2: f64 = po.cdf(2.0);
    assert(pcm == 0.0 && bits(pc27) == bits(pc2), "cdf 0 below 0, and constant between the integers");
    var pmn: f64 = po.mean();
    var pvr: f64 = po.variance();
    assert(pmn == 2.5 && pvr == 2.5, "mean and variance λ");

    test_group("JSON and Debug (serde_roundtrip_poisson, deserialize_rejects; D5, D12)");
    store64(sb + 8, 0);
    assert_eq(po.to_json(sb), PMN_ERR_NONE, "written");
    assert(text_is(sb, "{\"lambda\":2.5}") == 1, "as serde_json writes it");
    var rpo: PmnPoisson;
    assert_eq(PmnPoisson_from_json(&rpo, load64(sb), load64(sb + 8)), PMN_ERR_NONE, "read back");
    var rpl: f64 = rpo.lambda;
    assert(rpl == 2.5, "the same lambda");
    var jp = "{\"lambda\":-3.0}";
    assert_eq(PmnPoisson_from_json(&rpo, jp, strlen(jp)), PMN_ERR_DESERIALIZE, "lambda −3");
    assert_eq(PmnPoisson_from_json(0, jp, strlen(jp)), PMN_ERR_INVALID_PARAMETER, "a null out");
    store64(sb + 8, 0);
    assert_eq(po.debug(sb, 0), PMN_ERR_NONE, "Poisson {:?}");
    assert(text_is(sb, "Poisson { lambda: 2.5 }") == 1, "Poisson { lambda: 2.5 }");
    store64(sb + 8, 0);
    assert_eq(po.debug(sb, 1), PMN_ERR_NONE, "Poisson {:#?}");
    assert(text_is(sb, "Poisson {\n    lambda: 2.5,\n}") == 1, "one field a line");

    test_group("1.3.0's Binomial tests (mean_and_variance, degenerate_p, pmf_matches_exact_and_cdf_matches_sum)");
    var bnm: PmnBinomial;
    assert_eq(PmnBinomial_new(&bnm, 10, 0.3), PMN_ERR_NONE, "Binomial(10, 0.3)");
    var bim: f64 = bnm.mean();
    var biv: f64 = bnm.variance();
    var w3v: f64 = 10.0 * 0.3;
    var w21: f64 = w3v * 0.7;
    assert(bits(bim) == bits(w3v) && bits(biv) == bits(w21), "mean n·p and variance n·p·(1 − p), bit for bit");
    assert(f64_abs(bim - 3.0) < 0.0000000001 && f64_abs(biv - 2.1) < 0.0000000001, "3 and 2.1 within 1e-10");
    var b0d: PmnBinomial;
    assert_eq(PmnBinomial_new(&b0d, 10, 0.0), PMN_ERR_NONE, "Binomial(10, 0)");
    var dg1: f64 = b0d.pdf(0.0);
    var dg2: f64 = b0d.pdf(3.0);
    var dg3: f64 = b0d.cdf(0.0);
    assert(dg1 == 1.0 && dg2 == 0.0 && dg3 == 1.0, "p = 0: all the mass at 0");
    var b1d: PmnBinomial;
    assert_eq(PmnBinomial_new(&b1d, 10, 1.0), PMN_ERR_NONE, "Binomial(10, 1)");
    var dg4: f64 = b1d.pdf(10.0);
    var dg5: f64 = b1d.pdf(9.0);
    var dg6: f64 = b1d.cdf(9.0);
    var dg7: f64 = b1d.cdf(10.0);
    assert(dg4 == 1.0 && dg5 == 0.0 && dg6 == 0.0 && dg7 == 1.0, "p = 1: all the mass at n");
    PmnSimpleRng_new(&g, 1);
    assert_eq(PmnBinomial_new(&bnm, 1000, 1.0), PMN_ERR_NONE, "Binomial(1000, 1)");
    var dg8: f64 = bnm.sample(&g);
    assert_eq(PmnBinomial_new(&bnm, 1000, 0.0), PMN_ERR_NONE, "Binomial(1000, 0)");
    var dg9: f64 = bnm.sample(&g);
    assert(dg8 == 1000.0 && dg9 == 0.0, "draws of 1000 and 0");
    assert_eq(PmnBinomial_new(&bnm, 20, 0.3), PMN_ERR_NONE, "Binomial(20, 0.3)");
    var cum: f64 = 0.0;
    var ex_ok = 1;
    var cb: PmnU128;
    for (var bkk = 0; bkk <= 20; bkk = bkk + 1) {
        if (pmn_combinations(20, bkk, &cb) != PMN_ERR_NONE) { ex_ok = 0; }
        var ccf: f64 = f64_from(cb.lo);
        var ppk: f64 = _pmn_powi(0.3, bkk);
        var qk: f64 = _pmn_powi(0.7, 20 - bkk);
        var exact: f64 = ccf * ppk;
        exact = exact * qk;
        var bkf: f64 = f64_from(bkk);
        var pmf: f64 = bnm.pdf(bkf);
        if (rel_ok(pmf, exact, 0.0000000000001) == 0) { ex_ok = 0; }
        cum = cum + exact;
        if (bkk < 20) {
            var cdv: f64 = bnm.cdf(bkf);
            if (rel_ok(cdv, cum, 0.000000000001) == 0) { ex_ok = 0; }
        }
    }
    assert_eq(ex_ok, 1, "the pmf is C(20, k)·0.3^k·0.7^(20−k) within 1e-13, the cdf its running sum within 1e-12");

    test_group("1.3.0's large-n tests (binomial_large_n_is_fast_and_accurate, _large_n_sampling_moments)");
    assert_eq(PmnBinomial_new(&bnm, 1000000, 0.5), PMN_ERR_NONE, "Binomial(1e6, 0.5)");
    var hv: f64 = 500000.0;
    var bch: f64 = bnm.cdf(hv);
    var bph: f64 = bnm.pdf(hv);
    var hpv: f64 = 0.5 * bph;
    var wch: f64 = 0.5 + hpv;
    assert(rel_ok(bch, wch, 0.000000000001) == 1, "the symmetric cdf: P(X ≤ n/2) = ½ + P(X = n/2)/2 within 1e-12");
    var pih: f64 = pi * hv;
    var sph: f64 = f64_sqrt(pih);
    var iph: f64 = 1.0 / sph;
    var c4n: f64 = 1.0 / 4000000.0;
    var c4: f64 = 1.0 - c4n;
    var wph: f64 = iph * c4;
    assert(rel_ok(bph, wph, 0.000000001) == 1, "the central pmf ≈ (1 − 1/4n)/√(πn/2) within 1e-9");
    var bmx: PmnBinomial;
    assert_eq(PmnBinomial_new(&bmx, 0 - 1, 0.25), PMN_ERR_NONE, "Binomial(u64::MAX, 0.25)");
    PmnSimpleRng_new(&g, 77);
    var bsm: f64 = bmx.sample(&g);
    var umx: f64 = _pmn_u64_to_f64(0 - 1);
    var bfr: f64 = bsm / umx;
    assert(f64_abs(bfr - 0.25) < 0.000001, "u64::MAX trials: a draw within 1e-6 of a quarter, in O(log n)");
    assert_eq(PmnBinomial_new(&bnm, 10000, 0.3), PMN_ERR_NONE, "Binomial(1e4, 0.3)");
    PmnSimpleRng_new(&g, 31337);
    var lsum: f64 = 0.0;
    var lsq: f64 = 0.0;
    var l_ok = 1;
    for (var li = 0; li < 20000; li = li + 1) {
        var ld: f64 = bnm.sample(&g);
        var lfr: f64 = _pmn_fract(ld);
        if (ld < 0.0 || ld > 10000.0 || lfr != 0.0) { l_ok = 0; }
        lsum = lsum + ld;
        lsq = lsq + ld * ld;
    }
    var lmn: f64 = lsum / 20000.0;
    var lm2: f64 = lmn * lmn;
    lm2 = lm2 * 20000.0;
    var lvr: f64 = lsq - lm2;
    lvr = lvr / 19999.0;
    var lse: f64 = 2100.0 / 20000.0;
    lse = f64_sqrt(lse);
    lse = 5.0 * lse;
    var lvq: f64 = lvr / 2100.0;
    lvq = lvq - 1.0;
    assert(l_ok == 1 && f64_abs(lmn - 3000.0) < lse && f64_abs(lvq) < 0.06,
      "20,000 Beta-split draws: integers in [0, n], mean within 5 standard errors, variance 6%");

    test_group("the constructor, the unsigned n and the draws (D11)");
    var bbi: PmnBinomial;
    assert_eq(PmnBinomial_new(&bbi, 0, 0.5), PMN_ERR_INVALID_PARAMETER, "n = 0");
    assert_eq(PmnBinomial_new(&bbi, 10, nan), PMN_ERR_INVALID_PARAMETER, "a NaN p");
    assert_eq(PmnBinomial_new(&bbi, 10, 1.5), PMN_ERR_INVALID_PARAMETER, "p = 1.5");
    assert_eq(PmnBinomial_new(0, 10, 0.5), PMN_ERR_INVALID_PARAMETER, "a null out");
    bbi.n = 7;
    bbi.p = 0.25;
    assert_eq(PmnBinomial_new(&bbi, 5, -0.1), PMN_ERR_INVALID_PARAMETER, "p = −0.1");
    var bbp: f64 = bbi.p;
    assert(bbi.n == 7 && bbp == 0.25, "a refusal writes nothing");
    var h63 = 0x8000000000000000;
    assert_eq(PmnBinomial_new(&bbi, h63, 0.5), PMN_ERR_NONE, "n = 2^63: its word is negative as an i64");
    var h63m: f64 = bbi.mean();
    var w62: f64 = of_bits(0x43D0000000000000);
    assert(h63m == w62, "the mean is 2^62: n converts unsigned");
    var h63c: f64 = bbi.cdf(inf);
    var h63p: f64 = bbi.pdf(-1.0);
    assert(h63c == 1.0 && h63p == 0.0, "cdf 1 at ∞, pmf 0 below 0");
    assert_eq(PmnBinomial_new(&bnm, 64, 0.5), PMN_ERR_NONE, "Binomial(64, 0.5): simulated directly");
    ct1.g = &cg1;
    PmnSimpleRng_new(&cg1, 3);
    ct1.calls = 0;
    var d64: f64 = bnm.sample(&ct1);
    assert(ct1.calls == 64 && d64 >= 0.0 && d64 <= 64.0, "64 trials: 64 uniforms, one a trial");
    PmnSimpleRng_new(&cg1, 3);
    PmnSimpleRng_new(&h, 3);
    var dsim = 0;
    for (var di = 0; di < 64; di = di + 1) {
        var du: f64 = h.next_f64();
        if (du < 0.5) { dsim = dsim + 1; }
    }
    var d64b: f64 = bnm.sample(&cg1);
    assert(d64b == f64_from(dsim), "the direct draw counts the uniforms below p, bit for bit");
    assert_eq(PmnBinomial_new(&bnm, 65, 0.5), PMN_ERR_NONE, "Binomial(65, 0.5): one Beta split first");
    PmnSimpleRng_new(&cg1, 3);
    ct1.calls = 0;
    var d65: f64 = bnm.sample(&ct1);
    assert(ct1.calls >= 38 && ct1.calls < 65 && d65 >= 0.0 && d65 <= 65.0,
      "65 trials: one split (two gamma variates, 3 uniforms each at least), then 32 trials: fewer than 65 uniforms");

    assert_eq(PmnBinomial_new(&bnm, 10, 0.0), PMN_ERR_NONE, "Binomial(10, 0)");
    e8.k = 0;
    var tz0: f64 = bnm.sample(&e8);
    assert(tz0 == 0.0, "a trial succeeds on u < p: a u of 0 is no success at p = 0");
    assert_eq(PmnBinomial_new(&bnm, 8, 0.5), PMN_ERR_NONE, "Binomial(8, 0.5)");
    e8.k = 0;
    var tz8: f64 = bnm.sample(&e8);
    assert(tz8 == 4.0, "the eighths 0 … 7/8: four below ½, the one at ½ no success");
    assert_eq(PmnBinomial_new(&bnm, 65, 0.5), PMN_ERR_NONE, "Binomial(65, 0.5)");
    var cy: Cycle3;
    cy.k = 0;
    var tsx: f64 = bnm.sample(&cy);
    assert(tsx == 32.0, "a split at x = p exactly keeps the a − 1 = 32 trials below, now at p/x = 1: 32 successes");

    test_group("the pmf's and cdf's edges");
    assert_eq(PmnBinomial_new(&bnm, 20, 0.3), PMN_ERR_NONE, "Binomial(20, 0.3)");
    var e0b: f64 = bnm.pdf(mz);
    var e0w: f64 = _pmn_ln_1p(-0.3);
    e0w = 20.0 * e0w;
    e0w = _pmn_exp(e0w);
    var enb: f64 = bnm.pdf(20.0);
    var enw: f64 = _pmn_ln(0.3);
    enw = 20.0 * enw;
    enw = _pmn_exp(enw);
    assert(bits(e0b) == bits(e0w) && bits(enb) == bits(enw),
      "(1 − p)^n at 0 (−0.0 included) and p^n at n, bit for bit");
    var ef1: f64 = bnm.pdf(2.5);
    var ef2: f64 = bnm.pdf(21.0);
    var ef3: f64 = bnm.pdf(inf);
    var ef4: f64 = bnm.pdf(nneg);
    assert(ef1 == 0.0 && ef2 == 0.0 && ef3 == 0.0 && bits(ef4) == 0x7FF8000000000000, "0 off the support, NaN at NaN");
    var ec1: f64 = bnm.cdf(-0.5);
    var ec2: f64 = bnm.cdf(7.9);
    var ec3: f64 = bnm.cdf(7.0);
    var ec4: f64 = bnm.cdf(20.0);
    var ec5: f64 = bnm.cdf(nneg);
    assert(ec1 == 0.0 && bits(ec2) == bits(ec3) && ec4 == 1.0 && bits(ec5) == 0x7FF8000000000000,
      "cdf 0 below 0, constant between the integers, 1 at n, NaN at NaN");
    var bc_ok = 1;
    for (var bcc = 0; bcc < 20; bcc = bcc + 1) {
        var bcf: f64 = f64_from(bcc);
        var bcv: f64 = bnm.cdf(bcf);
        var bna: f64 = 20.0 - bcf;
        var bkb: f64 = bcf + 1.0;
        var bii, bic = _pmn_beta_inc(bna, bkb, 0.7, 0.3);
        if (bits(bcv) != bits(bii)) { bc_ok = 0; }
    }
    assert_eq(bc_ok, 1, "the cdf is beta_inc(n − k, k + 1, 1 − p, p)'s first value, bit for bit");

    test_group("JSON and Debug (serde_roundtrip_binomial, deserialize_rejects; D5, D12)");
    assert_eq(PmnBinomial_new(&bnm, 20, 0.4), PMN_ERR_NONE, "Binomial(20, 0.4)");
    store64(sb + 8, 0);
    assert_eq(bnm.to_json(sb), PMN_ERR_NONE, "written");
    assert(text_is(sb, "{\"n\":20,\"p\":0.4}") == 1, "as serde_json writes it, n an integer");
    var rbi: PmnBinomial;
    assert_eq(PmnBinomial_from_json(&rbi, load64(sb), load64(sb + 8)), PMN_ERR_NONE, "read back");
    var rbp: f64 = rbi.p;
    assert(rbi.n == 20 && rbp == 0.4, "the same n and p");
    var jb0 = "{\"n\":0,\"p\":0.5}";
    var jb1 = "{\"n\":5,\"p\":1.5}";
    var jb2 = "{\"n\":5.0,\"p\":0.5}";
    var jb3 = "{\"n\":18446744073709551615,\"p\":0.5}";
    assert_eq(PmnBinomial_from_json(&rbi, jb0, strlen(jb0)), PMN_ERR_DESERIALIZE, "n = 0");
    assert_eq(PmnBinomial_from_json(&rbi, jb1, strlen(jb1)), PMN_ERR_DESERIALIZE, "p = 1.5");
    assert_eq(PmnBinomial_from_json(&rbi, jb2, strlen(jb2)), PMN_ERR_DESERIALIZE, "n written as a float");
    assert_eq(PmnBinomial_from_json(&rbi, jb3, strlen(jb3)), PMN_ERR_NONE, "n = u64::MAX");
    assert(rbi.n == 0 - 1, "read as its word");
    store64(sb + 8, 0);
    assert_eq(rbi.to_json(sb), PMN_ERR_NONE, "written");
    assert(text_is(sb, "{\"n\":18446744073709551615,\"p\":0.5}") == 1, "and written back as unsigned");
    store64(sb + 8, 0);
    assert_eq(bnm.debug(sb, 0), PMN_ERR_NONE, "Binomial {:?}");
    assert(text_is(sb, "Binomial { n: 20, p: 0.4 }") == 1, "Binomial { n: 20, p: 0.4 }");
    store64(sb + 8, 0);
    assert_eq(bnm.debug(sb, 1), PMN_ERR_NONE, "Binomial {:#?}");
    assert(text_is(sb, "Binomial {\n    n: 20,\n    p: 0.4,\n}") == 1, "one field a line");

    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
