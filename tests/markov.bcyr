# markov.bcyr — src/markov.cyr (M6 part a): ns per call, on 1.3.0's own criterion bodies
# (rust-old/benches/benchmarks.rs), whose numbers are rust-old/benchmarks.md's (2026-11-14, this host; ADR 010):
# - `markov/step_1000`: a new 3-state chain and SimpleRng::new(42), then 1,000 steps (1,999.4 ns in Rust);
# - `markov/hmm_forward_1000`: the 3-state, 4-symbol example model's log-likelihood of (7i + i/3) mod 4, i < 1000
#   (44,986.0 ns);
# - `markov/hmm_baum_welch_200_x5`: five Baum–Welch rounds on the first 200 of those symbols (152,110.0 ns);
# - `markov/steady_state_10`: the 10-state chain with rows 1 + (3i + 5j) mod 7, normalized (619.2 ns).
# Each row prints a result. The record is docs/benchmarks-rust-v-cyrius.md.

include "tests/lib.cyr"

# Stores x as entry k of the f64 buffer buf.
fn put(buf, k, x: f64): i64 {
    store64(buf + k * 8, x);
    return 0;
}

# Prints a row's result's bit pattern in hex, so a run can be checked against the model.
fn show(name, r: f64): i64 {
    var x: f64 = r;
    print("  ", 2);
    print(name, strlen(name));
    print(": ", 2);
    fmt_hex(load64(&x));
    println("");
    return 0;
}

# Runs the bench rows below, printing each one's timing and the result a run can be checked by.
fn main(): i64 {
    alloc_init();
    var m = alloc(9 * 8);
    var w = "721343235";
    for (var k = 0; k < 9; k = k + 1) {
        var d: f64 = f64_from(load8(w + k) - 48);
        var p: f64 = d / 10.0;
        put(m, k, p);
    }
    var c: PmnMarkovChain;
    var g: PmnSimpleRng;
    var last = 0;
    var b1 = bench_new("step_1000");
    bench_batch_start(b1);
    for (var r = 0; r < 20000; r = r + 1) {
        if (PmnMarkovChain_new(&c, m, 3, 3, 0) != PMN_ERR_NONE) { return 1; }
        PmnSimpleRng_new(&g, 42);
        for (var s = 0; s < 1000; s = s + 1) { last = c.step(&g); }
        PmnMarkovChain_drop(&c);
    }
    bench_batch_stop(b1, 20000);
    show("last state", f64_from(last));
    bench_report(b1);

    var a = alloc(9 * 8);
    var ta = "721352235";
    for (var k2 = 0; k2 < 9; k2 = k2 + 1) {
        var d2: f64 = f64_from(load8(ta + k2) - 48);
        var p2: f64 = d2 / 10.0;
        put(a, k2, p2);
    }
    var e = alloc(12 * 8);
    var te = "531114412125";
    for (var k3 = 0; k3 < 12; k3 = k3 + 1) {
        var d3: f64 = f64_from(load8(te + k3) - 48);
        var p3: f64 = d3 / 10.0;
        put(e, k3, p3);
    }
    var ip = alloc(3 * 8);
    put(ip, 0, 0.5);
    put(ip, 1, 0.3);
    put(ip, 2, 0.2);
    var h: PmnHiddenMarkovModel;
    if (PmnHiddenMarkovModel_new(&h, a, 3, 3, e, 3, 4, ip, 3) != PMN_ERR_NONE) { return 1; }
    var obs = alloc(1000 * 8);
    for (var i = 0; i < 1000; i = i + 1) { store64(obs + i * 8, (i * 7 + i / 3) % 4); }
    var ll: f64 = 0.0;
    var b2 = bench_new("hmm_forward_1000");
    bench_batch_start(b2);
    for (var r2 = 0; r2 < 2000; r2 = r2 + 1) {
        var t, v = h.forward_log_likelihood(obs, 1000);
        if (t == Err) { return 1; }
        ll = v;
    }
    bench_batch_stop(b2, 2000);
    show("ln P", ll);
    bench_report(b2);

    var h2: PmnHiddenMarkovModel;
    var b3 = bench_new("hmm_baum_welch_200_x5");
    bench_batch_start(b3);
    for (var r3 = 0; r3 < 500; r3 = r3 + 1) {
        if (h.baum_welch(obs, 200, 5, &h2) != PMN_ERR_NONE) { return 1; }
        PmnHiddenMarkovModel_drop(&h2);
    }
    bench_batch_stop(b3, 500);
    if (h.baum_welch(obs, 200, 5, &h2) != PMN_ERR_NONE) { return 1; }
    var a00: f64 = load64(h2.transition());
    show("A[0][0]", a00);
    PmnHiddenMarkovModel_drop(&h2);
    bench_report(b3);

    var s10 = alloc(100 * 8);
    for (var i4 = 0; i4 < 10; i4 = i4 + 1) {
        var tot: f64 = 0.0;
        for (var j4 = 0; j4 < 10; j4 = j4 + 1) {
            var x: f64 = f64_from(1 + (i4 * 3 + j4 * 5) % 7);
            put(s10, i4 * 10 + j4, x);
            tot = tot + x;
        }
        for (var j5 = 0; j5 < 10; j5 = j5 + 1) {
            var y: f64 = load64(s10 + (i4 * 10 + j5) * 8);
            var z: f64 = y / tot;
            put(s10, i4 * 10 + j5, z);
        }
    }
    if (PmnMarkovChain_new(&c, s10, 10, 10, 0) != PMN_ERR_NONE) { return 1; }
    var pi = alloc(10 * 8);
    var b4 = bench_new("steady_state_10");
    bench_batch_start(b4);
    for (var r4 = 0; r4 < 50000; r4 = r4 + 1) {
        if (c.steady_state(pi, 10) != PMN_ERR_NONE) { return 1; }
    }
    bench_batch_stop(b4, 50000);
    var p0: f64 = load64(pi);
    show("π₀", p0);
    bench_report(b4);
    PmnMarkovChain_drop(&c);
    PmnHiddenMarkovModel_drop(&h);
    return 0;
}

var rc = main();
sys_exit_group(rc);
