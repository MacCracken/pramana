# special.bcyr — the special functions of src/special.cyr (M2): ns per call.
#
# 4,096 seeded arguments per row, cycled 250 times (1,024,000 calls), one row per fdlibm branch and the two normal
# tails. The Rust twin is scripts/probes/rust/src/bin/m2_special.rs: the same xorshift, regions and loop, 1.3.0's
# functions through the oracle hooks (glibc's exp). Each side prints the row's sum as bits: the sums differ only
# where a row hits one of the arguments whose glibc exp misrounds. The record is docs/benchmarks-rust-v-cyrius.md.

include "tests/lib.cyr"

var g_rng = 0x2545F4914F6CDD1D;
var g_xs = 0;

fn next(): i64 {
    var x = g_rng;
    x = x ^ (x >> 12);
    x = x ^ (x << 25);
    x = x ^ (x >> 27);
    g_rng = x;
    return x * 0x2545F4914F6CDD1D;
}

fn unit(): f64 {
    var top = next() >> 11;
    var a: f64 = f64_from(top);
    var d: f64 = 9007199254740992.0;
    return a / d;
}

# `which`: 0 erf, 1 erfc, 2 normal_cdf, 3 normal_sf, 4 the loop alone (x → x), on 4,096 uniform arguments in
# [lo, hi).
fn row(name: cstring, which, lo: f64, hi: f64): i64 {
    for (var j = 0; j < 4096; j = j + 1) {
        var w: f64 = hi - lo;
        var u: f64 = unit();
        var x0: f64 = lo + w * u;
        store64(g_xs + j * 8, x0);
    }
    var s: f64 = 0.0;
    var b = bench_new(name);
    bench_batch_start(b);
    for (var k = 0; k < 250; k = k + 1) {
        for (var i = 0; i < 4096; i = i + 1) {
            var x: f64 = load64(g_xs + i * 8);
            var r: f64 = 0.0;
            if (which == 0) { r = _pmn_erf(x); }
            if (which == 1) { r = _pmn_erfc(x); }
            if (which == 2) { r = _pmn_normal_cdf(x); }
            if (which == 3) { r = _pmn_normal_sf(x); }
            if (which == 4) { r = x; }
            s = s + r;
        }
    }
    bench_batch_stop(b, 1024000);
    var sb: f64 = s;
    print("  ", 2);
    print(name, strlen(name));
    print(", the sum: ", 11);
    fmt_hex(load64(&sb));
    println("");
    bench_report(b);
    return 0;
}

fn main(): i64 {
    alloc_init();
    g_xs = alloc(4096 * 8);
    row("the loop alone, x -> x", 4, -0.84375, 0.84375);
    row("erf, |x| < 0.84375", 0, -0.84375, 0.84375);
    row("erf, 0.84375 <= x < 1.25", 0, 0.84375, 1.25);
    row("erf, 1.25 <= x < 6", 0, 1.25, 6.0);
    row("erfc, 0.25 <= x < 0.84375", 1, 0.25, 0.84375);
    row("erfc, 1.25 <= x < 2.857", 1, 1.25, 2.857);
    row("erfc, 2.857 <= x < 27", 1, 2.857, 27.0);
    row("normal_cdf, z in [-10, 10)", 2, -10.0, 10.0);
    row("normal_cdf, z in [-38, -1.2)", 2, -38.0, -1.2);
    row("normal_sf, z in [0, 38)", 3, 0.0, 38.0);
    return 0;
}

var rc = main();
sys_exit_group(rc);
