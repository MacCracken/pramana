# special.bcyr — the special functions of src/special.cyr (M2): ns per call.
#
# 4,096 seeded arguments (or pairs) per row, cycled 250 times (1,024,000 calls): one row per branch of 1.3.0's fdlibm
# erf and erfc and the two normal tails (part a1), per branch of lnΓ and its relatives (part a2), and the incomplete
# functions (parts a3, a4). The Rust twin is `m2_special.rs`: the same xorshift, regions and loop, 1.3.0's functions
# through the oracle hooks (glibc's primitives). Each side prints the row's sum and, from part b1, an FNV-1a digest of
# its 4,096 results' bits: the sum can't see a 1-ulp change in one value, the digest can. They differ where a row hits
# an argument on which a glibc primitive misrounds, and wherever a T1 function (erf and erfc are CORE-MATH's,
# correctly rounded, from part b1) or Rust's formula on one moves the value. The record is
# docs/benchmarks-rust-v-cyrius.md, which keeps the twin's numbers: the Rust twins went with the Rust tooling (ADR
# 010).

include "tests/lib.cyr"

var g_rng = 0x2545F4914F6CDD1D;
var g_xs = 0;
var g_ys = 0;

fn next(): i64 {
    var x = g_rng;
    x = x ^ (x >> 12);
    x = x ^ (x << 25);
    x = x ^ (x >> 27);
    g_rng = x;
    return x * 0x2545F4914F6CDD1D;
}

fn unit(): f64 {
    var top = next() >> 11;
    var a: f64 = f64_from(top);
    var d: f64 = 9007199254740992.0;
    return a / d;
}

# One row's function at (x, y), as the timed loop below computes it; for the digest pass, outside the timing.
fn eval(which, x: f64, y: f64): f64 {
    var r: f64 = 0.0;
    if (which == 0) { r = _pmn_erf(x); }
    if (which == 1) { r = _pmn_erfc(x); }
    if (which == 2) { r = _pmn_normal_cdf(x); }
    if (which == 3) { r = _pmn_normal_sf(x); }
    if (which == 4) { r = x; }
    if (which == 5) { r = _pmn_ln_gamma(x); }
    if (which == 6) { r = _pmn_stirling_error(x); }
    if (which == 7) { r = _pmn_bd0(x, y); }
    if (which == 8) { r = _pmn_ln_gamma_kernel(x, y); }
    if (which == 9) { r = _pmn_ln_beta(x, y); }
    if (which == 10) {
        var gp, gq = _pmn_gamma_inc(x, y);
        r = gp - gq;
    }
    if (which == 11) {
        var sxy: f64 = x + y;
        var mx: f64 = x / sxy;
        var my: f64 = y / sxy;
        var bp, bq = _pmn_beta_inc(x, y, mx, my);
        r = bp - bq;
    }
    return r;
}

# `which`: 0 erf, 1 erfc, 2 normal_cdf, 3 normal_sf, 4 the loop alone (x → x), 5 ln_gamma, 6 stirling_error, 7 bd0,
# 8 ln_gamma_kernel, 9 ln_beta, 10 gamma_inc (P − Q, so both outputs reach the sum), 11 beta_inc on shapes x and y at
# the mean x/(x + y), its complement y/(x + y) passed as y (I − (1 − I)), on 4,096 uniform x in [lo, hi) and y in
# [lo2, hi2) (y unused by the one-argument functions), drawn alternately.
fn row(name: cstring, which, lo: f64, hi: f64, lo2: f64, hi2: f64): i64 {
    for (var j = 0; j < 4096; j = j + 1) {
        var w: f64 = hi - lo;
        var u: f64 = unit();
        var x0: f64 = lo + w * u;
        store64(g_xs + j * 8, x0);
        var w2: f64 = hi2 - lo2;
        var u2: f64 = unit();
        var y0: f64 = lo2 + w2 * u2;
        store64(g_ys + j * 8, y0);
    }
    var s: f64 = 0.0;
    var b = bench_new(name);
    bench_batch_start(b);
    for (var k = 0; k < 250; k = k + 1) {
        for (var i = 0; i < 4096; i = i + 1) {
            var x: f64 = load64(g_xs + i * 8);
            var y: f64 = load64(g_ys + i * 8);
            var r: f64 = 0.0;
            if (which == 0) { r = _pmn_erf(x); }
            if (which == 1) { r = _pmn_erfc(x); }
            if (which == 2) { r = _pmn_normal_cdf(x); }
            if (which == 3) { r = _pmn_normal_sf(x); }
            if (which == 4) { r = x; }
            if (which == 5) { r = _pmn_ln_gamma(x); }
            if (which == 6) { r = _pmn_stirling_error(x); }
            if (which == 7) { r = _pmn_bd0(x, y); }
            if (which == 8) { r = _pmn_ln_gamma_kernel(x, y); }
            if (which == 9) { r = _pmn_ln_beta(x, y); }
            if (which == 10) {
                var gp, gq = _pmn_gamma_inc(x, y);
                r = gp - gq;
            }
            if (which == 11) {
                var sxy: f64 = x + y;
                var mx: f64 = x / sxy;
                var my: f64 = y / sxy;
                var bp, bq = _pmn_beta_inc(x, y, mx, my);
                r = bp - bq;
            }
            s = s + r;
        }
    }
    bench_batch_stop(b, 1024000);
    var sb: f64 = s;
    print("  ", 2);
    print(name, strlen(name));
    print(", the sum: ", 11);
    fmt_hex(load64(&sb));
    println("");
    # The digest: FNV-1a over the 4,096 results' bit patterns, word by word, untimed. A sum of 10^6 values absorbs a
    # 1-ulp change in one of them; the digest does not, so equal digests mean equal values.
    var dg = 0xCBF29CE484222325;
    for (var t = 0; t < 4096; t = t + 1) {
        var xd: f64 = load64(g_xs + t * 8);
        var yd: f64 = load64(g_ys + t * 8);
        var rd: f64 = eval(which, xd, yd);
        dg = (dg ^ load64(&rd)) * 0x100000001B3;
    }
    print("  ", 2);
    print(name, strlen(name));
    print(", the digest: ", 14);
    fmt_hex(dg);
    println("");
    bench_report(b);
    return 0;
}

fn main(): i64 {
    alloc_init();
    g_xs = alloc(4096 * 8);
    g_ys = alloc(4096 * 8);
    row("the loop alone, x -> x", 4, -0.84375, 0.84375, 0.0, 1.0);
    row("erf, |x| < 0.84375", 0, -0.84375, 0.84375, 0.0, 1.0);
    row("erf, 0.84375 <= x < 1.25", 0, 0.84375, 1.25, 0.0, 1.0);
    row("erf, 1.25 <= x < 6", 0, 1.25, 6.0, 0.0, 1.0);
    row("erfc, 0.25 <= x < 0.84375", 1, 0.25, 0.84375, 0.0, 1.0);
    row("erfc, 1.25 <= x < 2.857", 1, 1.25, 2.857, 0.0, 1.0);
    row("erfc, 2.857 <= x < 27", 1, 2.857, 27.0, 0.0, 1.0);
    row("normal_cdf, z in [-10, 10)", 2, -10.0, 10.0, 0.0, 1.0);
    row("normal_cdf, z in [-38, -1.2)", 2, -38.0, -1.2, 0.0, 1.0);
    row("normal_sf, z in [0, 38)", 3, 0.0, 38.0, 0.0, 1.0);
    row("ln_gamma, x in [0.5, 10)", 5, 0.5, 10.0, 0.0, 1.0);
    row("ln_gamma, x in [-10, 0.5), reflected", 5, -10.0, 0.5, 0.0, 1.0);
    row("ln_gamma, x in [10, 1000)", 5, 10.0, 1000.0, 0.0, 1.0);
    row("stirling_error, a in [0.5, 10)", 6, 0.5, 10.0, 0.0, 1.0);
    row("stirling_error, a in [10, 1000), the series", 6, 10.0, 1000.0, 0.0, 1.0);
    row("bd0, x in [0, 100), m in [1, 100)", 7, 0.0, 100.0, 1.0, 100.0);
    row("ln_gamma_kernel, a in [1, 10), x in [0.1, 20)", 8, 1.0, 10.0, 0.1, 20.0);
    row("ln_gamma_kernel, a in [10, 1000), x in [5, 1500)", 8, 10.0, 1000.0, 5.0, 1500.0);
    row("ln_beta, a and b in [0.5, 10)", 9, 0.5, 10.0, 0.5, 10.0);
    row("ln_beta, a in [0.5, 10), b in [10, 1000)", 9, 0.5, 10.0, 10.0, 1000.0);
    row("ln_beta, a and b in [10, 1000)", 9, 10.0, 1000.0, 10.0, 1000.0);
    row("gamma_inc, a in [0.5, 10), x in [0.1, 20)", 10, 0.5, 10.0, 0.1, 20.0);
    row("gamma_inc, a in [10, 1000), x in [5, 1500)", 10, 10.0, 1000.0, 5.0, 1500.0);
    row("gamma_inc, Wilson-Hilferty, a and x in [1e9, 1.0001e9)", 10, 1000000000.0, 1000100000.0, 1000000000.0,
        1000100000.0);
    row("beta_inc, a and b in [0.5, 10), x at the mean", 11, 0.5, 10.0, 0.5, 10.0);
    row("beta_inc, a and b in [10, 1000), x at the mean", 11, 10.0, 1000.0, 10.0, 1000.0);
    return 0;
}

var rc = main();
sys_exit_group(rc);
