        var dch: PmnChiSquared;
        var ddf: f64 = _par_in(0);
        if (PmnChiSquared_new(&dch, ddf) != PMN_ERR_NONE) { return 0 - 1; }
        e = dch.debug(sb, alt);
    } elif (_par_eq(fp, fl, "debug::Exponential") == 1) {
        var de: PmnExponential;
        var dl: f64 = _par_in(0);
        if (PmnExponential_new(&de, dl) != PMN_ERR_NONE) { return 0 - 1; }
        e = de.debug(sb, alt);
    } elif (_par_eq(fp, fl, "debug::Bernoulli") == 1) {
        var db: PmnBernoulli;
        var dp: f64 = _par_in(0);
        if (PmnBernoulli_new(&db, dp) != PMN_ERR_NONE) { return 0 - 1; }
        e = db.debug(sb, alt);
    } elif (_par_eq(fp, fl, "debug::SimpleRng") == 1) {
        var g: PmnSimpleRng;
        if (PmnSimpleRng_new(&g, _par_in(0)) != PMN_ERR_NONE) { return 0 - 1; }
        e = g.debug(sb, alt);
    } elif (_par_eq(fp, fl, "debug::PramanaError") == 1) {
        var en[40];
        store64(&en, "InvalidParameter");
        store64(&en + 8, "InvalidSample");
        store64(&en + 16, "ConvergenceFailure");
        store64(&en + 24, "DimensionMismatch");
        store64(&en + 32, "ComputationError");
        _par_json_k = 0;
        var v = _par_jw_variant(&en, 5);
        if (v < 0) { return 0 - 1; }
        e = pmn_err_debug(PMN_ERR_INVALID_PARAMETER + v, sb, alt);
    } else {
        return 0;
    }
    if (e != PMN_ERR_NONE) { return 0 - 1; }
    _par_got_text(load64(sb), load64(sb + 8));
    return 1;
}

# `bridge` rows (M1 part e3): src/bridge.cyr. A slice is `v:n` and its values, read into a buffer; a slice of pairs
# is `v:n` then each pair's integer and f64, read into 16-byte records; a tuple's elements come back in order.
var _par_br_a = 0;
var _par_br_b = 0;
var _PAR_BR_CAP = 4096;

# The `v:n` slice at token k into buf (n words, or n records when `pairs`): n, with the next token index at *next.
fn _par_br_read(k, buf, pairs, next): i64 {
    if (k >= _par_in_n || load64(_par_in_k + k * 8) != 118) { return 0 - 1; }
    var n = _par_in(k);
    var per = 1;
    if (pairs == 1) { per = 2; }
    if (n < 0 || n > _PAR_BR_CAP || k + 1 + n * per > _par_in_n) { return 0 - 1; }
    for (var i = 0; i < n * per; i = i + 1) { store64(buf + i * 8, _par_in(k + 1 + i)); }
    store64(next, k + 1 + n * per);
    return n;
}

fn _par_bridge(fp, fl): i64 {
    if (_par_br_a == 0) {
        _par_br_a = alloc(_PAR_BR_CAP * 16);
        _par_br_b = alloc(_PAR_BR_CAP * 16);
    }
    var out[40];
    var x: f64 = _par_in(0);
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "bridge::ensemble_spread_to_confidence") == 1) {
        var r0: f64 = pmn_ensemble_spread_to_confidence(x, y);
        _par_got_f(r0);
        return 1;
    }
    if (_par_eq(fp, fl, "bridge::observation_error_to_likelihood") == 1) {
        var r1: f64 = pmn_observation_error_to_likelihood(x, y);
        _par_got_f(r1);
        return 1;
    }
    if (_par_eq(fp, fl, "bridge::sensor_noise_to_std_dev") == 1) {
        var r2: f64 = pmn_sensor_noise_to_std_dev(x, y);
        _par_got_f(r2);
        return 1;
    }
    if (_par_eq(fp, fl, "bridge::z_rates_to_d_prime") == 1) {
        var r3: f64 = pmn_z_rates_to_d_prime(x, y);
        _par_got_f(r3);
        return 1;
    }
    if (_par_eq(fp, fl, "bridge::uncertainty_to_gaussian") == 1) {
        if (pmn_uncertainty_to_gaussian(x, y, &out) != PMN_ERR_NONE) { return 0 - 1; }
        _par_got_f(load64(&out));
        _par_got_f(load64(&out + 8));
        return 1;
    }
    if (_par_eq(fp, fl, "bridge::item_variances_to_alpha") == 1) {
        var s: f64 = _par_in(1);
        var t: f64 = _par_in(2);
        var r4: f64 = pmn_item_variances_to_alpha(_par_in(0), s, t);
        _par_got_f(r4);
        return 1;
    }
    if (_par_eq(fp, fl, "bridge::replicates_to_t_statistic") == 1) {
        if (_par_in_n != 6) { return 0 - 1; }
        var sa: f64 = _par_in(1);
        var mb: f64 = _par_in(3);
        var sb: f64 = _par_in(4);
        var r5: f64 = pmn_replicates_to_t_statistic(x, sa, _par_in(2), mb, sb, _par_in(5));
        _par_got_f(r5);
        return 1;
    }
    var next = 0;
    if (_par_eq(fp, fl, "bridge::yields_to_mean_variance") == 1) {
        var n = _par_br_read(0, _par_br_a, 0, &next);
        if (n < 0 || pmn_yields_to_mean_variance(_par_br_a, n, &out) != PMN_ERR_NONE) { return 0 - 1; }
        _par_got_f(load64(&out));
        _par_got_f(load64(&out + 8));
        return 1;
    }
    if (_par_eq(fp, fl, "bridge::trait_scores_to_correlation") == 1) {
        var na = _par_br_read(0, _par_br_a, 0, &next);
        if (na < 0) { return 0 - 1; }
        var nb = _par_br_read(next, _par_br_b, 0, &next);
        if (nb < 0 || pmn_trait_scores_to_correlation(_par_br_a, na, _par_br_b, nb, &out) != PMN_ERR_NONE) {
            return 0 - 1;
        }
        for (var k = 0; k < 5; k = k + 1) { _par_got_f(load64(&out + k * 8)); }
        return 1;
    }
    var e = 0 - 1;
    var nr = _par_br_read(0, _par_br_a, 1, &next);
    if (nr < 0) { return 0 - 1; }
    if (_par_eq(fp, fl, "bridge::learning_trials_to_power_law") == 1) {
        e = pmn_learning_trials_to_power_law(_par_br_a, nr, &out);
    } elif (_par_eq(fp, fl, "bridge::response_times_to_hick_params") == 1) {
        e = pmn_response_times_to_hick_params(_par_br_a, nr, &out);
    } else {
        return 0;
    }
    if (e != PMN_ERR_NONE) { return 0 - 1; }
    _par_got_f(load64(&out));
    _par_got_f(load64(&out + 8));
    return 1;
}

# `combinatorics` rows (M1 part e2): src/combinatorics.cyr. A u128 is two tokens, its low word then its high word.
fn _par_combinatorics(fp, fl): i64 {
    var x: PmnU128;
    var e = 0 - 1;
    if (_par_eq(fp, fl, "combinatorics::stirling_approx") == 1) {
        if (_par_in_n != 1) { return 0 - 1; }
        var s: f64 = pmn_stirling_approx(_par_in(0));
        _par_got_f(s);
        return 1;
    }
    if (_par_eq(fp, fl, "combinatorics::factorial") == 1) {
        if (_par_in_n != 1) { return 0 - 1; }
        e = pmn_factorial(_par_in(0), &x);
    } elif (_par_in_n == 2 && _par_eq(fp, fl, "combinatorics::permutations") == 1) {
        e = pmn_permutations(_par_in(0), _par_in(1), &x);
    } elif (_par_in_n == 2 && _par_eq(fp, fl, "combinatorics::combinations") == 1) {
        e = pmn_combinations(_par_in(0), _par_in(1), &x);
    } else {
        return 0;
    }
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    _par_got_i(x.lo);
    _par_got_i(x.hi);
    return 1;
}

# `f64::*` and `u64::*` rows: the Rust std reference values (port plan §8.1), every one through src/mathx.cyr, the
# names the rest of the port calls (M1 part c):
# - the exact builtins sqrt, abs and floor;
# - the fdlibm word operations, which the port writes inline: `bits >> 32` (logical) and `bits & 0xFFFFFFFF00000000`;
# - the Rust-semantics helpers (ledger L2): min, max and clamp ignore a NaN as Rust does, fract is x − trunc(x),
#   is_nan, is_finite and total_cmp, `as usize` saturates, `u64 as f64` is unsigned, and powi is LLVM's
#   square-and-multiply;
# - the transcendentals, correctly rounded at 0 ulp (ADR 009): kimiya's exp, ln, exp_m1, powf, sin, cos and atan
#   (src/crmath.cyr, part b1), pramana's own ln_1p, tan and log2 (src/crmath_ext.cyr, parts b2–b4), ganita's cbrt.
fn _par_math(fp, fl): i64 {
    var w = _par_in(0);
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "f64::sqrt") == 1) { var r: f64 = f64_sqrt(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::abs") == 1) { var r: f64 = f64_abs(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::floor") == 1) { var r: f64 = f64_floor(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::high_word") == 1) { _par_got_i(w >> 32); return 1; }
    if (_par_eq(fp, fl, "f64::low_masked") == 1) { _par_got_f(w & 0xFFFFFFFF00000000); return 1; }
    if (_par_eq(fp, fl, "f64::fract") == 1) { var r: f64 = _pmn_fract(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::is_nan") == 1) { _par_got_i(_pmn_is_nan(x)); return 1; }
    if (_par_eq(fp, fl, "f64::is_finite") == 1) { _par_got_i(_pmn_is_finite(x)); return 1; }
    if (_par_eq(fp, fl, "f64::as_usize") == 1) { _par_got_i(_pmn_sat_usize(x)); return 1; }
    if (_par_eq(fp, fl, "u64::as_f64") == 1) { var r: f64 = _pmn_u64_to_f64(w); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::powi2") == 1) { var r: f64 = _pmn_powi(x, 2); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::powi3") == 1) { var r: f64 = _pmn_powi(x, 3); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::powi4") == 1) { var r: f64 = _pmn_powi(x, 4); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::powi9") == 1) { var r: f64 = _pmn_powi(x, 9); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::powi25") == 1) { var r: f64 = _pmn_powi(x, 25); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::powi49") == 1) { var r: f64 = _pmn_powi(x, 49); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::exp") == 1) { var r: f64 = _pmn_exp(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::ln") == 1) { var r: f64 = _pmn_ln(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::ln_1p") == 1) { var r: f64 = _pmn_ln_1p(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::exp_m1") == 1) { var r: f64 = _pmn_exp_m1(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::sin") == 1) { var r: f64 = _pmn_sin(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::cos") == 1) { var r: f64 = _pmn_cos(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::tan") == 1) { var r: f64 = _pmn_tan(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::atan") == 1) { var r: f64 = _pmn_atan(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::log2") == 1) { var r: f64 = _pmn_log2(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::cbrt") == 1) { var r: f64 = _pmn_cbrt(x); _par_got_f(r); return 1; }
    if (_par_in_n < 2) { return 0; }
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "f64::powf") == 1) { var r: f64 = _pmn_powf(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::max") == 1) { var r: f64 = _pmn_max(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::min") == 1) { var r: f64 = _pmn_min(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::total_cmp") == 1) { _par_got_i(_pmn_total_cmp(x, y)); return 1; }
    if (_par_in_n < 3) { return 0; }
    var z: f64 = _par_in(2);
    if (_par_eq(fp, fl, "f64::clamp") == 1) { var r: f64 = _pmn_clamp(x, y, z); _par_got_f(r); return 1; }
    return 0;
}

# `special` rows (M2): src/special.cyr, 1.3.0's math.rs in Rust's operation order on the correctly rounded primitives
# (T0), so every row matches special.cr.tsv's model at 0 ulp. Part a1: fdlibm's erf and erfc, Φ and 1 − Φ. Part a2:
# lnΓ, the Stirling remainder, bd0, the prefactor kernel and ln B. Part a3: the regularized incomplete gamma, (P, Q)
# and each alone. Part a4: the regularized incomplete beta, (I, 1 − I) from (a, b, x, y), and I alone from (x, a, b).
# Part b on: the T1 functions' rows are compared with special.ref.tsv at ADR 009's bounds (`_par_c_bound`).
fn _par_special(fp, fl): i64 {
    var x: f64 = _par_in(0);
    if (_par_in_n == 1) {
        if (_par_eq(fp, fl, "math::erf") == 1) { var r0: f64 = _pmn_erf(x); _par_got_f(r0); return 1; }
        if (_par_eq(fp, fl, "math::erfc") == 1) { var r1: f64 = _pmn_erfc(x); _par_got_f(r1); return 1; }
        if (_par_eq(fp, fl, "math::normal_cdf") == 1) { var r2: f64 = _pmn_normal_cdf(x); _par_got_f(r2); return 1; }
        if (_par_eq(fp, fl, "math::normal_sf") == 1) { var r3: f64 = _pmn_normal_sf(x); _par_got_f(r3); return 1; }
        if (_par_eq(fp, fl, "math::ln_gamma") == 1) { var r4: f64 = _pmn_ln_gamma(x); _par_got_f(r4); return 1; }
        if (_par_eq(fp, fl, "math::stirling_error") == 1) {
            var r5: f64 = _pmn_stirling_error(x);
            _par_got_f(r5);
            return 1;
        }
        return 0;
    }
    var y: f64 = _par_in(1);
    if (_par_in_n == 3 && _par_eq(fp, fl, "math::regularized_incomplete_beta") == 1) {
        var z3: f64 = _par_in(2);
        var r11: f64 = _pmn_regularized_incomplete_beta(x, y, z3);
        _par_got_f(r11);
        return 1;
    }
    if (_par_in_n == 4 && _par_eq(fp, fl, "math::beta_inc") == 1) {
        var bx: f64 = _par_in(2);
        var by: f64 = _par_in(3);
        var bp, bq = _pmn_beta_inc(x, y, bx, by);
        _par_got_f(bp);
        _par_got_f(bq);
        return 1;
    }
    if (_par_in_n != 2) { return 0; }
    if (_par_eq(fp, fl, "math::bd0") == 1) { var r6: f64 = _pmn_bd0(x, y); _par_got_f(r6); return 1; }
    if (_par_eq(fp, fl, "math::ln_gamma_kernel") == 1) {
        var r7: f64 = _pmn_ln_gamma_kernel(x, y);
        _par_got_f(r7);
        return 1;
    }
    if (_par_eq(fp, fl, "math::ln_beta") == 1) { var r8: f64 = _pmn_ln_beta(x, y); _par_got_f(r8); return 1; }
    if (_par_eq(fp, fl, "math::gamma_inc") == 1) {
        var gp, gq = _pmn_gamma_inc(x, y);
        _par_got_f(gp);
        _par_got_f(gq);
        return 1;
    }
    if (_par_eq(fp, fl, "math::regularized_lower_incomplete_gamma") == 1) {
        var r9: f64 = _pmn_regularized_lower_incomplete_gamma(x, y);
        _par_got_f(r9);
        return 1;
    }
    if (_par_eq(fp, fl, "math::regularized_upper_incomplete_gamma") == 1) {
        var r10: f64 = _pmn_regularized_upper_incomplete_gamma(x, y);
        _par_got_f(r10);
        return 1;
    }
    return 0;
}

# `dist` rows (M3): src/dist.cyr, src/dist_cont.cyr and src/dist_disc.cyr, each distribution built by its constructor
# from the row's parameters. Part a1: Normal, and Box–Muller's `standard_normal` through a bounded generic; part a2:
# Uniform, Exponential and Bernoulli; part a3: Cauchy and Weibull; part b1: Gamma, ChiSquared and the oracle's
# `sample_gamma_standard`; part b2: Beta, StudentT, FDistribution and the oracle's Student-t and F tails; part c1:
# Poisson and the oracle's `sample_poisson_ptrs`; part c2: Binomial, whose n is an integer token.
fn _par_std_normal<R: PmnRng>(g: *R): f64 {
    var z: f64 = _pmn_standard_normal(g);
    return z;
}

fn _par_poisson_ptrs<R: PmnRng>(l: f64, g: *R): f64 {
    var z: f64 = _pmn_sample_poisson_ptrs(l, g);
    return z;
}

fn _par_gamma_standard<R: PmnRng>(a: f64, g: *R): f64 {
    var z: f64 = _pmn_sample_gamma_standard(a, g);
    return z;
}

# A trait method of a built distribution d, through the bound as a consumer's generic code calls it: the method's
# name at mp (the row's `X::method` past `X::`), x (pdf, cdf) or the seed and count (sample) from input xi on.
fn _par_dist_call<D: PmnDistribution>(d: *D, mp, ml, xi): i64 {
    if (_par_eq(mp, ml, "pdf") == 1) {
        var x0: f64 = _par_in(xi);
        var r0: f64 = d.pdf(x0);
        _par_got_f(r0);
        return 1;
    }
    if (_par_eq(mp, ml, "cdf") == 1) {
        var x1: f64 = _par_in(xi);
        var r1: f64 = d.cdf(x1);
        _par_got_f(r1);
        return 1;
    }
    if (_par_eq(mp, ml, "mean") == 1) {
        var r2: f64 = d.mean();
        _par_got_f(r2);
        return 1;
    }
    if (_par_eq(mp, ml, "variance") == 1) {
        var r3: f64 = d.variance();
        _par_got_f(r3);
        return 1;
    }
    if (_par_eq(mp, ml, "sample") == 1) {
        var g: PmnSimpleRng;
        if (PmnSimpleRng_new(&g, _par_in(xi)) != PMN_ERR_NONE) { return 0 - 1; }
        var n = _par_in(xi + 1);
        _par_got_seq(n);
        for (var j = 0; j < n; j = j + 1) {
            var r4: f64 = d.sample(&g);
            _par_got_f(r4);
        }
        return 1;
    }
    return 0;
}

# X::new rows: the constructor's error, or the fields it holds (np of them, at f).
fn _par_dist_new(e, f, np): i64 {
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    for (var k = 0; k < np; k = k + 1) {
        var v: f64 = load64(f + k * 8);
        _par_got_f(v);
    }
    return 1;
}

# The length of a `X::` prefix at fp naming one of the distributions (its name's length plus 2), or 0.
fn _par_dist_prefix(fp, fl, name): i64 {
    var n = strlen(name);
    if (fl <= n + 2 || memeq(fp, name, n) != 1 || memeq(fp + n, "::", 2) != 1) { return 0; }
    return n + 2;
}

fn _par_dist(fp, fl): i64 {
    if (_par_eq(fp, fl, "standard_normal") == 1) {
        if (_par_in_n != 2) { return 0 - 1; }
        var sg: PmnSimpleRng;
        if (PmnSimpleRng_new(&sg, _par_in(0)) != PMN_ERR_NONE) { return 0 - 1; }
        var sn = _par_in(1);
        _par_got_seq(sn);
        for (var k = 0; k < sn; k = k + 1) {
            var z: f64 = _par_std_normal(&sg);
            _par_got_f(z);
        }
        return 1;
    }
    if (_par_eq(fp, fl, "sample_gamma_standard") == 1) {
        if (_par_in_n != 3) { return 0 - 1; }
        var ga: f64 = _par_in(0);
        var gg: PmnSimpleRng;
        if (PmnSimpleRng_new(&gg, _par_in(1)) != PMN_ERR_NONE) { return 0 - 1; }
        var gn = _par_in(2);
        _par_got_seq(gn);
        for (var gk = 0; gk < gn; gk = gk + 1) {
            var gz: f64 = _par_gamma_standard(ga, &gg);
            _par_got_f(gz);
        }
        return 1;
    }
    if (_par_eq(fp, fl, "student_t_two_tailed") == 1 || _par_eq(fp, fl, "student_t_cdf") == 1) {
        if (_par_in_n != 2) { return 0 - 1; }
        var tt: f64 = _par_in(0);
        var tdf: f64 = _par_in(1);
        var tr: f64 = 0.0;
        if (fl == 20) {
            tr = _pmn_student_t_two_tailed(tt, tdf);
        } else {
            tr = _pmn_student_t_cdf(tt, tdf);
        }
        _par_got_f(tr);
        return 1;
    }
    if (_par_eq(fp, fl, "sample_poisson_ptrs") == 1) {
        if (_par_in_n != 3) { return 0 - 1; }
        var pl: f64 = _par_in(0);
        var pg: PmnSimpleRng;
        if (PmnSimpleRng_new(&pg, _par_in(1)) != PMN_ERR_NONE) { return 0 - 1; }
        var pn = _par_in(2);
        _par_got_seq(pn);
        for (var pk = 0; pk < pn; pk = pk + 1) {
            var pz: f64 = _par_poisson_ptrs(pl, &pg);
            _par_got_f(pz);
        }
        return 1;
    }
    if (_par_eq(fp, fl, "f_cdf_sf") == 1) {
        if (_par_in_n != 3) { return 0 - 1; }
        var fx: f64 = _par_in(0);
        var fh1: f64 = _par_in(1);
        var fh2: f64 = _par_in(2);
        var fc, fs = _pmn_f_cdf_sf(fx, fh1, fh2);
        _par_got_f(fc);
        _par_got_f(fs);
        return 1;
    }
    var px = _par_dist_prefix(fp, fl, "Normal");
    if (px > 0) {
        var m: f64 = _par_in(0);
        var s: f64 = _par_in(1);
        var dn: PmnNormal;
        var en = PmnNormal_new(&dn, m, s);
        if (_par_eq(fp + px, fl - px, "new") == 1) { return _par_dist_new(en, &dn, 2); }
        if (en != PMN_ERR_NONE) { return 0 - 1; }
        return _par_dist_call(&dn, fp + px, fl - px, 2);
    }
    px = _par_dist_prefix(fp, fl, "Uniform");
    if (px > 0) {
        var lo: f64 = _par_in(0);
        var hi: f64 = _par_in(1);
        var du: PmnUniform;
        var eu = PmnUniform_new(&du, lo, hi);
        if (_par_eq(fp + px, fl - px, "new") == 1) { return _par_dist_new(eu, &du, 2); }
        if (eu != PMN_ERR_NONE) { return 0 - 1; }
        return _par_dist_call(&du, fp + px, fl - px, 2);
    }
    px = _par_dist_prefix(fp, fl, "Exponential");
    if (px > 0) {
        var l: f64 = _par_in(0);
        var de: PmnExponential;
        var ee = PmnExponential_new(&de, l);
        if (_par_eq(fp + px, fl - px, "new") == 1) { return _par_dist_new(ee, &de, 1); }
        if (ee != PMN_ERR_NONE) { return 0 - 1; }
        return _par_dist_call(&de, fp + px, fl - px, 1);
    }
    px = _par_dist_prefix(fp, fl, "Cauchy");
    if (px > 0) {
        var x0: f64 = _par_in(0);
        var ga: f64 = _par_in(1);
        var dc: PmnCauchy;
        var ec = PmnCauchy_new(&dc, x0, ga);
        if (_par_eq(fp + px, fl - px, "new") == 1) { return _par_dist_new(ec, &dc, 2); }
        if (ec != PMN_ERR_NONE) { return 0 - 1; }
        return _par_dist_call(&dc, fp + px, fl - px, 2);
    }
    px = _par_dist_prefix(fp, fl, "Weibull");
    if (px > 0) {
        var wk: f64 = _par_in(0);
        var wl: f64 = _par_in(1);
        var dw: PmnWeibull;
        var ew = PmnWeibull_new(&dw, wk, wl);
        if (_par_eq(fp + px, fl - px, "new") == 1) { return _par_dist_new(ew, &dw, 2); }
        if (ew != PMN_ERR_NONE) { return 0 - 1; }
        return _par_dist_call(&dw, fp + px, fl - px, 2);
    }
    px = _par_dist_prefix(fp, fl, "Gamma");
    if (px > 0) {
        var gal: f64 = _par_in(0);
        var gbe: f64 = _par_in(1);
        var dg: PmnGamma;
        var eg = PmnGamma_new(&dg, gal, gbe);
        if (_par_eq(fp + px, fl - px, "new") == 1) { return _par_dist_new(eg, &dg, 2); }
        if (eg != PMN_ERR_NONE) { return 0 - 1; }
        return _par_dist_call(&dg, fp + px, fl - px, 2);
    }
    px = _par_dist_prefix(fp, fl, "ChiSquared");
    if (px > 0) {
        var cdf0: f64 = _par_in(0);
        var dch: PmnChiSquared;
        var ech = PmnChiSquared_new(&dch, cdf0);
        if (_par_eq(fp + px, fl - px, "new") == 1) { return _par_dist_new(ech, &dch, 1); }
        if (ech != PMN_ERR_NONE) { return 0 - 1; }
        return _par_dist_call(&dch, fp + px, fl - px, 1);
    }
    px = _par_dist_prefix(fp, fl, "Beta");
    if (px > 0) {
        var bal: f64 = _par_in(0);
        var bbe: f64 = _par_in(1);
        var dbt: PmnBeta;
        var ebt = PmnBeta_new(&dbt, bal, bbe);
        if (_par_eq(fp + px, fl - px, "new") == 1) { return _par_dist_new(ebt, &dbt, 2); }
        if (ebt != PMN_ERR_NONE) { return 0 - 1; }
        return _par_dist_call(&dbt, fp + px, fl - px, 2);
    }
    px = _par_dist_prefix(fp, fl, "StudentT");
    if (px > 0) {
        var sdf: f64 = _par_in(0);
        var dst: PmnStudentT;
        var est = PmnStudentT_new(&dst, sdf);
        if (_par_eq(fp + px, fl - px, "new") == 1) { return _par_dist_new(est, &dst, 1); }
        if (est != PMN_ERR_NONE) { return 0 - 1; }
        return _par_dist_call(&dst, fp + px, fl - px, 1);
    }
    px = _par_dist_prefix(fp, fl, "FDistribution");
    if (px > 0) {
        var fd1: f64 = _par_in(0);
        var fd2: f64 = _par_in(1);
        var dfd: PmnFDistribution;
        var efd = PmnFDistribution_new(&dfd, fd1, fd2);
        if (_par_eq(fp + px, fl - px, "new") == 1) { return _par_dist_new(efd, &dfd, 2); }
        if (efd != PMN_ERR_NONE) { return 0 - 1; }
        return _par_dist_call(&dfd, fp + px, fl - px, 2);
    }
    px = _par_dist_prefix(fp, fl, "Poisson");
    if (px > 0) {
        var plam: f64 = _par_in(0);
        var dpo: PmnPoisson;
        var epo = PmnPoisson_new(&dpo, plam);
        if (_par_eq(fp + px, fl - px, "new") == 1) { return _par_dist_new(epo, &dpo, 1); }
        if (epo != PMN_ERR_NONE) { return 0 - 1; }
        return _par_dist_call(&dpo, fp + px, fl - px, 1);
    }
    px = _par_dist_prefix(fp, fl, "Binomial");
    if (px > 0) {
        var bn = _par_in(0);
        var bnp: f64 = _par_in(1);
        var dbn: PmnBinomial;
        var ebn = PmnBinomial_new(&dbn, bn, bnp);
        if (_par_eq(fp + px, fl - px, "new") == 1) {
            if (ebn != PMN_ERR_NONE) {
                _par_got_err(ebn);
                return 1;
            }
            _par_got_i(dbn.n);
            var bnq: f64 = dbn.p;
            _par_got_f(bnq);
            return 1;
        }
        if (ebn != PMN_ERR_NONE) { return 0 - 1; }
        return _par_dist_call(&dbn, fp + px, fl - px, 2);
    }
    px = _par_dist_prefix(fp, fl, "Bernoulli");
    if (px > 0) {
        var p: f64 = _par_in(0);
        var db: PmnBernoulli;
        var eb = PmnBernoulli_new(&db, p);
        if (_par_eq(fp + px, fl - px, "new") == 1) { return _par_dist_new(eb, &db, 1); }
        if (eb != PMN_ERR_NONE) { return 0 - 1; }
        return _par_dist_call(&db, fp + px, fl - px, 1);
    }
    px = _par_dist_prefix(fp, fl, "MultivariateNormal");
    if (px > 0) { return _par_mvn(fp + px, fl - px); }
    return 0;
}

# `MultivariateNormal::` rows (M3 part d2): the constructor on the row's mean (d) and rows × cols covariance, read into
# buffers of up to 4,096 f64s (declared with the codec's rows); then its L and log det (the oracle's `mvn_factor`), a
# density at the `v:n` point, or `count` draws from the seed, each vector's d elements in order. The MultivariateNormal
# is dropped after the row.

fn _par_mvn(mp, ml): i64 {
    if (_par_mv_m == 0) {
        _par_mv_m = alloc(_PAR_MV_CAP * 8);
        _par_mv_c = alloc(_PAR_MV_CAP * 8);
        _par_mv_x = alloc(_PAR_MV_CAP * 8);
        if (_par_mv_m == 0 || _par_mv_c == 0 || _par_mv_x == 0) { return 0 - 1; }
    }
    var d = _par_in(0);
    if (d < 0 || d > 64 || _par_in_f64s(1, _par_mv_m) != d) { return 0 - 1; }
    var rows = _par_in(2 + d);
    var cols = _par_in(3 + d);
    if (rows < 0 || cols < 0 || rows * cols > _PAR_MV_CAP) { return 0 - 1; }
    if (_par_in_f64s(4 + d, _par_mv_c) != rows * cols) { return 0 - 1; }
    var k0 = 5 + d + rows * cols;
    var m: PmnMultivariateNormal;
    var e = PmnMultivariateNormal_new(&m, _par_mv_m, d, _par_mv_c, rows, cols);
    if (_par_eq(mp, ml, "new") == 1) {
        if (e != PMN_ERR_NONE) {
            _par_got_err(e);
            return 1;
        }
        var l = m.buf + (d + d * d) * 8;
        _par_got_seq(d * d);
        for (var k = 0; k < d * d; k = k + 1) { _par_got_f(load64(l + k * 8)); }
        var ld: f64 = m.log_det;
        _par_got_f(ld);
        var e0 = PmnMultivariateNormal_drop(&m);
        return 1;
    }
    if (e != PMN_ERR_NONE) { return 0 - 1; }   # a density or a draw on a refused case
    var r = 0;
    if (_par_eq(mp, ml, "log_pdf") == 1 || _par_eq(mp, ml, "pdf") == 1) {
        var n = _par_in(k0);
        r = 0 - 1;
        if (n >= 0 && n <= _PAR_MV_CAP) {
            var nx = _par_in_f64s(k0, _par_mv_x);
            var t = Err;
            var v = 0;
            if (ml == 7) {
                t, v = m.log_pdf(_par_mv_x, nx);
            } else {
                t, v = m.pdf(_par_mv_x, nx);
            }
            if (t == Err) {
                _par_got_err(v);
            } else {
                _par_got_f(v);
            }
            r = 1;
        }
    } elif (_par_eq(mp, ml, "sample") == 1) {
        var g: PmnSimpleRng;
        r = 0 - 1;
        if (PmnSimpleRng_new(&g, _par_in(k0)) == PMN_ERR_NONE) {
            var count = _par_in(k0 + 1);
            _par_got_seq(count * d);
            r = 1;
            for (var c = 0; c < count; c = c + 1) {
                if (m.sample(&g, _par_mv_x, _PAR_MV_CAP) != PMN_ERR_NONE) { r = 0 - 1; }
                for (var j = 0; j < d; j = j + 1) { _par_got_f(load64(_par_mv_x + j * 8)); }
            }
        }
    }
    var e1 = PmnMultivariateNormal_drop(&m);
    return r;
}

# `linalg` rows (M3 part d1): src/linalg.cyr's Cholesky factorization and solve, the matrix a `v:n²` slice and the
# right side a `v:n` one, read into buffers of up to 64 × 64.
var _par_la_a = 0;
var _par_la_b = 0;
var _par_la_o = 0;
var _PAR_LA_CAP = 4096;

fn _par_linalg(fp, fl): i64 {
    if (_par_la_a == 0) {
        _par_la_a = alloc(_PAR_LA_CAP * 8);
        _par_la_b = alloc(_PAR_LA_CAP * 8);
        _par_la_o = alloc(_PAR_LA_CAP * 8);
        if (_par_la_a == 0 || _par_la_b == 0 || _par_la_o == 0) { return 0 - 1; }
    }
    var n = _par_in(0);
    if (n < 0 || n > 64) { return 0 - 1; }
    var nn = n * n;
    if (_par_in_f64s(1, _par_la_a) != nn) { return 0 - 1; }
    if (_par_eq(fp, fl, "linalg::cholesky") == 1) {
        var e = _pmn_cholesky(_par_la_a, n, _par_la_o);
        if (e != PMN_ERR_NONE) {
            _par_got_err(e);
            return 1;
        }
        _par_got_seq(nn);
        for (var k = 0; k < nn; k = k + 1) { _par_got_f(load64(_par_la_o + k * 8)); }
        return 1;
    }
    if (_par_eq(fp, fl, "linalg::eigen_symmetric") == 1) {
        var tol: f64 = _par_in(nn + 2);
        var e3 = _pmn_eigen_symmetric(_par_la_a, n, tol, _par_in(nn + 3), _par_la_b, _par_la_o);
        if (e3 != PMN_ERR_NONE) {
            _par_got_err(e3);
            return 1;
        }
        _par_got_seq(n);
        for (var k3 = 0; k3 < n; k3 = k3 + 1) { _par_got_f(load64(_par_la_b + k3 * 8)); }
        _par_got_seq(nn);
        for (var k4 = 0; k4 < nn; k4 = k4 + 1) { _par_got_f(load64(_par_la_o + k4 * 8)); }
        return 1;
    }
    if (_par_eq(fp, fl, "linalg::cholesky_solve") == 1) {
        if (_par_in_f64s(nn + 2, _par_la_b) != n) { return 0 - 1; }
        var e2 = _pmn_cholesky_solve(_par_la_a, n, _par_la_b, _par_la_o);
        if (e2 != PMN_ERR_NONE) {
            _par_got_err(e2);
            return 1;
        }
        _par_got_seq(n);
        for (var j = 0; j < n; j = j + 1) { _par_got_f(load64(_par_la_o + j * 8)); }
        return 1;
    }
    return 0;
}

# `descriptive` rows (M4): src/descriptive.cyr. A slice is `v:n` and its values; a Result is its value or `E:`.

fn _par_ds_result(t, v): i64 {
    if (t == Err) {
        _par_got_err(v);
    } else {
        _par_got_f(v);
    }
    return 1;
}

# The kernel of an `e:Kernel.<Name>` input token at k, or -1.
fn _par_in_kernel(k): i64 {
    if (k >= _par_in_n || load64(_par_in_k + k * 8) != 101) { return 0 - 1; }
    var p = _par_in(k);
    var len = load64(_par_in_l + k * 8);
    for (var j = 0; j < 4; j = j + 1) {
        var name = pmn_kernel_name(j);
        var nl = strlen(name);
        if (len == nl + 7 && memeq(p + 7, name, nl) == 1) { return j; }
    }
    return 0 - 1;
}

# `KernelDensity::evaluate_grid` rows: the data, the points, the kernel, then the bandwidth or `n:` for Silverman's.
fn _par_kde(): i64 {
    var n = _par_in(0);
    if (n < 0 || n > _PAR_DS_CAP || n + 1 >= _par_in_n) { return 0 - 1; }
    _par_in_f64s(0, _par_ds_a);
    var m = _par_in(n + 1);
    if (m < 0 || m > _PAR_DS_CAP) { return 0 - 1; }
    _par_in_f64s(n + 1, _par_ds_b);
    var kk = n + m + 2;
    var k = _par_in_kernel(kk);
    if (k < 0) { return 0 - 1; }
    var kd: PmnKernelDensity;
    var e = 0;
    if (load64(_par_in_k + (kk + 1) * 8) == 110) {
        e = PmnKernelDensity_silverman(&kd, _par_ds_a, n, k);
    } else {
        var h: f64 = _par_in(kk + 1);
        e = PmnKernelDensity_new(&kd, _par_ds_a, n, h, k);
    }
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    var bw: f64 = kd.bandwidth;
    _par_got_f(bw);
    _par_got_seq(m);
    var r = 1;
    if (kd.evaluate_grid(_par_ds_b, m, _par_ds_o, _PAR_DS_CAP) != PMN_ERR_NONE) { r = 0 - 1; }
    for (var j = 0; j < m; j = j + 1) { _par_got_f(load64(_par_ds_o + j * 8)); }
    PmnKernelDensity_drop(&kd);
    return r;
}

# Reads the variables (slices) of a corr or pca row into _par_ds_a, their records into recs (16 at most); the count, or
# -1 for a defect.
fn _par_vars(recs): i64 {
    var p = 0;
    var k = 0;
    var used = 0;
    while (k < _par_in_n) {
        if (load64(_par_in_k + k * 8) != 118 || p >= 16) { return 0 - 1; }
        var n = _par_in(k);
        if (n < 0 || used + n > _PAR_DS_CAP) { return 0 - 1; }
        _par_in_f64s(k, _par_ds_a + used * 8);
        store64(recs + p * 16, _par_ds_a + used * 8);
        store64(recs + p * 16 + 8, n);
        used = used + n;
        p = p + 1;
        k = k + 1 + n;
    }
    return p;
}

# Appends a PcaResult's three lists as golden tokens.
fn _par_got_pca(r: *PmnPcaResult): i64 {
    var rows = r.n_components();
    _par_got_seq(rows);
    for (var i = 0; i < rows; i = i + 1) {
        var c = r.component_len(i);
        var rp = r.component(i);
        _par_got_seq(c);
        for (var j = 0; j < c; j = j + 1) { _par_got_f(load64(rp + j * 8)); }
    }
    var ne = r.n_eigenvalues();
    _par_got_seq(ne);
    for (var k = 0; k < ne; k = k + 1) { _par_got_f(load64(r.eigenvalues() + k * 8)); }
    var nr = r.n_ratios();
    _par_got_seq(nr);
    for (var q = 0; q < nr; q = q + 1) { _par_got_f(load64(r.explained_variance_ratio() + q * 8)); }
    return 1;
}

# A PcaResult built from golden tokens at k0 (the codec's and Debug's rows), into out: the next token, or -1.
fn _par_pca_from_toks(k0, out: *PmnPcaResult): i64 {
    var k = k0;
    if (k >= _par_in_n) { return 0 - 1; }
    var rows = _par_in(k);
    k = k + 1;
    var cells = 0;
    for (var i = 0; i < rows; i = i + 1) {
        if (k >= _par_in_n) { return 0 - 1; }
        var c = _par_in(k);
        cells = cells + c;
        k = k + 1 + c;
    }
    if (k >= _par_in_n) { return 0 - 1; }
    var ne = _par_in(k);
    var kr = k + 1 + ne;
    if (kr >= _par_in_n) { return 0 - 1; }
    var nr = _par_in(kr);
    if (_pmn_pca_alloc(out, rows, cells, ne, nr) != PMN_ERR_NONE) { return 0 - 1; }
    k = k0 + 1;
    var at = 0;
    for (var i2 = 0; i2 < rows; i2 = i2 + 1) {
        var c2 = _par_in(k);
        store64(out.offs + i2 * 8, at);
        for (var j = 0; j < c2; j = j + 1) { store64(out.comp + (at + j) * 8, _par_in(k + 1 + j)); }
        at = at + c2;
        k = k + 1 + c2;
    }
    store64(out.offs + rows * 8, at);
    for (var e = 0; e < ne; e = e + 1) { store64(out.evals + e * 8, _par_in(k + 1 + e)); }
    k = k + 1 + ne;
    for (var q = 0; q < nr; q = q + 1) { store64(out.ratio + q * 8, _par_in(k + 1 + q)); }
    return k + 1 + nr;
}

# `pca` rows: the variables; the components, eigenvalues and ratios, or the error.
fn _par_pca(): i64 {
    var recs[256];
    var p = _par_vars(&recs);
    if (p < 0) { return 0 - 1; }
    var r: PmnPcaResult;
    var e = pmn_pca(&r, &recs, p);
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    _par_got_pca(&r);
    PmnPcaResult_drop(&r);
    return 1;
}

# `correlation_matrix` rows: the variables, each a slice; the p × p matrix row-major or the error.
fn _par_corr(): i64 {
    var recs[256];
    var p = _par_vars(&recs);
    if (p < 0) { return 0 - 1; }
    var e = pmn_correlation_matrix(&recs, p, _par_ds_o, _PAR_DS_CAP);
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    _par_got_seq(p * p);
    for (var j = 0; j < p * p; j = j + 1) { _par_got_f(load64(_par_ds_o + j * 8)); }
    return 1;
}

fn _par_descriptive(fp, fl): i64 {
    if (_par_ds_a == 0) { _par_ds_a = alloc(_PAR_DS_CAP * 8); }
    if (_par_ds_b == 0) { _par_ds_b = alloc(_PAR_DS_CAP * 8); }
    if (_par_ds_o == 0) { _par_ds_o = alloc(_PAR_DS_CAP * 8); }
    if (_par_ds_a == 0 || _par_ds_b == 0 || _par_ds_o == 0) { return 0 - 1; }
    if (_par_eq(fp, fl, "KernelDensity::evaluate_grid") == 1) { return _par_kde(); }
    if (_par_eq(fp, fl, "descriptive::correlation_matrix") == 1) { return _par_corr(); }
    if (_par_eq(fp, fl, "descriptive::pca") == 1) { return _par_pca(); }
    var n = _par_in(0);
    if (n < 0 || n > _PAR_DS_CAP) { return 0 - 1; }
    _par_in_f64s(0, _par_ds_a);
    var a = _par_ds_a;
    if (_par_eq(fp, fl, "descriptive::sum") == 1) {
        var s: f64 = pmn_sum(a, n);
        _par_got_f(s);
        return 1;
    }
    if (_par_eq(fp, fl, "descriptive::quartiles") == 1) {
        var q[24];
        var e = pmn_quartiles(a, n, &q);
        if (e != PMN_ERR_NONE) {
            _par_got_err(e);
            return 1;
        }
        for (var k = 0; k < 3; k = k + 1) { _par_got_f(load64(&q + k * 8)); }
        return 1;
    }
    if (_par_eq(fp, fl, "descriptive::percentile") == 1) {
        var p: f64 = _par_in(n + 1);
        var t0, v0 = pmn_percentile(a, n, p);
        return _par_ds_result(t0, v0);
    }
    var t = Err;
    var v = 0;
    if (_par_eq(fp, fl, "descriptive::mean") == 1) {
        t, v = pmn_mean(a, n);
    } elif (_par_eq(fp, fl, "descriptive::median") == 1) {
        t, v = pmn_median(a, n);
    } elif (_par_eq(fp, fl, "descriptive::mode") == 1) {
        t, v = pmn_mode(a, n);
    } elif (_par_eq(fp, fl, "descriptive::variance") == 1) {
        t, v = pmn_variance(a, n);
    } elif (_par_eq(fp, fl, "descriptive::std_dev") == 1) {
        t, v = pmn_std_dev(a, n);
    } elif (_par_eq(fp, fl, "descriptive::skewness") == 1) {
        t, v = pmn_skewness(a, n);
    } elif (_par_eq(fp, fl, "descriptive::kurtosis") == 1) {
        t, v = pmn_kurtosis(a, n);
    } elif (_par_eq(fp, fl, "descriptive::iqr") == 1) {
        t, v = pmn_iqr(a, n);
    } elif (_par_eq(fp, fl, "descriptive::min") == 1) {
        t, v = pmn_min(a, n);
    } elif (_par_eq(fp, fl, "descriptive::max") == 1) {
        t, v = pmn_max(a, n);
    } elif (_par_eq(fp, fl, "descriptive::range") == 1) {
        t, v = pmn_range(a, n);
    } else {
        return 0;
    }
    return _par_ds_result(t, v);
}

# ── `hypothesis` rows (M4 part b1): src/hypothesis.cyr. Slices, then scalars; a TestResult is its name (`s:`),
# statistic, p-value, df, level and verdict; the one-sample KS test's CDF an `e:Cdf.<Name>` token.

fn _par_cdf_std_normal(ctx, x: f64): f64 {
    var r: f64 = _pmn_normal_cdf(x);
    return r;
}

fn _par_cdf_uniform01(ctx, x: f64): f64 {
    var r: f64 = _pmn_clamp(x, 0.0, 1.0);
    return r;
}

fn _par_cdf_exponential1(ctx, x: f64): f64 {
    if (x < 0.0) { return 0.0; }
    var a: f64 = -x;
    var e: f64 = _pmn_exp_m1(a);
    var r: f64 = -e;
    return r;
}

fn _par_cdf_overshoot(ctx, x: f64): f64 {
    var t: f64 = 2.0 * x;
    var r: f64 = t - 0.5;
    return r;
}

fn _par_cdf_nan_at_half(ctx, x: f64): f64 {
    if (x == 0.5) {
        var nan: f64 = _PMN_F64_NAN;
        return nan;
    }
    var r: f64 = _pmn_clamp(x, 0.0, 1.0);
    return r;
}

# The CDF named by an `e:Cdf.<Name>` token at k, or 0.
fn _par_in_cdf(k): i64 {
    if (k >= _par_in_n || load64(_par_in_k + k * 8) != 101) { return 0; }
    var p = _par_in(k) + 4;
    var len = load64(_par_in_l + k * 8) - 4;
    if (len == 9 && memeq(p, "StdNormal", 9) == 1) { return &_par_cdf_std_normal; }
    if (len == 9 && memeq(p, "Uniform01", 9) == 1) { return &_par_cdf_uniform01; }
    if (len == 12 && memeq(p, "Exponential1", 12) == 1) { return &_par_cdf_exponential1; }
    if (len == 9 && memeq(p, "Overshoot", 9) == 1) { return &_par_cdf_overshoot; }
    if (len == 9 && memeq(p, "NanAtHalf", 9) == 1) { return &_par_cdf_nan_at_half; }
    return 0;
}

fn _par_got_test(r: *PmnTestResult): i64 {
    _par_got_text(r.name, r.name_len);
    var st: f64 = r.statistic;
    var p: f64 = r.p_value;
    var df: f64 = r.degrees_of_freedom;
    var al: f64 = r.reject_at_alpha;
    _par_got_f(st);
    _par_got_f(p);
    _par_got_f(df);
    _par_got_f(al);
    _par_got_i(r.reject);
    return 1;
}

fn _par_got_anova(r: *PmnAnovaResult): i64 {
    var a: f64 = r.ss_between;
    var b: f64 = r.ss_within;
    var c: f64 = r.ss_total;
    _par_got_f(a);
    _par_got_f(b);
    _par_got_f(c);
    _par_got_i(r.df_between);
    _par_got_i(r.df_within);
    var d: f64 = r.ms_between;
    var e: f64 = r.ms_within;
    var f: f64 = r.f_statistic;
    var g: f64 = r.p_value;
    var h: f64 = r.reject_at_alpha;
    _par_got_f(d);
    _par_got_f(e);
    _par_got_f(f);
    _par_got_f(g);
    _par_got_f(h);
    _par_got_i(r.reject);
    return 1;
}

fn _par_got_ks(r: *PmnKsResult): i64 {
    var a: f64 = r.statistic;
    var b: f64 = r.p_value;
    var c: f64 = r.reject_at_alpha;
    _par_got_f(a);
    _par_got_f(b);
    _par_got_f(c);
    _par_got_i(r.reject);
    return 1;
}

fn _par_got_ci(r: *PmnConfidenceInterval): i64 {
    var a: f64 = r.lower;
    var b: f64 = r.upper;
    var c: f64 = r.estimate;
    var d: f64 = r.confidence_level;
    _par_got_f(a);
    _par_got_f(b);
    _par_got_f(c);
    _par_got_f(d);
    return 1;
}

fn _par_ci_from_toks(k, r: *PmnConfidenceInterval): i64 {
    var a: f64 = _par_in(k);
    var b: f64 = _par_in(k + 1);
    var c: f64 = _par_in(k + 2);
    var d: f64 = _par_in(k + 3);
    r.lower = a;
    r.upper = b;
    r.estimate = c;
    r.confidence_level = d;
    return k + 4;
}

fn _par_hypothesis(fp, fl): i64 {
    if (_par_ds_a == 0) { _par_ds_a = alloc(_PAR_DS_CAP * 8); }
    if (_par_ds_a == 0) { return 0 - 1; }
    var recs[256];
    var p = 0;
    var k = 0;
    var used = 0;
    while (k < _par_in_n && load64(_par_in_k + k * 8) == 118) {
        var n = _par_in(k);
        if (p >= 16 || n < 0 || used + n > _PAR_DS_CAP) { return 0 - 1; }
        _par_in_f64s(k, _par_ds_a + used * 8);
        store64(&recs + p * 16, _par_ds_a + used * 8);
        store64(&recs + p * 16 + 8, n);
        used = used + n;
        p = p + 1;
        k = k + 1 + n;
    }
    var alpha: f64 = _par_in(_par_in_n - 1);
    var e = 0;
    var tr: PmnTestResult;
    var kr: PmnKsResult;
    if (_par_eq(fp, fl, "hypothesis::t_test_one_sample") == 1) {
        if (p != 1) { return 0 - 1; }
        var mu: f64 = _par_in(k);
        e = pmn_t_test_one_sample(&tr, load64(&recs), load64(&recs + 8), mu, alpha);
        if (e == PMN_ERR_NONE) { return _par_got_test(&tr); }
    } elif (_par_eq(fp, fl, "hypothesis::t_test_two_sample") == 1) {
        if (p != 2) { return 0 - 1; }
        e = pmn_t_test_two_sample(&tr, load64(&recs), load64(&recs + 8), load64(&recs + 16), load64(&recs + 24), alpha);
        if (e == PMN_ERR_NONE) { return _par_got_test(&tr); }
    } elif (_par_eq(fp, fl, "hypothesis::chi_squared_test") == 1) {
        if (p != 2) { return 0 - 1; }
        e = pmn_chi_squared_test(&tr, load64(&recs), load64(&recs + 8), load64(&recs + 16), load64(&recs + 24), alpha);
        if (e == PMN_ERR_NONE) { return _par_got_test(&tr); }
    } elif (_par_eq(fp, fl, "hypothesis::one_way_anova") == 1) {
        var ar: PmnAnovaResult;
        e = pmn_one_way_anova(&ar, &recs, p, alpha);
        if (e == PMN_ERR_NONE) { return _par_got_anova(&ar); }
    } elif (_par_eq(fp, fl, "hypothesis::ks_two_sample") == 1) {
        if (p != 2) { return 0 - 1; }
        e = pmn_ks_two_sample(&kr, load64(&recs), load64(&recs + 8), load64(&recs + 16), load64(&recs + 24), alpha);
        if (e == PMN_ERR_NONE) { return _par_got_ks(&kr); }
    } elif (_par_eq(fp, fl, "hypothesis::t_quantile") == 1) {
        var tp: f64 = _par_in(0);
        var td: f64 = _par_in(1);
        var tq: f64 = _pmn_t_quantile(tp, td);
        _par_got_f(tq);
        return 1;
    } elif (_par_eq(fp, fl, "hypothesis::z_quantile") == 1) {
        var zp: f64 = _par_in(0);
        var zq: f64 = _pmn_z_quantile(zp);
        _par_got_f(zq);
        return 1;
    } elif (_par_eq(fp, fl, "hypothesis::ci_mean") == 1) {
        var ci: PmnConfidenceInterval;
        if (p != 1) { return 0 - 1; }
        e = pmn_ci_mean(&ci, load64(&recs), load64(&recs + 8), alpha);
        if (e == PMN_ERR_NONE) { return _par_got_ci(&ci); }
    } elif (_par_eq(fp, fl, "hypothesis::ci_two_means") == 1) {
        var ci2: PmnConfidenceInterval;
        if (p != 2) { return 0 - 1; }
        e = pmn_ci_two_means(&ci2, load64(&recs), load64(&recs + 8), load64(&recs + 16), load64(&recs + 24), alpha);
        if (e == PMN_ERR_NONE) { return _par_got_ci(&ci2); }
    } elif (_par_eq(fp, fl, "hypothesis::ci_proportion") == 1) {
        var ci3: PmnConfidenceInterval;
        e = pmn_ci_proportion(&ci3, _par_in(0), _par_in(1), alpha);
        if (e == PMN_ERR_NONE) { return _par_got_ci(&ci3); }
    } elif (_par_eq(fp, fl, "hypothesis::ks_one_sample") == 1) {
        var cdf = _par_in_cdf(k);
        if (p != 1 || cdf == 0) { return 0 - 1; }
        e = pmn_ks_one_sample(&kr, load64(&recs), load64(&recs + 8), cdf, 0, alpha);
        if (e == PMN_ERR_NONE) { return _par_got_ks(&kr); }
    } else {
        return 0;
    }
    _par_got_err(e);
    return 1;
}

# A TestResult, AnovaResult or KsResult built from golden tokens at the cursor (the codec's and Debug's rows), into
# the given result; the next token.
fn _par_test_from_toks(k, r: *PmnTestResult): i64 {
    var n = 0;
    var p = _par_in_bytes(k, &n);
    if (p == 0) { return 0 - 1; }
    r.name = p;
    r.name_len = n;
    r.owned = 0;
    var a: f64 = _par_in(k + 1);
    var b: f64 = _par_in(k + 2);
    var c: f64 = _par_in(k + 3);
    var d: f64 = _par_in(k + 4);
    r.statistic = a;
    r.p_value = b;
    r.degrees_of_freedom = c;
    r.reject_at_alpha = d;
    r.reject = _par_in(k + 5);
    return k + 6;
}

fn _par_anova_from_toks(k, r: *PmnAnovaResult): i64 {
    var a: f64 = _par_in(k);
    var b: f64 = _par_in(k + 1);
    var c: f64 = _par_in(k + 2);
    r.ss_between = a;
    r.ss_within = b;
    r.ss_total = c;
    r.df_between = _par_in(k + 3);
    r.df_within = _par_in(k + 4);
    var d: f64 = _par_in(k + 5);
    var e: f64 = _par_in(k + 6);
    var f: f64 = _par_in(k + 7);
    var g: f64 = _par_in(k + 8);
    var h: f64 = _par_in(k + 9);
    r.ms_between = d;
    r.ms_within = e;
    r.f_statistic = f;
    r.p_value = g;
    r.reject_at_alpha = h;
    r.reject = _par_in(k + 10);
    return k + 11;
}

fn _par_ks_from_toks(k, r: *PmnKsResult): i64 {
    var a: f64 = _par_in(k);
    var b: f64 = _par_in(k + 1);
    var c: f64 = _par_in(k + 2);
    r.statistic = a;
    r.p_value = b;
    r.reject_at_alpha = c;
    r.reject = _par_in(k + 3);
    return k + 4;
}

# ── `regression` rows (M5 part a): src/regression.cyr. Slices, then scalars, as validate.py's REG reads them.

fn _par_got_linear(r: *PmnLinearModel): i64 {
    var a: f64 = r.slope;
    var b: f64 = r.intercept;
    var c: f64 = r.r_squared;
    _par_got_f(a);
    _par_got_f(b);
    _par_got_f(c);
    return 1;
}

fn _par_got_poly(r: *PmnPolynomialModel): i64 {
    var n = r.len();
    _par_got_seq(n);
    for (var k = 0; k < n; k = k + 1) { _par_got_f(load64(r.coefficients() + k * 8)); }
    _par_got_i(r.degree);
    var c: f64 = r.r_squared;
    _par_got_f(c);
    return 1;
}

fn _par_got_logit(r: *PmnLogisticModel): i64 {
    var n = r.len();
    _par_got_seq(n);
    for (var k = 0; k < n; k = k + 1) { _par_got_f(load64(r.coefficients() + k * 8)); }
    _par_got_i(r.iterations);
    _par_got_i(r.converged);
    return 1;
}

# A PolynomialModel or LogisticModel built from golden tokens at k (`v:n`, the coefficients, then two words):
# the next token, or -1.
fn _par_poly_from_toks(k, r: *PmnPolynomialModel): i64 {
    var n = _par_in(k);
    if (n < 0 || n > _PAR_DS_CAP || k + n + 3 > _par_in_n) { return 0 - 1; }
    _par_in_f64s(k, _par_ds_b);
    var r2: f64 = _par_in(k + n + 2);
    if (_pmn_poly_fill(r, _par_ds_b, n, _par_in(k + n + 1), r2) != PMN_ERR_NONE) { return 0 - 1; }
    return k + n + 3;
}

fn _par_logit_from_toks(k, r: *PmnLogisticModel): i64 {
    var n = _par_in(k);
    if (n < 0 || n > _PAR_DS_CAP || k + n + 3 > _par_in_n) { return 0 - 1; }
    _par_in_f64s(k, _par_ds_b);
    if (_pmn_logit_fill(r, _par_ds_b, n, _par_in(k + n + 1), _par_in(k + n + 2)) != PMN_ERR_NONE) { return 0 - 1; }
    return k + n + 3;
}

fn _par_regression(fp, fl): i64 {
    if (_par_ds_a == 0) { _par_ds_a = alloc(_PAR_DS_CAP * 8); }
    if (_par_ds_b == 0) { _par_ds_b = alloc(_PAR_DS_CAP * 8); }
    if (_par_ds_o == 0) { _par_ds_o = alloc(_PAR_DS_CAP * 8); }
    if (_par_ds_a == 0 || _par_ds_b == 0 || _par_ds_o == 0) { return 0 - 1; }
    # the scalars before the slices (predict, residuals) and the slices (with their positions)
    var recs[1024];
    var sc[64];
    var p = 0;
    var ns = 0;
    var k = 0;
    var used = 0;
    while (k < _par_in_n) {
        if (load64(_par_in_k + k * 8) == 118) {
            var n = _par_in(k);
            if (p >= 64 || n < 0 || used + n > _PAR_DS_CAP) { return 0 - 1; }
            _par_in_f64s(k, _par_ds_a + used * 8);
            store64(&recs + p * 16, _par_ds_a + used * 8);
            store64(&recs + p * 16 + 8, n);
            used = used + n;
            p = p + 1;
            k = k + 1 + n;
        } else {
            if (ns >= 8) { return 0 - 1; }
            store64(&sc + ns * 8, _par_in(k));
            ns = ns + 1;
            k = k + 1;
        }
    }
    var e = 0;
    if (_par_eq(fp, fl, "regression::linear_regression") == 1) {
        var lm: PmnLinearModel;
        e = pmn_linear_regression(&lm, load64(&recs), load64(&recs + 8), load64(&recs + 16), load64(&recs + 24));
        if (e == PMN_ERR_NONE) { return _par_got_linear(&lm); }
    } elif (_par_eq(fp, fl, "regression::predict") == 1) {
        var pm: PmnLinearModel;
        var s0: f64 = load64(&sc);
        var s1: f64 = load64(&sc + 8);
        var s2: f64 = load64(&sc + 16);
        var s3: f64 = load64(&sc + 24);
        pm.slope = s0;
        pm.intercept = s1;
        pm.r_squared = s2;
        var pv: f64 = pmn_predict(&pm, s3);
        _par_got_f(pv);
        return 1;
    } elif (_par_eq(fp, fl, "regression::residuals") == 1) {
        var rm: PmnLinearModel;
        var t0: f64 = load64(&sc);
        var t1: f64 = load64(&sc + 8);
        var t2: f64 = load64(&sc + 16);
        rm.slope = t0;
        rm.intercept = t1;
        rm.r_squared = t2;
        var nx = load64(&recs + 8);
        e = pmn_residuals(&rm, load64(&recs), nx, load64(&recs + 16), load64(&recs + 24), _par_ds_o, _PAR_DS_CAP);
        if (e == PMN_ERR_NONE) {
            _par_got_seq(nx);
            for (var j = 0; j < nx; j = j + 1) { _par_got_f(load64(_par_ds_o + j * 8)); }
            return 1;
        }
    } elif (_par_eq(fp, fl, "regression::polynomial_regression") == 1) {
        var py: PmnPolynomialModel;
        e = pmn_polynomial_regression(&py, load64(&recs), load64(&recs + 8), load64(&recs + 16), load64(&recs + 24),
            load64(&sc));
        if (e == PMN_ERR_NONE) {
            _par_got_poly(&py);
            PmnPolynomialModel_drop(&py);
            return 1;
        }
    } elif (_par_eq(fp, fl, "regression::predict_poly") == 1) {
        var pp: PmnPolynomialModel;
        if (_pmn_poly_fill(&pp, load64(&recs), load64(&recs + 8), 0, 0.0) != PMN_ERR_NONE) { return 0 - 1; }
        var px: f64 = load64(&sc);
        var pr: f64 = pmn_predict_poly(&pp, px);
        _par_got_f(pr);
        PmnPolynomialModel_drop(&pp);
        return 1;
    } elif (_par_eq(fp, fl, "regression::residuals_poly") == 1) {
        var rp: PmnPolynomialModel;
        if (_pmn_poly_fill(&rp, load64(&recs), load64(&recs + 8), 0, 0.0) != PMN_ERR_NONE) { return 0 - 1; }
        var nx2 = load64(&recs + 24);
        e = pmn_residuals_poly(&rp, load64(&recs + 16), nx2, load64(&recs + 32), load64(&recs + 40), _par_ds_o,
            _PAR_DS_CAP);
        PmnPolynomialModel_drop(&rp);
        if (e == PMN_ERR_NONE) {
            _par_got_seq(nx2);
            for (var j2 = 0; j2 < nx2; j2 = j2 + 1) { _par_got_f(load64(_par_ds_o + j2 * 8)); }
            return 1;
        }
    } elif (_par_eq(fp, fl, "regression::logistic_regression") == 1) {
        var lg: PmnLogisticModel;
        var l2: f64 = load64(&sc);
        var lab = p - 1;
        e = pmn_logistic_regression(&lg, &recs, lab, load64(&recs + lab * 16), load64(&recs + lab * 16 + 8), l2,
            load64(&sc + 8));
        if (e == PMN_ERR_NONE) {
            _par_got_logit(&lg);
            PmnLogisticModel_drop(&lg);
            return 1;
        }
    } elif (_par_eq(fp, fl, "regression::predict_logistic_proba") == 1) {
        var lp: PmnLogisticModel;
        if (_pmn_logit_fill(&lp, load64(&recs), load64(&recs + 8), 0, 0) != PMN_ERR_NONE) { return 0 - 1; }
        var pq: f64 = pmn_predict_logistic_proba(&lp, load64(&recs + 16), load64(&recs + 24));
        _par_got_f(pq);
        PmnLogisticModel_drop(&lp);
        return 1;
    } elif (_par_eq(fp, fl, "regression::predict_logistic_class") == 1) {
        var lc: PmnLogisticModel;
        if (_pmn_logit_fill(&lc, load64(&recs), load64(&recs + 8), 0, 0) != PMN_ERR_NONE) { return 0 - 1; }
        var th: f64 = load64(&sc);
        _par_got_i(pmn_predict_logistic_class(&lc, load64(&recs + 16), load64(&recs + 24), th));
        PmnLogisticModel_drop(&lc);
        return 1;
    } else {
        return 0;
    }
    _par_got_err(e);
    return 1;
}

# ── `timeseries` rows (M5 part b): src/timeseries.cyr. Slices and scalars in order, as validate.py's TS reads them.

fn _par_got_arima(r: *PmnArimaModel): i64 {
    var n = r.len();
    _par_got_seq(n);
    for (var k = 0; k < n; k = k + 1) { _par_got_f(load64(r.ar_coefficients() + k * 8)); }
    _par_got_i(r.d);
    var a: f64 = r.intercept;
    var b: f64 = r.residual_variance;
    _par_got_f(a);
    _par_got_f(b);
    return 1;
}

# An ArimaModel built from golden tokens at k (the coefficients' slice, d, the intercept, the residual variance): the
# next token, or -1.
fn _par_arima_from_toks(k, r: *PmnArimaModel): i64 {
    var n = _par_in(k);
    if (n < 0 || n > _PAR_DS_CAP || k + n + 4 > _par_in_n) { return 0 - 1; }
    _par_in_f64s(k, _par_ds_b);
    var ic: f64 = _par_in(k + n + 2);
    var rv: f64 = _par_in(k + n + 3);
    if (_pmn_arima_fill(r, _par_ds_b, n, _par_in(k + n + 1), ic, rv) != PMN_ERR_NONE) { return 0 - 1; }
    return k + n + 4;
}

fn _par_got_series(e, n): i64 {
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    _par_got_seq(n);
    for (var j = 0; j < n; j = j + 1) { _par_got_f(load64(_par_ds_o + j * 8)); }
    return 1;
}

fn _par_timeseries(fp, fl): i64 {
    if (_par_ds_a == 0) { _par_ds_a = alloc(_PAR_DS_CAP * 8); }
    if (_par_ds_b == 0) { _par_ds_b = alloc(_PAR_DS_CAP * 8); }
    if (_par_ds_o == 0) { _par_ds_o = alloc(_PAR_DS_CAP * 8); }
    if (_par_ds_a == 0 || _par_ds_b == 0 || _par_ds_o == 0) { return 0 - 1; }
    var x = _par_ds_a;
    var n = _par_in(0);
    if (n < 0 || n > _PAR_DS_CAP / 2) { return 0 - 1; }
    _par_in_f64s(0, x);
    var k = n + 1;
    var cap = _PAR_DS_CAP;
    if (_par_eq(fp, fl, "timeseries::moving_average") == 1) {
        var w = _par_in(k);
        var e0 = pmn_moving_average(x, n, w, _par_ds_o, cap);
        return _par_got_series(e0, n - w + 1);
    }
    if (_par_eq(fp, fl, "timeseries::exponential_smoothing") == 1) {
        var a: f64 = _par_in(k);
        var e1 = pmn_exponential_smoothing(x, n, a, _par_ds_o, cap);
        return _par_got_series(e1, n);
    }
    if (_par_eq(fp, fl, "timeseries::autocorrelation") == 1) {
        var t, v = pmn_autocorrelation(x, n, _par_in(k));
        if (t == Err) {
            _par_got_err(v);
        } else {
            _par_got_f(v);
        }
        return 1;
    }
    if (_par_eq(fp, fl, "timeseries::difference") == 1) {
        var d = _par_in(k);
        var e2 = pmn_difference(x, n, d, _par_ds_o, cap);
        return _par_got_series(e2, n - d);
    }
    if (_par_eq(fp, fl, "timeseries::integrate") == 1) {
        var np = _par_in(k);
        if (np < 0 || n + np > _PAR_DS_CAP / 2) { return 0 - 1; }
        var pre = x + n * 8;
        _par_in_f64s(k, pre);
        var d2 = _par_in(k + np + 1);
        var e3 = pmn_integrate(x, n, pre, np, d2, _par_ds_o, cap);
        return _par_got_series(e3, n + d2);
    }
    if (_par_eq(fp, fl, "timeseries::arima_fit") == 1) {
        var am: PmnArimaModel;
        var e4 = pmn_arima_fit(&am, x, n, _par_in(k), _par_in(k + 1));
        if (e4 != PMN_ERR_NONE) {
            _par_got_err(e4);
            return 1;
        }
        _par_got_arima(&am);
        PmnArimaModel_drop(&am);
        return 1;
    }
    if (_par_eq(fp, fl, "timeseries::arima_forecast") == 1) {
        var fm: PmnArimaModel;
        var hk = _par_arima_from_toks(0, &fm);
        if (hk < 0) { return 0 - 1; }
        var hn = _par_in(hk);
        if (hn < 0 || hn > _PAR_DS_CAP / 2) { return 0 - 1; }
        _par_in_f64s(hk, x);
        var steps = _par_in(hk + hn + 1);
        var e5 = pmn_arima_forecast(&fm, x, hn, steps, _par_ds_o, cap);
        PmnArimaModel_drop(&fm);
        return _par_got_series(e5, steps);
    }
    return 0;
}

# ── `bayesian` rows (M5 part c): src/bayesian.cyr.

fn _par_bayesian(fp, fl): i64 {
    if (_par_eq(fp, fl, "BayesianUpdate::new") == 1 || _par_eq(fp, fl, "bayesian::bayes_theorem") == 1) {
        if (_par_in_n != 3) { return 0 - 1; }
        var p: f64 = _par_in(0);
        var l: f64 = _par_in(1);
        var e: f64 = _par_in(2);
        if (_par_eq(fp, fl, "bayesian::bayes_theorem") == 1) {
            var t, v = pmn_bayes_theorem(p, l, e);
            if (t == Err) {
                _par_got_err(v);
            } else {
                _par_got_f(v);
            }
            return 1;
        }
        var u: PmnBayesianUpdate;
        var ce = PmnBayesianUpdate_new(&u, p, l, e);
        if (ce != PMN_ERR_NONE) {
            _par_got_err(ce);
            return 1;
        }
        var a: f64 = u.prior;
        var b: f64 = u.likelihood;
        var c: f64 = u.evidence;
        var post: f64 = u.posterior();
        _par_got_f(a);
        _par_got_f(b);
        _par_got_f(c);
        _par_got_f(post);
        return 1;
    }
    if (_par_eq(fp, fl, "bayesian::naive_bayes_classify") == 1) {
        if (_par_ds_a == 0) { _par_ds_a = alloc(_PAR_DS_CAP * 8); }
        if (_par_ds_a == 0) { return 0 - 1; }
        var recs[1024];
        var np = _par_vars(&recs);
        if (np < 2) { return 0 - 1; }
        var t2, v2 = pmn_naive_bayes_classify(load64(&recs), load64(&recs + 8), load64(&recs + 16),
            load64(&recs + 24), &recs + 32, np - 2);
        if (t2 == Err) {
            _par_got_err(v2);
        } else {
            _par_got_i(v2);
        }
        return 1;
    }
    return 0;
}

# ── `markov` rows (M6 part a): src/markov.cyr.

# A nested matrix at token k0 (`v:rows`, then each row's `v:cols` and entries) into buf (cap f64s), row-major, its rows
# and columns into dims[0, 2): the token after it, or -1 when it is ragged or too large.
fn _par_mat_from_toks(k0, buf, cap, dims): i64 {
    if (k0 >= _par_in_n) { return 0 - 1; }
    var rows = _par_in(k0);
    var k = k0 + 1;
    var cols = 0;
    var at = 0;
    for (var r = 0; r < rows; r = r + 1) {
        if (k >= _par_in_n) { return 0 - 1; }
        var c = _par_in(k);
        if (r == 0) { cols = c; }
        if (c != cols || c < 0 || at + c > cap || k + c >= _par_in_n) { return 0 - 1; }
        _par_in_f64s(k, buf + at * 8);
        at = at + c;
        k = k + 1 + c;
    }
    store64(dims, rows);
    store64(dims + 8, cols);
    return k;
}

# Appends a rows × cols row-major matrix as nested-list tokens.
fn _par_got_mat(p, rows, cols): i64 {
    _par_got_seq(rows);
    for (var r = 0; r < rows; r = r + 1) {
        _par_got_seq(cols);
        for (var c = 0; c < cols; c = c + 1) { _par_got_f(load64(p + (r * cols + c) * 8)); }
    }
    return 0;
}

# A MarkovChain from its codec tokens at k0 (the matrix nested, then the state) into c: the token after, or -1.
fn _par_chain_from_toks(k0, c: *PmnMarkovChain): i64 {
    if (_par_ds_b == 0) { _par_ds_b = alloc(_PAR_DS_CAP * 8); }
    if (_par_ds_b == 0) { return 0 - 1; }
    var dm[16];
    var k = _par_mat_from_toks(k0, _par_ds_b, _PAR_DS_CAP, &dm);
    if (k < 0 || k >= _par_in_n) { return 0 - 1; }
    if (PmnMarkovChain_new(c, _par_ds_b, load64(&dm), load64(&dm + 8), _par_in(k)) != PMN_ERR_NONE) { return 0 - 1; }
    return k + 1;
}

# A HiddenMarkovModel from its codec tokens at k0 (transition and emission nested, then the initial list) into h.
fn _par_hmm_from_toks(k0, h: *PmnHiddenMarkovModel): i64 {
    if (_par_ds_b == 0) { _par_ds_b = alloc(_PAR_DS_CAP * 8); }
    if (_par_ds_b == 0) { return 0 - 1; }
    var q = _PAR_DS_CAP / 4;
    var da[16];
    var db[16];
    var k = _par_mat_from_toks(k0, _par_ds_b, q, &da);
    if (k < 0) { return 0 - 1; }
    k = _par_mat_from_toks(k, _par_ds_b + q * 8, q, &db);
    if (k < 0 || k >= _par_in_n) { return 0 - 1; }
    var n = _par_in(k);
    if (n < 0 || n > q || k + n >= _par_in_n) { return 0 - 1; }
    var ip = _par_ds_b + 2 * q * 8;
    _par_in_f64s(k, ip);
    var e = PmnHiddenMarkovModel_new(h, _par_ds_b, load64(&da), load64(&da + 8), _par_ds_b + q * 8, load64(&db),
        load64(&db + 8), ip, n);
    if (e != PMN_ERR_NONE) { return 0 - 1; }
    return k + 1 + n;
}

# Reads the `v:n` slice at token k into buf (n ≤ cap words): the token after it, or -1.
fn _par_slice_at(k, buf, cap): i64 {
    if (k >= _par_in_n) { return 0 - 1; }
    if (load64(_par_in_k + k * 8) != 118) { return 0 - 1; }
    var n = _par_in(k);
    if (n < 0 || n > cap || k + n >= _par_in_n) { return 0 - 1; }
    _par_in_f64s(k, buf);
    return k + 1 + n;
}

# MarkovChain rows: the flat matrix, its rows, columns and initial state[, the seed and the steps]. HiddenMarkovModel
# rows: the flat transition, emission and initial slices, the observations, the four dimensions[, max_iter].
fn _par_markov(fp, fl): i64 {
    if (_par_ds_a == 0) { _par_ds_a = alloc(_PAR_DS_CAP * 8); }
    if (_par_ds_b == 0) { _par_ds_b = alloc(_PAR_DS_CAP * 8); }
    if (_par_ds_o == 0) { _par_ds_o = alloc(_PAR_DS_CAP * 8); }
    if (_par_ds_a == 0 || _par_ds_b == 0 || _par_ds_o == 0) { return 0 - 1; }
    var q = _PAR_DS_CAP / 4;
    if (fl > 13 && memeq(fp, "MarkovChain::", 13) == 1) {
        var k = _par_slice_at(0, _par_ds_a, _PAR_DS_CAP);
        if (k < 0 || k + 3 > _par_in_n) { return 0 - 1; }
        var c: PmnMarkovChain;
        var e = PmnMarkovChain_new(&c, _par_ds_a, _par_in(k), _par_in(k + 1), _par_in(k + 2));
        if (e != PMN_ERR_NONE) {
            _par_got_err(e);
            return 1;
        }
        var r = 1;
        if (_par_eq(fp, fl, "MarkovChain::new") == 1) {
            _par_got_i(c.num_states());
            _par_got_i(c.state);
        } elif (_par_eq(fp, fl, "MarkovChain::steady_state") == 1) {
            var es = c.steady_state(_par_ds_o, _PAR_DS_CAP);
            if (es != PMN_ERR_NONE) {
                _par_got_err(es);
            } else {
                _par_got_seq(c.num_states());
                for (var j = 0; j < c.num_states(); j = j + 1) { _par_got_f(load64(_par_ds_o + j * 8)); }
            }
        } elif (k + 5 == _par_in_n) {
            var g: PmnSimpleRng;
            var steps = _par_in(k + 4);
            if (PmnSimpleRng_new(&g, _par_in(k + 3)) != PMN_ERR_NONE || steps < 0 || steps >= _PAR_DS_CAP) {
                r = 0 - 1;
            } elif (_par_eq(fp, fl, "MarkovChain::step") == 1) {
                _par_got_seq(steps);
                for (var s = 0; s < steps; s = s + 1) { _par_got_i(c.step(&g)); }
            } elif (_par_eq(fp, fl, "MarkovChain::simulate") == 1) {
                var em = c.simulate(steps, &g, _par_ds_o, _PAR_DS_CAP);
                if (em != PMN_ERR_NONE) {
                    _par_got_err(em);
                } else {
                    _par_got_seq(steps + 1);
                    for (var t = 0; t <= steps; t = t + 1) { _par_got_i(load64(_par_ds_o + t * 8)); }
                }
            } else {
                r = 0;
            }
        } else {
            r = 0 - 1;
        }
        var cd = PmnMarkovChain_drop(&c);
        return r;
    }
    if (fl > 19 && memeq(fp, "HiddenMarkovModel::", 19) == 1) {
        var ka = _par_slice_at(0, _par_ds_a, q);
        if (ka < 0) { return 0 - 1; }
        var kb = _par_slice_at(ka, _par_ds_a + q * 8, q);
        if (kb < 0) { return 0 - 1; }
        var kp = _par_slice_at(kb, _par_ds_a + 2 * q * 8, q);
        if (kp < 0) { return 0 - 1; }
        var ko = _par_slice_at(kp, _par_ds_b, _PAR_DS_CAP);
        if (ko < 0 || ko + 4 > _par_in_n) { return 0 - 1; }
        var t = _par_in(kp);
        var h: PmnHiddenMarkovModel;
        var eh = PmnHiddenMarkovModel_new(&h, _par_ds_a, _par_in(ko), _par_in(ko + 1), _par_ds_a + q * 8,
            _par_in(ko + 2), _par_in(ko + 3), _par_ds_a + 2 * q * 8, _par_in(kb));
        if (eh != PMN_ERR_NONE) {
            _par_got_err(eh);
            return 1;
        }
        var rh = 1;
        if (_par_eq(fp, fl, "HiddenMarkovModel::new") == 1) {
            _par_got_i(h.num_states());
            _par_got_i(h.num_symbols());
        } elif (_par_eq(fp, fl, "HiddenMarkovModel::forward_log_likelihood") == 1) {
            var tl, vl = h.forward_log_likelihood(_par_ds_b, t);
            if (tl == Err) {
                _par_got_err(vl);
            } else {
                _par_got_f(vl);
            }
        } elif (_par_eq(fp, fl, "HiddenMarkovModel::viterbi") == 1) {
            var ev = h.viterbi(_par_ds_b, t, _par_ds_o, _PAR_DS_CAP);
            if (ev != PMN_ERR_NONE) {
                _par_got_err(ev);
            } else {
                _par_got_seq(t);
                for (var s2 = 0; s2 < t; s2 = s2 + 1) { _par_got_i(load64(_par_ds_o + s2 * 8)); }
            }
        } elif (_par_eq(fp, fl, "HiddenMarkovModel::baum_welch") == 1) {
            if (ko + 5 != _par_in_n) {
                rh = 0 - 1;
            } else {
                var h2: PmnHiddenMarkovModel;
                var eb = h.baum_welch(_par_ds_b, t, _par_in(ko + 4), &h2);
                if (eb != PMN_ERR_NONE) {
                    _par_got_err(eb);
                } else {
                    var n = h2.num_states();
                    var m = h2.num_symbols();
                    _par_got_seq(n * n);
                    for (var a = 0; a < n * n; a = a + 1) { _par_got_f(load64(h2.transition() + a * 8)); }
                    _par_got_seq(n * m);
                    for (var b = 0; b < n * m; b = b + 1) { _par_got_f(load64(h2.emission() + b * 8)); }
                    _par_got_seq(n);
                    for (var p = 0; p < n; p = p + 1) { _par_got_f(load64(h2.initial() + p * 8)); }
                    var d2 = PmnHiddenMarkovModel_drop(&h2);
                }
            }
        } else {
            rh = 0;
        }
        var hd = PmnHiddenMarkovModel_drop(&h);
        return rh;
    }
    return 0;
}

# ── `monte_carlo` rows (M6 part b): src/monte_carlo.cyr. The caller's functions are these, by id; validate.py's
# mc_f, mc_target and mc_cond model them in the same operation order.

# The integrands: x, x², 3x² + 2x + 1, sin x, exp(−x²), 1/x, 1e8 + x, √x, 5. ctx holds the id.
fn _par_mc_f(ctx, x: f64): f64 {
    var fid = load64(ctx);
    if (fid == 0) { return x; }
    if (fid == 1) {
        var r1: f64 = x * x;
        return r1;
    }
    if (fid == 2) {
        var a: f64 = 3.0 * x;
        var b: f64 = a * x;
        var c: f64 = 2.0 * x;
        var d: f64 = b + c;
        var r2: f64 = d + 1.0;
        return r2;
    }
    if (fid == 3) {
        var r3: f64 = _pmn_sin(x);
        return r3;
    }
    if (fid == 4) {
        var q: f64 = x * x;
        var nq: f64 = -q;
        var r4: f64 = _pmn_exp(nq);
        return r4;
    }
    if (fid == 5) {
        var r5: f64 = 1.0 / x;
        return r5;
    }
    if (fid == 6) {
        var r6: f64 = 100000000.0 + x;
        return r6;
    }
    if (fid == 7) {
        var r7: f64 = f64_sqrt(x);
        return r7;
    }
    return 5.0;
}

# The log-densities: N(0, I), N(0, 4I), the box [−1, 1]^d (−∞ or NaN outside), zero density below 2 then −(x₀ − 3)²,
# the mixture ln(e^(−(x−2)²/2) + e^(−(x+2)²/2)), Rosenbrock's scaled, always −∞, flat. ctx holds the id.
fn _par_mc_target(ctx, xs, dim): f64 {
    var tid = load64(ctx);
    var ninf: f64 = _PMN_F64_NEG_INFINITY;
    if (tid == 0 || tid == 1) {
        var s: f64 = 0.0;
        for (var k = 0; k < dim; k = k + 1) {
            var v: f64 = load64(xs + k * 8);
            var vv: f64 = v * v;
            s = s + vv;
        }
        if (tid == 0) {
            var r0: f64 = -0.5 * s;
            return r0;
        }
        var r1: f64 = -0.125 * s;
        return r1;
    }
    if (tid == 2 || tid == 3) {
        var inside = 1;
        for (var k2 = 0; k2 < dim; k2 = k2 + 1) {
            var w: f64 = load64(xs + k2 * 8);
            if (w < -1.0 || w > 1.0 || w != w) { inside = 0; }
        }
        if (inside == 1) { return 0.0; }
        if (tid == 2) { return ninf; }
        var nan: f64 = _PMN_F64_NAN;
        return nan;
    }
    var x0: f64 = load64(xs);
    if (tid == 4) {
        if (x0 < 2.0) { return ninf; }
        var d: f64 = x0 - 3.0;
        var dd: f64 = d * d;
        var r4: f64 = -dd;
        return r4;
    }
    if (tid == 5) {
        var a: f64 = x0 - 2.0;
        var b: f64 = x0 + 2.0;
        var aa: f64 = a * a;
        var ha: f64 = -0.5 * aa;
        var ea: f64 = _pmn_exp(ha);
        var bb: f64 = b * b;
        var hb: f64 = -0.5 * bb;
        var eb: f64 = _pmn_exp(hb);
        var sm: f64 = ea + eb;
        if (sm > 0.0) {
            var r5: f64 = _pmn_ln(sm);
            return r5;
        }
        return ninf;
    }
    if (tid == 6) {
        var x1: f64 = load64(xs + 8);
        var p: f64 = 1.0 - x0;
        var x00: f64 = x0 * x0;
        var q: f64 = x1 - x00;
        var pp: f64 = p * p;
        var qq: f64 = q * q;
        var hq: f64 = 100.0 * qq;
        var t: f64 = pp + hq;
        var nt: f64 = -t;
        var r6: f64 = nt / 20.0;
        return r6;
    }
    if (tid == 7) { return ninf; }
    return 0.0;
}

# Box–Muller's normal from a conditional's dyn draws, as `standard_normal`.
fn _par_mc_normal(rp: *PmnRngRef): f64 {
    var d1: f64 = rp.o.next_f64();
    var mp: f64 = _PMN_F64_MIN_POSITIVE;
    var u1: f64 = _pmn_max(d1, mp);
    var u2: f64 = rp.o.next_f64();
    var l: f64 = _pmn_ln(u1);
    var a: f64 = -2.0 * l;
    var r: f64 = f64_sqrt(a);
    var tp: f64 = 2.0 * _PMN_F64_PI;
    var t: f64 = tp * u2;
    var c: f64 = _pmn_cos(t);
    var z: f64 = r * c;
    return z;
}

# The Gibbs conditionals, by id: par·(the others' mean) + √(1 − par²)·z, z, a uniform draw, the others' mean plus a
# uniform in [−½, ½), ½(x_j + par). c holds {id, j, par}.
fn _par_mc_cond(c, state, dim, rp: *PmnRngRef): f64 {
    var cid = load64(c);
    var j = load64(c + 8);
    var par: f64 = load64(c + 16);
    if (cid == 0 || cid == 3) {
        var m: f64 = 0.0;
        var cnt = 0;
        for (var k = 0; k < dim; k = k + 1) {
            if (k != j) {
                var v: f64 = load64(state + k * 8);
                m = m + v;
                cnt = cnt + 1;
            }
        }
        if (cnt > 0) {
            var cf: f64 = f64_from(cnt);
            m = m / cf;
        }
        if (cid == 0) {
            var z: f64 = _par_mc_normal(rp);
            var pm: f64 = par * m;
            var p2: f64 = par * par;
            var om: f64 = 1.0 - p2;
            var sq: f64 = f64_sqrt(om);
            var sz: f64 = sq * z;
            var r0: f64 = pm + sz;
            return r0;
        }
        var u: f64 = rp.o.next_f64();
        var uh: f64 = u - 0.5;
        var r3: f64 = m + uh;
        return r3;
    }
    if (cid == 1) {
        var r1: f64 = _par_mc_normal(rp);
        return r1;
    }
    if (cid == 2) {
        var r2: f64 = rp.o.next_f64();
        return r2;
    }
    var sj: f64 = load64(state + j * 8);
    var sp: f64 = sj + par;
    var r4: f64 = 0.5 * sp;
    return r4;
}

# Appends a chain's samples (one flat `v:` slice) and its acceptance rate.
fn _par_got_chain(r: *PmnMcmcResult): i64 {
    var rows = r.n_samples();
    var cells = 0;
    if (rows > 0) { cells = load64(r.offs + rows * 8); }
    _par_got_seq(cells);
    for (var k = 0; k < cells; k = k + 1) { _par_got_f(load64(r.samples() + k * 8)); }
    var ar: f64 = r.acceptance_rate;
    _par_got_f(ar);
    return 0;
}

# monte_carlo rows: integrate (the integrand's id, a, b, n, seed), π (n, seed), Metropolis–Hastings (the initial point,
# the target's id, σ, n, burn-in, seed) and Gibbs (the conditionals' ids and parameters, the initial point, n, burn-in,
# seed).
fn _par_monte_carlo(fp, fl): i64 {
    if (_par_ds_a == 0) { _par_ds_a = alloc(_PAR_DS_CAP * 8); }
    if (_par_ds_b == 0) { _par_ds_b = alloc(_PAR_DS_CAP * 8); }
    if (_par_ds_o == 0) { _par_ds_o = alloc(_PAR_DS_CAP * 8); }
    if (_par_ds_a == 0 || _par_ds_b == 0 || _par_ds_o == 0) { return 0 - 1; }
    var g: PmnSimpleRng;
    var ctx[8];
    if (_par_eq(fp, fl, "monte_carlo::monte_carlo_integrate") == 1) {
        if (_par_in_n != 5) { return 0 - 1; }
        store64(&ctx, _par_in(0));
        var a: f64 = _par_in(1);
        var b: f64 = _par_in(2);
        if (PmnSimpleRng_new(&g, _par_in(4)) != PMN_ERR_NONE) { return 0 - 1; }
        var er: PmnEstimateResult;
        var e = pmn_monte_carlo_integrate(&er, &_par_mc_f, &ctx, a, b, _par_in(3), &g);
        if (e != PMN_ERR_NONE) {
            _par_got_err(e);
            return 1;
        }
        var v: f64 = er.value;
        var se: f64 = er.std_error;
        _par_got_f(v);
        _par_got_f(se);
        return 1;
    }
    if (_par_eq(fp, fl, "monte_carlo::monte_carlo_pi") == 1) {
        if (_par_in_n != 2) { return 0 - 1; }
        if (PmnSimpleRng_new(&g, _par_in(1)) != PMN_ERR_NONE) { return 0 - 1; }
        var t, pv = pmn_monte_carlo_pi(_par_in(0), &g);
        if (t == Err) {
            _par_got_err(pv);
        } else {
            _par_got_f(pv);
        }
        return 1;
    }
    var r: PmnMcmcResult;
    if (_par_eq(fp, fl, "monte_carlo::metropolis_hastings") == 1) {
        var k = _par_slice_at(0, _par_ds_a, _PAR_DS_CAP);
        if (k < 0 || k + 5 != _par_in_n) { return 0 - 1; }
        store64(&ctx, _par_in(k));
        var sd: f64 = _par_in(k + 1);
        if (PmnSimpleRng_new(&g, _par_in(k + 4)) != PMN_ERR_NONE) { return 0 - 1; }
        var em = pmn_metropolis_hastings(&r, &_par_mc_target, &ctx, _par_ds_a, _par_in(0), sd, _par_in(k + 2),
            _par_in(k + 3), &g);
        if (em != PMN_ERR_NONE) {
            _par_got_err(em);
            return 1;
        }
        _par_got_chain(&r);
        var dm = PmnMcmcResult_drop(&r);
        return 1;
    }
    if (_par_eq(fp, fl, "monte_carlo::gibbs_sampling") == 1) {
        var q = _PAR_DS_CAP / 4;
        var kc = _par_slice_at(0, _par_ds_a, q);
        if (kc < 0) { return 0 - 1; }
        var kp = _par_slice_at(kc, _par_ds_a + q * 8, q);
        if (kp < 0) { return 0 - 1; }
        var ki = _par_slice_at(kp, _par_ds_a + 2 * q * 8, q);
        if (ki < 0 || ki + 3 != _par_in_n) { return 0 - 1; }
        var dim = _par_in(0);
        if (_par_in(kc) != dim || dim > q / 3) { return 0 - 1; }
        for (var j = 0; j < dim; j = j + 1) {
            var cx = _par_ds_b + j * 24;
            store64(cx, load64(_par_ds_a + j * 8));
            store64(cx + 8, j);
            store64(cx + 16, load64(_par_ds_a + (q + j) * 8));
            store64(_par_ds_o + j * 16, &_par_mc_cond);
            store64(_par_ds_o + j * 16 + 8, cx);
        }
        if (PmnSimpleRng_new(&g, _par_in(ki + 2)) != PMN_ERR_NONE) { return 0 - 1; }
        var eg = pmn_gibbs_sampling(&r, _par_ds_o, dim, _par_ds_a + 2 * q * 8, _par_in(kp), _par_in(ki),
            _par_in(ki + 1), &g);
        if (eg != PMN_ERR_NONE) {
            _par_got_err(eg);
            return 1;
        }
        _par_got_chain(&r);
        var dg = PmnMcmcResult_drop(&r);
        return 1;
    }
    return 0;
}

# A McmcResult from its codec tokens at k0 (the samples nested, rows of any lengths, then the rate) into r: the token
# after them, or -1. The caller drops r.
fn _par_mcmc_from_toks(k0, r: *PmnMcmcResult): i64 {
    if (k0 >= _par_in_n) { return 0 - 1; }
    var rows = _par_in(k0);
    var k = k0 + 1;
    var cells = 0;
    for (var i = 0; i < rows; i = i + 1) {
        if (k >= _par_in_n) { return 0 - 1; }
        var c = _par_in(k);
        cells = cells + c;
        k = k + 1 + c;
    }
    if (k >= _par_in_n || rows < 0) { return 0 - 1; }
    if (_pmn_mcmc_alloc(r, rows, cells) != PMN_ERR_NONE) { return 0 - 1; }
    k = k0 + 1;
    var at = 0;
    for (var i2 = 0; i2 < rows; i2 = i2 + 1) {
        var c2 = _par_in(k);
        store64(r.offs + i2 * 8, at);
        for (var j = 0; j < c2; j = j + 1) { store64(r.data + (at + j) * 8, _par_in(k + 1 + j)); }
        at = at + c2;
        k = k + 1 + c2;
    }
    store64(r.offs + rows * 8, at);
    var ar: f64 = _par_in(k);
    r.acceptance_rate = ar;
    return k + 1;
}

# json::EstimateResult rows (M6 part b): the decoded fields, or the error.
fn _par_json_estimate(): i64 {
    var n = 0;
    var doc = _par_in_bytes(0, &n);
    if (doc == 0) { return 0 - 1; }
    var er: PmnEstimateResult;
    var e = PmnEstimateResult_from_json(&er, doc, n);
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    var v: f64 = er.value;
    var se: f64 = er.std_error;
    _par_got_f(v);
    _par_got_f(se);
    return 1;
}

# json::McmcResult rows (M6 part b): the decoded samples (nested lists, rows of any lengths) and rate; dropped after.
fn _par_json_mcmc(): i64 {
    var n = 0;
    var doc = _par_in_bytes(0, &n);
    if (doc == 0) { return 0 - 1; }
    var r: PmnMcmcResult;
    var e = PmnMcmcResult_from_json(&r, doc, n);
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    var rows = r.n_samples();
    _par_got_seq(rows);
    for (var i = 0; i < rows; i = i + 1) {
        var c = r.sample_len(i);
        _par_got_seq(c);
        for (var j = 0; j < c; j = j + 1) { _par_got_f(load64(r.sample(i) + j * 8)); }
    }
    var ar: f64 = r.acceptance_rate;
    _par_got_f(ar);
    var e1 = PmnMcmcResult_drop(&r);
    return 1;
}

# ── `soorat` rows (M7 part a): src/soorat.cyr. A value is its codec tokens, in Rust's field order.

# Input token k, an `s:` token, as a fresh copy of its bytes (escapes decoded): the pointer, its length at lenp; 0 when
# the token is no `s:` token.
fn _par_in_bytes_copy(k, lenp): i64 {
    var n = 0;
    var p = _par_in_bytes(k, &n);
    if (p == 0) { return 0; }
    var c = alloc(n + 8);
    if (c == 0) { return 0; }
    if (n > 0) { memcpy(c, p, n); }
    store64(lenp, n);
    return c;
}

# A `v:n` slice of f64 or u64 words at token k into a fresh buffer: the buffer, its count at np, the next token at kp;
# 0 when the token is no slice.
fn _par_so_vec(k, np, kp): i64 {
    if (k >= _par_in_n || load64(_par_in_k + k * 8) != 118) { return 0; }
    var n = _par_in(k);
    if (n < 0 || k + n >= _par_in_n) { return 0; }
    var b = alloc(n * 8 + 8);
    if (b == 0) { return 0; }
    _par_in_f64s(k, b);
    store64(np, n);
    store64(kp, k + 1 + n);
    return b;
}

# A shape of the given kind (0 DistributionCurve, 1 McmcTrace, 2 RegressionFit, 3 HistogramData, 4 CorrelationMatrix)
# from its codec tokens at k0 into out (a shape's struct): the next token, or -1. The caller drops out.
fn _par_so_from_toks(kind, k0, out): i64 {
    var k = k0;
    var nv = 3;
    if (kind == 1) { nv = 2; }
    if (kind == 2) { nv = 5; }
    if (kind == 3) { nv = 2; }
    if (kind == 4) { nv = 1; }
    var ps[48];
    var ns[48];
    for (var i = 0; i < nv; i = i + 1) {
        var nn = 0;
        var nk = 0;
        var b = _par_so_vec(k, &nn, &nk);
        if (b == 0) { return 0 - 1; }
        store64(&ps + i * 8, b);
        store64(&ns + i * 8, nn);
        k = nk;
    }
    if (kind == 0 || kind == 1) {
        var sn = 0;
        var sp = _par_in_bytes_copy(k, &sn);
        if (sp == 0) { return 0 - 1; }
        var e0 = 0;
        if (kind == 0) {
            e0 = PmnDistributionCurve_new(out, load64(&ps), load64(&ns), load64(&ps + 8), load64(&ns + 8),
                load64(&ps + 16), load64(&ns + 16), sp, sn);
        } else {
            e0 = PmnMcmcTrace_new(out, load64(&ps), load64(&ns), load64(&ps + 8), load64(&ns + 8), sp, sn);
        }
        if (e0 != PMN_ERR_NONE) { return 0 - 1; }
        return k + 1;
    }
    if (kind == 2) {
        if (k >= _par_in_n) { return 0 - 1; }
        var recs[80];
        for (var j = 0; j < 5; j = j + 1) {
            store64(&recs + j * 16, load64(&ps + j * 8));
            store64(&recs + j * 16 + 8, load64(&ns + j * 8));
        }
        var r2: f64 = _par_in(k);
        if (PmnRegressionFit_new(out, &recs, r2) != PMN_ERR_NONE) { return 0 - 1; }
        return k + 1;
    }
    if (kind == 3) {
        if (k >= _par_in_n) { return 0 - 1; }
        if (PmnHistogramData_new(out, load64(&ps), load64(&ns), load64(&ps + 8), load64(&ns + 8), _par_in(k))
            != PMN_ERR_NONE) {
            return 0 - 1;
        }
        return k + 1;
    }
    if (k + 1 >= _par_in_n) { return 0 - 1; }
    var size = _par_in(k);
    k = k + 1;
    if (load64(_par_in_k + k * 8) != 118) { return 0 - 1; }
    var nl = _par_in(k);
    if (nl < 0 || k + nl >= _par_in_n) { return 0 - 1; }
    var lr = alloc(nl * 16 + 8);
    for (var q = 0; q < nl; q = q + 1) {
        var ln = 0;
        var lp = _par_in_bytes_copy(k + 1 + q, &ln);
        if (lp == 0) { return 0 - 1; }
        store64(lr + q * 16, lp);
        store64(lr + q * 16 + 8, ln);
    }
    if (PmnCorrelationMatrix_new(out, load64(&ps), load64(&ns), size, lr, nl) != PMN_ERR_NONE) { return 0 - 1; }
    return k + 1 + nl;
}

# Appends n f64 words (or u64 words, ints = 1) at p as a `v:n` slice.
fn _par_got_words(p, n, ints): i64 {
    _par_got_seq(n);
    for (var i = 0; i < n; i = i + 1) {
        if (ints == 1) {
            _par_got_i(load64(p + i * 8));
        } else {
            _par_got_f(load64(p + i * 8));
        }
    }
    return 0;
}

# Appends a shape's codec tokens.
fn _par_got_shape(kind, v): i64 {
    if (kind == 0) {
        var c: PmnDistributionCurve = v;
        _par_got_words(c.x, c.nx, 0);
        _par_got_words(c.pdf, c.npdf, 0);
        _par_got_words(c.cdf, c.ncdf, 0);
        _par_got_text(c.name, c.nname);
        return 0;
    }
    if (kind == 1) {
        var t: PmnMcmcTrace = v;
        _par_got_words(t.samples, t.ns, 0);
        _par_got_words(t.lls, t.nll, 0);
        _par_got_text(t.parameter, t.nparameter);
        return 0;
    }
    if (kind == 2) {
        var ft: PmnRegressionFit = v;
        for (var i = 0; i < 5; i = i + 1) { _par_got_words(ft.field(i), ft.field_len(i), 0); }
        var r2: f64 = ft.r_squared;
        _par_got_f(r2);
        return 0;
    }
    if (kind == 3) {
        var h: PmnHistogramData = v;
        _par_got_words(h.edges, h.nedges, 0);
        _par_got_words(h.counts, h.ncounts, 1);
        _par_got_i(h.total);
        return 0;
    }
    var cm: PmnCorrelationMatrix = v;
    _par_got_words(cm.values, cm.nvalues, 0);
    _par_got_i(cm.size);
    _par_got_seq(cm.nlabels);
    for (var j = 0; j < cm.nlabels; j = j + 1) {
        _par_got_text(load64(cm.labels + j * 16), load64(cm.labels + j * 16 + 8));
    }
    return 0;
}

# The kind of a shape name at fp[0, fl) after a prefix of pre bytes, or -1.
fn _par_so_kind(fp, fl, pre): i64 {
    var p = fp + pre;
    var n = fl - pre;
    if (n == 17 && memeq(p, "DistributionCurve", 17) == 1) { return 0; }
    if (n == 9 && memeq(p, "McmcTrace", 9) == 1) { return 1; }
    if (n == 13 && memeq(p, "RegressionFit", 13) == 1) { return 2; }
    if (n == 13 && memeq(p, "HistogramData", 13) == 1) { return 3; }
    if (n == 17 && memeq(p, "CorrelationMatrix", 17) == 1) { return 4; }
    return 0 - 1;
}

fn _par_so_drop(kind, v): i64 {
    if (kind == 0) { return PmnDistributionCurve_drop(v); }
    if (kind == 1) { return PmnMcmcTrace_drop(v); }
    if (kind == 2) { return PmnRegressionFit_drop(v); }
    if (kind == 3) { return PmnHistogramData_drop(v); }
    return PmnCorrelationMatrix_drop(v);
}

# The codec, Debug and PartialEq calls by kind.
fn _par_so_to_json(kind, v, sb): i64 {
    if (kind == 0) {
        var a: PmnDistributionCurve = v;
        return a.to_json(sb);
    }
    if (kind == 1) {
        var b: PmnMcmcTrace = v;
        return b.to_json(sb);
    }
    if (kind == 2) {
        var c: PmnRegressionFit = v;
        return c.to_json(sb);
    }
    if (kind == 3) {
        var d: PmnHistogramData = v;
        return d.to_json(sb);
    }
    var e: PmnCorrelationMatrix = v;
    return e.to_json(sb);
}

fn _par_so_debug(kind, v, sb, alt): i64 {
    if (kind == 0) {
        var a: PmnDistributionCurve = v;
        return a.debug(sb, alt);
    }
    if (kind == 1) {
        var b: PmnMcmcTrace = v;
        return b.debug(sb, alt);
    }
    if (kind == 2) {
        var c: PmnRegressionFit = v;
        return c.debug(sb, alt);
    }
    if (kind == 3) {
        var d: PmnHistogramData = v;
        return d.debug(sb, alt);
    }
    var e: PmnCorrelationMatrix = v;
    return e.debug(sb, alt);
}

fn _par_so_from_json(kind, v, doc, n): i64 {
    if (kind == 0) { return PmnDistributionCurve_from_json(v, doc, n); }
    if (kind == 1) { return PmnMcmcTrace_from_json(v, doc, n); }
    if (kind == 2) { return PmnRegressionFit_from_json(v, doc, n); }
    if (kind == 3) { return PmnHistogramData_from_json(v, doc, n); }
    return PmnCorrelationMatrix_from_json(v, doc, n);
}

fn _par_so_eq(kind, a, b): i64 {
    if (kind == 0) { return PmnDistributionCurve_eq(a, b); }
    if (kind == 1) { return PmnMcmcTrace_eq(a, b); }
    if (kind == 2) { return PmnRegressionFit_eq(a, b); }
    if (kind == 3) { return PmnHistogramData_eq(a, b); }
    return PmnCorrelationMatrix_eq(a, b);
}

# soorat rows: from_data (the data, n_bins) and each shape's ::eq (two values' tokens).
fn _par_soorat(fp, fl): i64 {
    var sa[80];
    var sb2[80];
    if (_par_eq(fp, fl, "HistogramData::from_data") == 1) {
        var nn = 0;
        var nk = 0;
        var d = _par_so_vec(0, &nn, &nk);
        if (d == 0 || nk + 1 != _par_in_n) { return 0 - 1; }
        var h: PmnHistogramData;
        var e = PmnHistogramData_from_data(&h, d, nn, _par_in(nk));
        if (e != PMN_ERR_NONE) {
            _par_got_err(e);
            return 1;
        }
        _par_got_shape(3, &h);
        var hd = PmnHistogramData_drop(&h);
        return 1;
    }
    var kind = 0 - 1;
    if (fl > 4 && memeq(fp + fl - 4, "::eq", 4) == 1) { kind = _par_so_kind(fp, fl - 4, 0); }
    if (kind < 0) { return 0; }
    var k = _par_so_from_toks(kind, 0, &sa);
    if (k < 0) { return 0 - 1; }
    var k2 = _par_so_from_toks(kind, k, &sb2);
    if (k2 != _par_in_n) { return 0 - 1; }
    _par_got_i(_par_so_eq(kind, &sa, &sb2));
    var d1 = _par_so_drop(kind, &sa);
    var d2 = _par_so_drop(kind, &sb2);
    return 1;
}

# json::<shape> rows (M7 part a): the decoded value's codec tokens, or the error.
fn _par_json_shape(kind): i64 {
    var n = 0;
    var doc = _par_in_bytes(0, &n);
    if (doc == 0) { return 0 - 1; }
    var v[80];
    var e = _par_so_from_json(kind, &v, doc, n);
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    _par_got_shape(kind, &v);
    var d = _par_so_drop(kind, &v);
    return 1;
}

# ── `ai` rows (M7 part b): src/ai.cyr. A column is `s:name`, then its `v:` slice.

# The columns from token k on, to the row's end, into fresh records (32 bytes each): the records, their count at np;
# 0 on a malformed token.
fn _par_ai_cols(k0, np): i64 {
    var nc = 0;
    var k = k0;
    while (k < _par_in_n) {
        if (load64(_par_in_k + k * 8) != 115 || k + 1 >= _par_in_n) { return 0; }
        var n = _par_in(k + 1);
        if (n < 0 || k + 1 + n >= _par_in_n + 1) { return 0; }
        k = k + 2 + n;
        nc = nc + 1;
    }
    var recs = alloc(nc * 32 + 8);
    if (recs == 0) { return 0; }
    k = k0;
    for (var c = 0; c < nc; c = c + 1) {
        var ln = 0;
        var lp = _par_in_bytes_copy(k, &ln);
        var vn = 0;
        var vk = 0;
        var vp = _par_so_vec(k + 1, &vn, &vk);
        if (lp == 0 || vp == 0) { return 0; }
        store64(recs + c * 32, lp);
        store64(recs + c * 32 + 8, ln);
        store64(recs + c * 32 + 16, vp);
        store64(recs + c * 32 + 24, vn);
        k = vk;
    }
    store64(np, nc);
    return recs;
}

# Appends a QueryResult's tokens: the answer, the operation, then `v:n` and each value's key and f64.
fn _par_got_query(r: *PmnQueryResult): i64 {
    _par_got_text(r.answer, r.nanswer);
    _par_got_text(r.operation, r.noperation);
    _par_got_seq(r.nvalues);
    for (var i = 0; i < r.nvalues; i = i + 1) {
        _par_got_text(load64(r.values + i * 24), load64(r.values + i * 24 + 8));
        _par_got_f(load64(r.values + i * 24 + 16));
    }
    return 0;
}

# The recorded-response transport: ctx holds the reply's status, body and length, then a flag set when called and
# copies of the URL and body it was handed.
fn _par_ai_transport(ctx, url, nurl, body, nbody, resp): i64 {
    store64(ctx + 24, 1);
    var cu = alloc(nurl + 8);
    var cb = alloc(nbody + 8);
    if (cu == 0 || cb == 0) { return PMN_ERR_OUT_OF_MEMORY; }
    if (nurl > 0) { memcpy(cu, url, nurl); }
    if (nbody > 0) { memcpy(cb, body, nbody); }
    store64(ctx + 32, cu);
    store64(ctx + 40, nurl);
    store64(ctx + 48, cb);
    store64(ctx + 56, nbody);
    store64(resp, load64(ctx));
    store64(resp + 8, load64(ctx + 8));
    store64(resp + 16, load64(ctx + 16));
    return PMN_ERR_NONE;
}

# A QueryResult from its codec tokens at k0 (the answer, the operation, `v:n` and each key and value) into r: the
# next token, or -1. The caller drops r.
fn _par_qr_from_toks(k0, r: *PmnQueryResult): i64 {
    if (k0 + 2 >= _par_in_n) { return 0 - 1; }
    var an = 0;
    var ap = _par_in_bytes_copy(k0, &an);
    var on = 0;
    var op = _par_in_bytes_copy(k0 + 1, &on);
    if (ap == 0 || op == 0 || load64(_par_in_k + (k0 + 2) * 8) != 118) { return 0 - 1; }
    var nv = _par_in(k0 + 2);
    if (nv < 0 || k0 + 2 + 2 * nv >= _par_in_n + 1) { return 0 - 1; }
    var recs = alloc(nv * 24 + 8);
    for (var i = 0; i < nv; i = i + 1) {
        var kn = 0;
        var kp = _par_in_bytes_copy(k0 + 3 + 2 * i, &kn);
        if (kp == 0) { return 0 - 1; }
        store64(recs + i * 24, kp);
        store64(recs + i * 24 + 8, kn);
        store64(recs + i * 24 + 16, _par_in(k0 + 4 + 2 * i));
    }
    if (PmnQueryResult_new(r, ap, an, op, on, recs, nv) != PMN_ERR_NONE) { return 0 - 1; }
    return k0 + 3 + 2 * nv;
}

# json::QueryResult rows: the decoded result's tokens, or the error.
fn _par_json_qr(): i64 {
    var n = 0;
    var doc = _par_in_bytes(0, &n);
    if (doc == 0) { return 0 - 1; }
    var r: PmnQueryResult;
    var e = PmnQueryResult_from_json(&r, doc, n);
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    _par_got_query(&r);
    var d = PmnQueryResult_drop(&r);
    return 1;
}

fn _par_ai(fp, fl): i64 {
    var sb = str_builder_new();
    if (sb == 0) { return 0 - 1; }
    if (_par_eq(fp, fl, "ai::fmt_fixed") == 1) {
        if (_par_in_n != 2) { return 0 - 1; }
        var x: f64 = _par_in(0);
        if (_pmn_ai_w_fixed(sb, x, _par_in(1)) != PMN_ERR_NONE) { return 0 - 1; }
        _par_got_text(load64(sb), load64(sb + 8));
        return 1;
    }
    if (_par_eq(fp, fl, "ai::fmt_display") == 1) {
        if (_par_in_n != 1) { return 0 - 1; }
        var y: f64 = _par_in(0);
        if (_pmn_ai_w_display(sb, y) != PMN_ERR_NONE) { return 0 - 1; }
        _par_got_text(load64(sb), load64(sb + 8));
        return 1;
    }
    var nc = 0;
    if (_par_eq(fp, fl, "ai::build_data_summary") == 1) {
        var c0 = _par_ai_cols(0, &nc);
        if (c0 == 0 && _par_in_n > 0) { return 0 - 1; }
        if (_pmn_ai_summary(sb, c0, nc) != PMN_ERR_NONE) { return 0 - 1; }
        _par_got_text(load64(sb), load64(sb + 8));
        return 1;
    }
    if (_par_eq(fp, fl, "ai::request_body") == 1) {
        var mn = 0;
        var mp = _par_in_bytes_copy(0, &mn);
        var qn = 0;
        var qp = _par_in_bytes_copy(1, &qn);
        var c1 = _par_ai_cols(2, &nc);
        if (mp == 0 || qp == 0 || c1 == 0) { return 0 - 1; }
        if (_pmn_ai_request_body(sb, mp, mn, c1, nc, qp, qn) != PMN_ERR_NONE) { return 0 - 1; }
        _par_got_text(load64(sb), load64(sb + 8));
        return 1;
    }
    var r: PmnQueryResult;
    if (_par_eq(fp, fl, "StatQuery::query") == 1) {
        var bn = 0;
        var bp = _par_in_bytes_copy(0, &bn);
        var m2 = 0;
        var mp2 = _par_in_bytes_copy(1, &m2);
        var q2 = 0;
        var qp2 = _par_in_bytes_copy(2, &q2);
        var rn = 0;
        var rp = _par_in_bytes_copy(4, &rn);
        if (bp == 0 || mp2 == 0 || qp2 == 0 || rp == 0) { return 0 - 1; }
        var c2 = 0;
        if (_par_in_n > 5) {
            c2 = _par_ai_cols(5, &nc);
            if (c2 == 0) { return 0 - 1; }
        }
        var ctx[64];
        store64(&ctx, _par_in(3));
        store64(&ctx + 8, rp);
        store64(&ctx + 16, rn);
        store64(&ctx + 24, 0);
        var sq: PmnStatQuery;
        if (PmnStatQuery_new(&sq, bp, bn, mp2, m2, &_par_ai_transport, &ctx) != PMN_ERR_NONE) {
            return 0 - 1;
        }
        var e = sq.query(c2, nc, qp2, q2, &r);
        if (load64(&ctx + 24) == 1) {
            _par_got_text(load64(&ctx + 32), load64(&ctx + 40));
            _par_got_text(load64(&ctx + 48), load64(&ctx + 56));
        }
        if (e != PMN_ERR_NONE) {
            _par_got_err(e);
        } else {
            _par_got_query(&r);
            var dq = PmnQueryResult_drop(&r);
        }
        var ds = PmnStatQuery_drop(&sq);
        return 1;
    }
    if (_par_eq(fp, fl, "ai::execute_tool") == 1) {
        var tn = 0;
        var tp = _par_in_bytes_copy(0, &tn);
        var an = 0;
        var ap = _par_in_bytes_copy(1, &an);
        var c3 = _par_ai_cols(2, &nc);
        if (tp == 0 || ap == 0 || c3 == 0) { return 0 - 1; }
        var et = _pmn_ai_execute_tool(&r, tp, tn, ap, an, c3, nc);
        if (et != PMN_ERR_NONE) {
            _par_got_err(et);
            return 1;
        }
        _par_got_query(&r);
        var dt = PmnQueryResult_drop(&r);
        return 1;
    }
    return 0;
}

fn _par_dispatch(mp, ml, fp, fl): i64 {
    _par_got_n = 0;
    if (_par_eq(mp, ml, "ai") == 1) { return _par_ai(fp, fl); }
    if (_par_eq(mp, ml, "bayesian") == 1) { return _par_bayesian(fp, fl); }
    if (_par_eq(mp, ml, "bridge") == 1) { return _par_bridge(fp, fl); }
    if (_par_eq(mp, ml, "combinatorics") == 1) { return _par_combinatorics(fp, fl); }
    if (_par_eq(mp, ml, "constants") == 1) { return _par_constants(fp, fl); }
    if (_par_eq(mp, ml, "debug") == 1) { return _par_debug(fp, fl); }
    if (_par_eq(mp, ml, "descriptive") == 1) { return _par_descriptive(fp, fl); }
    if (_par_eq(mp, ml, "dist") == 1) { return _par_dist(fp, fl); }
    if (_par_eq(mp, ml, "fmt") == 1) { return _par_fmt(fp, fl); }
    if (_par_eq(mp, ml, "hypothesis") == 1) { return _par_hypothesis(fp, fl); }
    if (_par_eq(mp, ml, "json") == 1) { return _par_json(fp, fl); }
    if (_par_eq(mp, ml, "linalg") == 1) { return _par_linalg(fp, fl); }
    if (_par_eq(mp, ml, "markov") == 1) { return _par_markov(fp, fl); }
    if (_par_eq(mp, ml, "monte_carlo") == 1) { return _par_monte_carlo(fp, fl); }
    if (_par_eq(mp, ml, "math") == 1) { return _par_math(fp, fl); }
    if (_par_eq(mp, ml, "regression") == 1) { return _par_regression(fp, fl); }
    if (_par_eq(mp, ml, "rng") == 1) { return _par_rng(fp, fl); }
    if (_par_eq(mp, ml, "soorat") == 1) { return _par_soorat(fp, fl); }
    if (_par_eq(mp, ml, "special") == 1) { return _par_special(fp, fl); }
    if (_par_eq(mp, ml, "timeseries") == 1) { return _par_timeseries(fp, fl); }
    return 0;
}

# Shadow comparisons, never gated: the same golden rows through another Cyrius candidate. Each row's own outputs are
# folded into its digest first (a pending row has none), before a shadow replaces them.
# - the native exp, ln, atan and log2 builtins: x87 on x86_64, so their bits differ between targets (digests 13–16).
#   M0 step 8 dispatched the polyfill forms instead; M1 dispatches the correctly rounded functions;
# - the stdlib min / max, to show where their NaN semantics differ from Rust's.
fn _par_shadow_f(name, cls, r: f64) {
    _par_got_n = 0;
    _par_got_f(r);
    _par_shadow_record(name, cls);
    return 0;
}

fn _par_shadows(mp, ml, fp, fl, cls) {
    if (_par_eq(mp, ml, "constants") == 1) {
        if (_par_got_n > 0) { _par_dg_fold(12); }
        return 0;
    }
    if (_par_eq(mp, ml, "math") != 1) { return 0; }
    if (_par_got_n > 0) { _par_dg_fold(_par_dg_slot(fp, fl)); }
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "f64::exp") == 1) {
        var r: f64 = f64_exp(x);
        _par_shadow_f("f64::exp ~ f64_exp (native)", cls, r);
        _par_dg_fold(13);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::ln") == 1) {
        var r: f64 = f64_ln(x);
        _par_shadow_f("f64::ln ~ f64_ln (native)", cls, r);
        _par_dg_fold(14);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::atan") == 1) {
        var r: f64 = f64_atan(x);
        _par_shadow_f("f64::atan ~ f64_atan (native)", cls, r);
        _par_dg_fold(15);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::log2") == 1) {
        var r: f64 = f64_log2(x);
        _par_shadow_f("f64::log2 ~ f64_log2 (native)", cls, r);
        _par_dg_fold(16);
        return 0;
    }
    if (_par_in_n < 2) { return 0; }
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "f64::max") == 1) {
        var r: f64 = f64_max(x, y);
        _par_shadow_f("f64::max ~ f64_max", cls, r);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::min") == 1) {
        var r: f64 = f64_min(x, y);
        _par_shadow_f("f64::min ~ f64_min", cls, r);
        return 0;
    }
    return 0;
}

# The class-C bound for a function, in ulps; -1 while none is set (the rows are measured). Set in M0 step 8
# (port-parity §5), before each function's first gated comparison, and never raised to make a row pass:
# - 2 for the interim counterparts of the primitives: glibc and each counterpart are within about 1 ulp of the
#   correctly rounded value, so two implementations can differ by 2 (the siblings' rule for primitives). On a row
#   with a correction (math.cr.tsv) the reference is the correctly rounded value, so a pass there means within 2 ulp
#   of it: "accepted (ADR 9)" is that weaker statement until M1;
# - 0 for cbrt: Rust's (compiler_builtins) and ganita's are both correctly rounded;
# - powf stays measured: ganita's open pow(−1, |y| > 2^64) defect gives +inf against Rust's 1, and no ADR accepts a
#   counterpart that M1 replaces.
# M1 dispatches the correctly rounded functions, and each one's bound becomes 0 (ADR 009): exp, ln, exp_m1, powf,
# sin, cos and atan at part b1, ln_1p at b2, tan at b3, log2 at b4: every one is 0.
#must_use
fn _par_c_bound(fp, fl): i64 {
    if (_par_eq(fp, fl, "f64::cbrt") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::exp") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::ln") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::exp_m1") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::powf") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::sin") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::cos") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::atan") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::ln_1p") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::tan") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::log2") == 1) { return 0; }
    if (_par_eq(fp, fl, "combinatorics::stirling_approx") == 1) { return 0; }   # powf, correctly rounded (part e2)
    if (_par_eq(fp, fl, "bridge::observation_error_to_likelihood") == 1) { return 0; }   # exp (part e3)
    if (_par_eq(fp, fl, "bridge::learning_trials_to_power_law") == 1) { return 0; }      # ln and exp
    if (_par_eq(fp, fl, "bridge::response_times_to_hick_params") == 1) { return 0; }     # log2
    if (_par_eq(fp, fl, "math::erf") == 1) { return 0; }          # T0 on the correctly rounded exp (M2 part a1)
    if (_par_eq(fp, fl, "math::erfc") == 1) { return 0; }
    if (_par_eq(fp, fl, "math::normal_cdf") == 1) { return 1; }   # T1 (part b2): ADR 009's ≤ 1 ulp
    if (_par_eq(fp, fl, "math::normal_sf") == 1) { return 1; }
    if (_par_eq(fp, fl, "math::ln_gamma") == 1) { return 2; }    # T1 (part b3): ADR 009's ≤ 2 ulp (mixed for x < 0)
    if (_par_eq(fp, fl, "math::stirling_error") == 1) { return 0; }
    if (_par_eq(fp, fl, "math::bd0") == 1) { return 0; }         # ln_1p
    if (_par_eq(fp, fl, "math::ln_gamma_kernel") == 1) { return 0; }
    if (_par_eq(fp, fl, "math::ln_beta") == 1) { return 0; }
    if (_par_eq(fp, fl, "math::gamma_inc") == 1) { return _par_c_gamma_bound(); }   # T1 (part b4)
    if (_par_eq(fp, fl, "math::regularized_lower_incomplete_gamma") == 1) { return 0; }
    if (_par_eq(fp, fl, "math::regularized_upper_incomplete_gamma") == 1) { return 0; }
    if (_par_eq(fp, fl, "math::beta_inc") == 1) { return _par_c_beta_bound(); }     # T1 (part b5)
    if (_par_eq(fp, fl, "math::regularized_incomplete_beta") == 1) { return 0; }
    if (_par_eq(fp, fl, "KernelDensity::evaluate_grid") == 1) { return 0; }   # exp and powf (M4 part a2)
    if (_par_eq(fp, fl, "descriptive::pca") == 1) { return 0; }                # atan, cos, sin (part a3)
    if (_par_eq(fp, fl, "linalg::eigen_symmetric") == 1) { return 0; }
    if (_par_eq(fp, fl, "hypothesis::t_test_one_sample") == 1) { return 0; }   # downstream of the T1 functions (b1)
    if (_par_eq(fp, fl, "hypothesis::t_test_two_sample") == 1) { return 0; }
    if (_par_eq(fp, fl, "hypothesis::chi_squared_test") == 1) { return 0; }
    if (_par_eq(fp, fl, "hypothesis::one_way_anova") == 1) { return 0; }
    if (_par_eq(fp, fl, "hypothesis::ks_two_sample") == 1) { return 0; }
    if (_par_eq(fp, fl, "hypothesis::ks_one_sample") == 1) { return 0; }
    if (_par_eq(fp, fl, "hypothesis::t_quantile") == 1) { return 0; }        # downstream of T1 (part b2)
    if (_par_eq(fp, fl, "hypothesis::z_quantile") == 1) { return 0; }
    if (_par_eq(fp, fl, "hypothesis::ci_mean") == 1) { return 0; }
    if (_par_eq(fp, fl, "hypothesis::ci_two_means") == 1) { return 0; }
    if (_par_eq(fp, fl, "hypothesis::ci_proportion") == 1) { return 0; }
    if (_par_eq(fp, fl, "bayesian::naive_bayes_classify") == 1) { return 0; }    # ln (M5 part c)
    if (_par_eq(fp, fl, "HiddenMarkovModel::forward_log_likelihood") == 1) { return 0; }   # ln (M6 part a)
    if (_par_eq(fp, fl, "HiddenMarkovModel::viterbi") == 1) { return 0; }
    if (_par_eq(fp, fl, "monte_carlo::monte_carlo_integrate") == 1) { return 0; }   # sin and exp (M6 part b)
    if (_par_eq(fp, fl, "monte_carlo::metropolis_hastings") == 1) { return 0; }     # Box–Muller's ln and cos, exp
    if (_par_eq(fp, fl, "monte_carlo::gibbs_sampling") == 1) { return 0; }
    if (_par_eq(fp, fl, "ai::execute_tool") == 1) { return 0; }    # the t-test's T1 p-value (M7 part b)
    if (_par_eq(fp, fl, "regression::logistic_regression") == 1) { return 0; }   # the sigmoid's exp (M5 part a)
    if (_par_eq(fp, fl, "regression::predict_logistic_proba") == 1) { return 0; }
    if (_par_eq(fp, fl, "regression::predict_logistic_class") == 1) { return 0; }
    if (_par_eq(fp, fl, "Normal::pdf") == 1) { return 0; }      # exp (M3 part a1)
    if (_par_eq(fp, fl, "Normal::cdf") == 1) { return 0; }      # downstream of the T1 Φ (ADR 009 as amended)
    if (_par_eq(fp, fl, "Normal::sample") == 1) { return 0; }   # Box–Muller: ln and cos
    if (_par_eq(fp, fl, "standard_normal") == 1) { return 0; }
    if (_par_eq(fp, fl, "Exponential::pdf") == 1) { return 0; }      # exp (part a2)
    if (_par_eq(fp, fl, "Exponential::cdf") == 1) { return 0; }      # exp_m1
    if (_par_eq(fp, fl, "Exponential::sample") == 1) { return 0; }   # ln
    if (_par_eq(fp, fl, "Cauchy::cdf") == 1) { return 0; }           # atan (part a3)
    if (_par_eq(fp, fl, "Cauchy::sample") == 1) { return 0; }        # tan
    if (_par_eq(fp, fl, "Weibull::pdf") == 1) { return 0; }          # powf and exp
    if (_par_eq(fp, fl, "Weibull::cdf") == 1) { return 0; }          # powf and exp_m1
    if (_par_eq(fp, fl, "Weibull::mean") == 1) { return 0; }         # downstream of the T1 lnΓ (ADR 009 as amended)
    if (_par_eq(fp, fl, "Weibull::variance") == 1) { return 0; }
    if (_par_eq(fp, fl, "Weibull::sample") == 1) { return 0; }       # ln and powf
    if (_par_eq(fp, fl, "Gamma::pdf") == 1) { return 0; }            # ln and exp, downstream of the T1 lnΓ (part b1)
    if (_par_eq(fp, fl, "Gamma::cdf") == 1) { return 0; }            # downstream of the T1 incomplete gamma
    if (_par_eq(fp, fl, "Gamma::sample") == 1) { return 0; }         # Marsaglia–Tsang: ln, cos and powf
    if (_par_eq(fp, fl, "ChiSquared::pdf") == 1) { return 0; }
    if (_par_eq(fp, fl, "ChiSquared::cdf") == 1) { return 0; }
    if (_par_eq(fp, fl, "ChiSquared::sample") == 1) { return 0; }
    if (_par_eq(fp, fl, "sample_gamma_standard") == 1) { return 0; }
    if (_par_eq(fp, fl, "Beta::pdf") == 1) { return 0; }             # ln, ln_1p and exp; ln B on the T1 lnΓ (part b2)
    if (_par_eq(fp, fl, "Beta::cdf") == 1) { return 0; }             # downstream of the T1 incomplete beta
    if (_par_eq(fp, fl, "Beta::sample") == 1) { return 0; }          # Marsaglia–Tsang
    if (_par_eq(fp, fl, "StudentT::pdf") == 1) { return 0; }
    if (_par_eq(fp, fl, "StudentT::cdf") == 1) { return 0; }
    if (_par_eq(fp, fl, "StudentT::sample") == 1) { return 0; }
    if (_par_eq(fp, fl, "FDistribution::pdf") == 1) { return 0; }
    if (_par_eq(fp, fl, "FDistribution::cdf") == 1) { return 0; }
    if (_par_eq(fp, fl, "FDistribution::sample") == 1) { return 0; }
    if (_par_eq(fp, fl, "student_t_two_tailed") == 1) { return 0; }
    if (_par_eq(fp, fl, "student_t_cdf") == 1) { return 0; }
    if (_par_eq(fp, fl, "f_cdf_sf") == 1) { return 0; }
    if (_par_eq(fp, fl, "Poisson::pdf") == 1) { return 0; }          # ln and exp; the kernel on the T1 lnΓ (part c1)
    if (_par_eq(fp, fl, "Poisson::cdf") == 1) { return 0; }          # downstream of the T1 incomplete gamma
    if (_par_eq(fp, fl, "Poisson::sample") == 1) { return 0; }       # Knuth's exp, PTRS's ln and kernel
    if (_par_eq(fp, fl, "sample_poisson_ptrs") == 1) { return 0; }
    if (_par_eq(fp, fl, "Binomial::pdf") == 1) { return 0; }         # ln, ln_1p and exp; Stirling on T1 lnΓ (c2)
    if (_par_eq(fp, fl, "Binomial::cdf") == 1) { return 0; }         # downstream of the T1 incomplete beta
    if (_par_eq(fp, fl, "Binomial::sample") == 1) { return 0; }      # Marsaglia–Tsang
    if (_par_eq(fp, fl, "MultivariateNormal::new") == 1) { return 0; }       # hisab's factor and ln (d2)
    if (_par_eq(fp, fl, "MultivariateNormal::log_pdf") == 1) { return 0; }   # hisab's solve and ln
    if (_par_eq(fp, fl, "MultivariateNormal::pdf") == 1) { return 0; }       # and exp
    if (_par_eq(fp, fl, "MultivariateNormal::sample") == 1) { return 0; }    # Box–Muller's ln, cos and sin
    return 0 - 1;
}

# gamma_inc's region by its shape a (T1, M2 part b4; ADR 009): 1 on the committed domain, a in [1e-3, 1e5] with x > 0;
# 2 for the other shapes T1 computes, up to 1e9; 0 for the edges (a NaN, a ≤ 0, x ≤ 0, an infinite argument) and for
# a > 1e9, where Rust's Wilson–Hilferty form stays, on T1's Φ.
#must_use
fn _par_c_gamma_region(): i64 {
    if (_par_in_n != 2) { return 0; }
    var a: f64 = _par_in(0);
    var x: f64 = _par_in(1);
    var wh: f64 = _PMN_MATH_GAMMA_WILSON_HILFERTY_SHAPE;
    var inf: f64 = _PMN_F64_INFINITY;
    if (a > 0.0 && a <= wh && x > 0.0 && x < inf) {
        var lo: f64 = 0.001;
        var hi: f64 = 100000.0;
        if (a >= lo && a <= hi) { return 1; }
        return 2;
    }
    return 0;
}

# gamma_inc's bound: ADR 009's 4 ulp on the committed domain; elsewhere 0, which `_par_c_vs_rust` widens to 1.3.0's
# own error outside the domain.
#must_use
fn _par_c_gamma_bound(): i64 {
    if (_par_c_gamma_region() == 1) { return 4; }
    return 0;
}

# beta_inc's region by its shapes (T1, M2 part b5; ADR 009): 1 on the committed domain, a and b in [1e-3, 1e5] with
# x > 0 and y > 0; 2 for the other inputs T1 computes, finite shapes up to 1e9; 0 for the edges (a NaN, a shape ≤ 0,
# x ≤ 0, y ≤ 0), an infinite shape, and a shape past 1e9, where Rust's form stays (on T1's lnΓ).
#must_use
fn _par_c_beta_region(): i64 {
    if (_par_in_n != 4) { return 0; }
    var a: f64 = _par_in(0);
    var b: f64 = _par_in(1);
    var x: f64 = _par_in(2);
    var y: f64 = _par_in(3);
    var big: f64 = 1000000000.0;
    if (a > 0.0 && a <= big && b > 0.0 && b <= big && x > 0.0 && y > 0.0) {
        var lo: f64 = 0.001;
        var hi: f64 = 100000.0;
        if (a >= lo && a <= hi && b >= lo && b <= hi) { return 1; }
        return 2;
    }
    return 0;
}

# beta_inc's bound: ADR 009's 8 ulp on the committed domain; elsewhere 0, which `_par_c_vs_rust` widens to 1.3.0's own
# error outside the domain.
#must_use
fn _par_c_beta_bound(): i64 {
    if (_par_c_beta_region() == 1) { return 8; }
    return 0;
}

# 1 for a row outside its T1 function's committed domain, where ADR 009 asks only that no row be less accurate than
# Rust: gamma_inc for a < 1e-3 or 1e5 < a ≤ 1e9 (M2 part b4); beta_inc for a shape below 1e-3, or in (1e5, 1e9]
# (part b5).
#must_use
fn _par_c_vs_rust(fp, fl): i64 {
    if (_par_eq(fp, fl, "math::gamma_inc") == 1 && _par_c_gamma_region() == 2) { return 1; }
    if (_par_eq(fp, fl, "math::beta_inc") == 1 && _par_c_beta_region() == 2) { return 1; }
    return 0;
}

# 1 when the current row's class-C bound is ADR 009's mixed one, ulps of max(|want|, 1): lnΓ for x < 0, where the
# relative error is unbounded at the zeros of lnΓ (from M2 part b3).
#must_use
fn _par_c_mixed(fp, fl): i64 {
    if (_par_eq(fp, fl, "math::ln_gamma") != 1 || _par_in_n != 1) { return 0; }
    var x: f64 = _par_in(0);
    if (x < 0.0) { return 1; }
    return 0;
}

# The ADR accepting a divergent row (function and raw input field), or 0. The correctly rounded rows are ADR 009's,
# accepted by parity_core itself; ADR 007's mapped rows arrive with their modules.
#must_use
fn _par_accepted(fp, fl, ip, il): i64 {
    return 0;
}

# 1 for an ADR whose accepted rows are counted but not printed row by row. None yet.
#must_use
fn _par_accepted_quiet(adr): i64 {
    return 0;
}

# Module-specific summary lines after a module's report: the cross-target digests (M0 step 8). Then the pool's check
# (port plan §8.5): a module whose rows leave a work-table slot claimed fails.
fn _par_module_done(mp, ml) {
    var leak = _pmn_scratch_claimed();
    if (leak != 0) {
        print("  FAIL: ", 8);
        fmt_int(leak);
        println(" work-table pool slots still claimed after the module");
    }
    if (_par_eq(mp, ml, "constants") == 1) { _par_dg_print(12, "const"); }
    if (_par_eq(mp, ml, "math") != 1) { return leak; }
    _par_dg_print(0, "f64::exp (_pmn_km_cr_exp)");
    _par_dg_print(1, "f64::ln (_pmn_km_cr_ln)");
    _par_dg_print(2, "f64::ln_1p (_pmn_cr_log1p)");
    _par_dg_print(3, "f64::exp_m1 (_pmn_km_cr_expm1)");
    _par_dg_print(4, "f64::powf (_pmn_km_cr_pow)");
    _par_dg_print(5, "f64::sin (_pmn_km_cr_sin)");
    _par_dg_print(6, "f64::cos (_pmn_km_cr_cos)");
    _par_dg_print(7, "f64::tan (_pmn_cr_tan)");
    _par_dg_print(8, "f64::atan (_pmn_km_cr_atan2)");
    _par_dg_print(9, "f64::log2 (_pmn_cr_log2)");
    _par_dg_print(10, "f64::cbrt (ganita_f64_cbrt)");
    _par_dg_print(11, "class A/B math rows");
    _par_dg_print(13, "shadow: f64_exp (native)");
    _par_dg_print(14, "shadow: f64_ln (native)");
    _par_dg_print(15, "shadow: f64_atan (native)");
    _par_dg_print(16, "shadow: f64_log2 (native)");
    return leak;
}

# Every module is replayed here.
#must_use
fn _par_skip(mp, ml): i64 {
    return 0;
}

var exit_code = _par_main();
sys_exit_group(exit_code);
