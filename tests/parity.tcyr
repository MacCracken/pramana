    _par_got_f(p);
    return 1;
}

# The MultivariateNormal rows' buffers (M3 part d2): the mean, the covariance and a point or a draw, 4,096 f64s each.
var _par_mv_m = 0;
var _par_mv_c = 0;
var _par_mv_x = 0;
var _PAR_MV_CAP = 4096;

# json::MultivariateNormal rows (M3 part d2): PmnMultivariateNormal_from_json, then its mean and covariance as the
# codec's tokens (`v:d` and the mean, `v:d` and each row's `v:d` and entries); dropped after.
fn _par_json_mvn(): i64 {
    var n = 0;
    var doc = _par_in_bytes(0, &n);
    if (doc == 0) { return 0 - 1; }
    var m: PmnMultivariateNormal;
    var e = PmnMultivariateNormal_from_json(&m, doc, n);
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    var d = m.dim();
    var mu = m.mean_vec();
    var cv = m.covariance_matrix();
    _par_got_seq(d);
    for (var k = 0; k < d; k = k + 1) { _par_got_f(load64(mu + k * 8)); }
    _par_got_seq(d);
    for (var r = 0; r < d; r = r + 1) {
        _par_got_seq(d);
        for (var c = 0; c < d; c = c + 1) { _par_got_f(load64(cv + (r * d + c) * 8)); }
    }
    var e1 = PmnMultivariateNormal_drop(&m);
    return 1;
}

# A MultivariateNormal from the codec's tokens at token k (as _par_json_mvn emits them), into m: the tokens read, or
# -1 when they don't hold a square case the constructor accepts. The caller drops m.
fn _par_mvn_codec_new(m, k): i64 {
    if (_par_mv_m == 0) {
        _par_mv_m = alloc(_PAR_MV_CAP * 8);
        _par_mv_c = alloc(_PAR_MV_CAP * 8);
        _par_mv_x = alloc(_PAR_MV_CAP * 8);
        if (_par_mv_m == 0 || _par_mv_c == 0 || _par_mv_x == 0) { return 0 - 1; }
    }
    var d = _par_in(k);
    if (d <= 0 || d > 64 || _par_in_f64s(k, _par_mv_m) != d || _par_in(k + 1 + d) != d) { return 0 - 1; }
    var at = k + 2 + d;
    for (var r = 0; r < d; r = r + 1) {
        if (_par_in_f64s(at, _par_mv_c + r * d * 8) != d) { return 0 - 1; }
        at = at + 1 + d;
    }
    if (PmnMultivariateNormal_new(m, _par_mv_m, d, _par_mv_c, d, d) != PMN_ERR_NONE) { return 0 - 1; }
    return at - k;
}

# json::PcaResult rows (M4 part a3): the decoded lists, or the error.
fn _par_json_pca(): i64 {
    var n = 0;
    var doc = _par_in_bytes(0, &n);
    if (doc == 0) { return 0 - 1; }
    var r: PmnPcaResult;
    var e = PmnPcaResult_from_json(&r, doc, n);
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    _par_got_pca(&r);
    PmnPcaResult_drop(&r);
    return 1;
}

# json::TestResult (0), AnovaResult (1) and KsResult (2) rows (M4 part b1): the decoded fields, or the error.
fn _par_json_results(which): i64 {
    var n = 0;
    var doc = _par_in_bytes(0, &n);
    if (doc == 0) { return 0 - 1; }
    var e = 0;
    if (which == 0) {
        var tr: PmnTestResult;
        e = PmnTestResult_from_json(&tr, doc, n);
        if (e == PMN_ERR_NONE) {
            _par_got_test(&tr);
            PmnTestResult_drop(&tr);
            return 1;
        }
    } elif (which == 1) {
        var ar: PmnAnovaResult;
        e = PmnAnovaResult_from_json(&ar, doc, n);
        if (e == PMN_ERR_NONE) { return _par_got_anova(&ar); }
    } elif (which == 2) {
        var kr: PmnKsResult;
        e = PmnKsResult_from_json(&kr, doc, n);
        if (e == PMN_ERR_NONE) { return _par_got_ks(&kr); }
    } else {
        var cr: PmnConfidenceInterval;
        e = PmnConfidenceInterval_from_json(&cr, doc, n);
        if (e == PMN_ERR_NONE) { return _par_got_ci(&cr); }
    }
    _par_got_err(e);
    return 1;
}

# json::LinearModel (0), PolynomialModel (1) and LogisticModel (2) rows (M5 part a).
fn _par_json_models(which): i64 {
    var n = 0;
    var doc = _par_in_bytes(0, &n);
    if (doc == 0) { return 0 - 1; }
    var e = 0;
    if (which == 0) {
        var lm: PmnLinearModel;
        e = PmnLinearModel_from_json(&lm, doc, n);
        if (e == PMN_ERR_NONE) { return _par_got_linear(&lm); }
    } elif (which == 1) {
        var pm: PmnPolynomialModel;
        e = PmnPolynomialModel_from_json(&pm, doc, n);
        if (e == PMN_ERR_NONE) {
            _par_got_poly(&pm);
            PmnPolynomialModel_drop(&pm);
            return 1;
        }
    } elif (which == 3) {
        var ar: PmnArimaModel;
        e = PmnArimaModel_from_json(&ar, doc, n);
        if (e == PMN_ERR_NONE) {
            _par_got_arima(&ar);
            PmnArimaModel_drop(&ar);
            return 1;
        }
    } else {
        var gm: PmnLogisticModel;
        e = PmnLogisticModel_from_json(&gm, doc, n);
        if (e == PMN_ERR_NONE) {
            _par_got_logit(&gm);
            PmnLogisticModel_drop(&gm);
            return 1;
        }
    }
    _par_got_err(e);
    return 1;
}

# json::MarkovChain rows (M6 part a): PmnMarkovChain_from_json, then its matrix (nested lists) and state; dropped after.
fn _par_json_chain(): i64 {
    var n = 0;
    var doc = _par_in_bytes(0, &n);
    if (doc == 0) { return 0 - 1; }
    var c: PmnMarkovChain;
    var e = PmnMarkovChain_from_json(&c, doc, n);
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    var k = c.num_states();
    _par_got_mat(c.transition_matrix(), k, k);
    _par_got_i(c.state);
    var e1 = PmnMarkovChain_drop(&c);
    return 1;
}

# json::HiddenMarkovModel rows (M6 part a): the decoded transition, emission (nested lists) and initial distribution.
fn _par_json_hmm(): i64 {
    var n = 0;
    var doc = _par_in_bytes(0, &n);
    if (doc == 0) { return 0 - 1; }
    var h: PmnHiddenMarkovModel;
    var e = PmnHiddenMarkovModel_from_json(&h, doc, n);
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    var k = h.num_states();
    _par_got_mat(h.transition(), k, k);
    _par_got_mat(h.emission(), k, h.num_symbols());
    _par_got_seq(k);
    for (var j = 0; j < k; j = j + 1) { _par_got_f(load64(h.initial() + j * 8)); }
    var e1 = PmnHiddenMarkovModel_drop(&h);
    return 1;
}

# json::BayesianUpdate rows (M5 part c): the decoded fields, or the error.
fn _par_json_bayes(): i64 {
    var n = 0;
    var doc = _par_in_bytes(0, &n);
    if (doc == 0) { return 0 - 1; }
    var u: PmnBayesianUpdate;
    var e = PmnBayesianUpdate_from_json(&u, doc, n);
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    var a: f64 = u.prior;
    var b: f64 = u.likelihood;
    var c: f64 = u.evidence;
    _par_got_f(a);
    _par_got_f(b);
    _par_got_f(c);
    return 1;
}

# json::Kernel rows through the port's reader (M4 part a2).
fn _par_json_kernel(): i64 {
    var n = 0;
    var doc = _par_in_bytes(0, &n);
    if (doc == 0) { return 0 - 1; }
    var k = 0;
    var e = pmn_kernel_from_json(&k, doc, n);
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    if (k == PMN_KERNEL_GAUSSIAN) { _par_got_e("Kernel.Gaussian"); }
    if (k == PMN_KERNEL_EPANECHNIKOV) { _par_got_e("Kernel.Epanechnikov"); }
    if (k == PMN_KERNEL_UNIFORM) { _par_got_e("Kernel.Uniform"); }
    if (k == PMN_KERNEL_TRIANGULAR) { _par_got_e("Kernel.Triangular"); }
    return 1;
}

# json::KernelDensity rows: the data, the bandwidth and the kernel of the decoded value, or the error.
fn _par_json_kde(): i64 {
    var n = 0;
    var doc = _par_in_bytes(0, &n);
    if (doc == 0) { return 0 - 1; }
    var kd: PmnKernelDensity;
    var e = PmnKernelDensity_from_json(&kd, doc, n);
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    var d = kd.len();
    var p = kd.data_ptr();
    _par_got_seq(d);
    for (var k = 0; k < d; k = k + 1) { _par_got_f(load64(p + k * 8)); }
    var h: f64 = kd.bandwidth;
    _par_got_f(h);
    var kn = kd.kernel;
    if (kn == PMN_KERNEL_GAUSSIAN) { _par_got_e("Kernel.Gaussian"); }
    if (kn == PMN_KERNEL_EPANECHNIKOV) { _par_got_e("Kernel.Epanechnikov"); }
    if (kn == PMN_KERNEL_UNIFORM) { _par_got_e("Kernel.Uniform"); }
    if (kn == PMN_KERNEL_TRIANGULAR) { _par_got_e("Kernel.Triangular"); }
    var e1 = PmnKernelDensity_drop(&kd);
    return 1;
}

fn _par_json_value(fp, fl, root): i64 {
    if (_par_eq(fp, fl, "json::Pair") == 1) { return _par_json_pair(root); }
    if (_par_eq(fp, fl, "json::Shapes") == 1) { return _par_json_shapes(root); }
    if (_par_eq(fp, fl, "json::PramanaError") == 1) { return _par_json_error(root); }
    if (fl <= 6) { return 0 - 2; }
    var code = _par_json_code(fp + 6, fl - 6);           # the T of json::T
    if (code < 0) { return 0 - 2; }
    return _par_json_emit(code, root);
}

fn _par_json(fp, fl): i64 {
    if (fl > 13 && memeq(fp, "json::write::", 13) == 1) { return _par_json_write(fp, fl); }
    if (_par_eq(fp, fl, "json::PramanaError::code") == 1) { return _par_json_err_code(); }
    if (_par_eq(fp, fl, "json::SimpleRng") == 1) { return _par_json_simple_rng(); }
    if (_par_eq(fp, fl, "json::Normal") == 1) { return _par_json_normal(); }
    if (_par_eq(fp, fl, "json::Binomial") == 1) { return _par_json_binomial(); }
    if (_par_eq(fp, fl, "json::MultivariateNormal") == 1) { return _par_json_mvn(); }
    if (_par_eq(fp, fl, "json::KernelDensity") == 1) { return _par_json_kde(); }
    if (_par_eq(fp, fl, "json::Kernel") == 1) { return _par_json_kernel(); }
    if (_par_eq(fp, fl, "json::PcaResult") == 1) { return _par_json_pca(); }
    if (_par_eq(fp, fl, "json::TestResult") == 1) { return _par_json_results(0); }
    if (_par_eq(fp, fl, "json::AnovaResult") == 1) { return _par_json_results(1); }
    if (_par_eq(fp, fl, "json::KsResult") == 1) { return _par_json_results(2); }
    if (_par_eq(fp, fl, "json::ConfidenceInterval") == 1) { return _par_json_results(3); }
    if (_par_eq(fp, fl, "json::LinearModel") == 1) { return _par_json_models(0); }
    if (_par_eq(fp, fl, "json::PolynomialModel") == 1) { return _par_json_models(1); }
    if (_par_eq(fp, fl, "json::LogisticModel") == 1) { return _par_json_models(2); }
    if (_par_eq(fp, fl, "json::ArimaModel") == 1) { return _par_json_models(3); }
    if (_par_eq(fp, fl, "json::BayesianUpdate") == 1) { return _par_json_bayes(); }
    if (_par_eq(fp, fl, "json::MarkovChain") == 1) { return _par_json_chain(); }
    if (_par_eq(fp, fl, "json::HiddenMarkovModel") == 1) { return _par_json_hmm(); }
    if (_par_eq(fp, fl, "json::EstimateResult") == 1) { return _par_json_estimate(); }
    if (_par_eq(fp, fl, "json::QueryResult") == 1) { return _par_json_qr(); }
    var jsk = _par_so_kind(fp, fl, 6);
    if (jsk >= 0) { return _par_json_shape(jsk); }
    if (_par_eq(fp, fl, "json::McmcResult") == 1) { return _par_json_mcmc(); }
    var jd = _par_json_dist(fp, fl);
    if (jd != 0) { return jd; }
    if (_par_in_n != 1) { return 0 - 1; }
    if (_par_json_doc == 0) {
        _par_json_doc = alloc(_PMN_JSON_DOC_SIZE);
        _par_json_buf = alloc(_PAR_JSON_CAP * 8);
        if (_par_json_doc == 0 || _par_json_buf == 0) { return 0 - 1; }
    }
    var n = 0;
    var doc = _par_in_bytes(0, &n);
    if (doc == 0) { return 0 - 1; }
    var e = _pmn_json_open(_par_json_doc, doc, n);
    var r = 1;
    if (e == PMN_ERR_NONE) {
        e = _par_json_value(fp, fl, _pmn_json_root(_par_json_doc));
        if (e == 0 - 2) { r = 0; }
        if (e == 0 - 1) { r = 0 - 1; }
    }
    _pmn_json_close(_par_json_doc);
    if (r == 1 && e != PMN_ERR_NONE) {
        _par_got_n = 0;
        _par_got_err(e);
    }
    return r;
}

# `rng` rows (M1 part e1): 1.3.0's SimpleRng through src/rng.cyr. Each draw goes through a bounded generic, as every
# pramana API that takes Rust's `&mut impl Rng` does (D7, amended).
fn _par_draw<R: PmnRng>(g: *R): f64 {
    var r: f64 = g.next_f64();
    return r;
}

fn _par_rng(fp, fl): i64 {
    if (_par_in_n != 2) { return 0 - 1; }
    var g: PmnSimpleRng;
    if (PmnSimpleRng_new(&g, _par_in(0)) != PMN_ERR_NONE) { return 0 - 1; }
    var n = _par_in(1);
    if (_par_eq(fp, fl, "SimpleRng::next_f64") == 1) {
        _par_got_seq(n);
        for (var k = 0; k < n; k = k + 1) {
            var x: f64 = _par_draw(&g);
            _par_got_f(x);
        }
        return 1;
    }
    if (_par_eq(fp, fl, "SimpleRng::digest") == 1) {
        var h = 0xCBF29CE484222325;
        for (var j = 0; j < n; j = j + 1) {
            var y: f64 = _par_draw(&g);
            h = (h ^ load64(&y)) * 0x100000001B3;
        }
        _par_got_i(h);
        return 1;
    }
    return 0;
}

