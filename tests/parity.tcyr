# parity.tcyr — replays the golden corpus (tests/golden/*.tsv) against the port.
#
# Port plan §5 step 7, adapted from pravash's tests/parity.tcyr (its M0 version), itself impetus's, kimiya's and
# tanmatra's. Format and comparison rules: scripts/golden/README.md. The module list is tests/golden/modules.txt,
# which the generator writes. The replay machinery is tests/parity_core.cyr; this file holds the hooks and the
# dispatchers.
#
# Every row of every module is one of:
# - ok: every output matched within its class;
# - FAILED: an output differs; the first 10 per module are printed with the row's note and both bit patterns;
# - measured: class C, with no bound set yet for its function. The ulp distance is recorded but not gated. The bound
#   for each correctly rounded function is 0, set when M1 dispatches it (ADR 009); the stdlib counterparts here are
#   the step 8 baseline;
# - accepted: a divergence an ADR accepts (ADR 9: the correctly rounded rows, tests/golden/<module>.cr.tsv);
# - pending: its function isn't ported yet (no dispatcher entry).
#
# Per function it prints the row counts and the ulp histogram. Shadow lines (`fn ~ candidate`) compare the same rows
# against another Cyrius candidate and are never gated. The exit code is the number of modules with a failure.

include "tests/ulp.cyr"
include "tests/lib.cyr"

alloc_init();

include "tests/parity_core.cyr"
include "tests/constants_rows.cyr"

# ── cross-target digests (M0 step 8) ────────────────────────────────────────────────
# A 64-bit FNV-1a fold of every output word the port returns for a function, in row order (pravash's). Run on x86_64
# ELF, x86_64 PE and aarch64: equal digests mean bit-identical results on every row, which ADR 007 row 11 promises and
# histograms alone can't show. Slots 0–10 are the dispatched class-C functions, 11 the class-A/B math rows together,
# 12 the constants, 13–16 the native-builtin shadows (which differ on aarch64 by design: there the builtins are the
# polyfills).
var _PAR_DG_N = 17;
var _par_dg[136];

fn _par_dg_init() {
    for (var k = 0; k < _PAR_DG_N; k = k + 1) { store64(&_par_dg + k * 8, 0xcbf29ce484222325); }
    return 0;
}

# The digest slot of a math function's dispatched outputs.
#must_use
fn _par_dg_slot(fp, fl): i64 {
    if (_par_eq(fp, fl, "f64::exp") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::ln") == 1) { return 1; }
    if (_par_eq(fp, fl, "f64::ln_1p") == 1) { return 2; }
    if (_par_eq(fp, fl, "f64::exp_m1") == 1) { return 3; }
    if (_par_eq(fp, fl, "f64::powf") == 1) { return 4; }
    if (_par_eq(fp, fl, "f64::sin") == 1) { return 5; }
    if (_par_eq(fp, fl, "f64::cos") == 1) { return 6; }
    if (_par_eq(fp, fl, "f64::tan") == 1) { return 7; }
    if (_par_eq(fp, fl, "f64::atan") == 1) { return 8; }
    if (_par_eq(fp, fl, "f64::log2") == 1) { return 9; }
    if (_par_eq(fp, fl, "f64::cbrt") == 1) { return 10; }
    return 11;
}

# Folds the got list into digest `slot`.
fn _par_dg_fold(slot) {
    var at = &_par_dg + slot * 8;
    var h = load64(at);
    for (var k = 0; k < _par_got_n; k = k + 1) {
        h = (h ^ load64(_par_got_v + k * 8)) * 0x100000001b3;
    }
    store64(at, h);
    return 0;
}

# Prints digest `slot` under `name`.
fn _par_dg_print(slot, name) {
    print("  digest ", 9);
    _par_print_pad(name, strlen(name), 40);
    print(" 0x", 3);
    fmt_hex(load64(&_par_dg + slot * 8));
    println("");
    return 0;
}

_par_dg_init();

# ── hooks ───────────────────────────────────────────────────────────────────────────

# The Rust variant name of an error code (src/error.cyr).
#must_use
fn _par_error_name(code): i64 {
    return pmn_err_name(code);
}

# ── dispatch ────────────────────────────────────────────────────────────────────────
# Each module's dispatcher fills the got list for one row. It returns 1 when it handled the function, 0 when the
# function is pending (not ported), or -1 when the inputs are unusable (a defect, counted as a failure). Add a function
# the moment it's ported.

# `const` rows (input `s:<path>`): src/constants.cyr's value for the path, through the generated lookup
# (tests/constants_rows.cyr). An unknown path is a defect.
fn _par_constants(fp, fl): i64 {
    if (_par_eq(fp, fl, "const") != 1 || _par_in_n != 1) { return 0 - 1; }
    return _par_constant_row(load64(_par_in_v), load64(_par_in_l));
}

# `fmt` rows: serde_json's text for an f64 (`f64::to_json`), written by src/fmtf.cyr (M1 part d1; D5, ADR 007 row 7).
# One builder serves every row (its length reset), so the replay leaves nothing per row on the heap.
var _par_fmt_sb = 0;

fn _par_fmt(fp, fl): i64 {
    if (_par_eq(fp, fl, "f64::to_json") != 1 || _par_in_n != 1) { return 0; }
    if (_par_fmt_sb == 0) { _par_fmt_sb = str_builder_new(); }
    store64(_par_fmt_sb + 8, 0);
    var x: f64 = _par_in(0);
    _pmn_fmt_f64_json(_par_fmt_sb, x);
    _par_got_s(load64(_par_fmt_sb), load64(_par_fmt_sb + 8));
    return 1;
}

# `json::<T>` rows (input `s:<document>`): serde_json 1.0.154's reading of the document as T, through src/json.cyr's
# pre-pass, document arena and readers (M1 parts d3a and d3b): the value types, two test structs (`Pair`, `Shapes`)
# and 1.3.0's two enums (`Kernel`, `PramanaError`). A refusal anywhere is `E:Deserialize`: `_par_json` drops any
# tokens a value appended before it failed.
var _par_json_doc = 0;
var _par_json_buf = 0;
var _PAR_JSON_CAP = 65536;

# The shapes, by code: 0 f64, 1 u64 or usize, 2 bool, 3 String, 4 Vec<f64>, 5 Vec<u64>, 6 Vec<String>,
# 7 Vec<Vec<f64>>, 8 Kernel.
# The shape code of the type named by tp[0, tl) ("f64", "Vec<u64>", ...), or -1.
fn _par_json_code(tp, tl): i64 {
    if (_par_eq(tp, tl, "f64") == 1) { return 0; }
    if (_par_eq(tp, tl, "u64") == 1 || _par_eq(tp, tl, "usize") == 1) { return 1; }
    if (_par_eq(tp, tl, "bool") == 1) { return 2; }
    if (_par_eq(tp, tl, "String") == 1) { return 3; }
    if (_par_eq(tp, tl, "Vec<f64>") == 1) { return 4; }
    if (_par_eq(tp, tl, "Vec<u64>") == 1) { return 5; }
    if (_par_eq(tp, tl, "Vec<String>") == 1) { return 6; }
    if (_par_eq(tp, tl, "Vec<Vec<f64>>") == 1) { return 7; }
    if (_par_eq(tp, tl, "Kernel") == 1) { return 8; }
    return 0 - 1;
}

# Reads node v as shape `code` and appends its tokens: a PMN_ERR_* code, or -1 for a defect.
fn _par_json_emit(code, v): i64 {
    var w[16];
    if (code == 0) {
        var e0 = _pmn_json_f64(v, &w);
        if (e0 == PMN_ERR_NONE) { _par_got_f(load64(&w)); }
        return e0;
    }
    if (code == 1) {
        var e1 = _pmn_json_u64(v, &w);
        if (e1 == PMN_ERR_NONE) { _par_got_i(load64(&w)); }
        return e1;
    }
    if (code == 2) {
        var e2 = _pmn_json_bool(v, &w);
        if (e2 == PMN_ERR_NONE) { _par_got_i(load64(&w)); }
        return e2;
    }
    if (code == 3) {
        var e3 = _pmn_json_str(v, &w);
        if (e3 == PMN_ERR_NONE) { _par_got_text(load64(&w), load64(&w + 8)); }
        return e3;
    }
    if (code == 4 || code == 5) {
        var n = _pmn_json_arr_len(v);
        if (n < 0) { return PMN_ERR_DESERIALIZE; }
        if (n > _PAR_JSON_CAP) { return 0 - 1; }
        var e4 = 0;
        if (code == 4) { e4 = _pmn_json_vec_f64(v, _par_json_buf, _PAR_JSON_CAP); }
        if (code == 5) { e4 = _pmn_json_vec_u64(v, _par_json_buf, _PAR_JSON_CAP); }
        if (e4 != PMN_ERR_NONE) { return e4; }
        _par_got_seq(n);
        for (var k = 0; k < n; k = k + 1) {
            if (code == 4) { _par_got_f(load64(_par_json_buf + k * 8)); }
            if (code == 5) { _par_got_i(load64(_par_json_buf + k * 8)); }
        }
        return PMN_ERR_NONE;
    }
    if (code == 6) {
        var ns = _pmn_json_arr_len(v);
        if (ns < 0) { return PMN_ERR_DESERIALIZE; }
        _par_got_seq(ns);
        for (var a = 0; a < ns; a = a + 1) {
            var e6 = _par_json_emit(3, _pmn_json_arr_get(v, a));
            if (e6 != PMN_ERR_NONE) { return e6; }
        }
        return PMN_ERR_NONE;
    }
    if (code == 7) {
        var sh[24];
        var e7 = _pmn_json_mat_shape(v, &sh);
        if (e7 != PMN_ERR_NONE) { return e7; }
        var r = load64(&sh);
        _par_got_seq(r);
        for (var i = 0; i < r; i = i + 1) {
            if (_par_json_emit(4, _pmn_json_arr_get(v, i)) != PMN_ERR_NONE) { return 0 - 1; }   # the shape read them
        }
        return PMN_ERR_NONE;
    }
    if (code == 8) {
        var kn[32];
        store64(&kn, "Gaussian");
        store64(&kn + 8, "Epanechnikov");
        store64(&kn + 16, "Uniform");
        store64(&kn + 24, "Triangular");
        var e8 = _pmn_json_unit_variant(v, &kn, 4, &w);
        if (e8 != PMN_ERR_NONE) { return e8; }
        var j = load64(&w);
        if (j == 0) { _par_got_e("Kernel.Gaussian"); }
        if (j == 1) { _par_got_e("Kernel.Epanechnikov"); }
        if (j == 2) { _par_got_e("Kernel.Uniform"); }
        if (j == 3) { _par_got_e("Kernel.Triangular"); }
        return PMN_ERR_NONE;
    }
    return 0 - 1;
}

# The test struct `Pair { mean: f64, std_dev: f64 }` (Normal's fields): serde derive's rules, then both fields.
fn _par_json_pair(root): i64 {
    var names[16];
    store64(&names, "mean");
    store64(&names + 8, "std_dev");
    var sl[16];
    var e = _pmn_json_struct(root, &names, 2, &sl);
    if (e != PMN_ERR_NONE) { return e; }
    e = _par_json_emit(0, load64(&sl));
    if (e != PMN_ERR_NONE) { return e; }
    return _par_json_emit(0, load64(&sl + 8));
}

# The test struct `Shapes`: one field of every kind 1.3.0's serialized types hold, in declaration order.
fn _par_json_shapes(root): i64 {
    var names[80];
    var codes[80];
    store64(&names, "x");
    store64(&codes, 0);
    store64(&names + 8, "n");
    store64(&codes + 8, 1);
    store64(&names + 16, "k");
    store64(&codes + 16, 1);
    store64(&names + 24, "flag");
    store64(&codes + 24, 2);
    store64(&names + 32, "name");
    store64(&codes + 32, 3);
    store64(&names + 40, "xs");
    store64(&codes + 40, 4);
    store64(&names + 48, "ns");
    store64(&codes + 48, 5);
    store64(&names + 56, "labels");
    store64(&codes + 56, 6);
    store64(&names + 64, "m");
    store64(&codes + 64, 7);
    store64(&names + 72, "kernel");
    store64(&codes + 72, 8);
    var sl[80];
    var e = _pmn_json_struct(root, &names, 10, &sl);
    if (e != PMN_ERR_NONE) { return e; }
    for (var i = 0; i < 10; i = i + 1) {
        e = _par_json_emit(load64(&codes + i * 8), load64(&sl + i * 8));
        if (e != PMN_ERR_NONE) { return e; }
    }
    return PMN_ERR_NONE;
}

# 1.3.0's `PramanaError`: a newtype variant holding a String. The tokens are the variant and its message (part d4's
# codec keeps the variant alone, ADR 007 row 8).
fn _par_json_error(root): i64 {
    var names[40];
    store64(&names, "InvalidParameter");
    store64(&names + 8, "InvalidSample");
    store64(&names + 16, "ConvergenceFailure");
    store64(&names + 24, "DimensionMismatch");
    store64(&names + 32, "ComputationError");
    var w[16];
    var e = _pmn_json_newtype_variant(root, &names, 5, &w);
    if (e != PMN_ERR_NONE) { return e; }
    var j = load64(&w);
    if (j == 0) { _par_got_e("PramanaError.InvalidParameter"); }
    if (j == 1) { _par_got_e("PramanaError.InvalidSample"); }
    if (j == 2) { _par_got_e("PramanaError.ConvergenceFailure"); }
    if (j == 3) { _par_got_e("PramanaError.DimensionMismatch"); }
    if (j == 4) { _par_got_e("PramanaError.ComputationError"); }
    return _par_json_emit(3, load64(&w + 8));
}

# ── json::write::<T> rows (part d4): the value's tokens in, serde_json's text out, through src/json.cyr's writers into
# one reused builder. _par_json_k is the cursor over the input tokens.
var _par_json_sb = 0;
var _par_json_k = 0;

# The variant index of an `e:<Enum>.<Name>` input token at the cursor among names[0, n), or -1; it advances.
fn _par_jw_variant(names, n): i64 {
    var k = _par_json_k;
    _par_json_k = k + 1;
    if (k >= _par_in_n || load64(_par_in_k + k * 8) != 101) { return 0 - 1; }
    var p = _par_in(k);
    var len = load64(_par_in_l + k * 8);
    var dot = 0;
    while (dot < len && load8(p + dot) != 46) { dot = dot + 1; }
    for (var j = 0; j < n; j = j + 1) {
        var name = load64(names + j * 8);
        if (strlen(name) == len - dot - 1 && memeq(p + dot + 1, name, len - dot - 1) == 1) { return j; }
    }
    return 0 - 1;
}

# Writes the value at the cursor as shape `code` (_par_json_code's numbering): a PMN_ERR_* code, or -1 for a defect.
fn _par_jw(code): i64 {
    var sb = _par_json_sb;
    var k = _par_json_k;
    if (k >= _par_in_n) { return 0 - 1; }
    if (code == 0) {
        _par_json_k = k + 1;
        var x: f64 = _par_in(k);
        return _pmn_json_w_f64(sb, x);
    }
    if (code == 1) {
        _par_json_k = k + 1;
        return _pmn_json_w_u64(sb, _par_in(k));
    }
    if (code == 2) {
        _par_json_k = k + 1;
        return _pmn_json_w_bool(sb, _par_in(k));
    }
    if (code == 3) {
        _par_json_k = k + 1;
        var n = 0;
        var p = _par_in_bytes(k, &n);
        if (p == 0) { return 0 - 1; }
        return _pmn_json_w_str(sb, p, n);
    }
    var cnt = _par_in(k);
    _par_json_k = k + 1;
    if (code == 4 || code == 5) {
        if (cnt > _PAR_JSON_CAP || _par_json_k + cnt > _par_in_n) { return 0 - 1; }
        for (var i = 0; i < cnt; i = i + 1) { store64(_par_json_buf + i * 8, _par_in(_par_json_k + i)); }
        _par_json_k = _par_json_k + cnt;
        if (code == 4) { return _pmn_json_w_vec_f64(sb, _par_json_buf, cnt); }
        return _pmn_json_w_vec_u64(sb, _par_json_buf, cnt);
    }
    if (code == 6) {
        var e = _pmn_json_w_lit(sb, "[");
        for (var a = 0; a < cnt; a = a + 1) {
            if (a > 0 && e == PMN_ERR_NONE) { e = _pmn_json_w_lit(sb, ","); }
            if (e == PMN_ERR_NONE) { e = _par_jw(3); }
        }
        if (e != PMN_ERR_NONE) { return e; }
        return _pmn_json_w_lit(sb, "]");
    }
    if (code == 7) {
        var cols = 0;
        var at = 0;
        for (var r = 0; r < cnt; r = r + 1) {
            var c = _par_in(_par_json_k);
            _par_json_k = _par_json_k + 1;
            if (r == 0) { cols = c; }
            if (c != cols || at + c > _PAR_JSON_CAP) { return 0 - 1; }   # the rows are rectangular
            for (var j = 0; j < c; j = j + 1) { store64(_par_json_buf + (at + j) * 8, _par_in(_par_json_k + j)); }
            _par_json_k = _par_json_k + c;
            at = at + c;
        }
        return _pmn_json_w_mat_f64(sb, _par_json_buf, cnt, cols);
    }
    if (code == 8) {
        _par_json_k = k;
        var kn[32];
        store64(&kn, "Gaussian");
        store64(&kn + 8, "Epanechnikov");
        store64(&kn + 16, "Uniform");
        store64(&kn + 24, "Triangular");
        var v = _par_jw_variant(&kn, 4);
        if (v < 0) { return 0 - 1; }
        return _pmn_json_w_unit_variant(sb, load64(&kn + v * 8));
    }
    return 0 - 1;
}

# A json::write row: the shape's text into the builder, then one `s:` token, or the writer's error.
fn _par_json_write(fp, fl): i64 {
    if (_par_json_sb == 0) {
        _par_json_sb = str_builder_new();
        if (_par_json_buf == 0) { _par_json_buf = alloc(_PAR_JSON_CAP * 8); }
    }
    var sb = _par_json_sb;
    store64(sb + 8, 0);
    _par_json_k = 0;
    var e = 0 - 2;
    if (_par_eq(fp, fl, "json::write::Pair") == 1) {
        e = _pmn_json_w_key(sb, "mean", 1);
        if (e == PMN_ERR_NONE) { e = _par_jw(0); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_key(sb, "std_dev", 0); }
        if (e == PMN_ERR_NONE) { e = _par_jw(0); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_lit(sb, "}"); }
    } elif (_par_eq(fp, fl, "json::write::Shapes") == 1) {
        var names[80];
        store64(&names, "x");
        store64(&names + 8, "n");
        store64(&names + 16, "k");
        store64(&names + 24, "flag");
        store64(&names + 32, "name");
        store64(&names + 40, "xs");
        store64(&names + 48, "ns");
        store64(&names + 56, "labels");
        store64(&names + 64, "m");
        store64(&names + 72, "kernel");
        var codes[80];
        var cv = 0;
        for (var f = 0; f < 10; f = f + 1) {
            cv = f;
            if (f == 2) { cv = 1; }
            if (f > 2) { cv = f - 1; }
            store64(&codes + f * 8, cv);
        }
        e = PMN_ERR_NONE;
        for (var g = 0; g < 10; g = g + 1) {
            if (e == PMN_ERR_NONE) { e = _pmn_json_w_key(sb, load64(&names + g * 8), 1 - (g > 0)); }
            if (e == PMN_ERR_NONE) { e = _par_jw(load64(&codes + g * 8)); }
        }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_lit(sb, "}"); }
    } elif (_par_eq(fp, fl, "json::write::SimpleRng") == 1) {
        var g: PmnSimpleRng;
        if (PmnSimpleRng_new(&g, _par_in(0)) != PMN_ERR_NONE) { return 0 - 1; }
        _par_json_k = 1;
        e = g.to_json(sb);
    } elif (_par_eq(fp, fl, "json::write::PramanaError") == 1) {
        var en[40];
        store64(&en, "InvalidParameter");
        store64(&en + 8, "InvalidSample");
        store64(&en + 16, "ConvergenceFailure");
        store64(&en + 24, "DimensionMismatch");
        store64(&en + 32, "ComputationError");
        var v = _par_jw_variant(&en, 5);
        if (v < 0) { return 0 - 1; }
        e = pmn_err_to_json(PMN_ERR_INVALID_PARAMETER + v, sb);
    } else {
        var code = _par_json_code(fp + 13, fl - 13);     # the T of json::write::T
        if (code >= 0) { e = _par_jw(code); }
    }
    if (e == 0 - 2) { return 0; }
    if (e == 0 - 1 || _par_json_k != _par_in_n) { return 0 - 1; }
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    _par_got_text(load64(sb), load64(sb + 8));
    return 1;
}

# json::PramanaError::code rows: the error codec's reading, pmn_err_from_json, the variant alone.
fn _par_json_err_code(): i64 {
    var n = 0;
    var doc = _par_in_bytes(0, &n);
    if (doc == 0) { return 0 - 1; }
    var t, v = pmn_err_from_json(doc, n);
    if (is_err_result(t) == 1) {
        _par_got_err(v);
        return 1;
    }
    if (v == PMN_ERR_INVALID_PARAMETER) { _par_got_e("PramanaError.InvalidParameter"); }
    if (v == PMN_ERR_INVALID_SAMPLE) { _par_got_e("PramanaError.InvalidSample"); }
    if (v == PMN_ERR_CONVERGENCE_FAILURE) { _par_got_e("PramanaError.ConvergenceFailure"); }
    if (v == PMN_ERR_DIMENSION_MISMATCH) { _par_got_e("PramanaError.DimensionMismatch"); }
    if (v == PMN_ERR_COMPUTATION_ERROR) { _par_got_e("PramanaError.ComputationError"); }
    return 1;
}

# json::SimpleRng rows: PmnSimpleRng_from_json, the state it holds.
fn _par_json_simple_rng(): i64 {
    var n = 0;
    var doc = _par_in_bytes(0, &n);
    if (doc == 0) { return 0 - 1; }
    var g: PmnSimpleRng;
    var e = PmnSimpleRng_from_json(&g, doc, n);
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    _par_got_i(g.state);
    return 1;
}

fn _par_json_value(fp, fl, root): i64 {
    if (_par_eq(fp, fl, "json::Pair") == 1) { return _par_json_pair(root); }
    if (_par_eq(fp, fl, "json::Shapes") == 1) { return _par_json_shapes(root); }
    if (_par_eq(fp, fl, "json::PramanaError") == 1) { return _par_json_error(root); }
    if (fl <= 6) { return 0 - 2; }
    var code = _par_json_code(fp + 6, fl - 6);           # the T of json::T
    if (code < 0) { return 0 - 2; }
    return _par_json_emit(code, root);
}

fn _par_json(fp, fl): i64 {
    if (fl > 13 && memeq(fp, "json::write::", 13) == 1) { return _par_json_write(fp, fl); }
    if (_par_eq(fp, fl, "json::PramanaError::code") == 1) { return _par_json_err_code(); }
    if (_par_eq(fp, fl, "json::SimpleRng") == 1) { return _par_json_simple_rng(); }
    if (_par_in_n != 1) { return 0 - 1; }
    if (_par_json_doc == 0) {
        _par_json_doc = alloc(_PMN_JSON_DOC_SIZE);
        _par_json_buf = alloc(_PAR_JSON_CAP * 8);
        if (_par_json_doc == 0 || _par_json_buf == 0) { return 0 - 1; }
    }
    var n = 0;
    var doc = _par_in_bytes(0, &n);
    if (doc == 0) { return 0 - 1; }
    var e = _pmn_json_open(_par_json_doc, doc, n);
    var r = 1;
    if (e == PMN_ERR_NONE) {
        e = _par_json_value(fp, fl, _pmn_json_root(_par_json_doc));
        if (e == 0 - 2) { r = 0; }
        if (e == 0 - 1) { r = 0 - 1; }
    }
    _pmn_json_close(_par_json_doc);
    if (r == 1 && e != PMN_ERR_NONE) {
        _par_got_n = 0;
        _par_got_err(e);
    }
    return r;
}

# `rng` rows (M1 part e1): 1.3.0's SimpleRng through src/rng.cyr. Each draw goes through a bounded generic, as every
# pramana API that takes Rust's `&mut impl Rng` does (D7, amended).
fn _par_draw<R: PmnRng>(g: *R): f64 {
    var r: f64 = g.next_f64();
    return r;
}

fn _par_rng(fp, fl): i64 {
    if (_par_in_n != 2) { return 0 - 1; }
    var g: PmnSimpleRng;
    if (PmnSimpleRng_new(&g, _par_in(0)) != PMN_ERR_NONE) { return 0 - 1; }
    var n = _par_in(1);
    if (_par_eq(fp, fl, "SimpleRng::next_f64") == 1) {
        _par_got_seq(n);
        for (var k = 0; k < n; k = k + 1) {
            var x: f64 = _par_draw(&g);
            _par_got_f(x);
        }
        return 1;
    }
    if (_par_eq(fp, fl, "SimpleRng::digest") == 1) {
        var h = 0xCBF29CE484222325;
        for (var j = 0; j < n; j = j + 1) {
            var y: f64 = _par_draw(&g);
            h = (h ^ load64(&y)) * 0x100000001B3;
        }
        _par_got_i(h);
        return 1;
    }
    return 0;
}

# `debug` rows (M1 part f; D12): Rust's derived Debug, the second input 0 for `{:?}` and 1 for `{:#?}`.
var _par_dbg_sb = 0;

fn _par_debug(fp, fl): i64 {
    if (_par_in_n != 2) { return 0 - 1; }
    if (_par_dbg_sb == 0) { _par_dbg_sb = str_builder_new(); }
    var sb = _par_dbg_sb;
    store64(sb + 8, 0);
    var alt = _par_in(1);
    var e = 0 - 1;
    if (_par_eq(fp, fl, "debug::SimpleRng") == 1) {
        var g: PmnSimpleRng;
        if (PmnSimpleRng_new(&g, _par_in(0)) != PMN_ERR_NONE) { return 0 - 1; }
        e = g.debug(sb, alt);
    } elif (_par_eq(fp, fl, "debug::PramanaError") == 1) {
        var en[40];
        store64(&en, "InvalidParameter");
        store64(&en + 8, "InvalidSample");
        store64(&en + 16, "ConvergenceFailure");
        store64(&en + 24, "DimensionMismatch");
        store64(&en + 32, "ComputationError");
        _par_json_k = 0;
        var v = _par_jw_variant(&en, 5);
        if (v < 0) { return 0 - 1; }
        e = pmn_err_debug(PMN_ERR_INVALID_PARAMETER + v, sb, alt);
    } else {
        return 0;
    }
    if (e != PMN_ERR_NONE) { return 0 - 1; }
    _par_got_text(load64(sb), load64(sb + 8));
    return 1;
}

# `bridge` rows (M1 part e3): src/bridge.cyr. A slice is `v:n` and its values, read into a buffer; a slice of pairs
# is `v:n` then each pair's integer and f64, read into 16-byte records; a tuple's elements come back in order.
var _par_br_a = 0;
var _par_br_b = 0;
var _PAR_BR_CAP = 4096;

# The `v:n` slice at token k into buf (n words, or n records when `pairs`): n, with the next token index at *next.
fn _par_br_read(k, buf, pairs, next): i64 {
    if (k >= _par_in_n || load64(_par_in_k + k * 8) != 118) { return 0 - 1; }
    var n = _par_in(k);
    var per = 1;
    if (pairs == 1) { per = 2; }
    if (n < 0 || n > _PAR_BR_CAP || k + 1 + n * per > _par_in_n) { return 0 - 1; }
    for (var i = 0; i < n * per; i = i + 1) { store64(buf + i * 8, _par_in(k + 1 + i)); }
    store64(next, k + 1 + n * per);
    return n;
}

fn _par_bridge(fp, fl): i64 {
    if (_par_br_a == 0) {
        _par_br_a = alloc(_PAR_BR_CAP * 16);
        _par_br_b = alloc(_PAR_BR_CAP * 16);
    }
    var out[40];
    var x: f64 = _par_in(0);
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "bridge::ensemble_spread_to_confidence") == 1) {
        var r0: f64 = pmn_ensemble_spread_to_confidence(x, y);
        _par_got_f(r0);
        return 1;
    }
    if (_par_eq(fp, fl, "bridge::observation_error_to_likelihood") == 1) {
        var r1: f64 = pmn_observation_error_to_likelihood(x, y);
        _par_got_f(r1);
        return 1;
    }
    if (_par_eq(fp, fl, "bridge::sensor_noise_to_std_dev") == 1) {
        var r2: f64 = pmn_sensor_noise_to_std_dev(x, y);
        _par_got_f(r2);
        return 1;
    }
    if (_par_eq(fp, fl, "bridge::z_rates_to_d_prime") == 1) {
        var r3: f64 = pmn_z_rates_to_d_prime(x, y);
        _par_got_f(r3);
        return 1;
    }
    if (_par_eq(fp, fl, "bridge::uncertainty_to_gaussian") == 1) {
        if (pmn_uncertainty_to_gaussian(x, y, &out) != PMN_ERR_NONE) { return 0 - 1; }
        _par_got_f(load64(&out));
        _par_got_f(load64(&out + 8));
        return 1;
    }
    if (_par_eq(fp, fl, "bridge::item_variances_to_alpha") == 1) {
        var s: f64 = _par_in(1);
        var t: f64 = _par_in(2);
        var r4: f64 = pmn_item_variances_to_alpha(_par_in(0), s, t);
        _par_got_f(r4);
        return 1;
    }
    if (_par_eq(fp, fl, "bridge::replicates_to_t_statistic") == 1) {
        if (_par_in_n != 6) { return 0 - 1; }
        var sa: f64 = _par_in(1);
        var mb: f64 = _par_in(3);
        var sb: f64 = _par_in(4);
        var r5: f64 = pmn_replicates_to_t_statistic(x, sa, _par_in(2), mb, sb, _par_in(5));
        _par_got_f(r5);
        return 1;
    }
    var next = 0;
    if (_par_eq(fp, fl, "bridge::yields_to_mean_variance") == 1) {
        var n = _par_br_read(0, _par_br_a, 0, &next);
        if (n < 0 || pmn_yields_to_mean_variance(_par_br_a, n, &out) != PMN_ERR_NONE) { return 0 - 1; }
        _par_got_f(load64(&out));
        _par_got_f(load64(&out + 8));
        return 1;
    }
    if (_par_eq(fp, fl, "bridge::trait_scores_to_correlation") == 1) {
        var na = _par_br_read(0, _par_br_a, 0, &next);
        if (na < 0) { return 0 - 1; }
        var nb = _par_br_read(next, _par_br_b, 0, &next);
        if (nb < 0 || pmn_trait_scores_to_correlation(_par_br_a, na, _par_br_b, nb, &out) != PMN_ERR_NONE) {
            return 0 - 1;
        }
        for (var k = 0; k < 5; k = k + 1) { _par_got_f(load64(&out + k * 8)); }
        return 1;
    }
    var e = 0 - 1;
    var nr = _par_br_read(0, _par_br_a, 1, &next);
    if (nr < 0) { return 0 - 1; }
    if (_par_eq(fp, fl, "bridge::learning_trials_to_power_law") == 1) {
        e = pmn_learning_trials_to_power_law(_par_br_a, nr, &out);
    } elif (_par_eq(fp, fl, "bridge::response_times_to_hick_params") == 1) {
        e = pmn_response_times_to_hick_params(_par_br_a, nr, &out);
    } else {
        return 0;
    }
    if (e != PMN_ERR_NONE) { return 0 - 1; }
    _par_got_f(load64(&out));
    _par_got_f(load64(&out + 8));
    return 1;
}

# `combinatorics` rows (M1 part e2): src/combinatorics.cyr. A u128 is two tokens, its low word then its high word.
fn _par_combinatorics(fp, fl): i64 {
    var x: PmnU128;
    var e = 0 - 1;
    if (_par_eq(fp, fl, "combinatorics::stirling_approx") == 1) {
        if (_par_in_n != 1) { return 0 - 1; }
        var s: f64 = pmn_stirling_approx(_par_in(0));
        _par_got_f(s);
        return 1;
    }
    if (_par_eq(fp, fl, "combinatorics::factorial") == 1) {
        if (_par_in_n != 1) { return 0 - 1; }
        e = pmn_factorial(_par_in(0), &x);
    } elif (_par_in_n == 2 && _par_eq(fp, fl, "combinatorics::permutations") == 1) {
        e = pmn_permutations(_par_in(0), _par_in(1), &x);
    } elif (_par_in_n == 2 && _par_eq(fp, fl, "combinatorics::combinations") == 1) {
        e = pmn_combinations(_par_in(0), _par_in(1), &x);
    } else {
        return 0;
    }
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    _par_got_i(x.lo);
    _par_got_i(x.hi);
    return 1;
}

# `f64::*` and `u64::*` rows: the Rust std reference values (port plan §8.1), every one through src/mathx.cyr, the
# names the rest of the port calls (M1 part c):
# - the exact builtins sqrt, abs and floor;
# - the fdlibm word operations, which the port writes inline: `bits >> 32` (logical) and `bits & 0xFFFFFFFF00000000`;
# - the Rust-semantics helpers (ledger L2): min, max and clamp ignore a NaN as Rust does, fract is x − trunc(x),
#   is_nan, is_finite and total_cmp, `as usize` saturates, `u64 as f64` is unsigned, and powi is LLVM's
#   square-and-multiply;
# - the transcendentals, correctly rounded at 0 ulp (ADR 009): kimiya's exp, ln, exp_m1, powf, sin, cos and atan
#   (src/crmath.cyr, part b1), pramana's own ln_1p, tan and log2 (src/crmath_ext.cyr, parts b2–b4), ganita's cbrt.
fn _par_math(fp, fl): i64 {
    var w = _par_in(0);
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "f64::sqrt") == 1) { var r: f64 = f64_sqrt(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::abs") == 1) { var r: f64 = f64_abs(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::floor") == 1) { var r: f64 = f64_floor(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::high_word") == 1) { _par_got_i(w >> 32); return 1; }
    if (_par_eq(fp, fl, "f64::low_masked") == 1) { _par_got_f(w & 0xFFFFFFFF00000000); return 1; }
    if (_par_eq(fp, fl, "f64::fract") == 1) { var r: f64 = _pmn_fract(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::is_nan") == 1) { _par_got_i(_pmn_is_nan(x)); return 1; }
    if (_par_eq(fp, fl, "f64::is_finite") == 1) { _par_got_i(_pmn_is_finite(x)); return 1; }
    if (_par_eq(fp, fl, "f64::as_usize") == 1) { _par_got_i(_pmn_sat_usize(x)); return 1; }
    if (_par_eq(fp, fl, "u64::as_f64") == 1) { var r: f64 = _pmn_u64_to_f64(w); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::powi2") == 1) { var r: f64 = _pmn_powi(x, 2); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::powi3") == 1) { var r: f64 = _pmn_powi(x, 3); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::powi4") == 1) { var r: f64 = _pmn_powi(x, 4); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::powi9") == 1) { var r: f64 = _pmn_powi(x, 9); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::powi25") == 1) { var r: f64 = _pmn_powi(x, 25); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::powi49") == 1) { var r: f64 = _pmn_powi(x, 49); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::exp") == 1) { var r: f64 = _pmn_exp(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::ln") == 1) { var r: f64 = _pmn_ln(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::ln_1p") == 1) { var r: f64 = _pmn_ln_1p(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::exp_m1") == 1) { var r: f64 = _pmn_exp_m1(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::sin") == 1) { var r: f64 = _pmn_sin(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::cos") == 1) { var r: f64 = _pmn_cos(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::tan") == 1) { var r: f64 = _pmn_tan(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::atan") == 1) { var r: f64 = _pmn_atan(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::log2") == 1) { var r: f64 = _pmn_log2(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::cbrt") == 1) { var r: f64 = _pmn_cbrt(x); _par_got_f(r); return 1; }
    if (_par_in_n < 2) { return 0; }
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "f64::powf") == 1) { var r: f64 = _pmn_powf(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::max") == 1) { var r: f64 = _pmn_max(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::min") == 1) { var r: f64 = _pmn_min(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::total_cmp") == 1) { _par_got_i(_pmn_total_cmp(x, y)); return 1; }
    if (_par_in_n < 3) { return 0; }
    var z: f64 = _par_in(2);
    if (_par_eq(fp, fl, "f64::clamp") == 1) { var r: f64 = _pmn_clamp(x, y, z); _par_got_f(r); return 1; }
    return 0;
}

fn _par_dispatch(mp, ml, fp, fl): i64 {
    _par_got_n = 0;
    if (_par_eq(mp, ml, "bridge") == 1) { return _par_bridge(fp, fl); }
    if (_par_eq(mp, ml, "combinatorics") == 1) { return _par_combinatorics(fp, fl); }
    if (_par_eq(mp, ml, "constants") == 1) { return _par_constants(fp, fl); }
    if (_par_eq(mp, ml, "debug") == 1) { return _par_debug(fp, fl); }
    if (_par_eq(mp, ml, "fmt") == 1) { return _par_fmt(fp, fl); }
    if (_par_eq(mp, ml, "json") == 1) { return _par_json(fp, fl); }
    if (_par_eq(mp, ml, "math") == 1) { return _par_math(fp, fl); }
    if (_par_eq(mp, ml, "rng") == 1) { return _par_rng(fp, fl); }
    return 0;
}

# Shadow comparisons, never gated: the same golden rows through another Cyrius candidate. Each row's own outputs are
# folded into its digest first (a pending row has none), before a shadow replaces them.
# - the native exp, ln, atan and log2 builtins: x87 on x86_64, so their bits differ between targets (digests 13–16).
#   M0 step 8 dispatched the polyfill forms instead; M1 dispatches the correctly rounded functions;
# - the stdlib min / max, to show where their NaN semantics differ from Rust's.
fn _par_shadow_f(name, cls, r: f64) {
    _par_got_n = 0;
    _par_got_f(r);
    _par_shadow_record(name, cls);
    return 0;
}

fn _par_shadows(mp, ml, fp, fl, cls) {
    if (_par_eq(mp, ml, "constants") == 1) {
        if (_par_got_n > 0) { _par_dg_fold(12); }
        return 0;
    }
    if (_par_eq(mp, ml, "math") != 1) { return 0; }
    if (_par_got_n > 0) { _par_dg_fold(_par_dg_slot(fp, fl)); }
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "f64::exp") == 1) {
        var r: f64 = f64_exp(x);
        _par_shadow_f("f64::exp ~ f64_exp (native)", cls, r);
        _par_dg_fold(13);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::ln") == 1) {
        var r: f64 = f64_ln(x);
        _par_shadow_f("f64::ln ~ f64_ln (native)", cls, r);
        _par_dg_fold(14);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::atan") == 1) {
        var r: f64 = f64_atan(x);
        _par_shadow_f("f64::atan ~ f64_atan (native)", cls, r);
        _par_dg_fold(15);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::log2") == 1) {
        var r: f64 = f64_log2(x);
        _par_shadow_f("f64::log2 ~ f64_log2 (native)", cls, r);
        _par_dg_fold(16);
        return 0;
    }
    if (_par_in_n < 2) { return 0; }
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "f64::max") == 1) {
        var r: f64 = f64_max(x, y);
        _par_shadow_f("f64::max ~ f64_max", cls, r);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::min") == 1) {
        var r: f64 = f64_min(x, y);
        _par_shadow_f("f64::min ~ f64_min", cls, r);
        return 0;
    }
    return 0;
}

# The class-C bound for a function, in ulps; -1 while none is set (the rows are measured). Set in M0 step 8
# (port-parity §5), before each function's first gated comparison, and never raised to make a row pass:
# - 2 for the interim counterparts of the primitives: glibc and each counterpart are within about 1 ulp of the
#   correctly rounded value, so two implementations can differ by 2 (the siblings' rule for primitives). On a row
#   with a correction (math.cr.tsv) the reference is the correctly rounded value, so a pass there means within 2 ulp
#   of it: "accepted (ADR 9)" is that weaker statement until M1;
# - 0 for cbrt: Rust's (compiler_builtins) and ganita's are both correctly rounded;
# - powf stays measured: ganita's open pow(−1, |y| > 2^64) defect gives +inf against Rust's 1, and no ADR accepts a
#   counterpart that M1 replaces.
# M1 dispatches the correctly rounded functions, and each one's bound becomes 0 (ADR 009): exp, ln, exp_m1, powf,
# sin, cos and atan at part b1, ln_1p at b2, tan at b3, log2 at b4: every one is 0.
#must_use
fn _par_c_bound(fp, fl): i64 {
    if (_par_eq(fp, fl, "f64::cbrt") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::exp") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::ln") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::exp_m1") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::powf") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::sin") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::cos") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::atan") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::ln_1p") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::tan") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::log2") == 1) { return 0; }
    if (_par_eq(fp, fl, "combinatorics::stirling_approx") == 1) { return 0; }   # powf, correctly rounded (part e2)
    if (_par_eq(fp, fl, "bridge::observation_error_to_likelihood") == 1) { return 0; }   # exp (part e3)
    if (_par_eq(fp, fl, "bridge::learning_trials_to_power_law") == 1) { return 0; }      # ln and exp
    if (_par_eq(fp, fl, "bridge::response_times_to_hick_params") == 1) { return 0; }     # log2
    return 0 - 1;
}

# The ADR accepting a divergent row (function and raw input field), or 0. The correctly rounded rows are ADR 009's,
# accepted by parity_core itself; ADR 007's mapped rows arrive with their modules.
#must_use
fn _par_accepted(fp, fl, ip, il): i64 {
    return 0;
}

# 1 for an ADR whose accepted rows are counted but not printed row by row. None yet.
#must_use
fn _par_accepted_quiet(adr): i64 {
    return 0;
}

# Module-specific summary lines after a module's report: the cross-target digests (M0 step 8). Then the pool's check
# (port plan §8.5): a module whose rows leave a work-table slot claimed fails.
fn _par_module_done(mp, ml) {
    var leak = _pmn_scratch_claimed();
    if (leak != 0) {
        print("  FAIL: ", 8);
        fmt_int(leak);
        println(" work-table pool slots still claimed after the module");
    }
    if (_par_eq(mp, ml, "constants") == 1) { _par_dg_print(12, "const"); }
    if (_par_eq(mp, ml, "math") != 1) { return leak; }
    _par_dg_print(0, "f64::exp (_pmn_km_cr_exp)");
    _par_dg_print(1, "f64::ln (_pmn_km_cr_ln)");
    _par_dg_print(2, "f64::ln_1p (_pmn_cr_log1p)");
    _par_dg_print(3, "f64::exp_m1 (_pmn_km_cr_expm1)");
    _par_dg_print(4, "f64::powf (_pmn_km_cr_pow)");
