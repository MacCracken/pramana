# parity.tcyr — replays the golden corpus (tests/golden/*.tsv) against the port.
#
# Port plan §5 step 7, adapted from pravash's tests/parity.tcyr (its M0 version), itself impetus's, kimiya's and
# tanmatra's. Format and comparison rules: scripts/golden/README.md. The module list is tests/golden/modules.txt,
# which the generator writes. The replay machinery is tests/parity_core.cyr; this file holds the hooks and the
# dispatchers.
#
# Every row of every module is one of:
# - ok: every output matched within its class;
# - FAILED: an output differs; the first 10 per module are printed with the row's note and both bit patterns;
# - measured: class C, with no bound set yet for its function. The ulp distance is recorded but not gated. The bound
#   for each correctly rounded function is 0, set when M1 dispatches it (ADR 009); the stdlib counterparts here are
#   the step 8 baseline;
# - accepted: a divergence an ADR accepts (ADR 9: the correctly rounded rows, tests/golden/<module>.cr.tsv);
# - pending: its function isn't ported yet (no dispatcher entry).
#
# Per function it prints the row counts and the ulp histogram. Shadow lines (`fn ~ candidate`) compare the same rows
# against another Cyrius candidate and are never gated. The exit code is the number of modules with a failure.

include "tests/ulp.cyr"
include "tests/lib.cyr"

alloc_init();

include "tests/parity_core.cyr"
include "tests/constants_rows.cyr"

# ── cross-target digests (M0 step 8) ────────────────────────────────────────────────
# A 64-bit FNV-1a fold of every output word the port returns for a function, in row order (pravash's). Run on x86_64
# ELF, x86_64 PE and aarch64: equal digests mean bit-identical results on every row, which ADR 007 row 11 promises and
# histograms alone can't show. Slots 0–10 are the dispatched class-C functions, 11 the class-A/B math rows together,
# 12 the constants, 13–16 the native-builtin shadows (which differ on aarch64 by design: there the builtins are the
# polyfills).
var _PAR_DG_N = 17;
var _par_dg[136];

fn _par_dg_init() {
    for (var k = 0; k < _PAR_DG_N; k = k + 1) { store64(&_par_dg + k * 8, 0xcbf29ce484222325); }
    return 0;
}

# The digest slot of a math function's dispatched outputs.
#must_use
fn _par_dg_slot(fp, fl): i64 {
    if (_par_eq(fp, fl, "f64::exp") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::ln") == 1) { return 1; }
    if (_par_eq(fp, fl, "f64::ln_1p") == 1) { return 2; }
    if (_par_eq(fp, fl, "f64::exp_m1") == 1) { return 3; }
    if (_par_eq(fp, fl, "f64::powf") == 1) { return 4; }
    if (_par_eq(fp, fl, "f64::sin") == 1) { return 5; }
    if (_par_eq(fp, fl, "f64::cos") == 1) { return 6; }
    if (_par_eq(fp, fl, "f64::tan") == 1) { return 7; }
    if (_par_eq(fp, fl, "f64::atan") == 1) { return 8; }
    if (_par_eq(fp, fl, "f64::log2") == 1) { return 9; }
    if (_par_eq(fp, fl, "f64::cbrt") == 1) { return 10; }
    return 11;
}

# Folds the got list into digest `slot`.
fn _par_dg_fold(slot) {
    var at = &_par_dg + slot * 8;
    var h = load64(at);
    for (var k = 0; k < _par_got_n; k = k + 1) {
        h = (h ^ load64(_par_got_v + k * 8)) * 0x100000001b3;
    }
    store64(at, h);
    return 0;
}

# Prints digest `slot` under `name`.
fn _par_dg_print(slot, name) {
    print("  digest ", 9);
    _par_print_pad(name, strlen(name), 40);
    print(" 0x", 3);
    fmt_hex(load64(&_par_dg + slot * 8));
    println("");
    return 0;
}

_par_dg_init();

# The descriptive module's buffers (M4), declared here: the json and debug hooks use them too.
var _par_ds_a = 0;
var _par_ds_b = 0;
var _par_ds_o = 0;
var _PAR_DS_CAP = 4096;

# ── hooks ───────────────────────────────────────────────────────────────────────────

# The Rust variant name of an error code (src/error.cyr).
#must_use
fn _par_error_name(code): i64 {
    return pmn_err_name(code);
}

# ── dispatch ────────────────────────────────────────────────────────────────────────
# Each module's dispatcher fills the got list for one row. It returns 1 when it handled the function, 0 when the
# function is pending (not ported), or -1 when the inputs are unusable (a defect, counted as a failure). Add a function
# the moment it's ported.

# `const` rows (input `s:<path>`): src/constants.cyr's value for the path, through the generated lookup
# (tests/constants_rows.cyr). An unknown path is a defect.
fn _par_constants(fp, fl): i64 {
    if (_par_eq(fp, fl, "const") != 1 || _par_in_n != 1) { return 0 - 1; }
    return _par_constant_row(load64(_par_in_v), load64(_par_in_l));
}

# `fmt` rows: serde_json's text for an f64 (`f64::to_json`), written by src/fmtf.cyr (M1 part d1; D5, ADR 007 row 7).
# One builder serves every row (its length reset), so the replay leaves nothing per row on the heap.
var _par_fmt_sb = 0;

fn _par_fmt(fp, fl): i64 {
    if (_par_eq(fp, fl, "f64::to_json") != 1 || _par_in_n != 1) { return 0; }
    if (_par_fmt_sb == 0) { _par_fmt_sb = str_builder_new(); }
    store64(_par_fmt_sb + 8, 0);
    var x: f64 = _par_in(0);
    _pmn_fmt_f64_json(_par_fmt_sb, x);
    _par_got_s(load64(_par_fmt_sb), load64(_par_fmt_sb + 8));
    return 1;
}

# `json::<T>` rows (input `s:<document>`): serde_json 1.0.154's reading of the document as T, through src/json.cyr's
# pre-pass, document arena and readers (M1 parts d3a and d3b): the value types, two test structs (`Pair`, `Shapes`)
# and 1.3.0's two enums (`Kernel`, `PramanaError`). A refusal anywhere is `E:Deserialize`: `_par_json` drops any
# tokens a value appended before it failed.
var _par_json_doc = 0;
var _par_json_buf = 0;
var _PAR_JSON_CAP = 65536;

# The shapes, by code: 0 f64, 1 u64 or usize, 2 bool, 3 String, 4 Vec<f64>, 5 Vec<u64>, 6 Vec<String>,
# 7 Vec<Vec<f64>>, 8 Kernel.
# The shape code of the type named by tp[0, tl) ("f64", "Vec<u64>", ...), or -1.
fn _par_json_code(tp, tl): i64 {
    if (_par_eq(tp, tl, "f64") == 1) { return 0; }
    if (_par_eq(tp, tl, "u64") == 1 || _par_eq(tp, tl, "usize") == 1) { return 1; }
    if (_par_eq(tp, tl, "bool") == 1) { return 2; }
    if (_par_eq(tp, tl, "String") == 1) { return 3; }
    if (_par_eq(tp, tl, "Vec<f64>") == 1) { return 4; }
    if (_par_eq(tp, tl, "Vec<u64>") == 1) { return 5; }
    if (_par_eq(tp, tl, "Vec<String>") == 1) { return 6; }
    if (_par_eq(tp, tl, "Vec<Vec<f64>>") == 1) { return 7; }
    if (_par_eq(tp, tl, "Kernel") == 1) { return 8; }
    return 0 - 1;
}

# Reads node v as shape `code` and appends its tokens: a PMN_ERR_* code, or -1 for a defect.
fn _par_json_emit(code, v): i64 {
    var w[16];
    if (code == 0) {
        var e0 = _pmn_json_f64(v, &w);
        if (e0 == PMN_ERR_NONE) { _par_got_f(load64(&w)); }
        return e0;
    }
    if (code == 1) {
        var e1 = _pmn_json_u64(v, &w);
        if (e1 == PMN_ERR_NONE) { _par_got_i(load64(&w)); }
        return e1;
    }
    if (code == 2) {
        var e2 = _pmn_json_bool(v, &w);
        if (e2 == PMN_ERR_NONE) { _par_got_i(load64(&w)); }
        return e2;
    }
    if (code == 3) {
        var e3 = _pmn_json_str(v, &w);
        if (e3 == PMN_ERR_NONE) { _par_got_text(load64(&w), load64(&w + 8)); }
        return e3;
    }
    if (code == 4 || code == 5) {
        var n = _pmn_json_arr_len(v);
        if (n < 0) { return PMN_ERR_DESERIALIZE; }
        if (n > _PAR_JSON_CAP) { return 0 - 1; }
        var e4 = 0;
        if (code == 4) { e4 = _pmn_json_vec_f64(v, _par_json_buf, _PAR_JSON_CAP); }
        if (code == 5) { e4 = _pmn_json_vec_u64(v, _par_json_buf, _PAR_JSON_CAP); }
        if (e4 != PMN_ERR_NONE) { return e4; }
        _par_got_seq(n);
        for (var k = 0; k < n; k = k + 1) {
            if (code == 4) { _par_got_f(load64(_par_json_buf + k * 8)); }
            if (code == 5) { _par_got_i(load64(_par_json_buf + k * 8)); }
        }
        return PMN_ERR_NONE;
    }
    if (code == 6) {
        var ns = _pmn_json_arr_len(v);
        if (ns < 0) { return PMN_ERR_DESERIALIZE; }
        _par_got_seq(ns);
        for (var a = 0; a < ns; a = a + 1) {
            var e6 = _par_json_emit(3, _pmn_json_arr_get(v, a));
            if (e6 != PMN_ERR_NONE) { return e6; }
        }
        return PMN_ERR_NONE;
    }
    if (code == 7) {
        var sh[24];
        var e7 = _pmn_json_mat_shape(v, &sh);
        if (e7 != PMN_ERR_NONE) { return e7; }
        var r = load64(&sh);
        _par_got_seq(r);
        for (var i = 0; i < r; i = i + 1) {
            if (_par_json_emit(4, _pmn_json_arr_get(v, i)) != PMN_ERR_NONE) { return 0 - 1; }   # the shape read them
        }
        return PMN_ERR_NONE;
    }
    if (code == 8) {
        var kn[32];
        store64(&kn, "Gaussian");
        store64(&kn + 8, "Epanechnikov");
        store64(&kn + 16, "Uniform");
        store64(&kn + 24, "Triangular");
        var e8 = _pmn_json_unit_variant(v, &kn, 4, &w);
        if (e8 != PMN_ERR_NONE) { return e8; }
        var j = load64(&w);
        if (j == 0) { _par_got_e("Kernel.Gaussian"); }
        if (j == 1) { _par_got_e("Kernel.Epanechnikov"); }
        if (j == 2) { _par_got_e("Kernel.Uniform"); }
        if (j == 3) { _par_got_e("Kernel.Triangular"); }
        return PMN_ERR_NONE;
    }
    return 0 - 1;
}

# The test struct `Pair { mean: f64, std_dev: f64 }` (Normal's fields): serde derive's rules, then both fields.
fn _par_json_pair(root): i64 {
    var names[16];
    store64(&names, "mean");
    store64(&names + 8, "std_dev");
    var sl[16];
    var e = _pmn_json_struct(root, &names, 2, &sl);
    if (e != PMN_ERR_NONE) { return e; }
    e = _par_json_emit(0, load64(&sl));
    if (e != PMN_ERR_NONE) { return e; }
    return _par_json_emit(0, load64(&sl + 8));
}

# The test struct `Shapes`: one field of every kind 1.3.0's serialized types hold, in declaration order.
fn _par_json_shapes(root): i64 {
    var names[80];
    var codes[80];
    store64(&names, "x");
    store64(&codes, 0);
    store64(&names + 8, "n");
    store64(&codes + 8, 1);
    store64(&names + 16, "k");
    store64(&codes + 16, 1);
    store64(&names + 24, "flag");
    store64(&codes + 24, 2);
    store64(&names + 32, "name");
    store64(&codes + 32, 3);
    store64(&names + 40, "xs");
    store64(&codes + 40, 4);
    store64(&names + 48, "ns");
    store64(&codes + 48, 5);
    store64(&names + 56, "labels");
    store64(&codes + 56, 6);
    store64(&names + 64, "m");
    store64(&codes + 64, 7);
    store64(&names + 72, "kernel");
    store64(&codes + 72, 8);
    var sl[80];
    var e = _pmn_json_struct(root, &names, 10, &sl);
    if (e != PMN_ERR_NONE) { return e; }
    for (var i = 0; i < 10; i = i + 1) {
        e = _par_json_emit(load64(&codes + i * 8), load64(&sl + i * 8));
        if (e != PMN_ERR_NONE) { return e; }
    }
    return PMN_ERR_NONE;
}

# 1.3.0's `PramanaError`: a newtype variant holding a String. The tokens are the variant and its message (part d4's
# codec keeps the variant alone, ADR 007 row 8).
fn _par_json_error(root): i64 {
    var names[40];
    store64(&names, "InvalidParameter");
    store64(&names + 8, "InvalidSample");
    store64(&names + 16, "ConvergenceFailure");
    store64(&names + 24, "DimensionMismatch");
    store64(&names + 32, "ComputationError");
    var w[16];
    var e = _pmn_json_newtype_variant(root, &names, 5, &w);
    if (e != PMN_ERR_NONE) { return e; }
    var j = load64(&w);
    if (j == 0) { _par_got_e("PramanaError.InvalidParameter"); }
    if (j == 1) { _par_got_e("PramanaError.InvalidSample"); }
    if (j == 2) { _par_got_e("PramanaError.ConvergenceFailure"); }
    if (j == 3) { _par_got_e("PramanaError.DimensionMismatch"); }
    if (j == 4) { _par_got_e("PramanaError.ComputationError"); }
    return _par_json_emit(3, load64(&w + 8));
}

# ── json::write::<T> rows (part d4): the value's tokens in, serde_json's text out, through src/json.cyr's writers into
# one reused builder. _par_json_k is the cursor over the input tokens.
var _par_json_sb = 0;
var _par_json_k = 0;

# The variant index of an `e:<Enum>.<Name>` input token at the cursor among names[0, n), or -1; it advances.
fn _par_jw_variant(names, n): i64 {
    var k = _par_json_k;
    _par_json_k = k + 1;
    if (k >= _par_in_n || load64(_par_in_k + k * 8) != 101) { return 0 - 1; }
    var p = _par_in(k);
    var len = load64(_par_in_l + k * 8);
    var dot = 0;
    while (dot < len && load8(p + dot) != 46) { dot = dot + 1; }
    for (var j = 0; j < n; j = j + 1) {
        var name = load64(names + j * 8);
        if (strlen(name) == len - dot - 1 && memeq(p + dot + 1, name, len - dot - 1) == 1) { return j; }
    }
    return 0 - 1;
}

# Writes the value at the cursor as shape `code` (_par_json_code's numbering): a PMN_ERR_* code, or -1 for a defect.
fn _par_jw(code): i64 {
    var sb = _par_json_sb;
    var k = _par_json_k;
    if (k >= _par_in_n) { return 0 - 1; }
    if (code == 0) {
        _par_json_k = k + 1;
        var x: f64 = _par_in(k);
        return _pmn_json_w_f64(sb, x);
    }
    if (code == 1) {
        _par_json_k = k + 1;
        return _pmn_json_w_u64(sb, _par_in(k));
    }
    if (code == 2) {
        _par_json_k = k + 1;
        return _pmn_json_w_bool(sb, _par_in(k));
    }
    if (code == 3) {
        _par_json_k = k + 1;
        var n = 0;
        var p = _par_in_bytes(k, &n);
        if (p == 0) { return 0 - 1; }
        return _pmn_json_w_str(sb, p, n);
    }
    var cnt = _par_in(k);
    _par_json_k = k + 1;
    if (code == 4 || code == 5) {
        if (cnt > _PAR_JSON_CAP || _par_json_k + cnt > _par_in_n) { return 0 - 1; }
        for (var i = 0; i < cnt; i = i + 1) { store64(_par_json_buf + i * 8, _par_in(_par_json_k + i)); }
        _par_json_k = _par_json_k + cnt;
        if (code == 4) { return _pmn_json_w_vec_f64(sb, _par_json_buf, cnt); }
        return _pmn_json_w_vec_u64(sb, _par_json_buf, cnt);
    }
    if (code == 6) {
        var e = _pmn_json_w_lit(sb, "[");
        for (var a = 0; a < cnt; a = a + 1) {
            if (a > 0 && e == PMN_ERR_NONE) { e = _pmn_json_w_lit(sb, ","); }
            if (e == PMN_ERR_NONE) { e = _par_jw(3); }
        }
        if (e != PMN_ERR_NONE) { return e; }
        return _pmn_json_w_lit(sb, "]");
    }
    if (code == 7) {
        var cols = 0;
        var at = 0;
        for (var r = 0; r < cnt; r = r + 1) {
            var c = _par_in(_par_json_k);
            _par_json_k = _par_json_k + 1;
            if (r == 0) { cols = c; }
            if (c != cols || at + c > _PAR_JSON_CAP) { return 0 - 1; }   # the rows are rectangular
            for (var j = 0; j < c; j = j + 1) { store64(_par_json_buf + (at + j) * 8, _par_in(_par_json_k + j)); }
            _par_json_k = _par_json_k + c;
            at = at + c;
        }
        return _pmn_json_w_mat_f64(sb, _par_json_buf, cnt, cols);
    }
    if (code == 8) {
        _par_json_k = k;
        var kn[32];
        store64(&kn, "Gaussian");
        store64(&kn + 8, "Epanechnikov");
        store64(&kn + 16, "Uniform");
        store64(&kn + 24, "Triangular");
        var v = _par_jw_variant(&kn, 4);
        if (v < 0) { return 0 - 1; }
        return pmn_kernel_to_json(v, sb);                 # M4 part a2: the port's own writer
    }
    return 0 - 1;
}

# A json::write row: the shape's text into the builder, then one `s:` token, or the writer's error.
fn _par_json_write(fp, fl): i64 {
    if (_par_json_sb == 0) {
        _par_json_sb = str_builder_new();
        if (_par_json_buf == 0) { _par_json_buf = alloc(_PAR_JSON_CAP * 8); }
    }
    var sb = _par_json_sb;
    store64(sb + 8, 0);
    _par_json_k = 0;
    var e = 0 - 2;
    if (_par_eq(fp, fl, "json::write::Pair") == 1) {
        e = _pmn_json_w_key(sb, "mean", 1);
        if (e == PMN_ERR_NONE) { e = _par_jw(0); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_key(sb, "std_dev", 0); }
        if (e == PMN_ERR_NONE) { e = _par_jw(0); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_lit(sb, "}"); }
    } elif (_par_eq(fp, fl, "json::write::Shapes") == 1) {
        var names[80];
        store64(&names, "x");
        store64(&names + 8, "n");
        store64(&names + 16, "k");
        store64(&names + 24, "flag");
        store64(&names + 32, "name");
        store64(&names + 40, "xs");
        store64(&names + 48, "ns");
        store64(&names + 56, "labels");
        store64(&names + 64, "m");
        store64(&names + 72, "kernel");
        var codes[80];
        var cv = 0;
        for (var f = 0; f < 10; f = f + 1) {
            cv = f;
            if (f == 2) { cv = 1; }
            if (f > 2) { cv = f - 1; }
            store64(&codes + f * 8, cv);
        }
        e = PMN_ERR_NONE;
        for (var g = 0; g < 10; g = g + 1) {
            if (e == PMN_ERR_NONE) { e = _pmn_json_w_key(sb, load64(&names + g * 8), 1 - (g > 0)); }
            if (e == PMN_ERR_NONE) { e = _par_jw(load64(&codes + g * 8)); }
        }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_lit(sb, "}"); }
    } elif (_par_eq(fp, fl, "json::write::SimpleRng") == 1) {
        var g: PmnSimpleRng;
        if (PmnSimpleRng_new(&g, _par_in(0)) != PMN_ERR_NONE) { return 0 - 1; }
        _par_json_k = 1;
        e = g.to_json(sb);
    } elif (_par_eq(fp, fl, "json::write::Normal") == 1) {
        var wn: PmnNormal;
        var wm: f64 = _par_in(0);
        var ws: f64 = _par_in(1);
        if (PmnNormal_new(&wn, wm, ws) != PMN_ERR_NONE) { return 0 - 1; }
        _par_json_k = 2;
        e = wn.to_json(sb);
    } elif (_par_eq(fp, fl, "json::write::Uniform") == 1) {
        var wu: PmnUniform;
        var wlo: f64 = _par_in(0);
        var whi: f64 = _par_in(1);
        if (PmnUniform_new(&wu, wlo, whi) != PMN_ERR_NONE) { return 0 - 1; }
        _par_json_k = 2;
        e = wu.to_json(sb);
    } elif (_par_eq(fp, fl, "json::write::Exponential") == 1) {
        var we: PmnExponential;
        var wl: f64 = _par_in(0);
        if (PmnExponential_new(&we, wl) != PMN_ERR_NONE) { return 0 - 1; }
        _par_json_k = 1;
        e = we.to_json(sb);
    } elif (_par_eq(fp, fl, "json::write::Cauchy") == 1) {
        var wc: PmnCauchy;
        var wx0: f64 = _par_in(0);
        var wg: f64 = _par_in(1);
        if (PmnCauchy_new(&wc, wx0, wg) != PMN_ERR_NONE) { return 0 - 1; }
        _par_json_k = 2;
        e = wc.to_json(sb);
    } elif (_par_eq(fp, fl, "json::write::Weibull") == 1) {
        var ww: PmnWeibull;
        var wk: f64 = _par_in(0);
        var wwl: f64 = _par_in(1);
        if (PmnWeibull_new(&ww, wk, wwl) != PMN_ERR_NONE) { return 0 - 1; }
        _par_json_k = 2;
        e = ww.to_json(sb);
    } elif (_par_eq(fp, fl, "json::write::Gamma") == 1) {
        var wgd: PmnGamma;
        var wga: f64 = _par_in(0);
        var wgb: f64 = _par_in(1);
        if (PmnGamma_new(&wgd, wga, wgb) != PMN_ERR_NONE) { return 0 - 1; }
        _par_json_k = 2;
        e = wgd.to_json(sb);
    } elif (_par_eq(fp, fl, "json::write::ChiSquared") == 1) {
        var wch: PmnChiSquared;
        var wdf: f64 = _par_in(0);
        if (PmnChiSquared_new(&wch, wdf) != PMN_ERR_NONE) { return 0 - 1; }
        _par_json_k = 1;
        e = wch.to_json(sb);
    } elif (_par_eq(fp, fl, "json::write::Beta") == 1) {
        var wbd: PmnBeta;
        var wba: f64 = _par_in(0);
        var wbb: f64 = _par_in(1);
        if (PmnBeta_new(&wbd, wba, wbb) != PMN_ERR_NONE) { return 0 - 1; }
        _par_json_k = 2;
        e = wbd.to_json(sb);
    } elif (_par_eq(fp, fl, "json::write::FDistribution") == 1) {
        var wfd: PmnFDistribution;
        var wf1: f64 = _par_in(0);
        var wf2: f64 = _par_in(1);
        if (PmnFDistribution_new(&wfd, wf1, wf2) != PMN_ERR_NONE) { return 0 - 1; }
        _par_json_k = 2;
        e = wfd.to_json(sb);
    } elif (_par_eq(fp, fl, "json::write::StudentT") == 1) {
        var wst: PmnStudentT;
        var wsd: f64 = _par_in(0);
        if (PmnStudentT_new(&wst, wsd) != PMN_ERR_NONE) { return 0 - 1; }
        _par_json_k = 1;
        e = wst.to_json(sb);
    } elif (_par_eq(fp, fl, "json::write::Binomial") == 1) {
        var wbi: PmnBinomial;
        var wbp: f64 = _par_in(1);
        if (PmnBinomial_new(&wbi, _par_in(0), wbp) != PMN_ERR_NONE) { return 0 - 1; }
        _par_json_k = 2;
        e = wbi.to_json(sb);
    } elif (_par_eq(fp, fl, "json::write::MultivariateNormal") == 1) {
        var wmv: PmnMultivariateNormal;
        var wmk = _par_mvn_codec_new(&wmv, 0);
        if (wmk < 0) { return 0 - 1; }
        _par_json_k = wmk;
        e = wmv.to_json(sb);
        var wmd = PmnMultivariateNormal_drop(&wmv);
    } elif (_par_eq(fp, fl, "json::write::KernelDensity") == 1) {
        var wkn = _par_in(0);
        if (_par_ds_a == 0) { _par_ds_a = alloc(_PAR_DS_CAP * 8); }
        if (wkn < 0 || wkn > _PAR_DS_CAP || _par_ds_a == 0) { return 0 - 1; }
        _par_in_f64s(0, _par_ds_a);
        var wkh: f64 = _par_in(wkn + 1);
        var wkk = _par_in_kernel(wkn + 2);
        var wkd: PmnKernelDensity;
        if (PmnKernelDensity_new(&wkd, _par_ds_a, wkn, wkh, wkk) != PMN_ERR_NONE) { return 0 - 1; }
        _par_json_k = wkn + 3;
        e = wkd.to_json(sb);
        var wkx = PmnKernelDensity_drop(&wkd);
    } elif (_par_eq(fp, fl, "json::write::PcaResult") == 1) {
        var wpr: PmnPcaResult;
        var wpk = _par_pca_from_toks(0, &wpr);
        if (wpk < 0) { return 0 - 1; }
        _par_json_k = wpk;
        e = wpr.to_json(sb);
        var wpx = PmnPcaResult_drop(&wpr);
    } elif (_par_eq(fp, fl, "json::write::Poisson") == 1) {
        var wpo: PmnPoisson;
        var wpl: f64 = _par_in(0);
        if (PmnPoisson_new(&wpo, wpl) != PMN_ERR_NONE) { return 0 - 1; }
        _par_json_k = 1;
        e = wpo.to_json(sb);
    } elif (_par_eq(fp, fl, "json::write::Bernoulli") == 1) {
        var wb: PmnBernoulli;
        var wp: f64 = _par_in(0);
        if (PmnBernoulli_new(&wb, wp) != PMN_ERR_NONE) { return 0 - 1; }
        _par_json_k = 1;
        e = wb.to_json(sb);
    } elif (_par_eq(fp, fl, "json::write::PramanaError") == 1) {
        var en[40];
        store64(&en, "InvalidParameter");
        store64(&en + 8, "InvalidSample");
        store64(&en + 16, "ConvergenceFailure");
        store64(&en + 24, "DimensionMismatch");
        store64(&en + 32, "ComputationError");
        var v = _par_jw_variant(&en, 5);
        if (v < 0) { return 0 - 1; }
        e = pmn_err_to_json(PMN_ERR_INVALID_PARAMETER + v, sb);
    } else {
        var code = _par_json_code(fp + 13, fl - 13);     # the T of json::write::T
        if (code >= 0) { e = _par_jw(code); }
    }
    if (e == 0 - 2) { return 0; }
    if (e == 0 - 1 || _par_json_k != _par_in_n) { return 0 - 1; }
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    _par_got_text(load64(sb), load64(sb + 8));
    return 1;
}

# json::PramanaError::code rows: the error codec's reading, pmn_err_from_json, the variant alone.
fn _par_json_err_code(): i64 {
    var n = 0;
    var doc = _par_in_bytes(0, &n);
    if (doc == 0) { return 0 - 1; }
    var t, v = pmn_err_from_json(doc, n);
    if (is_err_result(t) == 1) {
        _par_got_err(v);
        return 1;
    }
    if (v == PMN_ERR_INVALID_PARAMETER) { _par_got_e("PramanaError.InvalidParameter"); }
    if (v == PMN_ERR_INVALID_SAMPLE) { _par_got_e("PramanaError.InvalidSample"); }
    if (v == PMN_ERR_CONVERGENCE_FAILURE) { _par_got_e("PramanaError.ConvergenceFailure"); }
    if (v == PMN_ERR_DIMENSION_MISMATCH) { _par_got_e("PramanaError.DimensionMismatch"); }
    if (v == PMN_ERR_COMPUTATION_ERROR) { _par_got_e("PramanaError.ComputationError"); }
    return 1;
}

# json::SimpleRng rows: PmnSimpleRng_from_json, the state it holds.
fn _par_json_simple_rng(): i64 {
    var n = 0;
    var doc = _par_in_bytes(0, &n);
    if (doc == 0) { return 0 - 1; }
    var g: PmnSimpleRng;
    var e = PmnSimpleRng_from_json(&g, doc, n);
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    _par_got_i(g.state);
    return 1;
}

# json::Normal rows (M3 part a1): PmnNormal_from_json, the two fields it holds.
fn _par_json_normal(): i64 {
    var n = 0;
    var doc = _par_in_bytes(0, &n);
    if (doc == 0) { return 0 - 1; }
    var d: PmnNormal;
    var e = PmnNormal_from_json(&d, doc, n);
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    var m: f64 = d.mean;
    var sd: f64 = d.std_dev;
    _par_got_f(m);
    _par_got_f(sd);
    return 1;
}

# json::Uniform, json::Exponential and json::Bernoulli rows (M3 part a2), json::Cauchy and json::Weibull (a3),
# json::Gamma and json::ChiSquared (b1), json::Beta, json::StudentT and json::FDistribution (b2), json::Poisson (c1):
# each one's from_json, the fields it holds.
fn _par_json_dist(fp, fl): i64 {
    var n = 0;
    var doc = _par_in_bytes(0, &n);
    if (doc == 0) { return 0 - 1; }
    var e = 0 - 1;
    var a: f64 = 0.0;
    var b: f64 = 0.0;
    var two = 0;
    if (_par_eq(fp, fl, "json::Uniform") == 1) {
        var u: PmnUniform;
        e = PmnUniform_from_json(&u, doc, n);
        a = u.min;
        b = u.max;
        two = 1;
    } elif (_par_eq(fp, fl, "json::Exponential") == 1) {
        var x: PmnExponential;
        e = PmnExponential_from_json(&x, doc, n);
        a = x.lambda;
    } elif (_par_eq(fp, fl, "json::Cauchy") == 1) {
        var c: PmnCauchy;
        e = PmnCauchy_from_json(&c, doc, n);
        a = c.x0;
        b = c.gamma;
        two = 1;
    } elif (_par_eq(fp, fl, "json::Weibull") == 1) {
        var w: PmnWeibull;
        e = PmnWeibull_from_json(&w, doc, n);
        a = w.k;
        b = w.lambda;
        two = 1;
    } elif (_par_eq(fp, fl, "json::Gamma") == 1) {
        var gd: PmnGamma;
        e = PmnGamma_from_json(&gd, doc, n);
        a = gd.alpha;
        b = gd.beta;
        two = 1;
    } elif (_par_eq(fp, fl, "json::ChiSquared") == 1) {
        var ch: PmnChiSquared;
        e = PmnChiSquared_from_json(&ch, doc, n);
        a = ch.df;
    } elif (_par_eq(fp, fl, "json::Beta") == 1) {
        var bd: PmnBeta;
        e = PmnBeta_from_json(&bd, doc, n);
        a = bd.alpha;
        b = bd.beta;
        two = 1;
    } elif (_par_eq(fp, fl, "json::FDistribution") == 1) {
        var fd: PmnFDistribution;
        e = PmnFDistribution_from_json(&fd, doc, n);
        a = fd.d1;
        b = fd.d2;
        two = 1;
    } elif (_par_eq(fp, fl, "json::StudentT") == 1) {
        var st: PmnStudentT;
        e = PmnStudentT_from_json(&st, doc, n);
        a = st.df;
    } elif (_par_eq(fp, fl, "json::Poisson") == 1) {
        var po: PmnPoisson;
        e = PmnPoisson_from_json(&po, doc, n);
        a = po.lambda;
    } elif (_par_eq(fp, fl, "json::Bernoulli") == 1) {
        var y: PmnBernoulli;
        e = PmnBernoulli_from_json(&y, doc, n);
        a = y.p;
    } else {
        return 0;
    }
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    _par_got_f(a);
    if (two == 1) { _par_got_f(b); }
    return 1;
}

# json::Binomial rows (M3 part c2): PmnBinomial_from_json, its u64 n and f64 p.
fn _par_json_binomial(): i64 {
    var n = 0;
    var doc = _par_in_bytes(0, &n);
    if (doc == 0) { return 0 - 1; }
    var d: PmnBinomial;
    var e = PmnBinomial_from_json(&d, doc, n);
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    _par_got_i(d.n);
    var p: f64 = d.p;
    _par_got_f(p);
    return 1;
}

# The MultivariateNormal rows' buffers (M3 part d2): the mean, the covariance and a point or a draw, 4,096 f64s each.
var _par_mv_m = 0;
var _par_mv_c = 0;
var _par_mv_x = 0;
var _PAR_MV_CAP = 4096;

# json::MultivariateNormal rows (M3 part d2): PmnMultivariateNormal_from_json, then its mean and covariance as the
# codec's tokens (`v:d` and the mean, `v:d` and each row's `v:d` and entries); dropped after.
fn _par_json_mvn(): i64 {
    var n = 0;
    var doc = _par_in_bytes(0, &n);
    if (doc == 0) { return 0 - 1; }
    var m: PmnMultivariateNormal;
    var e = PmnMultivariateNormal_from_json(&m, doc, n);
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    var d = m.dim();
    var mu = m.mean_vec();
    var cv = m.covariance_matrix();
    _par_got_seq(d);
    for (var k = 0; k < d; k = k + 1) { _par_got_f(load64(mu + k * 8)); }
    _par_got_seq(d);
    for (var r = 0; r < d; r = r + 1) {
        _par_got_seq(d);
        for (var c = 0; c < d; c = c + 1) { _par_got_f(load64(cv + (r * d + c) * 8)); }
    }
    var e1 = PmnMultivariateNormal_drop(&m);
    return 1;
}

# A MultivariateNormal from the codec's tokens at token k (as _par_json_mvn emits them), into m: the tokens read, or
# -1 when they don't hold a square case the constructor accepts. The caller drops m.
fn _par_mvn_codec_new(m, k): i64 {
    if (_par_mv_m == 0) {
        _par_mv_m = alloc(_PAR_MV_CAP * 8);
        _par_mv_c = alloc(_PAR_MV_CAP * 8);
        _par_mv_x = alloc(_PAR_MV_CAP * 8);
        if (_par_mv_m == 0 || _par_mv_c == 0 || _par_mv_x == 0) { return 0 - 1; }
    }
    var d = _par_in(k);
    if (d <= 0 || d > 64 || _par_in_f64s(k, _par_mv_m) != d || _par_in(k + 1 + d) != d) { return 0 - 1; }
    var at = k + 2 + d;
    for (var r = 0; r < d; r = r + 1) {
        if (_par_in_f64s(at, _par_mv_c + r * d * 8) != d) { return 0 - 1; }
        at = at + 1 + d;
    }
    if (PmnMultivariateNormal_new(m, _par_mv_m, d, _par_mv_c, d, d) != PMN_ERR_NONE) { return 0 - 1; }
    return at - k;
}

# json::PcaResult rows (M4 part a3): the decoded lists, or the error.
fn _par_json_pca(): i64 {
    var n = 0;
    var doc = _par_in_bytes(0, &n);
    if (doc == 0) { return 0 - 1; }
    var r: PmnPcaResult;
    var e = PmnPcaResult_from_json(&r, doc, n);
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    _par_got_pca(&r);
    PmnPcaResult_drop(&r);
    return 1;
}

# json::Kernel rows through the port's reader (M4 part a2).
fn _par_json_kernel(): i64 {
    var n = 0;
    var doc = _par_in_bytes(0, &n);
    if (doc == 0) { return 0 - 1; }
    var k = 0;
    var e = pmn_kernel_from_json(&k, doc, n);
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    if (k == PMN_KERNEL_GAUSSIAN) { _par_got_e("Kernel.Gaussian"); }
    if (k == PMN_KERNEL_EPANECHNIKOV) { _par_got_e("Kernel.Epanechnikov"); }
    if (k == PMN_KERNEL_UNIFORM) { _par_got_e("Kernel.Uniform"); }
    if (k == PMN_KERNEL_TRIANGULAR) { _par_got_e("Kernel.Triangular"); }
    return 1;
}

# json::KernelDensity rows: the data, the bandwidth and the kernel of the decoded value, or the error.
fn _par_json_kde(): i64 {
    var n = 0;
    var doc = _par_in_bytes(0, &n);
    if (doc == 0) { return 0 - 1; }
    var kd: PmnKernelDensity;
    var e = PmnKernelDensity_from_json(&kd, doc, n);
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    var d = kd.len();
    var p = kd.data_ptr();
    _par_got_seq(d);
    for (var k = 0; k < d; k = k + 1) { _par_got_f(load64(p + k * 8)); }
    var h: f64 = kd.bandwidth;
    _par_got_f(h);
    var kn = kd.kernel;
    if (kn == PMN_KERNEL_GAUSSIAN) { _par_got_e("Kernel.Gaussian"); }
    if (kn == PMN_KERNEL_EPANECHNIKOV) { _par_got_e("Kernel.Epanechnikov"); }
    if (kn == PMN_KERNEL_UNIFORM) { _par_got_e("Kernel.Uniform"); }
    if (kn == PMN_KERNEL_TRIANGULAR) { _par_got_e("Kernel.Triangular"); }
    var e1 = PmnKernelDensity_drop(&kd);
    return 1;
}

fn _par_json_value(fp, fl, root): i64 {
    if (_par_eq(fp, fl, "json::Pair") == 1) { return _par_json_pair(root); }
    if (_par_eq(fp, fl, "json::Shapes") == 1) { return _par_json_shapes(root); }
    if (_par_eq(fp, fl, "json::PramanaError") == 1) { return _par_json_error(root); }
    if (fl <= 6) { return 0 - 2; }
    var code = _par_json_code(fp + 6, fl - 6);           # the T of json::T
    if (code < 0) { return 0 - 2; }
    return _par_json_emit(code, root);
}

fn _par_json(fp, fl): i64 {
    if (fl > 13 && memeq(fp, "json::write::", 13) == 1) { return _par_json_write(fp, fl); }
    if (_par_eq(fp, fl, "json::PramanaError::code") == 1) { return _par_json_err_code(); }
    if (_par_eq(fp, fl, "json::SimpleRng") == 1) { return _par_json_simple_rng(); }
    if (_par_eq(fp, fl, "json::Normal") == 1) { return _par_json_normal(); }
    if (_par_eq(fp, fl, "json::Binomial") == 1) { return _par_json_binomial(); }
    if (_par_eq(fp, fl, "json::MultivariateNormal") == 1) { return _par_json_mvn(); }
    if (_par_eq(fp, fl, "json::KernelDensity") == 1) { return _par_json_kde(); }
    if (_par_eq(fp, fl, "json::Kernel") == 1) { return _par_json_kernel(); }
    if (_par_eq(fp, fl, "json::PcaResult") == 1) { return _par_json_pca(); }
    var jd = _par_json_dist(fp, fl);
    if (jd != 0) { return jd; }
    if (_par_in_n != 1) { return 0 - 1; }
    if (_par_json_doc == 0) {
        _par_json_doc = alloc(_PMN_JSON_DOC_SIZE);
        _par_json_buf = alloc(_PAR_JSON_CAP * 8);
        if (_par_json_doc == 0 || _par_json_buf == 0) { return 0 - 1; }
    }
    var n = 0;
    var doc = _par_in_bytes(0, &n);
    if (doc == 0) { return 0 - 1; }
    var e = _pmn_json_open(_par_json_doc, doc, n);
    var r = 1;
    if (e == PMN_ERR_NONE) {
        e = _par_json_value(fp, fl, _pmn_json_root(_par_json_doc));
        if (e == 0 - 2) { r = 0; }
        if (e == 0 - 1) { r = 0 - 1; }
    }
    _pmn_json_close(_par_json_doc);
    if (r == 1 && e != PMN_ERR_NONE) {
        _par_got_n = 0;
        _par_got_err(e);
    }
    return r;
}

# `rng` rows (M1 part e1): 1.3.0's SimpleRng through src/rng.cyr. Each draw goes through a bounded generic, as every
# pramana API that takes Rust's `&mut impl Rng` does (D7, amended).
fn _par_draw<R: PmnRng>(g: *R): f64 {
    var r: f64 = g.next_f64();
    return r;
}

fn _par_rng(fp, fl): i64 {
    if (_par_in_n != 2) { return 0 - 1; }
    var g: PmnSimpleRng;
    if (PmnSimpleRng_new(&g, _par_in(0)) != PMN_ERR_NONE) { return 0 - 1; }
    var n = _par_in(1);
    if (_par_eq(fp, fl, "SimpleRng::next_f64") == 1) {
        _par_got_seq(n);
        for (var k = 0; k < n; k = k + 1) {
            var x: f64 = _par_draw(&g);
            _par_got_f(x);
        }
        return 1;
    }
    if (_par_eq(fp, fl, "SimpleRng::digest") == 1) {
        var h = 0xCBF29CE484222325;
        for (var j = 0; j < n; j = j + 1) {
            var y: f64 = _par_draw(&g);
            h = (h ^ load64(&y)) * 0x100000001B3;
        }
        _par_got_i(h);
        return 1;
    }
    return 0;
}

# `debug` rows (M1 part f; D12): Rust's derived Debug, the second input 0 for `{:?}` and 1 for `{:#?}`.
var _par_dbg_sb = 0;

fn _par_debug(fp, fl): i64 {
    if (_par_dbg_sb == 0) { _par_dbg_sb = str_builder_new(); }
    var sb = _par_dbg_sb;
    store64(sb + 8, 0);
    var e = 0 - 1;
    if (_par_eq(fp, fl, "debug::f64") == 1) {
        if (_par_in_n != 1) { return 0 - 1; }
        var x: f64 = _par_in(0);
        e = _pmn_dbg_f64(sb, x);
        if (e != PMN_ERR_NONE) { return 0 - 1; }
        _par_got_text(load64(sb), load64(sb + 8));
        return 1;
    }
    if (_par_eq(fp, fl, "debug::Normal") == 1) {
        if (_par_in_n != 3) { return 0 - 1; }
        var dn: PmnNormal;
        var dm: f64 = _par_in(0);
        var ds: f64 = _par_in(1);
        if (PmnNormal_new(&dn, dm, ds) != PMN_ERR_NONE) { return 0 - 1; }
        e = dn.debug(sb, _par_in(2));
        if (e != PMN_ERR_NONE) { return 0 - 1; }
        _par_got_text(load64(sb), load64(sb + 8));
        return 1;
    }
    if (_par_eq(fp, fl, "debug::Uniform") == 1) {
        if (_par_in_n != 3) { return 0 - 1; }
        var du: PmnUniform;
        var dlo: f64 = _par_in(0);
        var dhi: f64 = _par_in(1);
        if (PmnUniform_new(&du, dlo, dhi) != PMN_ERR_NONE) { return 0 - 1; }
        e = du.debug(sb, _par_in(2));
        if (e != PMN_ERR_NONE) { return 0 - 1; }
        _par_got_text(load64(sb), load64(sb + 8));
        return 1;
    }
    if (_par_eq(fp, fl, "debug::Cauchy") == 1) {
        if (_par_in_n != 3) { return 0 - 1; }
        var dc: PmnCauchy;
        var dx0: f64 = _par_in(0);
        var dg: f64 = _par_in(1);
        if (PmnCauchy_new(&dc, dx0, dg) != PMN_ERR_NONE) { return 0 - 1; }
        e = dc.debug(sb, _par_in(2));
        if (e != PMN_ERR_NONE) { return 0 - 1; }
        _par_got_text(load64(sb), load64(sb + 8));
        return 1;
    }
    if (_par_eq(fp, fl, "debug::Weibull") == 1) {
        if (_par_in_n != 3) { return 0 - 1; }
        var dw: PmnWeibull;
        var dk: f64 = _par_in(0);
        var dwl: f64 = _par_in(1);
        if (PmnWeibull_new(&dw, dk, dwl) != PMN_ERR_NONE) { return 0 - 1; }
        e = dw.debug(sb, _par_in(2));
        if (e != PMN_ERR_NONE) { return 0 - 1; }
        _par_got_text(load64(sb), load64(sb + 8));
        return 1;
    }
    if (_par_eq(fp, fl, "debug::Gamma") == 1) {
        if (_par_in_n != 3) { return 0 - 1; }
        var dgd: PmnGamma;
        var dga: f64 = _par_in(0);
        var dgb: f64 = _par_in(1);
        if (PmnGamma_new(&dgd, dga, dgb) != PMN_ERR_NONE) { return 0 - 1; }
        e = dgd.debug(sb, _par_in(2));
        if (e != PMN_ERR_NONE) { return 0 - 1; }
        _par_got_text(load64(sb), load64(sb + 8));
        return 1;
    }
    if (_par_eq(fp, fl, "debug::Beta") == 1) {
        if (_par_in_n != 3) { return 0 - 1; }
        var dbd: PmnBeta;
        var dba: f64 = _par_in(0);
        var dbb: f64 = _par_in(1);
        if (PmnBeta_new(&dbd, dba, dbb) != PMN_ERR_NONE) { return 0 - 1; }
        e = dbd.debug(sb, _par_in(2));
        if (e != PMN_ERR_NONE) { return 0 - 1; }
        _par_got_text(load64(sb), load64(sb + 8));
        return 1;
    }
    if (_par_eq(fp, fl, "debug::FDistribution") == 1) {
        if (_par_in_n != 3) { return 0 - 1; }
        var dfd: PmnFDistribution;
        var df1: f64 = _par_in(0);
        var df2: f64 = _par_in(1);
        if (PmnFDistribution_new(&dfd, df1, df2) != PMN_ERR_NONE) { return 0 - 1; }
        e = dfd.debug(sb, _par_in(2));
        if (e != PMN_ERR_NONE) { return 0 - 1; }
        _par_got_text(load64(sb), load64(sb + 8));
        return 1;
    }
    if (_par_eq(fp, fl, "debug::MultivariateNormal") == 1) {
        var dmv: PmnMultivariateNormal;
        var dmk = _par_mvn_codec_new(&dmv, 0);
        if (dmk < 0 || dmk + 1 != _par_in_n) { return 0 - 1; }
        e = dmv.debug(sb, _par_in(dmk));
        var dmd = PmnMultivariateNormal_drop(&dmv);
        if (e != PMN_ERR_NONE) { return 0 - 1; }
        _par_got_text(load64(sb), load64(sb + 8));
        return 1;
    }
    if (_par_eq(fp, fl, "debug::Kernel") == 1) {
        if (_par_in_n != 2) { return 0 - 1; }
        e = pmn_kernel_debug(_par_in_kernel(0), sb, _par_in(1));
        if (e != PMN_ERR_NONE) { return 0 - 1; }
        _par_got_text(load64(sb), load64(sb + 8));
        return 1;
    }
    if (_par_eq(fp, fl, "debug::KernelDensity") == 1) {
        var dkn = _par_in(0);
        if (dkn < 0 || dkn > _PAR_DS_CAP || dkn + 4 != _par_in_n) { return 0 - 1; }
        if (_par_ds_a == 0) { _par_ds_a = alloc(_PAR_DS_CAP * 8); }
        _par_in_f64s(0, _par_ds_a);
        var dkh: f64 = _par_in(dkn + 1);
        var dkd: PmnKernelDensity;
        if (PmnKernelDensity_new(&dkd, _par_ds_a, dkn, dkh, _par_in_kernel(dkn + 2)) != PMN_ERR_NONE) { return 0 - 1; }
        e = dkd.debug(sb, _par_in(dkn + 3));
        var dkx = PmnKernelDensity_drop(&dkd);
        if (e != PMN_ERR_NONE) { return 0 - 1; }
        _par_got_text(load64(sb), load64(sb + 8));
        return 1;
    }
    if (_par_eq(fp, fl, "debug::PcaResult") == 1) {
        var dpr: PmnPcaResult;
        var dpk = _par_pca_from_toks(0, &dpr);
        if (dpk < 0 || dpk + 1 != _par_in_n) { return 0 - 1; }
        e = dpr.debug(sb, _par_in(dpk));
        var dpx = PmnPcaResult_drop(&dpr);
        if (e != PMN_ERR_NONE) { return 0 - 1; }
        _par_got_text(load64(sb), load64(sb + 8));
        return 1;
    }
    if (_par_eq(fp, fl, "debug::Binomial") == 1) {
        if (_par_in_n != 3) { return 0 - 1; }
        var dbi: PmnBinomial;
        var dbp: f64 = _par_in(1);
        if (PmnBinomial_new(&dbi, _par_in(0), dbp) != PMN_ERR_NONE) { return 0 - 1; }
        e = dbi.debug(sb, _par_in(2));
        if (e != PMN_ERR_NONE) { return 0 - 1; }
        _par_got_text(load64(sb), load64(sb + 8));
        return 1;
    }
    if (_par_in_n != 2) { return 0 - 1; }
    var alt = _par_in(1);
    if (_par_eq(fp, fl, "debug::Poisson") == 1) {
        var dpo: PmnPoisson;
        var dpl: f64 = _par_in(0);
        if (PmnPoisson_new(&dpo, dpl) != PMN_ERR_NONE) { return 0 - 1; }
        e = dpo.debug(sb, alt);
    } elif (_par_eq(fp, fl, "debug::StudentT") == 1) {
        var dst: PmnStudentT;
        var dsd: f64 = _par_in(0);
        if (PmnStudentT_new(&dst, dsd) != PMN_ERR_NONE) { return 0 - 1; }
        e = dst.debug(sb, alt);
    } elif (_par_eq(fp, fl, "debug::ChiSquared") == 1) {
        var dch: PmnChiSquared;
        var ddf: f64 = _par_in(0);
        if (PmnChiSquared_new(&dch, ddf) != PMN_ERR_NONE) { return 0 - 1; }
        e = dch.debug(sb, alt);
    } elif (_par_eq(fp, fl, "debug::Exponential") == 1) {
        var de: PmnExponential;
        var dl: f64 = _par_in(0);
        if (PmnExponential_new(&de, dl) != PMN_ERR_NONE) { return 0 - 1; }
        e = de.debug(sb, alt);
    } elif (_par_eq(fp, fl, "debug::Bernoulli") == 1) {
        var db: PmnBernoulli;
        var dp: f64 = _par_in(0);
        if (PmnBernoulli_new(&db, dp) != PMN_ERR_NONE) { return 0 - 1; }
        e = db.debug(sb, alt);
    } elif (_par_eq(fp, fl, "debug::SimpleRng") == 1) {
        var g: PmnSimpleRng;
        if (PmnSimpleRng_new(&g, _par_in(0)) != PMN_ERR_NONE) { return 0 - 1; }
        e = g.debug(sb, alt);
    } elif (_par_eq(fp, fl, "debug::PramanaError") == 1) {
        var en[40];
        store64(&en, "InvalidParameter");
        store64(&en + 8, "InvalidSample");
        store64(&en + 16, "ConvergenceFailure");
        store64(&en + 24, "DimensionMismatch");
        store64(&en + 32, "ComputationError");
        _par_json_k = 0;
        var v = _par_jw_variant(&en, 5);
        if (v < 0) { return 0 - 1; }
        e = pmn_err_debug(PMN_ERR_INVALID_PARAMETER + v, sb, alt);
    } else {
        return 0;
    }
    if (e != PMN_ERR_NONE) { return 0 - 1; }
    _par_got_text(load64(sb), load64(sb + 8));
    return 1;
}

# `bridge` rows (M1 part e3): src/bridge.cyr. A slice is `v:n` and its values, read into a buffer; a slice of pairs
# is `v:n` then each pair's integer and f64, read into 16-byte records; a tuple's elements come back in order.
var _par_br_a = 0;
var _par_br_b = 0;
var _PAR_BR_CAP = 4096;

# The `v:n` slice at token k into buf (n words, or n records when `pairs`): n, with the next token index at *next.
fn _par_br_read(k, buf, pairs, next): i64 {
    if (k >= _par_in_n || load64(_par_in_k + k * 8) != 118) { return 0 - 1; }
    var n = _par_in(k);
    var per = 1;
    if (pairs == 1) { per = 2; }
    if (n < 0 || n > _PAR_BR_CAP || k + 1 + n * per > _par_in_n) { return 0 - 1; }
    for (var i = 0; i < n * per; i = i + 1) { store64(buf + i * 8, _par_in(k + 1 + i)); }
    store64(next, k + 1 + n * per);
    return n;
}

fn _par_bridge(fp, fl): i64 {
    if (_par_br_a == 0) {
        _par_br_a = alloc(_PAR_BR_CAP * 16);
        _par_br_b = alloc(_PAR_BR_CAP * 16);
    }
    var out[40];
    var x: f64 = _par_in(0);
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "bridge::ensemble_spread_to_confidence") == 1) {
        var r0: f64 = pmn_ensemble_spread_to_confidence(x, y);
        _par_got_f(r0);
        return 1;
    }
    if (_par_eq(fp, fl, "bridge::observation_error_to_likelihood") == 1) {
        var r1: f64 = pmn_observation_error_to_likelihood(x, y);
        _par_got_f(r1);
        return 1;
    }
    if (_par_eq(fp, fl, "bridge::sensor_noise_to_std_dev") == 1) {
        var r2: f64 = pmn_sensor_noise_to_std_dev(x, y);
        _par_got_f(r2);
        return 1;
    }
    if (_par_eq(fp, fl, "bridge::z_rates_to_d_prime") == 1) {
        var r3: f64 = pmn_z_rates_to_d_prime(x, y);
        _par_got_f(r3);
        return 1;
    }
    if (_par_eq(fp, fl, "bridge::uncertainty_to_gaussian") == 1) {
        if (pmn_uncertainty_to_gaussian(x, y, &out) != PMN_ERR_NONE) { return 0 - 1; }
        _par_got_f(load64(&out));
        _par_got_f(load64(&out + 8));
        return 1;
    }
    if (_par_eq(fp, fl, "bridge::item_variances_to_alpha") == 1) {
        var s: f64 = _par_in(1);
        var t: f64 = _par_in(2);
        var r4: f64 = pmn_item_variances_to_alpha(_par_in(0), s, t);
        _par_got_f(r4);
        return 1;
    }
    if (_par_eq(fp, fl, "bridge::replicates_to_t_statistic") == 1) {
        if (_par_in_n != 6) { return 0 - 1; }
        var sa: f64 = _par_in(1);
        var mb: f64 = _par_in(3);
        var sb: f64 = _par_in(4);
        var r5: f64 = pmn_replicates_to_t_statistic(x, sa, _par_in(2), mb, sb, _par_in(5));
        _par_got_f(r5);
        return 1;
    }
    var next = 0;
    if (_par_eq(fp, fl, "bridge::yields_to_mean_variance") == 1) {
        var n = _par_br_read(0, _par_br_a, 0, &next);
        if (n < 0 || pmn_yields_to_mean_variance(_par_br_a, n, &out) != PMN_ERR_NONE) { return 0 - 1; }
        _par_got_f(load64(&out));
        _par_got_f(load64(&out + 8));
        return 1;
    }
    if (_par_eq(fp, fl, "bridge::trait_scores_to_correlation") == 1) {
        var na = _par_br_read(0, _par_br_a, 0, &next);
        if (na < 0) { return 0 - 1; }
        var nb = _par_br_read(next, _par_br_b, 0, &next);
        if (nb < 0 || pmn_trait_scores_to_correlation(_par_br_a, na, _par_br_b, nb, &out) != PMN_ERR_NONE) {
            return 0 - 1;
        }
        for (var k = 0; k < 5; k = k + 1) { _par_got_f(load64(&out + k * 8)); }
        return 1;
    }
    var e = 0 - 1;
    var nr = _par_br_read(0, _par_br_a, 1, &next);
    if (nr < 0) { return 0 - 1; }
    if (_par_eq(fp, fl, "bridge::learning_trials_to_power_law") == 1) {
        e = pmn_learning_trials_to_power_law(_par_br_a, nr, &out);
    } elif (_par_eq(fp, fl, "bridge::response_times_to_hick_params") == 1) {
        e = pmn_response_times_to_hick_params(_par_br_a, nr, &out);
    } else {
        return 0;
    }
    if (e != PMN_ERR_NONE) { return 0 - 1; }
    _par_got_f(load64(&out));
    _par_got_f(load64(&out + 8));
    return 1;
}

# `combinatorics` rows (M1 part e2): src/combinatorics.cyr. A u128 is two tokens, its low word then its high word.
fn _par_combinatorics(fp, fl): i64 {
    var x: PmnU128;
    var e = 0 - 1;
    if (_par_eq(fp, fl, "combinatorics::stirling_approx") == 1) {
        if (_par_in_n != 1) { return 0 - 1; }
        var s: f64 = pmn_stirling_approx(_par_in(0));
        _par_got_f(s);
        return 1;
    }
    if (_par_eq(fp, fl, "combinatorics::factorial") == 1) {
        if (_par_in_n != 1) { return 0 - 1; }
        e = pmn_factorial(_par_in(0), &x);
    } elif (_par_in_n == 2 && _par_eq(fp, fl, "combinatorics::permutations") == 1) {
        e = pmn_permutations(_par_in(0), _par_in(1), &x);
    } elif (_par_in_n == 2 && _par_eq(fp, fl, "combinatorics::combinations") == 1) {
        e = pmn_combinations(_par_in(0), _par_in(1), &x);
    } else {
        return 0;
    }
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    _par_got_i(x.lo);
    _par_got_i(x.hi);
    return 1;
}

# `f64::*` and `u64::*` rows: the Rust std reference values (port plan §8.1), every one through src/mathx.cyr, the
# names the rest of the port calls (M1 part c):
# - the exact builtins sqrt, abs and floor;
# - the fdlibm word operations, which the port writes inline: `bits >> 32` (logical) and `bits & 0xFFFFFFFF00000000`;
# - the Rust-semantics helpers (ledger L2): min, max and clamp ignore a NaN as Rust does, fract is x − trunc(x),
#   is_nan, is_finite and total_cmp, `as usize` saturates, `u64 as f64` is unsigned, and powi is LLVM's
#   square-and-multiply;
# - the transcendentals, correctly rounded at 0 ulp (ADR 009): kimiya's exp, ln, exp_m1, powf, sin, cos and atan
#   (src/crmath.cyr, part b1), pramana's own ln_1p, tan and log2 (src/crmath_ext.cyr, parts b2–b4), ganita's cbrt.
fn _par_math(fp, fl): i64 {
    var w = _par_in(0);
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "f64::sqrt") == 1) { var r: f64 = f64_sqrt(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::abs") == 1) { var r: f64 = f64_abs(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::floor") == 1) { var r: f64 = f64_floor(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::high_word") == 1) { _par_got_i(w >> 32); return 1; }
    if (_par_eq(fp, fl, "f64::low_masked") == 1) { _par_got_f(w & 0xFFFFFFFF00000000); return 1; }
    if (_par_eq(fp, fl, "f64::fract") == 1) { var r: f64 = _pmn_fract(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::is_nan") == 1) { _par_got_i(_pmn_is_nan(x)); return 1; }
    if (_par_eq(fp, fl, "f64::is_finite") == 1) { _par_got_i(_pmn_is_finite(x)); return 1; }
    if (_par_eq(fp, fl, "f64::as_usize") == 1) { _par_got_i(_pmn_sat_usize(x)); return 1; }
    if (_par_eq(fp, fl, "u64::as_f64") == 1) { var r: f64 = _pmn_u64_to_f64(w); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::powi2") == 1) { var r: f64 = _pmn_powi(x, 2); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::powi3") == 1) { var r: f64 = _pmn_powi(x, 3); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::powi4") == 1) { var r: f64 = _pmn_powi(x, 4); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::powi9") == 1) { var r: f64 = _pmn_powi(x, 9); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::powi25") == 1) { var r: f64 = _pmn_powi(x, 25); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::powi49") == 1) { var r: f64 = _pmn_powi(x, 49); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::exp") == 1) { var r: f64 = _pmn_exp(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::ln") == 1) { var r: f64 = _pmn_ln(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::ln_1p") == 1) { var r: f64 = _pmn_ln_1p(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::exp_m1") == 1) { var r: f64 = _pmn_exp_m1(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::sin") == 1) { var r: f64 = _pmn_sin(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::cos") == 1) { var r: f64 = _pmn_cos(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::tan") == 1) { var r: f64 = _pmn_tan(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::atan") == 1) { var r: f64 = _pmn_atan(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::log2") == 1) { var r: f64 = _pmn_log2(x); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::cbrt") == 1) { var r: f64 = _pmn_cbrt(x); _par_got_f(r); return 1; }
    if (_par_in_n < 2) { return 0; }
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "f64::powf") == 1) { var r: f64 = _pmn_powf(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::max") == 1) { var r: f64 = _pmn_max(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::min") == 1) { var r: f64 = _pmn_min(x, y); _par_got_f(r); return 1; }
    if (_par_eq(fp, fl, "f64::total_cmp") == 1) { _par_got_i(_pmn_total_cmp(x, y)); return 1; }
    if (_par_in_n < 3) { return 0; }
    var z: f64 = _par_in(2);
    if (_par_eq(fp, fl, "f64::clamp") == 1) { var r: f64 = _pmn_clamp(x, y, z); _par_got_f(r); return 1; }
    return 0;
}

# `special` rows (M2): src/special.cyr, 1.3.0's math.rs in Rust's operation order on the correctly rounded primitives
# (T0), so every row matches special.cr.tsv's model at 0 ulp. Part a1: fdlibm's erf and erfc, Φ and 1 − Φ. Part a2:
# lnΓ, the Stirling remainder, bd0, the prefactor kernel and ln B. Part a3: the regularized incomplete gamma, (P, Q)
# and each alone. Part a4: the regularized incomplete beta, (I, 1 − I) from (a, b, x, y), and I alone from (x, a, b).
# Part b on: the T1 functions' rows are compared with special.ref.tsv at ADR 009's bounds (`_par_c_bound`).
fn _par_special(fp, fl): i64 {
    var x: f64 = _par_in(0);
    if (_par_in_n == 1) {
        if (_par_eq(fp, fl, "math::erf") == 1) { var r0: f64 = _pmn_erf(x); _par_got_f(r0); return 1; }
        if (_par_eq(fp, fl, "math::erfc") == 1) { var r1: f64 = _pmn_erfc(x); _par_got_f(r1); return 1; }
        if (_par_eq(fp, fl, "math::normal_cdf") == 1) { var r2: f64 = _pmn_normal_cdf(x); _par_got_f(r2); return 1; }
        if (_par_eq(fp, fl, "math::normal_sf") == 1) { var r3: f64 = _pmn_normal_sf(x); _par_got_f(r3); return 1; }
        if (_par_eq(fp, fl, "math::ln_gamma") == 1) { var r4: f64 = _pmn_ln_gamma(x); _par_got_f(r4); return 1; }
        if (_par_eq(fp, fl, "math::stirling_error") == 1) {
            var r5: f64 = _pmn_stirling_error(x);
            _par_got_f(r5);
            return 1;
        }
        return 0;
    }
    var y: f64 = _par_in(1);
    if (_par_in_n == 3 && _par_eq(fp, fl, "math::regularized_incomplete_beta") == 1) {
        var z3: f64 = _par_in(2);
        var r11: f64 = _pmn_regularized_incomplete_beta(x, y, z3);
        _par_got_f(r11);
        return 1;
    }
    if (_par_in_n == 4 && _par_eq(fp, fl, "math::beta_inc") == 1) {
        var bx: f64 = _par_in(2);
        var by: f64 = _par_in(3);
        var bp, bq = _pmn_beta_inc(x, y, bx, by);
        _par_got_f(bp);
        _par_got_f(bq);
        return 1;
    }
    if (_par_in_n != 2) { return 0; }
    if (_par_eq(fp, fl, "math::bd0") == 1) { var r6: f64 = _pmn_bd0(x, y); _par_got_f(r6); return 1; }
    if (_par_eq(fp, fl, "math::ln_gamma_kernel") == 1) {
        var r7: f64 = _pmn_ln_gamma_kernel(x, y);
        _par_got_f(r7);
        return 1;
    }
    if (_par_eq(fp, fl, "math::ln_beta") == 1) { var r8: f64 = _pmn_ln_beta(x, y); _par_got_f(r8); return 1; }
    if (_par_eq(fp, fl, "math::gamma_inc") == 1) {
        var gp, gq = _pmn_gamma_inc(x, y);
        _par_got_f(gp);
        _par_got_f(gq);
        return 1;
    }
    if (_par_eq(fp, fl, "math::regularized_lower_incomplete_gamma") == 1) {
        var r9: f64 = _pmn_regularized_lower_incomplete_gamma(x, y);
        _par_got_f(r9);
        return 1;
    }
    if (_par_eq(fp, fl, "math::regularized_upper_incomplete_gamma") == 1) {
        var r10: f64 = _pmn_regularized_upper_incomplete_gamma(x, y);
        _par_got_f(r10);
        return 1;
    }
    return 0;
}

# `dist` rows (M3): src/dist.cyr, src/dist_cont.cyr and src/dist_disc.cyr, each distribution built by its constructor
# from the row's parameters. Part a1: Normal, and Box–Muller's `standard_normal` through a bounded generic; part a2:
# Uniform, Exponential and Bernoulli; part a3: Cauchy and Weibull; part b1: Gamma, ChiSquared and the oracle's
# `sample_gamma_standard`; part b2: Beta, StudentT, FDistribution and the oracle's Student-t and F tails; part c1:
# Poisson and the oracle's `sample_poisson_ptrs`; part c2: Binomial, whose n is an integer token.
fn _par_std_normal<R: PmnRng>(g: *R): f64 {
    var z: f64 = _pmn_standard_normal(g);
    return z;
}

fn _par_poisson_ptrs<R: PmnRng>(l: f64, g: *R): f64 {
    var z: f64 = _pmn_sample_poisson_ptrs(l, g);
    return z;
}

fn _par_gamma_standard<R: PmnRng>(a: f64, g: *R): f64 {
    var z: f64 = _pmn_sample_gamma_standard(a, g);
    return z;
}

# A trait method of a built distribution d, through the bound as a consumer's generic code calls it: the method's
# name at mp (the row's `X::method` past `X::`), x (pdf, cdf) or the seed and count (sample) from input xi on.
fn _par_dist_call<D: PmnDistribution>(d: *D, mp, ml, xi): i64 {
    if (_par_eq(mp, ml, "pdf") == 1) {
        var x0: f64 = _par_in(xi);
        var r0: f64 = d.pdf(x0);
        _par_got_f(r0);
        return 1;
    }
    if (_par_eq(mp, ml, "cdf") == 1) {
        var x1: f64 = _par_in(xi);
        var r1: f64 = d.cdf(x1);
        _par_got_f(r1);
        return 1;
    }
    if (_par_eq(mp, ml, "mean") == 1) {
        var r2: f64 = d.mean();
        _par_got_f(r2);
        return 1;
    }
    if (_par_eq(mp, ml, "variance") == 1) {
        var r3: f64 = d.variance();
        _par_got_f(r3);
        return 1;
    }
    if (_par_eq(mp, ml, "sample") == 1) {
        var g: PmnSimpleRng;
        if (PmnSimpleRng_new(&g, _par_in(xi)) != PMN_ERR_NONE) { return 0 - 1; }
        var n = _par_in(xi + 1);
        _par_got_seq(n);
        for (var j = 0; j < n; j = j + 1) {
            var r4: f64 = d.sample(&g);
            _par_got_f(r4);
        }
        return 1;
    }
    return 0;
}

# X::new rows: the constructor's error, or the fields it holds (np of them, at f).
fn _par_dist_new(e, f, np): i64 {
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    for (var k = 0; k < np; k = k + 1) {
        var v: f64 = load64(f + k * 8);
        _par_got_f(v);
    }
    return 1;
}

# The length of a `X::` prefix at fp naming one of the distributions (its name's length plus 2), or 0.
fn _par_dist_prefix(fp, fl, name): i64 {
    var n = strlen(name);
    if (fl <= n + 2 || memeq(fp, name, n) != 1 || memeq(fp + n, "::", 2) != 1) { return 0; }
    return n + 2;
}

fn _par_dist(fp, fl): i64 {
    if (_par_eq(fp, fl, "standard_normal") == 1) {
        if (_par_in_n != 2) { return 0 - 1; }
        var sg: PmnSimpleRng;
        if (PmnSimpleRng_new(&sg, _par_in(0)) != PMN_ERR_NONE) { return 0 - 1; }
        var sn = _par_in(1);
        _par_got_seq(sn);
        for (var k = 0; k < sn; k = k + 1) {
            var z: f64 = _par_std_normal(&sg);
            _par_got_f(z);
        }
        return 1;
    }
    if (_par_eq(fp, fl, "sample_gamma_standard") == 1) {
        if (_par_in_n != 3) { return 0 - 1; }
        var ga: f64 = _par_in(0);
        var gg: PmnSimpleRng;
        if (PmnSimpleRng_new(&gg, _par_in(1)) != PMN_ERR_NONE) { return 0 - 1; }
        var gn = _par_in(2);
        _par_got_seq(gn);
        for (var gk = 0; gk < gn; gk = gk + 1) {
            var gz: f64 = _par_gamma_standard(ga, &gg);
            _par_got_f(gz);
        }
        return 1;
    }
    if (_par_eq(fp, fl, "student_t_two_tailed") == 1 || _par_eq(fp, fl, "student_t_cdf") == 1) {
        if (_par_in_n != 2) { return 0 - 1; }
        var tt: f64 = _par_in(0);
        var tdf: f64 = _par_in(1);
        var tr: f64 = 0.0;
        if (fl == 20) {
            tr = _pmn_student_t_two_tailed(tt, tdf);
        } else {
            tr = _pmn_student_t_cdf(tt, tdf);
        }
        _par_got_f(tr);
        return 1;
    }
    if (_par_eq(fp, fl, "sample_poisson_ptrs") == 1) {
        if (_par_in_n != 3) { return 0 - 1; }
        var pl: f64 = _par_in(0);
        var pg: PmnSimpleRng;
        if (PmnSimpleRng_new(&pg, _par_in(1)) != PMN_ERR_NONE) { return 0 - 1; }
        var pn = _par_in(2);
        _par_got_seq(pn);
        for (var pk = 0; pk < pn; pk = pk + 1) {
            var pz: f64 = _par_poisson_ptrs(pl, &pg);
            _par_got_f(pz);
        }
        return 1;
    }
    if (_par_eq(fp, fl, "f_cdf_sf") == 1) {
        if (_par_in_n != 3) { return 0 - 1; }
        var fx: f64 = _par_in(0);
        var fh1: f64 = _par_in(1);
        var fh2: f64 = _par_in(2);
        var fc, fs = _pmn_f_cdf_sf(fx, fh1, fh2);
        _par_got_f(fc);
        _par_got_f(fs);
        return 1;
    }
    var px = _par_dist_prefix(fp, fl, "Normal");
    if (px > 0) {
        var m: f64 = _par_in(0);
        var s: f64 = _par_in(1);
        var dn: PmnNormal;
        var en = PmnNormal_new(&dn, m, s);
        if (_par_eq(fp + px, fl - px, "new") == 1) { return _par_dist_new(en, &dn, 2); }
        if (en != PMN_ERR_NONE) { return 0 - 1; }
        return _par_dist_call(&dn, fp + px, fl - px, 2);
    }
    px = _par_dist_prefix(fp, fl, "Uniform");
    if (px > 0) {
        var lo: f64 = _par_in(0);
        var hi: f64 = _par_in(1);
        var du: PmnUniform;
        var eu = PmnUniform_new(&du, lo, hi);
        if (_par_eq(fp + px, fl - px, "new") == 1) { return _par_dist_new(eu, &du, 2); }
        if (eu != PMN_ERR_NONE) { return 0 - 1; }
        return _par_dist_call(&du, fp + px, fl - px, 2);
    }
    px = _par_dist_prefix(fp, fl, "Exponential");
    if (px > 0) {
        var l: f64 = _par_in(0);
        var de: PmnExponential;
        var ee = PmnExponential_new(&de, l);
        if (_par_eq(fp + px, fl - px, "new") == 1) { return _par_dist_new(ee, &de, 1); }
        if (ee != PMN_ERR_NONE) { return 0 - 1; }
        return _par_dist_call(&de, fp + px, fl - px, 1);
    }
    px = _par_dist_prefix(fp, fl, "Cauchy");
    if (px > 0) {
        var x0: f64 = _par_in(0);
        var ga: f64 = _par_in(1);
        var dc: PmnCauchy;
        var ec = PmnCauchy_new(&dc, x0, ga);
        if (_par_eq(fp + px, fl - px, "new") == 1) { return _par_dist_new(ec, &dc, 2); }
        if (ec != PMN_ERR_NONE) { return 0 - 1; }
        return _par_dist_call(&dc, fp + px, fl - px, 2);
    }
    px = _par_dist_prefix(fp, fl, "Weibull");
    if (px > 0) {
        var wk: f64 = _par_in(0);
        var wl: f64 = _par_in(1);
        var dw: PmnWeibull;
        var ew = PmnWeibull_new(&dw, wk, wl);
        if (_par_eq(fp + px, fl - px, "new") == 1) { return _par_dist_new(ew, &dw, 2); }
        if (ew != PMN_ERR_NONE) { return 0 - 1; }
        return _par_dist_call(&dw, fp + px, fl - px, 2);
    }
    px = _par_dist_prefix(fp, fl, "Gamma");
    if (px > 0) {
        var gal: f64 = _par_in(0);
        var gbe: f64 = _par_in(1);
        var dg: PmnGamma;
        var eg = PmnGamma_new(&dg, gal, gbe);
        if (_par_eq(fp + px, fl - px, "new") == 1) { return _par_dist_new(eg, &dg, 2); }
        if (eg != PMN_ERR_NONE) { return 0 - 1; }
        return _par_dist_call(&dg, fp + px, fl - px, 2);
    }
    px = _par_dist_prefix(fp, fl, "ChiSquared");
    if (px > 0) {
        var cdf0: f64 = _par_in(0);
        var dch: PmnChiSquared;
        var ech = PmnChiSquared_new(&dch, cdf0);
        if (_par_eq(fp + px, fl - px, "new") == 1) { return _par_dist_new(ech, &dch, 1); }
        if (ech != PMN_ERR_NONE) { return 0 - 1; }
        return _par_dist_call(&dch, fp + px, fl - px, 1);
    }
    px = _par_dist_prefix(fp, fl, "Beta");
    if (px > 0) {
        var bal: f64 = _par_in(0);
        var bbe: f64 = _par_in(1);
        var dbt: PmnBeta;
        var ebt = PmnBeta_new(&dbt, bal, bbe);
        if (_par_eq(fp + px, fl - px, "new") == 1) { return _par_dist_new(ebt, &dbt, 2); }
        if (ebt != PMN_ERR_NONE) { return 0 - 1; }
        return _par_dist_call(&dbt, fp + px, fl - px, 2);
    }
    px = _par_dist_prefix(fp, fl, "StudentT");
    if (px > 0) {
        var sdf: f64 = _par_in(0);
        var dst: PmnStudentT;
        var est = PmnStudentT_new(&dst, sdf);
        if (_par_eq(fp + px, fl - px, "new") == 1) { return _par_dist_new(est, &dst, 1); }
        if (est != PMN_ERR_NONE) { return 0 - 1; }
        return _par_dist_call(&dst, fp + px, fl - px, 1);
    }
    px = _par_dist_prefix(fp, fl, "FDistribution");
    if (px > 0) {
        var fd1: f64 = _par_in(0);
        var fd2: f64 = _par_in(1);
        var dfd: PmnFDistribution;
        var efd = PmnFDistribution_new(&dfd, fd1, fd2);
        if (_par_eq(fp + px, fl - px, "new") == 1) { return _par_dist_new(efd, &dfd, 2); }
        if (efd != PMN_ERR_NONE) { return 0 - 1; }
        return _par_dist_call(&dfd, fp + px, fl - px, 2);
    }
    px = _par_dist_prefix(fp, fl, "Poisson");
    if (px > 0) {
        var plam: f64 = _par_in(0);
        var dpo: PmnPoisson;
        var epo = PmnPoisson_new(&dpo, plam);
        if (_par_eq(fp + px, fl - px, "new") == 1) { return _par_dist_new(epo, &dpo, 1); }
        if (epo != PMN_ERR_NONE) { return 0 - 1; }
        return _par_dist_call(&dpo, fp + px, fl - px, 1);
    }
    px = _par_dist_prefix(fp, fl, "Binomial");
    if (px > 0) {
        var bn = _par_in(0);
        var bnp: f64 = _par_in(1);
        var dbn: PmnBinomial;
        var ebn = PmnBinomial_new(&dbn, bn, bnp);
        if (_par_eq(fp + px, fl - px, "new") == 1) {
            if (ebn != PMN_ERR_NONE) {
                _par_got_err(ebn);
                return 1;
            }
            _par_got_i(dbn.n);
            var bnq: f64 = dbn.p;
            _par_got_f(bnq);
            return 1;
        }
        if (ebn != PMN_ERR_NONE) { return 0 - 1; }
        return _par_dist_call(&dbn, fp + px, fl - px, 2);
    }
    px = _par_dist_prefix(fp, fl, "Bernoulli");
    if (px > 0) {
        var p: f64 = _par_in(0);
        var db: PmnBernoulli;
        var eb = PmnBernoulli_new(&db, p);
        if (_par_eq(fp + px, fl - px, "new") == 1) { return _par_dist_new(eb, &db, 1); }
        if (eb != PMN_ERR_NONE) { return 0 - 1; }
        return _par_dist_call(&db, fp + px, fl - px, 1);
    }
    px = _par_dist_prefix(fp, fl, "MultivariateNormal");
    if (px > 0) { return _par_mvn(fp + px, fl - px); }
    return 0;
}

# `MultivariateNormal::` rows (M3 part d2): the constructor on the row's mean (d) and rows × cols covariance, read into
# buffers of up to 4,096 f64s (declared with the codec's rows); then its L and log det (the oracle's `mvn_factor`), a
# density at the `v:n` point, or `count` draws from the seed, each vector's d elements in order. The MultivariateNormal
# is dropped after the row.

fn _par_mvn(mp, ml): i64 {
    if (_par_mv_m == 0) {
        _par_mv_m = alloc(_PAR_MV_CAP * 8);
        _par_mv_c = alloc(_PAR_MV_CAP * 8);
        _par_mv_x = alloc(_PAR_MV_CAP * 8);
        if (_par_mv_m == 0 || _par_mv_c == 0 || _par_mv_x == 0) { return 0 - 1; }
    }
    var d = _par_in(0);
    if (d < 0 || d > 64 || _par_in_f64s(1, _par_mv_m) != d) { return 0 - 1; }
    var rows = _par_in(2 + d);
    var cols = _par_in(3 + d);
    if (rows < 0 || cols < 0 || rows * cols > _PAR_MV_CAP) { return 0 - 1; }
    if (_par_in_f64s(4 + d, _par_mv_c) != rows * cols) { return 0 - 1; }
    var k0 = 5 + d + rows * cols;
    var m: PmnMultivariateNormal;
    var e = PmnMultivariateNormal_new(&m, _par_mv_m, d, _par_mv_c, rows, cols);
    if (_par_eq(mp, ml, "new") == 1) {
        if (e != PMN_ERR_NONE) {
            _par_got_err(e);
            return 1;
        }
        var l = m.buf + (d + d * d) * 8;
        _par_got_seq(d * d);
        for (var k = 0; k < d * d; k = k + 1) { _par_got_f(load64(l + k * 8)); }
        var ld: f64 = m.log_det;
        _par_got_f(ld);
        var e0 = PmnMultivariateNormal_drop(&m);
        return 1;
    }
    if (e != PMN_ERR_NONE) { return 0 - 1; }   # a density or a draw on a refused case
    var r = 0;
    if (_par_eq(mp, ml, "log_pdf") == 1 || _par_eq(mp, ml, "pdf") == 1) {
        var n = _par_in(k0);
        r = 0 - 1;
        if (n >= 0 && n <= _PAR_MV_CAP) {
            var nx = _par_in_f64s(k0, _par_mv_x);
            var t = Err;
            var v = 0;
            if (ml == 7) {
                t, v = m.log_pdf(_par_mv_x, nx);
            } else {
                t, v = m.pdf(_par_mv_x, nx);
            }
            if (t == Err) {
                _par_got_err(v);
            } else {
                _par_got_f(v);
            }
            r = 1;
        }
    } elif (_par_eq(mp, ml, "sample") == 1) {
        var g: PmnSimpleRng;
        r = 0 - 1;
        if (PmnSimpleRng_new(&g, _par_in(k0)) == PMN_ERR_NONE) {
            var count = _par_in(k0 + 1);
            _par_got_seq(count * d);
            r = 1;
            for (var c = 0; c < count; c = c + 1) {
                if (m.sample(&g, _par_mv_x, _PAR_MV_CAP) != PMN_ERR_NONE) { r = 0 - 1; }
                for (var j = 0; j < d; j = j + 1) { _par_got_f(load64(_par_mv_x + j * 8)); }
            }
        }
    }
    var e1 = PmnMultivariateNormal_drop(&m);
    return r;
}

# `linalg` rows (M3 part d1): src/linalg.cyr's Cholesky factorization and solve, the matrix a `v:n²` slice and the
# right side a `v:n` one, read into buffers of up to 64 × 64.
var _par_la_a = 0;
var _par_la_b = 0;
var _par_la_o = 0;
var _PAR_LA_CAP = 4096;

fn _par_linalg(fp, fl): i64 {
    if (_par_la_a == 0) {
        _par_la_a = alloc(_PAR_LA_CAP * 8);
        _par_la_b = alloc(_PAR_LA_CAP * 8);
        _par_la_o = alloc(_PAR_LA_CAP * 8);
        if (_par_la_a == 0 || _par_la_b == 0 || _par_la_o == 0) { return 0 - 1; }
    }
    var n = _par_in(0);
    if (n < 0 || n > 64) { return 0 - 1; }
    var nn = n * n;
    if (_par_in_f64s(1, _par_la_a) != nn) { return 0 - 1; }
    if (_par_eq(fp, fl, "linalg::cholesky") == 1) {
        var e = _pmn_cholesky(_par_la_a, n, _par_la_o);
        if (e != PMN_ERR_NONE) {
            _par_got_err(e);
            return 1;
        }
        _par_got_seq(nn);
        for (var k = 0; k < nn; k = k + 1) { _par_got_f(load64(_par_la_o + k * 8)); }
        return 1;
    }
    if (_par_eq(fp, fl, "linalg::eigen_symmetric") == 1) {
        var tol: f64 = _par_in(nn + 2);
        var e3 = _pmn_eigen_symmetric(_par_la_a, n, tol, _par_in(nn + 3), _par_la_b, _par_la_o);
        if (e3 != PMN_ERR_NONE) {
            _par_got_err(e3);
            return 1;
        }
        _par_got_seq(n);
        for (var k3 = 0; k3 < n; k3 = k3 + 1) { _par_got_f(load64(_par_la_b + k3 * 8)); }
        _par_got_seq(nn);
        for (var k4 = 0; k4 < nn; k4 = k4 + 1) { _par_got_f(load64(_par_la_o + k4 * 8)); }
        return 1;
    }
    if (_par_eq(fp, fl, "linalg::cholesky_solve") == 1) {
        if (_par_in_f64s(nn + 2, _par_la_b) != n) { return 0 - 1; }
        var e2 = _pmn_cholesky_solve(_par_la_a, n, _par_la_b, _par_la_o);
        if (e2 != PMN_ERR_NONE) {
            _par_got_err(e2);
            return 1;
        }
        _par_got_seq(n);
        for (var j = 0; j < n; j = j + 1) { _par_got_f(load64(_par_la_o + j * 8)); }
        return 1;
    }
    return 0;
}

# `descriptive` rows (M4): src/descriptive.cyr. A slice is `v:n` and its values; a Result is its value or `E:`.

fn _par_ds_result(t, v): i64 {
    if (t == Err) {
        _par_got_err(v);
    } else {
        _par_got_f(v);
    }
    return 1;
}

# The kernel of an `e:Kernel.<Name>` input token at k, or -1.
fn _par_in_kernel(k): i64 {
    if (k >= _par_in_n || load64(_par_in_k + k * 8) != 101) { return 0 - 1; }
    var p = _par_in(k);
    var len = load64(_par_in_l + k * 8);
    for (var j = 0; j < 4; j = j + 1) {
        var name = pmn_kernel_name(j);
        var nl = strlen(name);
        if (len == nl + 7 && memeq(p + 7, name, nl) == 1) { return j; }
    }
    return 0 - 1;
}

# `KernelDensity::evaluate_grid` rows: the data, the points, the kernel, then the bandwidth or `n:` for Silverman's.
fn _par_kde(): i64 {
    var n = _par_in(0);
    if (n < 0 || n > _PAR_DS_CAP || n + 1 >= _par_in_n) { return 0 - 1; }
    _par_in_f64s(0, _par_ds_a);
    var m = _par_in(n + 1);
    if (m < 0 || m > _PAR_DS_CAP) { return 0 - 1; }
    _par_in_f64s(n + 1, _par_ds_b);
    var kk = n + m + 2;
    var k = _par_in_kernel(kk);
    if (k < 0) { return 0 - 1; }
    var kd: PmnKernelDensity;
    var e = 0;
    if (load64(_par_in_k + (kk + 1) * 8) == 110) {
        e = PmnKernelDensity_silverman(&kd, _par_ds_a, n, k);
    } else {
        var h: f64 = _par_in(kk + 1);
        e = PmnKernelDensity_new(&kd, _par_ds_a, n, h, k);
    }
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    var bw: f64 = kd.bandwidth;
    _par_got_f(bw);
    _par_got_seq(m);
    var r = 1;
    if (kd.evaluate_grid(_par_ds_b, m, _par_ds_o, _PAR_DS_CAP) != PMN_ERR_NONE) { r = 0 - 1; }
    for (var j = 0; j < m; j = j + 1) { _par_got_f(load64(_par_ds_o + j * 8)); }
    PmnKernelDensity_drop(&kd);
    return r;
}

# Reads the variables (slices) of a corr or pca row into _par_ds_a, their records into recs (16 at most); the count, or
# -1 for a defect.
fn _par_vars(recs): i64 {
    var p = 0;
    var k = 0;
    var used = 0;
    while (k < _par_in_n) {
        if (load64(_par_in_k + k * 8) != 118 || p >= 16) { return 0 - 1; }
        var n = _par_in(k);
        if (n < 0 || used + n > _PAR_DS_CAP) { return 0 - 1; }
        _par_in_f64s(k, _par_ds_a + used * 8);
        store64(recs + p * 16, _par_ds_a + used * 8);
        store64(recs + p * 16 + 8, n);
        used = used + n;
        p = p + 1;
        k = k + 1 + n;
    }
    return p;
}

# Appends a PcaResult's three lists as golden tokens.
fn _par_got_pca(r: *PmnPcaResult): i64 {
    var rows = r.n_components();
    _par_got_seq(rows);
    for (var i = 0; i < rows; i = i + 1) {
        var c = r.component_len(i);
        var rp = r.component(i);
        _par_got_seq(c);
        for (var j = 0; j < c; j = j + 1) { _par_got_f(load64(rp + j * 8)); }
    }
    var ne = r.n_eigenvalues();
    _par_got_seq(ne);
    for (var k = 0; k < ne; k = k + 1) { _par_got_f(load64(r.eigenvalues() + k * 8)); }
    var nr = r.n_ratios();
    _par_got_seq(nr);
    for (var q = 0; q < nr; q = q + 1) { _par_got_f(load64(r.explained_variance_ratio() + q * 8)); }
    return 1;
}

# A PcaResult built from golden tokens at k0 (the codec's and Debug's rows), into out: the next token, or -1.
fn _par_pca_from_toks(k0, out: *PmnPcaResult): i64 {
    var k = k0;
    if (k >= _par_in_n) { return 0 - 1; }
    var rows = _par_in(k);
    k = k + 1;
    var cells = 0;
    for (var i = 0; i < rows; i = i + 1) {
        if (k >= _par_in_n) { return 0 - 1; }
        var c = _par_in(k);
        cells = cells + c;
        k = k + 1 + c;
    }
    if (k >= _par_in_n) { return 0 - 1; }
    var ne = _par_in(k);
    var kr = k + 1 + ne;
    if (kr >= _par_in_n) { return 0 - 1; }
    var nr = _par_in(kr);
    if (_pmn_pca_alloc(out, rows, cells, ne, nr) != PMN_ERR_NONE) { return 0 - 1; }
    k = k0 + 1;
    var at = 0;
    for (var i2 = 0; i2 < rows; i2 = i2 + 1) {
        var c2 = _par_in(k);
        store64(out.offs + i2 * 8, at);
        for (var j = 0; j < c2; j = j + 1) { store64(out.comp + (at + j) * 8, _par_in(k + 1 + j)); }
        at = at + c2;
        k = k + 1 + c2;
    }
    store64(out.offs + rows * 8, at);
    for (var e = 0; e < ne; e = e + 1) { store64(out.evals + e * 8, _par_in(k + 1 + e)); }
    k = k + 1 + ne;
    for (var q = 0; q < nr; q = q + 1) { store64(out.ratio + q * 8, _par_in(k + 1 + q)); }
    return k + 1 + nr;
}

# `pca` rows: the variables; the components, eigenvalues and ratios, or the error.
fn _par_pca(): i64 {
    var recs[256];
    var p = _par_vars(&recs);
    if (p < 0) { return 0 - 1; }
    var r: PmnPcaResult;
    var e = pmn_pca(&r, &recs, p);
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    _par_got_pca(&r);
    PmnPcaResult_drop(&r);
    return 1;
}

# `correlation_matrix` rows: the variables, each a slice; the p × p matrix row-major or the error.
fn _par_corr(): i64 {
    var recs[256];
    var p = _par_vars(&recs);
    if (p < 0) { return 0 - 1; }
    var e = pmn_correlation_matrix(&recs, p, _par_ds_o, _PAR_DS_CAP);
    if (e != PMN_ERR_NONE) {
        _par_got_err(e);
        return 1;
    }
    _par_got_seq(p * p);
    for (var j = 0; j < p * p; j = j + 1) { _par_got_f(load64(_par_ds_o + j * 8)); }
    return 1;
}

fn _par_descriptive(fp, fl): i64 {
    if (_par_ds_a == 0) { _par_ds_a = alloc(_PAR_DS_CAP * 8); }
    if (_par_ds_b == 0) { _par_ds_b = alloc(_PAR_DS_CAP * 8); }
    if (_par_ds_o == 0) { _par_ds_o = alloc(_PAR_DS_CAP * 8); }
    if (_par_ds_a == 0 || _par_ds_b == 0 || _par_ds_o == 0) { return 0 - 1; }
    if (_par_eq(fp, fl, "KernelDensity::evaluate_grid") == 1) { return _par_kde(); }
    if (_par_eq(fp, fl, "descriptive::correlation_matrix") == 1) { return _par_corr(); }
    if (_par_eq(fp, fl, "descriptive::pca") == 1) { return _par_pca(); }
    var n = _par_in(0);
    if (n < 0 || n > _PAR_DS_CAP) { return 0 - 1; }
    _par_in_f64s(0, _par_ds_a);
    var a = _par_ds_a;
    if (_par_eq(fp, fl, "descriptive::sum") == 1) {
        var s: f64 = pmn_sum(a, n);
        _par_got_f(s);
        return 1;
    }
    if (_par_eq(fp, fl, "descriptive::quartiles") == 1) {
        var q[24];
        var e = pmn_quartiles(a, n, &q);
        if (e != PMN_ERR_NONE) {
            _par_got_err(e);
            return 1;
        }
        for (var k = 0; k < 3; k = k + 1) { _par_got_f(load64(&q + k * 8)); }
        return 1;
    }
    if (_par_eq(fp, fl, "descriptive::percentile") == 1) {
        var p: f64 = _par_in(n + 1);
        var t0, v0 = pmn_percentile(a, n, p);
        return _par_ds_result(t0, v0);
    }
    var t = Err;
    var v = 0;
    if (_par_eq(fp, fl, "descriptive::mean") == 1) {
        t, v = pmn_mean(a, n);
    } elif (_par_eq(fp, fl, "descriptive::median") == 1) {
        t, v = pmn_median(a, n);
    } elif (_par_eq(fp, fl, "descriptive::mode") == 1) {
        t, v = pmn_mode(a, n);
    } elif (_par_eq(fp, fl, "descriptive::variance") == 1) {
        t, v = pmn_variance(a, n);
    } elif (_par_eq(fp, fl, "descriptive::std_dev") == 1) {
        t, v = pmn_std_dev(a, n);
    } elif (_par_eq(fp, fl, "descriptive::skewness") == 1) {
        t, v = pmn_skewness(a, n);
    } elif (_par_eq(fp, fl, "descriptive::kurtosis") == 1) {
        t, v = pmn_kurtosis(a, n);
    } elif (_par_eq(fp, fl, "descriptive::iqr") == 1) {
        t, v = pmn_iqr(a, n);
    } elif (_par_eq(fp, fl, "descriptive::min") == 1) {
        t, v = pmn_min(a, n);
    } elif (_par_eq(fp, fl, "descriptive::max") == 1) {
        t, v = pmn_max(a, n);
    } elif (_par_eq(fp, fl, "descriptive::range") == 1) {
        t, v = pmn_range(a, n);
    } else {
        return 0;
    }
    return _par_ds_result(t, v);
}

fn _par_dispatch(mp, ml, fp, fl): i64 {
    _par_got_n = 0;
    if (_par_eq(mp, ml, "bridge") == 1) { return _par_bridge(fp, fl); }
    if (_par_eq(mp, ml, "combinatorics") == 1) { return _par_combinatorics(fp, fl); }
    if (_par_eq(mp, ml, "constants") == 1) { return _par_constants(fp, fl); }
    if (_par_eq(mp, ml, "debug") == 1) { return _par_debug(fp, fl); }
    if (_par_eq(mp, ml, "descriptive") == 1) { return _par_descriptive(fp, fl); }
    if (_par_eq(mp, ml, "dist") == 1) { return _par_dist(fp, fl); }
    if (_par_eq(mp, ml, "fmt") == 1) { return _par_fmt(fp, fl); }
    if (_par_eq(mp, ml, "json") == 1) { return _par_json(fp, fl); }
    if (_par_eq(mp, ml, "linalg") == 1) { return _par_linalg(fp, fl); }
    if (_par_eq(mp, ml, "math") == 1) { return _par_math(fp, fl); }
    if (_par_eq(mp, ml, "rng") == 1) { return _par_rng(fp, fl); }
    if (_par_eq(mp, ml, "special") == 1) { return _par_special(fp, fl); }
    return 0;
}

# Shadow comparisons, never gated: the same golden rows through another Cyrius candidate. Each row's own outputs are
# folded into its digest first (a pending row has none), before a shadow replaces them.
# - the native exp, ln, atan and log2 builtins: x87 on x86_64, so their bits differ between targets (digests 13–16).
#   M0 step 8 dispatched the polyfill forms instead; M1 dispatches the correctly rounded functions;
# - the stdlib min / max, to show where their NaN semantics differ from Rust's.
fn _par_shadow_f(name, cls, r: f64) {
    _par_got_n = 0;
    _par_got_f(r);
    _par_shadow_record(name, cls);
    return 0;
}

fn _par_shadows(mp, ml, fp, fl, cls) {
    if (_par_eq(mp, ml, "constants") == 1) {
        if (_par_got_n > 0) { _par_dg_fold(12); }
        return 0;
    }
    if (_par_eq(mp, ml, "math") != 1) { return 0; }
    if (_par_got_n > 0) { _par_dg_fold(_par_dg_slot(fp, fl)); }
    var x: f64 = _par_in(0);
    if (_par_eq(fp, fl, "f64::exp") == 1) {
        var r: f64 = f64_exp(x);
        _par_shadow_f("f64::exp ~ f64_exp (native)", cls, r);
        _par_dg_fold(13);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::ln") == 1) {
        var r: f64 = f64_ln(x);
        _par_shadow_f("f64::ln ~ f64_ln (native)", cls, r);
        _par_dg_fold(14);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::atan") == 1) {
        var r: f64 = f64_atan(x);
        _par_shadow_f("f64::atan ~ f64_atan (native)", cls, r);
        _par_dg_fold(15);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::log2") == 1) {
        var r: f64 = f64_log2(x);
        _par_shadow_f("f64::log2 ~ f64_log2 (native)", cls, r);
        _par_dg_fold(16);
        return 0;
    }
    if (_par_in_n < 2) { return 0; }
    var y: f64 = _par_in(1);
    if (_par_eq(fp, fl, "f64::max") == 1) {
        var r: f64 = f64_max(x, y);
        _par_shadow_f("f64::max ~ f64_max", cls, r);
        return 0;
    }
    if (_par_eq(fp, fl, "f64::min") == 1) {
        var r: f64 = f64_min(x, y);
        _par_shadow_f("f64::min ~ f64_min", cls, r);
        return 0;
    }
    return 0;
}

# The class-C bound for a function, in ulps; -1 while none is set (the rows are measured). Set in M0 step 8
# (port-parity §5), before each function's first gated comparison, and never raised to make a row pass:
# - 2 for the interim counterparts of the primitives: glibc and each counterpart are within about 1 ulp of the
#   correctly rounded value, so two implementations can differ by 2 (the siblings' rule for primitives). On a row
#   with a correction (math.cr.tsv) the reference is the correctly rounded value, so a pass there means within 2 ulp
#   of it: "accepted (ADR 9)" is that weaker statement until M1;
# - 0 for cbrt: Rust's (compiler_builtins) and ganita's are both correctly rounded;
# - powf stays measured: ganita's open pow(−1, |y| > 2^64) defect gives +inf against Rust's 1, and no ADR accepts a
#   counterpart that M1 replaces.
# M1 dispatches the correctly rounded functions, and each one's bound becomes 0 (ADR 009): exp, ln, exp_m1, powf,
# sin, cos and atan at part b1, ln_1p at b2, tan at b3, log2 at b4: every one is 0.
#must_use
fn _par_c_bound(fp, fl): i64 {
    if (_par_eq(fp, fl, "f64::cbrt") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::exp") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::ln") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::exp_m1") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::powf") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::sin") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::cos") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::atan") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::ln_1p") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::tan") == 1) { return 0; }
    if (_par_eq(fp, fl, "f64::log2") == 1) { return 0; }
    if (_par_eq(fp, fl, "combinatorics::stirling_approx") == 1) { return 0; }   # powf, correctly rounded (part e2)
    if (_par_eq(fp, fl, "bridge::observation_error_to_likelihood") == 1) { return 0; }   # exp (part e3)
    if (_par_eq(fp, fl, "bridge::learning_trials_to_power_law") == 1) { return 0; }      # ln and exp
    if (_par_eq(fp, fl, "bridge::response_times_to_hick_params") == 1) { return 0; }     # log2
    if (_par_eq(fp, fl, "math::erf") == 1) { return 0; }          # T0 on the correctly rounded exp (M2 part a1)
    if (_par_eq(fp, fl, "math::erfc") == 1) { return 0; }
    if (_par_eq(fp, fl, "math::normal_cdf") == 1) { return 1; }   # T1 (part b2): ADR 009's ≤ 1 ulp
    if (_par_eq(fp, fl, "math::normal_sf") == 1) { return 1; }
    if (_par_eq(fp, fl, "math::ln_gamma") == 1) { return 2; }    # T1 (part b3): ADR 009's ≤ 2 ulp (mixed for x < 0)
    if (_par_eq(fp, fl, "math::stirling_error") == 1) { return 0; }
    if (_par_eq(fp, fl, "math::bd0") == 1) { return 0; }         # ln_1p
    if (_par_eq(fp, fl, "math::ln_gamma_kernel") == 1) { return 0; }
    if (_par_eq(fp, fl, "math::ln_beta") == 1) { return 0; }
    if (_par_eq(fp, fl, "math::gamma_inc") == 1) { return _par_c_gamma_bound(); }   # T1 (part b4)
    if (_par_eq(fp, fl, "math::regularized_lower_incomplete_gamma") == 1) { return 0; }
    if (_par_eq(fp, fl, "math::regularized_upper_incomplete_gamma") == 1) { return 0; }
    if (_par_eq(fp, fl, "math::beta_inc") == 1) { return _par_c_beta_bound(); }     # T1 (part b5)
    if (_par_eq(fp, fl, "math::regularized_incomplete_beta") == 1) { return 0; }
    if (_par_eq(fp, fl, "KernelDensity::evaluate_grid") == 1) { return 0; }   # exp and powf (M4 part a2)
    if (_par_eq(fp, fl, "descriptive::pca") == 1) { return 0; }                # atan, cos, sin (part a3)
    if (_par_eq(fp, fl, "linalg::eigen_symmetric") == 1) { return 0; }
    if (_par_eq(fp, fl, "Normal::pdf") == 1) { return 0; }      # exp (M3 part a1)
    if (_par_eq(fp, fl, "Normal::cdf") == 1) { return 0; }      # downstream of the T1 Φ (ADR 009 as amended)
    if (_par_eq(fp, fl, "Normal::sample") == 1) { return 0; }   # Box–Muller: ln and cos
    if (_par_eq(fp, fl, "standard_normal") == 1) { return 0; }
    if (_par_eq(fp, fl, "Exponential::pdf") == 1) { return 0; }      # exp (part a2)
    if (_par_eq(fp, fl, "Exponential::cdf") == 1) { return 0; }      # exp_m1
    if (_par_eq(fp, fl, "Exponential::sample") == 1) { return 0; }   # ln
    if (_par_eq(fp, fl, "Cauchy::cdf") == 1) { return 0; }           # atan (part a3)
    if (_par_eq(fp, fl, "Cauchy::sample") == 1) { return 0; }        # tan
    if (_par_eq(fp, fl, "Weibull::pdf") == 1) { return 0; }          # powf and exp
    if (_par_eq(fp, fl, "Weibull::cdf") == 1) { return 0; }          # powf and exp_m1
    if (_par_eq(fp, fl, "Weibull::mean") == 1) { return 0; }         # downstream of the T1 lnΓ (ADR 009 as amended)
    if (_par_eq(fp, fl, "Weibull::variance") == 1) { return 0; }
    if (_par_eq(fp, fl, "Weibull::sample") == 1) { return 0; }       # ln and powf
    if (_par_eq(fp, fl, "Gamma::pdf") == 1) { return 0; }            # ln and exp, downstream of the T1 lnΓ (part b1)
    if (_par_eq(fp, fl, "Gamma::cdf") == 1) { return 0; }            # downstream of the T1 incomplete gamma
    if (_par_eq(fp, fl, "Gamma::sample") == 1) { return 0; }         # Marsaglia–Tsang: ln, cos and powf
    if (_par_eq(fp, fl, "ChiSquared::pdf") == 1) { return 0; }
    if (_par_eq(fp, fl, "ChiSquared::cdf") == 1) { return 0; }
    if (_par_eq(fp, fl, "ChiSquared::sample") == 1) { return 0; }
    if (_par_eq(fp, fl, "sample_gamma_standard") == 1) { return 0; }
    if (_par_eq(fp, fl, "Beta::pdf") == 1) { return 0; }             # ln, ln_1p and exp; ln B on the T1 lnΓ (part b2)
    if (_par_eq(fp, fl, "Beta::cdf") == 1) { return 0; }             # downstream of the T1 incomplete beta
    if (_par_eq(fp, fl, "Beta::sample") == 1) { return 0; }          # Marsaglia–Tsang
    if (_par_eq(fp, fl, "StudentT::pdf") == 1) { return 0; }
    if (_par_eq(fp, fl, "StudentT::cdf") == 1) { return 0; }
    if (_par_eq(fp, fl, "StudentT::sample") == 1) { return 0; }
    if (_par_eq(fp, fl, "FDistribution::pdf") == 1) { return 0; }
    if (_par_eq(fp, fl, "FDistribution::cdf") == 1) { return 0; }
    if (_par_eq(fp, fl, "FDistribution::sample") == 1) { return 0; }
    if (_par_eq(fp, fl, "student_t_two_tailed") == 1) { return 0; }
    if (_par_eq(fp, fl, "student_t_cdf") == 1) { return 0; }
    if (_par_eq(fp, fl, "f_cdf_sf") == 1) { return 0; }
    if (_par_eq(fp, fl, "Poisson::pdf") == 1) { return 0; }          # ln and exp; the kernel on the T1 lnΓ (part c1)
    if (_par_eq(fp, fl, "Poisson::cdf") == 1) { return 0; }          # downstream of the T1 incomplete gamma
    if (_par_eq(fp, fl, "Poisson::sample") == 1) { return 0; }       # Knuth's exp, PTRS's ln and kernel
    if (_par_eq(fp, fl, "sample_poisson_ptrs") == 1) { return 0; }
    if (_par_eq(fp, fl, "Binomial::pdf") == 1) { return 0; }         # ln, ln_1p and exp; Stirling on T1 lnΓ (c2)
    if (_par_eq(fp, fl, "Binomial::cdf") == 1) { return 0; }         # downstream of the T1 incomplete beta
    if (_par_eq(fp, fl, "Binomial::sample") == 1) { return 0; }      # Marsaglia–Tsang
    if (_par_eq(fp, fl, "MultivariateNormal::new") == 1) { return 0; }       # hisab's factor and ln (d2)
    if (_par_eq(fp, fl, "MultivariateNormal::log_pdf") == 1) { return 0; }   # hisab's solve and ln
    if (_par_eq(fp, fl, "MultivariateNormal::pdf") == 1) { return 0; }       # and exp
    if (_par_eq(fp, fl, "MultivariateNormal::sample") == 1) { return 0; }    # Box–Muller's ln, cos and sin
    return 0 - 1;
}

# gamma_inc's region by its shape a (T1, M2 part b4; ADR 009): 1 on the committed domain, a in [1e-3, 1e5] with x > 0;
# 2 for the other shapes T1 computes, up to 1e9; 0 for the edges (a NaN, a ≤ 0, x ≤ 0, an infinite argument) and for
# a > 1e9, where Rust's Wilson–Hilferty form stays, on T1's Φ.
#must_use
fn _par_c_gamma_region(): i64 {
    if (_par_in_n != 2) { return 0; }
    var a: f64 = _par_in(0);
    var x: f64 = _par_in(1);
    var wh: f64 = _PMN_MATH_GAMMA_WILSON_HILFERTY_SHAPE;
    var inf: f64 = _PMN_F64_INFINITY;
    if (a > 0.0 && a <= wh && x > 0.0 && x < inf) {
        var lo: f64 = 0.001;
        var hi: f64 = 100000.0;
        if (a >= lo && a <= hi) { return 1; }
        return 2;
    }
    return 0;
}

# gamma_inc's bound: ADR 009's 4 ulp on the committed domain; elsewhere 0, which `_par_c_vs_rust` widens to 1.3.0's
# own error outside the domain.
#must_use
fn _par_c_gamma_bound(): i64 {
    if (_par_c_gamma_region() == 1) { return 4; }
    return 0;
}

# beta_inc's region by its shapes (T1, M2 part b5; ADR 009): 1 on the committed domain, a and b in [1e-3, 1e5] with
# x > 0 and y > 0; 2 for the other inputs T1 computes, finite shapes up to 1e9; 0 for the edges (a NaN, a shape ≤ 0,
# x ≤ 0, y ≤ 0), an infinite shape, and a shape past 1e9, where Rust's form stays (on T1's lnΓ).
#must_use
fn _par_c_beta_region(): i64 {
    if (_par_in_n != 4) { return 0; }
    var a: f64 = _par_in(0);
    var b: f64 = _par_in(1);
    var x: f64 = _par_in(2);
    var y: f64 = _par_in(3);
    var big: f64 = 1000000000.0;
    if (a > 0.0 && a <= big && b > 0.0 && b <= big && x > 0.0 && y > 0.0) {
        var lo: f64 = 0.001;
        var hi: f64 = 100000.0;
        if (a >= lo && a <= hi && b >= lo && b <= hi) { return 1; }
        return 2;
    }
    return 0;
}

# beta_inc's bound: ADR 009's 8 ulp on the committed domain; elsewhere 0, which `_par_c_vs_rust` widens to 1.3.0's own
# error outside the domain.
#must_use
fn _par_c_beta_bound(): i64 {
    if (_par_c_beta_region() == 1) { return 8; }
    return 0;
}

# 1 for a row outside its T1 function's committed domain, where ADR 009 asks only that no row be less accurate than
# Rust: gamma_inc for a < 1e-3 or 1e5 < a ≤ 1e9 (M2 part b4); beta_inc for a shape below 1e-3, or in (1e5, 1e9]
# (part b5).
#must_use
fn _par_c_vs_rust(fp, fl): i64 {
    if (_par_eq(fp, fl, "math::gamma_inc") == 1 && _par_c_gamma_region() == 2) { return 1; }
    if (_par_eq(fp, fl, "math::beta_inc") == 1 && _par_c_beta_region() == 2) { return 1; }
    return 0;
}

# 1 when the current row's class-C bound is ADR 009's mixed one, ulps of max(|want|, 1): lnΓ for x < 0, where the
# relative error is unbounded at the zeros of lnΓ (from M2 part b3).
#must_use
fn _par_c_mixed(fp, fl): i64 {
    if (_par_eq(fp, fl, "math::ln_gamma") != 1 || _par_in_n != 1) { return 0; }
    var x: f64 = _par_in(0);
    if (x < 0.0) { return 1; }
    return 0;
}

# The ADR accepting a divergent row (function and raw input field), or 0. The correctly rounded rows are ADR 009's,
# accepted by parity_core itself; ADR 007's mapped rows arrive with their modules.
#must_use
fn _par_accepted(fp, fl, ip, il): i64 {
    return 0;
}

# 1 for an ADR whose accepted rows are counted but not printed row by row. None yet.
#must_use
fn _par_accepted_quiet(adr): i64 {
    return 0;
}

# Module-specific summary lines after a module's report: the cross-target digests (M0 step 8). Then the pool's check
# (port plan §8.5): a module whose rows leave a work-table slot claimed fails.
fn _par_module_done(mp, ml) {
    var leak = _pmn_scratch_claimed();
    if (leak != 0) {
        print("  FAIL: ", 8);
        fmt_int(leak);
        println(" work-table pool slots still claimed after the module");
    }
    if (_par_eq(mp, ml, "constants") == 1) { _par_dg_print(12, "const"); }
    if (_par_eq(mp, ml, "math") != 1) { return leak; }
    _par_dg_print(0, "f64::exp (_pmn_km_cr_exp)");
    _par_dg_print(1, "f64::ln (_pmn_km_cr_ln)");
    _par_dg_print(2, "f64::ln_1p (_pmn_cr_log1p)");
    _par_dg_print(3, "f64::exp_m1 (_pmn_km_cr_expm1)");
    _par_dg_print(4, "f64::powf (_pmn_km_cr_pow)");
    _par_dg_print(5, "f64::sin (_pmn_km_cr_sin)");
    _par_dg_print(6, "f64::cos (_pmn_km_cr_cos)");
    _par_dg_print(7, "f64::tan (_pmn_cr_tan)");
    _par_dg_print(8, "f64::atan (_pmn_km_cr_atan2)");
    _par_dg_print(9, "f64::log2 (_pmn_cr_log2)");
    _par_dg_print(10, "f64::cbrt (ganita_f64_cbrt)");
    _par_dg_print(11, "class A/B math rows");
    _par_dg_print(13, "shadow: f64_exp (native)");
    _par_dg_print(14, "shadow: f64_ln (native)");
    _par_dg_print(15, "shadow: f64_atan (native)");
    _par_dg_print(16, "shadow: f64_log2 (native)");
    return leak;
}

# Every module is replayed here.
#must_use
fn _par_skip(mp, ml): i64 {
    return 0;
}

var exit_code = _par_main();
sys_exit_group(exit_code);
