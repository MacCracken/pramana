# fmtf.bcyr — serde_json's f64 text (M1 part d1; src/fmtf.cyr).
#
# ns per value written into a reused builder, 4,096 seeded values per row, cycled 250 times (1,024,000 writes). The
# Rust twin is scripts/probes/rust/src/bin/m1_primitives.rs (its `fmt` rows: serde_json::to_writer into a reused
# buffer). The record is docs/benchmarks-rust-v-cyrius.md.

include "tests/lib.cyr"

var g_rng = 0x2545F4914F6CDD1D;
var g_xs = 0;

fn next(): i64 {
    var x = g_rng;
    x = x ^ (x >> 12);
    x = x ^ (x << 25);
    x = x ^ (x >> 27);
    g_rng = x;
    return x * 0x2545F4914F6CDD1D;
}

fn unit(): f64 {
    var top = next() >> 11;
    var a: f64 = f64_from(top);
    var d: f64 = 9007199254740992.0;
    return a / d;
}

fn row(name: cstring): i64 {
    var sb = str_builder_new();
    var total = 0;
    var b = bench_new(name);
    bench_batch_start(b);
    var k = 0;
    while (k < 250) {
        var i = 0;
        while (i < 4096) {
            var x: f64 = load64(g_xs + i * 8);
            store64(sb + 8, 0);
            _pmn_fmt_f64_json(sb, x);
            total = total + load64(sb + 8);
            i = i + 1;
        }
        k = k + 1;
    }
    bench_batch_stop(b, 1024000);
    bench_report(b);
    if (total == 7) { println("sink"); }
    return 0;
}

fn main(): i64 {
    alloc_init();
    g_xs = alloc(4096 * 8);
    var i = 0;
    while (i < 4096) {
        var w: f64 = 1000000.0;
        var u: f64 = unit();
        var x: f64 = w * u;
        store64(g_xs + i * 8, x);
        i = i + 1;
    }
    row("to_json, x in [0, 1e6)");
    i = 0;
    while (i < 4096) {
        var bits = next();
        if (((bits >> 52) & 0x7FF) == 0x7FF) { bits = bits & 0xBFFFFFFFFFFFFFFF; }
        store64(g_xs + i * 8, bits);
        i = i + 1;
    }
    row("to_json, any finite bits");
    return 0;
}

var rc = main();
sys_exit_group(rc);
