# hypothesis.bcyr — src/hypothesis.cyr (M4 part b1): ns per call, on 1.3.0's own criterion bodies
# (rust-old/benches/benchmarks.rs), whose numbers are rust-old/benchmarks.md's (2026-11-14, this host; ADR 010):
# - `hypothesis/t_test_one_sample_1000`: i·0.01 + 5 for i < 1000, against μ₀ = 5 (1,614.9 ns in Rust);
# - `hypothesis/ks_two_sample_1000`: scrambled(1000) against 1.1·scrambled(1200) (22,969 ns);
# - `hypothesis/chi_squared_test_20`: 50 + 3·(i mod 7) against 59 (157.1 ns).
# Each row prints its p-value's bits. The record is docs/benchmarks-rust-v-cyrius.md.

include "tests/lib.cyr"

# Prints a row's result's bit pattern in hex, so a run can be checked against the model.
fn show(name, r: f64): i64 {
    var x: f64 = r;
    print("  ", 2);
    print(name, strlen(name));
    print(": ", 2);
    fmt_hex(load64(&x));
    println("");
    return 0;
}

# Fills p[0, n) with a fixed scramble of [0, 1): (7919i + 13) mod 10007, over 10007.
fn scrambled(p, n): i64 {
    for (var i = 0; i < n; i = i + 1) {
        var w: f64 = f64_from((i * 7919 + 13) % 10007);
        var r: f64 = w / 10007.0;
        store64(p + i * 8, r);
    }
    return 0;
}

# Runs the bench rows below, printing each one's timing and the result a run can be checked by.
fn main(): i64 {
    alloc_init();
    var a = alloc(1200 * 8);
    var b = alloc(1200 * 8);
    var tr: PmnTestResult;
    for (var i = 0; i < 1000; i = i + 1) {
        var x: f64 = f64_from(i);
        var y: f64 = x * 0.01;
        var z: f64 = y + 5.0;
        store64(a + i * 8, z);
    }
    var b1 = bench_new("t_test_one_sample_1000");
    bench_batch_start(b1);
    for (var r = 0; r < 5000; r = r + 1) {
        if (pmn_t_test_one_sample(&tr, a, 1000, 5.0, 0.05) != PMN_ERR_NONE) { return 1; }
    }
    bench_batch_stop(b1, 5000);
    show("p", tr.p_value);
    bench_report(b1);

    scrambled(a, 1000);
    scrambled(b, 1200);
    for (var k = 0; k < 1200; k = k + 1) {
        var v: f64 = load64(b + k * 8);
        var w: f64 = v * 1.1;
        store64(b + k * 8, w);
    }
    var kr: PmnKsResult;
    var b2 = bench_new("ks_two_sample_1000");
    bench_batch_start(b2);
    for (var r2 = 0; r2 < 1000; r2 = r2 + 1) {
        if (pmn_ks_two_sample(&kr, a, 1000, b, 1200, 0.05) != PMN_ERR_NONE) { return 1; }
    }
    bench_batch_stop(b2, 1000);
    show("p", kr.p_value);
    bench_report(b2);

    for (var j = 0; j < 20; j = j + 1) {
        var m: f64 = f64_from((j % 7) * 3);
        var o: f64 = 50.0 + m;
        store64(a + j * 8, o);
        store64(b + j * 8, 59.0);
    }
    var b3 = bench_new("chi_squared_test_20");
    bench_batch_start(b3);
    for (var r3 = 0; r3 < 100000; r3 = r3 + 1) {
        if (pmn_chi_squared_test(&tr, a, 20, b, 20, 0.05) != PMN_ERR_NONE) { return 1; }
    }
    bench_batch_stop(b3, 100000);
    show("p", tr.p_value);
    bench_report(b3);
    return 0;
}

var rc = main();
sys_exit_group(rc);
