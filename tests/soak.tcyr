# One round of the thirteen: the parameters moved by r mod 7 (so a warm-up of 70 rounds meets every text size the
# builder holds), each one's constructor, five methods, codec both ways and Debug. The sum of the pdfs and cdfs, or NaN
# when a constructor or codec refuses.
fn dists_round(r, sb, g: *PmnSimpleRng): f64 {
    var k = r % 7;
    var kf: f64 = f64_from(k);
    var a: f64 = 0.5 + kf;
    var hk: f64 = 0.5 * kf;
    var b: f64 = 1.25 + hk;
    var xk: f64 = 0.375 * kf;
    var x: f64 = xk + 0.1;
    var pk: f64 = 0.1 * kf;
    var p: f64 = pk + 0.1;
    var nint = 10 + k;
    var s: f64 = 0.0;
    var e = 0;
    var d_normal: PmnNormal;
    e = e + PmnNormal_new(&d_normal, x, b);
    var t_normal: f64 = trait_round(&d_normal, x, g);
    s = s + t_normal;
    e = e + codec_normal(&d_normal, sb);
    var d_uniform: PmnUniform;
    e = e + PmnUniform_new(&d_uniform, x, x + b);
    var t_uniform: f64 = trait_round(&d_uniform, x, g);
    s = s + t_uniform;
    e = e + codec_uniform(&d_uniform, sb);
    var d_exponential: PmnExponential;
    e = e + PmnExponential_new(&d_exponential, b);
    var t_exponential: f64 = trait_round(&d_exponential, x, g);
    s = s + t_exponential;
    e = e + codec_exponential(&d_exponential, sb);
    var d_bernoulli: PmnBernoulli;
    e = e + PmnBernoulli_new(&d_bernoulli, p);
    var t_bernoulli: f64 = trait_round(&d_bernoulli, x, g);
    s = s + t_bernoulli;
    e = e + codec_bernoulli(&d_bernoulli, sb);
    var d_cauchy: PmnCauchy;
    e = e + PmnCauchy_new(&d_cauchy, x, b);
    var t_cauchy: f64 = trait_round(&d_cauchy, x, g);
    s = s + t_cauchy;
    e = e + codec_cauchy(&d_cauchy, sb);
    var d_weibull: PmnWeibull;
    e = e + PmnWeibull_new(&d_weibull, a, b);
    var t_weibull: f64 = trait_round(&d_weibull, x, g);
    s = s + t_weibull;
    e = e + codec_weibull(&d_weibull, sb);
    var d_gamma: PmnGamma;
    e = e + PmnGamma_new(&d_gamma, a, b);
    var t_gamma: f64 = trait_round(&d_gamma, x, g);
    s = s + t_gamma;
    e = e + codec_gamma(&d_gamma, sb);
    var d_chisquared: PmnChiSquared;
    e = e + PmnChiSquared_new(&d_chisquared, a);
    var t_chisquared: f64 = trait_round(&d_chisquared, x, g);
    s = s + t_chisquared;
    e = e + codec_chisquared(&d_chisquared, sb);
    var d_beta: PmnBeta;
    e = e + PmnBeta_new(&d_beta, a, b);
    var t_beta: f64 = trait_round(&d_beta, x, g);
    s = s + t_beta;
    e = e + codec_beta(&d_beta, sb);
    var d_studentt: PmnStudentT;
    e = e + PmnStudentT_new(&d_studentt, a);
    var t_studentt: f64 = trait_round(&d_studentt, x, g);
    s = s + t_studentt;
    e = e + codec_studentt(&d_studentt, sb);
    var d_fdistribution: PmnFDistribution;
    e = e + PmnFDistribution_new(&d_fdistribution, a, b);
    var t_fdistribution: f64 = trait_round(&d_fdistribution, x, g);
    s = s + t_fdistribution;
    e = e + codec_fdistribution(&d_fdistribution, sb);
    var d_poisson: PmnPoisson;
    e = e + PmnPoisson_new(&d_poisson, b);
    var t_poisson: f64 = trait_round(&d_poisson, x, g);
    s = s + t_poisson;
    e = e + codec_poisson(&d_poisson, sb);
    var d_binomial: PmnBinomial;
    e = e + PmnBinomial_new(&d_binomial, nint, p);
    var t_binomial: f64 = trait_round(&d_binomial, x, g);
    s = s + t_binomial;
    e = e + codec_binomial(&d_binomial, sb);
    if (e != PMN_ERR_NONE) {
        var nan: f64 = 0x7FF8000000000000;
        return nan;
    }
    return s;
}

# One round of M2's fourteen special functions, the arguments moved by r so the rounds cross their branches: erf and
# erfc either side of 0.84375 and in the tail, lnΓ reflected, the incomplete gamma's series, fraction, small-shape Q
# and Wilson–Hilferty form, and the incomplete beta's fraction, power series and Rust's form past 1e9. The sum of the
# results, which the caller checks is finite.
fn m2_round(r): f64 {
    var k = r % 97;
    var kf: f64 = f64_from(k);
    var t: f64 = kf / 97.0;
    var s: f64 = 0.0;
    var x1: f64 = 6.0 * t - 3.0;
    var e1: f64 = _pmn_erf(x1);
    var e2: f64 = _pmn_erfc(x1);
    var x2: f64 = 30.0 * t - 10.0;
    var e3: f64 = _pmn_normal_cdf(x2);
    var e4: f64 = _pmn_normal_sf(x2);
    s = s + e1 + e2 + e3 + e4;
    var x3: f64 = 20.0 * t - 9.7;
    var l1: f64 = _pmn_ln_gamma(x3);
    var a1: f64 = 0.05 + 30.0 * t;
    var l2: f64 = _pmn_stirling_error(a1);
    var l3: f64 = _pmn_bd0(a1, 7.0);
    var l4: f64 = _pmn_ln_gamma_kernel(a1, 3.0);
    var l5: f64 = _pmn_ln_beta(a1, 0.3);
    s = s + l1 + l2 + l3 + l4 + l5;
    var g1, g2 = _pmn_gamma_inc(a1, 4.0);
    var g3, g4 = _pmn_gamma_inc(0.3, 0.2);
    var g5, g6 = _pmn_gamma_inc(2000000000.0, 2000000000.0);
    var g7: f64 = _pmn_regularized_lower_incomplete_gamma(a1, 9.0);
    var g8: f64 = _pmn_regularized_upper_incomplete_gamma(a1, 9.0);
    s = s + g1 + g2 + g3 + g4 + g5 + g6 + g7 + g8;
    var xb: f64 = 0.02 + 0.96 * t;
    var yb: f64 = 1.0 - xb;
    var b1, b2 = _pmn_beta_inc(a1, 4.0, xb, yb);
    var b3, b4 = _pmn_beta_inc(0.01, 50.0, 0.001, 0.999);
    var b5, b6 = _pmn_beta_inc(3000000000.0, 2000000000.0, 0.6, 0.4);
    var b7: f64 = _pmn_regularized_incomplete_beta(xb, 2.5, a1);
    s = s + b1 + b2 + b3 + b4 + b5 + b6 + b7;
    return s;
}

fn m4_cdf(ctx, x: f64): f64 {
    var r: f64 = _pmn_normal_cdf(x);
    return r;
}

# One round of every M4 call (M4 part c): the fourteen statistics, correlation, a KDE and a PCA built, evaluated,
# written, read back and dropped, the six tests, the three intervals, and a TestResult read and dropped. Sizes vary with
# r, up to 300 points, so the pool's slots grow to their marks in the warm-up.
fn m4_round(r, a, b, o, sb): f64 {
    var n = 2 + r % 299;
    for (var i = 0; i < n; i = i + 1) {
        var x: f64 = f64_from((i * 7919 + r * 13) % 1009);
        var y: f64 = x * 0.01;
        store64(a + i * 8, y);
        var z: f64 = f64_from((i * 104729 + r) % 997);
        var w: f64 = z * 0.02;
        store64(b + i * 8, w);
    }
    var acc: f64 = pmn_sum(a, n);
    var t, v = pmn_median(a, n);
    t, v = pmn_mode(a, n);
    t, v = pmn_kurtosis(a, n);
    t, v = pmn_percentile(a, n, 37.5);
    t, v = pmn_iqr(a, n);
    t, v = pmn_range(a, n);
    var q: f64 = v;
    acc = acc + q;
    var recs[32];
    store64(&recs, a);
    store64(&recs + 8, n);
    store64(&recs + 16, b);
    store64(&recs + 24, n);
    if (pmn_correlation_matrix(&recs, 2, o, 4) != PMN_ERR_NONE) { return 0.0 / 0.0; }
    var kd: PmnKernelDensity;
    if (PmnKernelDensity_silverman(&kd, a, n, r % 4) != PMN_ERR_NONE) { return 0.0 / 0.0; }
    var dens: f64 = kd.evaluate(1.0);
    acc = acc + dens;
    store64(sb + 8, 0);
    if (kd.to_json(sb) != PMN_ERR_NONE) { return 0.0 / 0.0; }
    var kd2: PmnKernelDensity;
    if (PmnKernelDensity_from_json(&kd2, load64(sb), load64(sb + 8)) != PMN_ERR_NONE) { return 0.0 / 0.0; }
    PmnKernelDensity_drop(&kd2);
    PmnKernelDensity_drop(&kd);
    var pr: PmnPcaResult;
    if (pmn_pca(&pr, &recs, 2) != PMN_ERR_NONE) { return 0.0 / 0.0; }
    store64(sb + 8, 0);
    if (pr.to_json(sb) != PMN_ERR_NONE) { return 0.0 / 0.0; }
    var pr2: PmnPcaResult;
    if (PmnPcaResult_from_json(&pr2, load64(sb), load64(sb + 8)) != PMN_ERR_NONE) { return 0.0 / 0.0; }
    PmnPcaResult_drop(&pr2);
    PmnPcaResult_drop(&pr);
    var tr: PmnTestResult;
    var kr: PmnKsResult;
    var ar: PmnAnovaResult;
    var ci: PmnConfidenceInterval;
    if (pmn_t_test_two_sample(&tr, a, n, b, n, 0.05) != PMN_ERR_NONE) { return 0.0 / 0.0; }
    var tp: f64 = tr.p_value;
    acc = acc + tp;
    store64(sb + 8, 0);
    if (tr.to_json(sb) != PMN_ERR_NONE) { return 0.0 / 0.0; }
    var tr2: PmnTestResult;
    if (PmnTestResult_from_json(&tr2, load64(sb), load64(sb + 8)) != PMN_ERR_NONE) { return 0.0 / 0.0; }
    PmnTestResult_drop(&tr2);
    if (pmn_ks_two_sample(&kr, a, n, b, n, 0.05) != PMN_ERR_NONE) { return 0.0 / 0.0; }
    if (pmn_ks_one_sample(&kr, a, n, &m4_cdf, 0, 0.05) != PMN_ERR_NONE) { return 0.0 / 0.0; }
    if (pmn_one_way_anova(&ar, &recs, 2, 0.05) != PMN_ERR_NONE) { return 0.0 / 0.0; }
    if (pmn_ci_proportion(&ci, r % 50, 50, 0.95) != PMN_ERR_NONE) { return 0.0 / 0.0; }
    var cu: f64 = ci.upper;
    acc = acc + cu;
    return acc;
}

# One round of every M5 call (M5 part d): the three fits with their predictions, residuals, codecs and drops, the
# time-series functions, an ARIMA fit, forecast, codec and drop, and the Bayesian calls, at up to 200 points.
fn m5_round(r, a, b, o, recs, sb): f64 {
    var n = 8 + r % 192;
    for (var i = 0; i < n; i = i + 1) {
        var fi: f64 = f64_from(i);
        store64(a + i * 8, fi);
        var w: f64 = f64_from((i * 7919 + r * 31) % 101);
        var y: f64 = w * 0.03;
        var s: f64 = 0.5 * fi;
        var yv: f64 = s + y;
        store64(b + i * 8, yv);
        store64(recs + i * 16, b + i * 8);
        store64(recs + i * 16 + 8, 1);
    }
    var acc: f64 = 0.0;
    var lm: PmnLinearModel;
    if (pmn_linear_regression(&lm, a, n, b, n) != PMN_ERR_NONE) { return 0.0 / 0.0; }
    if (pmn_residuals(&lm, a, n, b, n, o, 200) != PMN_ERR_NONE) { return 0.0 / 0.0; }
    var pm: PmnPolynomialModel;
    if (pmn_polynomial_regression(&pm, a, n, b, n, 1 + r % 3) != PMN_ERR_NONE) { return 0.0 / 0.0; }
    store64(sb + 8, 0);
    if (pm.to_json(sb) != PMN_ERR_NONE) { return 0.0 / 0.0; }
    var pm2: PmnPolynomialModel;
    if (PmnPolynomialModel_from_json(&pm2, load64(sb), load64(sb + 8)) != PMN_ERR_NONE) { return 0.0 / 0.0; }
    var pp: f64 = pmn_predict_poly(&pm2, 3.0);
    acc = acc + pp;
    PmnPolynomialModel_drop(&pm2);
    PmnPolynomialModel_drop(&pm);
    var lab = o + 100 * 8;
    for (var j = 0; j < n; j = j + 1) {
        var lv: f64 = 0.0;
        if ((j * 13 + r) % 7 > 3) { lv = 1.0; }
        store64(lab + j * 8, lv);
    }
    var lg: PmnLogisticModel;
    if (pmn_logistic_regression(&lg, recs, n, lab, n, 1.0, 20) != PMN_ERR_NONE) { return 0.0 / 0.0; }
    var lp: f64 = pmn_predict_logistic_proba(&lg, b, 1);
    acc = acc + lp;
    PmnLogisticModel_drop(&lg);
    if (pmn_moving_average(b, n, 5, o, 200) != PMN_ERR_NONE) { return 0.0 / 0.0; }
    if (pmn_exponential_smoothing(b, n, 0.3, o, 200) != PMN_ERR_NONE) { return 0.0 / 0.0; }
    if (pmn_difference(b, n, 2, o, 200) != PMN_ERR_NONE) { return 0.0 / 0.0; }
    var t, v = pmn_autocorrelation(b, n, 1);
    var am: PmnArimaModel;
    if (pmn_arima_fit(&am, b, n, 2, 1) != PMN_ERR_NONE) { return 0.0 / 0.0; }
    if (pmn_arima_forecast(&am, b, n, 5, o, 200) != PMN_ERR_NONE) { return 0.0 / 0.0; }
    store64(sb + 8, 0);
    if (am.to_json(sb) != PMN_ERR_NONE) { return 0.0 / 0.0; }
    var am2: PmnArimaModel;
    if (PmnArimaModel_from_json(&am2, load64(sb), load64(sb + 8)) != PMN_ERR_NONE) { return 0.0 / 0.0; }
    PmnArimaModel_drop(&am2);
    PmnArimaModel_drop(&am);
    var f0: f64 = load64(o);
    acc = acc + f0;
    var u: PmnBayesianUpdate;
    if (PmnBayesianUpdate_new(&u, 0.5, 0.4, 0.3) != PMN_ERR_NONE) { return 0.0 / 0.0; }
    var po: f64 = u.posterior();
    acc = acc + po;
    return acc;
}

fn main() {
    alloc_init();
    g_vals = alloc(20000 * 8);
    var n = 0;
    g_doc = doc_of(100, &n);
    g_doc_n = n;
    g_big = doc_of(20000, &n);
    g_big_n = n;
    var sb = str_builder_new();

    test_group("a warm-up fills the pool's slots and the freelist's classes");
    var warm = 0;
    for (var w = 0; w < 50; w = w + 1) { warm = warm + round(sb, 1); }
    assert_eq(warm, 0, "every call succeeds");
    assert(g_big_n > 300000, "the large document is over 300 KB, so its arena is a block of its own");

    test_group("10^4 rounds of every M1 path that allocates, 200 of them with the large document");
    var b0 = alloc_used();
    var f0 = _fl_arena_pos;
    var v0 = vm_kb();
    var bad = 0;
    for (var r = 0; r < 10000; r = r + 1) {
        var with_big = 0;
        if (r % 50 == 0) { with_big = 1; }
        bad = bad + round(sb, with_big);
    }
    assert_eq(bad, 0, "every call succeeds");
    assert_eq(alloc_used() - b0, 0, "the bump heap: 0 bytes taken");
    assert_eq(_fl_arena_pos - f0, 0, "the freelist's arena: 0 bytes carved, every block reused");
    var v1 = vm_kb();
    if (v0 >= 0) {
        assert_eq(v1 - v0, 0, "the mapped size: unchanged, every large block unmapped");
    } else {
        println("  (no /proc/self/statm on this target: the mapped size isn't measured)");
    }
    assert_eq(_pmn_scratch_claimed(), 0, "the pool: nothing left claimed");
    assert(_pmn_scratch_bytes() <= 8 * 2 * 1048576, "and no slot over 2 MiB");

    test_group("10^4 rounds of M2's fourteen special functions (M2 part c): nothing taken");
    var m2w: f64 = m2_round(1);
    var mb0 = alloc_used();
    var mf0 = _fl_arena_pos;
    var mv0 = vm_kb();
    var acc: f64 = m2w;
    for (var r2 = 0; r2 < 10000; r2 = r2 + 1) {
        var v2: f64 = m2_round(r2);
        acc = acc + v2;
    }
    assert(_pmn_is_finite(acc) == 1, "every result is finite");
    assert_eq(alloc_used() - mb0, 0, "the bump heap: 0 bytes taken");
    assert_eq(_fl_arena_pos - mf0, 0, "the freelist's arena: 0 bytes carved");
    var mv1 = vm_kb();
    if (mv0 >= 0) {
        assert_eq(mv1 - mv0, 0, "the mapped size: unchanged");
    } else {
        println("  (no /proc/self/statm on this target: the mapped size isn't measured)");
    }
    assert_eq(_pmn_scratch_claimed(), 0, "the pool: nothing claimed");

    test_group("10^4 linalg factorizations and solves on caller buffers (M3 part d1): nothing taken");
    var la = alloc(24 * 24 * 8);
    var ll = alloc(24 * 24 * 8);
    var lb = alloc(24 * 8);
    var lx = alloc(24 * 8);
    var lw: f64 = linalg_round(0, la, ll, lb, lx);
    var lb0 = alloc_used();
    var lf0 = _fl_arena_pos;
    var lv0 = vm_kb();
    var lacc: f64 = lw;
    for (var r3 = 0; r3 < 10000; r3 = r3 + 1) {
        var v3: f64 = linalg_round(r3, la, ll, lb, lx);
        lacc = lacc + v3;
    }
    assert(_pmn_is_finite(lacc) == 1, "every factorization and solve succeeds, finite");
    assert_eq(alloc_used() - lb0, 0, "the bump heap: 0 bytes taken");
    assert_eq(_fl_arena_pos - lf0, 0, "the freelist's arena: 0 bytes carved");
    var lv1 = vm_kb();
    if (lv0 >= 0) {
        assert_eq(lv1 - lv0, 0, "the mapped size: unchanged");
    } else {
        println("  (no /proc/self/statm on this target: the mapped size isn't measured)");
    }
    assert_eq(_pmn_scratch_claimed(), 0, "the pool: nothing claimed");

    test_group("10^4 MultivariateNormal rounds, 10^3 of them at d = 32 (M3 part d2): every block freed");
    var mm = alloc(32 * 8);
    var mc = alloc(32 * 32 * 8);
    var mx = alloc(32 * 8);
    var mo = alloc(32 * 8);
    var msb = str_builder_new();
    var mw: f64 = 0.0;
    for (var r4 = 0; r4 < 70; r4 = r4 + 1) {   # every shape the loop makes, so the pool's slots reach their sizes
        var w4: f64 = mvn_round(r4, mm, mc, mx, mo, msb);
        mw = mw + w4;
    }
    var nb0 = alloc_used();
    var nf0 = _fl_arena_pos;
    var nv0 = vm_kb();
    var macc: f64 = mw;
    for (var r5 = 0; r5 < 10000; r5 = r5 + 1) {
        var v5: f64 = mvn_round(r5, mm, mc, mx, mo, msb);
        macc = macc + v5;
    }
    assert(_pmn_is_finite(macc) == 1, "every round succeeds, its log density finite");
    assert_eq(alloc_used() - nb0, 0, "the bump heap: 0 bytes taken");
    assert_eq(_fl_arena_pos - nf0, 0, "the freelist's arena: 0 bytes carved");
    var nv1 = vm_kb();
    if (nv0 >= 0) {
        assert_eq(nv1 - nv0, 0, "the mapped size: unchanged");
    } else {
        println("  (no /proc/self/statm on this target: the mapped size isn't measured)");
    }
    assert_eq(_pmn_scratch_claimed(), 0, "the pool: nothing claimed");

    test_group("10^4 rounds of the thirteen caller-storage distributions, every call (M3 part e): nothing taken");
    var dsb = str_builder_new();
    var dg: PmnSimpleRng;
    var edg = PmnSimpleRng_new(&dg, 7);
    var dw: f64 = 0.0;
    for (var r6 = 0; r6 < 70; r6 = r6 + 1) {
        var w6: f64 = dists_round(r6, dsb, &dg);
        dw = dw + w6;
    }
    var qb0 = alloc_used();
    var qf0 = _fl_arena_pos;
    var qv0 = vm_kb();
    var dacc: f64 = dw;
    for (var r7 = 0; r7 < 10000; r7 = r7 + 1) {
        var v7: f64 = dists_round(r7, dsb, &dg);
        dacc = dacc + v7;
    }
    assert(_pmn_is_finite(dacc) == 1 && edg == PMN_ERR_NONE,
      "every constructor and codec succeeds, every pdf and cdf finite");
    assert_eq(alloc_used() - qb0, 0, "the bump heap: 0 bytes taken");
    assert_eq(_fl_arena_pos - qf0, 0, "the freelist's arena: 0 bytes carved");
    var qv1 = vm_kb();
    if (qv0 >= 0) {
        assert_eq(qv1 - qv0, 0, "the mapped size: unchanged");
    } else {
        println("  (no /proc/self/statm on this target: the mapped size isn't measured)");
    }
    assert_eq(_pmn_scratch_claimed(), 0, "the pool: nothing claimed");

    test_group("10^4 rounds of every M4 call, KDE, PCA and TestResult built, written, read and dropped (M4 part c)");
    var m4a = alloc(300 * 8);
    var m4b = alloc(300 * 8);
    var m4o = alloc(4 * 8);
    var m4sb = str_builder_new();
    var m4w: f64 = 0.0;
    for (var r8 = 0; r8 < 600; r8 = r8 + 1) {   # every size the loop makes, so the pool's slots reach their marks
        var w8: f64 = m4_round(r8, m4a, m4b, m4o, m4sb);
        m4w = m4w + w8;
    }
    var xb0 = alloc_used();
    var xf0 = _fl_arena_pos;
    var xv0 = vm_kb();
    var m4acc: f64 = m4w;
    for (var r9 = 0; r9 < 10000; r9 = r9 + 1) {
        var v9: f64 = m4_round(r9, m4a, m4b, m4o, m4sb);
        m4acc = m4acc + v9;
    }
    assert(_pmn_is_finite(m4acc) == 1, "every call succeeds, every value finite");
    assert_eq(alloc_used() - xb0, 0, "the bump heap: 0 bytes taken");
    assert_eq(_fl_arena_pos - xf0, 0, "the freelist's arena: 0 bytes carved");
    var xv1 = vm_kb();
    if (xv0 >= 0) {
        assert_eq(xv1 - xv0, 0, "the mapped size: unchanged");
    } else {
        println("  (no /proc/self/statm on this target: the mapped size isn't measured)");
    }
    assert_eq(_pmn_scratch_claimed(), 0, "the pool: nothing claimed");

    test_group("10^4 rounds of every M5 call, the models built, written, read and dropped (M5 part d)");
    var m5a = alloc(200 * 8);
    var m5b = alloc(200 * 8);
    var m5o = alloc(400 * 8);
    var m5r = alloc(200 * 16);
    var m5sb = str_builder_new();
    var m5w: f64 = 0.0;
    for (var ra = 0; ra < 400; ra = ra + 1) {   # every size the loop makes, so the pool's slots reach their marks
        var wa: f64 = m5_round(ra, m5a, m5b, m5o, m5r, m5sb);
        m5w = m5w + wa;
    }
    var yb0 = alloc_used();
    var yf0 = _fl_arena_pos;
    var yv0 = vm_kb();
    var m5acc: f64 = m5w;
    for (var rb = 0; rb < 10000; rb = rb + 1) {
        var vb: f64 = m5_round(rb, m5a, m5b, m5o, m5r, m5sb);
        m5acc = m5acc + vb;
    }
    assert(_pmn_is_finite(m5acc) == 1, "every call succeeds, every value finite");
    assert_eq(alloc_used() - yb0, 0, "the bump heap: 0 bytes taken");
    assert_eq(_fl_arena_pos - yf0, 0, "the freelist's arena: 0 bytes carved");
    var yv1 = vm_kb();
    if (yv0 >= 0) {
        assert_eq(yv1 - yv0, 0, "the mapped size: unchanged");
    } else {
        println("  (no /proc/self/statm on this target: the mapped size isn't measured)");
    }
    assert_eq(_pmn_scratch_claimed(), 0, "the pool: nothing claimed");

    return assert_summary();
}

var exit_code = main();
# Any failure at all is exit 1: a wait status is 8 bits, so a raw count of 256 would read as success.
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
