# soak.tcyr — M1's allocation soak (port plan §7's gate, D11; probe P4's measures), and M2's.
#
# Every M1 path that allocates, run 10^4 times after a warm-up: JSON decodes small and large (a large document's
# arena is a freelist block over 4 KB, mapped and unmapped each time), JSON writes, the error codec and SimpleRng's
# codec both ways, both bridge fits, and nine nested pool claims (the ninth an overflow block). Afterwards the bump
# heap, the freelist's arena cursor, the process's mapped size (/proc/self/statm, where the target has it) and the
# pool's claimed slots must all be where they were: nothing an M1 call took stays taken. M2's special functions
# (M2 part c, its gate) take nothing at all: 10^4 rounds of each of the fourteen, across their branches, leave the same
# four measures where they were. So does M3 part d1's linalg: 10^4 factorizations and solves on caller buffers, where
# hisab's return a fresh Vec each call and ganita's solve leaves 8n bytes (ledger L4). M3's gate (part e) adds the
# thirteen caller-storage distributions: 10^4 rounds of every call of each, codecs and Debug included. And M3 part d2's
# MultivariateNormal, the one owned distribution: 10^4 rounds of its constructor, both densities, a draw, a clone and
# its JSON both ways, each block freed by its drop, a tenth of them at d = 32 (a block over 4 KB, mapped and
# unmapped). M4's gate (part c) adds every M4 call: the statistics, correlation, a KDE and a PCA built, written, read
# back and dropped, the six tests, the intervals and a decoded TestResult's owned name, 10^4 rounds at up to 300 points.
# M5's gate (part d) adds every M5 call: the fits, the time series, ARIMA and its codec, the Bayesian calls.

include "tests/lib.cyr"

var g_doc = 0;
var g_doc_n = 0;
var g_big = 0;
var g_big_n = 0;
var g_vals = 0;

# The process's mapped size in KB, from /proc/self/statm's first field (4 KB pages); −1 where it can't be read.
fn vm_kb(): i64 {
    var buf[64];
    var n = file_read_all("/proc/self/statm", &buf, 63);
    if (n <= 0) { return 0 - 1; }
    var v = 0;
    var i = 0;
    while (i < n) {
        var c = load8(&buf + i);
        if (c < 48 || c > 57) { break; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v * 4;
}

fn dec_vec(root, ctx): i64 {
    var n = _pmn_json_arr_len(root);
    if (n < 0 || n > 20000) { return PMN_ERR_DESERIALIZE; }
    return _pmn_json_vec_f64(root, g_vals, 20000);
}

fn dec_pair(root, ctx): i64 {
    var names[16];
    store64(&names, "mean");
    store64(&names + 8, "std_dev");
    var sl[16];
    var e = _pmn_json_struct(root, &names, 2, &sl);
    if (e != PMN_ERR_NONE) { return e; }
    var w[16];
    e = _pmn_json_f64(load64(&sl), &w);
    if (e == PMN_ERR_NONE) { e = _pmn_json_f64(load64(&sl + 8), &w + 8); }
    return e;
}

# One round of every allocating M1 path; the count of calls that failed.
fn round(sb, big): i64 {
    var bad = 0;
    var pair = "{\"mean\": 0.5, \"std_dev\": 2.25, \"zz\": [1, {\"a\": null}]}";
    if (_pmn_json_decode(pair, strlen(pair), &dec_pair, 0) != PMN_ERR_NONE) { bad = bad + 1; }
    if (_pmn_json_decode(g_doc, g_doc_n, &dec_vec, 0) != PMN_ERR_NONE) { bad = bad + 1; }
    if (big == 1 && _pmn_json_decode(g_big, g_big_n, &dec_vec, 0) != PMN_ERR_NONE) { bad = bad + 1; }
    var bad_doc = "[1, 2,";
    if (_pmn_json_decode(bad_doc, strlen(bad_doc), &dec_vec, 0) != PMN_ERR_DESERIALIZE) { bad = bad + 1; }
    store64(sb + 8, 0);
    if (_pmn_json_w_mat_f64(sb, g_vals, 10, 10) != PMN_ERR_NONE) { bad = bad + 1; }
    store64(sb + 8, 0);
    if (pmn_err_to_json(PMN_ERR_COMPUTATION_ERROR, sb) != PMN_ERR_NONE) { bad = bad + 1; }
    var et, ev = pmn_err_from_json(load64(sb), load64(sb + 8));
    if (is_err_result(et) == 1 || ev != PMN_ERR_COMPUTATION_ERROR) { bad = bad + 1; }
    store64(sb + 8, 0);
    if (pmn_err_debug(PMN_ERR_INVALID_SAMPLE, sb, 1) != PMN_ERR_NONE) { bad = bad + 1; }
    var g: PmnSimpleRng;
    var h: PmnSimpleRng;
    if (PmnSimpleRng_new(&g, 42) != PMN_ERR_NONE) { bad = bad + 1; }
    store64(sb + 8, 0);
    if (g.to_json(sb) != PMN_ERR_NONE || PmnSimpleRng_from_json(&h, load64(sb), load64(sb + 8)) != PMN_ERR_NONE) {
        bad = bad + 1;
    }
    store64(sb + 8, 0);
    if (g.debug(sb, 0) != PMN_ERR_NONE) { bad = bad + 1; }
    var recs[320];
    for (var k = 0; k < 20; k = k + 1) {
        var kf: f64 = f64_from(k + 1);
        var t: f64 = 50.0 / kf;
        store64(&recs + k * 16, k + 1);
        store64(&recs + k * 16 + 8, t);
    }
    var out[16];
    if (pmn_learning_trials_to_power_law(&recs, 20, &out) != PMN_ERR_NONE) { bad = bad + 1; }
    if (pmn_response_times_to_hick_params(&recs, 20, &out) != PMN_ERR_NONE) { bad = bad + 1; }
    var ps[72];
    var ss[72];
    for (var m = 0; m < 9; m = m + 1) {
        var p, s = _pmn_scratch_take(256 + m);
        if (p == 0) { bad = bad + 1; }
        store64(&ps + m * 8, p);
        store64(&ss + m * 8, s);
    }
    for (var m2 = 8; m2 >= 0; m2 = m2 - 1) { _pmn_scratch_give(load64(&ps + m2 * 8), load64(&ss + m2 * 8)); }
    return bad;
}

# Writes `[x0,x1,…]` of n seeded values into a new buffer; its pointer, the length at *lenp.
fn doc_of(n, lenp): i64 {
    var sb = str_builder_new();
    var x: f64 = 0.125;
    var e = _pmn_json_w_lit(sb, "[");
    for (var i = 0; i < n; i = i + 1) {
        if (i > 0) { e = e | _pmn_json_w_lit(sb, ","); }
        x = x * 1.0001 + 0.37;
        e = e | _pmn_json_w_f64(sb, x);
    }
    e = e | _pmn_json_w_lit(sb, "]");
    if (e != PMN_ERR_NONE) { return 0; }
    store64(lenp, load64(sb + 8));
    return load64(sb);
}

# One linalg round on caller buffers a (the matrix), l (the factor), b and x: the n × n [2, −1] tridiagonal with r
# added to its diagonal, n from 1 to 24, factored and solved. x's first element, which the caller checks is finite.
fn linalg_round(r, a, l, b, x): f64 {
    var n = 1 + r % 24;
    var rf: f64 = f64_from(r % 7);
    for (var i = 0; i < n; i = i + 1) {
        for (var j = 0; j < n; j = j + 1) {
            var v: f64 = 0.0;
            if (i == j) { v = 2.0 + rf; }
            if (i - j == 1 || j - i == 1) { v = -1.0; }
            store64(a + (i * n + j) * 8, v);
        }
        store64(b + i * 8, 1.0);
    }
    if (_pmn_cholesky(a, n, l) != PMN_ERR_NONE) {
        var nan: f64 = 0x7FF8000000000000;
        return nan;
    }
    if (_pmn_cholesky_solve(l, n, b, x) != PMN_ERR_NONE) {
        var nan2: f64 = 0x7FF8000000000000;
        return nan2;
    }
    var x0: f64 = load64(x);
    return x0;
}

# One MultivariateNormal round on caller buffers mean, cov, x and out and the builder sb: d from 1 to 6, or 32 when
# r is a multiple of 10, the covariance the [2 + r mod 7, −1] tridiagonal; the constructor, log_pdf and pdf at x, a draw
# from seed r, a clone, a write and a read back, and the three drops. The log density, which the caller checks is
# finite, or NaN when a call refuses.
fn mvn_round(r, mean, cov, x, out, sb): f64 {
    var d = 1 + r % 6;
    if (r % 10 == 0) { d = 32; }
    var rf: f64 = f64_from(r % 7);
    for (var i = 0; i < d; i = i + 1) {
        for (var j = 0; j < d; j = j + 1) {
            var v: f64 = 0.0;
            if (i == j) { v = 2.0 + rf; }
            if (i - j == 1 || j - i == 1) { v = -1.0; }
            store64(cov + (i * d + j) * 8, v);
        }
        var mi: f64 = f64_from(i);
        store64(mean + i * 8, mi);
        var xi: f64 = 0.5 + mi;
        store64(x + i * 8, xi);
    }
    var nan: f64 = 0x7FF8000000000000;
    var m: PmnMultivariateNormal;
    if (PmnMultivariateNormal_new(&m, mean, d, cov, d, d) != PMN_ERR_NONE) { return nan; }
    var t, v = m.log_pdf(x, d);
    var t2, v2 = m.pdf(x, d);
    var g: PmnSimpleRng;
    var eg = PmnSimpleRng_new(&g, r);
    var es = m.sample(&g, out, d);
    var c: PmnMultivariateNormal;
    var ec = PmnMultivariateNormal_clone(&c, &m);
    store64(sb + 8, 0);
    var ew = c.to_json(sb);
    var back: PmnMultivariateNormal;
    var eb = PmnMultivariateNormal_from_json(&back, load64(sb), load64(sb + 8));
    var d1 = PmnMultivariateNormal_drop(&back);
    var d2 = PmnMultivariateNormal_drop(&c);
    var d3 = PmnMultivariateNormal_drop(&m);
    if (t == Err || t2 == Err || es != PMN_ERR_NONE || ec != PMN_ERR_NONE || ew != PMN_ERR_NONE) { return nan; }
    if (eb != PMN_ERR_NONE) { return nan; }
    var lp: f64 = v;
    return lp;
}

# M3's gate: the thirteen caller-storage distributions, every call of each. g_sink folds the means, variances and
# draws by their bits (Cauchy's mean is NaN by definition, so they are not summed).
var g_sink = 0;

# The five trait methods of d at x, one draw from g: pdf(x) + cdf(x), which the caller checks is finite.
fn trait_round<D: PmnDistribution>(d: *D, x: f64, g: *PmnSimpleRng): f64 {
    var p: f64 = d.pdf(x);
    var c: f64 = d.cdf(x);
    var m: f64 = d.mean();
    var v: f64 = d.variance();
    var s: f64 = d.sample(g);
    g_sink = g_sink ^ load64(&m) ^ load64(&v) ^ load64(&s);
    return p + c;
}

# Each distribution's JSON written and read back, and its Debug in both forms, into sb: the codes summed.
fn codec_normal(d: *PmnNormal, sb): i64 {
    store64(sb + 8, 0);
    var e = d.to_json(sb);
    var back: PmnNormal;
    e = e + PmnNormal_from_json(&back, load64(sb), load64(sb + 8));
    store64(sb + 8, 0);
    e = e + d.debug(sb, 0) + d.debug(sb, 1);
    return e;
}

fn codec_uniform(d: *PmnUniform, sb): i64 {
    store64(sb + 8, 0);
    var e = d.to_json(sb);
    var back: PmnUniform;
    e = e + PmnUniform_from_json(&back, load64(sb), load64(sb + 8));
    store64(sb + 8, 0);
    e = e + d.debug(sb, 0) + d.debug(sb, 1);
    return e;
}

