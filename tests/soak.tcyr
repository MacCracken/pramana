# soak.tcyr — M1's allocation soak (port plan §7's gate, D11; probe P4's measures), and M2's.
#
# Every M1 path that allocates, run 10^4 times after a warm-up: JSON decodes small and large (a large document's
# arena is a freelist block over 4 KB, mapped and unmapped each time), JSON writes, the error codec and SimpleRng's
# codec both ways, both bridge fits, and nine nested pool claims (the ninth an overflow block). Afterwards the bump
# heap, the freelist's arena cursor, the process's mapped size (/proc/self/statm, where the target has it) and the
# pool's claimed slots must all be where they were: nothing an M1 call took stays taken. M2's special functions
# (M2 part c, its gate) take nothing at all: 10^4 rounds of each of the fourteen, across their branches, leave the same
# four measures where they were. So does M3 part d1's linalg: 10^4 factorizations and solves on caller buffers, where
# hisab's return a fresh Vec each call and ganita's solve leaves 8n bytes (ledger L4).

include "tests/lib.cyr"

var g_doc = 0;
var g_doc_n = 0;
var g_big = 0;
var g_big_n = 0;
var g_vals = 0;

# The process's mapped size in KB, from /proc/self/statm's first field (4 KB pages); −1 where it can't be read.
fn vm_kb(): i64 {
    var buf[64];
    var n = file_read_all("/proc/self/statm", &buf, 63);
    if (n <= 0) { return 0 - 1; }
    var v = 0;
    var i = 0;
    while (i < n) {
        var c = load8(&buf + i);
        if (c < 48 || c > 57) { break; }
        v = v * 10 + (c - 48);
        i = i + 1;
    }
    return v * 4;
}

fn dec_vec(root, ctx): i64 {
    var n = _pmn_json_arr_len(root);
    if (n < 0 || n > 20000) { return PMN_ERR_DESERIALIZE; }
    return _pmn_json_vec_f64(root, g_vals, 20000);
}

fn dec_pair(root, ctx): i64 {
    var names[16];
    store64(&names, "mean");
    store64(&names + 8, "std_dev");
    var sl[16];
    var e = _pmn_json_struct(root, &names, 2, &sl);
    if (e != PMN_ERR_NONE) { return e; }
    var w[16];
    e = _pmn_json_f64(load64(&sl), &w);
    if (e == PMN_ERR_NONE) { e = _pmn_json_f64(load64(&sl + 8), &w + 8); }
    return e;
}

# One round of every allocating M1 path; the count of calls that failed.
fn round(sb, big): i64 {
    var bad = 0;
    var pair = "{\"mean\": 0.5, \"std_dev\": 2.25, \"zz\": [1, {\"a\": null}]}";
    if (_pmn_json_decode(pair, strlen(pair), &dec_pair, 0) != PMN_ERR_NONE) { bad = bad + 1; }
    if (_pmn_json_decode(g_doc, g_doc_n, &dec_vec, 0) != PMN_ERR_NONE) { bad = bad + 1; }
    if (big == 1 && _pmn_json_decode(g_big, g_big_n, &dec_vec, 0) != PMN_ERR_NONE) { bad = bad + 1; }
    var bad_doc = "[1, 2,";
    if (_pmn_json_decode(bad_doc, strlen(bad_doc), &dec_vec, 0) != PMN_ERR_DESERIALIZE) { bad = bad + 1; }
    store64(sb + 8, 0);
    if (_pmn_json_w_mat_f64(sb, g_vals, 10, 10) != PMN_ERR_NONE) { bad = bad + 1; }
    store64(sb + 8, 0);
    if (pmn_err_to_json(PMN_ERR_COMPUTATION_ERROR, sb) != PMN_ERR_NONE) { bad = bad + 1; }
    var et, ev = pmn_err_from_json(load64(sb), load64(sb + 8));
    if (is_err_result(et) == 1 || ev != PMN_ERR_COMPUTATION_ERROR) { bad = bad + 1; }
    store64(sb + 8, 0);
    if (pmn_err_debug(PMN_ERR_INVALID_SAMPLE, sb, 1) != PMN_ERR_NONE) { bad = bad + 1; }
    var g: PmnSimpleRng;
    var h: PmnSimpleRng;
    if (PmnSimpleRng_new(&g, 42) != PMN_ERR_NONE) { bad = bad + 1; }
    store64(sb + 8, 0);
    if (g.to_json(sb) != PMN_ERR_NONE || PmnSimpleRng_from_json(&h, load64(sb), load64(sb + 8)) != PMN_ERR_NONE) {
        bad = bad + 1;
    }
    store64(sb + 8, 0);
    if (g.debug(sb, 0) != PMN_ERR_NONE) { bad = bad + 1; }
    var recs[320];
    for (var k = 0; k < 20; k = k + 1) {
        var kf: f64 = f64_from(k + 1);
        var t: f64 = 50.0 / kf;
        store64(&recs + k * 16, k + 1);
        store64(&recs + k * 16 + 8, t);
    }
    var out[16];
    if (pmn_learning_trials_to_power_law(&recs, 20, &out) != PMN_ERR_NONE) { bad = bad + 1; }
    if (pmn_response_times_to_hick_params(&recs, 20, &out) != PMN_ERR_NONE) { bad = bad + 1; }
    var ps[72];
    var ss[72];
    for (var m = 0; m < 9; m = m + 1) {
        var p, s = _pmn_scratch_take(256 + m);
        if (p == 0) { bad = bad + 1; }
        store64(&ps + m * 8, p);
        store64(&ss + m * 8, s);
    }
    for (var m2 = 8; m2 >= 0; m2 = m2 - 1) { _pmn_scratch_give(load64(&ps + m2 * 8), load64(&ss + m2 * 8)); }
    return bad;
}

# Writes `[x0,x1,…]` of n seeded values into a new buffer; its pointer, the length at *lenp.
fn doc_of(n, lenp): i64 {
    var sb = str_builder_new();
    var x: f64 = 0.125;
    var e = _pmn_json_w_lit(sb, "[");
    for (var i = 0; i < n; i = i + 1) {
        if (i > 0) { e = e | _pmn_json_w_lit(sb, ","); }
        x = x * 1.0001 + 0.37;
        e = e | _pmn_json_w_f64(sb, x);
    }
    e = e | _pmn_json_w_lit(sb, "]");
    if (e != PMN_ERR_NONE) { return 0; }
    store64(lenp, load64(sb + 8));
    return load64(sb);
}

# One linalg round on caller buffers a (the matrix), l (the factor), b and x: the n × n [2, −1] tridiagonal with r
# added to its diagonal, n from 1 to 24, factored and solved. x's first element, which the caller checks is finite.
fn linalg_round(r, a, l, b, x): f64 {
    var n = 1 + r % 24;
    var rf: f64 = f64_from(r % 7);
    for (var i = 0; i < n; i = i + 1) {
        for (var j = 0; j < n; j = j + 1) {
            var v: f64 = 0.0;
            if (i == j) { v = 2.0 + rf; }
            if (i - j == 1 || j - i == 1) { v = -1.0; }
            store64(a + (i * n + j) * 8, v);
        }
        store64(b + i * 8, 1.0);
    }
    if (_pmn_cholesky(a, n, l) != PMN_ERR_NONE) {
        var nan: f64 = 0x7FF8000000000000;
        return nan;
    }
    if (_pmn_cholesky_solve(l, n, b, x) != PMN_ERR_NONE) {
        var nan2: f64 = 0x7FF8000000000000;
        return nan2;
    }
    var x0: f64 = load64(x);
    return x0;
}

# One round of M2's fourteen special functions, the arguments moved by r so the rounds cross their branches: erf and
# erfc either side of 0.84375 and in the tail, lnΓ reflected, the incomplete gamma's series, fraction, small-shape Q
# and Wilson–Hilferty form, and the incomplete beta's fraction, power series and Rust's form past 1e9. The sum of the
# results, which the caller checks is finite.
fn m2_round(r): f64 {
    var k = r % 97;
    var kf: f64 = f64_from(k);
    var t: f64 = kf / 97.0;
    var s: f64 = 0.0;
    var x1: f64 = 6.0 * t - 3.0;
    var e1: f64 = _pmn_erf(x1);
    var e2: f64 = _pmn_erfc(x1);
    var x2: f64 = 30.0 * t - 10.0;
    var e3: f64 = _pmn_normal_cdf(x2);
    var e4: f64 = _pmn_normal_sf(x2);
    s = s + e1 + e2 + e3 + e4;
    var x3: f64 = 20.0 * t - 9.7;
    var l1: f64 = _pmn_ln_gamma(x3);
    var a1: f64 = 0.05 + 30.0 * t;
    var l2: f64 = _pmn_stirling_error(a1);
    var l3: f64 = _pmn_bd0(a1, 7.0);
    var l4: f64 = _pmn_ln_gamma_kernel(a1, 3.0);
    var l5: f64 = _pmn_ln_beta(a1, 0.3);
    s = s + l1 + l2 + l3 + l4 + l5;
    var g1, g2 = _pmn_gamma_inc(a1, 4.0);
    var g3, g4 = _pmn_gamma_inc(0.3, 0.2);
    var g5, g6 = _pmn_gamma_inc(2000000000.0, 2000000000.0);
    var g7: f64 = _pmn_regularized_lower_incomplete_gamma(a1, 9.0);
    var g8: f64 = _pmn_regularized_upper_incomplete_gamma(a1, 9.0);
    s = s + g1 + g2 + g3 + g4 + g5 + g6 + g7 + g8;
    var xb: f64 = 0.02 + 0.96 * t;
    var yb: f64 = 1.0 - xb;
    var b1, b2 = _pmn_beta_inc(a1, 4.0, xb, yb);
    var b3, b4 = _pmn_beta_inc(0.01, 50.0, 0.001, 0.999);
    var b5, b6 = _pmn_beta_inc(3000000000.0, 2000000000.0, 0.6, 0.4);
    var b7: f64 = _pmn_regularized_incomplete_beta(xb, 2.5, a1);
    s = s + b1 + b2 + b3 + b4 + b5 + b6 + b7;
    return s;
}

fn main() {
    alloc_init();
    g_vals = alloc(20000 * 8);
    var n = 0;
    g_doc = doc_of(100, &n);
    g_doc_n = n;
    g_big = doc_of(20000, &n);
    g_big_n = n;
    var sb = str_builder_new();

    test_group("a warm-up fills the pool's slots and the freelist's classes");
    var warm = 0;
    for (var w = 0; w < 50; w = w + 1) { warm = warm + round(sb, 1); }
    assert_eq(warm, 0, "every call succeeds");
    assert(g_big_n > 300000, "the large document is over 300 KB, so its arena is a block of its own");

    test_group("10^4 rounds of every M1 path that allocates, 200 of them with the large document");
    var b0 = alloc_used();
    var f0 = _fl_arena_pos;
    var v0 = vm_kb();
    var bad = 0;
    for (var r = 0; r < 10000; r = r + 1) {
        var with_big = 0;
        if (r % 50 == 0) { with_big = 1; }
        bad = bad + round(sb, with_big);
    }
    assert_eq(bad, 0, "every call succeeds");
    assert_eq(alloc_used() - b0, 0, "the bump heap: 0 bytes taken");
    assert_eq(_fl_arena_pos - f0, 0, "the freelist's arena: 0 bytes carved, every block reused");
    var v1 = vm_kb();
    if (v0 >= 0) {
        assert_eq(v1 - v0, 0, "the mapped size: unchanged, every large block unmapped");
    } else {
        println("  (no /proc/self/statm on this target: the mapped size isn't measured)");
    }
    assert_eq(_pmn_scratch_claimed(), 0, "the pool: nothing left claimed");
    assert(_pmn_scratch_bytes() <= 8 * 2 * 1048576, "and no slot over 2 MiB");

    test_group("10^4 rounds of M2's fourteen special functions (M2 part c): nothing taken");
    var m2w: f64 = m2_round(1);
    var mb0 = alloc_used();
    var mf0 = _fl_arena_pos;
    var mv0 = vm_kb();
    var acc: f64 = m2w;
    for (var r2 = 0; r2 < 10000; r2 = r2 + 1) {
        var v2: f64 = m2_round(r2);
        acc = acc + v2;
    }
    assert(_pmn_is_finite(acc) == 1, "every result is finite");
    assert_eq(alloc_used() - mb0, 0, "the bump heap: 0 bytes taken");
    assert_eq(_fl_arena_pos - mf0, 0, "the freelist's arena: 0 bytes carved");
    var mv1 = vm_kb();
    if (mv0 >= 0) {
        assert_eq(mv1 - mv0, 0, "the mapped size: unchanged");
    } else {
        println("  (no /proc/self/statm on this target: the mapped size isn't measured)");
    }
    assert_eq(_pmn_scratch_claimed(), 0, "the pool: nothing claimed");

    test_group("10^4 linalg factorizations and solves on caller buffers (M3 part d1): nothing taken");
    var la = alloc(24 * 24 * 8);
    var ll = alloc(24 * 24 * 8);
    var lb = alloc(24 * 8);
    var lx = alloc(24 * 8);
    var lw: f64 = linalg_round(0, la, ll, lb, lx);
    var lb0 = alloc_used();
    var lf0 = _fl_arena_pos;
    var lv0 = vm_kb();
    var lacc: f64 = lw;
    for (var r3 = 0; r3 < 10000; r3 = r3 + 1) {
        var v3: f64 = linalg_round(r3, la, ll, lb, lx);
        lacc = lacc + v3;
    }
    assert(_pmn_is_finite(lacc) == 1, "every factorization and solve succeeds, finite");
    assert_eq(alloc_used() - lb0, 0, "the bump heap: 0 bytes taken");
    assert_eq(_fl_arena_pos - lf0, 0, "the freelist's arena: 0 bytes carved");
    var lv1 = vm_kb();
    if (lv0 >= 0) {
        assert_eq(lv1 - lv0, 0, "the mapped size: unchanged");
    } else {
        println("  (no /proc/self/statm on this target: the mapped size isn't measured)");
    }
    assert_eq(_pmn_scratch_claimed(), 0, "the pool: nothing claimed");

    return assert_summary();
}

var exit_code = main();
# Any failure at all is exit 1: a wait status is 8 bits, so a raw count of 256 would read as success.
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
