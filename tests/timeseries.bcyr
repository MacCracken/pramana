# timeseries.bcyr — src/timeseries.cyr (M5 part b): ns per call, on 1.3.0's own criterion body
# (rust-old/benches/benchmarks.rs), whose number is rust-old/benchmarks.md's (2026-11-14, this host; ADR 010):
# `timeseries/moving_average_10000_w50`, the 50-point moving average of sin(i) for i < 10⁴ (29,544 ns in Rust). The
# row prints the last average's bits. The record is docs/benchmarks-rust-v-cyrius.md.

include "tests/lib.cyr"

# Runs the bench rows below, printing each one's timing and the result a run can be checked by.
fn main(): i64 {
    alloc_init();
    var x = alloc(10000 * 8);
    var o = alloc(10000 * 8);
    for (var i = 0; i < 10000; i = i + 1) {
        var fi: f64 = f64_from(i);
        var s: f64 = _pmn_sin(fi);
        store64(x + i * 8, s);
    }
    var b1 = bench_new("moving_average_10000_w50");
    bench_batch_start(b1);
    for (var r = 0; r < 2000; r = r + 1) {
        if (pmn_moving_average(x, 10000, 50, o, 10000) != PMN_ERR_NONE) { return 1; }
    }
    bench_batch_stop(b1, 2000);
    print("  the last average: ", 20);
    fmt_hex(load64(o + 9950 * 8));
    println("");
    bench_report(b1);
    return 0;
}

var rc = main();
sys_exit_group(rc);
