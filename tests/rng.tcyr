# rng.tcyr — random numbers (M1 part e1; port plan D7 as amended, ADR 007 row 6).
#
# tests/parity.tcyr replays 1.3.0's own streams (tests/golden/rng.tsv: 40 seeds × 256 draws, and 10^6-draw digests)
# and its SimpleRng documents (tests/golden/json.tsv). These tests name what the module promises on its own: the
# zero seed, the range, a consumer's own generator through the trait, and the codec's edges.

include "tests/lib.cyr"

# A consumer's own generator, as Rust users implemented `Rng`: it counts up in steps of 1/8, then wraps.
struct Eighths {
    k;
}

impl PmnRng for Eighths {
    fn next_f64(self): f64 {
        var a: f64 = f64_from(self.k);
        var d: f64 = 8.0;
        self.k = (self.k + 1) & 7;
        return a / d;
    }
}

# What an API generic over the RNG does with it: the sum of n draws.
fn draw_sum<R: PmnRng>(g: *R, n): f64 {
    var s: f64 = 0.0;
    for (var i = 0; i < n; i = i + 1) {
        var x: f64 = g.next_f64();
        s = s + x;
    }
    return s;
}

fn main() {
    alloc_init();
    var g: PmnSimpleRng;
    var h: PmnSimpleRng;

    test_group("SimpleRng::new");
    assert_eq(PmnSimpleRng_new(&g, 42), PMN_ERR_NONE, "a seed");
    assert_eq(g.state, 42, "is the state");
    assert(PmnSimpleRng_new(&g, 0) == PMN_ERR_NONE && g.state == 1, "a seed of 0 becomes 1");
    var z: f64 = g.next_f64();
    assert(z > 0.0, "so the stream does not stick at 0.0");
    assert_eq(PmnSimpleRng_new(0, 42), PMN_ERR_INVALID_PARAMETER, "a null out is the caller's error");

    test_group("draws");
    PmnSimpleRng_new(&g, 12345);
    PmnSimpleRng_new(&h, 12345);
    var same = 1;
    var inside = 1;
    for (var i = 0; i < 10000; i = i + 1) {
        var a: f64 = g.next_f64();
        var b: f64 = h.next_f64();
        if (load64(&a) != load64(&b)) { same = 0; }
        if (a < 0.0 || a >= 1.0) { inside = 0; }
    }
    assert_eq(same, 1, "one seed, one stream: 10^4 draws bit for bit");
    assert_eq(inside, 1, "every draw in [0, 1)");
    PmnSimpleRng_new(&g, 0 - 1);
    var top: f64 = g.next_f64();
    assert(top >= 0.0 && top < 1.0, "u64::MAX seeds a stream too");

    test_group("the trait: a consumer's own generator");
    var e8 = Eighths { 0 };
    var s8: f64 = draw_sum(&e8, 8);
    assert(s8 == 3.5, "a generic API draws from it: 0/8 + … + 7/8 = 3.5");
    PmnSimpleRng_new(&g, 7);
    PmnSimpleRng_new(&h, 7);
    var sg: f64 = draw_sum(&g, 100);
    var sh: f64 = 0.0;
    for (var j = 0; j < 100; j = j + 1) {
        var d: f64 = h.next_f64();
        sh = sh + d;
    }
    assert(load64(&sg) == load64(&sh), "through the generic, the same draws as direct calls");

    test_group("the JSON codec");
    var sb = str_builder_new();
    PmnSimpleRng_new(&g, 0);
    assert(g.to_json(sb) == PMN_ERR_NONE && load64(sb + 8) == 11 && memeq(load64(sb), "{\"state\":1}", 11) == 1,
        "new(0) writes {\"state\":1}");
    store64(sb + 8, 0);
    PmnSimpleRng_new(&g, 0 - 1);
    assert(g.to_json(sb) == PMN_ERR_NONE && load64(sb + 8) == 30, "u64::MAX writes in full, unsigned");
    assert_eq(PmnSimpleRng_from_json(&h, load64(sb), load64(sb + 8)), PMN_ERR_NONE, "and reads back");
    assert_eq(h.state, 0 - 1, "to the same state");
    store64(sb + 8, 0);
    var zt = "{\"state\":0}";
    assert(PmnSimpleRng_from_json(&h, zt, strlen(zt)) == PMN_ERR_NONE && h.state == 1,
        "a saved state of 0 reads as 1, as 1.3.0's repr does");
    var sq = "[5]";
    assert(PmnSimpleRng_from_json(&h, sq, strlen(sq)) == PMN_ERR_NONE && h.state == 5, "the sequence form reads");
    var neg = "{\"state\":-1}";
    assert_eq(PmnSimpleRng_from_json(&h, neg, strlen(neg)), PMN_ERR_DESERIALIZE, "a negative state refuses");
    var fl = "{\"state\":1.0}";
    assert_eq(PmnSimpleRng_from_json(&h, fl, strlen(fl)), PMN_ERR_DESERIALIZE, "so does a float");
    var miss = "{\"seed\":1}";
    assert_eq(PmnSimpleRng_from_json(&h, miss, strlen(miss)), PMN_ERR_DESERIALIZE, "and a missing state");
    assert_eq(PmnSimpleRng_from_json(0, zt, strlen(zt)), PMN_ERR_INVALID_PARAMETER, "a null out is the caller's");
    assert_eq(_pmn_scratch_claimed(), 0, "nothing claimed");

    test_group("a resumed stream continues where the saved one left off");
    PmnSimpleRng_new(&g, 99);
    for (var k = 0; k < 1000; k = k + 1) {
        var w: f64 = g.next_f64();
    }
    store64(sb + 8, 0);
    assert_eq(g.to_json(sb), PMN_ERR_NONE, "saved after 1,000 draws");
    assert_eq(PmnSimpleRng_from_json(&h, load64(sb), load64(sb + 8)), PMN_ERR_NONE, "restored");
    var cont = 1;
    for (var m = 0; m < 1000; m = m + 1) {
        var p: f64 = g.next_f64();
        var q: f64 = h.next_f64();
        if (load64(&p) != load64(&q)) { cont = 0; }
    }
    assert_eq(cont, 1, "the next 1,000 draws match bit for bit");

    test_group("a soak leaves the heap where it found it");
    var before = alloc_used();
    for (var r = 0; r < 10000; r = r + 1) {
        store64(sb + 8, 0);
        if (g.to_json(sb) != PMN_ERR_NONE) { println("write failed"); }
        if (PmnSimpleRng_from_json(&h, load64(sb), load64(sb + 8)) != PMN_ERR_NONE) { println("read failed"); }
    }
    assert_eq(alloc_used() - before, 0, "10^4 saves and restores: 0 bytes of bump heap");
    assert_eq(_pmn_scratch_claimed(), 0, "and nothing left claimed");

    return assert_summary();
}

var exit_code = main();
# Any failure at all is exit 1: a wait status is 8 bits, so a raw count of 256 would read as success.
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
