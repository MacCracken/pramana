# crmath.bcyr — the correctly rounded primitives (M1 part b; port plan D2, §3.7).
#
# ns per call on 4,096 seeded arguments per row, cycled 250 times (1,024,000 calls). The Rust twin is
# `m1_primitives.rs`: the same xorshift, the same regions, Rust's f64 methods (glibc 2.44). The record is
# docs/benchmarks-rust-v-cyrius.md, which keeps the twin's numbers: the Rust twins went with the Rust tooling (ADR
# 010).

include "tests/lib.cyr"

var g_rng = 0x2545F4914F6CDD1D;
var g_xs = 0;
var g_ys = 0;

fn unit(): f64 {
    var x = g_rng;
    x = x ^ (x >> 12);
    x = x ^ (x << 25);
    x = x ^ (x >> 27);
    g_rng = x;
    var top = (x * 0x2545F4914F6CDD1D) >> 11;
    var a: f64 = f64_from(top);
    var d: f64 = 9007199254740992.0;
    return a / d;
}

# Fills `buf` with 4,096 uniform values in [lo, hi).
fn fill(buf, lo: f64, hi: f64): i64 {
    var i = 0;
    while (i < 4096) {
        var w: f64 = hi - lo;
        var u: f64 = unit();
        var x: f64 = lo + w * u;
        store64(buf + i * 8, x);
        i = i + 1;
    }
    return 0;
}

# `which`: 0 exp, 1 ln, 2 exp_m1, 3 powf, 4 sin, 5 cos, 6 atan, 7 ln_1p, 8 tan, 9 log2.
fn row(name: cstring, which): i64 {
    var s: f64 = 0.0;
    var b = bench_new(name);
    bench_batch_start(b);
    var k = 0;
    while (k < 250) {
        var i = 0;
        while (i < 4096) {
            var x: f64 = load64(g_xs + i * 8);
            var r: f64 = 0.0;
            if (which == 0) { r = _pmn_km_cr_exp(x); }
            if (which == 1) { r = _pmn_km_cr_ln(x); }
            if (which == 2) { r = _pmn_km_cr_expm1(x); }
            if (which == 3) {
                var y: f64 = load64(g_ys + i * 8);
                r = _pmn_km_cr_pow(x, y);
            }
            if (which == 4) { r = _pmn_km_cr_sin(x); }
            if (which == 5) { r = _pmn_km_cr_cos(x); }
            if (which == 6) { r = _pmn_km_cr_atan2(x, 1.0); }
            if (which == 7) { r = _pmn_cr_log1p(x); }
            if (which == 8) { r = _pmn_cr_tan(x); }
            if (which == 9) { r = _pmn_cr_log2(x); }
            s = s + r;
            i = i + 1;
        }
        k = k + 1;
    }
    bench_batch_stop(b, 1024000);
    bench_report(b);
    if (s != s) { println("nan"); }
    return 0;
}

fn main(): i64 {
    alloc_init();
    g_xs = alloc(4096 * 8);
    g_ys = alloc(4096 * 8);
    fill(g_xs, -20.0, 20.0);
    row("exp, x in [-20, 20)", 0);
    fill(g_xs, 0.001, 1000.0);
    row("ln, x in [0.001, 1000)", 1);
    fill(g_xs, -1.0, 1.0);
    row("exp_m1, x in [-1, 1)", 2);
    fill(g_xs, 0.5, 2.0);
    fill(g_ys, -10.0, 10.0);
    row("powf, x in [0.5, 2), y in [-10, 10)", 3);
    fill(g_xs, -10.0, 10.0);
    row("sin, x in [-10, 10)", 4);
    row("cos, x in [-10, 10)", 5);
    row("atan, x in [-10, 10)", 6);
    fill(g_xs, -0.5, 1.0);
    row("ln_1p, x in [-0.5, 1)", 7);
    fill(g_xs, -0.0009765625, 0.0009765625);
    row("ln_1p, x in [-1/1024, 1/1024)", 7);
    fill(g_xs, -10.0, 10.0);
    row("tan, x in [-10, 10)", 8);
    fill(g_xs, 0.001, 1000.0);
    row("log2, x in [0.001, 1000)", 9);
    return 0;
}

var rc = main();
sys_exit_group(rc);
