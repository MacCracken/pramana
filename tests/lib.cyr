# lib.cyr — the library's module list, in cyrius.cyml [lib] order, for test compiles.
#
# `cyrius test` never prepends [lib] (cyrius distlib alone reads it), so every test that exercises the library
# includes this file. Keep it in step with [lib] (impetus port-parity §4.4 and pravash found the same).

include "src/error.cyr"
include "src/constants.cyr"
include "src/crmath_data.cyr"
include "src/crmath.cyr"
include "src/crmath_ext.cyr"
include "src/crerf_data.cyr"
include "src/crerf.cyr"
include "src/mathx.cyr"
include "src/fmtf.cyr"
include "src/pool.cyr"
include "src/json.cyr"
include "src/debug.cyr"
include "src/rng.cyr"
include "src/combinatorics.cyr"
include "src/bridge.cyr"
include "src/special.cyr"
