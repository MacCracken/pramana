# combinatorics.bcyr — counting (M1 part e2): ns per call, 10^5 calls per row.
#
# The Rust twin (scripts/probes/rust/src/bin/m1_primitives.rs, its `comb` rows) calls 1.3.0's functions on the same
# arguments; each side prints every result's words. The record is docs/benchmarks-rust-v-cyrius.md.

include "tests/lib.cyr"

# which: 0 factorial(34), 1 permutations(30, 15), 2 combinations(60, 30), 3 combinations(130, 65) (an overflow error).
fn row(name: cstring, which): i64 {
    var x: PmnU128;
    var e = 0;
    var b = bench_new(name);
    bench_batch_start(b);
    for (var i = 0; i < 100000; i = i + 1) {
        if (which == 0) { e = pmn_factorial(34, &x); }
        if (which == 1) { e = pmn_permutations(30, 15, &x); }
        if (which == 2) { e = pmn_combinations(60, 30, &x); }
        if (which == 3) { e = pmn_combinations(130, 65, &x); }
    }
    bench_batch_stop(b, 100000);
    print("  ", 2);
    print(name, strlen(name));
    print(": ", 2);
    if (e == PMN_ERR_NONE) {
        fmt_hex(x.hi);
        print(" ", 1);
        fmt_hex(x.lo);
    } else {
        print(pmn_err_name(e), strlen(pmn_err_name(e)));
    }
    println("");
    bench_report(b);
    return 0;
}

fn main(): i64 {
    alloc_init();
    row("factorial(34)", 0);
    row("permutations(30, 15)", 1);
    row("combinations(60, 30)", 2);
    row("combinations(130, 65), an overflow", 3);
    var s: f64 = 0.0;
    var b = bench_new("stirling_approx(100)");
    bench_batch_start(b);
    for (var j = 0; j < 100000; j = j + 1) {
        var y: f64 = pmn_stirling_approx(100);
        s = s + y;
    }
    bench_batch_stop(b, 100000);
    bench_report(b);
    if (s != s) { println("sink"); }
    return 0;
}

var rc = main();
sys_exit_group(rc);
