# descriptive.bcyr — src/descriptive.cyr (M4 part a1): ns per call, on 1.3.0's own criterion bodies
# (rust-old/benches/benchmarks.rs), whose numbers are rust-old/benchmarks.md's (2026-11-14, this host; ADR 010):
# - `descriptive/stats_10000`: mean, variance and std_dev of i·0.1 for i in 0..10⁴ (36,868 ns in Rust);
# - `descriptive/median_10001`: the median of `scrambled(10001)`, (i·7919 + 13) mod 10007 / 10007 (18,435 ns);
# - `descriptive/mode_10000`: the mode of ⌊500·scrambled(10⁴)⌋ (172,780 ns);
# - `descriptive/kde_gaussian_200pts_1000eval`: a Gaussian KDE of (i − 100)·0.05, i < 200, h = 0.5, at
#   (i − 500)·0.01 for i < 1000 (1,047.4 µs; part a2).
# Each row prints its result's bits, which the golden rows pin as Rust's. The record is
# docs/benchmarks-rust-v-cyrius.md.

include "tests/lib.cyr"

# Prints a row's result's bit pattern in hex, so a run can be checked against the model.
fn show(name, r: f64): i64 {
    var x: f64 = r;
    print("  ", 2);
    print(name, strlen(name));
    print(": ", 2);
    fmt_hex(load64(&x));
    println("");
    return 0;
}

# 1.3.0's `scrambled(n)`: deterministic data in [0, 1).
fn scrambled(p, n): i64 {
    for (var i = 0; i < n; i = i + 1) {
        var w: f64 = f64_from((i * 7919 + 13) % 10007);
        var r: f64 = w / 10007.0;
        store64(p + i * 8, r);
    }
    return 0;
}

# Runs the bench rows below, printing each one's timing and the result a run can be checked by.
fn main(): i64 {
    alloc_init();
    var a = alloc(10001 * 8);
    for (var i = 0; i < 10000; i = i + 1) {
        var x: f64 = f64_from(i);
        var y: f64 = x * 0.1;
        store64(a + i * 8, y);
    }
    var acc: f64 = 0.0;
    var reps = 2000;
    var b1 = bench_new("stats_10000 (mean, variance, std_dev)");
    bench_batch_start(b1);
    for (var r = 0; r < reps; r = r + 1) {
        var t1, v1 = pmn_mean(a, 10000);
        var t2, v2 = pmn_variance(a, 10000);
        var t3, v3 = pmn_std_dev(a, 10000);
        if (t1 == Err || t2 == Err || t3 == Err) { return 1; }
        var s3: f64 = v3;
        acc = acc + s3;
    }
    bench_batch_stop(b1, reps);
    show("std_dev(i·0.1, i < 10⁴)", acc);
    bench_report(b1);

    scrambled(a, 10001);
    var med: f64 = 0.0;
    var b2 = bench_new("median_10001");
    bench_batch_start(b2);
    for (var r2 = 0; r2 < reps; r2 = r2 + 1) {
        var tm, vm = pmn_median(a, 10001);
        if (tm == Err) { return 1; }
        var m: f64 = vm;
        med = m;
    }
    bench_batch_stop(b2, reps);
    show("median(scrambled(10001))", med);
    bench_report(b2);

    scrambled(a, 10000);
    for (var k = 0; k < 10000; k = k + 1) {
        var u: f64 = load64(a + k * 8);
        var u5: f64 = u * 500.0;
        var fl: f64 = f64_floor(u5);
        store64(a + k * 8, fl);
    }
    var mo: f64 = 0.0;
    var b3 = bench_new("mode_10000");
    bench_batch_start(b3);
    for (var r3 = 0; r3 < 500; r3 = r3 + 1) {
        var to, vo = pmn_mode(a, 10000);
        if (to == Err) { return 1; }
        var mv: f64 = vo;
        mo = mv;
    }
    bench_batch_stop(b3, 500);
    show("mode(⌊500·scrambled(10⁴)⌋)", mo);
    bench_report(b3);

    for (var d = 0; d < 200; d = d + 1) {
        var df: f64 = f64_from(d - 100);
        var dv: f64 = df * 0.05;
        store64(a + d * 8, dv);
    }
    var kd: PmnKernelDensity;
    if (PmnKernelDensity_new(&kd, a, 200, 0.5, PMN_KERNEL_GAUSSIAN) != PMN_ERR_NONE) { return 1; }
    var ks: f64 = 0.0;
    var b4 = bench_new("kde_gaussian_200pts_1000eval");
    bench_batch_start(b4);
    for (var r4 = 0; r4 < 20; r4 = r4 + 1) {
        for (var q = 0; q < 1000; q = q + 1) {
            var qf: f64 = f64_from(q - 500);
            var x: f64 = qf * 0.01;
            var dens: f64 = kd.evaluate(x);
            ks = ks + dens;
        }
    }
    bench_batch_stop(b4, 20);
    show("Σ densities over the 20 runs", ks);
    bench_report(b4);
    PmnKernelDensity_drop(&kd);
    return 0;
}

var rc = main();
sys_exit_group(rc);
