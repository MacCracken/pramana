# bayesian.tcyr — src/bayesian.cyr (M5 part c).
#
# tests/parity.tcyr replays 1.3.0's values (tests/golden/bayesian.tsv, json.tsv, debug.tsv). These carry 1.3.0's own
# tests over (bayesian.rs) and pin the buffer refusals.

include "tests/lib.cyr"

fn put(buf, k, x: f64): i64 {
    store64(buf + k * 8, x);
    return 0;
}

fn main() {
    alloc_init();
    test_group("1.3.0's tests (the theorem, the update, zero evidence, naive Bayes, serde, coherence, validation)");
    var t, v = pmn_bayes_theorem(0.01, 0.9, 0.1);
    var r: f64 = v;
    var d: f64 = r - 0.09;
    assert(t != Err && f64_abs(d) < 0.0000000001, "P(A|B) = 0.9·0.01/0.1 = 0.09");
    var u: PmnBayesianUpdate;
    assert_eq(PmnBayesianUpdate_new(&u, 0.5, 0.8, 0.6), PMN_ERR_NONE, "an update");
    var post: f64 = u.posterior();
    var ex: f64 = 0.8 * 0.5;
    var ex2: f64 = ex / 0.6;
    assert(post == ex2, "its posterior, as written");
    t, v = pmn_bayes_theorem(0.5, 0.5, 0.0);
    assert(t == Err && v == PMN_ERR_INVALID_PARAMETER, "zero evidence");
    var feats[16];
    put(&feats, 0, 1.0);
    put(&feats, 1, 0.5);
    var pri[16];
    put(&pri, 0, 0.5);
    put(&pri, 1, 0.5);
    var l0[16];
    var l1[16];
    put(&l0, 0, 0.9);
    put(&l0, 1, 0.8);
    put(&l1, 0, 0.1);
    put(&l1, 1, 0.2);
    var rows[32];
    store64(&rows, &l0);
    store64(&rows + 8, 2);
    store64(&rows + 16, &l1);
    store64(&rows + 24, 2);
    t, v = pmn_naive_bayes_classify(&feats, 2, &pri, 2, &rows, 2);
    assert(t != Err && v == 0, "class 0");
    t, v = pmn_naive_bayes_classify(&feats, 2, &pri, 0, &rows, 0);
    assert(t == Err && v == PMN_ERR_INVALID_SAMPLE, "no classes");
    t, v = pmn_naive_bayes_classify(&feats, 2, &pri, 2, &rows, 1);
    assert(t == Err && v == PMN_ERR_DIMENSION_MISMATCH, "2 priors, 1 row");
    t, v = pmn_naive_bayes_classify(&feats, 1, &pri, 2, &rows, 2);
    assert(t == Err && v == PMN_ERR_DIMENSION_MISMATCH, "rows of 2 for 1 feature");
    assert_eq(PmnBayesianUpdate_new(&u, 0.3, 0.7, 0.4), PMN_ERR_NONE, "0.3, 0.7, 0.4");
    var sb = str_builder_new();
    assert_eq(u.to_json(sb), PMN_ERR_NONE, "to_json");
    var u2: PmnBayesianUpdate;
    assert_eq(PmnBayesianUpdate_from_json(&u2, load64(sb), load64(sb + 8)), PMN_ERR_NONE, "from_json");
    var p1: f64 = u.prior;
    var p2: f64 = u2.prior;
    var e1: f64 = u.evidence;
    var e2: f64 = u2.evidence;
    assert(p1 == p2 && e1 == e2, "round trip");
    assert_eq(PmnBayesianUpdate_new(&u, 0.5, 0.9, 0.2), PMN_ERR_INVALID_PARAMETER, "0.45 > 0.2: incoherent");
    assert_eq(PmnBayesianUpdate_new(&u, 0.5, 0.4, 0.2), PMN_ERR_NONE, "posterior exactly 1 is allowed");
    var one: f64 = u.posterior();
    var od: f64 = one - 1.0;
    assert(f64_abs(od) < 0.000000000000001, "posterior 1");
    var bad1 = "{\"prior\":0.5,\"likelihood\":0.5,\"evidence\":0.0}";
    var bad2 = "{\"prior\":1.5,\"likelihood\":0.5,\"evidence\":0.9}";
    var good = "{\"prior\":0.3,\"likelihood\":0.8,\"evidence\":0.5}";
    assert_eq(PmnBayesianUpdate_from_json(&u2, bad1, strlen(bad1)), PMN_ERR_DESERIALIZE, "zero evidence refused");
    assert_eq(PmnBayesianUpdate_from_json(&u2, bad2, strlen(bad2)), PMN_ERR_DESERIALIZE, "prior 1.5 refused");
    assert_eq(PmnBayesianUpdate_from_json(&u2, good, strlen(good)), PMN_ERR_NONE, "a valid document read");
    assert_eq(PmnBayesianUpdate_new(0, 0.5, 0.5, 0.5), PMN_ERR_INVALID_PARAMETER, "a null out");
    return assert_summary();
}

var exit_code = main();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
