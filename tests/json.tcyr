# json.tcyr — the JSON core (M1 parts d3a, d3b and d4; port plan D5, §8.3 and §8.5).
#
# tests/parity.tcyr replays serde_json's own verdicts and text on every reader and writer (tests/golden/json.tsv).
# These tests name what the core does on its own: the pre-pass's rewrites, the document's claims on every path, the
# arena's growth past its first claim, the readers' and writers' caller-error codes, the error codec's refusals, round
# trips of seeded values, and soaks that leave the heap where they found it.

include "tests/lib.cyr"

var g_buf = 0;
var g_doc = 0;

# Copies the C string s into g_buf; its length.
fn text(s: cstring): i64 {
    var n = strlen(s);
    memcpy(g_buf, s, n);
    return n;
}

# 1 when the pre-pass turns `src` into `want`.
fn lifts_to(src: cstring, want: cstring): i64 {
    var n = text(src);
    var out[128];
    var m = _pmn_json_lift(g_buf, n, &out, 128);
    if (m != strlen(want)) { return 0; }
    if (memeq(&out, want, m) != 1) { return 0; }
    return 1;
}

# Opens the C string s as g_doc; the error code.
fn open(s: cstring): i64 {
    _pmn_json_close(g_doc);
    var n = text(s);
    return _pmn_json_open(g_doc, g_buf, n);
}

var g_rng = 0x9E3779B97F4A7C15;

fn next(): i64 {
    var x = g_rng;
    x = x ^ (x >> 12);
    x = x ^ (x << 25);
    x = x ^ (x >> 27);
    g_rng = x;
    return x * 0x2545F4914F6CDD1D;
}

# A finite double from seeded bits.
fn finite(): i64 {
    var b = next();
    while (((b >> 52) & 0x7FF) == 0x7FF) { b = next(); }
    return b;
}

# 1 when the builder holds exactly the C string want; it is then cleared.
fn wrote(sb, want: cstring): i64 {
    var n = strlen(want);
    var ok = 0;
    if (load64(sb + 8) == n && memeq(load64(sb), want, n) == 1) { ok = 1; }
    store64(sb + 8, 0);
    return ok;
}

# Opens the builder's text as g_doc (the text is copied to g_buf first); the error code.
fn reopen(sb): i64 {
    _pmn_json_close(g_doc);
    var n = load64(sb + 8);
    memcpy(g_buf, load64(sb), n);
    store64(sb + 8, 0);
    return _pmn_json_open(g_doc, g_buf, n);
}

# A decoder for _pmn_json_decode: the sum of a Vec<f64> into ctx, or the reader's error.
fn dec_sum(root, ctx): i64 {
    var n = _pmn_json_arr_len(root);
    if (n < 0) { return PMN_ERR_DESERIALIZE; }
    var vals[64];
    if (n > 8) { return PMN_ERR_INVALID_SAMPLE; }
    var e = _pmn_json_vec_f64(root, &vals, 8);
    if (e != PMN_ERR_NONE) { return e; }
    var s: f64 = 0.0;
    for (var i = 0; i < n; i = i + 1) {
        var x: f64 = load64(&vals + i * 8);
        s = s + x;
    }
    store64(ctx, s);
    return PMN_ERR_NONE;
}

fn main() {
    alloc_init();
    g_buf = alloc(1048576);
    g_doc = alloc(_PMN_JSON_DOC_SIZE);
    memset(g_doc, 0, _PMN_JSON_DOC_SIZE);
    store64(g_doc + 16, 0 - 1);
    var w[8];
    var sv[16];

    test_group("the pre-pass rewrites numbers as serde_json reads them");
    assert(lifts_to("-0", "-0.0") == 1, "-0 becomes -0.0");
    assert(lifts_to("[-1,-25]", "[-1.0,-25.0]") == 1, "a negative integer becomes a float");
    assert(lifts_to("9223372036854775807", "9223372036854775807") == 1, "i64::MAX stays");
    assert(lifts_to("9223372036854775808", "-9223372036854775808") == 1, "2^63 becomes its bits as an i64");
    assert(lifts_to("18446744073709551615", "-1") == 1, "u64::MAX becomes -1");
    assert(lifts_to("18446744073709551616", "18446744073709551616.0") == 1, "2^64 becomes a float");
    assert(lifts_to("[1.5,-2e3,01,-]", "[1.5,-2e3,01,-]") == 1, "a float, and what isn't an integer, stay");
    assert(lifts_to("{\"-1\":\"a\\\"-1\"}", "{\"-1\":\"a\\\"-1\"}") == 1, "nothing inside a string changes");
    var ctl = text("\"ab\"");
    store8(g_buf + 2, 1);
    var o1[40];
    assert_eq(_pmn_json_lift(g_buf, ctl, &o1, 2 * ctl + 32), 0 - 1, "a raw control byte in a string refuses");
    var big = text("[1,2,3,4,5,6,7,8,9]");
    assert_eq(_pmn_json_lift(g_buf, big, &o1, 16), 0 - 2, "a destination too small is -2, not an overrun");

    test_group("a document: its claims on every path");
    assert_eq(open("[1, 2]"), PMN_ERR_NONE, "[1, 2] opens");
    assert_eq(_pmn_json_arr_len(_pmn_json_root(g_doc)), 2, "its root is a two-element array");
    assert_eq(_pmn_scratch_claimed(), 1, "an open document holds one claim, its arena");
    _pmn_json_close(g_doc);
    assert_eq(_pmn_scratch_claimed(), 0, "closing releases it");
    _pmn_json_close(g_doc);
    assert_eq(_pmn_scratch_claimed(), 0, "closing twice is harmless");
    assert_eq(open("[1, 2"), PMN_ERR_DESERIALIZE, "a syntax fault refuses");
    assert_eq(_pmn_scratch_claimed(), 0, "and holds nothing");
    var cn = text("\"a b\"");
    store8(g_buf + 2, 10);
    assert_eq(_pmn_json_open(g_doc, g_buf, cn), PMN_ERR_DESERIALIZE, "a raw newline in a string refuses");
    assert_eq(_pmn_scratch_claimed(), 0, "and holds nothing");
    assert_eq(_pmn_json_open(g_doc, g_buf, 0), PMN_ERR_DESERIALIZE, "an empty document refuses");
    assert_eq(_pmn_json_open(g_doc, 0, 5), PMN_ERR_INVALID_PARAMETER, "a null text is the caller's error");
    assert_eq(_pmn_json_open(0, g_buf, 5), PMN_ERR_INVALID_PARAMETER, "so is a null document");
    assert_eq(_pmn_json_open(g_doc, g_buf, 2 * VEC_CAP_MAX), PMN_ERR_OUT_OF_MEMORY,
        "a document long enough to overflow bayan's arrays is refused unread (ledger L13)");
    assert_eq(_pmn_scratch_claimed(), 0, "nothing claimed by any refusal");

    test_group("the size guard keeps bayan's arrays under VEC_CAP_MAX (ledger L13)");
    # vec_push_a ends the process ("vec: capacity overflow") one element past VEC_CAP_MAX, and bayan pushes every array
    # element through it. Lowered to 64, the guard must refuse a document that could hold 65 elements, unread.
    var cap_saved = VEC_CAP_MAX;
    VEC_CAP_MAX = 64;
    var zn = 0;
    store8(g_buf, 91);
    zn = 1;
    for (var z = 0; z < 65; z = z + 1) {
        if (z > 0) {
            store8(g_buf + zn, 44);
            zn = zn + 1;
        }
        store8(g_buf + zn, 48);
        zn = zn + 1;
    }
    store8(g_buf + zn, 93);
    zn = zn + 1;
    assert_eq(_pmn_json_open(g_doc, g_buf, zn), PMN_ERR_OUT_OF_MEMORY, "65 elements: refused, not aborted");
    store8(g_buf + 126, 93);
    assert_eq(_pmn_json_open(g_doc, g_buf, 127), PMN_ERR_NONE, "127 bytes, 63 elements: read");
    assert_eq(_pmn_json_arr_len(_pmn_json_root(g_doc)), 63, "all 63");
    _pmn_json_close(g_doc);
    VEC_CAP_MAX = cap_saved;

    test_group("the arena doubles past its first claim");
    var n = 0;
    store8(g_buf, 91);
    n = 1;
    for (var k = 0; k < 20000; k = k + 1) {
        if (k > 0) {
            store8(g_buf + n, 44);
            n = n + 1;
        }
        store8(g_buf + n, 91);
        store8(g_buf + n + 1, 93);
        n = n + 2;
    }
    store8(g_buf + n, 93);
    n = n + 1;
    assert_eq(_pmn_json_open(g_doc, g_buf, n), PMN_ERR_NONE, "20,000 empty arrays: 64 times the text, past 24");
    assert_eq(_pmn_json_arr_len(_pmn_json_root(g_doc)), 20000, "all 20,000 read");
    assert_eq(_pmn_scratch_claimed(), 0, "a claim over 1 MiB holds no slot");
    _pmn_json_close(g_doc);

    test_group("f64: any number, refusing one past its range");
    assert_eq(open("1.5"), PMN_ERR_NONE, "1.5 opens");
    assert_eq(_pmn_json_f64(_pmn_json_root(g_doc), &w), PMN_ERR_NONE, "1.5 reads");
    assert_eq(load64(&w), 0x3FF8000000000000, "as 1.5");
    open("-0");
    assert_eq(_pmn_json_f64(_pmn_json_root(g_doc), &w), PMN_ERR_NONE, "-0 reads");
    assert_eq(load64(&w), 0x8000000000000000, "as -0.0, as serde_json reads it");
    open("18446744073709551615");
    assert_eq(_pmn_json_f64(_pmn_json_root(g_doc), &w), PMN_ERR_NONE, "u64::MAX reads");
    assert_eq(load64(&w), 0x43F0000000000000, "rounded to 2^64, unsigned");
    open("1e400");
    assert_eq(_pmn_json_f64(_pmn_json_root(g_doc), &w), PMN_ERR_DESERIALIZE, "1e400 is out of range");
    open("null");
    assert_eq(_pmn_json_f64(_pmn_json_root(g_doc), &w), PMN_ERR_DESERIALIZE, "null is no f64");
    open("\"1\"");
    assert_eq(_pmn_json_f64(_pmn_json_root(g_doc), &w), PMN_ERR_DESERIALIZE, "nor is a string");
    assert_eq(_pmn_json_f64(_pmn_json_root(g_doc), 0), PMN_ERR_INVALID_PARAMETER, "a null out is the caller's");
    assert_eq(_pmn_json_f64(0, &w), PMN_ERR_DESERIALIZE, "a missing node refuses");

    test_group("u64: an integer from 0 to 2^64 - 1");
    open("18446744073709551615");
    assert_eq(_pmn_json_u64(_pmn_json_root(g_doc), &w), PMN_ERR_NONE, "u64::MAX reads");
    assert_eq(load64(&w), 0 - 1, "as all ones");
    open("-1");
    assert_eq(_pmn_json_u64(_pmn_json_root(g_doc), &w), PMN_ERR_DESERIALIZE, "-1 refuses");
    open("-0");
    assert_eq(_pmn_json_u64(_pmn_json_root(g_doc), &w), PMN_ERR_DESERIALIZE, "-0 refuses, a float to serde_json");
    open("1.0");
    assert_eq(_pmn_json_u64(_pmn_json_root(g_doc), &w), PMN_ERR_DESERIALIZE, "1.0 refuses");
    open("18446744073709551616");
    assert_eq(_pmn_json_u64(_pmn_json_root(g_doc), &w), PMN_ERR_DESERIALIZE, "2^64 refuses");

    test_group("bool and String");
    open("true");
    assert(_pmn_json_bool(_pmn_json_root(g_doc), &w) == PMN_ERR_NONE && load64(&w) == 1, "true is 1");
    open("1");
    assert_eq(_pmn_json_bool(_pmn_json_root(g_doc), &w), PMN_ERR_DESERIALIZE, "1 is no bool");
    open("\"\\u00e9\\u0000\"");
    assert_eq(_pmn_json_str(_pmn_json_root(g_doc), &sv), PMN_ERR_NONE, "escapes decode");
    var sp = load64(&sv);
    assert(load64(&sv + 8) == 3 && load8(sp) == 0xC3 && load8(sp + 1) == 0xA9 && load8(sp + 2) == 0,
        "to UTF-8, a NUL kept");
    var bn = text("\"a?b\"");
    store8(g_buf + 2, 0xFF);
    _pmn_json_close(g_doc);
    _pmn_json_open(g_doc, g_buf, bn);
    assert_eq(_pmn_json_str(_pmn_json_root(g_doc), &sv), PMN_ERR_DESERIALIZE, "invalid UTF-8 refuses when read");
    var on = text("\"??\"");
    store8(g_buf + 1, 0xC0);
    store8(g_buf + 2, 0xAF);
    _pmn_json_close(g_doc);
    _pmn_json_open(g_doc, g_buf, on);
    assert_eq(_pmn_json_str(_pmn_json_root(g_doc), &sv), PMN_ERR_DESERIALIZE, "so does an overlong form");

    test_group("vectors and matrices");
    var vb[64];
    open("[1, -0, 2.5]");
    assert_eq(_pmn_json_vec_f64(_pmn_json_root(g_doc), &vb, 8), PMN_ERR_NONE, "a Vec<f64> reads");
    assert(load64(&vb + 8) == 0x8000000000000000 && load64(&vb + 16) == 0x4004000000000000, "-0 and 2.5");
    assert_eq(_pmn_json_vec_f64(_pmn_json_root(g_doc), &vb, 2), PMN_ERR_INVALID_PARAMETER, "a short buffer refuses");
    open("[1, \"x\"]");
    assert_eq(_pmn_json_vec_f64(_pmn_json_root(g_doc), &vb, 8), PMN_ERR_DESERIALIZE, "a string element refuses");
    open("[3, 18446744073709551615]");
    assert_eq(_pmn_json_vec_u64(_pmn_json_root(g_doc), &vb, 8), PMN_ERR_NONE, "a Vec<u64> reads");
    assert(load64(&vb) == 3 && load64(&vb + 8) == 0 - 1, "3 and u64::MAX");
    var sh[24];
    open("[[1, 2], [3]]");
    assert_eq(_pmn_json_mat_shape(_pmn_json_root(g_doc), &sh), PMN_ERR_NONE, "a ragged matrix reads");
    assert(load64(&sh) == 2 && load64(&sh + 8) == 2 && load64(&sh + 16) == 1, "2 rows, 2 columns first, ragged");
    assert_eq(_pmn_json_mat_f64(_pmn_json_root(g_doc), &vb, 2, 2), PMN_ERR_INVALID_PARAMETER,
        "filling it as 2 x 2 refuses");
    open("[[1, 2], [3, 4]]");
    assert_eq(_pmn_json_mat_shape(_pmn_json_root(g_doc), &sh), PMN_ERR_NONE, "a square one reads");
    assert(load64(&sh + 16) == 0, "and is not ragged");
    assert_eq(_pmn_json_mat_f64(_pmn_json_root(g_doc), &vb, 2, 2), PMN_ERR_NONE, "and fills");
    assert(load64(&vb + 16) == 0x4008000000000000, "row-major: element (1, 0) is 3");
    open("[[1, null]]");
    assert_eq(_pmn_json_mat_shape(_pmn_json_root(g_doc), &sh), PMN_ERR_DESERIALIZE, "a null element refuses");
    _pmn_json_close(g_doc);

    test_group("serde's struct rules");
    var nm[16];
    store64(&nm, "mean");
    store64(&nm + 8, "std_dev");
    var sl[16];
    open("{\"std_dev\": 2, \"zz\": [1, {\"a\": null}], \"mean\": 1}");
    assert_eq(_pmn_json_struct(_pmn_json_root(g_doc), &nm, 2, &sl), PMN_ERR_NONE,
        "the map form, in any order, with an unknown member skipped");
    assert(_pmn_json_f64(load64(&sl), &w) == PMN_ERR_NONE && load64(&w) == 0x3FF0000000000000, "mean = 1");
    assert(_pmn_json_f64(load64(&sl + 8), &w) == PMN_ERR_NONE && load64(&w) == 0x4000000000000000, "std_dev = 2");
    open("[1, 2]");
    assert_eq(_pmn_json_struct(_pmn_json_root(g_doc), &nm, 2, &sl), PMN_ERR_NONE, "the sequence form");
    assert(_pmn_json_f64(load64(&sl + 8), &w) == PMN_ERR_NONE && load64(&w) == 0x4000000000000000, "in field order");
    open("[1]");
    assert_eq(_pmn_json_struct(_pmn_json_root(g_doc), &nm, 2, &sl), PMN_ERR_DESERIALIZE, "a short sequence refuses");
    open("[1, 2, 3]");
    assert_eq(_pmn_json_struct(_pmn_json_root(g_doc), &nm, 2, &sl), PMN_ERR_DESERIALIZE, "so does a long one");
    open("{\"mean\": 1}");
    assert_eq(_pmn_json_struct(_pmn_json_root(g_doc), &nm, 2, &sl), PMN_ERR_DESERIALIZE, "a missing field refuses");
    assert_eq(load64(&sl + 8), 0, "and its slot is empty");
    open("{\"me\\u0061n\": 1, \"std_dev\": 2}");
    assert_eq(_pmn_json_struct(_pmn_json_root(g_doc), &nm, 2, &sl), PMN_ERR_NONE, "a key matches once decoded");
    assert_eq(open("{\"mean\": 1, \"mean\": 1, \"std_dev\": 2}"), PMN_ERR_DESERIALIZE,
        "a field named twice refuses: bayan refuses the duplicate key first");
    var kn = text("{\"z?\": 1, \"mean\": 1, \"std_dev\": 2}");
    store8(g_buf + 3, 0xFF);
    _pmn_json_close(g_doc);
    assert_eq(_pmn_json_open(g_doc, g_buf, kn), PMN_ERR_NONE, "bayan reads a key that is not UTF-8");
    assert_eq(_pmn_json_struct(_pmn_json_root(g_doc), &nm, 2, &sl), PMN_ERR_DESERIALIZE,
        "the struct refuses it, unknown or not, as serde_json parses every key");
    open("1");
    assert_eq(_pmn_json_struct(_pmn_json_root(g_doc), &nm, 2, &sl), PMN_ERR_DESERIALIZE, "a number is no struct");
    assert_eq(_pmn_json_struct(_pmn_json_root(g_doc), 0, 2, &sl), PMN_ERR_INVALID_PARAMETER,
        "null names: the caller's");
    assert_eq(_pmn_json_struct(_pmn_json_root(g_doc), &nm, 0, &sl), PMN_ERR_INVALID_PARAMETER, "so are no fields");

    test_group("enums: a unit variant and a newtype variant");
    var kv[32];
    store64(&kv, "Gaussian");
    store64(&kv + 8, "Epanechnikov");
    store64(&kv + 16, "Uniform");
    store64(&kv + 24, "Triangular");
    open("\"Uniform\"");
    assert(_pmn_json_unit_variant(_pmn_json_root(g_doc), &kv, 4, &w) == PMN_ERR_NONE && load64(&w) == 2,
        "\"Uniform\" is variant 2");
    open("{\"Triangular\": null}");
    assert(_pmn_json_unit_variant(_pmn_json_root(g_doc), &kv, 4, &w) == PMN_ERR_NONE && load64(&w) == 3,
        "{\"Triangular\": null} is variant 3");
    open("\"uniform\"");
    assert_eq(_pmn_json_unit_variant(_pmn_json_root(g_doc), &kv, 4, &w), PMN_ERR_DESERIALIZE, "names are exact");
    open("{\"Uniform\": 0}");
    assert_eq(_pmn_json_unit_variant(_pmn_json_root(g_doc), &kv, 4, &w), PMN_ERR_DESERIALIZE, "a unit holds null");
    open("{\"Uniform\": null, \"Gaussian\": null}");
    assert_eq(_pmn_json_unit_variant(_pmn_json_root(g_doc), &kv, 4, &w), PMN_ERR_DESERIALIZE, "one member only");
    open("2");
    assert_eq(_pmn_json_unit_variant(_pmn_json_root(g_doc), &kv, 4, &w), PMN_ERR_DESERIALIZE, "no index form");
    var ev[16];
    store64(&ev, "InvalidParameter");
    store64(&ev + 8, "InvalidSample");
    open("{\"InvalidSample\": \"m\"}");
    assert_eq(_pmn_json_newtype_variant(_pmn_json_root(g_doc), &ev, 2, &sv), PMN_ERR_NONE, "a newtype variant");
    assert_eq(load64(&sv), 1, "is variant 1");
    var pw[16];
    assert(_pmn_json_str(load64(&sv + 8), &pw) == PMN_ERR_NONE && load64(&pw + 8) == 1, "its value is the node");
    open("\"InvalidSample\"");
    assert_eq(_pmn_json_newtype_variant(_pmn_json_root(g_doc), &ev, 2, &sv), PMN_ERR_DESERIALIZE,
        "the bare name refuses: it is a unit variant to serde");
    open("{\"Nope\": \"m\"}");
    assert_eq(_pmn_json_newtype_variant(_pmn_json_root(g_doc), &ev, 2, &sv), PMN_ERR_DESERIALIZE, "unknown refuses");
    _pmn_json_close(g_doc);

    test_group("the writers: serde_json's compact text");
    var sb = str_builder_new();
    var x15: f64 = 1.5;
    var nanv: f64 = 0x7FF8000000000000;
    var nz: f64 = -0.0;
    assert(_pmn_json_w_f64(sb, x15) == PMN_ERR_NONE && wrote(sb, "1.5") == 1, "1.5");
    assert(_pmn_json_w_f64(sb, nanv) == PMN_ERR_NONE && wrote(sb, "null") == 1, "NaN is null");
    assert(_pmn_json_w_f64(sb, nz) == PMN_ERR_NONE && wrote(sb, "-0.0") == 1, "-0.0");
    assert(_pmn_json_w_u64(sb, 0) == PMN_ERR_NONE && wrote(sb, "0") == 1, "u64 0");
    assert(_pmn_json_w_u64(sb, 0 - 1) == PMN_ERR_NONE && wrote(sb, "18446744073709551615") == 1, "u64::MAX");
    assert(_pmn_json_w_bool(sb, 1) == PMN_ERR_NONE && wrote(sb, "true") == 1, "true");
    var wsn = text("a\"b\\c\n??é/");
    store8(g_buf + 6, 1);
    store8(g_buf + 7, 0x7F);
    assert(_pmn_json_w_str(sb, g_buf, wsn) == PMN_ERR_NONE, "a string writes");
    var want[64];
    var wn = strlen("\"a\\\"b\\\\c\\n\\u0001?é/\"");
    memcpy(&want, "\"a\\\"b\\\\c\\n\\u0001?é/\"", wn);
    store8(&want + 16, 0x7F);
    assert(load64(sb + 8) == wn && memeq(load64(sb), &want, wn) == 1,
        "quote, backslash and newline escaped, 0x01 as \\u0001, DEL, é and / as they are");
    store64(sb + 8, 0);
    var vv[24];
    store64(&vv, 0x3FF8000000000000);
    store64(&vv + 8, 0x7FF0000000000000);
    store64(&vv + 16, 0x8000000000000000);
    assert(_pmn_json_w_vec_f64(sb, &vv, 3) == PMN_ERR_NONE && wrote(sb, "[1.5,null,-0.0]") == 1, "a Vec<f64>");
    assert(_pmn_json_w_vec_f64(sb, 0, 0) == PMN_ERR_NONE && wrote(sb, "[]") == 1, "an empty one");
    store64(&vv, 7);
    store64(&vv + 8, 0 - 1);
    assert(_pmn_json_w_vec_u64(sb, &vv, 2) == PMN_ERR_NONE && wrote(sb, "[7,18446744073709551615]") == 1,
        "a Vec<u64>");
    var mv[32];
    store64(&mv, 0x3FF0000000000000);
    store64(&mv + 8, 0x4000000000000000);
    store64(&mv + 16, 0x4008000000000000);
    store64(&mv + 24, 0x4010000000000000);
    assert(_pmn_json_w_mat_f64(sb, &mv, 2, 2) == PMN_ERR_NONE && wrote(sb, "[[1.0,2.0],[3.0,4.0]]") == 1,
        "a 2 x 2 matrix, row-major");
    assert(_pmn_json_w_mat_f64(sb, 0, 0, 3) == PMN_ERR_NONE && wrote(sb, "[]") == 1, "no rows is []");
    assert(_pmn_json_w_mat_f64(sb, &mv, 1, 0) == PMN_ERR_NONE && wrote(sb, "[[]]") == 1, "one empty row is [[]]");
    var m05: f64 = 0.5;
    var s225: f64 = 2.25;
    var es = _pmn_json_w_key(sb, "mean", 1);
    es = es | _pmn_json_w_f64(sb, m05);
    es = es | _pmn_json_w_key(sb, "std_dev", 0);
    es = es | _pmn_json_w_f64(sb, s225);
    es = es | _pmn_json_w_lit(sb, "}");
    assert(es == PMN_ERR_NONE && wrote(sb, "{\"mean\":0.5,\"std_dev\":2.25}") == 1, "a struct, in field order");
    assert(_pmn_json_w_unit_variant(sb, "Gaussian") == PMN_ERR_NONE && wrote(sb, "\"Gaussian\"") == 1,
        "a unit variant");
    assert_eq(_pmn_json_w_f64(0, x15), PMN_ERR_INVALID_PARAMETER, "a null builder is the caller's error");
    assert_eq(_pmn_json_w_reserve(sb, 4611686018427387904), PMN_ERR_OUT_OF_MEMORY,
        "room that can't be had is OUT_OF_MEMORY, not an abort (ledger L14)");

    test_group("the error codec (ADR 007 row 8)");
    assert(pmn_err_to_json(PMN_ERR_INVALID_SAMPLE, sb) == PMN_ERR_NONE && wrote(sb, "{\"InvalidSample\":\"\"}") == 1,
        "a code is its variant with an empty message");
    var trips = 0;
    for (var c = PMN_ERR_INVALID_PARAMETER; c <= PMN_ERR_COMPUTATION_ERROR; c = c + 1) {
        if (pmn_err_to_json(c, sb) == PMN_ERR_NONE) {
            var et, ev = pmn_err_from_json(load64(sb), load64(sb + 8));
            if (is_err_result(et) == 0 && ev == c) { trips = trips + 1; }
        }
        store64(sb + 8, 0);
    }
    assert_eq(trips, 5, "all five round-trip to their code");
    assert(pmn_err_to_json(PMN_ERR_OUT_OF_MEMORY, sb) == PMN_ERR_INVALID_PARAMETER && load64(sb + 8) == 0,
        "OUT_OF_MEMORY has no 1.3.0 variant: refused, nothing written");
    assert(pmn_err_to_json(PMN_ERR_DESERIALIZE, sb) == PMN_ERR_INVALID_PARAMETER && load64(sb + 8) == 0,
        "nor DESERIALIZE");
    assert(pmn_err_to_json(PMN_ERR_NONE, sb) == PMN_ERR_INVALID_PARAMETER && load64(sb + 8) == 0, "nor NONE");
    assert_eq(pmn_err_to_json(99, sb), PMN_ERR_INVALID_PARAMETER, "nor a value that is no code");
    var dn = text("{\"DimensionMismatch\": \"rows differ\"}");
    var dt, dv = pmn_err_from_json(g_buf, dn);
    assert(is_err_result(dt) == 0 && dv == PMN_ERR_DIMENSION_MISMATCH, "1.3.0's document reads to its code");
    var un = text("\"InvalidParameter\"");
    var ut, uv = pmn_err_from_json(g_buf, un);
    assert(is_err_result(ut) == 1 && uv == PMN_ERR_DESERIALIZE, "the bare name refuses");
    var bn2 = text("{\"InvalidParameter\": \"a?\"}");
    store8(g_buf + 22, 0xFF);
    var bt, bv = pmn_err_from_json(g_buf, bn2);
    assert(is_err_result(bt) == 1 && bv == PMN_ERR_DESERIALIZE, "a message that is not UTF-8 refuses, dropped or not");
    assert_eq(_pmn_scratch_claimed(), 0, "nothing claimed");

    test_group("round trips: what pramana writes, it reads back to the same bits");
    var fbad = 0;
    for (var r = 0; r < 2000; r = r + 1) {
        var fb = finite();
        var fx: f64 = fb;
        var fw = _pmn_json_w_f64(sb, fx);
        var fo = reopen(sb);
        var got[8];
        if (fw != PMN_ERR_NONE || fo != PMN_ERR_NONE || _pmn_json_f64(_pmn_json_root(g_doc), &got) != PMN_ERR_NONE) {
            fbad = fbad + 1;
        } elif (load64(&got) != fb) {
            fbad = fbad + 1;
        }
    }
    assert_eq(fbad, 0, "2,000 seeded finite f64s");
    var ubad = 0;
    for (var r2 = 0; r2 < 2000; r2 = r2 + 1) {
        var uw = next() >> (r2 % 64);
        var uo = _pmn_json_w_u64(sb, uw) | reopen(sb);
        var ug[8];
        if (uo != PMN_ERR_NONE || _pmn_json_u64(_pmn_json_root(g_doc), &ug) != PMN_ERR_NONE || load64(&ug) != uw) {
            ubad = ubad + 1;
        }
    }
    assert_eq(ubad, 0, "2,000 seeded u64s");
    var sbad = 0;
    var src[64];
    for (var r3 = 0; r3 < 2000; r3 = r3 + 1) {
        var len = next() & 31;
        for (var j = 0; j < len; j = j + 1) { store8(&src + j, next() & 0x7F); }
        var so = _pmn_json_w_str(sb, &src, len) | reopen(sb);
        var sg[16];
        if (so != PMN_ERR_NONE || _pmn_json_str(_pmn_json_root(g_doc), &sg) != PMN_ERR_NONE) {
            sbad = sbad + 1;
        } elif (load64(&sg + 8) != len || memeq(load64(&sg), &src, len) != 1) {
            sbad = sbad + 1;
        }
    }
    assert_eq(sbad, 0, "2,000 seeded ASCII strings, every control byte among them");
    var mbad = 0;
    var mm[200];
    var mo[200];
    for (var r4 = 0; r4 < 300; r4 = r4 + 1) {
        var rows = next() & 3;
        var cols = next() & 3;
        for (var q = 0; q < rows * cols; q = q + 1) { store64(&mm + q * 8, finite()); }
        var mw = _pmn_json_w_mat_f64(sb, &mm, rows, cols) | reopen(sb);
        var msh[24];
        if (mw != PMN_ERR_NONE || _pmn_json_mat_shape(_pmn_json_root(g_doc), &msh) != PMN_ERR_NONE) {
            mbad = mbad + 1;
        } elif (load64(&msh) != rows || (rows > 0 && load64(&msh + 8) != cols)) {
            mbad = mbad + 1;
        } elif (_pmn_json_mat_f64(_pmn_json_root(g_doc), &mo, rows, cols) != PMN_ERR_NONE) {
            mbad = mbad + 1;
        } elif (rows * cols > 0 && memeq(&mo, &mm, rows * cols * 8) != 1) {
            mbad = mbad + 1;
        }
    }
    assert_eq(mbad, 0, "300 seeded matrices up to 3 x 3, empty ones included");
    _pmn_json_close(g_doc);

    test_group("a write soak leaves the heap where it found it, once the builder holds the longest text");
    for (var w0 = 0; w0 < 10; w0 = w0 + 1) {
        if (_pmn_json_w_mat_f64(sb, &mm, 3, 3) != PMN_ERR_NONE) { println("write failed"); }
        store64(sb + 8, 0);
    }
    var wbefore = alloc_used();
    for (var w1 = 0; w1 < 10000; w1 = w1 + 1) {
        if (_pmn_json_w_mat_f64(sb, &mm, 3, 3) != PMN_ERR_NONE) { println("write failed"); }
        store64(sb + 8, 0);
    }
    assert_eq(alloc_used() - wbefore, 0, "10^4 writes into one cleared builder: 0 bytes of bump heap");

    test_group("decode closes on every path");
    var sum[8];
    var sn = text("[1.5, 2.5]");
    assert_eq(_pmn_json_decode(g_buf, sn, &dec_sum, &sum), PMN_ERR_NONE, "a decoder runs");
    assert_eq(load64(&sum), 0x4010000000000000, "1.5 + 2.5 = 4");
    var ln = text("[1,2,3,4,5,6,7,8,9]");
    assert_eq(_pmn_json_decode(g_buf, ln, &dec_sum, &sum), PMN_ERR_INVALID_SAMPLE, "its own error comes back");
    var fn2 = text("[1, true]");
    assert_eq(_pmn_json_decode(g_buf, fn2, &dec_sum, &sum), PMN_ERR_DESERIALIZE, "as does a reader's");
    var bad = text("[1,");
    assert_eq(_pmn_json_decode(g_buf, bad, &dec_sum, &sum), PMN_ERR_DESERIALIZE, "as does the parse's");
    assert_eq(_pmn_json_decode(g_buf, sn, 0, &sum), PMN_ERR_INVALID_PARAMETER, "a null decoder is the caller's");
    assert_eq(_pmn_scratch_claimed(), 0, "nothing claimed after any of them");

    test_group("a soak leaves the heap where it found it");
    var before = alloc_used();
    for (var i = 0; i < 10000; i = i + 1) {
        var t = text("[0.1, -0, 18446744073709551615, 1e-3]");
        if (i % 3 == 0) { t = text("[0.1, x]"); }
        _pmn_json_decode(g_buf, t, &dec_sum, &sum);
    }
    assert_eq(alloc_used() - before, 0, "10^4 decodes: 0 bytes of bump heap");
    assert_eq(_pmn_scratch_claimed(), 0, "and nothing left claimed");

    return assert_summary();
}

var exit_code = main();
# Any failure at all is exit 1: a wait status is 8 bits, so a raw count of 256 would read as success.
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
