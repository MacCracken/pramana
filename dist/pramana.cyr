# π/2 = P1 + P2 + P3 + P4 + P5 (Cody–Waite: P1 and P2 at 33 bits, so k·P1 and k·P2 are exact for
# |k| < 2^20; |P2| < 2^-32, |P3| < 2^-65, the rest below 2^-225), INVPIO2 = 2/π rounded; π =
# PIH + PIM + PIL and π/2 = PIO2H + PIO2M + PIO2L (triple-doubles); PIO4 and PI3O4 = π/4 and 3π/4
# rounded. S3 … S7 (−1/6, 1/120, −1/5040) and C4, C6 (1/24, −1/720): the fast sin and cos
# polynomials; A3 … A9 (−1/3, 1/5, −1/7, 1/9): the fast atan polynomial.
var _PMN_KM_CR_SC_P1 = 0x3FF921FB54400000;   # 1.5707963267341256

var _PMN_KM_CR_SC_P2 = 0x3DD0B4611A600000;   # 6.077100506303966e-11

var _PMN_KM_CR_SC_P3 = 0x3BA3198A2E037073;   # 2.0222662487959506e-21

var _PMN_KM_CR_SC_P4 = 0x384129024E088A68;   # 1.0085854035872483e-37

var _PMN_KM_CR_SC_P5 = 0xB4D9C5FEFA20ACE2;   # -4.2044856255549717e-54

var _PMN_KM_CR_SC_INVPIO2 = 0x3FE45F306DC9C883;   # 0.6366197723675814

var _PMN_KM_CR_SC_PIH = 0x400921FB54442D18;   # 3.141592653589793

