var _PMN_KM_CR_EXP_L4 = 0xB6579B31ACE93A4F;   # -6.460814311526024e-47

var _PMN_KM_CR_EXP_P3 = 0x3FC5555555555555;   # 0.16666666666666666

var _PMN_KM_CR_EXP_P4 = 0x3FA5555555555555;   # 0.041666666666666664

var _PMN_KM_CR_EXP_P5 = 0x3F81111111111111;   # 0.008333333333333333

# Q3 … Q9 = 1/3!, …, 1/9!: expm1's small-|x| fast path, x + x²/2 + x³·(Q3 + x·Q4 + … + x⁶·Q9).
var _PMN_KM_CR_EXPM1_Q3 = 0x3FC5555555555555;   # 0.16666666666666666

var _PMN_KM_CR_EXPM1_Q4 = 0x3FA5555555555555;   # 0.041666666666666664

