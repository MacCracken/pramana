# --- crerf.cyr ---

# crerf.cyr — erf and erfc, correctly rounded: CORE-MATH's binary64 algorithms ported without FMA (M2 part b1; port
# plan D3 = C, §3.4; ADR 009).
#
# CORE-MATH's src/binary64/erf/erf.c and erfc/erfc.c (Paul Zimmermann, MIT licence; the notice is in crerf_data.cyr,
# with every table, which scripts/vendor_coremath.py generates from the sources), transcribed function for function by
# probe P9 (§5 step 9e) and moved here unchanged but for names. Cyrius has no scalar FMA, so every
# __builtin_fma(a, b, c) is `_pmn_cm_fma`: a·b = p + e exactly by Dekker's product (Veltkamp's split), then
# RN(p + e + c) exactly by Boldo and Melquiond's round-to-odd sum (kimiya's, vendored in src/crmath.cyr). That is an
# exact fma for every operand these functions reach except one: erf's tiny path ends with fma(l, 2^-106, y), whose
# product can be subnormal, so `_pmn_cm_fma_tiny` rounds that sum once on the subnormal grid instead. a_mul's
# fma(a, b, −a·b) is the same Dekker product, and both TwoSum forms compute the exact error, so those helpers are
# kimiya's. Floating-point flags (fenv) and errno are not ported: Cyrius has neither, and Rust's erf sets neither.
#
# P9 verified the port against CORE-MATH's own build (hardware FMA) bit for bit, on all of its worst cases and
# 2.7 million more arguments, and against MPFR; scripts/crverify/ re-checks this copy (both functions and their
# accurate paths) on three targets. The hex words below are bit patterns of the C literals each line's comment cites,
# which `scripts/vendor_coremath.py --check` verifies against the sources.
#
# UPSTREAM(L8): ganita:docs/development/issues/2026-11-15-special-functions-scope-request.md
#   replace with ganita's correctly rounded erf and erfc if it takes them on; parity: every erf and erfc row
# UPSTREAM(L12): cyrius:docs/development/issues/2026-11-15-no-scalar-fma.md
#   `_pmn_cm_fma` is the exact fma; replace it with f64_fma (and keep `_pmn_cm_fma_tiny`'s subnormal rounding unless
#   f64_fma rounds a subnormal sum once); the bits must not change

# ── helpers ────────────────────────────────────────────────────────────────────────────────────────

# fma(a, b, c), exactly: RN(a·b + c) with one rounding.
#must_use
fn _pmn_cm_fma(a: f64, b: f64, c: f64): f64 {
    var p, e = _pmn_km_two_prod(a, b);
    var r: f64 = _pmn_km_rn3(p, e, c);
    return r;
}

# RN(y + l·2^-106) exactly, for erf's tiny path: Y = y·2^106, Y + l = sh + sl exactly; a normal result is sh·2^-106,
# a subnormal one N·2^-1074 with N = RN(2^52 + (sh + sl)·2^968) − 2^52 (the grid of [2^52, 2^53) is 1).
#must_use
fn _pmn_cm_fma_tiny(l: f64, y: f64): f64 {
    var s106: f64 = 0x4690000000000000;          # 0x1p106
    var ys: f64 = y * s106;
    var sh, sl = _pmn_km_two_sum(ys, l);
    var ash: f64 = f64_abs(sh);
    var lim: f64 = 0x06B0000000000000;           # 0x1p-916
    if (ash >= lim) {
        var d106: f64 = 0x3950000000000000;      # 0x1p-106
        var r: f64 = sh * d106;
        return r;
    }
    var m: f64 = 0x4330000000000000;             # 0x1p52
    if (sh < 0.0) { m = -m; }
    var up: f64 = 0x7C70000000000000;            # 0x1p968
    var a: f64 = sh * up;
    var b: f64 = sl * up;
    var z: f64 = _pmn_km_rn3(m, a, b);
    var n: f64 = z - m;
    var tiny: f64 = _pmn_cm_bits(1);                 # 0x1p-1074
    var r2: f64 = n * tiny;
    return r2;
}

# s_mul: a·(bh + bl) as a double-double.
#must_use
fn _pmn_cm_s_mul(a: f64, bh: f64, bl: f64): (f64, f64) {
    var h, l = _pmn_km_two_prod(a, bh);
    var l2: f64 = _pmn_cm_fma(a, bl, l);
    return (h, l2);
}

# d_mul: (ah + al)·(bh + bl) − al·bl.
#must_use
fn _pmn_cm_d_mul(ah: f64, al: f64, bh: f64, bl: f64): (f64, f64) {
    var h, l = _pmn_km_two_prod(ah, bh);
    var l2: f64 = _pmn_cm_fma(ah, bl, l);
    var l3: f64 = _pmn_cm_fma(al, bh, l2);
    return (h, l3);
}

# fast_sum: a + (bh + bl), for |a| ≥ |bh|.
#must_use
fn _pmn_cm_fast_sum(a: f64, bh: f64, bl: f64): (f64, f64) {
    var h, l = _pmn_km_fast_two_sum(a, bh);
    var l2: f64 = l + bl;
    return (h, l2);
}

# Round to the nearest integer, ties to even, for |x| < 2^51.
#must_use
fn _pmn_cm_roundeven(x: f64): f64 {
    var t: f64 = x + 6755399441055744.0;         # 1.5·2^52
    var r: f64 = t - 6755399441055744.0;
    return r;
}

# 2^e·r with one rounding (C's ldexp): two exact scalings, of which only the second can round.
#must_use
fn _pmn_cm_ldexp(r: f64, e): f64 {
    var e1 = e / 2;
    var e2 = e - e1;
    var s1: f64 = _pmn_km_cr_pow2(e1);
    var s2: f64 = _pmn_km_cr_pow2(e2);
    var y: f64 = r * s1;
    var z: f64 = y * s2;
    return z;
}

# A double from its bit pattern, for the subnormal constants (a small hex literal in an f64 slot reads as an integer).
#must_use
fn _pmn_cm_bits(w): f64 {
    var r: f64 = 0.0;
    store64(&r, w);
    return r;
}

#must_use
fn _pmn_cm_tab(t, i): f64 {
    var v: f64 = load64(t + i * 8);
    return v;
}

# ── erf ────────────────────────────────────────────────────────────────────────────────────────────

# cr_erf_fast: for 0 ≤ z ≤ 0x1.7afb48dc96626p+2, (h, l, err) with |(h + l)/erf(z) − 1| < err.
#must_use
fn _pmn_cm_erf_fast(z0: f64): (f64, f64, f64) {
    var z: f64 = z0;
    if (z < 0.0625) {
        var t = &_PMN_CM_FAST_C0;
        var z2h, z2l = _pmn_km_two_prod(z, z);
        var z4: f64 = z2h * z2h;
        var c9: f64 = _pmn_cm_fma(_pmn_cm_tab(t, 7), z2h, _pmn_cm_tab(t, 6));
        var c5: f64 = _pmn_cm_fma(_pmn_cm_tab(t, 5), z2h, _pmn_cm_tab(t, 4));
        c5 = _pmn_cm_fma(c9, z4, c5);
        var th, tl = _pmn_km_two_prod(z2h, c5);
        var h, l = _pmn_km_fast_two_sum(_pmn_cm_tab(t, 2), th);
        var a1: f64 = tl + _pmn_cm_tab(t, 3);
        l = l + a1;
        var hc: f64 = h;
        var th2, tl2 = _pmn_km_two_prod(z2h, h);
        var f1: f64 = _pmn_cm_fma(z2h, l, _pmn_cm_tab(t, 1));
        tl2 = tl2 + f1;
        var h2, l2 = _pmn_km_fast_two_sum(_pmn_cm_tab(t, 0), th2);
        var f2: f64 = _pmn_cm_fma(z2l, hc, tl2);
        l2 = l2 + f2;
        var h3, tl3 = _pmn_km_two_prod(h2, z);
        var l3: f64 = _pmn_cm_fma(l2, z, tl3);
        var err0: f64 = 0x3BA7800000000000;     # 0x1.78p-69
        return (h3, l3, err0);
    }
    var sz: f64 = 16.0 * z;
    var v: f64 = f64_floor(sz);
    var i = f64_to(sz);
    var zm: f64 = z - 0.03125;
    var vz: f64 = 0.0625 * v;
    z = zm - vz;
    var c = &_PMN_CM_C + (i - 1) * 13 * 8;
    var z2: f64 = z * z;
    var z4b: f64 = z2 * z2;
    var d9: f64 = _pmn_cm_fma(_pmn_cm_tab(c, 12), z, _pmn_cm_tab(c, 11));
    var d7: f64 = _pmn_cm_fma(_pmn_cm_tab(c, 10), z, _pmn_cm_tab(c, 9));
    var d5: f64 = _pmn_cm_fma(_pmn_cm_tab(c, 8), z, _pmn_cm_tab(c, 7));
    var zc6: f64 = z * _pmn_cm_tab(c, 6);
    var c3h, c3l = _pmn_km_fast_two_sum(_pmn_cm_tab(c, 5), zc6);
    d7 = _pmn_cm_fma(d9, z2, d7);
    var m5: f64 = d5 * z2;
    var c3h2, t1 = _pmn_km_fast_two_sum(c3h, m5);
    c3l = c3l + t1;
    var m7: f64 = d7 * z4b;
    var c3h3, t2 = _pmn_km_fast_two_sum(c3h2, m7);
    c3l = c3l + t2;
    var th3, tl3b = _pmn_km_two_prod(z, c3h3);
    var c2h, c2l = _pmn_km_fast_two_sum(_pmn_cm_tab(c, 4), th3);
    var f3: f64 = _pmn_cm_fma(z, c3l, tl3b);
    c2l = c2l + f3;
    var th4, tl4 = _pmn_km_two_prod(z, c2h);
    var hh, ll = _pmn_km_fast_two_sum(_pmn_cm_tab(c, 2), th4);
    var f4: f64 = _pmn_cm_fma(z, c2l, _pmn_cm_tab(c, 3));
    var a4: f64 = tl4 + f4;
    ll = ll + a4;
    var th5, tl5 = _pmn_km_two_prod(z, hh);
    tl5 = _pmn_cm_fma(z, ll, tl5);
    var hf, lf = _pmn_km_fast_two_sum(_pmn_cm_tab(c, 0), th5);
    var a5: f64 = tl5 + _pmn_cm_tab(c, 1);
    lf = lf + a5;
    var err1: f64 = 0x3BA1100000000000;         # 0x1.11p-69
    return (hf, lf, err1);
}

# cr_erf_accurate_tiny's polynomial, for 2^-61 ≤ z < 1/8 (erfc.c's copy, without erf's exception list).
#must_use
fn _pmn_cm_erf_acc_tiny_poly(z: f64): (f64, f64) {
    var p = &_PMN_CM_TINY_P;
    var z2: f64 = z * z;
    var h: f64 = _pmn_cm_tab(p, 14);
    var a = 19;
    while (a > 11) {
        h = _pmn_cm_fma(h, z2, _pmn_cm_tab(p, a / 2 + 4));
        a = a - 2;
    }
    var l: f64 = 0.0;
    a = 11;
    while (a > 7) {
        var th, tl = _pmn_km_two_prod(h, z);
        tl = _pmn_cm_fma(l, z, tl);
        var h2, l2 = _pmn_km_two_prod(th, z);
        l2 = _pmn_cm_fma(tl, z, l2);
        var h3, t3 = _pmn_km_fast_two_sum(_pmn_cm_tab(p, a / 2 + 4), h2);
        h = h3;
        l = l2 + t3;
        a = a - 2;
    }
    a = 7;
    while (a >= 1) {
        var th4, tl4 = _pmn_km_two_prod(h, z);
        tl4 = _pmn_cm_fma(l, z, tl4);
        var h4, l4 = _pmn_km_two_prod(th4, z);
        l4 = _pmn_cm_fma(tl4, z, l4);
        var h5, t5 = _pmn_km_fast_two_sum(_pmn_cm_tab(p, a - 1), h4);
        h = h5;
        var s5: f64 = _pmn_cm_tab(p, a) + t5;
        l = l4 + s5;
        a = a - 2;
    }
    var h6, tl6 = _pmn_km_two_prod(h, z);
    var l6: f64 = _pmn_cm_fma(l, z, tl6);
    return (h6, l6);
}

# cr_erf_accurate's polynomial, for 1/8 ≤ z ≤ 0x1.7afb48dc96626p+2.
#must_use
fn _pmn_cm_erf_acc_poly(z0: f64): (f64, f64) {
    var sz: f64 = 8.0 * z0;
    var v: f64 = f64_floor(sz);
    var i = f64_to(sz);
    var zm: f64 = z0 - 0.0625;
    var vz: f64 = 0.125 * v;
    var z: f64 = zm - vz;
    var p = &_PMN_CM_C2 + (i - 1) * 27 * 8;
    var h: f64 = _pmn_cm_tab(p, 26);
    var j = 17;
    while (j > 10) {
        h = _pmn_cm_fma(h, z, _pmn_cm_tab(p, 8 + j));
        j = j - 1;
    }
    var l: f64 = 0.0;
    j = 10;
    while (j > 7) {
        var th, tl = _pmn_km_two_prod(h, z);
        tl = _pmn_cm_fma(l, z, tl);
        var h2, l2 = _pmn_km_two_sum(_pmn_cm_tab(p, 8 + j), th);
        h = h2;
        l = l2 + tl;
        j = j - 1;
    }
    j = 7;
    while (j >= 0) {
        var th3, tl3 = _pmn_km_two_prod(h, z);
        tl3 = _pmn_cm_fma(l, z, tl3);
        var h3, l3 = _pmn_km_two_sum(_pmn_cm_tab(p, 2 * j), th3);
        h = h3;
        var s3: f64 = _pmn_cm_tab(p, 2 * j + 1) + tl3;
        l = l3 + s3;
        j = j - 1;
    }
    return (h, l);
}

# erf.c's cr_erf_accurate: its five exceptions, then the tiny path (with its own 171) or the polynomial.
#must_use
fn _pmn_cm_erf_accurate(z: f64): (f64, f64) {
    var e = &_PMN_CM_ACC_EXC;
    var i = 0;
    while (i < 5) {
        if (z == _pmn_cm_tab(e, 3 * i)) { return (_pmn_cm_tab(e, 3 * i + 1), _pmn_cm_tab(e, 3 * i + 2)); }
        i = i + 1;
    }
    if (z < 0.125) {
        var x = &_PMN_CM_TINY_EXC;
        var lo = 0;
        var hi = 171;
        while (lo + 1 < hi) {
            var k = (lo + hi) / 2;
            if (_pmn_cm_tab(x, 3 * k) <= z) { lo = k; } else { hi = k; }
        }
        if (z == _pmn_cm_tab(x, 3 * lo)) { return (_pmn_cm_tab(x, 3 * lo + 1), _pmn_cm_tab(x, 3 * lo + 2)); }
        var th, tl = _pmn_cm_erf_acc_tiny_poly(z);
        return (th, tl);
    }
    var ph, pl = _pmn_cm_erf_acc_poly(z);
    return (ph, pl);
}

# erfc.c's cr_erf_accurate: no exceptions (cr_erfc_accurate keeps its own).
#must_use
fn _pmn_cm_erf_acc_core(z: f64): (f64, f64) {
    if (z < 0.125) {
        var th, tl = _pmn_cm_erf_acc_tiny_poly(z);
        return (th, tl);
    }
    var ph, pl = _pmn_cm_erf_acc_poly(z);
    return (ph, pl);
}

# erf(x), correctly rounded (cr_erf).
#must_use
fn _pmn_cm_erf(x: f64): f64 {
    var z: f64 = f64_abs(x);
    var ux = load64(&z);
    if (ux > 0x4017AFB48DC96626) {
        var os: f64 = 1.0;
        if (x < 0.0) { os = -1.0; }
        if (ux > 0x7FF0000000000000) {
            var nn: f64 = x + x;
            return nn;
        }
        if (ux == 0x7FF0000000000000) { return os; }
        var e54: f64 = 0x3C90000000000000;      # 0x1p-54
        var q: f64 = e54 * os;
        var r: f64 = os - q;
        return r;
    }
    var t61: f64 = 0x3C20000000000000;          # 0x1p-61
    if (z < t61) {
        if (x == 0.0) { return x; }
        var ch: f64 = _PMN_CM_D_CH;
        var cl: f64 = _PMN_CM_D_CL;
        var y: f64 = ch * x;
        var s106: f64 = 0x4690000000000000;     # 0x1p106
        var sx: f64 = x * s106;
        var h, l = _pmn_km_two_prod(ch, sx);
        l = _pmn_cm_fma(cl, sx, l);
        var ys: f64 = y * s106;
        var d: f64 = h - ys;
        l = l + d;
        var res: f64 = _pmn_cm_fma_tiny(l, y);
        return res;
    }
    var fh, fl, err = _pmn_cm_erf_fast(z);
    var sgn = load64(&x) & 0x8000000000000000;
    var ub = load64(&fh) ^ sgn;
    var vb = load64(&fl) ^ sgn;
    var u: f64 = ub;
    var v: f64 = vb;
    var nu: f64 = -u;
    var a1: f64 = _pmn_cm_fma(err, nu, v);
    var left: f64 = u + a1;
    var a2: f64 = _pmn_cm_fma(err, u, v);
    var right: f64 = u + a2;
    if (left == right) { return left; }
    var ah, al = _pmn_cm_erf_accurate(z);
    if (x >= 0.0) {
        var rp: f64 = ah + al;
        return rp;
    }
    var nh: f64 = -ah;
    var nl: f64 = -al;
    var rn: f64 = nh + nl;
    return rn;
}

# The accurate path alone, for every finite x with 2^-61 ≤ |x| ≤ 0x1.7afb48dc96626p+2 (the verification's entry).
#must_use
fn _pmn_cm_erf_acc(x: f64): f64 {
    var z: f64 = f64_abs(x);
    var ah, al = _pmn_cm_erf_accurate(z);
    if (x >= 0.0) {
        var rp: f64 = ah + al;
        return rp;
    }
    var nh: f64 = -ah;
    var nl: f64 = -al;
    var rn: f64 = nh + nl;
    return rn;
}

# ── erfc ───────────────────────────────────────────────────────────────────────────────────────────

# q_1: exp(zh + zl) for |z| < 0.000130273, as a double-double.
#must_use
fn _pmn_cm_q_1(zh: f64, zl: f64): (f64, f64) {
    var q1 = &_PMN_CM_Q1;
    var z: f64 = zh + zl;
    var q: f64 = _pmn_cm_fma(_pmn_cm_tab(q1, 4), zh, _pmn_cm_tab(q1, 3));
    q = _pmn_cm_fma(q, z, _pmn_cm_tab(q1, 2));
    var qz: f64 = q * z;
    var h, l = _pmn_km_fast_two_sum(_pmn_cm_tab(q1, 1), qz);
    var h2, l2 = _pmn_cm_d_mul(zh, zl, h, l);
    var h3, l3 = _pmn_cm_fast_sum(_pmn_cm_tab(q1, 0), h2, l2);
    return (h3, l3);
}

# exp_1: exp(xh + xl) as a double-double (pow.[ch]'s fast path).
#must_use
fn _pmn_cm_exp_1(xh: f64, xl: f64): (f64, f64) {
    var inv: f64 = _PMN_CM_D_INVLOG2;
    var xi: f64 = xh * inv;
    var k: f64 = _pmn_cm_roundeven(xi);
    var l2h: f64 = _PMN_CM_D_LOG2H;
    var l2l: f64 = _PMN_CM_D_LOG2L;
    var kh, kl = _pmn_cm_s_mul(k, l2h, l2l);
    var dk: f64 = xh - kh;
    var yh, yl = _pmn_km_fast_two_sum(dk, xl);
    yl = yl - kl;
    var kk = f64_to(k);
    var m = (kk >>> 12) + 0x3FF;
    var i2 = (kk >>> 6) & 0x3F;
    var i1 = kk & 0x3F;
    var t1h: f64 = _pmn_cm_tab(&_PMN_CM_T1, 2 * i2);
    var t1l: f64 = _pmn_cm_tab(&_PMN_CM_T1, 2 * i2 + 1);
    var t2h: f64 = _pmn_cm_tab(&_PMN_CM_T2, 2 * i1);
    var t2l: f64 = _pmn_cm_tab(&_PMN_CM_T2, 2 * i1 + 1);
    var hh, hl = _pmn_cm_d_mul(t2h, t2l, t1h, t1l);
    var qh, ql = _pmn_cm_q_1(yh, yl);
    var rh, rl = _pmn_cm_d_mul(hh, hl, qh, ql);
    var sb = m << 52;
    var sc: f64 = sb;
    var oh: f64 = rh * sc;
    var ol: f64 = rl * sc;
    return (oh, ol);
}

# exp_accurate: exp(xh + xl) = 2^e·(h + l) for −742 ≤ xh + xl ≤ −2.92, to about 104 bits.
#must_use
fn _pmn_cm_exp_accurate(xh: f64, xl: f64): (f64, f64, i64) {
    var inv: f64 = _PMN_CM_D_INVLOG2acc;
    var xi: f64 = xh * inv;
    var kf: f64 = _pmn_cm_roundeven(xi);
    var k = f64_to(kf);
    var nk: f64 = -kf;
    var l2h: f64 = _PMN_CM_D_LOG2Hacc;
    var l2l: f64 = _PMN_CM_D_LOG2Lacc;
    var l2t: f64 = _PMN_CM_D_LOG2tiny;
    var yh: f64 = _pmn_cm_fma(nk, l2h, xh);
    var kl: f64 = nk * l2l;
    var th, tl = _pmn_km_two_sum(kl, xl);
    var yh2, yl = _pmn_km_fast_two_sum(yh, th);
    var ytl: f64 = yl + tl;
    var yl2: f64 = _pmn_cm_fma(nk, l2t, ytl);
    var e2 = &_PMN_CM_E2;
    var h: f64 = _pmn_cm_tab(e2, 27);
    var i = 18;
    while (i >= 16) {
        h = _pmn_cm_fma(h, yh2, _pmn_cm_tab(e2, i + 8));
        i = i - 1;
    }
    var ah, al = _pmn_km_two_prod(h, yh2);
    al = _pmn_cm_fma(h, yl2, al);
    var hh, ll = _pmn_km_fast_two_sum(_pmn_cm_tab(e2, 23), ah);
    ll = ll + al;
    i = 14;
    while (i >= 8) {
        var bh, bl = _pmn_km_two_prod(hh, yh2);
        bl = _pmn_cm_fma(hh, yl2, bl);
        bl = _pmn_cm_fma(ll, yh2, bl);
        var ch, cl = _pmn_km_fast_two_sum(_pmn_cm_tab(e2, i + 8), bh);
        hh = ch;
        ll = cl + bl;
        i = i - 1;
    }
    i = 7;
    while (i >= 0) {
        var dh, dl = _pmn_km_two_prod(hh, yh2);
        dl = _pmn_cm_fma(hh, yl2, dl);
        dl = _pmn_cm_fma(ll, yh2, dl);
        var fh, fl = _pmn_km_fast_two_sum(_pmn_cm_tab(e2, 2 * i), dh);
        hh = fh;
        var s: f64 = dl + _pmn_cm_tab(e2, 2 * i + 1);
        ll = fl + s;
        i = i - 1;
    }
    return (hh, ll, k);
}

# erfc_asympt_fast: for THRESHOLD1 < x < 0x1.b39dc41e48bfdp+4, (h, l, err), err an absolute bound.
#must_use
fn _pmn_cm_erfc_asympt_fast(x: f64): (f64, f64, f64) {
    var top: f64 = 0x4039DB1BB14E15CA;          # 0x1.9db1bb14e15cap+4
    if (x >= top) { return (0.0, 0.0, 1.0); }
    var uh, ul = _pmn_km_two_prod(x, x);
    var nuh: f64 = -uh;
    var nul: f64 = -ul;
    var eh, el = _pmn_cm_exp_1(nuh, nul);
    var yh: f64 = 1.0 / x;
    var nx: f64 = -x;
    var f: f64 = _pmn_cm_fma(nx, yh, 1.0);
    var yl: f64 = yh * f;
    var thr = &_PMN_CM_ASFAST_THR;
    var i = 0;
    while (yh > _pmn_cm_tab(thr, i)) { i = i + 1; }
    var p = &_PMN_CM_T + i * 13 * 8;
    var vh, vl = _pmn_km_two_prod(yh, yh);
    var y2: f64 = 2.0 * yh;
    vl = _pmn_cm_fma(y2, yl, vl);
    var zh: f64 = _pmn_cm_tab(p, 12);
    zh = _pmn_cm_fma(zh, vh, _pmn_cm_tab(p, 11));
    zh = _pmn_cm_fma(zh, vh, _pmn_cm_tab(p, 10));
    var h, l = _pmn_cm_s_mul(zh, vh, vl);
    var zh2, zl = _pmn_km_fast_two_sum(_pmn_cm_tab(p, 9), h);
    zl = zl + l;
    var j = 15;
    while (j >= 3) {
        var h2, l2 = _pmn_cm_d_mul(zh2, zl, vh, vl);
        var zh3, zl3 = _pmn_km_fast_two_sum(_pmn_cm_tab(p, (j + 1) / 2), h2);
        zh2 = zh3;
        zl = zl3 + l2;
        j = j - 2;
    }
    var h4, l4 = _pmn_cm_d_mul(zh2, zl, vh, vl);
    var zh5, zl5 = _pmn_km_fast_two_sum(_pmn_cm_tab(p, 0), h4);
    var s5: f64 = l4 + _pmn_cm_tab(p, 1);
    zl5 = zl5 + s5;
    var wh, wl = _pmn_cm_d_mul(zh5, zl5, yh, yl);
    var rh, rl = _pmn_cm_d_mul(wh, wl, eh, el);
    var lim: f64 = 0x044151B9A3FDD5C9;          # 0x1.151b9a3fdd5c9p-955
    if (rh >= lim) {
        var c: f64 = 0x3BBD900000000000;        # 0x1.d9p-68
        var er: f64 = c * rh;
        return (rh, rl, er);
    }
    var floor: f64 = 0x0010000000000000;        # 0x1p-1022
    return (rh, rl, floor);
}

# cr_erfc_fast: for −0x1.7744f8f74e94bp2 < x < 0x1.b39dc41e48bfdp+4, (h, l, err), err an absolute bound.
#must_use
fn _pmn_cm_erfc_fast(x: f64): (f64, f64, f64) {
    if (x < 0.0) {
        var nx: f64 = -x;
        var h, l, err = _pmn_cm_erf_fast(nx);
        var ea: f64 = err * h;
        var h2, t = _pmn_km_fast_two_sum(1.0, h);
        var l2: f64 = t + l;
        var c: f64 = 0x3994000000000000;        # 0x1.4p-102
        var e2: f64 = ea + c;
        return (h2, l2, e2);
    }
    var t1: f64 = _PMN_CM_D_THRESHOLD1;
    if (x <= t1) {
        var h3, l3, err3 = _pmn_cm_erf_fast(x);
        var ea3: f64 = err3 * h3;
        var nh: f64 = -h3;
        var h4, t4 = _pmn_km_fast_two_sum(1.0, nh);
        var l4: f64 = t4 - l3;
        var half: f64 = 0x3FDE861FBB24C00A;     # 0x1.e861fbb24c00ap-2
        if (x >= half) { return (h4, l4, ea3); }
        var c4: f64 = 0x3974000000000000;       # 0x1.4p-104
        var e4: f64 = ea3 + c4;
        return (h4, l4, e4);
    }
    var h5, l5, e5 = _pmn_cm_erfc_asympt_fast(x);
    return (h5, l5, e5);
}

# erfc_asympt_accurate: for 0x1.b59ffb450828cp+0 < x < 0x1.b39dc41e48bfdp+4.
#must_use
fn _pmn_cm_erfc_asympt_accurate(x: f64): f64 {
    var ex = &_PMN_CM_ASACC_EXC;
    var n = 0;
    while (n < 22) {
        if (x == _pmn_cm_tab(ex, 3 * n)) {
            var r0: f64 = _pmn_cm_tab(ex, 3 * n + 1) + _pmn_cm_tab(ex, 3 * n + 2);
            return r0;
        }
        n = n + 1;
    }
    var sx: f64 = 0x403A8F7BFBD15495;           # 0x1.a8f7bfbd15495p+4: the subnormal exception
    if (x == sx) {
        # C returns fma(0x1p-1074, -0.25, 0x1.99ef5883f656cp-1024): a quarter of the subnormal grid off a subnormal,
        # which rounds back to it.
        var rs: f64 = _pmn_cm_bits(0x000667BD620FD95B);   # 0x1.99ef5883f656cp-1024
        return rs;
    }
    var uh, ul = _pmn_km_two_prod(x, x);
    var nuh: f64 = -uh;
    var nul: f64 = -ul;
    var eh, el, e = _pmn_cm_exp_accurate(nuh, nul);
    var yh: f64 = 1.0 / x;
    var nx: f64 = -x;
    var f: f64 = _pmn_cm_fma(nx, yh, 1.0);
    var yl: f64 = yh * f;
    var thr = &_PMN_CM_ASACC_THR;
    var i = 0;
    while (yh > _pmn_cm_tab(thr, i)) { i = i + 1; }
    var p = &_PMN_CM_TACC + i * 30 * 8;
    var vh, vl = _pmn_km_two_prod(yh, yh);
    var y2: f64 = 2.0 * yh;
    vl = _pmn_cm_fma(y2, yl, vl);
    var zh: f64 = _pmn_cm_tab(p, 14 + 6 + i);
    var zl: f64 = 0.0;
    var j = 27 + 2 * i;
    while (j >= 13) {
        var h, l = _pmn_km_two_prod(zh, vh);
        l = _pmn_cm_fma(zh, vl, l);
        l = _pmn_cm_fma(zl, vh, l);
        var zh2, zl2 = _pmn_km_two_sum(_pmn_cm_tab(p, (j - 1) / 2 + 6), h);
        zh = zh2;
        zl = zl2 + l;
        j = j - 2;
    }
    j = 11;
    while (j >= 1) {
        var h3, l3 = _pmn_km_two_prod(zh, vh);
        l3 = _pmn_cm_fma(zh, vl, l3);
        l3 = _pmn_cm_fma(zl, vh, l3);
        var zh3, zl3 = _pmn_km_two_sum(_pmn_cm_tab(p, j - 1), h3);
        zh = zh3;
        var s3: f64 = l3 + _pmn_cm_tab(p, j);
        zl = zl3 + s3;
        j = j - 2;
    }
    var wh, wl = _pmn_km_two_prod(zh, yh);
    wl = _pmn_cm_fma(zh, yl, wl);
    wl = _pmn_cm_fma(zl, yh, wl);
    var wh2, wl2 = _pmn_km_fast_two_sum(wh, wl);
    var rh, rl = _pmn_km_two_prod(wh2, eh);
    rl = _pmn_cm_fma(wh2, el, rl);
    rl = _pmn_cm_fma(wl2, eh, rl);
    var sum: f64 = rh + rl;
    var res: f64 = _pmn_cm_ldexp(sum, e);
    var dmin: f64 = 0x0010000000000000;         # 0x1p-1022
    if (res < dmin) {
        var back: f64 = _pmn_cm_ldexp(res, 0 - e);
        var corr: f64 = rh - back;
        corr = corr + rl;
        var add: f64 = _pmn_cm_ldexp(corr, e);
        res = res + add;
    }
    return res;
}

# cr_erfc_accurate.
#must_use
fn _pmn_cm_erfc_accurate(x: f64): f64 {
    if (x < 0.0) {
        var en = &_PMN_CM_ERFC_NEG_EXC;
        var n = 0;
        while (n < 17) {
            if (x == _pmn_cm_tab(en, 3 * n)) {
                var r0: f64 = _pmn_cm_tab(en, 3 * n + 1) + _pmn_cm_tab(en, 3 * n + 2);
                return r0;
            }
            n = n + 1;
        }
        var nx: f64 = -x;
        var h, l = _pmn_cm_erf_acc_core(nx);
        var h2, t = _pmn_km_fast_two_sum(1.0, h);
        var l2: f64 = t + l;
        var r: f64 = h2 + l2;
        return r;
    }
    var mid: f64 = 0x3FFB59FFB450828C;          # 0x1.b59ffb450828cp+0
    if (x <= mid) {
        var ep = &_PMN_CM_ERFC_POS_EXC;
        var m = 0;
        while (m < 29) {
            if (x == _pmn_cm_tab(ep, 3 * m)) {
                var r1: f64 = _pmn_cm_tab(ep, 3 * m + 1) + _pmn_cm_tab(ep, 3 * m + 2);
                return r1;
            }
            m = m + 1;
        }
        var h3, l3 = _pmn_cm_erf_acc_core(x);
        var nh: f64 = -h3;
        var h4, t4 = _pmn_km_fast_two_sum(1.0, nh);
        var l4: f64 = t4 - l3;
        var r4: f64 = h4 + l4;
        return r4;
    }
    var r5: f64 = _pmn_cm_erfc_asympt_accurate(x);
    return r5;
}

# erfc(x), correctly rounded (cr_erfc).
#must_use
fn _pmn_cm_erfc(x: f64): f64 {
    var t = load64(&x);
    var at = t & 0x7FFFFFFFFFFFFFFF;
    if (t < 0) {
        if (t >= 0xC017744F8F74E94B) {
            if (t >= 0xFFF0000000000000) {
                if (t == 0xFFF0000000000000) { return 2.0; }
                var nn: f64 = x + x;
                return nn;
            }
            var e54: f64 = 0x3C90000000000000;  # 0x1p-54
            var r2: f64 = 2.0 - e54;
            return r2;
        }
        var lo: f64 = 0xBC9C5BF891B4EF6A;       # -0x1.c5bf891b4ef6ap-54
        if (lo <= x) {
            var nx: f64 = -x;
            var s54: f64 = 0x3C90000000000000;  # 0x1p-54
            var r1: f64 = _pmn_cm_fma(nx, s54, 1.0);
            return r1;
        }
    } else {
        if (at >= 0x403B39DC41E48BFD) {
            if (at >= 0x7FF0000000000000) {
                if (at == 0x7FF0000000000000) { return 0.0; }
                var np: f64 = x + x;
                return np;
            }
            var t1074: f64 = _pmn_cm_bits(1);           # 0x1p-1074
            var rq: f64 = t1074 * 0.25;
            return rq;
        }
        var hi: f64 = 0x3C8C5BF891B4EF6A;       # 0x1.c5bf891b4ef6ap-55
        if (x <= hi) {
            var nx2: f64 = -x;
            var s542: f64 = 0x3C90000000000000; # 0x1p-54
            var r3: f64 = _pmn_cm_fma(nx2, s542, 1.0);
            return r3;
        }
    }
    var h, l, err = _pmn_cm_erfc_fast(x);
    var a: f64 = l - err;
    var left: f64 = h + a;
    var b: f64 = l + err;
    var right: f64 = h + b;
    if (left == right) { return left; }
    var ra: f64 = _pmn_cm_erfc_accurate(x);
    return ra;
}

# The accurate path alone, for every finite x the fast path serves (the verification's entry).
#must_use
fn _pmn_cm_erfc_acc(x: f64): f64 {
    var ra: f64 = _pmn_cm_erfc_accurate(x);
    return ra;
}

# ── Φ on erfc's double-double core (M2 part b2; probe P9, §5 step 9d-4) ────────────────────────────────────────

# 1/√2 as a double-double: RN(1/√2) and RN(1/√2 − RN(1/√2)). scripts/crverify/consts.py checks both against their
# definition.
var _PMN_CM_RS2_H: f64 = 0x3FE6A09E667F3BCD;    # checked by consts.py: RN(1/sqrt 2)
var _PMN_CM_RS2_L: f64 = 0xBC8BDD3413B26456;    # checked by consts.py: RN(1/sqrt 2 - RN(1/sqrt 2))

# −z/√2 as a double-double h + l, to about 2^-104 relative, for |z| ≤ 64 (Dekker's split needs |z| < 2^996).
#must_use
fn _pmn_cm_ncdf_arg(z: f64): (f64, f64) {
    var nz: f64 = -z;
    var p, e = _pmn_km_two_prod(nz, _PMN_CM_RS2_H);
    var t: f64 = nz * _PMN_CM_RS2_L;
    var e2: f64 = e + t;
    var h, l = _pmn_km_fast_two_sum(p, e2);
    return (h, l);
}

# ρ = −l·(2/√π)·e^(−h²)/E, E ≈ erfc(h): erfc(h + l) = erfc(h)·(1 + ρ) to first order. |ρ| ≤ 2^-42.5 and needs about
# 2^-25 of relative accuracy, so e^(−h²) of the rounded h² (relative error h²·2^-53) is plenty. For h ≤ 25.86 only,
# where e^(−h²) is normal.
#must_use
fn _pmn_cm_ncdf_rho(h: f64, l: f64, e: f64): f64 {
    var h2: f64 = h * h;
    var nh2: f64 = -h2;
    var t: f64 = _pmn_km_cr_exp(nh2);
    var a: f64 = l * _PMN_CM_D_CH;                  # CH = RN(2/√π)
    var b: f64 = a * t;
    var r: f64 = b / e;
    var nr: f64 = -r;
    return nr;
}

# erfc(x) = 2^e·(rh + rl) unrounded, and w with erfc(x) = e^(−x²)·w stored at `wout`, for 0x1.b59ffb450828cp+0 < x <
# 0x1.b39dc41e48bfdp+4: _pmn_cm_erfc_asympt_accurate without its exception table (the inputs where erfc(x) itself is
# hard to round) or its final rounding.
#must_use
fn _pmn_cm_asympt_dd(x: f64, wout): (f64, f64, i64) {
    var uh, ul = _pmn_km_two_prod(x, x);
    var nuh: f64 = -uh;
    var nul: f64 = -ul;
    var eh, el, e = _pmn_cm_exp_accurate(nuh, nul);
    var yh: f64 = 1.0 / x;
    var nx: f64 = -x;
    var f: f64 = _pmn_cm_fma(nx, yh, 1.0);
    var yl: f64 = yh * f;
    var thr = &_PMN_CM_ASACC_THR;
    var i = 0;
    while (yh > _pmn_cm_tab(thr, i)) { i = i + 1; }
    var p = &_PMN_CM_TACC + i * 30 * 8;
    var vh, vl = _pmn_km_two_prod(yh, yh);
    var y2: f64 = 2.0 * yh;
    vl = _pmn_cm_fma(y2, yl, vl);
    var zh: f64 = _pmn_cm_tab(p, 14 + 6 + i);
    var zl: f64 = 0.0;
    var j = 27 + 2 * i;
    while (j >= 13) {
        var h, l = _pmn_km_two_prod(zh, vh);
        l = _pmn_cm_fma(zh, vl, l);
        l = _pmn_cm_fma(zl, vh, l);
        var zh2, zl2 = _pmn_km_two_sum(_pmn_cm_tab(p, (j - 1) / 2 + 6), h);
        zh = zh2;
        zl = zl2 + l;
        j = j - 2;
    }
    j = 11;
    while (j >= 1) {
        var h3, l3 = _pmn_km_two_prod(zh, vh);
        l3 = _pmn_cm_fma(zh, vl, l3);
        l3 = _pmn_cm_fma(zl, vh, l3);
        var zh3, zl3 = _pmn_km_two_sum(_pmn_cm_tab(p, j - 1), h3);
        zh = zh3;
        var s3: f64 = l3 + _pmn_cm_tab(p, j);
        zl = zl3 + s3;
        j = j - 2;
    }
    var wh, wl = _pmn_km_two_prod(zh, yh);
    wl = _pmn_cm_fma(zh, yl, wl);
    wl = _pmn_cm_fma(zl, yh, wl);
    var wh2, wl2 = _pmn_km_fast_two_sum(wh, wl);
    var rh, rl = _pmn_km_two_prod(wh2, eh);
    rl = _pmn_cm_fma(wh2, el, rl);
    rl = _pmn_cm_fma(wl2, eh, rl);
    store64(wout, wh2);
    return (rh, rl, e);
}

# RN((rh + rl)·2^e) with one rounding, for rh > 0 and |rl| ≤ ulp(rh): a normal result is RN(rh + rl) scaled exactly;
# a subnormal one is N·2^-1074 with N = RN(2^52 + (rh + rl)·2^(e+1074)) − 2^52 (the grid of [2^52, 2^53) is 1, and
# both scalings are exact), as _pmn_cm_fma_tiny does.
#must_use
fn _pmn_cm_round_scaled(rh: f64, rl: f64, e): f64 {
    var r: f64 = rh + rl;
    var y: f64 = _pmn_cm_ldexp(r, e);
    var dmin: f64 = 0x0010000000000000;            # 0x1p-1022
    if (y >= dmin) { return y; }
    var q = e + 1074;
    var a: f64 = _pmn_cm_ldexp(rh, q);
    var b: f64 = _pmn_cm_ldexp(rl, q);
    var m: f64 = 0x4330000000000000;               # 0x1p52
    var t: f64 = _pmn_km_rn3(m, a, b);
    var n: f64 = t - m;
    var tiny: f64 = _pmn_cm_bits(1);               # 0x1p-1074
    var r2: f64 = n * tiny;
    return r2;
}

# erfc(h) = 2^e·(rh + rl) before rounding, and ρ for h + l stored at `rout`: from CORE-MATH's fast path when its bound
# is under 2^-60 relative, else from its accurate paths (about 2^-100). For −0x1.7744f8f74e94bp+2 < h <
# 0x1.b39dc41e48bfdp+4. The 2^-60 bound is the speed knob P9 measured: it keeps the result within 0.5 + 2^-7 ulp, and
# 2^-56 would keep it within 0.5 + 2^-3 at about 30% less in the core (port-parity §6.8, §8.6).
#must_use
fn _pmn_cm_erfc_dd(h: f64, l: f64, rout): (f64, f64, i64) {
    var fh, fl, err = _pmn_cm_erfc_fast(h);
    var c60: f64 = 0x3C30000000000000;             # 0x1p-60
    var lim: f64 = fh * c60;
    if (err <= lim) {
        var rho: f64 = _pmn_cm_ncdf_rho(h, l, fh);
        store64(rout, rho);
        return (fh, fl, 0);
    }
    var mid: f64 = 0x3FFB59FFB450828C;             # 0x1.b59ffb450828cp+0
    if (h <= mid) {
        # erfc = 1 ∓ erf(|h|), as cr_erfc_accurate (in practice unused: the fast bound holds below mid)
        if (h < 0.0) {
            var nh: f64 = -h;
            var a, b = _pmn_cm_erf_acc_core(nh);
            var r, t = _pmn_km_fast_two_sum(1.0, a);
            var rl: f64 = t + b;
            var rho1: f64 = _pmn_cm_ncdf_rho(h, l, r);
            store64(rout, rho1);
            return (r, rl, 0);
        }
        var a2, b2 = _pmn_cm_erf_acc_core(h);
        var na2: f64 = -a2;
        var r2, t2 = _pmn_km_fast_two_sum(1.0, na2);
        var rl2: f64 = t2 - b2;
        var rho2: f64 = _pmn_cm_ncdf_rho(h, l, r2);
        store64(rout, rho2);
        return (r2, rl2, 0);
    }
    var w: f64 = 0.0;
    var rh, rl3, e = _pmn_cm_asympt_dd(h, &w);
    var q: f64 = l * _PMN_CM_D_CH;
    var rho3: f64 = q / w;
    var nrho3: f64 = -rho3;
    store64(rout, nrho3);
    return (rh, rl3, e);
}

# The cases with a fixed result, on the thresholds cr_erfc uses for h: Φ = 1 (erfc(h) rounds to 2), Φ = 0 (erfc(h) <
# 2^-1075), and Φ = ½ (erfc(h) rounds to 1). Returns (1, Φ) when one applies, else (0, 0).
#must_use
fn _pmn_cm_ncdf_special(h: f64): (i64, f64) {
    var lo: f64 = 0xC017744F8F74E94B;               # -0x1.7744f8f74e94bp+2
    if (h <= lo) { return (1, 1.0); }
    var hi: f64 = 0x403B39DC41E48BFD;               # 0x1.b39dc41e48bfdp+4
    if (h >= hi) { return (1, 0.0); }
    var tn: f64 = 0xBC9C5BF891B4EF6A;               # -0x1.c5bf891b4ef6ap-54
    var tp: f64 = 0x3C8C5BF891B4EF6A;               # 0x1.c5bf891b4ef6ap-55
    if (h >= tn && h <= tp) { return (1, 0.5); }
    return (0, 0.0);
}

# Φ(z) = ½·erfc(−z/√2) within 0.5 + 2^-7 ulp (T1, M2 part b2): with h + l = −z/√2 as a double-double, Φ(z) =
# 2^(e−1)·(rh + rl + rh·ρ) from erfc(h)'s double-double 2^e·(rh + rl) and the first-order correction ρ for l, rounded
# once, on the subnormal grid too. A NaN is returned as z + z.
#must_use
fn _pmn_cm_normal_cdf(z: f64): f64 {
    if (z != z) {
        var nn: f64 = z + z;
        return nn;
    }
    if (z > 16.0) { return 1.0; }
    if (z < -40.0) { return 0.0; }
    var h, l = _pmn_cm_ncdf_arg(z);
    var sp, sv = _pmn_cm_ncdf_special(h);
    if (sp == 1) { return sv; }
    var rho: f64 = 0.0;
    var rh, rl, e = _pmn_cm_erfc_dd(h, l, &rho);
    var c: f64 = rh * rho;
    var rl2: f64 = rl + c;
    var r: f64 = _pmn_cm_round_scaled(rh, rl2, e - 1);
    return r;
}

