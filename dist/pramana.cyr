# --- lgamma.cyr ---

# lgamma.cyr — lnΓ within 2 ulp (T1, M2 part b3; port plan D3 = C, §3.4; ADR 009: ≤ 2 ulp for x > 0, and ≤ 2 ulp
# of max(|lnΓ|, 1) for x < 0).
#
# Probe P9's prototype (§5 step 9d-1), moved here unchanged but for names. It is fdlibm's e_lgamma_r layout:
# polynomials centred on the roots at 1 and 2 and on the minimum at 1.4616, the rational form on [2, 3) with the
# product (y + 2)(y + 3)… up to 8, and the asymptotic series from 8. Three changes keep a rounding from costing an
# ulp:
# - every logarithm is kimiya's double-double ln core (src/crmath.cyr, relative error near 2^-80), not a rounded ln;
# - the product on [3, 8), and (x − ½)(ln x − 1) for x ≥ 8 at every magnitude up to lnΓ's overflow, are carried as
#   double-doubles (fdlibm drops the −½ past 2^58);
# - for x < 0, sin(πx) is reduced exactly, r = |x| − round(|x|), and the reflection subtracts in double-double.
# The result is rounded once. P9 measured it within 1.31 ulp for x > 0 and 1.40 ulp of max(|lnΓ|, 1) for x < 0 on
# 1,675,000 MPFR rows, where 1.3.0's Lanczos form is off by up to 4.3×10¹³ ulp beside the roots.
#
# Unlike 1.3.0: lnΓ(x) = −ln x for 0 < x < 2^-70 (1.3.0 returned +∞ below about 3.2e-301); the negative integers are
# poles, +∞ (1.3.0 returned a finite value, as sin(π·n) rounds away from 0); and lnΓ(±∞) = +∞ (1.3.0: NaN at +∞).
# The coefficients are src/lgamma_data.cyr's, which scripts/vendor_lgamma.py generates from the libm crate's
# transcription of e_lgamma_r.c and checks, with this file's inline hex words (`--check`).
#
# UPSTREAM(L8): ganita:docs/development/issues/2026-11-15-special-functions-scope-request.md
#   replace with ganita's lgamma if it takes the special functions on, at ADR 009's bound; parity: every ln_gamma row
#
# ====================================================
# Copyright (C) 1993 by Sun Microsystems, Inc. All rights reserved.
#
# Developed at SunSoft, a Sun Microsystems, Inc. business.
# Permission to use, copy, modify, and distribute this
# software is freely granted, provided that this notice
# is preserved.
# ====================================================

# fdlibm's polynomial for lnΓ near 1 and 2 (x < 2), case i of e_lgamma_r, in its operation order: the value r adds.
#must_use
fn _pmn_lg_poly12(y: f64, i): f64 {
    if (i == 0) {
        var a0: f64 = _PMN_LG_A0;
        var a1: f64 = _PMN_LG_A1;
        var a2: f64 = _PMN_LG_A2;
        var a3: f64 = _PMN_LG_A3;
        var a4: f64 = _PMN_LG_A4;
        var a5: f64 = _PMN_LG_A5;
        var a6: f64 = _PMN_LG_A6;
        var a7: f64 = _PMN_LG_A7;
        var a8: f64 = _PMN_LG_A8;
        var a9: f64 = _PMN_LG_A9;
        var a10: f64 = _PMN_LG_A10;
        var a11: f64 = _PMN_LG_A11;
        var z: f64 = y * y;
        var p1: f64 = a0 + z * (a2 + z * (a4 + z * (a6 + z * (a8 + z * a10))));
        var p2: f64 = z * (a1 + z * (a3 + z * (a5 + z * (a7 + z * (a9 + z * a11)))));
        var yp: f64 = y * p1;
        var p: f64 = yp + p2;
        var hy: f64 = 0.5 * y;
        return p - hy;
    }
    if (i == 1) {
        var t0: f64 = _PMN_LG_T0;
        var t1: f64 = _PMN_LG_T1;
        var t2: f64 = _PMN_LG_T2;
        var t3: f64 = _PMN_LG_T3;
        var t4: f64 = _PMN_LG_T4;
        var t5: f64 = _PMN_LG_T5;
        var t6: f64 = _PMN_LG_T6;
        var t7: f64 = _PMN_LG_T7;
        var t8: f64 = _PMN_LG_T8;
        var t9: f64 = _PMN_LG_T9;
        var t10: f64 = _PMN_LG_T10;
        var t11: f64 = _PMN_LG_T11;
        var t12: f64 = _PMN_LG_T12;
        var t13: f64 = _PMN_LG_T13;
        var t14: f64 = _PMN_LG_T14;
        var tf: f64 = _PMN_LG_TF;
        var tt: f64 = _PMN_LG_TT;
        var z1: f64 = y * y;
        var w: f64 = z1 * y;
        var q1: f64 = t0 + w * (t3 + w * (t6 + w * (t9 + w * t12)));
        var q2: f64 = t1 + w * (t4 + w * (t7 + w * (t10 + w * t13)));
        var q3: f64 = t2 + w * (t5 + w * (t8 + w * (t11 + w * t14)));
        var inner: f64 = q2 + y * q3;
        var wi: f64 = w * inner;
        var zq: f64 = z1 * q1;
        var tw: f64 = tt - wi;
        var pp: f64 = zq - tw;
        return tf + pp;
    }
    var u0: f64 = _PMN_LG_U0;
    var u1: f64 = _PMN_LG_U1;
    var u2: f64 = _PMN_LG_U2;
    var u3: f64 = _PMN_LG_U3;
    var u4: f64 = _PMN_LG_U4;
    var u5: f64 = _PMN_LG_U5;
    var v1: f64 = _PMN_LG_V1;
    var v2: f64 = _PMN_LG_V2;
    var v3: f64 = _PMN_LG_V3;
    var v4: f64 = _PMN_LG_V4;
    var v5: f64 = _PMN_LG_V5;
    var r1: f64 = y * (u0 + y * (u1 + y * (u2 + y * (u3 + y * (u4 + y * u5)))));
    var r2: f64 = 1.0 + y * (v1 + y * (v2 + y * (v3 + y * (v4 + y * v5))));
    var hy2: f64 = -0.5 * y;
    var qq: f64 = r1 / r2;
    return hy2 + qq;
}

# lnΓ(2 + y) for y in [0, 1), fdlibm's rational form: 0.5·y + P(y)/Q(y).
#must_use
fn _pmn_lg_rat23(y: f64): f64 {
    var s0: f64 = _PMN_LG_S0;
    var s1: f64 = _PMN_LG_S1;
    var s2: f64 = _PMN_LG_S2;
    var s3: f64 = _PMN_LG_S3;
    var s4: f64 = _PMN_LG_S4;
    var s5: f64 = _PMN_LG_S5;
    var s6: f64 = _PMN_LG_S6;
    var r1: f64 = _PMN_LG_R1;
    var r2: f64 = _PMN_LG_R2;
    var r3: f64 = _PMN_LG_R3;
    var r4: f64 = _PMN_LG_R4;
    var r5: f64 = _PMN_LG_R5;
    var r6: f64 = _PMN_LG_R6;
    var p: f64 = y * (s0 + y * (s1 + y * (s2 + y * (s3 + y * (s4 + y * (s5 + y * s6))))));
    var q: f64 = 1.0 + y * (r1 + y * (r2 + y * (r3 + y * (r4 + y * (r5 + y * r6)))));
    var hy: f64 = 0.5 * y;
    var pq: f64 = p / q;
    return hy + pq;
}

# lnΓ(x) for a finite x ≥ 2^-70, as an unrounded double-double (h, l).
#must_use
fn _pmn_lg_pos_dd(x: f64): (f64, f64) {
    var u = load64(&x);
    var ix = (u >> 32) & 0x7FFFFFFF;
    if ((ix == 0x3FF00000 || ix == 0x40000000) && (u & 0xFFFFFFFF) == 0) { return (0.0, 0.0); }
    if (ix < 0x40000000) {
        # x < 2: lnΓ(x) = lnΓ(x + 1) − ln x below 0.9, then a polynomial centred on 1, 2 or the minimum.
        var rh: f64 = 0.0;
        var rl: f64 = 0.0;
        var y: f64 = 0.0;
        var i = 0;
        var tc: f64 = _PMN_LG_TC;
        if (ix <= 0x3FECCCCC) {
            var lh, ll = _pmn_dd_ln(x);
            rh = -lh;
            rl = -ll;
            if (ix >= 0x3FE76944) {
                y = 1.0 - x;
            } elif (ix >= 0x3FCDA661) {
                var tm1: f64 = tc - 1.0;
                y = x - tm1;
                i = 1;
            } else {
                y = x;
                i = 2;
            }
        } else {
            if (ix >= 0x3FFBB4C3) {
                y = 2.0 - x;
            } elif (ix >= 0x3FF3B4C4) {
                y = x - tc;
                i = 1;
            } else {
                y = x - 1.0;
                i = 2;
            }
        }
        var pv: f64 = _pmn_lg_poly12(y, i);
        var s, e = _pmn_km_two_sum(rh, pv);
        var lo: f64 = e + rl;
        return (s, lo);
    }
    if (ix < 0x40200000) {
        # 2 ≤ x < 8: lnΓ(2 + y) + ln((y + 2)(y + 3)…), the product as a double-double.
        var k = f64_to(x);
        var fk: f64 = f64_from(k);
        var y2: f64 = x - fk;
        var r0: f64 = _pmn_lg_rat23(y2);
        if (k < 3) { return (r0, 0.0); }
        var zh, zl = _pmn_km_two_sum(y2, 2.0);
        var j = 3;
        while (j < k) {
            var fj: f64 = f64_from(j);
            var fh, fl = _pmn_km_two_sum(y2, fj);
            var mh, ml = _pmn_dd_mul(zh, zl, fh, fl);
            zh = mh;
            zl = ml;
            j = j + 1;
        }
        var lzh, lzl = _pmn_dd_ln(zh);
        var cz: f64 = zl / zh;
        var lzl2: f64 = lzl + cz;
        var s2, e2 = _pmn_km_two_sum(lzh, r0);
        var lo2: f64 = e2 + lzl2;
        return (s2, lo2);
    }
    # x ≥ 8: (x − ½)(ln x − 1) + w(1/x), with x·(ln x − 1) a double-double at every magnitude.
    var th, tl = _pmn_dd_ln(x);
    var sh, sl0 = _pmn_km_two_sum(th, -1.0);
    var sl: f64 = sl0 + tl;
    var ph: f64 = 0.0;
    var pe: f64 = 0.0;
    var big: f64 = 0x7DD0000000000000;          # 0x1p990: Veltkamp's split needs |x| below 2^996
    if (x < big) {
        var p0, e0 = _pmn_km_two_prod(x, sh);
        ph = p0;
        pe = e0;
    } else {
        var dn: f64 = 0x3BF0000000000000;       # 0x1p-64
        var up: f64 = 0x43F0000000000000;       # 0x1p64
        var xs: f64 = x * dn;
        var p1, e1 = _pmn_km_two_prod(xs, sh);
        ph = p1 * up;
        pe = e1 * up;
    }
    # lnΓ overflows past about 2.556·10³⁰⁵: x·(ln x − 1) is then +∞, and its error term would make ∞ − ∞ (P9's sets
    # stopped at 8·2^1010; M2 part b3 found the NaN). It is within ½ ln x of lnΓ, so the two round alike but within
    # about 352 of the overflow tie.
    if (ph == _PMN_F64_INFINITY) { return (ph, 0.0); }
    var xsl: f64 = x * sl;
    pe = pe + xsl;
    var hsh: f64 = -0.5 * sh;
    var hsl: f64 = -0.5 * sl;
    var w0: f64 = _PMN_LG_W0;
    var w1: f64 = _PMN_LG_W1;
    var w2: f64 = _PMN_LG_W2;
    var w3: f64 = _PMN_LG_W3;
    var w4: f64 = _PMN_LG_W4;
    var w5: f64 = _PMN_LG_W5;
    var w6: f64 = _PMN_LG_W6;
    var zr: f64 = 1.0 / x;
    var yr: f64 = zr * zr;
    var w: f64 = w0 + zr * (w1 + yr * (w2 + yr * (w3 + yr * (w4 + yr * (w5 + yr * w6)))));
    var tail: f64 = (hsh + hsl) + w;
    var lo3: f64 = pe + tail;
    var h3, l3 = _pmn_km_fast_two_sum(ph, lo3);
    return (h3, l3);
}

# T1 lnΓ(x) = ln|Γ(x)|, rounded once. +∞ at 0, at the negative integers and at ±∞; NaN for NaN.
#must_use
fn _pmn_lg_ln_gamma(x: f64): f64 {
    var u = load64(&x);
    var ix = (u >> 32) & 0x7FFFFFFF;
    if (ix >= 0x7FF00000) {
        var sq: f64 = x * x;
        return sq;
    }
    if (ix < 0x3B900000) {
        # |x| < 2^-70: lnΓ(x) = −ln|x| to far below an ulp.
        var ax: f64 = f64_abs(x);
        var lx: f64 = _pmn_km_cr_ln(ax);
        return -lx;
    }
    if (x > 0.0) {
        var h, l = _pmn_lg_pos_dd(x);
        var r: f64 = h + l;
        return r;
    }
    # x < 0: lnΓ(x) = ln π − ln|x| − ln|sin(π r)| − lnΓ(|x|), r = |x| − round(|x|) exactly.
    var inf: f64 = _PMN_F64_INFINITY;
    var a: f64 = -x;
    var two52: f64 = 0x4330000000000000;     # 0x1p52
    if (a >= two52) { return inf; }
    var ah: f64 = a + 0.5;
    var n: f64 = f64_floor(ah);
    var rr: f64 = a - n;
    if (rr == 0.0) { return inf; }
    var ar: f64 = f64_abs(rr);
    var pih: f64 = _PMN_KM_CR_SC_PIH;
    var pim: f64 = _PMN_KM_CR_SC_PIM;
    var qh, ql0 = _pmn_km_two_prod(pih, ar);
    var qm: f64 = pim * ar;
    var ql: f64 = ql0 + qm;
    var sn: f64 = _pmn_km_cr_sin(qh);
    var cs: f64 = _pmn_km_cr_cos(qh);
    var sc: f64 = ql * cs;
    var lsh, lsl0 = _pmn_dd_ln(sn);
    var csn: f64 = sc / sn;
    var lsl: f64 = lsl0 + csn;
    var lah, lal = _pmn_dd_ln(a);
    var lph, lpl0 = _pmn_dd_ln(pih);
    var cpi: f64 = pim / pih;
    var lpl: f64 = lpl0 + cpi;
    var gh, gl = _pmn_lg_pos_dd(a);
    var nlah: f64 = -lah;
    var nlsh: f64 = -lsh;
    var ngh: f64 = -gh;
    var s1, e1 = _pmn_km_two_sum(lph, nlah);
    var s2, e2 = _pmn_km_two_sum(s1, nlsh);
    var s3, e3 = _pmn_km_two_sum(s2, ngh);
    var lo: f64 = ((e1 + e2) + e3) + (((lpl - lal) - lsl) - gl);
    var res: f64 = s3 + lo;
    return res;
}

