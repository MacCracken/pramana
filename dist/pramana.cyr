# ln 2 = LN2H + LN2M + LN2L (LN2H at 42 bits, so E·LN2H is exact for |E| < 2^11). C3 … C8: the
# Taylor coefficients 1/3, −1/4, 1/5, −1/6, 1/7, −1/8 of log1p(r) − r + r²/2. 1/ln 10 = IVH + IVM +
# IVL, and IVH = IVH1 + IVH2 (26 + 27 bits).
var _PMN_KM_CR_LN_LN2H = 0x3FE62E42FEFA3800;   # 0.6931471805598903

var _PMN_KM_CR_LN_LN2M = 0x3D2EF35793C76730;   # 5.497923018708371e-14

var _PMN_KM_CR_LN_LN2L = 0x398F97B57A079A19;   # 1.94704509238075e-31

var _PMN_KM_CR_LN_C3 = 0x3FD5555555555555;   # 0.3333333333333333

var _PMN_KM_CR_LN_C4 = 0xBFD0000000000000;   # -0.25

var _PMN_KM_CR_LN_C5 = 0x3FC999999999999A;   # 0.2

var _PMN_KM_CR_LN_C6 = 0xBFC5555555555555;   # -0.16666666666666666

var _PMN_KM_CR_LN_C7 = 0x3FC2492492492492;   # 0.14285714285714285

var _PMN_KM_CR_LN_C8 = 0xBFC0000000000000;   # -0.125

