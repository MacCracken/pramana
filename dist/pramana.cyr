# An f64's bits as a word (impetus takes `_im_bits` from its mathx.cyr): an untyped parameter, an i64 return.
#must_use
fn _pmn_im_bits(x): i64 {
    return x;
}

# a := v, for 0 <= v < 2^63.
fn _pmn_im_bn_set(a, v) {
    var n = 0;
    var x = v;
    while (x != 0) {
        store64(a + 8 + n * 8, x & 0xFFFFFFFF);
        x = x >> 32;
        n = n + 1;
    }
    store64(a, n);
    return 0;
}

# dst := src.
fn _pmn_im_bn_copy(dst, src) {
    var n = load64(src);
    for (var i = 0; i <= n; i = i + 1) { store64(dst + i * 8, load64(src + i * 8)); }
    return 0;
}

# a := a × m, for 0 < m < 2^31.
fn _pmn_im_bn_mul_small(a, m) {
    var n = load64(a);
    var carry = 0;
    for (var i = 0; i < n; i = i + 1) {
        var t = load64(a + 8 + i * 8) * m + carry;
        store64(a + 8 + i * 8, t & 0xFFFFFFFF);
        carry = t >> 32;
    }
    while (carry != 0) {
        store64(a + 8 + n * 8, carry & 0xFFFFFFFF);
        carry = carry >> 32;
        n = n + 1;
    }
    store64(a, n);
    return 0;
}

# a := a × 10^k, for k >= 0 (in steps of 10^9).
fn _pmn_im_bn_mul_pow10(a, k) {
    var left = k;
    while (left >= 9) {
        _pmn_im_bn_mul_small(a, 1000000000);
        left = left - 9;
    }
    var m = 1;
    for (var i = 0; i < left; i = i + 1) { m = m * 10; }
    if (m > 1) { _pmn_im_bn_mul_small(a, m); }
    return 0;
}

# a := a × 2^k, for k >= 0.
fn _pmn_im_bn_shl(a, k) {
    var n = load64(a);
    if (n == 0) { return 0; }
    var q = k / 32;
    var b = k % 32;
    if (b != 0) {
        var carry = 0;
        for (var i = 0; i < n; i = i + 1) {
            var t = (load64(a + 8 + i * 8) << b) | carry;
            store64(a + 8 + i * 8, t & 0xFFFFFFFF);
            carry = t >> 32;
        }
        if (carry != 0) {
            store64(a + 8 + n * 8, carry);
            n = n + 1;
        }
    }
    if (q > 0) {
        var i = n - 1;
        while (i >= 0) {
            store64(a + 8 + (i + q) * 8, load64(a + 8 + i * 8));
            i = i - 1;
        }
        for (var j = 0; j < q; j = j + 1) { store64(a + 8 + j * 8, 0); }
        n = n + q;
    }
    store64(a, n);
    return 0;
}

# dst := a + b (dst distinct from both).
fn _pmn_im_bn_sum(dst, a, b) {
    var na = load64(a);
    var nb = load64(b);
    var n = na;
    if (nb > n) { n = nb; }
    var carry = 0;
    for (var i = 0; i < n; i = i + 1) {
        var x = 0;
        var y = 0;
        if (i < na) { x = load64(a + 8 + i * 8); }
        if (i < nb) { y = load64(b + 8 + i * 8); }
        var t = x + y + carry;
        store64(dst + 8 + i * 8, t & 0xFFFFFFFF);
        carry = t >> 32;
    }
    if (carry != 0) {
        store64(dst + 8 + n * 8, carry);
        n = n + 1;
    }
    store64(dst, n);
    return 0;
}

# -1, 0 or 1 as a < b, a = b, a > b.
#must_use
fn _pmn_im_bn_cmp(a, b): i64 {
    var na = load64(a);
    var nb = load64(b);
    if (na != nb) {
        if (na < nb) { return 0 - 1; }
        return 1;
    }
    var i = na - 1;
    while (i >= 0) {
        var x = load64(a + 8 + i * 8);
        var y = load64(b + 8 + i * 8);
        if (x != y) {
            if (x < y) { return 0 - 1; }
            return 1;
        }
        i = i - 1;
    }
    return 0;
}

# a := a − b, for a >= b.
fn _pmn_im_bn_sub(a, b) {
    var na = load64(a);
    var nb = load64(b);
    var borrow = 0;
    for (var i = 0; i < na; i = i + 1) {
        var y = 0;
        if (i < nb) { y = load64(b + 8 + i * 8); }
        var t = load64(a + 8 + i * 8) - y - borrow;
        borrow = 0;
        if (t < 0) {
            t = t + 0x100000000;
            borrow = 1;
        }
        store64(a + 8 + i * 8, t);
    }
    while (na > 0 && load64(a + na * 8) == 0) { na = na - 1; }
    store64(a, na);
    return 0;
}

# The number of bits in x > 0.
#must_use
fn _pmn_im_bitlen(x): i64 {
    var n = 0;
    var v = x;
    while (v != 0) {
        v = v >> 1;
        n = n + 1;
    }
    return n;
}

# The shortest decimal digits of the positive finite double with bits `bits` that read back to it,
# the closest to its exact value among them: writes the ASCII digits to `digits` (17 bytes is
# enough) and returns (n, k) with value = 0.d1d2…dn × 10^k. When the exact value lies exactly
# halfway between the two closest candidates, `tie_even` 0 takes the upper one (Rust's core
# printer: 2^-25 is 2.9802322387695313e-8) and 1 the even one (serde_json's zmij: …5312e-8).
fn _pmn_im_shortest(bits, digits, tie_even) {
    var be = (bits >> 52) & 0x7FF;
    var f = bits & 0xFFFFFFFFFFFFF;
    var e = 0 - 1074;
    if (be != 0) {
        f = f | 0x10000000000000;
        e = be - 1075;
    }
    # IEEE round-half-even on reading: the interval's ends belong to it when f is even.
    var even = 1 - (f & 1);
    var r[328];
    var s[328];
    var mp[328];
    var mm[328];
    var t[328];
    if (e >= 0) {
        if (f != 0x10000000000000) {
            _pmn_im_bn_set(&r, f);
            _pmn_im_bn_shl(&r, e + 1);
            _pmn_im_bn_set(&s, 2);
            _pmn_im_bn_set(&mp, 1);
            _pmn_im_bn_shl(&mp, e);
            _pmn_im_bn_copy(&mm, &mp);
        } else {
            _pmn_im_bn_set(&r, f);
            _pmn_im_bn_shl(&r, e + 2);
            _pmn_im_bn_set(&s, 4);
            _pmn_im_bn_set(&mp, 1);
            _pmn_im_bn_shl(&mp, e + 1);
            _pmn_im_bn_set(&mm, 1);
            _pmn_im_bn_shl(&mm, e);
        }
    } else {
        if (e == 0 - 1074 || f != 0x10000000000000) {
            _pmn_im_bn_set(&r, f);
            _pmn_im_bn_shl(&r, 1);
            _pmn_im_bn_set(&s, 1);
            _pmn_im_bn_shl(&s, 1 - e);
            _pmn_im_bn_set(&mp, 1);
            _pmn_im_bn_set(&mm, 1);
        } else {
            _pmn_im_bn_set(&r, f);
            _pmn_im_bn_shl(&r, 2);
            _pmn_im_bn_set(&s, 1);
            _pmn_im_bn_shl(&s, 2 - e);
            _pmn_im_bn_set(&mp, 2);
            _pmn_im_bn_set(&mm, 1);
        }
    }
    # k = ⌈log10(v) − 1e-10⌉ from the binary exponent: never too large, at most one too small
    # (the fixup below adds the one).
    var lg: f64 = f64_from(e + _pmn_im_bitlen(f) - 1);
    var est: f64 = lg * 0.30102999566398114 - 0.0000000001;
    var k = f64_to(f64_ceil(est));
    if (k >= 0) {
        _pmn_im_bn_mul_pow10(&s, k);
    } else {
        _pmn_im_bn_mul_pow10(&r, 0 - k);
        _pmn_im_bn_mul_pow10(&mp, 0 - k);
        _pmn_im_bn_mul_pow10(&mm, 0 - k);
    }
    _pmn_im_bn_sum(&t, &r, &mp);
    var c = _pmn_im_bn_cmp(&t, &s);
    if ((even == 1 && c >= 0) || (even == 0 && c > 0)) {
        _pmn_im_bn_mul_small(&s, 10);
        k = k + 1;
    }
    var n = 0;
    while (1) {
        _pmn_im_bn_mul_small(&r, 10);
        _pmn_im_bn_mul_small(&mp, 10);
        _pmn_im_bn_mul_small(&mm, 10);
        var d = 0;
        while (_pmn_im_bn_cmp(&r, &s) >= 0) {
            _pmn_im_bn_sub(&r, &s);
            d = d + 1;
        }
        var lo = _pmn_im_bn_cmp(&r, &mm);
        var tc1 = 0;
        if (lo < 0 || (even == 1 && lo == 0)) { tc1 = 1; }
        _pmn_im_bn_sum(&t, &r, &mp);
        var hi = _pmn_im_bn_cmp(&t, &s);
        var tc2 = 0;
        if (hi > 0 || (even == 1 && hi == 0)) { tc2 = 1; }
        if (tc1 == 0 && tc2 == 0) {
            store8(digits + n, 48 + d);
            n = n + 1;
        } else {
            if (tc1 == 1 && tc2 == 1) {
                # Both neighbours read back: the closer one, 2r against s; a tie per `tie_even`.
                _pmn_im_bn_copy(&t, &r);
                _pmn_im_bn_shl(&t, 1);
                var half = _pmn_im_bn_cmp(&t, &s);
                if (half > 0) { d = d + 1; }
                if (half == 0 && (tie_even == 0 || (d & 1) == 1)) { d = d + 1; }
            } elif (tc2 == 1) {
                d = d + 1;
            }
            store8(digits + n, 48 + d);
            n = n + 1;
            return (n, k);
        }
    }
    return (n, k);
}

# Appends `count` copies of byte c.
fn _pmn_im_sb_repeat(sb, c, count) {
    for (var i = 0; i < count; i = i + 1) { str_builder_putc(sb, c); }
    return 0;
}

# Appends digits [from, to) of `digits`.
fn _pmn_im_sb_digits(sb, digits, from, to) {
    for (var i = from; i < to; i = i + 1) { str_builder_putc(sb, load8(digits + i)); }
    return 0;
}

# Appends 0.d1…dn × 10^k positionally: "123.45", "0.00012", "12300". With `int_suffix` 1, an integer
# gets ".0" (serde_json's form).
fn _pmn_im_sb_positional(sb, digits, n, k, int_suffix) {
    if (k <= 0) {
        str_builder_putc(sb, 48);
        str_builder_putc(sb, 46);
        _pmn_im_sb_repeat(sb, 48, 0 - k);
        _pmn_im_sb_digits(sb, digits, 0, n);
        return 0;
    }
    if (k >= n) {
        _pmn_im_sb_digits(sb, digits, 0, n);
        _pmn_im_sb_repeat(sb, 48, k - n);
        if (int_suffix == 1) {
            str_builder_putc(sb, 46);
            str_builder_putc(sb, 48);
        }
        return 0;
    }
    _pmn_im_sb_digits(sb, digits, 0, k);
    str_builder_putc(sb, 46);
    _pmn_im_sb_digits(sb, digits, k, n);
    return 0;
}

# The number of non-finite values _pmn_fmt_f64_json has written as `null`, as serde_json does. A caller that must not
# lose one (the snapshot's JSON form, ADR 0013) zeroes it, writes, and checks it.
var _pmn_im_json_nonfinite = 0;

# Appends x as serde_json 1.0.154 writes an f64 (zmij's format). Mirrors `serde_json::to_string(&x)`.
fn _pmn_fmt_f64_json(sb, x: f64) {
    var bits = _pmn_im_bits(x);
    var mag = bits & 0x7FFFFFFFFFFFFFFF;
    if (mag >= 0x7FF0000000000000) {
        _pmn_im_json_nonfinite = _pmn_im_json_nonfinite + 1;
        str_builder_add_cstr(sb, "null");
        return 0;
    }
    if (bits < 0) { str_builder_putc(sb, 45); }
    if (mag == 0) {
        str_builder_add_cstr(sb, "0.0");
        return 0;
    }
    var digits[24];
    var n, k = _pmn_im_shortest(mag, &digits, 1);
    var ex = k - 1;
    if (ex >= 0 - 5 && ex <= 15) {
        _pmn_im_sb_positional(sb, &digits, n, k, 1);
        return 0;
    }
    str_builder_putc(sb, load8(&digits));
    if (n > 1) {
        str_builder_putc(sb, 46);
        _pmn_im_sb_digits(sb, &digits, 1, n);
    }
    str_builder_putc(sb, 101);
    if (ex >= 0) {
        str_builder_putc(sb, 43);
        str_builder_add_int(sb, ex);
    } else {
        str_builder_putc(sb, 45);
        str_builder_add_int(sb, 0 - ex);
    }
    return 0;
}

# --- pool.cyr ---

# pool.cyr — the work-table pool: scratch memory that leaves the heap where it found it (port plan D11, §8.5;
# kimiya ADR 0007; probe P4).
#
# A function that needs scratch claims it here and gives it back on every return path, so nothing it needed for a
# while stays on the heap:
# - **Eight slots,** each a buffer the pool keeps for the process's lifetime, claimed by compare-and-swap, so
#   concurrent callers never share one. A free slot already big enough is taken first. Otherwise a free slot grows on
#   the freelist (to at least twice its size) and frees the buffer it outgrew: unlike kimiya's, whose slots grow on the
#   bump heap and keep every outgrown buffer. A slot grows only while it is too small, so no slot exceeds twice the
#   largest claim, however the claims race.
# - **Past the eighth** concurrent claim, the claim is a freelist block of its own, freed on release (kimiya takes it
#   from the bump heap). So is any claim over 1 MiB: a slot keeps its buffer for the process's lifetime, and a JSON
#   document's arena is up to 88 times the text (part d3), so a slot never holds more than 2 MiB.
# - **The bump allocator** turns a claim into a stdlib Allocator (bayan's `_a` calls take one), with its vtable
#   (_PMN_BUMP_ALLOCATOR_SIZE bytes) and state (_PMN_BUMP_STATE_SIZE) in the caller's storage: `allocator_new` would
#   take 40 bytes of the bump heap per use. It counts the allocations it refused, so a caller can tell an exhausted
#   claim from a failure of its own.
# Probe P4 drove every convention in loops of 10^3 … 10^6 and found the bump heap, the freelist and the process's
# mapped size unchanged (port-parity §6.2). The pool's own buffers are the one thing kept: at most eight, each at its
# high-water mark. tests/pool.tcyr checks the claims, the growth, the overflow and the allocator, and
# tests/pool_threads.tcyr the same under four racing threads; the parity harness fails a module that leaves a slot
# claimed.

const _PMN_POOL_SLOTS = 8;
const _PMN_POOL_OVERFLOW = -2;
const _PMN_POOL_SLOT_MAX = 1048576;
const _PMN_BUMP_ALLOCATOR_SIZE = 40;
const _PMN_BUMP_STATE_SIZE = 32;

var _pmn_pool_busy: i64[_PMN_POOL_SLOTS];
var _pmn_pool_ptr: i64[_PMN_POOL_SLOTS];
var _pmn_pool_cap: i64[_PMN_POOL_SLOTS];

# Claims `bytes` of scratch: (buffer, slot). Give it back with `_pmn_scratch_give(buffer, slot)` on every return
# path. (0, −1) when the memory can't be had (or bytes ≤ 0); nothing is then claimed.
#must_use
fn _pmn_scratch_take(bytes): (i64, i64) {
    if (bytes <= 0) { return (0, 0 - 1); }
    var i = 0;
    if (bytes > _PMN_POOL_SLOT_MAX) { i = _PMN_POOL_SLOTS; }   # past the cap: straight to a block of its own
    while (i < _PMN_POOL_SLOTS) {
        if (load64(&_pmn_pool_busy + 8 * i) == 0 && load64(&_pmn_pool_cap + 8 * i) >= bytes) {
            if (atomic_cas(&_pmn_pool_busy + 8 * i, 0, 1) == 1) { return (load64(&_pmn_pool_ptr + 8 * i), i); }
        }
        i = i + 1;
    }
    if (bytes <= _PMN_POOL_SLOT_MAX) { i = 0; }
    while (i < _PMN_POOL_SLOTS) {
        if (load64(&_pmn_pool_busy + 8 * i) == 0) {
            if (atomic_cas(&_pmn_pool_busy + 8 * i, 0, 1) == 1) {
                # A slot busy during the first scan may have been released since, already big enough. Growing it
                # anyway would double a slot on every such race, without bound (tests/pool_threads.tcyr found
                # capacities of 64 GB before the check, which kimiya's _km_scratch_grow has).
                var cap = load64(&_pmn_pool_cap + 8 * i);
                if (cap >= bytes) { return (load64(&_pmn_pool_ptr + 8 * i), i); }
                var want = 2 * cap;
                if (want < bytes) { want = bytes; }
                var q = fl_alloc(want);
                if (q == 0 && want > bytes) {
                    want = bytes;                   # twice the slot can't be had: the claim alone, as kimiya does
                    q = fl_alloc(want);
                }
                if (q == 0) {
                    _pmn_scratch_give(0, i);
                    return (0, 0 - 1);
                }
                var old = load64(&_pmn_pool_ptr + 8 * i);
                if (old != 0) { fl_free(old); }
                store64(&_pmn_pool_ptr + 8 * i, q);
                store64(&_pmn_pool_cap + 8 * i, want);
                return (q, i);
            }
        }
        i = i + 1;
    }
    var o = fl_alloc(bytes);
    if (o == 0) { return (0, 0 - 1); }
    return (o, _PMN_POOL_OVERFLOW);
}

# Gives back what `_pmn_scratch_take` handed out. A slot of −1 (a failed claim) is a no-op. The release is a
# compare-and-swap 1 → 0: the stdlib's CAS orders as acquire-release on both arches (x86 `lock cmpxchg`, aarch64
# `stlxr`), so the caller's writes to the buffer are visible before the slot reads free. That is half the cost of a
# full fence and a plain store (18 ns of 36 per claim, measured with tests/pool.bcyr's first row).
fn _pmn_scratch_give(p, slot): i64 {
    if (slot == _PMN_POOL_OVERFLOW) {
        if (p != 0) { fl_free(p); }
        return 0;
    }
    if (slot < 0 || slot >= _PMN_POOL_SLOTS) { return 0; }
    atomic_cas(&_pmn_pool_busy + 8 * slot, 1, 0);
    return 0;
}

# The number of slots claimed now: 0 between calls (the parity harness checks it after every module).
#must_use
fn _pmn_scratch_claimed(): i64 {
    var c = 0;
    var i = 0;
    while (i < _PMN_POOL_SLOTS) {
        c = c + load64(&_pmn_pool_busy + 8 * i);
        i = i + 1;
    }
    return c;
}

# The bytes the slots hold for the process.
#must_use
fn _pmn_scratch_bytes(): i64 {
    var bytes = 0;
    var i = 0;
    while (i < _PMN_POOL_SLOTS) {
        bytes = bytes + load64(&_pmn_pool_cap + 8 * i);
        i = i + 1;
    }
    return bytes;
}

# ── a bump allocator over a claim ──────────────────────────────────────────────────────────────────
# State (_PMN_BUMP_STATE_SIZE bytes, the caller's): the next free byte, the end, the start, and the count of refused
# allocations. Allocations are 8-byte aligned; an allocation that doesn't fit returns 0 and is counted, and the claim
# stays as it was (the caller retries with a bigger claim).

#must_use
fn _pmn_bump_alloc(st, size): i64 {
    if (size < 0) { return 0; }
    var cur = load64(st);
    var n = (size + 7) & (0 - 8);
    if (n > load64(st + 8) - cur) {
        store64(st + 24, load64(st + 24) + 1);
        return 0;
    }
    store64(st, cur + n);
    return cur;
}

#must_use
fn _pmn_bump_realloc(st, old, old_size, new_size): i64 {
    var q = _pmn_bump_alloc(st, new_size);
    if (q == 0) { return 0; }
    if (old != 0) {
        var n = old_size;
        if (new_size < n) { n = new_size; }
        memcpy(q, old, n);
    }
    return q;
}

fn _pmn_bump_free(st, p): i64 {
    return 0;
}

fn _pmn_bump_reset(st): i64 {
    store64(st, load64(st + 16));
    return 0;
}

# Makes `a` (_PMN_BUMP_ALLOCATOR_SIZE bytes, the caller's) an Allocator that bump-allocates in [buf, buf + cap), with
# its state at `st` (_PMN_BUMP_STATE_SIZE bytes, the caller's). Returns a. Nothing is allocated, and nothing needs
# releasing but the claim itself.
fn _pmn_bump_allocator(a, st, buf, cap): i64 {
    store64(st, buf);
    store64(st + 8, buf + cap);
    store64(st + 16, buf);
    store64(st + 24, 0);
    store64(a, &_pmn_bump_alloc);
    store64(a + 8, &_pmn_bump_realloc);
    store64(a + 16, &_pmn_bump_free);
    store64(a + 24, &_pmn_bump_reset);
    store64(a + 32, st);
    return a;
}

# The bytes the bump allocator at `st` has handed out.
#must_use
fn _pmn_bump_used(st): i64 {
    return load64(st) - load64(st + 16);
}

# The allocations the bump allocator at `st` has refused since it was made.
#must_use
fn _pmn_bump_refused(st): i64 {
    return load64(st + 24);
}

# --- json.cyr ---

# json.cyr — JSON as serde_json 1.0.154 reads and writes it (port plan D5, §8.3 and §8.5; ADR 007 rows 7, 8 and 16).
#
# **Reading** (M1 parts d3a and d3b). A type's decoder reads a document the way 1.3.0's serde derive and its
# `try_from` validation did:
# 1. **The pre-pass** (`_pmn_json_lift`) rewrites the text so that bayan's tree reads every number as serde_json does,
#    and refuses a raw control byte in a string, as serde_json does anywhere (probe P7, port-parity §6.3).
# 2. **The tree.** bayan parses the rewritten text into an arena: a bump allocator over a work-table pool claim (part
#    d2). The claim starts at 24 times the text and doubles while bayan runs out; a tree is at most 88 times its text
#    (an empty container costs 176 bytes for its 2), so the doubling stops by 128 times. Nothing of a document
#    outlives `_pmn_json_close`, and `_pmn_json_decode` closes on every path.
# 3. **The readers** take values from the tree with serde's rules for each Rust type (§8.3):
#    - an f64: any JSON number, refusing one past f64's range (serde_json's "number out of range");
#    - a u64 or usize: a JSON integer from 0 to 2^64 − 1; a float refuses, even `1.0` or `-0`;
#    - a bool: `true` or `false`;
#    - a String: a JSON string whose bytes are UTF-8 (serde_json validates a string it reads, not one it skips);
#    - a Vec: a JSON array of the element's form; a Vec<Vec<f64>> may be ragged, which its type then judges;
#    - `null` is none of them (1.3.0 has no Option field);
#    - a struct: serde derive's rules (`_pmn_json_struct`);
#    - an enum: externally tagged, a unit variant (`_pmn_json_unit_variant`) or a newtype variant
#      (`_pmn_json_newtype_variant`), the only two forms 1.3.0's enums take.
# A decoder reads every field before it judges any: serde reports a malformed field before the type's `try_from`
# sees a value, so a document with both faults is PMN_ERR_DESERIALIZE, not the constructor's code.
#
# Every serde_json refusal is PMN_ERR_DESERIALIZE (D6). Memory that can't be had is PMN_ERR_OUT_OF_MEMORY, and a
# caller's own bad argument (a null buffer, one too small) is PMN_ERR_INVALID_PARAMETER.
#
# **Writing** (M1 part d4). A type's encoder appends serde_json's compact text to the caller's str_builder, byte for
# byte (ADR 007 row 7): f64s through src/fmtf.cyr's serde_json form (`null` for NaN and ±∞), integers in decimal,
# strings with serde_json's escapes, `[a,b]`, `{"name":value}` in field order, `"Name"` for a unit variant and
# `{"Name":value}` for a newtype variant. A writer returns PMN_ERR_NONE, or PMN_ERR_OUT_OF_MEMORY when the builder
# can't grow (its text is then incomplete). It grows the builder through `default_alloc()`, which never frees an
# outgrown buffer, so reuse one cleared builder for repeated writes.
#
# **The error codec** (part d4; ADR 007 row 8, amended): `pmn_err_to_json` writes a code as 1.3.0's PramanaError with
# an empty message, and `pmn_err_from_json` reads one back to its code, dropping the message.
# UPSTREAM(L7): cyrius:docs/development/issues/2026-11-11-derive-json-no-vector-array-or-tagged-variant-shapes.md
#   the hand readers here and the codecs on them give way to #derive(Deserialize) once it can validate and read
#   matrices and u64s; parity: every JSON row
# UPSTREAM(L11): bayan:docs/development/issues/2026-11-09-json-integer-above-i64-max-refuses-the-document.md
#   (with -0 and raw control bytes, ledger §10) the pre-pass goes once bayan's tree has a u64 node, a signed zero
#   and strict strings; parity: tests/golden/json.tsv
# UPSTREAM(L13): cyrius:docs/development/issues/2026-11-11-vec-keeps-outgrown-buffer-and-aborts.md
#   the document-size guard in _pmn_json_open goes once vec_push_a returns -1 past VEC_CAP_MAX; parity: the json
#   rows
# UPSTREAM(L14): cyrius:docs/development/issues/2026-11-13-str-builder-grow-never-frees-the-outgrown-buffer.md
#   (pramana's section) the reservations before fmtf's printer and str_builder_add_json_str go once both have
#   non-aborting forms; parity: the json::write rows

# A document's state, in the caller's storage: the root node, the arena and its pool slot (24 bytes), the arena's
# Allocator (40) and its bump state (32).
const _PMN_JSON_DOC_SIZE = 96;

# The arena starts at this many bytes per byte of rewritten text, plus _PMN_JSON_ARENA_PAD, and doubles up to
# _PMN_JSON_ARENA_LIMIT per byte (plus 64 KiB).
const _PMN_JSON_ARENA_FACTOR = 24;
const _PMN_JSON_ARENA_PAD = 4096;
const _PMN_JSON_ARENA_LIMIT = 128;

# ── 1. the pre-pass ─────────────────────────────────────────────────────────────────────────────

# 1 when the n digits at p (no leading zero) are at most the decimal `bound`'s.
#must_use
fn _pmn_json_digits_le(p, n, bound: cstring): i64 {
    var bn = strlen(bound);
    if (n < bn) { return 1; }
    if (n > bn) { return 0; }
    var i = 0;
    while (i < n) {
        var a = load8(p + i);
        var b = load8(bound + i);
        if (a < b) { return 1; }
        if (a > b) { return 0; }
        i = i + 1;
    }
    return 1;
}

# STAND-IN (ledger L11) for three gaps in bayan's tree: it refuses an integer at or above 2^63, reads `-0` as +0, and
# accepts a raw control byte in a string. Rewrites src[0, n) into dst[0, cap):
# - a negative integer, `-0` included, becomes a float (`-1.0`, `-0.0`): serde_json reads `-0` as −0.0, refuses any
#   negative for a u64, and reads the same value for an f64;
# - an integer in 2^63 … 2^64 − 1 becomes the negative integer with its bits, −(2^64 − v), which nothing else now
#   yields, so a u64 reader takes it back exactly and an f64 reader rounds it as unsigned;
# - a larger integer becomes a float, which an f64 reader takes correctly rounded and a u64 reader refuses;
# - a raw byte below 0x20 in a string refuses the document. UTF-8 is not checked here: serde_json checks a string it
#   reads and skips one it ignores, so the readers check theirs.
# Anything else is copied as it is, for bayan to judge. Returns the new length, −1 for a refusal, or −2 when cap is
# below 2n + 32. That bound always suffices, so it is checked once: a number grows by at most 2 bytes, and every
# number but the last is followed by a byte that is no number's, so the text grows to at most 2n + 1.
#must_use
fn _pmn_json_lift(src, n, dst, cap): i64 {
    if (n < 0 || cap < 2 * n + 32) { return 0 - 2; }
    var i = 0;
    var o = 0;
    while (i < n) {
        var c = load8(src + i);
        if (c == 34) {
            store8(dst + o, c);
            o = o + 1;
            i = i + 1;
            while (i < n) {
                var s = load8(src + i);
                if (s < 32) { return 0 - 1; }
                store8(dst + o, s);
                o = o + 1;
                i = i + 1;
                if (s == 34) { break; }
                if (s == 92 && i < n) {
                    var e = load8(src + i);
                    if (e < 32) { return 0 - 1; }
                    store8(dst + o, e);
                    o = o + 1;
                    i = i + 1;
                }
            }
        } elif (c == 45 || (c >= 48 && c <= 57)) {
            var st = i;
            var neg = 0;
            if (c == 45) {
                neg = 1;
                i = i + 1;
            }
            var ds = i;
            while (i < n) {
                var d = load8(src + i);
                if (d < 48 || d > 57) { break; }
                i = i + 1;
            }
            var de = i;
            var other = 0;
            while (i < n) {
                var x = load8(src + i);
                if ((x < 48 || x > 57) && x != 46 && x != 101 && x != 69 && x != 43 && x != 45) { break; }
                other = 1;
                i = i + 1;
            }
            var len = i - st;
            var nd = de - ds;
            var plain = 1;                       # a well-formed integer: digits only, no leading zero
            if (other == 1 || nd == 0) { plain = 0; }
            if (nd > 1 && load8(src + ds) == 48) { plain = 0; }
            memcpy(dst + o, src + st, len);
            if (plain == 1 && neg == 1) {
                store8(dst + o + len, 46);
                store8(dst + o + len + 1, 48);
                o = o + len + 2;
            } elif (plain == 1 && nd >= 19 && _pmn_json_digits_le(src + ds, nd, "9223372036854775807") == 0) {
                if (_pmn_json_digits_le(src + ds, nd, "18446744073709551615") == 1) {
                    o = o + _pmn_json_neg_complement(src + ds, nd, dst + o);
                } else {
                    store8(dst + o + len, 46);
                    store8(dst + o + len + 1, 48);
                    o = o + len + 2;
                }
            } else {
                o = o + len;
            }
        } else {
            store8(dst + o, c);
            o = o + 1;
            i = i + 1;
        }
    }
    return o;
}

# Writes `-` and the decimal of 2^64 − v at out, for the 19 or 20 digits of v in [2^63, 2^64): the negative integer
# with v's bits, by decimal subtraction (no division). Returns the bytes written.
#must_use
fn _pmn_json_neg_complement(p, nd, out): i64 {
    var t[24];
    var two64 = "18446744073709551616";
    var borrow = 0;
    var k = 19;
    while (k >= 0) {
        var a = load8(two64 + k) - 48;
        var b = 0;
        var at = k - (20 - nd);
        if (at >= 0) { b = load8(p + at) - 48; }
        var d = a - b - borrow;
        borrow = 0;
        if (d < 0) {
            d = d + 10;
            borrow = 1;
        }
        store8(&t + k, 48 + d);
        k = k - 1;
    }
    var z = 0;
    while (z < 19 && load8(&t + z) == 48) { z = z + 1; }
    store8(out, 45);
    memcpy(out + 1, &t + z, 20 - z);
    return 21 - z;
}

# ── 2. the document ─────────────────────────────────────────────────────────────────────────────

# Parses text[0, n) into the document `doc` (_PMN_JSON_DOC_SIZE bytes, the caller's): PMN_ERR_NONE with the tree at
# `_pmn_json_root(doc)`, or an error code with nothing held. Close it with `_pmn_json_close(doc)` either way.
#must_use
fn _pmn_json_open(doc, text, n): i64 {
    if (doc == 0) { return PMN_ERR_INVALID_PARAMETER; }
    store64(doc, 0);
    store64(doc + 8, 0);
    store64(doc + 16, 0 - 1);
    if (n < 0 || (text == 0 && n > 0)) { return PMN_ERR_INVALID_PARAMETER; }
    # STAND-IN (ledger L13): vec_push_a aborts the process past VEC_CAP_MAX elements, and an array holds at most
    # (n + 1) / 2. A longer document (512 MiB at the default cap) is memory pramana won't ask bayan for.
    if (n > 2 * VEC_CAP_MAX - 1) { return PMN_ERR_OUT_OF_MEMORY; }
    var lcap = 2 * n + 32;
    var lb, ls = _pmn_scratch_take(lcap);
    if (lb == 0) { return PMN_ERR_OUT_OF_MEMORY; }
    var m = _pmn_json_lift(text, n, lb, lcap);
    if (m < 0) {
        _pmn_scratch_give(lb, ls);
        if (m == 0 - 1) { return PMN_ERR_DESERIALIZE; }
        return PMN_ERR_OUT_OF_MEMORY;
    }
    var cap = _PMN_JSON_ARENA_FACTOR * m + _PMN_JSON_ARENA_PAD;
    var limit = _PMN_JSON_ARENA_LIMIT * m + 65536;
    var ps[_JP_STATE_SIZE];
    while (1 == 1) {
        var ab, asl = _pmn_scratch_take(cap);
        if (ab == 0) {
            _pmn_scratch_give(lb, ls);
            return PMN_ERR_OUT_OF_MEMORY;
        }
        _pmn_bump_allocator(doc + 24, doc + 64, ab, cap);
        var v = bayan_json_v_parse_ctx_a(doc + 24, &ps, lb, m);
        if (v != 0) {
            _pmn_scratch_give(lb, ls);            # the tree holds copies: nothing points into the text
            store64(doc, v);
            store64(doc + 8, ab);
            store64(doc + 16, asl);
            return PMN_ERR_NONE;
        }
        var refused = _pmn_bump_refused(doc + 64);
        _pmn_scratch_give(ab, asl);
        if (refused == 0) {
            _pmn_scratch_give(lb, ls);
            return PMN_ERR_DESERIALIZE;
        }
        if (cap >= limit) {
            _pmn_scratch_give(lb, ls);
            return PMN_ERR_OUT_OF_MEMORY;
        }
        cap = 2 * cap;
    }
    return PMN_ERR_OUT_OF_MEMORY;
}

# The root node of an open document, or 0.
#must_use
fn _pmn_json_root(doc): i64 {
    if (doc == 0) { return 0; }
    return load64(doc);
}

# Releases what an open document holds. Safe after a failed open, and twice.
fn _pmn_json_close(doc): i64 {
    if (doc == 0) { return 0; }
    var slot = load64(doc + 16);
    if (slot != 0 - 1) { _pmn_scratch_give(load64(doc + 8), slot); }
    store64(doc, 0);
    store64(doc + 8, 0);
    store64(doc + 16, 0 - 1);
    return 0;
}

# Decodes text[0, n): opens it, calls `fp(root, ctx)` (a decoder returning an error code), and closes it on every
# path. Returns the open's error or the decoder's.
#must_use
fn _pmn_json_decode(text, n, fp, ctx): i64 {
    if (fp == 0) { return PMN_ERR_INVALID_PARAMETER; }
    var doc[_PMN_JSON_DOC_SIZE];
    var e = _pmn_json_open(&doc, text, n);
    if (e != PMN_ERR_NONE) {
        _pmn_json_close(&doc);
        return e;
    }
    var r = fncall2(fp, _pmn_json_root(&doc), ctx);
    _pmn_json_close(&doc);
    return r;
}

# ── 3. the readers ──────────────────────────────────────────────────────────────────────────────

# An f64 field: any JSON number into out (its bits). An integer converts as Rust's `as f64` does: the pre-pass leaves
# only u64 bit patterns, so a negative word is its value plus 2^64.
#must_use
fn _pmn_json_f64(v, out): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    if (v == 0) { return PMN_ERR_DESERIALIZE; }
    var t = bayan_json_v_tag(v);
    if (t == JTAG_FLOAT) {
        var b = bayan_json_v_float(v);
        if (((b >> 52) & 0x7FF) == 0x7FF) { return PMN_ERR_DESERIALIZE; }   # serde_json's "number out of range"
        store64(out, b);
        return PMN_ERR_NONE;
    }
    if (t == JTAG_INT) {
        var x: f64 = _pmn_u64_to_f64(bayan_json_v_int(v));
        store64(out, x);
        return PMN_ERR_NONE;
    }
    return PMN_ERR_DESERIALIZE;
}

# A u64 or usize field: a JSON integer from 0 to 2^64 − 1, into out (the word).
#must_use
fn _pmn_json_u64(v, out): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    if (v == 0 || bayan_json_v_tag(v) != JTAG_INT) { return PMN_ERR_DESERIALIZE; }
    store64(out, bayan_json_v_int(v));
    return PMN_ERR_NONE;
}

# A bool field into out (1 or 0).
#must_use
fn _pmn_json_bool(v, out): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    if (v == 0 || bayan_json_v_tag(v) != JTAG_BOOL) { return PMN_ERR_DESERIALIZE; }
    store64(out, bayan_json_v_bool(v));
    return PMN_ERR_NONE;
}

# 1 when the next k bytes after p[i] are continuation bytes, the first in [lo, hi].
#must_use
fn _pmn_json_utf8_cont(p, i, n, k, lo, hi): i64 {
    if (i + k >= n) { return 0; }
    var c1 = load8(p + i + 1);
    if (c1 < lo || c1 > hi) { return 0; }
    var j = 2;
    while (j <= k) {
        var c = load8(p + i + j);
        if (c < 0x80 || c > 0xBF) { return 0; }
        j = j + 1;
    }
    return 1;
}

# 1 when p[0, n) is UTF-8: no overlong form, no surrogate, nothing past U+10FFFF (Rust's `str::from_utf8`).
#must_use
fn _pmn_json_utf8(p, n): i64 {
    var i = 0;
    while (i < n) {
        var c = load8(p + i);
        var k = 0 - 1;
        var lo = 0x80;
        var hi = 0xBF;
        if (c < 0x80) {
            k = 0;
        } elif (c >= 0xC2 && c <= 0xDF) {
            k = 1;
        } elif (c == 0xE0) {
            k = 2;
            lo = 0xA0;
        } elif ((c >= 0xE1 && c <= 0xEC) || c == 0xEE || c == 0xEF) {
            k = 2;
        } elif (c == 0xED) {
            k = 2;
            hi = 0x9F;
        } elif (c == 0xF0) {
            k = 3;
            lo = 0x90;
        } elif (c >= 0xF1 && c <= 0xF3) {
            k = 3;
        } elif (c == 0xF4) {
            k = 3;
            hi = 0x8F;
        }
        if (k < 0) { return 0; }
        if (k > 0 && _pmn_json_utf8_cont(p, i, n, k, lo, hi) == 0) { return 0; }
        i = i + k + 1;
    }
    return 1;
}

# A String field: out gets the decoded bytes' pointer and their length (16 bytes). The bytes belong to the document's
# arena: copy them before `_pmn_json_close`.
#must_use
fn _pmn_json_str(v, out): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    if (v == 0 || bayan_json_v_tag(v) != JTAG_STR) { return PMN_ERR_DESERIALIZE; }
    var s = bayan_json_v_str(v);
    var p = str_data(s);
    var n = str_len(s);
    if (_pmn_json_utf8(p, n) == 0) { return PMN_ERR_DESERIALIZE; }
    store64(out, p);
    store64(out + 8, n);
    return PMN_ERR_NONE;
}

# An array's length, or −1 when v is no array.
#must_use
fn _pmn_json_arr_len(v): i64 {
    if (v == 0 || bayan_json_v_tag(v) != JTAG_ARR) { return 0 - 1; }
    return bayan_json_v_arr_len(v);
}

# An array's element i, or 0 out of range.
#must_use
fn _pmn_json_arr_get(v, i): i64 {
    return bayan_json_v_arr_get(v, i);
}

# A Vec<f64> field into out[0, len), where cap ≥ len = `_pmn_json_arr_len(v)`.
#must_use
fn _pmn_json_vec_f64(v, out, cap): i64 {
    var n = _pmn_json_arr_len(v);
    if (n < 0) { return PMN_ERR_DESERIALIZE; }
    if (n > cap || (out == 0 && n > 0)) { return PMN_ERR_INVALID_PARAMETER; }
    var i = 0;
    while (i < n) {
        var e = _pmn_json_f64(bayan_json_v_arr_get(v, i), out + i * 8);
        if (e != PMN_ERR_NONE) { return e; }
        i = i + 1;
    }
    return PMN_ERR_NONE;
}

# A Vec<u64> or Vec<usize> field into out[0, len), where cap ≥ len = `_pmn_json_arr_len(v)`.
#must_use
fn _pmn_json_vec_u64(v, out, cap): i64 {
    var n = _pmn_json_arr_len(v);
    if (n < 0) { return PMN_ERR_DESERIALIZE; }
    if (n > cap || (out == 0 && n > 0)) { return PMN_ERR_INVALID_PARAMETER; }
    var i = 0;
    while (i < n) {
        var e = _pmn_json_u64(bayan_json_v_arr_get(v, i), out + i * 8);
        if (e != PMN_ERR_NONE) { return e; }
        i = i + 1;
    }
    return PMN_ERR_NONE;
}

# A Vec<Vec<f64>> field's shape, once every element is known to be an f64 (serde reads the whole matrix before the
# type's constructor judges its shape): shape[0] the rows, shape[1] the first row's length (0 for no rows), shape[2]
# 1 when some row's length differs from the first's (24 bytes, the caller's). Each row's length is
# `_pmn_json_arr_len(_pmn_json_arr_get(v, i))`.
#must_use
fn _pmn_json_mat_shape(v, shape): i64 {
    if (shape == 0) { return PMN_ERR_INVALID_PARAMETER; }
    var r = _pmn_json_arr_len(v);
    if (r < 0) { return PMN_ERR_DESERIALIZE; }
    var c0 = 0;
    var ragged = 0;
    var x[8];
    var i = 0;
    while (i < r) {
        var row = bayan_json_v_arr_get(v, i);
        var c = _pmn_json_arr_len(row);
        if (c < 0) { return PMN_ERR_DESERIALIZE; }
        var j = 0;
        while (j < c) {
            if (_pmn_json_f64(bayan_json_v_arr_get(row, j), &x) != PMN_ERR_NONE) { return PMN_ERR_DESERIALIZE; }
            j = j + 1;
        }
        if (i == 0) {
            c0 = c;
        } elif (c != c0) {
            ragged = 1;
        }
        i = i + 1;
    }
    store64(shape, r);
    store64(shape + 8, c0);
    store64(shape + 16, ragged);
    return PMN_ERR_NONE;
}

# A rows × cols Vec<Vec<f64>> field into out, row-major (rows · cols f64s). PMN_ERR_INVALID_PARAMETER when the
# matrix has another shape: read `_pmn_json_mat_shape` first.
#must_use
fn _pmn_json_mat_f64(v, out, rows, cols): i64 {
    if (_pmn_json_arr_len(v) != rows || rows < 0 || cols < 0) { return PMN_ERR_INVALID_PARAMETER; }
    if (out == 0 && rows > 0 && cols > 0) { return PMN_ERR_INVALID_PARAMETER; }
    var i = 0;
    while (i < rows) {
        var row = bayan_json_v_arr_get(v, i);
        if (_pmn_json_arr_len(row) != cols) { return PMN_ERR_INVALID_PARAMETER; }
        var e = _pmn_json_vec_f64(row, out + i * cols * 8, cols);
        if (e != PMN_ERR_NONE) { return e; }
        i = i + 1;
    }
    return PMN_ERR_NONE;
}

# The index of the decoded key `key` (a Str) among the C strings names[0, n), or −1. Bytes compare exactly, as serde's
# derived identifiers do.
#must_use
fn _pmn_json_name_index(key, names, n): i64 {
    if (key == 0) { return 0 - 1; }
    var p = str_data(key);
    var len = str_len(key);
    var j = 0;
    while (j < n) {
        var name = load64(names + j * 8);
        if (strlen(name) == len && memeq(p, name, len) == 1) { return j; }
        j = j + 1;
    }
    return 0 - 1;
}

# A struct, by serde derive's rules: slots[0, nf) get the nodes of the fields named names[0, nf) (C strings, in
# declaration order).
# - **The map form,** a JSON object: each member whose key is a field's name fills that field's slot; an unknown
#   member is skipped, unread; a field named twice refuses, and so does one never named. Every key must be UTF-8:
#   serde_json parses a struct's keys as strings, the unknown ones too.
# - **The sequence form,** a JSON array of exactly nf values, in field order.
# Anything else refuses. The fields' values are the caller's to read.
#must_use
fn _pmn_json_struct(v, names, nf, slots): i64 {
    if (names == 0 || slots == 0 || nf <= 0) { return PMN_ERR_INVALID_PARAMETER; }
    var i = 0;
    while (i < nf) {
        store64(slots + i * 8, 0);
        i = i + 1;
    }
    if (v == 0) { return PMN_ERR_DESERIALIZE; }
    var t = bayan_json_v_tag(v);
    if (t == JTAG_ARR) {
        if (bayan_json_v_arr_len(v) != nf) { return PMN_ERR_DESERIALIZE; }
        i = 0;
        while (i < nf) {
            store64(slots + i * 8, bayan_json_v_arr_get(v, i));
            i = i + 1;
        }
        return PMN_ERR_NONE;
    }
    if (t != JTAG_OBJ) { return PMN_ERR_DESERIALIZE; }
    var m = bayan_json_v_obj_len(v);
    var k = 0;
    while (k < m) {
        var key = bayan_json_v_obj_key(v, k);
        if (key == 0 || _pmn_json_utf8(str_data(key), str_len(key)) == 0) { return PMN_ERR_DESERIALIZE; }
        var j = _pmn_json_name_index(key, names, nf);
        if (j >= 0) {
            if (load64(slots + j * 8) != 0) { return PMN_ERR_DESERIALIZE; }   # bayan refuses it first, today
            store64(slots + j * 8, bayan_json_v_obj_val(v, k));
        }
        k = k + 1;
    }
    i = 0;
    while (i < nf) {
        if (load64(slots + i * 8) == 0) { return PMN_ERR_DESERIALIZE; }
        i = i + 1;
    }
    return PMN_ERR_NONE;
}

# An enum's unit variant, externally tagged: the string "Name", or the one-member object {"Name": null}. out gets the
# variant's index among names[0, n). A variant index, another case, or a second member refuses.
#must_use
fn _pmn_json_unit_variant(v, names, n, out): i64 {
    if (names == 0 || out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    if (v == 0) { return PMN_ERR_DESERIALIZE; }
    var t = bayan_json_v_tag(v);
    var key = 0;
    if (t == JTAG_STR) {
        key = bayan_json_v_str(v);
    } elif (t == JTAG_OBJ) {
        if (bayan_json_v_obj_len(v) != 1) { return PMN_ERR_DESERIALIZE; }
        if (bayan_json_v_tag(bayan_json_v_obj_val(v, 0)) != JTAG_NULL) { return PMN_ERR_DESERIALIZE; }
        key = bayan_json_v_obj_key(v, 0);
    } else {
        return PMN_ERR_DESERIALIZE;
    }
    var j = _pmn_json_name_index(key, names, n);
    if (j < 0) { return PMN_ERR_DESERIALIZE; }
    store64(out, j);
    return PMN_ERR_NONE;
}

# An enum's newtype variant, externally tagged: the one-member object {"Name": value}. out gets the variant's index
# among names[0, n), then the value's node, for the caller to read (16 bytes). The bare string "Name" refuses: serde
# reads it as a unit variant.
#must_use
fn _pmn_json_newtype_variant(v, names, n, out): i64 {
    if (names == 0 || out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    if (v == 0 || bayan_json_v_tag(v) != JTAG_OBJ || bayan_json_v_obj_len(v) != 1) { return PMN_ERR_DESERIALIZE; }
    var j = _pmn_json_name_index(bayan_json_v_obj_key(v, 0), names, n);
    if (j < 0) { return PMN_ERR_DESERIALIZE; }
    store64(out, j);
    store64(out + 8, bayan_json_v_obj_val(v, 0));
    return PMN_ERR_NONE;
}

# ── 4. the writers ──────────────────────────────────────────────────────────────────────────────

# STAND-IN (ledger L14): makes room for n more bytes in sb, so that the stdlib writers with no non-aborting form
# (`str_builder_putc`, `_add_cstr`, `_add_int`, `_add_json_str`, which fmtf.cyr's printer and the string writer use)
# never have to grow it: they end the process when a grow fails. PMN_ERR_OUT_OF_MEMORY when the room can't be had.
#must_use
fn _pmn_json_w_reserve(sb, n): i64 {
    if (sb == 0) { return PMN_ERR_INVALID_PARAMETER; }
    if (_sb_grow_a(default_alloc(), sb, n) != 0) { return PMN_ERR_OUT_OF_MEMORY; }
    return PMN_ERR_NONE;
}

# Appends the n bytes at p.
#must_use
fn _pmn_json_w_bytes(sb, p, n): i64 {
    if (sb == 0) { return PMN_ERR_INVALID_PARAMETER; }
    if (n <= 0) { return PMN_ERR_NONE; }
    var t[16];
    store64(&t, p);
    store64(&t + 8, n);
    if (str_builder_add_a(default_alloc(), sb, &t) != 0) { return PMN_ERR_OUT_OF_MEMORY; }
    return PMN_ERR_NONE;
}

# Appends the C string s.
#must_use
fn _pmn_json_w_lit(sb, s: cstring): i64 {
    return _pmn_json_w_bytes(sb, s, strlen(s));
}

# Appends x as serde_json writes an f64: its shortest round-trip digits, or `null` for NaN and ±∞ (at most 24 bytes).
#must_use
fn _pmn_json_w_f64(sb, x: f64): i64 {
    var e = _pmn_json_w_reserve(sb, 32);
    if (e != PMN_ERR_NONE) { return e; }
    _pmn_fmt_f64_json(sb, x);
    return PMN_ERR_NONE;
}

# Appends the word x, read as unsigned, in decimal: a u64 or a usize.
#must_use
fn _pmn_json_w_u64(sb, x): i64 {
    var tmp[24];
    var k = 24;
    var r = x;
    while (k == 24 || r != 0) {
        var q = (r >> 1) / 5;                   # r / 10, unsigned
        k = k - 1;
        store8(&tmp + k, 48 + r - q * 10);
        r = q;
    }
    return _pmn_json_w_bytes(sb, &tmp + k, 24 - k);
}

# Appends `true` or `false`.
#must_use
fn _pmn_json_w_bool(sb, b): i64 {
    if (b != 0) { return _pmn_json_w_lit(sb, "true"); }
    return _pmn_json_w_lit(sb, "false");
}

# Appends the n bytes at p as serde_json writes a string: quoted, `"` and `\` escaped, \b \f \n \r \t named, the other
# bytes below 0x20 as \u00xx in lowercase hex, every other byte as it is (str_builder_add_json_str, which writes
# exactly this, after a reservation of the exact length).
#must_use
fn _pmn_json_w_str(sb, p, n): i64 {
    if (n < 0 || (p == 0 && n > 0)) { return PMN_ERR_INVALID_PARAMETER; }
    var need = 2;
    var i = 0;
    while (i < n) {
        var c = load8(p + i);
        if (c == 34 || c == 92 || c == 8 || c == 9 || c == 10 || c == 12 || c == 13) {
            need = need + 2;
        } elif (c < 32) {
            need = need + 6;
        } else {
            need = need + 1;
        }
        i = i + 1;
    }
    var e = _pmn_json_w_reserve(sb, need);
    if (e != PMN_ERR_NONE) { return e; }
    var t[16];
    store64(&t, p);
    store64(&t + 8, n);
    str_builder_add_json_str(sb, &t);
    return PMN_ERR_NONE;
}

# Appends the n f64s at p as a JSON array.
#must_use
fn _pmn_json_w_vec_f64(sb, p, n): i64 {
    if (n < 0 || (p == 0 && n > 0)) { return PMN_ERR_INVALID_PARAMETER; }
    var e = _pmn_json_w_lit(sb, "[");
    var i = 0;
    while (e == PMN_ERR_NONE && i < n) {
        if (i > 0) { e = _pmn_json_w_lit(sb, ","); }
        var x: f64 = load64(p + i * 8);
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_f64(sb, x); }
        i = i + 1;
    }
    if (e != PMN_ERR_NONE) { return e; }
    return _pmn_json_w_lit(sb, "]");
}

# Appends the n u64s (or usizes) at p as a JSON array.
#must_use
fn _pmn_json_w_vec_u64(sb, p, n): i64 {
    if (n < 0 || (p == 0 && n > 0)) { return PMN_ERR_INVALID_PARAMETER; }
    var e = _pmn_json_w_lit(sb, "[");
    var i = 0;
    while (e == PMN_ERR_NONE && i < n) {
        if (i > 0) { e = _pmn_json_w_lit(sb, ","); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_u64(sb, load64(p + i * 8)); }
        i = i + 1;
    }
    if (e != PMN_ERR_NONE) { return e; }
    return _pmn_json_w_lit(sb, "]");
}

# Appends the rows × cols f64s at p (row-major) as a Vec<Vec<f64>>: `[[a,b],[c,d]]`, or `[]` for no rows.
#must_use
fn _pmn_json_w_mat_f64(sb, p, rows, cols): i64 {
    if (rows < 0 || cols < 0 || (p == 0 && rows > 0 && cols > 0)) { return PMN_ERR_INVALID_PARAMETER; }
    var e = _pmn_json_w_lit(sb, "[");
    var i = 0;
    while (e == PMN_ERR_NONE && i < rows) {
        if (i > 0) { e = _pmn_json_w_lit(sb, ","); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_vec_f64(sb, p + i * cols * 8, cols); }
        i = i + 1;
    }
    if (e != PMN_ERR_NONE) { return e; }
    return _pmn_json_w_lit(sb, "]");
}

# Opens a struct's member: `{"name":` for the first (first = 1), `,"name":` after. A field name is a plain ASCII
# identifier, written as it is. Close the struct with `_pmn_json_w_lit(sb, "}")`.
#must_use
fn _pmn_json_w_key(sb, name: cstring, first): i64 {
    var e = PMN_ERR_NONE;
    if (first == 1) {
        e = _pmn_json_w_lit(sb, "{\"");
    } else {
        e = _pmn_json_w_lit(sb, ",\"");
    }
    if (e == PMN_ERR_NONE) { e = _pmn_json_w_lit(sb, name); }
    if (e == PMN_ERR_NONE) { e = _pmn_json_w_lit(sb, "\":"); }
    return e;
}

# Appends a unit variant: `"Name"`.
#must_use
fn _pmn_json_w_unit_variant(sb, name: cstring): i64 {
    var e = _pmn_json_w_lit(sb, "\"");
    if (e == PMN_ERR_NONE) { e = _pmn_json_w_lit(sb, name); }
    if (e == PMN_ERR_NONE) { e = _pmn_json_w_lit(sb, "\""); }
    return e;
}

# Opens a newtype variant: `{"Name":`. Append its value, then close it with `_pmn_json_w_lit(sb, "}")`.
#must_use
fn _pmn_json_w_newtype_open(sb, name: cstring): i64 {
    return _pmn_json_w_key(sb, name, 1);
}

# ── 5. the error codec ──────────────────────────────────────────────────────────────────────────

# Writes the code as 1.3.0's PramanaError document with an empty message: `{"InvalidParameter":""}`, which a Rust 1.x
# consumer reads as InvalidParameter(""). PMN_ERR_NONE, or PMN_ERR_OUT_OF_MEMORY when sb can't grow;
# PMN_ERR_INVALID_PARAMETER, writing nothing, for a code 1.3.0 has no variant for: PMN_ERR_NONE, the Cyrius-only
# PMN_ERR_OUT_OF_MEMORY and PMN_ERR_DESERIALIZE, or a value that is no code (ADR 007 row 8, amended 2026-11-15).
#must_use
fn pmn_err_to_json(code, sb): i64 {
    if (sb == 0 || code < PMN_ERR_INVALID_PARAMETER || code > PMN_ERR_COMPUTATION_ERROR) {
        return PMN_ERR_INVALID_PARAMETER;
    }
    var e = _pmn_json_w_newtype_open(sb, pmn_err_name(code));
    if (e == PMN_ERR_NONE) { e = _pmn_json_w_lit(sb, "\"\"}"); }
    return e;
}

# The decoder for pmn_err_from_json: the newtype variant, its message read as serde reads a String, then dropped.
fn _pmn_err_from_root(root, out): i64 {
    var names[40];
    store64(&names, "InvalidParameter");
    store64(&names + 8, "InvalidSample");
    store64(&names + 16, "ConvergenceFailure");
    store64(&names + 24, "DimensionMismatch");
    store64(&names + 32, "ComputationError");
    var w[16];
    var e = _pmn_json_newtype_variant(root, &names, 5, &w);
    if (e != PMN_ERR_NONE) { return e; }
    var msg[16];
    e = _pmn_json_str(load64(&w + 8), &msg);
    if (e != PMN_ERR_NONE) { return e; }
    store64(out, PMN_ERR_INVALID_PARAMETER + load64(&w));   # the variants in 1.3.0's order are the codes 1 … 5
    return PMN_ERR_NONE;
}

# Reads a PramanaError document, buf[0, len), to its code: Ok(PMN_ERR_INVALID_PARAMETER … PMN_ERR_COMPUTATION_ERROR),
# the message read and dropped (ADR 007 row 8). Err(PMN_ERR_DESERIALIZE) for any document serde_json refuses,
# Err(PMN_ERR_OUT_OF_MEMORY) when the tree can't be had.
#must_use
fn pmn_err_from_json(buf, len): Result {
    var code[8];
    var e = _pmn_json_decode(buf, len, &_pmn_err_from_root, &code);
    if (e != PMN_ERR_NONE) { return Err(e); }
    return Ok(load64(&code));
}

# --- debug.cyr ---

# debug.cyr — Rust's derived `Debug`, `{:?}` and `{:#?}`, into a str_builder (port plan D12; M1 part f).
#
# Every public type of 1.3.0 derives Debug, and the port writes its text byte for byte: each type's
# `x.debug(sb, alternate)` (alternate 0 for `{:?}`, 1 for `{:#?}`) returns PMN_ERR_NONE, or PMN_ERR_OUT_OF_MEMORY when
# the builder can't grow. These builders give the two shapes a derive prints, over the JSON writers' non-aborting
# appends (src/json.cyr):
# - a struct: `Name { a: 1, b: 2 }`, or `Name {\n    a: 1,\n    b: 2,\n}`;
# - a tuple (a newtype variant): `Name(x)`, or `Name(\n    x,\n)`.
# M1's types hold integers and strings at one level. A nested value's alternate form indents its own lines, which
# arrives with the first type that nests one (M3 part d2, MultivariateNormal). M3 part a1 adds an f64 field's form,
# `_pmn_dbg_f64`.

# Opens a struct (`braces` 1) or a tuple (0) named `name`.
#must_use
fn _pmn_dbg_open(sb, name: cstring, braces, alternate): i64 {
    var e = _pmn_json_w_lit(sb, name);
    if (e != PMN_ERR_NONE) { return e; }
    if (braces == 1 && alternate == 1) { return _pmn_json_w_lit(sb, " {\n"); }
    if (braces == 1) { return _pmn_json_w_lit(sb, " { "); }
    if (alternate == 1) { return _pmn_json_w_lit(sb, "(\n"); }
    return _pmn_json_w_lit(sb, "(");
}

# Starts an item: a struct field's `name: ` (name 0 for a tuple item), after `, ` unless first; indented in the
# alternate form.
#must_use
fn _pmn_dbg_item(sb, name, first, alternate): i64 {
    var e = PMN_ERR_NONE;
    if (alternate == 1) {
        e = _pmn_json_w_lit(sb, "    ");
    } elif (first == 0) {
        e = _pmn_json_w_lit(sb, ", ");
    }
    if (e == PMN_ERR_NONE && name != 0) {
        e = _pmn_json_w_lit(sb, name);
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_lit(sb, ": "); }
    }
    return e;
}

# Ends an item: `,\n` in the alternate form, nothing otherwise.
#must_use
fn _pmn_dbg_item_end(sb, alternate): i64 {
    if (alternate == 1) { return _pmn_json_w_lit(sb, ",\n"); }
    return PMN_ERR_NONE;
}

# Closes what _pmn_dbg_open opened.
#must_use
fn _pmn_dbg_close(sb, braces, alternate): i64 {
    if (braces == 1 && alternate == 1) { return _pmn_json_w_lit(sb, "}"); }
    if (braces == 1) { return _pmn_json_w_lit(sb, " }"); }
    return _pmn_json_w_lit(sb, ")");
}

# Appends x as Rust's `{:?}` writes an f64 (D12; M3 part a1). The digits are the shortest that read back to x, the
# closest to its exact value among them, and on an exact tie the upper one, as Rust's core printer chooses
# (2^-25 is 2.9802322387695313e-8): impetus's digit core in src/fmtf.cyr with `tie_even` 0. The form is pravash's
# `_pv_debug_f64` (its src/fmtf.cyr, Rust's `<f64 as Debug>::fmt`): positional with at least one fractional digit
# (`1.0`, `0.0001`, `9999999999999998.0`), or exponential for a nonzero |x| below 1e-4 or from 1e16 (`1e16`,
# `9.999999999999999e-5`, `5e-324`), with no `+` in the exponent; `NaN` with no sign, `inf`, `-inf`, and `-0.0`.
# pravash's form sits on its own copy of the digit core (generalized for f32), so it is moved onto impetus's here
# rather than vendored with a second bignum. tests/golden/debug.tsv pins it against Rust's own `{:?}`.
# PMN_ERR_NONE, or PMN_ERR_OUT_OF_MEMORY when sb can't grow.
#must_use
fn _pmn_dbg_f64(sb, x: f64): i64 {
    var e = _pmn_json_w_reserve(sb, 32);
    if (e != PMN_ERR_NONE) { return e; }
    if (x != x) {
        str_builder_add_cstr(sb, "NaN");
        return PMN_ERR_NONE;
    }
    var bits = _pmn_im_bits(x);
    var mag = bits & 0x7FFFFFFFFFFFFFFF;
    if (bits < 0) { str_builder_putc(sb, 45); }
    if (mag == 0x7FF0000000000000) {
        str_builder_add_cstr(sb, "inf");
        return PMN_ERR_NONE;
    }
    if (mag == 0) {
        str_builder_add_cstr(sb, "0.0");
        return PMN_ERR_NONE;
    }
    var digits[24];
    var n, k = _pmn_im_shortest(mag, &digits, 0);
    var ax: f64 = 0.0;
    store64(&ax, mag);
    var lo: f64 = 0.0001;
    var hi: f64 = 10000000000000000.0;
    if (ax < lo || ax >= hi) {
        str_builder_putc(sb, load8(&digits));
        if (n > 1) {
            str_builder_putc(sb, 46);
            _pmn_im_sb_digits(sb, &digits, 1, n);
        }
        str_builder_putc(sb, 101);
        str_builder_add_int(sb, k - 1);
        return PMN_ERR_NONE;
    }
    _pmn_im_sb_positional(sb, &digits, n, k, 1);
    return PMN_ERR_NONE;
}

# Rust's Debug of a PramanaError as pramana writes it: the variant with an empty message, `InvalidParameter("")` or
# `InvalidParameter(\n    "",\n)`, as `pmn_err_to_json` writes the same message (ADR 007 row 8).
# PMN_ERR_INVALID_PARAMETER, writing nothing, for a code 1.3.0 has no variant for (PMN_ERR_NONE, OUT_OF_MEMORY,
# DESERIALIZE, or no code): `pmn_err_name` names those.
#must_use
fn pmn_err_debug(code, sb, alternate): i64 {
    if (sb == 0 || code < PMN_ERR_INVALID_PARAMETER || code > PMN_ERR_COMPUTATION_ERROR) {
        return PMN_ERR_INVALID_PARAMETER;
    }
    var e = _pmn_dbg_open(sb, pmn_err_name(code), 0, alternate);
    if (e == PMN_ERR_NONE) { e = _pmn_dbg_item(sb, 0, 1, alternate); }
    if (e == PMN_ERR_NONE) { e = _pmn_json_w_lit(sb, "\"\""); }
    if (e == PMN_ERR_NONE) { e = _pmn_dbg_item_end(sb, alternate); }
    if (e == PMN_ERR_NONE) { e = _pmn_dbg_close(sb, 0, alternate); }
    return e;
}

# --- rng.cyr ---

# rng.cyr — random numbers (port of Rust 1.3.0's src/rng.rs; port plan D7 as amended, ADR 007 row 6; M1 part e1).
#
# `PmnRng` is Rust's `Rng` trait: one method, `next_f64`, a uniform f64 in [0, 1). A consumer brings its own
# generator by implementing it. Every pramana API that took Rust's `&mut impl Rng` is generic over `R: PmnRng` and
# takes `rng: *R`, so a draw is a static call, as Rust's monomorphized one is (probe P2: a `dyn` costs about 3 ns more
# on a 12 ns draw). `dyn PmnRng` is kept for Gibbs' conditionals alone, which Rust gives `&mut dyn Rng` (M6).
#
# `PmnSimpleRng` is 1.3.0's `SimpleRng`: xorshift64 (13, 7, 17) on one word, mapped to [0, 1) by its top 53 bits.
# It is integer code, so its streams are class A on every target (`>>` is the logical shift Rust's u64 shift is). It
# is for reproducible simulations and tests, not cryptographically secure.
#
# Debug: `SimpleRng { state: N }` (D12). JSON: `{"state":N}`, as serde derived it. Reading goes through
# `SimpleRngRepr` and `SimpleRng::new`, so a state of 0, xorshift's one fixed point, becomes 1 (port plan D5).

trait PmnRng {
    fn next_f64(self): f64;
}

struct PmnSimpleRng {
    state;
}

# Rust's `SimpleRng::new(seed)`: fills out (caller storage, D11). A seed of 0 becomes 1, so the stream never sticks
# at 0.0. PMN_ERR_INVALID_PARAMETER for a null out; Rust's `new` cannot fail.
fn PmnSimpleRng_new(out: *PmnSimpleRng, seed): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    var s = seed;
    if (s == 0) { s = 1; }
    out.state = s;
    return PMN_ERR_NONE;
}

impl PmnRng for PmnSimpleRng {
    # The next f64 in [0, 1): one xorshift64 step, then (x >> 11) / 2^53, which is exact.
    fn next_f64(self): f64 {
        var x = self.state;
        x = x ^ (x << 13);
        x = x ^ (x >> 7);
        x = x ^ (x << 17);
        self.state = x;
        var a: f64 = f64_from(x >> 11);
        var d: f64 = 9007199254740992.0;
        return a / d;
    }
}

impl PmnSimpleRng {
    # Appends Rust's Debug of the generator (D12): `SimpleRng { state: 42 }` for `{:?}` (alternate 0), or
    # `SimpleRng {\n    state: 42,\n}` for `{:#?}` (1). PMN_ERR_NONE, or PMN_ERR_OUT_OF_MEMORY when sb can't grow.
    #must_use
    fn debug(self, sb, alternate): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var e = _pmn_dbg_open(sb, "SimpleRng", 1, alternate);
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item(sb, "state", 1, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_u64(sb, self.state); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item_end(sb, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_close(sb, 1, alternate); }
        return e;
    }

    # Appends serde_json's text for the generator, `{"state":N}`: PMN_ERR_NONE, or PMN_ERR_OUT_OF_MEMORY when sb can't
    # grow.
    #must_use
    fn to_json(self, sb): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var e = _pmn_json_w_key(sb, "state", 1);
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_u64(sb, self.state); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_lit(sb, "}"); }
        return e;
    }
}

# The decoder for PmnSimpleRng_from_json: SimpleRngRepr's one u64 field, by serde's struct rules, then
# `SimpleRng::new` (serde's `from`, which cannot fail).
fn _pmn_simple_rng_from_root(root, out): i64 {
    var names[8];
    store64(&names, "state");
    var sl[8];
    var e = _pmn_json_struct(root, &names, 1, &sl);
    if (e != PMN_ERR_NONE) { return e; }
    var w[8];
    e = _pmn_json_u64(load64(&sl), &w);
    if (e != PMN_ERR_NONE) { return e; }
    return PmnSimpleRng_new(out, load64(&w));
}

# Reads a SimpleRng document, buf[0, len), into out (caller storage): PMN_ERR_NONE, PMN_ERR_DESERIALIZE for any
# document serde_json refuses, or PMN_ERR_OUT_OF_MEMORY. A state of 0 reads as 1, as in 1.3.0.
#must_use
fn PmnSimpleRng_from_json(out: *PmnSimpleRng, buf, len): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    return _pmn_json_decode(buf, len, &_pmn_simple_rng_from_root, out);
}

# --- combinatorics.cyr ---

# combinatorics.cyr — counting (port of Rust 1.3.0's src/combinatorics.rs; port plan D10, ADR 007 row 4; M1 part e2).
#
# `factorial`, `permutations` and `combinations` return Rust's `Result<u128>`: here a code, with the value in a
# caller's `PmnU128 { lo, hi }`, written only on success (D10). Their arithmetic is 1.3.0's, step for step, with every
# u64 compared as unsigned:
# - **factorial(n):** n > 34 refuses (ComputationError); otherwise 2 · 3 · … · n, checked.
# - **permutations(n, r):** r > n refuses (InvalidParameter); otherwise n · (n − 1) · … · (n − r + 1), each product
#   checked, so an overflow stops the loop at once (ComputationError), whatever r is.
# - **combinations(n, r):** r > n refuses; otherwise r = min(r, n − r), then result · (n − i) / (i + 1) for each i,
#   the product checked before the division. So, as in Rust, an intermediate product can overflow although the result
#   fits: combinations(130, 65) refuses (probe P1).
#
# The u128 arithmetic is probe P1's, which matched 1.3.0 on 3,736 cases: a 128 × 64-bit multiply over 32-bit limbs (no
# partial product overflows a word), with overflow detection, and a 128 / 64-bit restoring division, which part e2
# gives a 32-bit-limb fast path for the small divisors `combinations` makes (C(60, 30): 28.5 µs → 1.14 µs).
# `stirling_approx(n)` is √(2πn) · (n / e)^n in 1.3.0's operation order, through the correctly rounded powf (ADR 009).

struct PmnU128 {
    lo;
    hi;
}

# 1 when a < b as unsigned 64-bit words.
#must_use
#pure
fn _pmn_u64_lt(a, b): i64 {
    if ((a ^ 0x8000000000000000) < (b ^ 0x8000000000000000)) { return 1; }
    return 0;
}

# (hi, lo) × b: the product's (hi, lo), and 1 when it needs more than 128 bits. Each limb's sum of at most four
# 32-bit pieces stays below 2^35, so no carry is lost.
#must_use
fn _pmn_u128_mul_u64(hi, lo, b): (i64, i64, i64) {
    var x0 = lo & 0xFFFFFFFF;
    var x1 = lo >> 32;
    var x2 = hi & 0xFFFFFFFF;
    var x3 = hi >> 32;
    var b0 = b & 0xFFFFFFFF;
    var b1 = b >> 32;
    var p = x0 * b0;
    var a0 = p & 0xFFFFFFFF;
    var a1 = p >> 32;
    p = x0 * b1;
    a1 = a1 + (p & 0xFFFFFFFF);
    var a2 = p >> 32;
    p = x1 * b0;
    a1 = a1 + (p & 0xFFFFFFFF);
    a2 = a2 + (p >> 32);
    p = x1 * b1;
    a2 = a2 + (p & 0xFFFFFFFF);
    var a3 = p >> 32;
    p = x2 * b0;
    a2 = a2 + (p & 0xFFFFFFFF);
    a3 = a3 + (p >> 32);
    p = x2 * b1;
    a3 = a3 + (p & 0xFFFFFFFF);
    var a4 = p >> 32;
    p = x3 * b0;
    a3 = a3 + (p & 0xFFFFFFFF);
    a4 = a4 + (p >> 32);
    p = x3 * b1;
    a4 = a4 + (p & 0xFFFFFFFF);
    var a5 = p >> 32;
    a1 = a1 + (a0 >> 32);
    a2 = a2 + (a1 >> 32);
    a3 = a3 + (a2 >> 32);
    a4 = a4 + (a3 >> 32);
    a5 = a5 + (a4 >> 32);
    var rlo = (a0 & 0xFFFFFFFF) | ((a1 & 0xFFFFFFFF) << 32);
    var rhi = (a2 & 0xFFFFFFFF) | ((a3 & 0xFFFFFFFF) << 32);
    var ovf = 0;
    if ((a4 & 0xFFFFFFFF) != 0 || a5 != 0) { ovf = 1; }
    return (rhi, rlo, ovf);
}

# (hi, lo) / d for d ≥ 1: the quotient's (hi, lo).
# - **d < 2^31,** which is every divisor `combinations` makes (i + 1 for i below r, and r stays small before a product
#   overflows): long division by 32-bit limbs. Each partial numerator is a remainder below d times 2^32 plus a limb,
#   so below 2^63, where the native (signed) division is exact.
# - **Otherwise,** restoring division over the 128 bits. The remainder stays below d < 2^64; a carry out of its top bit
#   means it is already ≥ d.
#must_use
fn _pmn_u128_div_u64(hi, lo, d): (i64, i64) {
    if (d > 0 && d < 0x80000000) {
        var n3 = hi >> 32;
        var q3 = n3 / d;
        var n2 = ((n3 - q3 * d) << 32) | (hi & 0xFFFFFFFF);
        var q2 = n2 / d;
        var n1 = ((n2 - q2 * d) << 32) | (lo >> 32);
        var q1 = n1 / d;
        var n0 = ((n1 - q1 * d) << 32) | (lo & 0xFFFFFFFF);
        var q0 = n0 / d;
        return ((q3 << 32) | q2, (q1 << 32) | q0);
    }
    var qhi = 0;
    var qlo = 0;
    var rem = 0;
    var i = 127;
    while (i >= 0) {
        var bit = 0;
        if (i >= 64) {
            bit = (hi >> (i - 64)) & 1;
        } else {
            bit = (lo >> i) & 1;
        }
        var top = rem >> 63;
        rem = (rem << 1) | bit;
        if (top == 1 || _pmn_u64_lt(rem, d) == 0) {
            rem = rem - d;
            if (i >= 64) {
                qhi = qhi | (1 << (i - 64));
            } else {
                qlo = qlo | (1 << i);
            }
        }
        i = i - 1;
    }
    return (qhi, qlo);
}

# Rust's `factorial(n)`: n! into out. PMN_ERR_COMPUTATION_ERROR for n > 34, whose factorial overflows u128.
#must_use
fn pmn_factorial(n, out: *PmnU128): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    if (_pmn_u64_lt(34, n) == 1) { return PMN_ERR_COMPUTATION_ERROR; }
    var hi = 0;
    var lo = 1;
    var i = 2;
    while (_pmn_u64_lt(n, i) == 0) {
        var h, l, ovf = _pmn_u128_mul_u64(hi, lo, i);
        if (ovf == 1) { return PMN_ERR_COMPUTATION_ERROR; }
        hi = h;
        lo = l;
        i = i + 1;
    }
    out.lo = lo;
    out.hi = hi;
    return PMN_ERR_NONE;
}

# Rust's `permutations(n, r)`: n! / (n − r)! into out. PMN_ERR_INVALID_PARAMETER for r > n, and
# PMN_ERR_COMPUTATION_ERROR when the product overflows u128.
#must_use
fn pmn_permutations(n, r, out: *PmnU128): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    if (_pmn_u64_lt(n, r) == 1) { return PMN_ERR_INVALID_PARAMETER; }
    var hi = 0;
    var lo = 1;
    var i = 0;
    while (i != r) {
        var h, l, ovf = _pmn_u128_mul_u64(hi, lo, n - i);
        if (ovf == 1) { return PMN_ERR_COMPUTATION_ERROR; }
        hi = h;
        lo = l;
        i = i + 1;
    }
    out.lo = lo;
    out.hi = hi;
    return PMN_ERR_NONE;
}

# Rust's `combinations(n, r)`: the binomial coefficient into out. PMN_ERR_INVALID_PARAMETER for r > n, and
# PMN_ERR_COMPUTATION_ERROR when an intermediate product overflows u128.
#must_use
fn pmn_combinations(n, r, out: *PmnU128): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    if (_pmn_u64_lt(n, r) == 1) { return PMN_ERR_INVALID_PARAMETER; }
    var k = r;
    if (_pmn_u64_lt(n - r, k) == 1) { k = n - r; }
    var hi = 0;
    var lo = 1;
    var i = 0;
    while (i != k) {
        var h, l, ovf = _pmn_u128_mul_u64(hi, lo, n - i);
        if (ovf == 1) { return PMN_ERR_COMPUTATION_ERROR; }
        var qh, ql = _pmn_u128_div_u64(h, l, i + 1);
        hi = qh;
        lo = ql;
        i = i + 1;
    }
    out.lo = lo;
    out.hi = hi;
    return PMN_ERR_NONE;
}

# Rust's `stirling_approx(n)`: 1 for n = 0, else √(2π · n) · (n / e)^n, with n converted as Rust's `n as f64`
# (unsigned, to nearest). ∞ once (n / e)^n overflows.
#must_use
fn pmn_stirling_approx(n): f64 {
    if (n == 0) { return 1.0; }
    var nf: f64 = _pmn_u64_to_f64(n);
    var pi: f64 = _PMN_F64_PI;
    var e: f64 = _PMN_F64_E;
    var two_pi: f64 = 2.0 * pi;
    var a: f64 = two_pi * nf;
    var root: f64 = f64_sqrt(a);
    var base: f64 = nf / e;
    var pw: f64 = _pmn_powf(base, nf);
    return root * pw;
}

# --- bridge.cyr ---

# bridge.cyr — conversions from other AGNOS science crates' values to pramana's parameters (port of Rust 1.3.0's
# src/bridge.rs; M1 part e3).
#
# Eleven functions for badal (weather), kimiya (chemistry), ushma (thermodynamics) and bodh (psychology), each in
# 1.3.0's operation order:
# - a slice `&[f64]` is a pointer and a count; a slice of pairs `&[(u32, f64)]` or `&[(usize, f64)]` is n records of
#   16 bytes: the integer word, then the f64;
# - a returned tuple fills the caller's `out`, its elements in order (port plan §8.3). Those functions return a code,
#   PMN_ERR_INVALID_PARAMETER only for a caller's null buffer: 1.3.0's cannot fail. `out` is written last, so it may
#   alias an input;
# - f64 sums start at −0.0, as Rust's `sum` does (port-parity §1), and the explicit accumulators at +0.0, as written;
# - an integer converts as Rust's `as f64` does (unsigned, to nearest);
# - the thresholds are 1.3.0's literals: 1e-15 (written out here, as Cyrius has no exponent form) and 1.96, each
#   pinned by golden rows at and beside it.
# The likelihood, the power-law fit and Hick's fit call exp, ln and log2, correctly rounded (ADR 009): class C. The
# rest is arithmetic and sqrt: class B, expected exact.

# The 1e-15 floors of `replicates_to_t_statistic`, `item_variances_to_alpha` and the line fit.
#must_use
#pure
fn _pmn_bridge_floor(): f64 {
    var t: f64 = 0.000000000000001;
    return t;
}

# The sum of x[0, n), from −0.0 as Rust's `Iterator::sum` for f64.
#must_use
fn _pmn_bridge_sum(x, n): f64 {
    var s: f64 = -0.0;
    for (var i = 0; i < n; i = i + 1) {
        var v: f64 = load64(x + i * 8);
        s = s + v;
    }
    return s;
}

# ── badal (weather) ─────────────────────────────────────────────────────────────────────────────

# Rust's `ensemble_spread_to_confidence`: |std_dev| · confidence_z, the confidence interval's half-width.
#must_use
#pure
fn pmn_ensemble_spread_to_confidence(std_dev: f64, confidence_z: f64): f64 {
    var a: f64 = f64_abs(std_dev);
    return a * confidence_z;
}

# Rust's `observation_error_to_likelihood`: the normal density of the residual, exp(−z²/2) / (σ√(2π)) with
# z = residual / σ; 0 for σ ≤ 0.
#must_use
fn pmn_observation_error_to_likelihood(residual: f64, std_dev: f64): f64 {
    if (std_dev <= 0.0) { return 0.0; }
    var z: f64 = residual / std_dev;
    var tau: f64 = _PMN_F64_TAU;
    var two_pi_sqrt: f64 = f64_sqrt(tau);
    var h: f64 = -0.5 * z;
    var a: f64 = h * z;
    var e: f64 = _pmn_exp(a);
    var d: f64 = std_dev * two_pi_sqrt;
    return e / d;
}

# ── kimiya (chemistry) ──────────────────────────────────────────────────────────────────────────

# Rust's `yields_to_mean_variance`: out[0] the mean and out[1] the sample variance (n − 1) of yields[0, n); (0, 0)
# for no yields, and a variance of 0 for one.
#must_use
fn pmn_yields_to_mean_variance(yields, n, out): i64 {
    if (out == 0 || n < 0 || (yields == 0 && n > 0)) { return PMN_ERR_INVALID_PARAMETER; }
    var mean: f64 = 0.0;
    var variance: f64 = 0.0;
    if (n > 0) {
        var nf: f64 = f64_from(n);
        var s: f64 = _pmn_bridge_sum(yields, n);
        mean = s / nf;
        if (n > 1) {
            var ss: f64 = -0.0;
            for (var i = 0; i < n; i = i + 1) {
                var y: f64 = load64(yields + i * 8);
                var d: f64 = y - mean;
                var sq: f64 = d * d;
                ss = ss + sq;
            }
            var nm1: f64 = nf - 1.0;
            variance = ss / nm1;
        }
    }
    store64(out, mean);
    store64(out + 8, variance);
    return PMN_ERR_NONE;
}

# Rust's `replicates_to_t_statistic`: Welch's t, (mean_a − mean_b) / √(s_a²/n_a + s_b²/n_b); 0 when either count is 0
# or the standard error is below 1e-15. The counts are usizes.
#must_use
fn pmn_replicates_to_t_statistic(mean_a: f64, std_a: f64, n_a, mean_b: f64, std_b: f64, n_b): f64 {
    if (n_a == 0 || n_b == 0) { return 0.0; }
    var fa: f64 = _pmn_u64_to_f64(n_a);
    var fb: f64 = _pmn_u64_to_f64(n_b);
    var va: f64 = std_a * std_a;
    var vb: f64 = std_b * std_b;
    var ta: f64 = va / fa;
    var tb: f64 = vb / fb;
    var t: f64 = ta + tb;
    var se: f64 = f64_sqrt(t);
    var floor: f64 = _pmn_bridge_floor();
    if (se < floor) { return 0.0; }
    var diff: f64 = mean_a - mean_b;
    return diff / se;
}

# ── ushma (thermodynamics) ──────────────────────────────────────────────────────────────────────

# Rust's `uncertainty_to_gaussian`: out[0] the measured value and out[1] σ = |uncertainty| / 1.96, a 95% interval's
# half-width read back as a standard deviation.
#must_use
fn pmn_uncertainty_to_gaussian(measured_value: f64, uncertainty_k: f64, out): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    var a: f64 = f64_abs(uncertainty_k);
    var c: f64 = 1.96;
    var sd: f64 = a / c;
    store64(out, measured_value);
    store64(out + 8, sd);
    return PMN_ERR_NONE;
}

# Rust's `sensor_noise_to_std_dev`: √(psd · bandwidth); 0 unless both are positive.
#must_use
fn pmn_sensor_noise_to_std_dev(psd: f64, bandwidth_hz: f64): f64 {
    if (psd <= 0.0 || bandwidth_hz <= 0.0) { return 0.0; }
    var p: f64 = psd * bandwidth_hz;
    return f64_sqrt(p);
}

# ── bodh (psychology) ───────────────────────────────────────────────────────────────────────────

# Rust's `item_variances_to_alpha`: Cronbach's α = k/(k − 1) · (1 − Σσᵢ² / σ²_total); 0 for k < 2 or a total variance
# below 1e-15. k is a usize.
#must_use
fn pmn_item_variances_to_alpha(k, sum_item_variance: f64, total_variance: f64): f64 {
    var floor: f64 = _pmn_bridge_floor();
    if (_pmn_u64_lt(k, 2) == 1 || total_variance < floor) { return 0.0; }
    var kf: f64 = _pmn_u64_to_f64(k);
    var km1: f64 = kf - 1.0;
    var ratio: f64 = kf / km1;
    var q: f64 = sum_item_variance / total_variance;
    var one_minus: f64 = 1.0 - q;
    return ratio * one_minus;
}

# Rust's `z_rates_to_d_prime`: d′ = z(hit) − z(false alarm).
#must_use
#pure
fn pmn_z_rates_to_d_prime(z_hit: f64, z_false_alarm: f64): f64 {
    return z_hit - z_false_alarm;
}

# Rust's `trait_scores_to_correlation`: out[0 … 4] = (mean a, mean b, cov(a, b), var a, var b), the sample (n − 1)
# forms, for a[0, na) and b[0, nb); all 0 when the slices are empty or of different lengths, and the last three 0 for
# one score each.
#must_use
fn pmn_trait_scores_to_correlation(a, na, b, nb, out): i64 {
    if (out == 0 || na < 0 || nb < 0 || (a == 0 && na > 0) || (b == 0 && nb > 0)) {
        return PMN_ERR_INVALID_PARAMETER;
    }
    var mean_a: f64 = 0.0;
    var mean_b: f64 = 0.0;
    var cov: f64 = 0.0;
    var var_a: f64 = 0.0;
    var var_b: f64 = 0.0;
    if (na > 0 && na == nb) {
        var n: f64 = f64_from(na);
        var sa: f64 = _pmn_bridge_sum(a, na);
        var sb: f64 = _pmn_bridge_sum(b, nb);
        mean_a = sa / n;
        mean_b = sb / n;
        for (var i = 0; i < na; i = i + 1) {
            var xa: f64 = load64(a + i * 8);
            var xb: f64 = load64(b + i * 8);
            var da: f64 = xa - mean_a;
            var db: f64 = xb - mean_b;
            var pab: f64 = da * db;
            var paa: f64 = da * da;
            var pbb: f64 = db * db;
            cov = cov + pab;
            var_a = var_a + paa;
            var_b = var_b + pbb;
        }
        if (n > 1.0) {
            var denom: f64 = n - 1.0;
            cov = cov / denom;
            var_a = var_a / denom;
            var_b = var_b / denom;
        } else {
            cov = 0.0;
            var_a = 0.0;
            var_b = 0.0;
        }
    }
    store64(out, mean_a);
    store64(out + 8, mean_b);
    store64(out + 16, cov);
    store64(out + 24, var_a);
    store64(out + 32, var_b);
    return PMN_ERR_NONE;
}

# The least-squares line through the n points (xs[k], ys[k]): 1 with (slope, intercept), or 0 for fewer than two
# points or an x spread (Σ(x − x̄)²) not above 1e-15 or not finite. Rust's private `fit_line`, its folds from +0.0.
#must_use
fn _pmn_bridge_fit_line(xs, ys, n): (i64, f64, f64) {
    var none: f64 = 0.0;
    if (n < 2) { return (0, none, none); }
    var sx: f64 = 0.0;
    var sy: f64 = 0.0;
    for (var i = 0; i < n; i = i + 1) {
        var x: f64 = load64(xs + i * 8);
        var y: f64 = load64(ys + i * 8);
        sx = sx + x;
        sy = sy + y;
    }
    var nf: f64 = f64_from(n);
    var mean_x: f64 = sx / nf;
    var mean_y: f64 = sy / nf;
    var sxx: f64 = 0.0;
    var sxy: f64 = 0.0;
    for (var j = 0; j < n; j = j + 1) {
        var x2: f64 = load64(xs + j * 8);
        var y2: f64 = load64(ys + j * 8);
        var dx: f64 = x2 - mean_x;
        var dxx: f64 = dx * dx;
        var dy: f64 = y2 - mean_y;
        var dxy: f64 = dx * dy;
        sxx = sxx + dxx;
        sxy = sxy + dxy;
    }
    var floor: f64 = _pmn_bridge_floor();
    if ((sxx > floor && _pmn_is_finite(sxx) == 1) == 0) { return (0, none, none); }
    var slope: f64 = sxy / sxx;
    var sm: f64 = slope * mean_x;
    var intercept: f64 = mean_y - sm;
    return (1, slope, intercept);
}

# The kept points of n 16-byte records (an integer word, then an f64) into scratch: `kind` 0 keeps learning trials
# (trial > 0, time > 0 and finite; x = ln trial, y = ln time), 1 keeps Hick's data (choices > 0, a finite time; x =
# log2 choices, y = the time). Returns the scratch (to give back), its slot, and the count kept; a scratch of 0 when it
# can't be had.
fn _pmn_bridge_points(recs, n, kind): (i64, i64, i64) {
    var p, slot = _pmn_scratch_take(16 * n + 16);
    if (p == 0) { return (0, slot, 0); }
    var m = 0;
    for (var i = 0; i < n; i = i + 1) {
        var w = load64(recs + i * 16);
        var t: f64 = load64(recs + i * 16 + 8);
        var keep = 0;
        if (kind == 0 && w != 0 && t > 0.0 && _pmn_is_finite(t) == 1) { keep = 1; }
        if (kind == 1 && w != 0 && _pmn_is_finite(t) == 1) { keep = 1; }
        if (keep == 1) {
            var wf: f64 = _pmn_u64_to_f64(w);
            var x: f64 = 0.0;
            var y: f64 = t;
            if (kind == 0) {
                x = _pmn_ln(wf);
                y = _pmn_ln(t);
            } else {
                x = _pmn_log2(wf);
            }
            store64(p + m * 8, x);
            store64(p + (n + 1 + m) * 8, y);
            m = m + 1;
        }
    }
    return (p, slot, m);
}

# Rust's `learning_trials_to_power_law`: the power law of practice T = a · N^(−b), fitted on ln T = ln a − b ln N over
# the n records (trial, time) with trial > 0 and a positive, finite time: out[0] = a and out[1] = b; (0, 0) when no
# line fits.
#must_use
fn pmn_learning_trials_to_power_law(trials, n, out): i64 {
    if (out == 0 || n < 0 || (trials == 0 && n > 0)) { return PMN_ERR_INVALID_PARAMETER; }
    var p, slot, m = _pmn_bridge_points(trials, n, 0);
    if (p == 0 && n > 0) { return PMN_ERR_OUT_OF_MEMORY; }
    var ok, slope, intercept = _pmn_bridge_fit_line(p, p + (n + 1) * 8, m);
    _pmn_scratch_give(p, slot);
    var a: f64 = 0.0;
    var b: f64 = 0.0;
    if (ok == 1) {
        a = _pmn_exp(intercept);
        b = -slope;
    }
    store64(out, a);
    store64(out + 8, b);
    return PMN_ERR_NONE;
}

# Rust's `response_times_to_hick_params`: Hick's law RT = a + b · log2(n), fitted over the n records (choices, time)
# with choices > 0 and a finite time: out[0] = a and out[1] = b; (0, 0) when no line fits.
#must_use
fn pmn_response_times_to_hick_params(data, n, out): i64 {
    if (out == 0 || n < 0 || (data == 0 && n > 0)) { return PMN_ERR_INVALID_PARAMETER; }
    var p, slot, m = _pmn_bridge_points(data, n, 1);
    if (p == 0 && n > 0) { return PMN_ERR_OUT_OF_MEMORY; }
    var ok, slope, intercept = _pmn_bridge_fit_line(p, p + (n + 1) * 8, m);
    _pmn_scratch_give(p, slot);
    var a: f64 = 0.0;
    var b: f64 = 0.0;
    if (ok == 1) {
        a = intercept;
        b = slope;
    }
    store64(out, a);
    store64(out + 8, b);
    return PMN_ERR_NONE;
}

# --- special.cyr ---

# special.cyr — the special functions (port of Rust 1.3.0's src/math.rs; port plan D3, §3.4, ADR 009; M2).
#
# M2 lands in two tiers (D3 = C):
# - **T0, part a:** math.rs in Rust's operation order, on the correctly rounded primitives. Its rows matched 1.3.0's
#   bits wherever glibc rounds correctly, and the `*.cr.tsv` model elsewhere, at 0 ulp: that proved the transcription.
# - **T1, part b:** the five replacements of §3.4 (erf and erfc correctly rounded; normal_cdf, ln_gamma, gamma_inc,
#   beta_inc to ADR 009's bounds), gated against the reference rows (`*.ref.tsv`: MPFR's values, and Rust's formulas
#   on them downstream).
#
# Now:
# - erf and erfc are T1 (part b1): CORE-MATH's, correctly rounded (src/crerf.cyr). 1.3.0's fdlibm transcription, which
#   part a1 proved at 0 ulp, is retired;
# - Φ and 1 − Φ are T1 (part b2): within 0.5 + 2^-7 ulp, on erfc's double-double core (src/crerf.cyr);
# - lnΓ is T1 (part b3): fdlibm's layout with double-double logarithms (src/lgamma.cyr), within 2 ulp;
# - a2: the Stirling remainder, Loader's bd0, the incomplete gamma's prefactor kernel, and ln B (T0, on T1's lnΓ);
# - the regularized incomplete gamma P and Q are T1 (part b4): Rust's two expansions in double-double, split at x = a
#   (src/gammainc.cyr), within 4 ulp; Rust's Wilson–Hilferty form past a = 10⁹, on T1's Φ;
# - the regularized incomplete beta I_x(a, b) and its complement are T1 (part b5) up to max(a, b) = 1e9: Rust's
#   continued fraction in double-double, with the smaller of x and y exact and a power-series complement for small
#   shapes (src/betainc.cyr), within 8 ulp; Rust's form (a4, T0) past 1e9.
# The coefficients are src/constants.cyr's, generated from rust-old/src and proven against the oracle (M0 step 6). The
# primitives are exp, ln, ln_1p and sin, each correctly rounded (src/crmath.cyr, src/crmath_ext.cyr), and sqrt and
# cbrt. 1.3.0's math.rs is crate-private, so these names are too (`_pmn_`).
#
# UPSTREAM(L8): ganita:docs/development/issues/2026-11-15-special-functions-scope-request.md
#   replace with ganita's special functions if it takes them on; parity: every special row, and every *.ref.tsv row

# erf(x), correctly rounded (T1, M2 part b1): CORE-MATH's algorithm. ±1 at ±∞, and a NaN returned as x + x.
#must_use
fn _pmn_erf(x: f64): f64 {
    var r: f64 = _pmn_cm_erf(x);
    return r;
}

# erfc(x) = 1 − erf(x), correctly rounded (T1, M2 part b1): CORE-MATH's algorithm, computed directly, so the tail
# keeps its relative precision down to the subnormals. 0 at +∞, 2 at −∞, and a NaN returned as x + x.
#must_use
fn _pmn_erfc(x: f64): f64 {
    var r: f64 = _pmn_cm_erfc(x);
    return r;
}

# Φ(z) = ½·erfc(−z/√2) within 0.5 + 2^-7 ulp (T1, M2 part b2; ADR 009's bound is 1 ulp), and correctly rounded
# almost everywhere: −z/√2 is carried as a double-double, and its low part's first-order correction is applied to
# CORE-MATH's unrounded double-double erfc, with the ½ folded into one rounding (src/crerf.cyr). 1.3.0 rounded −z/√2
# first, which costs up to 1,688 ulp in the tail. A NaN is returned as z + z.
#must_use
fn _pmn_normal_cdf(z: f64): f64 {
    var r: f64 = _pmn_cm_normal_cdf(z);
    return r;
}

# 1 − Φ(z) = ½·erfc(z/√2) = Φ(−z), bit for bit, as in 1.3.0 (T1, M2 part b2). A NaN is returned as z + z.
#must_use
fn _pmn_normal_sf(z: f64): f64 {
    if (z != z) {
        var nn: f64 = z + z;
        return nn;
    }
    var nz: f64 = -z;
    var r: f64 = _pmn_cm_normal_cdf(nz);
    return r;
}

# ── part a2: lnΓ and its relatives ──────────────────────────────────────────────────────────────────────────────

# lnΓ(x) = ln|Γ(x)| within 2 ulp for x > 0, and within 2 ulp of max(|lnΓ|, 1) for x < 0 (T1, M2 part b3; ADR 009):
# probe P9's fdlibm-layout form with double-double logarithms and products, rounded once (src/lgamma.cyr). 1.3.0's
# Lanczos form, which part a2 proved at 0 ulp, is retired: it is off by up to 4.3×10¹³ ulp beside the roots at 1 and
# 2. +∞ at 0, at the negative integers and at ±∞; −ln x below 2^-70.
#must_use
fn _pmn_ln_gamma(x: f64): f64 {
    var r: f64 = _pmn_lg_ln_gamma(x);
    return r;
}

# Rust's `stirling_error`: lnΓ(a) − [(a − ½) ln a − a + ln √(2π)]. From a = 10 the asymptotic series, seven terms in
# 1/a² (its coefficients are Rust's literal quotients, each a correctly rounded division as Rust folds it); below,
# the difference itself.
#must_use
fn _pmn_stirling_error(a: f64): f64 {
    if (a >= 10.0) {
        var r: f64 = 1.0 / a;
        var r2: f64 = r * r;
        var t: f64 = r2 / 156.0;
        t = 691.0 / 360360.0 - t;
        t = 1.0 / 1188.0 - r2 * t;
        t = 1.0 / 1680.0 - r2 * t;
        t = 1.0 / 1260.0 - r2 * t;
        t = 1.0 / 360.0 - r2 * t;
        t = 1.0 / 12.0 - r2 * t;
        return r * t;
    }
    var lg: f64 = _pmn_ln_gamma(a);
    var la: f64 = _pmn_ln(a);
    var am: f64 = a - 0.5;
    var b1: f64 = am * la;
    var b2: f64 = b1 - a;
    var b3: f64 = b2 + _PMN_MATH_LN_SQRT_2PI;
    return lg - b3;
}

# Rust's `bd0`, Loader's deviance term x ln(x/m) + m − x, as m·((1 + u) ln(1 + u) − u) with u = (x − m)/m: its
# absolute error is about |x − m|·ε rather than x·ε. m at x = 0.
#must_use
fn _pmn_bd0(x: f64, m: f64): f64 {
    if (x == 0.0) { return m; }
    var xm: f64 = x - m;
    var u: f64 = xm / m;
    var l: f64 = _pmn_ln_1p(u);
    var u1: f64 = 1.0 + u;
    var p: f64 = u1 * l;
    var d: f64 = p - u;
    return m * d;
}

# Rust's `ln_gamma_kernel`: a ln x − x − lnΓ(a), the log of the incomplete gamma's prefactor (and of the Poisson pmf
# at a = k + 1). From a = 10 it is −a(u − ln(1 + u)) + ½ ln a − ln √(2π) − stirling_error(a), u = (x − a)/a, which
# does not cancel.
#must_use
fn _pmn_ln_gamma_kernel(a: f64, x: f64): f64 {
    if (a < 10.0) {
        var lx: f64 = _pmn_ln(x);
        var t: f64 = a * lx;
        var t2: f64 = t - x;
        var lg: f64 = _pmn_ln_gamma(a);
        return t2 - lg;
    }
    var xa: f64 = x - a;
    var u: f64 = xa / a;
    var l1: f64 = _pmn_ln_1p(u);
    var d: f64 = u - l1;
    var na: f64 = -a;
    var m: f64 = na * d;
    var la: f64 = _pmn_ln(a);
    var h: f64 = 0.5 * la;
    var r: f64 = m + h;
    var r2: f64 = r - _PMN_MATH_LN_SQRT_2PI;
    var st: f64 = _pmn_stirling_error(a);
    return r2 - st;
}

# Rust's `ln_beta`: ln B(a, b) = lnΓ(a) + lnΓ(b) − lnΓ(a + b), in R's lbeta scheme: with p = min(a, b) and
# q = max(a, b) (Rust's min and max, which ignore a NaN), the Stirling corrections when q ≥ 10, so the three lnΓ
# never cancel.
#must_use
fn _pmn_ln_beta(a: f64, b: f64): f64 {
    var p: f64 = _pmn_min(a, b);
    var q: f64 = _pmn_max(a, b);
    if (p >= 10.0) {
        var pq: f64 = p + q;
        var sp: f64 = _pmn_stirling_error(p);
        var sq: f64 = _pmn_stirling_error(q);
        var spq: f64 = _pmn_stirling_error(pq);
        var c1: f64 = sp + sq;
        var corr: f64 = c1 - spq;
        var lq: f64 = _pmn_ln(q);
        var t1: f64 = -0.5 * lq;
        var t2: f64 = t1 + _PMN_MATH_LN_SQRT_2PI;
        var t3: f64 = t2 + corr;
        var r: f64 = p / pq;
        var lr: f64 = _pmn_ln(r);
        var pm: f64 = p - 0.5;
        var t4: f64 = pm * lr;
        var t5: f64 = t3 + t4;
        var np: f64 = -p;
        var nr: f64 = np / pq;
        var l1: f64 = _pmn_ln_1p(nr);
        var t6: f64 = q * l1;
        return t5 + t6;
    }
    if (q >= 10.0) {
        var pq2: f64 = p + q;
        var sq2: f64 = _pmn_stirling_error(q);
        var spq2: f64 = _pmn_stirling_error(pq2);
        var corr2: f64 = sq2 - spq2;
        var lgp: f64 = _pmn_ln_gamma(p);
        var u1: f64 = lgp + corr2;
        var u2: f64 = u1 + p;
        var lpq: f64 = _pmn_ln(pq2);
        var plp: f64 = p * lpq;
        var u3: f64 = u2 - plp;
        var np2: f64 = -p;
        var nr2: f64 = np2 / pq2;
        var l2: f64 = _pmn_ln_1p(nr2);
        var qm: f64 = q - 0.5;
        var u4: f64 = qm * l2;
        return u3 + u4;
    }
    var ga: f64 = _pmn_ln_gamma(a);
    var gb: f64 = _pmn_ln_gamma(b);
    var ab: f64 = a + b;
    var gab: f64 = _pmn_ln_gamma(ab);
    var g1: f64 = ga + gb;
    return g1 - gab;
}

# ── parts a3 and b4: the regularized incomplete gamma ───────────────────────────────────────────────────────────

# Rust's `iteration_budget`: min(200 + 20·√shape, 10⁶) iterations, truncated as `as usize` truncates; √shape is 0
# for a shape that is not finite and positive. Bounds every series and continued fraction's worst-case time.
#must_use
fn _pmn_iteration_budget(shape: f64): i64 {
    var root: f64 = 0.0;
    if (_pmn_is_finite(shape) == 1 && shape > 0.0) { root = f64_sqrt(shape); }
    var t: f64 = 20.0 * root;
    var b: f64 = 200.0 + t;
    var mx: f64 = _PMN_MATH_MAX_ITERATIONS;
    var m: f64 = _pmn_min(b, mx);
    return _pmn_sat_usize(m);
}

# (P(a, x), Q(a, x)) within 4 ulp for a in [1e-3, 1e5] (T1, M2 part b4; ADR 009): probe P9's form up to a = 10⁹,
# Rust's two expansions with a double-double prefactor, double-double loops and the split at x = a (src/gammainc.cyr).
# 1.3.0's double-precision series and continued fraction, which part a3 proved at 0 ulp, are retired: they are off by
# up to 485 ulp on §3.2's pairs and 2.9×10⁹ in the deep lower tail. Past a = 10⁹, Rust's Wilson–Hilferty form as it
# is (ADR 009): (x/a)^⅓ is close to N(1 − 1/(9a), 1/(9a)), on T1's Φ. (NaN, NaN) for a NaN argument or a ≤ 0; (0, 1)
# for x ≤ 0 or a = +∞; (1, 0) for x = +∞.
#must_use
fn _pmn_gamma_inc(a: f64, x: f64): (f64, f64) {
    if (x != x || a != a || a <= 0.0) {
        var nan: f64 = _PMN_F64_NAN;
        return (nan, nan);
    }
    if (x <= 0.0) { return (0.0, 1.0); }
    var inf: f64 = _PMN_F64_INFINITY;
    if (x == inf) { return (1.0, 0.0); }
    if (a == inf) { return (0.0, 1.0); }
    var wh: f64 = _PMN_MATH_GAMMA_WILSON_HILFERTY_SHAPE;
    if (a > wh) {
        var a9: f64 = 9.0 * a;
        var v: f64 = 1.0 / a9;
        var xa: f64 = x / a;
        var cr: f64 = _pmn_cbrt(xa);
        var mv: f64 = 1.0 - v;
        var num: f64 = cr - mv;
        var sv: f64 = f64_sqrt(v);
        var z: f64 = num / sv;
        var pz: f64 = _pmn_normal_cdf(z);
        var qz: f64 = _pmn_normal_sf(z);
        return (pz, qz);
    }
    var p, q = _pmn_gi_gamma_inc(a, x);
    return (p, q);
}

# Rust's `regularized_lower_incomplete_gamma`: P(a, x) = γ(a, x)/Γ(a), gamma_inc's first value.
#must_use
fn _pmn_regularized_lower_incomplete_gamma(a: f64, x: f64): f64 {
    var p, q = _pmn_gamma_inc(a, x);
    return p;
}

# Rust's `regularized_upper_incomplete_gamma`: Q(a, x) = 1 − P(a, x), computed directly, gamma_inc's second value.
#must_use
fn _pmn_regularized_upper_incomplete_gamma(a: f64, x: f64): f64 {
    var p, q = _pmn_gamma_inc(a, x);
    return q;
}

# ── parts a4 and b5: the regularized incomplete beta ────────────────────────────────────────────────────────────

# Rust's `beta_cf` (T0, part a4; kept past max(a, b) = 1e9, as beta_inc below says): I_x(a, b) by Lentz's continued
# fraction, for x < (a + 1)/(a + b + 2), where it converges fastest.
# The prefactor x^a·y^b/(a·B(a, b)) is taken in logs: for two shapes of 10 or more in TOMS 708's brcomp form, −bd0(a,
# s·x) − bd0(b, s·y) + ½ ln(ab/s) − ln √(2π) − corr − ln a with s = a + b, which does not cancel; otherwise as
# a ln x + b ln y − ln B(a, b) − ln a, each log taken on the side that keeps precision (ln(1 − y) as ln_1p(−y) when
# y < ½). y is 1 − x, passed by the caller. Even and odd steps alternate, each denominator kept from 0 by 1e-300,
# until an odd step's factor is within 1e-15 of 1 or the budget for max(a, b) runs out; the result is clamped to
# [0, 1], and is 0 when the prefactor underflows.
#must_use
fn _pmn_beta_cf(a: f64, b: f64, x: f64, y: f64): f64 {
    var ln_prefix: f64 = 0.0;
    var la: f64 = _pmn_ln(a);
    if (a >= 10.0 && b >= 10.0) {
        var s: f64 = a + b;
        var sa: f64 = _pmn_stirling_error(a);
        var sb: f64 = _pmn_stirling_error(b);
        var ss: f64 = _pmn_stirling_error(s);
        var c1: f64 = sa + sb;
        var corr: f64 = c1 - ss;
        var sx: f64 = s * x;
        var sy: f64 = s * y;
        var da: f64 = _pmn_bd0(a, sx);
        var db: f64 = _pmn_bd0(b, sy);
        var nda: f64 = -da;
        var t1: f64 = nda - db;
        var lb: f64 = _pmn_ln(b);
        var ls: f64 = _pmn_ln(s);
        var lab: f64 = la + lb;
        var labs: f64 = lab - ls;
        var h: f64 = 0.5 * labs;
        var t2: f64 = t1 + h;
        var t3: f64 = t2 - _PMN_MATH_LN_SQRT_2PI;
        var t4: f64 = t3 - corr;
        ln_prefix = t4 - la;
    } else {
        var ln_x: f64 = 0.0;
        if (y < 0.5) {
            var ny: f64 = -y;
            ln_x = _pmn_ln_1p(ny);
        } else {
            ln_x = _pmn_ln(x);
        }
        var ln_y: f64 = 0.0;
        if (x < 0.5) {
            var nx: f64 = -x;
            ln_y = _pmn_ln_1p(nx);
        } else {
            ln_y = _pmn_ln(y);
        }
        var u1: f64 = a * ln_x;
        var u2: f64 = b * ln_y;
        var u3: f64 = u1 + u2;
        var lbe: f64 = _pmn_ln_beta(a, b);
        var u4: f64 = u3 - lbe;
        ln_prefix = u4 - la;
    }
    var prefix: f64 = _pmn_exp(ln_prefix);
    if (prefix == 0.0) { return 0.0; }

    var tiny: f64 = _PMN_MATH_LENTZ_TINY;
    var eps: f64 = _PMN_MATH_CONVERGENCE_EPS;
    var mab: f64 = _pmn_max(a, b);
    var n = _pmn_iteration_budget(mab);
    var c: f64 = 1.0;
    # 1 − (a + b)x/(a + 1), written with y = 1 − x so it does not cancel as x → 1.
    var a1: f64 = a + 1.0;
    var omb: f64 = 1.0 - b;
    var e1: f64 = omb * x;
    var e2: f64 = a1 * y;
    var e3: f64 = e1 + e2;
    var d: f64 = e3 / a1;
    var d0abs: f64 = f64_abs(d);
    if (d0abs < tiny) { d = tiny; }
    d = 1.0 / d;
    var h2: f64 = d;
    var ab: f64 = a + b;
    for (var m = 1; m <= n; m = m + 1) {
        var mf: f64 = f64_from(m);
        var two_m: f64 = 2.0 * mf;
        var a2m: f64 = a + two_m;

        # The even step: m(b − m)x / ((a + 2m − 1)(a + 2m)).
        var bm: f64 = b - mf;
        var n1: f64 = mf * bm;
        var n2: f64 = n1 * x;
        var a2m1: f64 = a2m - 1.0;
        var de: f64 = a2m1 * a2m;
        var num_even: f64 = n2 / de;
        var ned: f64 = num_even * d;
        d = 1.0 + ned;
        var dab: f64 = f64_abs(d);
        if (dab < tiny) { d = tiny; }
        var nec: f64 = num_even / c;
        c = 1.0 + nec;
        var cab: f64 = f64_abs(c);
        if (cab < tiny) { c = tiny; }
        d = 1.0 / d;
        var dc: f64 = d * c;
        h2 = h2 * dc;

        # The odd step: −(a + m)(a + b + m)x / ((a + 2m)(a + 2m + 1)).
        var am: f64 = a + mf;
        var abm: f64 = ab + mf;
        var o1: f64 = am * abm;
        var o2: f64 = o1 * x;
        var no2: f64 = -o2;
        var a2p1: f64 = a2m + 1.0;
        var dod: f64 = a2m * a2p1;
        var num_odd: f64 = no2 / dod;
        var nod: f64 = num_odd * d;
        d = 1.0 + nod;
        var dab2: f64 = f64_abs(d);
        if (dab2 < tiny) { d = tiny; }
        var noc: f64 = num_odd / c;
        c = 1.0 + noc;
        var cab2: f64 = f64_abs(c);
        if (cab2 < tiny) { c = tiny; }
        d = 1.0 / d;
        var delta: f64 = d * c;
        h2 = h2 * delta;
        var dm: f64 = delta - 1.0;
        var dma: f64 = f64_abs(dm);
        if (dma < eps) { break; }
    }
    var r: f64 = prefix * h2;
    return _pmn_clamp(r, 0.0, 1.0);
}

# (I_x(a, b), 1 − I_x(a, b)) within 8 ulp for a and b in [1e-3, 1e5] (T1, M2 part b5; ADR 009): up to max(a, b) =
# 1e9, probe P9's form, Rust's continued fraction on the side x < (a + 1)/(a + b + 2) with a double-double prefactor and
# loop, the smaller of x and y taken as exact, and TOMS 708's power series for a complement below 2^-6
# (src/betainc.cyr). 1.3.0's double-precision form, which part a4 proved at 0 ulp, is off by up to 583 ulp on §3.2's
# rows and 1.7×10⁵ near the mean; T1 replaces it there. Past max(a, b) = 1e9, as for gamma_inc, Rust's form stays as it
# is (ADR 009: no row less accurate than Rust): there the fraction needs more steps than any budget allows near the
# switch (5 ms a call at 1e9, 130 ms at 1e15), and its products overflow past about 1e154. An infinite shape gives
# (NaN, NaN), Rust's value, before the loop rather than after its 10⁶-step budget (part a4's finding).
# y is 1 − x, passed by the caller so that a caller who knows it exactly never rounds 1 − x; T1 recomputes the larger of
# the two from the smaller. (NaN, NaN) for any NaN argument or a shape ≤ 0; (0, 1) for x ≤ 0; (1, 0) for y ≤ 0.
#must_use
fn _pmn_beta_inc(a: f64, b: f64, x: f64, y: f64): (f64, f64) {
    var nan: f64 = _PMN_F64_NAN;
    if (x != x || y != y || a != a || b != b || a <= 0.0 || b <= 0.0) { return (nan, nan); }
    if (x <= 0.0) { return (0.0, 1.0); }
    if (y <= 0.0) { return (1.0, 0.0); }
    var inf: f64 = _PMN_F64_INFINITY;
    if (a == inf || b == inf) { return (nan, nan); }
    var big: f64 = 1000000000.0;                # 1e9, gamma_inc's T1 limit too
    if (a <= big && b <= big) {
        var tp, tq = _pmn_bi_beta_inc(a, b, x, y);
        return (tp, tq);
    }
    var a1: f64 = a + 1.0;
    var ab: f64 = a + b;
    var ab2: f64 = ab + 2.0;
    var split: f64 = a1 / ab2;
    if (x < split) {
        var p: f64 = _pmn_beta_cf(a, b, x, y);
        var q: f64 = 1.0 - p;
        return (p, q);
    }
    var q2: f64 = _pmn_beta_cf(b, a, y, x);
    var p2: f64 = 1.0 - q2;
    return (p2, q2);
}

# Rust's `regularized_incomplete_beta`: I_x(a, b), beta_inc's first value with y = 1 − x rounded.
#must_use
fn _pmn_regularized_incomplete_beta(x: f64, a: f64, b: f64): f64 {
    var y: f64 = 1.0 - x;
    var p, q = _pmn_beta_inc(a, b, x, y);
    return p;
}

# --- dist.cyr ---

# dist.cyr — the distributions' shared parts (port of Rust 1.3.0's src/distribution.rs; port plan D7, D11, §8.3; M3):
# the `Distribution` trait, the parameter checks every constructor makes, the Box–Muller variate the normal-based
# samplers draw, and Marsaglia and Tsang's Gamma(α, 1) variate the gamma-based ones draw.
#
# Each distribution is a `PmnX` struct filled in caller storage by `PmnX_new(out, …)` (D11), which returns
# PMN_ERR_NONE or PMN_ERR_INVALID_PARAMETER and writes `out` only on success, as Rust's `X::new` returns `Ok` or
# `Err(InvalidParameter)` (its message is dropped: D6, ADR 007 row 1). Every method keeps its Rust name. `sample` is
# generic over the caller's generator, `R: PmnRng`, so a draw is a static call, as Rust's monomorphized one is (D7 as
# amended after probe P2). Rust's values and operation order are the definition: every transcendental is the
# correctly rounded one (ADR 009), and every special function the T1 one.

# `cyrius lint` compiles a file alone, without the manifest, and a trait bound naming another module's trait doesn't
# compile there: this file and src/dist_cont.cyr include the module whose trait they name. An include of a file
# already included is skipped, and `cyrius distlib` leaves project includes out of the bundle.

trait PmnDistribution {
    # The probability density (or mass) at x.
    fn pdf(self, x: f64): f64;
    # The cumulative probability P(X ≤ x).
    fn cdf(self, x: f64): f64;
    # The expected value.
    fn mean(self): f64;
    # The variance.
    fn variance(self): f64;
    # One draw from the distribution, from the caller's generator.
    fn sample<R: PmnRng>(self, rng: *R): f64;
}

# Rust's `require_finite`: PMN_ERR_NONE when v is finite, else PMN_ERR_INVALID_PARAMETER.
#must_use
fn _pmn_require_finite(v: f64): i64 {
    if (_pmn_is_finite(v) == 1) { return PMN_ERR_NONE; }
    return PMN_ERR_INVALID_PARAMETER;
}

# Rust's `require_positive`: PMN_ERR_NONE when v is finite and strictly positive, else PMN_ERR_INVALID_PARAMETER.
#must_use
fn _pmn_require_positive(v: f64): i64 {
    if (_pmn_is_finite(v) == 1 && v > 0.0) { return PMN_ERR_NONE; }
    return PMN_ERR_INVALID_PARAMETER;
}

# Rust's `require_probability`: PMN_ERR_NONE when 0 ≤ v ≤ 1 (so never for NaN), else PMN_ERR_INVALID_PARAMETER.
#must_use
fn _pmn_require_probability(v: f64): i64 {
    if (v >= 0.0 && v <= 1.0) { return PMN_ERR_NONE; }
    return PMN_ERR_INVALID_PARAMETER;
}

# Rust's `standard_normal`: one N(0, 1) variate by Box–Muller's cosine branch, from two uniforms,
# √(−2 ln u1)·cos(2π u2), with u1 kept from 0 by f64::MIN_POSITIVE. In Rust's operation order, on the correctly
# rounded ln and cos.
#must_use
fn _pmn_standard_normal<R: PmnRng>(rng: *R): f64 {
    var d1: f64 = rng.next_f64();
    var mp: f64 = _PMN_F64_MIN_POSITIVE;
    var u1: f64 = _pmn_max(d1, mp);
    var u2: f64 = rng.next_f64();
    var l: f64 = _pmn_ln(u1);
    var a: f64 = -2.0 * l;
    var r: f64 = f64_sqrt(a);
    var tp: f64 = 2.0 * _PMN_F64_PI;
    var t: f64 = tp * u2;
    var c: f64 = _pmn_cos(t);
    return r * c;
}

# Rust's `sample_gamma_standard`: one Gamma(α, 1) variate by Marsaglia and Tsang's method, with the Ahrens–Dieter
# boost for α < 1 (a Gamma(α + 1, 1) variate times u^(1/α)), in Rust's operation order on the correctly rounded ln and
# pow and Box–Muller's normal. It backs the Gamma and χ² samplers (part b1), and the Beta, Student-t, F and Binomial
# ones to come. α is a constructor's, finite and positive: Rust's loop never ends on a NaN.
#must_use
fn _pmn_sample_gamma_standard<R: PmnRng>(alpha: f64, rng: *R): f64 {
    var mp: f64 = _PMN_F64_MIN_POSITIVE;
    var ea: f64 = alpha;
    var boost: f64 = 1.0;
    if (alpha < 1.0) {
        var d0: f64 = rng.next_f64();
        var u0: f64 = _pmn_max(d0, mp);
        ea = alpha + 1.0;
        var ia: f64 = 1.0 / alpha;
        boost = _pmn_powf(u0, ia);
    }
    var third: f64 = 1.0 / 3.0;
    var d: f64 = ea - third;
    var nd: f64 = 9.0 * d;
    var sq: f64 = f64_sqrt(nd);
    var c: f64 = 1.0 / sq;
    var sample: f64 = 0.0;
    while (1) {
        # A normal variate x with v = 1 + c·x positive, then v³.
        var x: f64 = 0.0;
        var v: f64 = 0.0;
        while (1) {
            x = _pmn_standard_normal(rng);
            var cx: f64 = c * x;
            v = 1.0 + cx;
            if (v > 0.0) { break; }
        }
        var vv: f64 = v * v;
        v = vv * v;
        var du: f64 = rng.next_f64();
        var u: f64 = _pmn_max(du, mp);
        # The squeeze, 1 − 0.0331·x⁴, as Rust multiplies it, left to right.
        var q: f64 = 0.0331 * x;
        q = q * x;
        q = q * x;
        q = q * x;
        var lim: f64 = 1.0 - q;
        if (u < lim) {
            sample = d * v;
            break;
        }
        # The full test: ln u < ½x² + d·(1 − v + ln v).
        var lu: f64 = _pmn_ln(u);
        var hx: f64 = 0.5 * x;
        hx = hx * x;
        var lv: f64 = _pmn_ln(v);
        var t: f64 = 1.0 - v;
        t = t + lv;
        var dt: f64 = d * t;
        var rhs: f64 = hx + dt;
        if (lu < rhs) {
            sample = d * v;
            break;
        }
    }
    return sample * boost;
}

# Reads n f64 fields of a struct by serde's rules (names[i] into the words at vals, at most 8), for the distributions'
# decoders, which then call their constructor.
#must_use
fn _pmn_dist_fields(root, names, n, vals): i64 {
    var sl[64];
    var e = _pmn_json_struct(root, names, n, &sl);
    if (e != PMN_ERR_NONE) { return e; }
    for (var i = 0; i < n; i = i + 1) {
        e = _pmn_json_f64(load64(&sl + i * 8), vals + i * 8);
        if (e != PMN_ERR_NONE) { return e; }
    }
    return PMN_ERR_NONE;
}

# --- dist_cont.cyr ---

# dist_cont.cyr — the continuous distributions of Rust 1.3.0's src/distribution.rs (port plan §4.1, D5, D7, D11, D12;
# M3 parts a1–a3): their constructors, the five `PmnDistribution` methods, serde_json's codec and the derived Debug.
# Normal (part a1), Uniform and Exponential (a2), Cauchy and Weibull (a3).
#
# Each is Rust's in its operation order on the correctly rounded primitives and the T1 special functions (ADR 009),
# so its values differ from 1.3.0's only where glibc misrounds or where T1 moves a special function. JSON is serde's
# derived form, `{"mean":0.0,"std_dev":1.0}`, written byte for byte as serde_json writes it (D5), and read through the
# validating constructor, as Rust's `#[serde(try_from = "…Repr")]` does: a document whose parameters the constructor
# refuses reads as PMN_ERR_DESERIALIZE, the code every serde_json error maps to (D6). Debug is the derive's form,
# `Normal { mean: 0.0, std_dev: 1.0 }` (D12).

# ── Normal (part a1) ────────────────────────────────────────────────────────────────────────────────

# Rust's `Normal`: the normal (Gaussian) distribution with mean `mean` and standard deviation `std_dev`.
struct PmnNormal {
    mean: f64;
    std_dev: f64;
}

# Rust's `Normal::new(mean, std_dev)` into out (caller storage, D11): PMN_ERR_NONE, or PMN_ERR_INVALID_PARAMETER,
# writing nothing, unless mean is finite and std_dev finite and positive, or for a null out.
#must_use
fn PmnNormal_new(out: *PmnNormal, mean: f64, std_dev: f64): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    var e = _pmn_require_finite(mean);
    if (e == PMN_ERR_NONE) { e = _pmn_require_positive(std_dev); }
    if (e != PMN_ERR_NONE) { return e; }
    out.mean = mean;
    out.std_dev = std_dev;
    return PMN_ERR_NONE;
}

impl PmnDistribution for PmnNormal {
    # Rust's `pdf`: (1/(σ·√(2π)))·exp(−½z²), z = (x − μ)/σ.
    #must_use
    fn pdf(self, x: f64): f64 {
        var m: f64 = self.mean;
        var s: f64 = self.std_dev;
        var d: f64 = x - m;
        var z: f64 = d / s;
        var tp: f64 = 2.0 * _PMN_F64_PI;
        var r: f64 = f64_sqrt(tp);
        var sr: f64 = s * r;
        var c: f64 = 1.0 / sr;
        var h: f64 = -0.5 * z;
        var q: f64 = h * z;
        var ex: f64 = _pmn_exp(q);
        return c * ex;
    }

    # Rust's `cdf`: Φ((x − μ)/σ), the T1 Φ (M2 part b2: within 0.5 + 2^-7 ulp of the true Φ of the rounded z).
    #must_use
    fn cdf(self, x: f64): f64 {
        var m: f64 = self.mean;
        var s: f64 = self.std_dev;
        var d: f64 = x - m;
        var z: f64 = d / s;
        return _pmn_normal_cdf(z);
    }

    # Rust's `mean`: μ.
    #must_use
    fn mean(self): f64 {
        var m: f64 = self.mean;
        return m;
    }

    # Rust's `variance`: σ·σ.
    #must_use
    fn variance(self): f64 {
        var s: f64 = self.std_dev;
        return s * s;
    }

    # Rust's `sample`: μ + σ·Z, Z from Box–Muller (`_pmn_standard_normal`), two uniforms a draw.
    #must_use
    fn sample<R: PmnRng>(self, rng: *R): f64 {
        var m: f64 = self.mean;
        var s: f64 = self.std_dev;
        var z: f64 = _pmn_standard_normal(rng);
        var t: f64 = s * z;
        return m + t;
    }
}

impl PmnNormal {
    # Appends Rust's Debug (D12): `Normal { mean: 0.0, std_dev: 1.0 }` for `{:?}` (alternate 0), or
    # `Normal {\n    mean: 0.0,\n    std_dev: 1.0,\n}` for `{:#?}` (1). PMN_ERR_NONE, or PMN_ERR_OUT_OF_MEMORY when sb
    # can't grow.
    #must_use
    fn debug(self, sb, alternate): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var m: f64 = self.mean;
        var s: f64 = self.std_dev;
        var e = _pmn_dbg_open(sb, "Normal", 1, alternate);
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item(sb, "mean", 1, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_f64(sb, m); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item_end(sb, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item(sb, "std_dev", 0, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_f64(sb, s); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item_end(sb, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_close(sb, 1, alternate); }
        return e;
    }

    # Appends serde_json's text, `{"mean":M,"std_dev":S}`: PMN_ERR_NONE, or PMN_ERR_OUT_OF_MEMORY when sb can't grow.
    #must_use
    fn to_json(self, sb): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var m: f64 = self.mean;
        var s: f64 = self.std_dev;
        var e = _pmn_json_w_key(sb, "mean", 1);
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_f64(sb, m); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_key(sb, "std_dev", 0); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_f64(sb, s); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_lit(sb, "}"); }
        return e;
    }
}

# The decoder for PmnNormal_from_json: NormalRepr's two f64 fields by serde's struct rules, then `Normal::new`, whose
# refusal serde_json reports as an error (PMN_ERR_DESERIALIZE).
fn _pmn_normal_from_root(root, out): i64 {
    var names[16];
    store64(&names, "mean");
    store64(&names + 8, "std_dev");
    var v[16];
    var e = _pmn_dist_fields(root, &names, 2, &v);
    if (e != PMN_ERR_NONE) { return e; }
    var m: f64 = load64(&v);
    var s: f64 = load64(&v + 8);
    if (PmnNormal_new(out, m, s) != PMN_ERR_NONE) { return PMN_ERR_DESERIALIZE; }
    return PMN_ERR_NONE;
}

# Reads a Normal document, buf[0, len), into out (caller storage): PMN_ERR_NONE, PMN_ERR_DESERIALIZE for any document
# serde_json refuses (its parameters included: a std_dev ≤ 0, as `Normal::new` refuses it), or PMN_ERR_OUT_OF_MEMORY.
#must_use
fn PmnNormal_from_json(out: *PmnNormal, buf, len): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    return _pmn_json_decode(buf, len, &_pmn_normal_from_root, out);
}

# ── Uniform (part a2) ───────────────────────────────────────────────────────────────────────────────

# Rust's `Uniform`: the continuous uniform distribution on [min, max].
struct PmnUniform {
    min: f64;
    max: f64;
}

# Rust's `Uniform::new(min, max)` into out (caller storage, D11): PMN_ERR_NONE, or PMN_ERR_INVALID_PARAMETER, writing
# nothing, unless both bounds are finite, min < max, and the width max − min is finite; or for a null out.
#must_use
fn PmnUniform_new(out: *PmnUniform, min: f64, max: f64): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    var e = _pmn_require_finite(min);
    if (e == PMN_ERR_NONE) { e = _pmn_require_finite(max); }
    if (e != PMN_ERR_NONE) { return e; }
    if (min >= max) { return PMN_ERR_INVALID_PARAMETER; }
    var w: f64 = max - min;
    if (_pmn_is_finite(w) == 0) { return PMN_ERR_INVALID_PARAMETER; }
    out.min = min;
    out.max = max;
    return PMN_ERR_NONE;
}

impl PmnDistribution for PmnUniform {
    # Rust's `pdf`: 1/(max − min) on [min, max], else 0 (and 0 at NaN, whose comparisons are false).
    #must_use
    fn pdf(self, x: f64): f64 {
        var lo: f64 = self.min;
        var hi: f64 = self.max;
        if (x >= lo && x <= hi) {
            var w: f64 = hi - lo;
            return 1.0 / w;
        }
        return 0.0;
    }

    # Rust's `cdf`: 0 below min, 1 above max, else (x − min)/(max − min) (NaN at NaN).
    #must_use
    fn cdf(self, x: f64): f64 {
        var lo: f64 = self.min;
        var hi: f64 = self.max;
        if (x < lo) { return 0.0; }
        if (x > hi) { return 1.0; }
        var d: f64 = x - lo;
        var w: f64 = hi - lo;
        return d / w;
    }

    # Rust's `mean`: (min + max)/2.
    #must_use
    fn mean(self): f64 {
        var lo: f64 = self.min;
        var hi: f64 = self.max;
        var t: f64 = lo + hi;
        return t / 2.0;
    }

    # Rust's `variance`: (max − min)²/12, as range·range/12.
    #must_use
    fn variance(self): f64 {
        var lo: f64 = self.min;
        var hi: f64 = self.max;
        var r: f64 = hi - lo;
        var r2: f64 = r * r;
        return r2 / 12.0;
    }

    # Rust's `sample`: min + U·(max − min), one uniform a draw.
    #must_use
    fn sample<R: PmnRng>(self, rng: *R): f64 {
        var lo: f64 = self.min;
        var hi: f64 = self.max;
        var u: f64 = rng.next_f64();
        var w: f64 = hi - lo;
        var t: f64 = u * w;
        return lo + t;
    }
}

impl PmnUniform {
    # Appends Rust's Debug (D12): `Uniform { min: 0.0, max: 1.0 }`, or its alternate form. PMN_ERR_NONE, or
    # PMN_ERR_OUT_OF_MEMORY when sb can't grow.
    #must_use
    fn debug(self, sb, alternate): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var lo: f64 = self.min;
        var hi: f64 = self.max;
        var e = _pmn_dbg_open(sb, "Uniform", 1, alternate);
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item(sb, "min", 1, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_f64(sb, lo); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item_end(sb, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item(sb, "max", 0, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_f64(sb, hi); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item_end(sb, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_close(sb, 1, alternate); }
        return e;
    }

    # Appends serde_json's text, `{"min":A,"max":B}`: PMN_ERR_NONE, or PMN_ERR_OUT_OF_MEMORY when sb can't grow.
    #must_use
    fn to_json(self, sb): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var lo: f64 = self.min;
        var hi: f64 = self.max;
        var e = _pmn_json_w_key(sb, "min", 1);
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_f64(sb, lo); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_key(sb, "max", 0); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_f64(sb, hi); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_lit(sb, "}"); }
        return e;
    }
}

# The decoder for PmnUniform_from_json: UniformRepr's two f64 fields, then `Uniform::new`.
fn _pmn_uniform_from_root(root, out): i64 {
    var names[16];
    store64(&names, "min");
    store64(&names + 8, "max");
    var v[16];
    var e = _pmn_dist_fields(root, &names, 2, &v);
    if (e != PMN_ERR_NONE) { return e; }
    var lo: f64 = load64(&v);
    var hi: f64 = load64(&v + 8);
    if (PmnUniform_new(out, lo, hi) != PMN_ERR_NONE) { return PMN_ERR_DESERIALIZE; }
    return PMN_ERR_NONE;
}

# Reads a Uniform document, buf[0, len), into out (caller storage): PMN_ERR_NONE, PMN_ERR_DESERIALIZE for any document
# serde_json refuses (min ≥ max among them), or PMN_ERR_OUT_OF_MEMORY.
#must_use
fn PmnUniform_from_json(out: *PmnUniform, buf, len): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    return _pmn_json_decode(buf, len, &_pmn_uniform_from_root, out);
}

# ── Exponential (part a2) ───────────────────────────────────────────────────────────────────────────

# Rust's `Exponential`: the exponential distribution with rate `lambda`.
struct PmnExponential {
    lambda: f64;
}

# Rust's `Exponential::new(lambda)` into out (caller storage, D11): PMN_ERR_NONE, or PMN_ERR_INVALID_PARAMETER, writing
# nothing, unless lambda is finite and positive; or for a null out.
#must_use
fn PmnExponential_new(out: *PmnExponential, lambda: f64): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    var e = _pmn_require_positive(lambda);
    if (e != PMN_ERR_NONE) { return e; }
    out.lambda = lambda;
    return PMN_ERR_NONE;
}

impl PmnDistribution for PmnExponential {
    # Rust's `pdf`: λ·exp(−λx) for x ≥ 0, else 0 (NaN at NaN).
    #must_use
    fn pdf(self, x: f64): f64 {
        if (x < 0.0) { return 0.0; }
        var l: f64 = self.lambda;
        var nl: f64 = -l;
        var t: f64 = nl * x;
        var ex: f64 = _pmn_exp(t);
        return l * ex;
    }

    # Rust's `cdf`: 1 − exp(−λx) as −expm1(−λx), for x ≥ 0, else 0 (NaN at NaN).
    #must_use
    fn cdf(self, x: f64): f64 {
        if (x < 0.0) { return 0.0; }
        var l: f64 = self.lambda;
        var nl: f64 = -l;
        var t: f64 = nl * x;
        var em: f64 = _pmn_exp_m1(t);
        return -em;
    }

    # Rust's `mean`: 1/λ.
    #must_use
    fn mean(self): f64 {
        var l: f64 = self.lambda;
        return 1.0 / l;
    }

    # Rust's `variance`: 1/(λ·λ).
    #must_use
    fn variance(self): f64 {
        var l: f64 = self.lambda;
        var l2: f64 = l * l;
        return 1.0 / l2;
    }

    # Rust's `sample`, by the inverse CDF: −ln(1 − U)/λ, with U kept from 0 by f64::MIN_POSITIVE.
    #must_use
    fn sample<R: PmnRng>(self, rng: *R): f64 {
        var d: f64 = rng.next_f64();
        var mp: f64 = _PMN_F64_MIN_POSITIVE;
        var u: f64 = _pmn_max(d, mp);
        var c: f64 = 1.0 - u;
        var lc: f64 = _pmn_ln(c);
        var nlc: f64 = -lc;
        var l: f64 = self.lambda;
        return nlc / l;
    }
}

impl PmnExponential {
    # Appends Rust's Debug (D12): `Exponential { lambda: 1.0 }`, or its alternate form. PMN_ERR_NONE, or
    # PMN_ERR_OUT_OF_MEMORY when sb can't grow.
    #must_use
    fn debug(self, sb, alternate): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var l: f64 = self.lambda;
        var e = _pmn_dbg_open(sb, "Exponential", 1, alternate);
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item(sb, "lambda", 1, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_f64(sb, l); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item_end(sb, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_close(sb, 1, alternate); }
        return e;
    }

    # Appends serde_json's text, `{"lambda":L}`: PMN_ERR_NONE, or PMN_ERR_OUT_OF_MEMORY when sb can't grow.
    #must_use
    fn to_json(self, sb): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var l: f64 = self.lambda;
        var e = _pmn_json_w_key(sb, "lambda", 1);
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_f64(sb, l); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_lit(sb, "}"); }
        return e;
    }
}

# The decoder for PmnExponential_from_json: ExponentialRepr's one f64 field, then `Exponential::new`.
fn _pmn_exponential_from_root(root, out): i64 {
    var names[8];
    store64(&names, "lambda");
    var v[8];
    var e = _pmn_dist_fields(root, &names, 1, &v);
    if (e != PMN_ERR_NONE) { return e; }
    var l: f64 = load64(&v);
    if (PmnExponential_new(out, l) != PMN_ERR_NONE) { return PMN_ERR_DESERIALIZE; }
    return PMN_ERR_NONE;
}

# Reads an Exponential document, buf[0, len), into out (caller storage): PMN_ERR_NONE, PMN_ERR_DESERIALIZE for any
# document serde_json refuses (a lambda ≤ 0 among them), or PMN_ERR_OUT_OF_MEMORY.
#must_use
fn PmnExponential_from_json(out: *PmnExponential, buf, len): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    return _pmn_json_decode(buf, len, &_pmn_exponential_from_root, out);
}

# ── Cauchy (part a3) ────────────────────────────────────────────────────────────────────────────────

# Rust's `Cauchy`: the Cauchy distribution with location `x0` and scale `gamma`.
struct PmnCauchy {
    x0: f64;
    gamma: f64;
}

# Rust's `Cauchy::new(x0, gamma)` into out (caller storage, D11): PMN_ERR_NONE, or PMN_ERR_INVALID_PARAMETER, writing
# nothing, unless x0 is finite and gamma finite and positive; or for a null out.
#must_use
fn PmnCauchy_new(out: *PmnCauchy, x0: f64, gamma: f64): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    var e = _pmn_require_finite(x0);
    if (e == PMN_ERR_NONE) { e = _pmn_require_positive(gamma); }
    if (e != PMN_ERR_NONE) { return e; }
    out.x0 = x0;
    out.gamma = gamma;
    return PMN_ERR_NONE;
}

impl PmnDistribution for PmnCauchy {
    # Rust's `pdf`: 1/(π·γ·(1 + z²)), z = (x − x0)/γ.
    #must_use
    fn pdf(self, x: f64): f64 {
        var x0: f64 = self.x0;
        var g: f64 = self.gamma;
        var d: f64 = x - x0;
        var z: f64 = d / g;
        var pi: f64 = _PMN_F64_PI;
        var pg: f64 = pi * g;
        var zz: f64 = z * z;
        var q: f64 = 1.0 + zz;
        var den: f64 = pg * q;
        return 1.0 / den;
    }

    # Rust's `cdf`: (1/π)·atan((x − x0)/γ) + ½, on the correctly rounded atan.
    #must_use
    fn cdf(self, x: f64): f64 {
        var x0: f64 = self.x0;
        var g: f64 = self.gamma;
        var pi: f64 = _PMN_F64_PI;
        var ip: f64 = 1.0 / pi;
        var d: f64 = x - x0;
        var z: f64 = d / g;
        var a: f64 = _pmn_atan(z);
        var r: f64 = ip * a;
        return r + 0.5;
    }

    # Rust's `mean`: undefined, NaN.
    #must_use
    fn mean(self): f64 {
        var nan: f64 = _PMN_F64_NAN;
        return nan;
    }

    # Rust's `variance`: undefined, NaN.
    #must_use
    fn variance(self): f64 {
        var nan: f64 = _PMN_F64_NAN;
        return nan;
    }

    # Rust's `sample`, the inverse cdf: x0 + γ·tan(π·(u − ½)), on the correctly rounded tan.
    #must_use
    fn sample<R: PmnRng>(self, rng: *R): f64 {
        var u: f64 = rng.next_f64();
        var pi: f64 = _PMN_F64_PI;
        var h: f64 = u - 0.5;
        var t: f64 = pi * h;
        var tn: f64 = _pmn_tan(t);
        var g: f64 = self.gamma;
        var gt: f64 = g * tn;
        var x0: f64 = self.x0;
        return x0 + gt;
    }
}

impl PmnCauchy {
    # Appends Rust's Debug (D12): `Cauchy { x0: 0.0, gamma: 1.0 }`, or its alternate form. PMN_ERR_NONE, or
    # PMN_ERR_OUT_OF_MEMORY when sb can't grow.
    #must_use
    fn debug(self, sb, alternate): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var x0: f64 = self.x0;
        var g: f64 = self.gamma;
        var e = _pmn_dbg_open(sb, "Cauchy", 1, alternate);
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item(sb, "x0", 1, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_f64(sb, x0); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item_end(sb, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item(sb, "gamma", 0, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_f64(sb, g); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item_end(sb, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_close(sb, 1, alternate); }
        return e;
    }

    # Appends serde_json's text, `{"x0":X,"gamma":G}`: PMN_ERR_NONE, or PMN_ERR_OUT_OF_MEMORY when sb can't grow.
    #must_use
    fn to_json(self, sb): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var x0: f64 = self.x0;
        var g: f64 = self.gamma;
        var e = _pmn_json_w_key(sb, "x0", 1);
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_f64(sb, x0); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_key(sb, "gamma", 0); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_f64(sb, g); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_lit(sb, "}"); }
        return e;
    }
}

# The decoder for PmnCauchy_from_json: CauchyRepr's two f64 fields, then `Cauchy::new`.
fn _pmn_cauchy_from_root(root, out): i64 {
    var names[16];
    store64(&names, "x0");
    store64(&names + 8, "gamma");
    var v[16];
    var e = _pmn_dist_fields(root, &names, 2, &v);
    if (e != PMN_ERR_NONE) { return e; }
    var x0: f64 = load64(&v);
    var g: f64 = load64(&v + 8);
    if (PmnCauchy_new(out, x0, g) != PMN_ERR_NONE) { return PMN_ERR_DESERIALIZE; }
    return PMN_ERR_NONE;
}

# Reads a Cauchy document, buf[0, len), into out (caller storage): PMN_ERR_NONE, PMN_ERR_DESERIALIZE for any document
# serde_json refuses (a gamma the constructor refuses among them), or PMN_ERR_OUT_OF_MEMORY.
#must_use
fn PmnCauchy_from_json(out: *PmnCauchy, buf, len): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    return _pmn_json_decode(buf, len, &_pmn_cauchy_from_root, out);
}

# ── Weibull (part a3) ───────────────────────────────────────────────────────────────────────────────

# Rust's `Weibull`: the Weibull distribution with shape `k` and scale `lambda`.
struct PmnWeibull {
    k: f64;
    lambda: f64;
}

# Rust's `Weibull::new(k, lambda)` into out (caller storage, D11): PMN_ERR_NONE, or PMN_ERR_INVALID_PARAMETER, writing
# nothing, unless k and lambda are both finite and positive; or for a null out.
#must_use
fn PmnWeibull_new(out: *PmnWeibull, k: f64, lambda: f64): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    var e = _pmn_require_positive(k);
    if (e == PMN_ERR_NONE) { e = _pmn_require_positive(lambda); }
    if (e != PMN_ERR_NONE) { return e; }
    out.k = k;
    out.lambda = lambda;
    return PMN_ERR_NONE;
}

# Γ(1 + j/k) as Rust computes it, exp(lnΓ(1 + j/k)), on the T1 lnΓ and the correctly rounded exp: the Weibull
# moments' factor.
#must_use
fn _pmn_weibull_g(j: f64, k: f64): f64 {
    var q: f64 = j / k;
    var a: f64 = 1.0 + q;
    var lg: f64 = _pmn_ln_gamma(a);
    var r: f64 = _pmn_exp(lg);
    return r;
}

impl PmnDistribution for PmnWeibull {
    # Rust's `pdf`: (k/λ)·z^(k−1)·exp(−z^k), z = x/λ, for x > 0; 0 below 0; at 0, 1/λ for k = 1, 0 for k > 1 and +∞
    # for k < 1. On the correctly rounded pow and exp.
    #must_use
    fn pdf(self, x: f64): f64 {
        if (x < 0.0) { return 0.0; }
        var k: f64 = self.k;
        var l: f64 = self.lambda;
        if (x == 0.0) {
            if (k == 1.0) { return 1.0 / l; }
            if (k > 1.0) { return 0.0; }
            var inf: f64 = _PMN_F64_INFINITY;
            return inf;
        }
        var z: f64 = x / l;
        var kl: f64 = k / l;
        var km1: f64 = k - 1.0;
        var p1: f64 = _pmn_powf(z, km1);
        var p2: f64 = _pmn_powf(z, k);
        var np2: f64 = -p2;
        var ex: f64 = _pmn_exp(np2);
        var a: f64 = kl * p1;
        return a * ex;
    }

    # Rust's `cdf`: −expm1(−(x/λ)^k) for x > 0, else 0 (NaN at NaN). On the correctly rounded pow and expm1.
    #must_use
    fn cdf(self, x: f64): f64 {
        if (x <= 0.0) { return 0.0; }
        var k: f64 = self.k;
        var l: f64 = self.lambda;
        var z: f64 = x / l;
        var p: f64 = _pmn_powf(z, k);
        var np: f64 = -p;
        var em: f64 = _pmn_exp_m1(np);
        return -em;
    }

    # Rust's `mean`: λ·Γ(1 + 1/k), Γ as exp(lnΓ) on the T1 lnΓ.
    #must_use
    fn mean(self): f64 {
        var k: f64 = self.k;
        var g1: f64 = _pmn_weibull_g(1.0, k);
        var l: f64 = self.lambda;
        return l * g1;
    }

    # Rust's `variance`: λ²·(Γ(1 + 2/k) − Γ(1 + 1/k)²), in Rust's order, (λ·λ)·(g2 − g1·g1).
    #must_use
    fn variance(self): f64 {
        var k: f64 = self.k;
        var g1: f64 = _pmn_weibull_g(1.0, k);
        var g2: f64 = _pmn_weibull_g(2.0, k);
        var l: f64 = self.lambda;
        var ll: f64 = l * l;
        var gg: f64 = g1 * g1;
        var d: f64 = g2 - gg;
        return ll * d;
    }

    # Rust's `sample`, the inverse cdf: λ·(−ln(1 − u))^(1/k), with u kept from 0 by f64::MIN_POSITIVE. On the
    # correctly rounded ln and pow.
    #must_use
    fn sample<R: PmnRng>(self, rng: *R): f64 {
        var d: f64 = rng.next_f64();
        var mp: f64 = _PMN_F64_MIN_POSITIVE;
        var u: f64 = _pmn_max(d, mp);
        var c: f64 = 1.0 - u;
        var lc: f64 = _pmn_ln(c);
        var nlc: f64 = -lc;
        var k: f64 = self.k;
        var ik: f64 = 1.0 / k;
        var p: f64 = _pmn_powf(nlc, ik);
        var l: f64 = self.lambda;
        return l * p;
    }
}

impl PmnWeibull {
    # Appends Rust's Debug (D12): `Weibull { k: 2.0, lambda: 1.0 }`, or its alternate form. PMN_ERR_NONE, or
    # PMN_ERR_OUT_OF_MEMORY when sb can't grow.
    #must_use
    fn debug(self, sb, alternate): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var k: f64 = self.k;
        var l: f64 = self.lambda;
        var e = _pmn_dbg_open(sb, "Weibull", 1, alternate);
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item(sb, "k", 1, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_f64(sb, k); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item_end(sb, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item(sb, "lambda", 0, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_f64(sb, l); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item_end(sb, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_close(sb, 1, alternate); }
        return e;
    }

    # Appends serde_json's text, `{"k":K,"lambda":L}`: PMN_ERR_NONE, or PMN_ERR_OUT_OF_MEMORY when sb can't grow.
    #must_use
    fn to_json(self, sb): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var k: f64 = self.k;
        var l: f64 = self.lambda;
        var e = _pmn_json_w_key(sb, "k", 1);
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_f64(sb, k); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_key(sb, "lambda", 0); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_f64(sb, l); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_lit(sb, "}"); }
        return e;
    }
}

# The decoder for PmnWeibull_from_json: WeibullRepr's two f64 fields, then `Weibull::new`.
fn _pmn_weibull_from_root(root, out): i64 {
    var names[16];
    store64(&names, "k");
    store64(&names + 8, "lambda");
    var v[16];
    var e = _pmn_dist_fields(root, &names, 2, &v);
    if (e != PMN_ERR_NONE) { return e; }
    var k: f64 = load64(&v);
    var l: f64 = load64(&v + 8);
    if (PmnWeibull_new(out, k, l) != PMN_ERR_NONE) { return PMN_ERR_DESERIALIZE; }
    return PMN_ERR_NONE;
}

# Reads a Weibull document, buf[0, len), into out (caller storage): PMN_ERR_NONE, PMN_ERR_DESERIALIZE for any document
# serde_json refuses (a shape or scale the constructor refuses among them), or PMN_ERR_OUT_OF_MEMORY.
#must_use
fn PmnWeibull_from_json(out: *PmnWeibull, buf, len): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    return _pmn_json_decode(buf, len, &_pmn_weibull_from_root, out);
}

# --- dist_gamma.cyr ---

# dist_gamma.cyr — the gamma family of Rust 1.3.0's src/distribution.rs (port plan §4.1, D5, D7, D11, D12; M3 parts
# b1 and b2): their constructors, the five `PmnDistribution` methods, serde_json's codec and the derived Debug, as
# src/dist_cont.cyr's. Gamma and ChiSquared (part b1); Beta, StudentT and FDistribution (b2), with Rust's Student-t
# and F tails, which the hypothesis tests (M4) share.
#
# Their densities take lnΓ or ln B and their cdfs the regularized incomplete gamma or beta, all T1 (ADR 009): a row
# downstream of them is Rust's formula on T1's value. Their draws are Marsaglia and Tsang's,
# `_pmn_sample_gamma_standard` in src/dist.cyr.

# ── Gamma (part b1) ─────────────────────────────────────────────────────────────────────────────────

# Rust's `Gamma`: the gamma distribution with shape `alpha` and scale `beta`.
struct PmnGamma {
    alpha: f64;
    beta: f64;
}

# Rust's `Gamma::new(alpha, beta)` into out (caller storage, D11): PMN_ERR_NONE, or PMN_ERR_INVALID_PARAMETER, writing
# nothing, unless alpha and beta are both finite and positive; or for a null out.
#must_use
fn PmnGamma_new(out: *PmnGamma, alpha: f64, beta: f64): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    var e = _pmn_require_positive(alpha);
    if (e == PMN_ERR_NONE) { e = _pmn_require_positive(beta); }
    if (e != PMN_ERR_NONE) { return e; }
    out.alpha = alpha;
    out.beta = beta;
    return PMN_ERR_NONE;
}

impl PmnDistribution for PmnGamma {
    # Rust's `pdf`: exp((α − 1)·ln x − x/β − α·ln β − lnΓ(α)) for x > 0, else 0 (NaN at NaN). On the correctly rounded
    # ln and exp and the T1 lnΓ, in Rust's order, left to right.
    #must_use
    fn pdf(self, x: f64): f64 {
        if (x <= 0.0) { return 0.0; }
        var a: f64 = self.alpha;
        var b: f64 = self.beta;
        var am1: f64 = a - 1.0;
        var lx: f64 = _pmn_ln(x);
        var t1: f64 = am1 * lx;
        var xb: f64 = x / b;
        var lb: f64 = _pmn_ln(b);
        var alb: f64 = a * lb;
        var lg: f64 = _pmn_ln_gamma(a);
        var s: f64 = t1 - xb;
        s = s - alb;
        s = s - lg;
        var r: f64 = _pmn_exp(s);
        return r;
    }

    # Rust's `cdf`: P(α, x/β), the T1 regularized lower incomplete gamma, for x > 0, else 0 (NaN at NaN).
    #must_use
    fn cdf(self, x: f64): f64 {
        if (x <= 0.0) { return 0.0; }
        var a: f64 = self.alpha;
        var b: f64 = self.beta;
        var xb: f64 = x / b;
        var p: f64 = _pmn_regularized_lower_incomplete_gamma(a, xb);
        return p;
    }

    # Rust's `mean`: α·β.
    #must_use
    fn mean(self): f64 {
        var a: f64 = self.alpha;
        var b: f64 = self.beta;
        return a * b;
    }

    # Rust's `variance`: α·β·β, left to right.
    #must_use
    fn variance(self): f64 {
        var a: f64 = self.alpha;
        var b: f64 = self.beta;
        var ab: f64 = a * b;
        return ab * b;
    }

    # Rust's `sample`: a Gamma(α, 1) variate times β.
    #must_use
    fn sample<R: PmnRng>(self, rng: *R): f64 {
        var a: f64 = self.alpha;
        var g: f64 = _pmn_sample_gamma_standard(a, rng);
        var b: f64 = self.beta;
        return g * b;
    }
}

impl PmnGamma {
    # Appends Rust's Debug (D12): `Gamma { alpha: 2.0, beta: 1.0 }`, or its alternate form. PMN_ERR_NONE, or
    # PMN_ERR_OUT_OF_MEMORY when sb can't grow.
    #must_use
    fn debug(self, sb, alternate): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var a: f64 = self.alpha;
        var b: f64 = self.beta;
        var e = _pmn_dbg_open(sb, "Gamma", 1, alternate);
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item(sb, "alpha", 1, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_f64(sb, a); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item_end(sb, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item(sb, "beta", 0, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_f64(sb, b); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item_end(sb, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_close(sb, 1, alternate); }
        return e;
    }

    # Appends serde_json's text, `{"alpha":A,"beta":B}`: PMN_ERR_NONE, or PMN_ERR_OUT_OF_MEMORY when sb can't grow.
    #must_use
    fn to_json(self, sb): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var a: f64 = self.alpha;
        var b: f64 = self.beta;
        var e = _pmn_json_w_key(sb, "alpha", 1);
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_f64(sb, a); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_key(sb, "beta", 0); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_f64(sb, b); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_lit(sb, "}"); }
        return e;
    }
}

# The decoder for PmnGamma_from_json: GammaRepr's two f64 fields, then `Gamma::new`.
fn _pmn_gamma_from_root(root, out): i64 {
    var names[16];
    store64(&names, "alpha");
    store64(&names + 8, "beta");
    var v[16];
    var e = _pmn_dist_fields(root, &names, 2, &v);
    if (e != PMN_ERR_NONE) { return e; }
    var a: f64 = load64(&v);
    var b: f64 = load64(&v + 8);
    if (PmnGamma_new(out, a, b) != PMN_ERR_NONE) { return PMN_ERR_DESERIALIZE; }
    return PMN_ERR_NONE;
}

# Reads a Gamma document, buf[0, len), into out (caller storage): PMN_ERR_NONE, PMN_ERR_DESERIALIZE for any document
# serde_json refuses (a shape or scale the constructor refuses among them), or PMN_ERR_OUT_OF_MEMORY.
#must_use
fn PmnGamma_from_json(out: *PmnGamma, buf, len): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    return _pmn_json_decode(buf, len, &_pmn_gamma_from_root, out);
}

# ── ChiSquared (part b1) ────────────────────────────────────────────────────────────────────────────

# Rust's `ChiSquared`: the χ² distribution with `df` degrees of freedom, Gamma(df/2, 2).
struct PmnChiSquared {
    df: f64;
}

# Rust's `ChiSquared::new(df)` into out (caller storage, D11): PMN_ERR_NONE, or PMN_ERR_INVALID_PARAMETER, writing
# nothing, unless df is finite and positive; or for a null out.
#must_use
fn PmnChiSquared_new(out: *PmnChiSquared, df: f64): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    var e = _pmn_require_positive(df);
    if (e != PMN_ERR_NONE) { return e; }
    out.df = df;
    return PMN_ERR_NONE;
}

impl PmnDistribution for PmnChiSquared {
    # Rust's `pdf`: exp((k − 1)·ln x − x/2 − k·ln 2 − lnΓ(k)), k = df/2, for x > 0, else 0 (NaN at NaN). On the
    # correctly rounded ln and exp and the T1 lnΓ, in Rust's order, left to right.
    #must_use
    fn pdf(self, x: f64): f64 {
        if (x <= 0.0) { return 0.0; }
        var df: f64 = self.df;
        var k: f64 = df / 2.0;
        var km1: f64 = k - 1.0;
        var lx: f64 = _pmn_ln(x);
        var t1: f64 = km1 * lx;
        var x2: f64 = x / 2.0;
        var l2: f64 = _pmn_ln(2.0);
        var kl2: f64 = k * l2;
        var lg: f64 = _pmn_ln_gamma(k);
        var s: f64 = t1 - x2;
        s = s - kl2;
        s = s - lg;
        var r: f64 = _pmn_exp(s);
        return r;
    }

    # Rust's `cdf`: P(df/2, x/2), the T1 regularized lower incomplete gamma, for x > 0, else 0 (NaN at NaN).
    #must_use
    fn cdf(self, x: f64): f64 {
        if (x <= 0.0) { return 0.0; }
        var df: f64 = self.df;
        var k: f64 = df / 2.0;
        var x2: f64 = x / 2.0;
        var p: f64 = _pmn_regularized_lower_incomplete_gamma(k, x2);
        return p;
    }

    # Rust's `mean`: df.
    #must_use
    fn mean(self): f64 {
        var df: f64 = self.df;
        return df;
    }

    # Rust's `variance`: 2·df.
    #must_use
    fn variance(self): f64 {
        var df: f64 = self.df;
        return 2.0 * df;
    }

    # Rust's `sample`: a Gamma(df/2, 1) variate times 2.
    #must_use
    fn sample<R: PmnRng>(self, rng: *R): f64 {
        var df: f64 = self.df;
        var k: f64 = df / 2.0;
        var g: f64 = _pmn_sample_gamma_standard(k, rng);
        return g * 2.0;
    }
}

impl PmnChiSquared {
    # Appends Rust's Debug (D12): `ChiSquared { df: 3.0 }`, or its alternate form. PMN_ERR_NONE, or
    # PMN_ERR_OUT_OF_MEMORY when sb can't grow.
    #must_use
    fn debug(self, sb, alternate): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var df: f64 = self.df;
        var e = _pmn_dbg_open(sb, "ChiSquared", 1, alternate);
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item(sb, "df", 1, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_f64(sb, df); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item_end(sb, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_close(sb, 1, alternate); }
        return e;
    }

    # Appends serde_json's text, `{"df":D}`: PMN_ERR_NONE, or PMN_ERR_OUT_OF_MEMORY when sb can't grow.
    #must_use
    fn to_json(self, sb): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var df: f64 = self.df;
        var e = _pmn_json_w_key(sb, "df", 1);
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_f64(sb, df); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_lit(sb, "}"); }
        return e;
    }
}

# The decoder for PmnChiSquared_from_json: ChiSquaredRepr's one f64 field, then `ChiSquared::new`.
fn _pmn_chi_squared_from_root(root, out): i64 {
    var names[8];
    store64(&names, "df");
    var v[8];
    var e = _pmn_dist_fields(root, &names, 1, &v);
    if (e != PMN_ERR_NONE) { return e; }
    var df: f64 = load64(&v);
    if (PmnChiSquared_new(out, df) != PMN_ERR_NONE) { return PMN_ERR_DESERIALIZE; }
    return PMN_ERR_NONE;
}

# Reads a ChiSquared document, buf[0, len), into out (caller storage): PMN_ERR_NONE, PMN_ERR_DESERIALIZE for any
# document serde_json refuses (a df the constructor refuses among them), or PMN_ERR_OUT_OF_MEMORY.
#must_use
fn PmnChiSquared_from_json(out: *PmnChiSquared, buf, len): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    return _pmn_json_decode(buf, len, &_pmn_chi_squared_from_root, out);
}

# ── Beta (part b2) ──────────────────────────────────────────────────────────────────────────────────

# Rust's `Beta`: the beta distribution on [0, 1] with shapes `alpha` and `beta`.
struct PmnBeta {
    alpha: f64;
    beta: f64;
}

# Rust's `Beta::new(alpha, beta)` into out (caller storage, D11): PMN_ERR_NONE, or PMN_ERR_INVALID_PARAMETER, writing
# nothing, unless alpha and beta are both finite and positive; or for a null out.
#must_use
fn PmnBeta_new(out: *PmnBeta, alpha: f64, beta: f64): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    var e = _pmn_require_positive(alpha);
    if (e == PMN_ERR_NONE) { e = _pmn_require_positive(beta); }
    if (e != PMN_ERR_NONE) { return e; }
    out.alpha = alpha;
    out.beta = beta;
    return PMN_ERR_NONE;
}

impl PmnDistribution for PmnBeta {
    # Rust's `pdf`: exp((α − 1)·ln x + (β − 1)·ln(1 − x) − ln B(α, β)) on (0, 1), else 0 (NaN at NaN), ln(1 − x) as
    # ln_1p(−x). On the correctly rounded ln, ln_1p and exp and ln B on the T1 lnΓ.
    #must_use
    fn pdf(self, x: f64): f64 {
        if (x <= 0.0 || x >= 1.0) { return 0.0; }
        var a: f64 = self.alpha;
        var b: f64 = self.beta;
        var am1: f64 = a - 1.0;
        var lx: f64 = _pmn_ln(x);
        var t1: f64 = am1 * lx;
        var bm1: f64 = b - 1.0;
        var nx: f64 = -x;
        var ly: f64 = _pmn_ln_1p(nx);
        var t2: f64 = bm1 * ly;
        var lb: f64 = _pmn_ln_beta(a, b);
        var s: f64 = t1 + t2;
        s = s - lb;
        var r: f64 = _pmn_exp(s);
        return r;
    }

    # Rust's `cdf`: 0 at and below 0, 1 from 1, else I_x(α, β), the T1 regularized incomplete beta (NaN at NaN).
    #must_use
    fn cdf(self, x: f64): f64 {
        if (x <= 0.0) { return 0.0; }
        if (x >= 1.0) { return 1.0; }
        var a: f64 = self.alpha;
        var b: f64 = self.beta;
        var r: f64 = _pmn_regularized_incomplete_beta(x, a, b);
        return r;
    }

    # Rust's `mean`: α/(α + β).
    #must_use
    fn mean(self): f64 {
        var a: f64 = self.alpha;
        var b: f64 = self.beta;
        var ab: f64 = a + b;
        return a / ab;
    }

    # Rust's `variance`: α·β/((α + β)²·(α + β + 1)), as Rust groups it.
    #must_use
    fn variance(self): f64 {
        var a: f64 = self.alpha;
        var b: f64 = self.beta;
        var ab: f64 = a + b;
        var num: f64 = a * b;
        var ab2: f64 = ab * ab;
        var ab1: f64 = ab + 1.0;
        var den: f64 = ab2 * ab1;
        return num / den;
    }

    # Rust's `sample`, the gamma ratio: X/(X + Y), X a Gamma(α, 1) variate and Y a Gamma(β, 1) one, drawn in that
    # order.
    #must_use
    fn sample<R: PmnRng>(self, rng: *R): f64 {
        var a: f64 = self.alpha;
        var b: f64 = self.beta;
        var gx: f64 = _pmn_sample_gamma_standard(a, rng);
        var gy: f64 = _pmn_sample_gamma_standard(b, rng);
        var t: f64 = gx + gy;
        return gx / t;
    }
}

impl PmnBeta {
    # Appends Rust's Debug (D12): `Beta { alpha: 2.0, beta: 5.0 }`, or its alternate form. PMN_ERR_NONE, or
    # PMN_ERR_OUT_OF_MEMORY when sb can't grow.
    #must_use
    fn debug(self, sb, alternate): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var a: f64 = self.alpha;
        var b: f64 = self.beta;
        var e = _pmn_dbg_open(sb, "Beta", 1, alternate);
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item(sb, "alpha", 1, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_f64(sb, a); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item_end(sb, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item(sb, "beta", 0, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_f64(sb, b); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item_end(sb, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_close(sb, 1, alternate); }
        return e;
    }

    # Appends serde_json's text, `{"alpha":A,"beta":B}`: PMN_ERR_NONE, or PMN_ERR_OUT_OF_MEMORY when sb can't grow.
    #must_use
    fn to_json(self, sb): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var a: f64 = self.alpha;
        var b: f64 = self.beta;
        var e = _pmn_json_w_key(sb, "alpha", 1);
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_f64(sb, a); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_key(sb, "beta", 0); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_f64(sb, b); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_lit(sb, "}"); }
        return e;
    }
}

# The decoder for PmnBeta_from_json: BetaRepr's two f64 fields, then `Beta::new`.
fn _pmn_beta_from_root(root, out): i64 {
    var names[16];
    store64(&names, "alpha");
    store64(&names + 8, "beta");
    var v[16];
    var e = _pmn_dist_fields(root, &names, 2, &v);
    if (e != PMN_ERR_NONE) { return e; }
    var a: f64 = load64(&v);
    var b: f64 = load64(&v + 8);
    if (PmnBeta_new(out, a, b) != PMN_ERR_NONE) { return PMN_ERR_DESERIALIZE; }
    return PMN_ERR_NONE;
}

# Reads a Beta document, buf[0, len), into out (caller storage): PMN_ERR_NONE, PMN_ERR_DESERIALIZE for any document
# serde_json refuses (a shape the constructor refuses among them), or PMN_ERR_OUT_OF_MEMORY.
#must_use
fn PmnBeta_from_json(out: *PmnBeta, buf, len): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    return _pmn_json_decode(buf, len, &_pmn_beta_from_root, out);
}

# ── StudentT (part b2) ──────────────────────────────────────────────────────────────────────────────

# Rust's `student_t_two_tailed`: P(|T| ≥ |t|) = I_x(df/2, ½) with x = 1/(1 + t²/df) and its complement
# y = 1/(1 + df/t²), both formed without cancellation, on the T1 incomplete beta; clamped to [0, 1]. NaN when t or df
# is. The hypothesis tests (M4) share it.
#must_use
fn _pmn_student_t_two_tailed(t: f64, df: f64): f64 {
    if (t != t || df != df) {
        var nan: f64 = _PMN_F64_NAN;
        return nan;
    }
    var t2: f64 = t * t;
    var q1: f64 = t2 / df;
    var d1: f64 = 1.0 + q1;
    var x: f64 = 1.0 / d1;
    var q2: f64 = df / t2;
    var d2: f64 = 1.0 + q2;
    var y: f64 = 1.0 / d2;
    var h: f64 = df / 2.0;
    var i, c = _pmn_beta_inc(h, 0.5, x, y);
    var r: f64 = _pmn_clamp(i, 0.0, 1.0);
    return r;
}

# Rust's `student_t_cdf`: 1 − ½·P(|T| ≥ |t|) for t ≥ 0, ½·P(|T| ≥ |t|) below, so each tail keeps its accuracy.
#must_use
fn _pmn_student_t_cdf(t: f64, df: f64): f64 {
    var tt: f64 = _pmn_student_t_two_tailed(t, df);
    var h: f64 = 0.5 * tt;
    if (t >= 0.0) { return 1.0 - h; }
    return h;
}

# Rust's `StudentT`: Student's t distribution with `df` degrees of freedom.
struct PmnStudentT {
    df: f64;
}

# Rust's `StudentT::new(df)` into out (caller storage, D11): PMN_ERR_NONE, or PMN_ERR_INVALID_PARAMETER, writing
# nothing, unless df is finite and positive; or for a null out.
#must_use
fn PmnStudentT_new(out: *PmnStudentT, df: f64): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    var e = _pmn_require_positive(df);
    if (e != PMN_ERR_NONE) { return e; }
    out.df = df;
    return PMN_ERR_NONE;
}

impl PmnDistribution for PmnStudentT {
    # Rust's `pdf`, as exp of its log. From df = 20, −ln B(ν/2, ½) − ½·ln ν − ((ν + 1)/2)·ln_1p(x²/ν), as the two lnΓ
    # cancel there; below, lnΓ((ν + 1)/2) − lnΓ(ν/2) − ½·ln(νπ) − ((ν + 1)/2)·ln(1 + x²/ν). On the correctly rounded
    # primitives and the T1 lnΓ.
    #must_use
    fn pdf(self, x: f64): f64 {
        var df: f64 = self.df;
        var dp1: f64 = df + 1.0;
        var h: f64 = dp1 / 2.0;
        var xx: f64 = x * x;
        var q: f64 = xx / df;
        var s: f64 = 0.0;
        if (df >= 20.0) {
            var hd: f64 = df / 2.0;
            var lb: f64 = _pmn_ln_beta(hd, 0.5);
            var ld: f64 = _pmn_ln(df);
            var hld: f64 = 0.5 * ld;
            var lq: f64 = _pmn_ln_1p(q);
            var hlq: f64 = h * lq;
            s = -lb;
            s = s - hld;
            s = s - hlq;
        } else {
            var lg1: f64 = _pmn_ln_gamma(h);
            var hd2: f64 = df / 2.0;
            var lg2: f64 = _pmn_ln_gamma(hd2);
            var pi: f64 = _PMN_F64_PI;
            var dpi: f64 = df * pi;
            var ldp: f64 = _pmn_ln(dpi);
            var hldp: f64 = 0.5 * ldp;
            var q1: f64 = 1.0 + q;
            var lq1: f64 = _pmn_ln(q1);
            var hlq1: f64 = h * lq1;
            s = lg1 - lg2;
            s = s - hldp;
            s = s - hlq1;
        }
        var r: f64 = _pmn_exp(s);
        return r;
    }

    # Rust's `cdf`: `student_t_cdf`.
    #must_use
    fn cdf(self, x: f64): f64 {
        var df: f64 = self.df;
        var r: f64 = _pmn_student_t_cdf(x, df);
        return r;
    }

    # Rust's `mean`: 0 for df > 1, else undefined, NaN.
    #must_use
    fn mean(self): f64 {
        var df: f64 = self.df;
        if (df > 1.0) { return 0.0; }
        var nan: f64 = _PMN_F64_NAN;
        return nan;
    }

    # Rust's `variance`: df/(df − 2) for df > 2, +∞ for 1 < df ≤ 2, else NaN.
    #must_use
    fn variance(self): f64 {
        var df: f64 = self.df;
        if (df > 2.0) {
            var d2: f64 = df - 2.0;
            return df / d2;
        }
        if (df > 1.0) {
            var inf: f64 = _PMN_F64_INFINITY;
            return inf;
        }
        var nan: f64 = _PMN_F64_NAN;
        return nan;
    }

    # Rust's `sample`: Z/√(V/df), Z from Box–Muller and then V a χ²(df) variate, 2·Gamma(df/2, 1).
    #must_use
    fn sample<R: PmnRng>(self, rng: *R): f64 {
        var z: f64 = _pmn_standard_normal(rng);
        var df: f64 = self.df;
        var hd: f64 = df / 2.0;
        var g: f64 = _pmn_sample_gamma_standard(hd, rng);
        var v: f64 = g * 2.0;
        var vd: f64 = v / df;
        var sq: f64 = f64_sqrt(vd);
        return z / sq;
    }
}

impl PmnStudentT {
    # Appends Rust's Debug (D12): `StudentT { df: 3.0 }`, or its alternate form. PMN_ERR_NONE, or
    # PMN_ERR_OUT_OF_MEMORY when sb can't grow.
    #must_use
    fn debug(self, sb, alternate): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var df: f64 = self.df;
        var e = _pmn_dbg_open(sb, "StudentT", 1, alternate);
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item(sb, "df", 1, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_f64(sb, df); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item_end(sb, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_close(sb, 1, alternate); }
        return e;
    }

    # Appends serde_json's text, `{"df":D}`: PMN_ERR_NONE, or PMN_ERR_OUT_OF_MEMORY when sb can't grow.
    #must_use
    fn to_json(self, sb): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var df: f64 = self.df;
        var e = _pmn_json_w_key(sb, "df", 1);
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_f64(sb, df); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_lit(sb, "}"); }
        return e;
    }
}

# The decoder for PmnStudentT_from_json: StudentTRepr's one f64 field, then `StudentT::new`.
fn _pmn_student_t_from_root(root, out): i64 {
    var names[8];
    store64(&names, "df");
    var v[8];
    var e = _pmn_dist_fields(root, &names, 1, &v);
    if (e != PMN_ERR_NONE) { return e; }
    var df: f64 = load64(&v);
    if (PmnStudentT_new(out, df) != PMN_ERR_NONE) { return PMN_ERR_DESERIALIZE; }
    return PMN_ERR_NONE;
}

# Reads a StudentT document, buf[0, len), into out (caller storage): PMN_ERR_NONE, PMN_ERR_DESERIALIZE for any
# document serde_json refuses (a df the constructor refuses among them), or PMN_ERR_OUT_OF_MEMORY.
#must_use
fn PmnStudentT_from_json(out: *PmnStudentT, buf, len): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    return _pmn_json_decode(buf, len, &_pmn_student_t_from_root, out);
}

# ── FDistribution (part b2) ─────────────────────────────────────────────────────────────────────────

# Rust's `f_cdf_sf`: (the cdf, the survival) of F(d1, d2) at x, each without cancellation, as the T1 incomplete
# beta's (I_u, 1 − I_u) at u = d1x/(d1x + d2) and its complement v = d2/(d1x + d2), each formed directly. (NaN, NaN)
# at NaN, (0, 1) at and below 0. The hypothesis tests (M4) share it.
#must_use
fn _pmn_f_cdf_sf(x: f64, d1: f64, d2: f64): (f64, f64) {
    if (x != x) {
        var nan: f64 = _PMN_F64_NAN;
        return (nan, nan);
    }
    if (x <= 0.0) { return (0.0, 1.0); }
    var dx: f64 = d1 * x;
    var r: f64 = dx / d2;
    var ir: f64 = 1.0 / r;
    var du: f64 = 1.0 + ir;
    var u: f64 = 1.0 / du;
    var dv: f64 = 1.0 + r;
    var v: f64 = 1.0 / dv;
    var h1: f64 = d1 / 2.0;
    var h2: f64 = d2 / 2.0;
    var c, s = _pmn_beta_inc(h1, h2, u, v);
    return (c, s);
}

# Rust's `FDistribution`: Fisher–Snedecor's F with `d1` and `d2` degrees of freedom.
struct PmnFDistribution {
    d1: f64;
    d2: f64;
}

# Rust's `FDistribution::new(d1, d2)` into out (caller storage, D11): PMN_ERR_NONE, or PMN_ERR_INVALID_PARAMETER,
# writing nothing, unless d1 and d2 are both finite and positive; or for a null out.
#must_use
fn PmnFDistribution_new(out: *PmnFDistribution, d1: f64, d2: f64): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    var e = _pmn_require_positive(d1);
    if (e == PMN_ERR_NONE) { e = _pmn_require_positive(d2); }
    if (e != PMN_ERR_NONE) { return e; }
    out.d1 = d1;
    out.d2 = d2;
    return PMN_ERR_NONE;
}

impl PmnDistribution for PmnFDistribution {
    # Rust's `pdf`: exp(h1·ln(d1/d2) + (h1 − 1)·ln x − (h1 + h2)·ln_1p(d1x/d2) − ln B(h1, h2)), h = d/2, for x > 0,
    # else 0 (NaN at NaN). On the correctly rounded primitives and ln B on the T1 lnΓ.
    #must_use
    fn pdf(self, x: f64): f64 {
        if (x <= 0.0) { return 0.0; }
        var d1: f64 = self.d1;
        var d2: f64 = self.d2;
        var h1: f64 = d1 / 2.0;
        var h2: f64 = d2 / 2.0;
        var rd: f64 = d1 / d2;
        var lrd: f64 = _pmn_ln(rd);
        var t1: f64 = h1 * lrd;
        var h1m1: f64 = h1 - 1.0;
        var lx: f64 = _pmn_ln(x);
        var t2: f64 = h1m1 * lx;
        var hs: f64 = h1 + h2;
        var dx: f64 = d1 * x;
        var q: f64 = dx / d2;
        var lq: f64 = _pmn_ln_1p(q);
        var t3: f64 = hs * lq;
        var lb: f64 = _pmn_ln_beta(h1, h2);
        var s: f64 = t1 + t2;
        s = s - t3;
        s = s - lb;
        var r: f64 = _pmn_exp(s);
        return r;
    }

    # Rust's `cdf`: `f_cdf_sf`'s first value.
    #must_use
    fn cdf(self, x: f64): f64 {
        var d1: f64 = self.d1;
        var d2: f64 = self.d2;
        var c, s = _pmn_f_cdf_sf(x, d1, d2);
        return c;
    }

    # Rust's `mean`: d2/(d2 − 2) for d2 > 2, else undefined, NaN.
    #must_use
    fn mean(self): f64 {
        var d2: f64 = self.d2;
        if (d2 > 2.0) {
            var dm: f64 = d2 - 2.0;
            return d2 / dm;
        }
        var nan: f64 = _PMN_F64_NAN;
        return nan;
    }

    # Rust's `variance`: 2·d2²·(d1 + d2 − 2)/(d1·(d2 − 2)²·(d2 − 4)) for d2 > 4, as Rust groups it, else NaN.
    #must_use
    fn variance(self): f64 {
        var d1: f64 = self.d1;
        var d2: f64 = self.d2;
        if (d2 > 4.0) {
            var n1: f64 = 2.0 * d2;
            n1 = n1 * d2;
            var sm: f64 = d1 + d2;
            sm = sm - 2.0;
            var num: f64 = n1 * sm;
            var m2: f64 = d2 - 2.0;
            var den: f64 = d1 * m2;
            den = den * m2;
            var m4: f64 = d2 - 4.0;
            den = den * m4;
            return num / den;
        }
        var nan: f64 = _PMN_F64_NAN;
        return nan;
    }

    # Rust's `sample`: (X1/d1)/(X2/d2), X1 and X2 χ² variates, 2·Gamma(d/2, 1), drawn in that order.
    #must_use
    fn sample<R: PmnRng>(self, rng: *R): f64 {
        var d1: f64 = self.d1;
        var d2: f64 = self.d2;
        var h1: f64 = d1 / 2.0;
        var g1: f64 = _pmn_sample_gamma_standard(h1, rng);
        var x1: f64 = g1 * 2.0;
        var h2: f64 = d2 / 2.0;
        var g2: f64 = _pmn_sample_gamma_standard(h2, rng);
        var x2: f64 = g2 * 2.0;
        var a: f64 = x1 / d1;
        var b: f64 = x2 / d2;
        return a / b;
    }
}

impl PmnFDistribution {
    # Appends Rust's Debug (D12): `FDistribution { d1: 4.0, d2: 9.0 }`, or its alternate form. PMN_ERR_NONE, or
    # PMN_ERR_OUT_OF_MEMORY when sb can't grow.
    #must_use
    fn debug(self, sb, alternate): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var d1: f64 = self.d1;
        var d2: f64 = self.d2;
        var e = _pmn_dbg_open(sb, "FDistribution", 1, alternate);
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item(sb, "d1", 1, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_f64(sb, d1); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item_end(sb, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item(sb, "d2", 0, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_f64(sb, d2); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item_end(sb, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_close(sb, 1, alternate); }
        return e;
    }

    # Appends serde_json's text, `{"d1":D1,"d2":D2}`: PMN_ERR_NONE, or PMN_ERR_OUT_OF_MEMORY when sb can't grow.
    #must_use
    fn to_json(self, sb): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var d1: f64 = self.d1;
        var d2: f64 = self.d2;
        var e = _pmn_json_w_key(sb, "d1", 1);
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_f64(sb, d1); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_key(sb, "d2", 0); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_f64(sb, d2); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_lit(sb, "}"); }
        return e;
    }
}

# The decoder for PmnFDistribution_from_json: FDistributionRepr's two f64 fields, then `FDistribution::new`.
fn _pmn_f_distribution_from_root(root, out): i64 {
    var names[16];
    store64(&names, "d1");
    store64(&names + 8, "d2");
    var v[16];
    var e = _pmn_dist_fields(root, &names, 2, &v);
    if (e != PMN_ERR_NONE) { return e; }
    var d1: f64 = load64(&v);
    var d2: f64 = load64(&v + 8);
    if (PmnFDistribution_new(out, d1, d2) != PMN_ERR_NONE) { return PMN_ERR_DESERIALIZE; }
    return PMN_ERR_NONE;
}

# Reads an FDistribution document, buf[0, len), into out (caller storage): PMN_ERR_NONE, PMN_ERR_DESERIALIZE for any
# document serde_json refuses (a degree of freedom the constructor refuses among them), or PMN_ERR_OUT_OF_MEMORY.
#must_use
fn PmnFDistribution_from_json(out: *PmnFDistribution, buf, len): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    return _pmn_json_decode(buf, len, &_pmn_f_distribution_from_root, out);
}

# --- dist_disc.cyr ---

# dist_disc.cyr — the discrete distributions of Rust 1.3.0's src/distribution.rs (port plan §4.1, D5, D7, D11, D12;
# M3 parts a2, c1, c2): their constructors, the five `PmnDistribution` methods, serde_json's codec and the derived
# Debug, as src/dist_cont.cyr's. Bernoulli (part a2) and Poisson (c1); Binomial arrives in part c2.

# ── Bernoulli (part a2) ─────────────────────────────────────────────────────────────────────────────

# Rust's `Bernoulli`: one trial with success probability `p`.
struct PmnBernoulli {
    p: f64;
}

# Rust's `Bernoulli::new(p)` into out (caller storage, D11): PMN_ERR_NONE, or PMN_ERR_INVALID_PARAMETER, writing
# nothing, unless 0 ≤ p ≤ 1 (so never for NaN); or for a null out.
#must_use
fn PmnBernoulli_new(out: *PmnBernoulli, p: f64): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    var e = _pmn_require_probability(p);
    if (e != PMN_ERR_NONE) { return e; }
    out.p = p;
    return PMN_ERR_NONE;
}

impl PmnDistribution for PmnBernoulli {
    # Rust's `pdf`, the mass: 1 − p within f64::EPSILON of 0, p within f64::EPSILON of 1, else 0.
    #must_use
    fn pdf(self, x: f64): f64 {
        var p: f64 = self.p;
        var eps: f64 = _PMN_F64_EPSILON;
        var ax: f64 = f64_abs(x);
        if (ax < eps) { return 1.0 - p; }
        var d: f64 = x - 1.0;
        var ad: f64 = f64_abs(d);
        if (ad < eps) { return p; }
        return 0.0;
    }

    # Rust's `cdf`: NaN at NaN, 0 below 0, 1 − p on [0, 1), 1 from 1.
    #must_use
    fn cdf(self, x: f64): f64 {
        if (x != x) {
            var nan: f64 = _PMN_F64_NAN;
            return nan;
        }
        if (x < 0.0) { return 0.0; }
        var p: f64 = self.p;
        if (x < 1.0) { return 1.0 - p; }
        return 1.0;
    }

    # Rust's `mean`: p.
    #must_use
    fn mean(self): f64 {
        var p: f64 = self.p;
        return p;
    }

    # Rust's `variance`: p·(1 − p).
    #must_use
    fn variance(self): f64 {
        var p: f64 = self.p;
        var q: f64 = 1.0 - p;
        return p * q;
    }

    # Rust's `sample`: 1 when a uniform is below p, else 0.
    #must_use
    fn sample<R: PmnRng>(self, rng: *R): f64 {
        var u: f64 = rng.next_f64();
        var p: f64 = self.p;
        if (u < p) { return 1.0; }
        return 0.0;
    }
}

impl PmnBernoulli {
    # Appends Rust's Debug (D12): `Bernoulli { p: 0.5 }`, or its alternate form. PMN_ERR_NONE, or
    # PMN_ERR_OUT_OF_MEMORY when sb can't grow.
    #must_use
    fn debug(self, sb, alternate): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var p: f64 = self.p;
        var e = _pmn_dbg_open(sb, "Bernoulli", 1, alternate);
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item(sb, "p", 1, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_f64(sb, p); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item_end(sb, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_close(sb, 1, alternate); }
        return e;
    }

    # Appends serde_json's text, `{"p":P}`: PMN_ERR_NONE, or PMN_ERR_OUT_OF_MEMORY when sb can't grow.
    #must_use
    fn to_json(self, sb): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var p: f64 = self.p;
        var e = _pmn_json_w_key(sb, "p", 1);
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_f64(sb, p); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_lit(sb, "}"); }
        return e;
    }
}

# The decoder for PmnBernoulli_from_json: BernoulliRepr's one f64 field, then `Bernoulli::new`.
fn _pmn_bernoulli_from_root(root, out): i64 {
    var names[8];
    store64(&names, "p");
    var v[8];
    var e = _pmn_dist_fields(root, &names, 1, &v);
    if (e != PMN_ERR_NONE) { return e; }
    var p: f64 = load64(&v);
    if (PmnBernoulli_new(out, p) != PMN_ERR_NONE) { return PMN_ERR_DESERIALIZE; }
    return PMN_ERR_NONE;
}

# Reads a Bernoulli document, buf[0, len), into out (caller storage): PMN_ERR_NONE, PMN_ERR_DESERIALIZE for any
# document serde_json refuses (a p outside [0, 1] among them), or PMN_ERR_OUT_OF_MEMORY.
#must_use
fn PmnBernoulli_from_json(out: *PmnBernoulli, buf, len): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    return _pmn_json_decode(buf, len, &_pmn_bernoulli_from_root, out);
}

# ── Poisson (part c1) ───────────────────────────────────────────────────────────────────────────────

# Rust's `POISSON_PTRS_THRESHOLD`: above this rate the sampler is PTRS, at and below it Knuth's multiplication.
var _PMN_POISSON_PTRS_THRESHOLD: f64 = 30.0;

# Rust's `sample_poisson_ptrs`: Hörmann's transformed rejection with squeeze (PTRS, 1993), valid for λ ≥ 10, in Rust's
# operation order on the correctly rounded ln and the kernel ln P(X = k) = ln_gamma_kernel(k + 1, λ) − ln λ. Two
# uniforms a try. λ is a constructor's, finite and above 30 (the oracle's hook takes λ ≥ 10).
#must_use
fn _pmn_sample_poisson_ptrs<R: PmnRng>(lambda: f64, rng: *R): f64 {
    var slam: f64 = f64_sqrt(lambda);
    var loglam: f64 = _pmn_ln(lambda);
    var b0: f64 = 2.53 * slam;
    var b: f64 = 0.931 + b0;
    var a0: f64 = 0.02483 * b;
    var a: f64 = -0.059 + a0;
    var b34: f64 = b - 3.4;
    var ia0: f64 = 1.1328 / b34;
    var inv_alpha: f64 = 1.1239 + ia0;
    var b2: f64 = b - 2.0;
    var vr0: f64 = 3.6224 / b2;
    var vr: f64 = 0.9277 - vr0;
    var lia: f64 = _pmn_ln(inv_alpha);
    while (1) {
        var du: f64 = rng.next_f64();
        var u: f64 = du - 0.5;
        var v: f64 = rng.next_f64();
        var au: f64 = f64_abs(u);
        var us: f64 = 0.5 - au;
        var a2: f64 = 2.0 * a;
        var q: f64 = a2 / us;
        q = q + b;
        q = q * u;
        q = q + lambda;
        q = q + 0.43;
        var k: f64 = f64_floor(q);
        if (us >= 0.07 && v <= vr) { return k; }
        var skip = 0;
        if (k < 0.0 || _pmn_is_finite(k) == 0) { skip = 1; }
        if (us < 0.013 && v > us) { skip = 1; }
        if (skip == 0) {
            var lv: f64 = _pmn_ln(v);
            var lhs: f64 = lv + lia;
            var uu: f64 = us * us;
            var t: f64 = a / uu;
            t = t + b;
            var lt: f64 = _pmn_ln(t);
            lhs = lhs - lt;
            var rhs: f64 = -lambda;
            if (k != 0.0) {
                var k1: f64 = k + 1.0;
                var kern: f64 = _pmn_ln_gamma_kernel(k1, lambda);
                rhs = kern - loglam;
            }
            if (lhs <= rhs) { return k; }
        }
    }
    return 0.0;
}

# Rust's `Poisson`: the Poisson distribution with rate `lambda`.
struct PmnPoisson {
    lambda: f64;
}

# Rust's `Poisson::new(lambda)` into out (caller storage, D11): PMN_ERR_NONE, or PMN_ERR_INVALID_PARAMETER, writing
# nothing, unless lambda is finite and positive; or for a null out.
#must_use
fn PmnPoisson_new(out: *PmnPoisson, lambda: f64): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    var e = _pmn_require_positive(lambda);
    if (e != PMN_ERR_NONE) { return e; }
    out.lambda = lambda;
    return PMN_ERR_NONE;
}

impl PmnDistribution for PmnPoisson {
    # Rust's `pdf`, the mass P(X = k) = λ^k e^-λ/k!: NaN at NaN; 0 below 0, off the integers (an exact comparison) and
    # at ∞; e^-λ at 0; else exp(ln_gamma_kernel(k + 1, λ) − ln λ), Loader's form, in O(1) and without cancellation.
    #must_use
    fn pdf(self, x: f64): f64 {
        if (x != x) {
            var nan: f64 = _PMN_F64_NAN;
            return nan;
        }
        var fr: f64 = _pmn_fract(x);
        if (x < 0.0 || fr != 0.0 || _pmn_is_finite(x) == 0) { return 0.0; }
        var l: f64 = self.lambda;
        var nl: f64 = -l;
        if (x == 0.0) {
            var e0: f64 = _pmn_exp(nl);
            return e0;
        }
        var x1: f64 = x + 1.0;
        var kern: f64 = _pmn_ln_gamma_kernel(x1, l);
        var ll: f64 = _pmn_ln(l);
        var s: f64 = kern - ll;
        var r: f64 = _pmn_exp(s);
        return r;
    }

    # Rust's `cdf`: P(X ≤ x) = Q(⌊x⌋ + 1, λ), the T1 regularized upper incomplete gamma; NaN at NaN, 0 below 0.
    #must_use
    fn cdf(self, x: f64): f64 {
        if (x != x) {
            var nan: f64 = _PMN_F64_NAN;
            return nan;
        }
        if (x < 0.0) { return 0.0; }
        var fl: f64 = f64_floor(x);
        var a: f64 = fl + 1.0;
        var l: f64 = self.lambda;
        var q: f64 = _pmn_regularized_upper_incomplete_gamma(a, l);
        return q;
    }

    # Rust's `mean`: λ.
    #must_use
    fn mean(self): f64 {
        var l: f64 = self.lambda;
        return l;
    }

    # Rust's `variance`: λ.
    #must_use
    fn variance(self): f64 {
        var l: f64 = self.lambda;
        return l;
    }

    # Rust's `sample`, exact: PTRS above λ = 30; at and below, Knuth's multiplication, the count of uniforms whose
    # running product stays above e^-λ.
    #must_use
    fn sample<R: PmnRng>(self, rng: *R): f64 {
        var l: f64 = self.lambda;
        var th: f64 = _PMN_POISSON_PTRS_THRESHOLD;
        if (l > th) {
            var pt: f64 = _pmn_sample_poisson_ptrs(l, rng);
            return pt;
        }
        var nl: f64 = -l;
        var lim: f64 = _pmn_exp(nl);
        var k = 0;
        var pr: f64 = 1.0;
        while (1) {
            k = k + 1;
            var u: f64 = rng.next_f64();
            pr = pr * u;
            if (pr <= lim) { break; }
        }
        var km: f64 = f64_from(k - 1);
        return km;
    }
}

impl PmnPoisson {
    # Appends Rust's Debug (D12): `Poisson { lambda: 3.5 }`, or its alternate form. PMN_ERR_NONE, or
    # PMN_ERR_OUT_OF_MEMORY when sb can't grow.
    #must_use
    fn debug(self, sb, alternate): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var l: f64 = self.lambda;
        var e = _pmn_dbg_open(sb, "Poisson", 1, alternate);
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item(sb, "lambda", 1, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_f64(sb, l); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_item_end(sb, alternate); }
        if (e == PMN_ERR_NONE) { e = _pmn_dbg_close(sb, 1, alternate); }
        return e;
    }

    # Appends serde_json's text, `{"lambda":L}`: PMN_ERR_NONE, or PMN_ERR_OUT_OF_MEMORY when sb can't grow.
    #must_use
    fn to_json(self, sb): i64 {
        if (self == 0) { return PMN_ERR_INVALID_PARAMETER; }
        var l: f64 = self.lambda;
        var e = _pmn_json_w_key(sb, "lambda", 1);
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_f64(sb, l); }
        if (e == PMN_ERR_NONE) { e = _pmn_json_w_lit(sb, "}"); }
        return e;
    }
}

# The decoder for PmnPoisson_from_json: PoissonRepr's one f64 field, then `Poisson::new`.
fn _pmn_poisson_from_root(root, out): i64 {
    var names[8];
    store64(&names, "lambda");
    var v[8];
    var e = _pmn_dist_fields(root, &names, 1, &v);
    if (e != PMN_ERR_NONE) { return e; }
    var l: f64 = load64(&v);
    if (PmnPoisson_new(out, l) != PMN_ERR_NONE) { return PMN_ERR_DESERIALIZE; }
    return PMN_ERR_NONE;
}

# Reads a Poisson document, buf[0, len), into out (caller storage): PMN_ERR_NONE, PMN_ERR_DESERIALIZE for any document
# serde_json refuses (a lambda the constructor refuses among them), or PMN_ERR_OUT_OF_MEMORY.
#must_use
fn PmnPoisson_from_json(out: *PmnPoisson, buf, len): i64 {
    if (out == 0) { return PMN_ERR_INVALID_PARAMETER; }
    return _pmn_json_decode(buf, len, &_pmn_poisson_from_root, out);
}
