    0x3C5AFC89088CB729, 0xBC1773EC70B99803, 0xBC2049A1E95FE1F7, 0xBC15902995DE94EF,
    0xBC10698D6C892967, 0x3C07FD07DD8E6B43, 0x3BF811F3054300C0, 0x3BE1C138C584E5D8,
    0xBBD91BDF43D1EA35, 0x3B98CCB23ED16378, 0x3B9E18438A6B48BE, 0x3B755E8BAFEA33AC,
    0x3B8D0156AFFDBC11, 0xBB7643B6FD841D17, 0xBB7B59478CCD48A2, 0xBB4BBE0E1359BE6C,
    0xBB5DE0792137E167, 0x3B33B24839A5D1E2, 0xBB3158C16E0E2054, 0x3B269B0D4D854AC3,
    0xBAE2BE263AE7D962, 0x3AF17BC5BF6B04A4, 0xBAFBF98C5790F889, 0xBAE602B4076A885C,
    0xBAD1AB8DB7603983, 0xBAC5020A4144EBBC, 0x3A955B39E2ADA0D7, 0x3AA9B7402FEA75CE,
    0x3A93546A6054C889, 0x3A7702C8E88DFB2D, 0xBA7BC696EF5C5F41, 0xBA6F8778B18E28E8,
    0xBA4A12830516DA70, 0xBA4EF7E0DA52D749, 0x3A39F401BC2B3D47, 0xBA2382C27A3837C4,
    0x3A1BBD35645D5E6B, 0xB9F847EFCFFEC60C, 0x39E30A5C43949674, 0xB9E0795F00482CD6,
    0x39C382E028127AE0, 0xB9BE229766CDD426, 0xB9BF793B0201B061, 0x39440669DE861CFC,
    0xB99523D4DA4741C2, 0xB97C32E4CD8DC1AD, 0xB962CDD7DB9C7BB2, 0x395E20F05E872CFF,
    0x394415C27D8F2836, 0xB91FC64B1982DA8B, 0x392AB440A48C4063, 0x392B91693F03C85B,
    0x39110B9AD7F1CED4, 0x38F564CDEF577D05, 0x38DB311229528611, 0x38C1760BF0B1F7E0,
    0x38D82901F929F664, 0xB8A512A56E6B5809, 0xB88C43874360A5FC, 0xB872ED04D9C77096,
    0xB896EA6B12420976
};

# --- gammainc.cyr ---

# gammainc.cyr — the regularized incomplete gamma P(a, x) and Q(a, x) within 4 ulp (T1, M2 part b4; port plan
# D3 = C, §3.4; ADR 009: ≤ 4 ulp for a in [1e-3, 1e5] and x > 0; for any other a up to 1e9, no row less accurate
# than Rust's).
#
# Probe P9's prototype (§5 step 9d-2), moved here unchanged but for names. It keeps Rust's two expansions, the series
# for P and Legendre's continued fraction for Q, with four changes:
# - the prefactor's exponent a ln x − x − lnΓ(a) is a double-double. Below a = 10, lnΓ(a) comes from the ζ series of
#   lnΓ(1 + f) (src/zeta_data.cyr) and an exact recurrence. From a = 10 it is Rust's cancellation-free kernel, with
#   u − ln(1 + u) as an exact series, or with ln(1 + u) taken as ln x − ln a so that u's rounding never enters.
#   kimiya's exp core takes the double-double;
# - the series and the continued fraction run in double-double and stop under 2^-62;
# - the split is at x = a, so a complement is taken only where it can't cancel: Q = 1 − P where P ≤ 0.64, and
#   P = 1 − Q where Q ≤ 1/2;
# - for a < 1 and x < 1.1, Q comes directly from (Γ(1 + a) − x^a − a·x^a·Σ (−x)^n/(n!(a + n)))/Γ(1 + a), not as
#   1 − P (Rust's 246-ulp row).
# Three fixes to P9's form, each found past its sets (a from 1e-3 to 1e5, x to 50a): the series stops on a bound of
# its tail, not on its last term; below a = 2^-512 its Σ/a is formed as Σ/(a·2^600), as Dekker's split overflowed into
# a NaN; and past x = 2^990 the result is (1, 0) directly, where the kernel overflowed the same way.
# Each result is rounded once; a subnormal one is rounded twice, by the final scaling, by at most 2^-1074. P9 measured
# it within 1.0 ulp (mean ≤ 0.25) on 360,400 rows against a 320-bit reference, where 1.3.0 is off by up to 485 ulp on
# §3.2's pairs and by 2.9×10⁹ in the deep lower tail. It costs 10–17× 1.3.0's form: every loop step is double-double.
#
# UPSTREAM(L8): ganita:docs/development/issues/2026-11-15-special-functions-scope-request.md
#   replace with ganita's incomplete gamma if it takes the special functions on, at ADR 009's bound; parity: every
#   gamma_inc row of special.ref.tsv

# lnΓ(1 + f) for 0 ≤ f < 1 as a double-double: −γf + Σ (−1)^k ζ(k)/k·f^k up to f = 1/2, and with y = f − 1,
# (1 − γ)y + Σ (−1)^k (ζ(k) − 1)/k·y^k above (terms below 2^-k and 4^-k: the sums stop under 2^-62 of the value).
#must_use
fn _pmn_gi_lngamma1p_dd(f: f64): (f64, f64) {
    if (f == 0.0) { return (0.0, 0.0); }
    var gh: f64 = _PMN_ZT_EULER_H;
    var gl: f64 = _PMN_ZT_EULER_L;
    var thr: f64 = 0x3C10000000000000;          # 0x1p-62
    var y: f64 = f;
    var ch: f64 = 0.0;
    var cl: f64 = 0.0;
    var useh = 1;
    if (f > 0.5) {
        y = f - 1.0;
        var oh, ol = _pmn_km_two_sum(1.0, -gh);
        var ol2: f64 = ol - gl;
        ch = oh;
        cl = ol2;
        useh = 0;
    } else {
        ch = -gh;
        cl = -gl;
    }
    var acc, accl = _pmn_dd_mul_d(ch, cl, y);
    var ph: f64 = y;
    var pl: f64 = 0.0;
    var k = 2;
    while (k <= 64) {
        var nh, nl = _pmn_dd_mul_d(ph, pl, y);
        ph = nh;
        pl = nl;
        var zh: f64 = load64(&_PMN_ZT_ZH + k * 8);
        var zl: f64 = load64(&_PMN_ZT_ZL + k * 8);
        if (useh == 0) {
            zh = load64(&_PMN_ZT_MH + k * 8);
            zl = load64(&_PMN_ZT_ML + k * 8);
        }
        var th, tl = _pmn_dd_mul(zh, zl, ph, pl);
        var fk: f64 = f64_from(k);
        var uh, ul = _pmn_dd_div(th, tl, fk, 0.0);
        if ((k & 1) == 1) {
            uh = -uh;
            ul = -ul;
        }
        var sh, sl = _pmn_dd_add(acc, accl, uh, ul);
        acc = sh;
        accl = sl;
        var au: f64 = f64_abs(uh);
        var aa: f64 = f64_abs(acc);
        var lim: f64 = aa * thr;
        if (au < lim) { break; }
        k = k + 1;
    }
    return (acc, accl);
}

# lnΓ(a) for 0 < a < 20 as a double-double: lnΓ(1 + f) − ln a below 1, else lnΓ(1 + f) + ln((1 + f)…(m − 1 + f))
# with a = m + f and the product a double-double (the incomplete gamma calls it below 10).
#must_use
fn _pmn_gi_lngamma_small_dd(a: f64): (f64, f64) {
    if (a < 1.0) {
        var gh, gl = _pmn_gi_lngamma1p_dd(a);
        var lh, ll = _pmn_dd_ln_any(a);
        var rh, rl = _pmn_dd_add(gh, gl, -lh, -ll);
        return (rh, rl);
    }
    var mf: f64 = f64_floor(a);
    var f: f64 = a - mf;
    var m = f64_to(mf);
    var g2h, g2l = _pmn_gi_lngamma1p_dd(f);
    if (m < 2) { return (g2h, g2l); }
    var zh, zl = _pmn_km_two_sum(1.0, f);
    var j = 2;
    while (j < m) {
        var fj: f64 = f64_from(j);
        var th, tl = _pmn_km_two_sum(fj, f);
        var nh, nl = _pmn_dd_mul(zh, zl, th, tl);
        zh = nh;
        zl = nl;
        j = j + 1;
    }
    var lzh, lzl = _pmn_dd_ln(zh);
    var cz: f64 = zl / zh;
    var lzl2: f64 = lzl + cz;
    var sh, sl = _pmn_dd_add(g2h, g2l, lzh, lzl2);
    return (sh, sl);
}

# The prefactor's exponent M = a ln x − x − lnΓ(a) as a double-double.
#must_use
fn _pmn_gi_lnpre(a: f64, x: f64): (f64, f64) {
    if (a < 10.0) {
        var lh, ll = _pmn_dd_ln_any(x);
        var th, tl = _pmn_dd_mul_d(lh, ll, a);
        var sh, sl = _pmn_dd_add(th, tl, -x, 0.0);
        var gh, gl = _pmn_gi_lngamma_small_dd(a);
        var mh, ml = _pmn_dd_add(sh, sl, -gh, -gl);
        return (mh, ml);
    }
    # a ≥ 10: −a·φ(u) + ½ ln a − ln √(2π) − stirling(a), u = (x − a)/a, φ(u) = u − ln(1 + u).
    var dh, dl = _pmn_km_two_sum(x, -a);
    var uh, ul = _pmn_dd_div(dh, dl, a, 0.0);
    var fh: f64 = 0.0;
    var fl: f64 = 0.0;
    var lah, lal = _pmn_dd_ln(a);
    var au: f64 = f64_abs(uh);
    if (au <= 0.25) {
        # φ(u) = Σ_{k≥2} (−u)^k/k, exactly enough: terms fall by 4 or more.
        var wh: f64 = -uh;
        var wl: f64 = -ul;
        var ph, pl = _pmn_dd_mul(wh, wl, wh, wl);
        var thr: f64 = 0x3C10000000000000;      # 0x1p-62
        var k = 2;
        while (k < 200) {
            var fk: f64 = f64_from(k);
            var th2, tl2 = _pmn_dd_div(ph, pl, fk, 0.0);
            var sh2, sl2 = _pmn_dd_add(fh, fl, th2, tl2);
            fh = sh2;
            fl = sl2;
            var at: f64 = f64_abs(th2);
            var af: f64 = f64_abs(fh);
            var lim: f64 = af * thr;
            if (at < lim) { break; }
            var nh, nl = _pmn_dd_mul(ph, pl, wh, wl);
            ph = nh;
            pl = nl;
            k = k + 1;
        }
    } else {
        # ln(1 + u) = ln x − ln a exactly, so u's rounding never enters the logarithm.
        var lxh, lxl = _pmn_dd_ln_any(x);
        var l1h, l1l = _pmn_dd_add(lxh, lxl, -lah, -lal);
        var ph2, pl2 = _pmn_dd_add(uh, ul, -l1h, -l1l);
        fh = ph2;
        fl = pl2;
    }
    var ah, al = _pmn_dd_mul_d(fh, fl, a);
    var hh: f64 = 0.5 * lah;
    var hl: f64 = 0.5 * lal;
    var pih: f64 = _PMN_KM_CR_SC_PIH;
    var pim: f64 = _PMN_KM_CR_SC_PIM;
    var tph: f64 = 2.0 * pih;
    var tpm: f64 = 2.0 * pim;
    var lph, lpl = _pmn_dd_ln(tph);
    var cp: f64 = tpm / tph;
    var lpl2: f64 = lpl + cp;
    var sph: f64 = 0.5 * lph;
    var spl: f64 = 0.5 * lpl2;
    var st: f64 = _pmn_stirling_error(a);       # Rust's series, as a ≥ 10
    var r1h, r1l = _pmn_dd_add(hh, hl, -ah, -al);
    var r2h, r2l = _pmn_dd_add(r1h, r1l, -sph, -spl);
    var r3h, r3l = _pmn_dd_add(r2h, r2l, -st, 0.0);
    return (r3h, r3l);
}

# e^M for a double-double M, as (h, l, E) with h + l = e^M/2^E near 2^-70; E = −100000 when e^M underflows.
#must_use
fn _pmn_gi_exp_dd(mh: f64, ml: f64): (f64, f64, i64) {
    var lo: f64 = -1100.0;
    if (mh < lo) { return (0.0, 0.0, 0 - 100000); }
    var h, l, e = _pmn_km_exp_core(mh, ml);
    return (h, l, e);
}

# The series Σ_{n≥0} Π_{k=1..n} x/(a + k) as a double-double, stopping once the tail is under 2^-62 of the sum: the
# terms after t_n are below t_n·r/(1 − r) with r = x/(a + n + 1), so the test is t_n·x < 2^-62·S·(a + n + 1 − x). P9
# stopped at t_n < 2^-62·S, which near x = a leaves a tail of t_n/(1 − r), about √a/9 terms' worth: 7 ulp at a = 1e9
# (M2 part b4's crverify set), 0.07 at 1e5.
#must_use
fn _pmn_gi_series(a: f64, x: f64): (f64, f64) {
    var sh: f64 = 1.0;
    var sl: f64 = 0.0;
    var th: f64 = 1.0;
    var tl: f64 = 0.0;
    var thr: f64 = 0x3C10000000000000;          # 0x1p-62
    var n = 1;
    var cap = 2000 + 100 * f64_to(f64_sqrt(a));
    while (n < cap) {
        var fnn: f64 = f64_from(n);
        var dh, dl = _pmn_km_two_sum(a, fnn);
        var qh, ql = _pmn_dd_div(x, 0.0, dh, dl);
        var mh, ml = _pmn_dd_mul(th, tl, qh, ql);
        th = mh;
        tl = ml;
        var nh, nl = _pmn_dd_add(sh, sl, th, tl);
        sh = nh;
        sl = nl;
        var axn: f64 = a - x;
        var gap: f64 = axn + (fnn + 1.0);
        var tx: f64 = th * x;
        var lim: f64 = sh * thr;
        var lim2: f64 = lim * gap;
        if (tx < lim2) { break; }
        n = n + 1;
    }
    return (sh, sl);
}

# Legendre's continued fraction for Γ(a, x)·e^x·x^-a by modified Lentz, in double-double, stopping when a step
# changes the value by under 2^-62.
#must_use
fn _pmn_gi_cf(a: f64, x: f64): (f64, f64) {
    var tiny: f64 = 0x0010000000000000;         # 0x1p-1022
    var bh, bl0 = _pmn_km_two_sum(x, -a);
    var b1h, b1l = _pmn_dd_add(bh, bl0, 1.0, 0.0);
    bh = b1h;
    var bl: f64 = b1l;
    var dh, dl = _pmn_dd_div(1.0, 0.0, bh, bl);
    var hh: f64 = dh;
    var hl: f64 = dl;
    var ch: f64 = 0.0;
    var cl: f64 = 0.0;
    var thr: f64 = 0x3C10000000000000;          # 0x1p-62
    var cap = 2000 + 100 * f64_to(f64_sqrt(a));
    var i = 1;
    while (i < cap) {
        var fi: f64 = f64_from(i);
        var ih, il = _pmn_km_two_sum(fi, -a);
        var anh, anl = _pmn_dd_mul_d(ih, il, fi);
        anh = -anh;
        anl = -anl;
        var b2h, b2l = _pmn_dd_add(bh, bl, 2.0, 0.0);
        bh = b2h;
        bl = b2l;
        var adh, adl = _pmn_dd_mul(anh, anl, dh, dl);
        var d2h, d2l = _pmn_dd_add(adh, adl, bh, bl);
        var dab: f64 = f64_abs(d2h);
        if (dab < tiny) {
            d2h = tiny;
            d2l = 0.0;
        }
        if (i == 1) {
            # c starts at "infinity", so the first c is b itself.
            ch = bh;
            cl = bl;
        } else {
            var qh, ql = _pmn_dd_div(anh, anl, ch, cl);
            var c2h, c2l = _pmn_dd_add(bh, bl, qh, ql);
            ch = c2h;
            cl = c2l;
        }
        var cab: f64 = f64_abs(ch);
        if (cab < tiny) {
            ch = tiny;
            cl = 0.0;
        }
        var rdh, rdl = _pmn_dd_div(1.0, 0.0, d2h, d2l);
        dh = rdh;
        dl = rdl;
        var delh, dell = _pmn_dd_mul(dh, dl, ch, cl);
        var nhh, nhl = _pmn_dd_mul(hh, hl, delh, dell);
        hh = nhh;
        hl = nhl;
        var dm1h, dm1l = _pmn_dd_add(delh, dell, -1.0, 0.0);
        var dev: f64 = f64_abs(dm1h);
        if (dev < thr) { break; }
        i = i + 1;
    }
    return (hh, hl);
}

# Q for a < 1 and x < 1.1, directly: (Γ(1 + a) − x^a − a·x^a·T)/Γ(1 + a), T = Σ_{n≥1} (−x)^n/(n!(a + n)),
# with Γ(1 + a) − 1 = expm1(lnΓ(1 + a)) and x^a − 1 = expm1(a ln x), all in double-double.
#must_use
fn _pmn_gi_small_q(a: f64, x: f64): f64 {
    var lgh, lgl = _pmn_gi_lngamma1p_dd(a);
    var g1h, g1l = _pmn_dd_expm1(lgh, lgl);
    var lxh, lxl = _pmn_dd_ln_any(x);
    var alh, all = _pmn_dd_mul_d(lxh, lxl, a);
    var p1h, p1l = _pmn_dd_expm1(alh, all);
    var th: f64 = 0.0;
    var tl: f64 = 0.0;
    var ch: f64 = 1.0;
    var cl: f64 = 0.0;
    var nx: f64 = -x;
    var thr: f64 = 0x3C10000000000000;          # 0x1p-62
    var n = 1;
    while (n < 80) {
        var fnn: f64 = f64_from(n);
        var mh, ml = _pmn_dd_mul_d(ch, cl, nx);
        var qh, ql = _pmn_dd_div(mh, ml, fnn, 0.0);
        ch = qh;
        cl = ql;
        var dh, dl = _pmn_km_two_sum(a, fnn);
        var uh, ul = _pmn_dd_div(ch, cl, dh, dl);
        var sh, sl = _pmn_dd_add(th, tl, uh, ul);
        th = sh;
        tl = sl;
        var au: f64 = f64_abs(uh);
        var as: f64 = f64_abs(th);
        var lim: f64 = as * thr;
        if (au < lim) { break; }
        n = n + 1;
    }
    var xah, xal = _pmn_dd_add(1.0, 0.0, p1h, p1l);
    var axh, axl = _pmn_dd_mul_d(xah, xal, a);
    var wh, wl = _pmn_dd_mul(axh, axl, th, tl);
    var dfh, dfl = _pmn_dd_add(g1h, g1l, -p1h, -p1l);
    var nmh, nml = _pmn_dd_add(dfh, dfl, -wh, -wl);
    var gmh, gml = _pmn_dd_add(1.0, 0.0, g1h, g1l);
    var qh2, ql2 = _pmn_dd_div(nmh, nml, gmh, gml);
    var r: f64 = qh2 + ql2;
    return r;
}

# T1 (P, Q) for 0 < a ≤ 1e9 (special.cyr's gamma_inc keeps Rust's Wilson–Hilferty form past 1e9). (NaN, NaN) for a NaN
# argument or a ≤ 0; (0, 1) for x ≤ 0 or a = +∞; (1, 0) for x = +∞; each as Rust's.
#must_use
fn _pmn_gi_gamma_inc(a: f64, x: f64): (f64, f64) {
    var nan: f64 = _PMN_F64_NAN;
    if (x != x || a != a || a <= 0.0) { return (nan, nan); }
    if (x <= 0.0) { return (0.0, 1.0); }
    var inf: f64 = _PMN_F64_INFINITY;
    if (x == inf) { return (1.0, 0.0); }
    if (a == inf) { return (0.0, 1.0); }
    # Past x = 2^990, Q is far below 2^-1075 for every a up to 1e9 (the exponent is about −x), and from a = 10 the
    # kernel's (x − a)/a and a·φ(u) would overflow Dekker's split near x = 2^996·a: (1, 0), which the underflowed
    # prefactor gives below (M2 part b4 found the NaN at x = f64::MAX; P9's sets stopped at 50a).
    var huge: f64 = 0x7DD0000000000000;         # 0x1p990
    if (x > huge) { return (1.0, 0.0); }
    var mh, ml = _pmn_gi_lnpre(a, x);
    var eh, el, e = _pmn_gi_exp_dd(mh, ml);
    if (x < a || (a < 1.0 && x < 1.1)) {
        var sh, sl = _pmn_gi_series(a, x);
        # Σ/a passes 2^996, where Dekker's split overflows, once a is below about 2^-995: below 2^-512 the sum is
        # divided by a·2^600 and the scale takes the 600 back, both exactly (M2 part b4 found the NaN at a = 1e-300;
        # P9's sets stopped at 1e-3).
        var ad: f64 = a;
        var es = e;
        var t512: f64 = 0x1FF0000000000000;    # 0x1p-512
        if (a < t512) {
            var p600: f64 = 0x6570000000000000; # 0x1p600
            ad = a * p600;
            es = e + 600;
        }
        var s2h, s2l = _pmn_dd_div(sh, sl, ad, 0.0);
        var ph, pl = _pmn_dd_mul(eh, el, s2h, s2l);
        var pr: f64 = ph + pl;
        var p: f64 = _pmn_dd_scale(pr, es);
        if (a < 1.0 && x < 1.1) {
            var qs: f64 = _pmn_gi_small_q(a, x);
            return (p, qs);
        }
        # Q = 1 − P, with P ≤ 0.64 here (x < a, a ≥ 1): the scaled double-double, then one rounding.
        var s: f64 = _pmn_km_cr_pow2(e);
        if (e < 0 - 1000) { s = 0.0; }
        var psh: f64 = ph * s;
        var psl: f64 = pl * s;
        var qh, ql = _pmn_dd_add(1.0, 0.0, -psh, -psl);
        var q: f64 = qh + ql;
        return (p, q);
    }
    var hh, hl = _pmn_gi_cf(a, x);
    var qqh, qql = _pmn_dd_mul(eh, el, hh, hl);
    var qr: f64 = qqh + qql;
    var q2: f64 = _pmn_dd_scale(qr, e);
    var s2: f64 = _pmn_km_cr_pow2(e);
    if (e < 0 - 1000) { s2 = 0.0; }
    var qsh: f64 = qqh * s2;
    var qsl: f64 = qql * s2;
    var p2h, p2l = _pmn_dd_add(1.0, 0.0, -qsh, -qsl);
    var p2: f64 = p2h + p2l;
    return (p2, q2);
}

# --- betainc.cyr ---

# betainc.cyr — the regularized incomplete beta I_x(a, b) and 1 − I_x(a, b) within 8 ulp (T1, M2 part b5; port plan
# D3 = C, §3.4; ADR 009: ≤ 8 ulp for a and b in [1e-3, 1e5] and x in [0, 1]; for other shapes, no row less accurate
# than Rust's).
#
# Probe P9's prototype (§5 step 9d-3), moved here unchanged but for names. It keeps Rust's continued fraction on the
# side x < (a + 1)/(a + b + 2), with four changes:
# - the smaller of x and y is taken as exact, and the other recomputed as 1 − it in double-double. Rust's API passes
#   both so that a caller who knows 1 − x can keep it;
# - the prefactor's exponent a ln x + b ln y − ln B(a, b) − ln a is a double-double, with lnΓ a double-double at every
#   argument: below 20 the ζ series and the recurrence (src/gammainc.cyr), from 20 Stirling, whose correction series
#   is a double-double too, on the whole argument;
# - the continued fraction runs in double-double and stops at 2^-62;
# - a complement below 2^-6 is computed directly. That happens only for a small first shape below its switch, where
#   b·x ≲ 1. The direct form is TOMS 708's power series (bpser): 1 − I = (aB − x^a − a·x^a·S)/(aB),
#   S = Σ_{j≥1} (1 − b)_j/j!·x^j/(a + j), with aB − 1 and x^a − 1 as expm1s of double-doubles.
# Five fixes to P9's form, each found past its sets (a and b in [1e-3, 1e5], y = 1 − x; M2 part b5):
# - the power series' ln(a·B(a, b)) is lnΓ(1 + a) − [lnΓ(a + b) − lnΓ(b)], with the difference in a form whose every
#   term is proportional to a. P9's sum of lnΓ lost the a/(a + b) of two tiny shapes entirely, and 118 ulp at b = 6e8;
# - the quotient a/b scales a subnormal a first, where Dekker's product kept 27 bits of it;
# - for two shapes of 20 or more the prefactor takes TOMS 708's brcomp form, and with one, ln B takes the Stirling
#   difference: P9's sum cancelled from a + b down to O(1), 2–3 ulp near 1e9;
# - the side of the switch is chosen on the x the computation uses, not the caller's (they differ when y ≠ 1 − x).
# src/special.cyr keeps Rust's form past max(a, b) = 1e9, as for gamma_inc, so P9's cap stays inside an integer.
# Each result is rounded once; a subnormal one is rounded twice, by the final scaling, by at most 2^-1074. P9 measured
# it within 0.51 ulp (mean ≤ 0.25) on 214,744 rows against a 320-bit reference checked against exact rationals, where
# 1.3.0 is off by up to 583 ulp on §3.2's rows and 1.7×10⁵ near the mean; with the fixes, crverify's 140,098 rows from
# shapes of 2^-1074 to 1e9 are within 1.0 ulp. It costs 10–17× 1.3.0's form: every loop step is double-double.
#
# UPSTREAM(L8): ganita:docs/development/issues/2026-11-15-special-functions-scope-request.md
#   replace with ganita's incomplete beta if it takes the special functions on, at ADR 009's bound; parity: every
#   beta_inc row of special.ref.tsv

# ψ(z) for z > 0 to about 1e-10, enough for the first-order correction lnΓ(z + δ) ≈ lnΓ(z) + δ·ψ(z), |δ| ≤ ulp(z).
#must_use
fn _pmn_bi_digamma(z: f64): f64 {
    var s: f64 = 0.0;
    var w: f64 = z;
    while (w < 6.0) {
        var r: f64 = 1.0 / w;
        s = s - r;
        w = w + 1.0;
    }
    var lw: f64 = _pmn_km_cr_ln(w);
    var iw: f64 = 1.0 / w;
    var i2: f64 = iw * iw;
    var t: f64 = i2 * (0.083333333333333333 - i2 * (0.0083333333333333333 - i2 * 0.003968253968253968));
    var hw: f64 = 0.5 * iw;
    var p: f64 = lw - hw;
    var q: f64 = p - t;
    return q + s;
}

# Stirling's correction lnΓ(z) − [(z − ½) ln z − z + ln √(2π)] for z = zh + zl ≥ 20, Rust's seven terms evaluated
# in double-double on the whole argument (truncation below 1e-21 there; the plain double sum's rounding, 4e-19, and
# dropping zl, 3e-19, are what the small shapes' differences lnΓ(a) − lnΓ(a + b) cannot afford).
#must_use
fn _pmn_bi_stirling_dd(zh: f64, zl: f64): (f64, f64) {
    var rh, rl = _pmn_dd_div(1.0, 0.0, zh, zl);
    var r2h, r2l = _pmn_dd_mul(rh, rl, rh, rl);
    var c6h, c6l = _pmn_dd_div(1.0, 0.0, 156.0, 0.0);
    var c5h, c5l = _pmn_dd_div(691.0, 0.0, 360360.0, 0.0);
    var c4h, c4l = _pmn_dd_div(1.0, 0.0, 1188.0, 0.0);
    var c3h, c3l = _pmn_dd_div(1.0, 0.0, 1680.0, 0.0);
    var c2h, c2l = _pmn_dd_div(1.0, 0.0, 1260.0, 0.0);
    var c1h, c1l = _pmn_dd_div(1.0, 0.0, 360.0, 0.0);
    var c0h, c0l = _pmn_dd_div(1.0, 0.0, 12.0, 0.0);
    # t = c0 − r²(c1 − r²(c2 − r²(c3 − r²(c4 − r²(c5 − r²·c6))))), then r·t.
    var th, tl = _pmn_dd_mul(r2h, r2l, c6h, c6l);
    var u5h, u5l = _pmn_dd_add(c5h, c5l, -th, -tl);
    var m5h, m5l = _pmn_dd_mul(r2h, r2l, u5h, u5l);
    var u4h, u4l = _pmn_dd_add(c4h, c4l, -m5h, -m5l);
    var m4h, m4l = _pmn_dd_mul(r2h, r2l, u4h, u4l);
    var u3h, u3l = _pmn_dd_add(c3h, c3l, -m4h, -m4l);
    var m3h, m3l = _pmn_dd_mul(r2h, r2l, u3h, u3l);
    var u2h, u2l = _pmn_dd_add(c2h, c2l, -m3h, -m3l);
    var m2h, m2l = _pmn_dd_mul(r2h, r2l, u2h, u2l);
    var u1h, u1l = _pmn_dd_add(c1h, c1l, -m2h, -m2l);
    var m1h, m1l = _pmn_dd_mul(r2h, r2l, u1h, u1l);
    var u0h, u0l = _pmn_dd_add(c0h, c0l, -m1h, -m1l);
    var sh, sl = _pmn_dd_mul(rh, rl, u0h, u0l);
    return (sh, sl);
}

# lnΓ(z) for z = zh + zl > 0 as a double-double: below 20 the ζ-series form and the recurrence (plus zl·ψ), from 20
# Stirling, (z − ½) ln z − z + ln √(2π) + stirling(z), every term a double-double.
#must_use
fn _pmn_bi_lgamma_dd(zh: f64, zl: f64): (f64, f64) {
    if (zh < 20.0) {
        var gh, gl = _pmn_gi_lngamma_small_dd(zh);
        if (zl != 0.0) {
            var ps: f64 = _pmn_bi_digamma(zh);
            var c: f64 = zl * ps;
            var rh, rl = _pmn_dd_add(gh, gl, c, 0.0);
            return (rh, rl);
        }
        return (gh, gl);
    }
    var lh, ll0 = _pmn_dd_ln(zh);
    var cz: f64 = zl / zh;
    var ll: f64 = ll0 + cz;
    var mh, ml = _pmn_dd_add(zh, zl, -0.5, 0.0);
    var ph, pl = _pmn_dd_mul(mh, ml, lh, ll);
    var qh, ql = _pmn_dd_add(ph, pl, -zh, -zl);
    var pih: f64 = _PMN_KM_CR_SC_PIH;
    var pim: f64 = _PMN_KM_CR_SC_PIM;
    var tph: f64 = 2.0 * pih;
    var tpm: f64 = 2.0 * pim;
    var lph, lpl = _pmn_dd_ln(tph);
    var cp: f64 = tpm / tph;
    var lpl2: f64 = lpl + cp;
    var sph: f64 = 0.5 * lph;
    var spl: f64 = 0.5 * lpl2;
    var r1h, r1l = _pmn_dd_add(qh, ql, sph, spl);
    var sth, stl = _pmn_bi_stirling_dd(zh, zl);
    var r2h, r2l = _pmn_dd_add(r1h, r1l, sth, stl);
    return (r2h, r2l);
}

# ln of a positive double-double.
#must_use
fn _pmn_bi_ln_of_dd(h: f64, l: f64): (f64, f64) {
    var lh, ll = _pmn_dd_ln_any(h);
    var c: f64 = l / h;
    var l2: f64 = ll + c;
    return (lh, l2);
}

# φ(u) = u − ln(1 + u) for a double-double u > −1, as a double-double: the series Σ_{k≥2} (−u)^k/k for |u| ≤ ¼ (terms
# fall by 4 or more), else u − l, l = ln(1 + u) given by the caller from exact logarithms (as _pmn_gi_lnpre does).
#must_use
fn _pmn_bi_phi(uh: f64, ul: f64, lh: f64, ll: f64): (f64, f64) {
    var au: f64 = f64_abs(uh);
    if (au <= 0.25) {
        var fh: f64 = 0.0;
        var fl: f64 = 0.0;
        var wh: f64 = -uh;
        var wl: f64 = -ul;
        var ph, pl = _pmn_dd_mul(wh, wl, wh, wl);
        var thr: f64 = 0x3C10000000000000;      # 0x1p-62
        var k = 2;
        while (k < 200) {
            var fk: f64 = f64_from(k);
            var th, tl = _pmn_dd_div(ph, pl, fk, 0.0);
            var sh, sl = _pmn_dd_add(fh, fl, th, tl);
            fh = sh;
            fl = sl;
            var at: f64 = f64_abs(th);
            var af: f64 = f64_abs(fh);
            var lim: f64 = af * thr;
            if (at < lim || th == 0.0) { break; }
            var nh, nl = _pmn_dd_mul(ph, pl, wh, wl);
            ph = nh;
            pl = nl;
            k = k + 1;
        }
        return (fh, fl);
    }
    var rh, rl = _pmn_dd_add(uh, ul, -lh, -ll);
    return (rh, rl);
}

# ln √(2π) as a double-double (as _pmn_bi_lgamma_dd forms it).
#must_use
fn _pmn_bi_ln_sqrt_2pi(): (f64, f64) {
    var pih: f64 = _PMN_KM_CR_SC_PIH;
    var pim: f64 = _PMN_KM_CR_SC_PIM;
    var tph: f64 = 2.0 * pih;
    var tpm: f64 = 2.0 * pim;
    var lph, lpl = _pmn_dd_ln(tph);
    var cp: f64 = tpm / tph;
    var lpl2: f64 = lpl + cp;
    var sph: f64 = 0.5 * lph;
    var spl: f64 = 0.5 * lpl2;
    return (sph, spl);
}

# M for a, b ≥ 20 in TOMS 708's brcomp form, as Rust takes it for two shapes of 10 or more, here in double-double:
# with s = a + b and λ = bx − ay = sx − a,
#   M = −a·φ(λ/a) − b·φ(−λ/b) + ½ ln(b/(a·s)) − ln √(2π) − [st(a) + st(b) − st(s)],
# st being Stirling's correction (_pmn_bi_stirling_dd). Every term keeps its relative precision, where P9's sum
# a ln x + b ln y − ln B(a, b) − ln a cancels from about a + b down to O(1) near the mean, which left the logarithms'
# 2^-80 relative error at 2 ulp in I near a = b = 1e9 (M2 part b5).
#must_use
fn _pmn_bi_lnpre_large(a: f64, b: f64, xh: f64, xl: f64, yh: f64, yl: f64): (f64, f64) {
    var sh, sl = _pmn_km_two_sum(a, b);
    var bxh, bxl = _pmn_dd_mul_d(xh, xl, b);
    var ayh, ayl = _pmn_dd_mul_d(yh, yl, a);
    var lmh, lml = _pmn_dd_add(bxh, bxl, -ayh, -ayl);
    var uah, ual = _pmn_dd_div(lmh, lml, a, 0.0);
    var ubh, ubl = _pmn_dd_div(-lmh, -lml, b, 0.0);
    var lah, lal = _pmn_dd_ln(a);
    var lbh, lbl = _pmn_dd_ln(b);
    var lsh, lsl = _pmn_bi_ln_of_dd(sh, sl);
    # ln(1 + u_a) = ln s + ln x − ln a and ln(1 + u_b) = ln s + ln y − ln b, used when |u| > ¼.
    var l1h: f64 = 0.0;
    var l1l: f64 = 0.0;
    var aua: f64 = f64_abs(uah);
    if (aua > 0.25) {
        var lxh, lxl = _pmn_bi_ln_of_dd(xh, xl);
        var v1h, v1l = _pmn_dd_add(lsh, lsl, lxh, lxl);
        var v2h, v2l = _pmn_dd_add(v1h, v1l, -lah, -lal);
        l1h = v2h;
        l1l = v2l;
    }
    var l2h: f64 = 0.0;
    var l2l: f64 = 0.0;
    var aub: f64 = f64_abs(ubh);
    if (aub > 0.25) {
        var lyh, lyl = _pmn_bi_ln_of_dd(yh, yl);
        var w1h, w1l = _pmn_dd_add(lsh, lsl, lyh, lyl);
        var w2h, w2l = _pmn_dd_add(w1h, w1l, -lbh, -lbl);
        l2h = w2h;
        l2l = w2l;
    }
    var pah, pal = _pmn_bi_phi(uah, ual, l1h, l1l);
    var pbh, pbl = _pmn_bi_phi(ubh, ubl, l2h, l2l);
    var fah, fal = _pmn_dd_mul_d(pah, pal, a);
    var fbh, fbl = _pmn_dd_mul_d(pbh, pbl, b);
    # ½(ln b − ln a − ln s)
    var h1h, h1l = _pmn_dd_add(lbh, lbl, -lah, -lal);
    var h2h, h2l = _pmn_dd_add(h1h, h1l, -lsh, -lsl);
    var h3h: f64 = 0.5 * h2h;
    var h3l: f64 = 0.5 * h2l;
    var sah, sal = _pmn_bi_stirling_dd(a, 0.0);
    var sbh, sbl = _pmn_bi_stirling_dd(b, 0.0);
    var ssh, ssl = _pmn_bi_stirling_dd(sh, sl);
    var c1h, c1l = _pmn_dd_add(sah, sal, sbh, sbl);
    var c2h, c2l = _pmn_dd_add(c1h, c1l, -ssh, -ssl);
    var qh, ql = _pmn_bi_ln_sqrt_2pi();
    var m1h, m1l = _pmn_dd_add(h3h, h3l, -fah, -fal);
    var m2h, m2l = _pmn_dd_add(m1h, m1l, -fbh, -fbl);
    var m3h, m3l = _pmn_dd_add(m2h, m2l, -qh, -ql);
    var m4h, m4l = _pmn_dd_add(m3h, m3l, -c2h, -c2l);
    return (m4h, m4l);
}

# The exponent M = a ln x + b ln y − ln B(a, b) − ln a of x^a·y^b/(a·B(a, b)), as a double-double. For two shapes of
# 20 or more, the brcomp form above; for one, ln B = lnΓ(p) − [lnΓ(p + q) − lnΓ(q)] with p the smaller shape and the
# difference from _pmn_bi_lgdiff_big, where P9's lnΓ(q) − lnΓ(a + b) cancelled from about q ln q (3 ulp in 1 − I at
# a = 0.0016, b = 7.7e8; M2 part b5); below 20, P9's sum of the three lnΓ.
#must_use
fn _pmn_bi_lnpre(a: f64, b: f64, xh: f64, xl: f64, yh: f64, yl: f64): (f64, f64) {
    if (a >= 20.0 && b >= 20.0) {
        var rh, rl = _pmn_bi_lnpre_large(a, b, xh, xl, yh, yl);
        return (rh, rl);
    }
    if (a >= 20.0 || b >= 20.0) {
        var p: f64 = a;
        var q: f64 = b;
        if (a > b) {
            p = b;
            q = a;
        }
        var lxh2, lxl2 = _pmn_bi_ln_of_dd(xh, xl);
        var lyh2, lyl2 = _pmn_bi_ln_of_dd(yh, yl);
        var e1h, e1l = _pmn_dd_mul_d(lxh2, lxl2, a);
        var e2h, e2l = _pmn_dd_mul_d(lyh2, lyl2, b);
        var gph, gpl = _pmn_bi_lgamma_dd(p, 0.0);
        var dh, dl = _pmn_bi_lgdiff_big(p, q);
        var la2h, la2l = _pmn_dd_ln_any(a);
        var f1h, f1l = _pmn_dd_add(e1h, e1l, e2h, e2l);
        var f2h, f2l = _pmn_dd_add(f1h, f1l, -gph, -gpl);
        var f3h, f3l = _pmn_dd_add(f2h, f2l, dh, dl);
        var f4h, f4l = _pmn_dd_add(f3h, f3l, -la2h, -la2l);
        return (f4h, f4l);
    }
    var lxh, lxl = _pmn_bi_ln_of_dd(xh, xl);
    var lyh, lyl = _pmn_bi_ln_of_dd(yh, yl);
    var t1h, t1l = _pmn_dd_mul_d(lxh, lxl, a);
    var t2h, t2l = _pmn_dd_mul_d(lyh, lyl, b);
    var gah, gal = _pmn_bi_lgamma_dd(a, 0.0);
    var gbh, gbl = _pmn_bi_lgamma_dd(b, 0.0);
    var sh, sl = _pmn_km_two_sum(a, b);
    var gsh, gsl = _pmn_bi_lgamma_dd(sh, sl);
    var lah, lal = _pmn_dd_ln_any(a);
    var u1h, u1l = _pmn_dd_add(t1h, t1l, t2h, t2l);
    var u2h, u2l = _pmn_dd_add(u1h, u1l, -gah, -gal);
    var u3h, u3l = _pmn_dd_add(u2h, u2l, -gbh, -gbl);
    var u4h, u4l = _pmn_dd_add(u3h, u3l, gsh, gsl);
    var u5h, u5l = _pmn_dd_add(u4h, u4l, -lah, -lal);
    return (u5h, u5l);
}

# Lentz's continued fraction for I_x(a, b)·a·B(a, b)/(x^a y^b), Rust's even and odd steps, in double-double.
#must_use
fn _pmn_bi_cf(a: f64, b: f64, xh: f64, xl: f64, yh: f64, yl: f64, cap): (f64, f64) {
    var tiny: f64 = 0x0010000000000000;         # 0x1p-1022
    var thr: f64 = 0x3C10000000000000;          # 0x1p-62
    var a1h, a1l = _pmn_km_two_sum(a, 1.0);
    var obh, obl = _pmn_km_two_sum(1.0, -b);
    var n1h, n1l = _pmn_dd_mul(obh, obl, xh, xl);
    var n2h, n2l = _pmn_dd_mul(a1h, a1l, yh, yl);
    var n3h, n3l = _pmn_dd_add(n1h, n1l, n2h, n2l);
    var d0h, d0l = _pmn_dd_div(n3h, n3l, a1h, a1l);
    var dah: f64 = f64_abs(d0h);
    if (dah < tiny) {
        d0h = tiny;
        d0l = 0.0;
    }
    var dh, dl = _pmn_dd_div(1.0, 0.0, d0h, d0l);
    var hh: f64 = dh;
    var hl: f64 = dl;
    var ch: f64 = 1.0;
    var cl: f64 = 0.0;
    var abh, abl = _pmn_km_two_sum(a, b);
    var m = 1;
    while (m < cap) {
        var mf: f64 = f64_from(m);
        var tm: f64 = 2.0 * mf;
        # even: m(b − m)x / ((a + 2m − 1)(a + 2m))
        var bmh, bml = _pmn_km_two_sum(b, -mf);
        var e1h, e1l = _pmn_dd_mul_d(bmh, bml, mf);
        var e2h, e2l = _pmn_dd_mul(e1h, e1l, xh, xl);
        var at0h, at0l = _pmn_km_two_sum(a, tm);
        var at1h, at1l = _pmn_dd_add(at0h, at0l, -1.0, 0.0);
        var dnh, dnl = _pmn_dd_mul(at1h, at1l, at0h, at0l);
        var neh, nel = _pmn_dd_div(e2h, e2l, dnh, dnl);
        var x1h, x1l = _pmn_dd_mul(neh, nel, dh, dl);
        var d2h, d2l = _pmn_dd_add(1.0, 0.0, x1h, x1l);
        var q1h, q1l = _pmn_dd_div(neh, nel, ch, cl);
        var c2h, c2l = _pmn_dd_add(1.0, 0.0, q1h, q1l);
        var rdh, rdl = _pmn_dd_div(1.0, 0.0, d2h, d2l);
        dh = rdh;
        dl = rdl;
        ch = c2h;
        cl = c2l;
        var g1h, g1l = _pmn_dd_mul(dh, dl, ch, cl);
        var hh1, hl1 = _pmn_dd_mul(hh, hl, g1h, g1l);
        hh = hh1;
        hl = hl1;
        # odd: −(a + m)(a + b + m)x / ((a + 2m)(a + 2m + 1))
        var amh, aml = _pmn_km_two_sum(a, mf);
        var abmh, abml = _pmn_dd_add(abh, abl, mf, 0.0);
        var o1h, o1l = _pmn_dd_mul(amh, aml, abmh, abml);
        var o2h, o2l = _pmn_dd_mul(o1h, o1l, xh, xl);
        var at2h, at2l = _pmn_dd_add(at0h, at0l, 1.0, 0.0);
        var dn2h, dn2l = _pmn_dd_mul(at0h, at0l, at2h, at2l);
        var noh, nol = _pmn_dd_div(o2h, o2l, dn2h, dn2l);
        noh = -noh;
        nol = -nol;
        var x2h, x2l = _pmn_dd_mul(noh, nol, dh, dl);
        var d3h, d3l = _pmn_dd_add(1.0, 0.0, x2h, x2l);
        var q2h, q2l = _pmn_dd_div(noh, nol, ch, cl);
        var c3h, c3l = _pmn_dd_add(1.0, 0.0, q2h, q2l);
        var rd2h, rd2l = _pmn_dd_div(1.0, 0.0, d3h, d3l);
        dh = rd2h;
        dl = rd2l;
        ch = c3h;
        cl = c3l;
        var delh, dell = _pmn_dd_mul(dh, dl, ch, cl);
        var hh2, hl2 = _pmn_dd_mul(hh, hl, delh, dell);
        hh = hh2;
        hl = hl2;
        var dmh, dml = _pmn_dd_add(delh, dell, -1.0, 0.0);
        var dev: f64 = f64_abs(dmh);
        if (dev < thr) { break; }
        m = m + 1;
    }
    return (hh, hl);
}

# x^a y^b/(a B(a, b)) times the continued fraction: I_x(a, b) as (h, l, E), h + l = I/2^E.
#must_use
fn _pmn_bi_side(a: f64, b: f64, xh: f64, xl: f64, yh: f64, yl: f64, cap): (f64, f64, i64) {
    var mh, ml = _pmn_bi_lnpre(a, b, xh, xl, yh, yl);
    var eh, el, e = _pmn_gi_exp_dd(mh, ml);
    if (e < 0 - 2000) { return (0.0, 0.0, e); }
    var hh, hl = _pmn_bi_cf(a, b, xh, xl, yh, yl, cap);
    var vh, vl = _pmn_dd_mul(eh, el, hh, hl);
    return (vh, vl, e);
}

# a/w as a double-double for a, w > 0. Below a = 2^-512, a is scaled by 2^600 first and the quotient scaled back,
# both exactly: the correction's remainder a − q·w is near 2^-53·a, and below 2^-1022 Dekker's product no longer gives
# it exactly. Unscaled, a subnormal a over a tiny w kept only about 27 bits of the quotient (M2 part b5).
#must_use
fn _pmn_bi_quot(a: f64, w: f64): (f64, f64) {
    var t512: f64 = 0x1FF0000000000000;        # 0x1p-512
    if (a < t512) {
        var p600: f64 = 0x6570000000000000;    # 0x1p600
        var m600: f64 = 0x1A70000000000000;    # 0x1p-600
        var as: f64 = a * p600;
        var qh, ql = _pmn_dd_div(as, 0.0, w, 0.0);
        var rh: f64 = qh * m600;
        var rl: f64 = ql * m600;
        return (rh, rl);
    }
    var q2h, q2l = _pmn_dd_div(a, 0.0, w, 0.0);
    return (q2h, q2l);
}

# ln(1 + t)/t = Σ_{k≥1} (−1)^(k+1) t^(k−1)/k for 0 ≤ t ≤ 1/4 as a double-double. The terms fall by 4 or more, so the
# tail after one under 2^-62 of the sum is below a third of that.
#must_use
fn _pmn_bi_log1p_g(th: f64, tl: f64): (f64, f64) {
    var sh: f64 = 1.0;
    var sl: f64 = 0.0;
    var ph: f64 = 1.0;
    var pl: f64 = 0.0;
    var thr: f64 = 0x3C10000000000000;          # 0x1p-62
    var k = 2;
    while (k < 80) {
        var nh, nl = _pmn_dd_mul(ph, pl, th, tl);
        ph = -nh;
        pl = -nl;
        var fk: f64 = f64_from(k);
        var qh, ql = _pmn_dd_div(ph, pl, fk, 0.0);
        var uh, ul = _pmn_dd_add(sh, sl, qh, ql);
        sh = uh;
        sl = ul;
        var aq: f64 = f64_abs(qh);
        var lim: f64 = sh * thr;
        if (aq < lim || qh == 0.0) { break; }
        k = k + 1;
    }
    return (sh, sl);
}

# ln(1 + a/w) for a, w > 0 as a double-double: t·(ln(1 + t)/t) with t = a/w when 4a ≤ w, else ln(w + a) − ln w,
# which is at least ln(5/4) and so does not cancel.
#must_use
fn _pmn_bi_ln1p_ratio(a: f64, w: f64): (f64, f64) {
    var a4: f64 = 4.0 * a;
    if (a4 <= w) {
        var th, tl = _pmn_bi_quot(a, w);
        var gh, gl = _pmn_bi_log1p_g(th, tl);
        var sh, sl = _pmn_dd_mul(th, tl, gh, gl);
        return (sh, sl);
    }
    var swh, swl = _pmn_km_two_sum(w, a);
    var l1h, l1l = _pmn_bi_ln_of_dd(swh, swl);
    var l2h, l2l = _pmn_dd_ln_any(w);
    var rh, rl = _pmn_dd_add(l1h, l1l, -l2h, -l2l);
    return (rh, rl);
}

# lnΓ(a + b) − lnΓ(b) for b ≥ 20 as a double-double, every term proportional to a (M2 part b5): Stirling's form gives
# (b − ½)·ln(1 + a/b) + a·(ln(a + b) − 1) − [st(b) − st(a + b)], and with r = 1/b and q = 1/(a + b) each of Stirling's
# terms c/z^n contributes c·(r^n − q^n) = c·a·r·q·P_n, P_n = Σ_{j<n} r^j q^(n−1−j) (P_1 = 1, P_(n+1) = r^n + q·P_n).
# The difference of two lnΓ near b ln b lost its absolute error, about 2^-80·b ln b from the logarithms, to a result
# near a ln b: 9.6 ulp in 1 − I at a = 0.0031, b = 4.1e7.
#must_use
fn _pmn_bi_lgdiff_big(a: f64, b: f64): (f64, f64) {
    var rh, rl = _pmn_dd_div(1.0, 0.0, b, 0.0);
    var sh, sl = _pmn_km_two_sum(b, a);
    var qh, ql = _pmn_dd_div(1.0, 0.0, sh, sl);
    # Stirling's coefficients, c_k/z^(2k+1) with alternating signs (as _pmn_bi_stirling_dd).
    var c0h, c0l = _pmn_dd_div(1.0, 0.0, 12.0, 0.0);
    var accl: f64 = c0l;
    var acch: f64 = c0h;
    var ph: f64 = 1.0;                          # P_n, n = 1
    var pl: f64 = 0.0;
    var wh: f64 = rh;                           # r^n, n = 1
    var wl: f64 = rl;
    var n = 1;
    while (n < 13) {
        var mh, ml = _pmn_dd_mul(qh, ql, ph, pl);
        var nh, nl = _pmn_dd_add(wh, wl, mh, ml);
        ph = nh;
        pl = nl;
        n = n + 1;
        var w2h, w2l = _pmn_dd_mul(wh, wl, rh, rl);
        wh = w2h;
        wl = w2l;
        if ((n & 1) == 1) {
            var den: f64 = 360.0;
            var num: f64 = 1.0;
            if (n == 5) { den = 1260.0; }
            if (n == 7) { den = 1680.0; }
            if (n == 9) { den = 1188.0; }
            if (n == 11) {
                num = 691.0;
                den = 360360.0;
            }
            if (n == 13) { den = 156.0; }
            var ch, cl = _pmn_dd_div(num, 0.0, den, 0.0);
            var th, tl = _pmn_dd_mul(ch, cl, ph, pl);
            if ((n & 3) == 3) {
                th = -th;
                tl = -tl;
            }
            var ah, al = _pmn_dd_add(acch, accl, th, tl);
            acch = ah;
            accl = al;
        }
    }
    var rqh, rql = _pmn_dd_mul(rh, rl, qh, ql);
    var aqh, aql = _pmn_dd_mul_d(rqh, rql, a);
    var dsh, dsl = _pmn_dd_mul(aqh, aql, acch, accl);       # st(b) − st(a + b)
    # (b − ½)·ln(1 + a/b): for 4a ≤ b as a·(1 − r/2)·(ln(1 + t)/t), t = a/b, so a t that is subnormal never meets a
    # factor b; else directly.
    var t1h: f64 = 0.0;
    var t1l: f64 = 0.0;
    var a4: f64 = 4.0 * a;
    if (a4 <= b) {
        var tth, ttl = _pmn_bi_quot(a, b);
        var gh, gl = _pmn_bi_log1p_g(tth, ttl);
        var hrh, hrl = _pmn_dd_mul_d(rh, rl, -0.5);
        var fh, fl = _pmn_dd_add(1.0, 0.0, hrh, hrl);
        var fgh, fgl = _pmn_dd_mul(fh, fl, gh, gl);
        var t3h, t3l = _pmn_dd_mul_d(fgh, fgl, a);
        t1h = t3h;
        t1l = t3l;
    } else {
        var lh, ll = _pmn_bi_ln1p_ratio(a, b);
        var bmh, bml = _pmn_km_two_sum(b, -0.5);
        var t4h, t4l = _pmn_dd_mul(bmh, bml, lh, ll);
        t1h = t4h;
        t1l = t4l;
    }
    var lsh, lsl = _pmn_bi_ln_of_dd(sh, sl);
    var l1h, l1l = _pmn_dd_add(lsh, lsl, -1.0, 0.0);
    var t2h, t2l = _pmn_dd_mul_d(l1h, l1l, a);
    var u1h, u1l = _pmn_dd_add(t1h, t1l, t2h, t2l);
    var u2h, u2l = _pmn_dd_add(u1h, u1l, -dsh, -dsl);
    return (u2h, u2l);
}

# lnΓ(a + b) − lnΓ(b) for b < 20 and a < 1 as a double-double, every term proportional to a (M2 part b5). With
# m = ⌊b⌋ − 1, both b − m and a + b − m lie in [1, 3), where lnΓ(2 + y) = (1 − γ)y + Σ_{k≥2} (−1)^k (ζ(k) − 1)/k·y^k
# (|y| < 2). So the difference is (1 − γ)a + Σ (−1)^k (ζ(k) − 1)/k·D_k with D_k = y2^k − y1^k = y2·D_(k−1) + a·y1^(k−1)
# (y1 = b − m − 2, y2 = y1 + a), plus ln(1 + a/(b − i)) for i = 1 … m, or minus ln(1 + a/b) when m = −1. |D_k| ≤
# k·a and ζ(k) − 1 < 2^(1−k), so all 63 terms are taken: the rest is below 2^-63·a. The difference of two lnΓ lost
# the a/b of two tiny shapes, ln(1 + a/b), entirely: 1 − I off by a factor of 10^285 at a = 3.8e-321, b = 1.6e-288.
#must_use
fn _pmn_bi_lgdiff_small(a: f64, b: f64): (f64, f64) {
    var fb: f64 = f64_floor(b);
    var mf: f64 = fb - 1.0;
    var m = f64_to(mf);
    var m2: f64 = mf + 2.0;
    var y1h, y1l = _pmn_km_two_sum(b, -m2);   # exact for m ≥ 0; b − 1 as a double-double for m = −1
    var y2h, y2l = _pmn_dd_add(y1h, y1l, a, 0.0);
    var gh: f64 = _PMN_ZT_EULER_H;
    var gl: f64 = _PMN_ZT_EULER_L;
    var oh, ol = _pmn_km_two_sum(1.0, -gh);
    var ol2: f64 = ol - gl;
    var acch, accl = _pmn_dd_mul_d(oh, ol2, a);
    var dh: f64 = a;                            # D_1
    var dl: f64 = 0.0;
    var ph: f64 = 1.0;                          # y1^(k−1)
    var pl: f64 = 0.0;
    var k = 2;
    while (k <= 64) {
        var p2h, p2l = _pmn_dd_mul(ph, pl, y1h, y1l);
        ph = p2h;
        pl = p2l;
        var t1h, t1l = _pmn_dd_mul(y2h, y2l, dh, dl);
        var t2h, t2l = _pmn_dd_mul_d(ph, pl, a);
        var d2h, d2l = _pmn_dd_add(t1h, t1l, t2h, t2l);
        dh = d2h;
        dl = d2l;
        var zh: f64 = load64(&_PMN_ZT_MH + k * 8);
        var zl: f64 = load64(&_PMN_ZT_ML + k * 8);
        var th, tl = _pmn_dd_mul(zh, zl, dh, dl);
        var fk: f64 = f64_from(k);
        var uh, ul = _pmn_dd_div(th, tl, fk, 0.0);
        if ((k & 1) == 1) {
            uh = -uh;
            ul = -ul;
        }
        var sh, sl = _pmn_dd_add(acch, accl, uh, ul);
        acch = sh;
        accl = sl;
        k = k + 1;
    }
    if (m < 0) {
        var lh, ll = _pmn_bi_ln1p_ratio(a, b);
        var r1h, r1l = _pmn_dd_add(acch, accl, -lh, -ll);
        return (r1h, r1l);
    }
    var i = 1;
    while (i <= m) {
        var fi: f64 = f64_from(i);
        var bi: f64 = b - fi;                   # exact: i is a multiple of ulp(b)
        var l2h, l2l = _pmn_bi_ln1p_ratio(a, bi);
        var r2h, r2l = _pmn_dd_add(acch, accl, l2h, l2l);
        acch = r2h;
        accl = r2l;
        i = i + 1;
    }
    return (acch, accl);
}

# ln(a·B(a, b)) = lnΓ(1 + a) − [lnΓ(a + b) − lnΓ(b)] as a double-double (M2 part b5), for the power series below:
# lnΓ(1 + a) from the ζ series for a < 1, and the difference from _pmn_bi_lgdiff_big or _pmn_bi_lgdiff_small, so the
# result keeps its relative precision when it is small, which is where 1 − I is. P9 summed lnΓ(a) + ln a + lnΓ(b) −
# lnΓ(a + b); for a ≥ 1 with b < 20, which the power series doesn't reach in practice, that form remains.
#must_use
fn _pmn_bi_ln_ab(a: f64, b: f64): (f64, f64) {
    if (a >= 1.0 && b < 20.0) {
        var g1h, g1l = _pmn_bi_lgamma_dd(a, 0.0);
        var lah, lal = _pmn_dd_ln_any(a);
        var h1h, h1l = _pmn_dd_add(g1h, g1l, lah, lal);
        var gbh, gbl = _pmn_bi_lgamma_dd(b, 0.0);
        var sh, sl = _pmn_km_two_sum(a, b);
        var gsh, gsl = _pmn_bi_lgamma_dd(sh, sl);
        var l1h, l1l = _pmn_dd_add(h1h, h1l, gbh, gbl);
        var l2h, l2l = _pmn_dd_add(l1h, l1l, -gsh, -gsl);
        return (l2h, l2l);
    }
    var ah: f64 = 0.0;
    var al: f64 = 0.0;
    if (a < 1.0) {
        var g2h, g2l = _pmn_gi_lngamma1p_dd(a);
        ah = g2h;
        al = g2l;
    } else {
        var g3h, g3l = _pmn_bi_lgamma_dd(a, 0.0);
        var la2h, la2l = _pmn_dd_ln_any(a);
        var h3h, h3l = _pmn_dd_add(g3h, g3l, la2h, la2l);
        ah = h3h;
        al = h3l;
    }
    var dh: f64 = 0.0;
    var dl: f64 = 0.0;
    if (b >= 20.0) {
        var d1h, d1l = _pmn_bi_lgdiff_big(a, b);
        dh = d1h;
        dl = d1l;
    } else {
        var d2h, d2l = _pmn_bi_lgdiff_small(a, b);
        dh = d2h;
        dl = d2l;
    }
    var rh, rl = _pmn_dd_add(ah, al, -dh, -dl);
    return (rh, rl);
}

# 1 − I_x(a, b) directly, for the side whose value is above 1 − 2^-6 (a small, b·x ≲ 1): the power series.
#must_use
fn _pmn_bi_comp(a: f64, b: f64, xh: f64, xl: f64): f64 {
    # ln(a·B(a, b)), then aB − 1.
    var l2h, l2l = _pmn_bi_ln_ab(a, b);
    var bmh, bml = _pmn_dd_expm1(l2h, l2l);
    # x^a − 1.
    var lxh, lxl = _pmn_bi_ln_of_dd(xh, xl);
    var axh, axl = _pmn_dd_mul_d(lxh, lxl, a);
    var pmh, pml = _pmn_dd_expm1(axh, axl);
    # S = Σ_{j≥1} t_j/(a + j), t_j = t_{j−1}·(j − b)·x/j.
    var th: f64 = 1.0;
    var tl: f64 = 0.0;
    var sumh: f64 = 0.0;
    var suml: f64 = 0.0;
    var thr: f64 = 0x3C10000000000000;          # 0x1p-62
    var j = 1;
    while (j < 100000) {
        var fj: f64 = f64_from(j);
        var jbh, jbl = _pmn_km_two_sum(fj, -b);
        var m1h, m1l = _pmn_dd_mul(th, tl, jbh, jbl);
        var m2h, m2l = _pmn_dd_mul(m1h, m1l, xh, xl);
        var m3h, m3l = _pmn_dd_div(m2h, m2l, fj, 0.0);
        th = m3h;
        tl = m3l;
        var ajh, ajl = _pmn_km_two_sum(a, fj);
        var qh, ql = _pmn_dd_div(th, tl, ajh, ajl);
        var nh, nl = _pmn_dd_add(sumh, suml, qh, ql);
        sumh = nh;
        suml = nl;
        var aq: f64 = f64_abs(qh);
        var as: f64 = f64_abs(sumh);
        var lim: f64 = as * thr;
        if (aq < lim && j > 2) { break; }
        j = j + 1;
    }
    # numerator (aB − 1) − (x^a − 1) − a·x^a·S, over aB.
    var xah, xal = _pmn_dd_add(1.0, 0.0, pmh, pml);
    var w1h, w1l = _pmn_dd_mul(xah, xal, sumh, suml);
    var w2h, w2l = _pmn_dd_mul_d(w1h, w1l, a);
    var n1h, n1l = _pmn_dd_add(bmh, bml, -pmh, -pml);
    var n2h, n2l = _pmn_dd_add(n1h, n1l, -w2h, -w2l);
    var dh, dl = _pmn_dd_add(1.0, 0.0, bmh, bml);
    var rh, rl = _pmn_dd_div(n2h, n2l, dh, dl);
    var r: f64 = rh + rl;
    return r;
}

# T1 (I_x(a, b), 1 − I_x(a, b)); the smaller of x and y is taken as exact. (NaN, NaN) for a NaN argument or a shape
# ≤ 0; (0, 1) for x ≤ 0; (1, 0) for y ≤ 0; each as Rust's.
#must_use
fn _pmn_bi_beta_inc(a: f64, b: f64, x: f64, y: f64): (f64, f64) {
    var nan: f64 = _PMN_F64_NAN;
    if (x != x || y != y || a != a || b != b || a <= 0.0 || b <= 0.0) { return (nan, nan); }
    if (x <= 0.0) { return (0.0, 1.0); }
    if (y <= 0.0) { return (1.0, 0.0); }
    var xh: f64 = x;
    var xl: f64 = 0.0;
    var yh: f64 = y;
    var yl: f64 = 0.0;
    if (x <= y) {
        var th, tl = _pmn_km_two_sum(1.0, -x);
        yh = th;
        yl = tl;
    } else {
        var uh, ul = _pmn_km_two_sum(1.0, -y);
        xh = uh;
        xl = ul;
    }
    var a1: f64 = a + 1.0;
    var ab: f64 = a + b;
    var ab2: f64 = ab + 2.0;
    var sw: f64 = a1 / ab2;
    var mx: f64 = a;
    if (b > a) { mx = b; }
    var cap = 4000 + 200 * f64_to(f64_sqrt(mx));
    # The side is chosen on the x the computation uses: xh is the caller's x when x ≤ y, else 1 − y. P9 tested the
    # caller's x, the same number wherever y = 1 − x, but on 1.3.0's rows that pass a y that isn't (beta_inc(2, 3, 0.3,
    # 2^-1074): x is 1 − 2^-1074) it ran the fraction at x ≈ 1 on the wrong side and returned (0, 1) for (1, 0)
    # (M2 part b5).
    var swap = 0;
    if (xh >= sw) { swap = 1; }
    var vh: f64 = 0.0;
    var vl: f64 = 0.0;
    var e = 0;
    if (swap == 0) {
        var v1h, v1l, e1 = _pmn_bi_side(a, b, xh, xl, yh, yl, cap);
        vh = v1h;
        vl = v1l;
        e = e1;
    } else {
        var v2h, v2l, e2 = _pmn_bi_side(b, a, yh, yl, xh, xl, cap);
        vh = v2h;
        vl = v2l;
        e = e2;
    }
    var v: f64 = 0.0;
    var vsh: f64 = 0.0;
    var vsl: f64 = 0.0;
    if (e > 0 - 2000) {
        var vr: f64 = vh + vl;
        v = _pmn_dd_scale(vr, e);
        if (e >= 0 - 1022) {
            var s: f64 = _pmn_km_cr_pow2(e);
            vsh = vh * s;
            vsl = vl * s;
        } else {
            vsh = v;
        }
    }
    var oh, ol = _pmn_dd_add(1.0, 0.0, -vsh, -vsl);
    var other: f64 = oh + ol;
    var lim: f64 = 0.015625;                    # 2^-6: a smaller complement is computed directly
    if (oh < lim) {
        if (swap == 0) {
            other = _pmn_bi_comp(a, b, xh, xl);
        } else {
            other = _pmn_bi_comp(b, a, yh, yl);
        }
    }
    if (swap == 0) { return (v, other); }
    return (other, v);
}

# --- mathx.cyr ---

# mathx.cyr — pramana's f64 surface: Rust std semantics on top of the Cyrius builtins (port plan §8.1; ADR 009).
#
# Every std f64 operation pramana 1.3.0's code calls, as rustc 1.100.0 compiles it on x86_64, pinned by
# tests/golden/math.tsv (port-parity §1 found where the stdlib differs):
# - min / max / clamp ignore a NaN operand as Rust does (the stdlib's f64_min / f64_max ignore one only as the first
#   operand), and equal operands, +0 and −0 included, give the second (maxsd / minsd);
# - fract is x − trunc(x) (the stdlib's f64_fract is floor-based: f64_fract(−2.75) = 0.25, Rust's −0.75);
# - the predicates and total_cmp have no public stdlib counterpart;
# - `u64 as f64` rounds the unsigned value (f64_from reads its word as signed), and `f64 as usize` saturates (f64_to
#   doesn't);
# - powi is LLVM's and compiler-rt's square-and-multiply, the set bits multiplied in low to high.
# The transcendentals are the correctly rounded functions (ADR 009): kimiya's in src/crmath.cyr, pramana's own log1p,
# tan and log2 in src/crmath_ext.cyr (both ledger L1, with their own notes), cbrt ganita's, which already is. Every
# other module calls them through the names here, so a conversion to ganita's tier changes only this file.
# UPSTREAM(L2): cyrius:docs/development/issues/2026-11-11-f64-min-max-drop-nan-only-as-first-operand.md
#   replace each helper with the stdlib's minNum / maxNum, predicates, trunc-based fract, unsigned conversion and
#   saturating casts once they ship; parity: the class A f64::min, max, clamp, fract, is_nan, is_finite, as_usize and
#   u64::as_f64 rows of tests/golden/math.tsv.

# 1 when x is NaN. Mirrors `f64::is_nan`.
#must_use
#pure
fn _pmn_is_nan(x: f64): i64 {
    if (x != x) { return 1; }
    return 0;
}

# 1 when x is neither infinite nor NaN (x − x is 0 only then). Mirrors `f64::is_finite`.
#must_use
#pure
fn _pmn_is_finite(x: f64): i64 {
    var d: f64 = x - x;
    if (d == 0.0) { return 1; }
    return 0;
}

# The smaller of x and y, ignoring a NaN operand (NaN only when both are). Equal operands, +0 and −0 included, give
# y. Mirrors `f64::min`.
#must_use
#pure
fn _pmn_min(x: f64, y: f64): f64 {
    if (x != x) { return y; }
    if (y != y) { return x; }
    if (x < y) { return x; }
    return y;
}

# The larger of x and y, ignoring a NaN operand (NaN only when both are). Equal operands, +0 and −0 included, give
# y. Mirrors `f64::max`.
#must_use
#pure
fn _pmn_max(x: f64, y: f64): f64 {
    if (x != x) { return y; }
    if (y != y) { return x; }
    if (x > y) { return x; }
    return y;
}

# x restricted to [lo, hi]: lo when x < lo, hi when x > hi, else x (a NaN x stays NaN). Rust panics when lo > hi or
# a bound is NaN; every caller passes valid bounds, and this never aborts. Mirrors `f64::clamp`.
#must_use
#pure
fn _pmn_clamp(x: f64, lo: f64, hi: f64): f64 {
    var r: f64 = x;
    if (r < lo) { r = lo; }
    if (r > hi) { r = hi; }
    return r;
}

# x − trunc(x), the fractional part with x's sign: fract(−2.75) = −0.75, fract(±∞) = NaN. Never f64_fract, which is
# floor-based. Mirrors `f64::fract`.
#must_use
#pure
fn _pmn_fract(x: f64): f64 {
    var t: f64 = f64_trunc(x);
    var r: f64 = x - t;
    return r;
}

# Rust's total order: −1, 0 or 1 as x is below, equal to or above y, comparing the sign-folded bits (−NaN < −∞ < … <
# −0 < +0 < … < +∞ < +NaN). Mirrors `f64::total_cmp`.
#must_use
#pure
fn _pmn_total_cmp(x: f64, y: f64): i64 {
    var a = load64(&x);
    var b = load64(&y);
    a = a ^ ((a >>> 63) >> 1);
    b = b ^ ((b >>> 63) >> 1);
    if (a < b) { return 0 - 1; }
    if (a > b) { return 1; }
    return 0;
}

# A u64 word as the nearest f64 (ties to even). Below 2^63 the signed conversion is that. At or above, the word
# halved with a sticky bit (the dropped bit ORed in) converts to the same rounding at half the value, and doubling
# is exact. Mirrors `n as f64` for a u64.
#must_use
#pure
fn _pmn_u64_to_f64(n): f64 {
    if (n >= 0) {
        var r: f64 = f64_from(n);
        return r;
    }
    var h = (n >> 1) | (n & 1);
    var f: f64 = f64_from(h);
    var r2: f64 = f + f;
    return r2;
}

# `x as usize` on a 64-bit target: toward zero, saturating at 0 and u64::MAX, NaN → 0. The result is the 64-bit
# word, so a value at or above 2^63 reads negative as an i64.
#must_use
#pure
fn _pmn_sat_usize(x: f64): i64 {
    if (x != x) { return 0; }
    if (x <= 0.0) { return 0; }
    if (x >= 18446744073709551616.0) { return 0 - 1; }
    if (x >= 9223372036854775808.0) {
        var hi: f64 = x - 9223372036854775808.0;    # exact: both are multiples of 2^11
        return f64_to(hi) | 0x8000000000000000;
    }
    return f64_to(x);
}

# x^n by square-and-multiply, the set bits of |n| multiplied in low to high from 1, then 1/r for n < 0: LLVM's
# expansion of a literal `x.powi(n)` and compiler-rt's __powidf2 alike (1·y is exact, so the start costs nothing).
# x²⁵ = (x · x⁸) · x¹⁶. Mirrors `f64::powi`.
#must_use
#pure
fn _pmn_powi(x: f64, n): f64 {
    var base: f64 = x;
    var p = n;
    var recip = 0;
    if (n < 0) {
        recip = 1;
        p = 0 - n;
    }
    var mul: f64 = 1.0;
    while (1) {
        if ((p & 1) != 0) { mul = mul * base; }
        p = p >> 1;
        if (p == 0) { break; }
        base = base * base;
    }
    if (recip == 1) {
        var r: f64 = 1.0 / mul;
        return r;
    }
    return mul;
}

# ── the transcendentals, correctly rounded ────────────────────────────────────────────────────────

