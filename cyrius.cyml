[package]
name = "pramana"
version = "${file:VERSION}"
description = "pramana — statistics and probability: distributions, special functions, hypothesis tests, regression, Bayesian inference, Markov chains, Monte Carlo, time series"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/pramana"
language = "cyrius"
cyrius = "6.7.18"

[build]
entry = "src/main.cyr"
output = "build/pramana"
# Dead-code elimination: a consumer that calls one function doesn't carry the rest (port plan §4.3 row 10, probe P8).
dce = true

# stdlib leaves, vendored into lib/ by `cyrius deps` and prepended to every compile (port plan §5 step 3).
#   math     — f64 basics (sqrt, floor, abs, f64_from / f64_to) and the polyfills; every transcendental goes
#              through pramana's correctly rounded functions instead (ADR 009)
#   ganita   — ganita_f64_cbrt (exact; the Wilson–Hilferty branch), and the Cholesky pair if probe P5 keeps it
#   overflow — the saturating `+|` / `-|` / `*|` operators (u64 / PmnU128 combinatorics, the ulp distance)
#   tagged / result — the value-form Option and Result
#   freelist — fl_alloc / fl_free: owned objects with a `_drop` (port plan D11)
#   fnptr    — callbacks as a function pointer plus a context (Monte Carlo, MH, Gibbs, the KS one-sample CDF; D7)
#   atomic   — compare-and-swap for the work-table pool (kimiya ADR 0007; D11)
#   bayan    — the JSON value tree under the hand codecs (D5)
# No hisab: its four 1.4.0 routines are transcribed into src/linalg.cyr (port plan §8.2, ADR 008).
# sandhi (HTTP) joins only for the `ai` code, outside the core bundle (D8, probe P8).
[deps]
stdlib = ["syscalls", "string", "alloc", "str", "fmt", "io", "vec", "math", "ganita",
    "overflow", "tagged", "result", "freelist", "fnptr", "atomic", "bayan"]

# Test / bench / fuzz compiles only.
[test]
stdlib = ["assert", "bench", "thread"]

# The library's modules, in dependency order (port plan §5 step 3: error → constants → crmath_data → crmath → mathx →
# json → rng → combinatorics → bridge → special → …). `cyrius distlib` bundles them into dist/pramana.cyr; tests
# include the same list through tests/lib.cyr, which must stay in step.
[lib]
modules = [
    "src/error.cyr",
    "src/constants.cyr",
    "src/crmath_data.cyr",
    "src/crmath.cyr",
    "src/crmath_ext.cyr",
    "src/dd.cyr",
    "src/crerf_data.cyr",
    "src/crerf.cyr",
    "src/lgamma_data.cyr",
    "src/lgamma.cyr",
    "src/zeta_data.cyr",
    "src/gammainc.cyr",
    "src/betainc.cyr",
    "src/mathx.cyr",
    "src/fmtf.cyr",
    "src/pool.cyr",
    "src/json.cyr",
    "src/debug.cyr",
    "src/rng.cyr",
    "src/combinatorics.cyr",
    "src/bridge.cyr",
    "src/special.cyr",
    "src/linalg.cyr",
    "src/dist.cyr",
    "src/dist_cont.cyr",
    "src/dist_gamma.cyr",
    "src/dist_disc.cyr",
    "src/dist_mvn.cyr",
    "src/sort.cyr",
    "src/descriptive.cyr",
    "src/kde.cyr",
    "src/pca.cyr",
    "src/hypothesis.cyr",
    "src/regression.cyr",
    "src/timeseries.cyr",
]
