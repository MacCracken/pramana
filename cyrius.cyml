[package]
name = "pramana"
version = "${file:VERSION}"
description = "pramana — statistics and probability: distributions, special functions, hypothesis tests, regression, Bayesian inference, Markov chains, Monte Carlo, time series"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/pramana"
language = "cyrius"
cyrius = "6.7.18"

[build]
entry = "src/main.cyr"
output = "build/pramana"

[deps]
stdlib = ["string", "fmt", "alloc", "vec", "str", "syscalls", "io", "args"]

# Test / bench / fuzz compiles only. `bench` was missing from the scaffold (the open cyrius port issue, item 3).
[test]
stdlib = ["assert", "bench"]
